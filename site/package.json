{
  "name": "@awesome-everything/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "NODE_OPTIONS=--max-old-space-size=10240 astro build && bun scripts/lint-dist.mjs",
    "build:incremental": "bun scripts/incremental-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:samples": "bun scripts/run-code-samples.mjs",
    "verify:scenario": "bun scripts/verify-scenario.mjs",
    "verify:grammar": "bun scripts/grammar-gen/verify-grammar.ts",
    "verify:samples:list": "bun scripts/run-code-samples.mjs --list",
    "audit:depth": "bun scripts/depth-audit/audit.ts",
    "audit:scenario": "bun scripts/scenario-audit/audit.ts",
    "audit:coverage": "bun scripts/coverage-audit/audit.ts",
    "audit:grammar": "bun scripts/grammar-gen/audit-grammar.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "audit:sandbox": "bun scripts/audit-sandbox-empty.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/mdx": "5.0.6",
    "@astrojs/preact": "5.1.3",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/tailwind": "6.0.2",
    "@electric-sql/pglite": "0.4.5",
    "@preact/signals": "^1.3.0",
    "@xenova/transformers": "2.17.2",
    "astro": "6.3.5",
    "gsap": "^3.12.5",
    "lottie-web": "^5.12.2",
    "preact": "^10.22.0",
    "quickjs-emscripten": "0.32.0",
    "tailwindcss": "^3.4.0",
    "ts-fsrs": "4",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "25.9.1",
    "@vitest/ui": "^2.1.0",
    "jsdom": "^25.0.0",
    "vitest": "^2.1.0"
  }
}
