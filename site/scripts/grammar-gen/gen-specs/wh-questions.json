{
  "id": "wh-questions",
  "gen": {
    "pools": [
      {
        "id": "whWords",
        "tags": {
          "level": [
            "A2"
          ]
        },
        "items": [
          "What",
          "Where",
          "When",
          "Why",
          "How",
          "Who",
          "Which",
          "How much"
        ]
      },
      {
        "id": "subjMixed",
        "tags": {
          "level": [
            "A2"
          ]
        },
        "items": [
          "she",
          "he",
          "the manager",
          "your client",
          "the new intern",
          "my colleague",
          "the vendor",
          "it",
          "you",
          "we",
          "they",
          "the developers",
          "your friends",
          "the testers"
        ]
      },
      {
        "id": "baseVerbs",
        "tags": {
          "level": [
            "A2"
          ]
        },
        "items": [
          "work",
          "want",
          "mean",
          "need",
          "fix",
          "ship",
          "review",
          "deploy",
          "decide",
          "report"
        ]
      }
    ],
    "templates": [
      {
        "id": "wh-aux-present",
        "type": "fill_in_blank",
        "cefrMin": "A2",
        "cefrMax": "A2",
        "pattern": "{whWords} ___ {subj} {verb}? (hint: choose the auxiliary for {subj})",
        "slots": {
          "subj": {
            "pool": "subjMixed"
          },
          "verb": {
            "pool": "baseVerbs"
          }
        },
        "deriveKey": "question-aux-present",
        "rationale": {
          "en": "With an ordinary verb, a wh-question needs do or does before the subject; {subj} takes does if it is third person singular, otherwise do. The main verb stays in its base form.",
          "ru": "С обычным глаголом wh-вопрос требует do или does перед подлежащим; {subj} берёт does, если это 3-е лицо ед. ч., иначе do. Основной глагол остаётся в базовой форме."
        }
      },
      {
        "id": "wh-aux-past",
        "type": "fill_in_blank",
        "cefrMin": "A2",
        "cefrMax": "B1",
        "pattern": "{whWords} ___ {subj} {verb} yesterday? (hint: past auxiliary for {subj})",
        "slots": {
          "subj": {
            "pool": "subjMixed"
          },
          "verb": {
            "pool": "baseVerbs"
          }
        },
        "deriveKey": "question-aux-past",
        "rationale": {
          "en": "In a past wh-question the auxiliary is always did for every subject; did already carries the past tense, so the main verb stays in its base form.",
          "ru": "В wh-вопросе в прошедшем времени вспомогательный глагол всегда did для любого подлежащего; did уже выражает прошедшее время, поэтому основной глагол остаётся в базовой форме."
        }
      }
    ],
    "features": [
      "subject-aux-agreement-present",
      "do-does-by-person",
      "did-invariant-past",
      "base-verb-after-auxiliary"
    ],
    "contexts": []
  }
}