        },
        "deriveKey": "present-participle-form",
        "rationale": {
          "en": "After the auxiliary 'is' the main verb takes the -ing form: '{subj} is …-ing' describes an action happening now.",
          "ru": "После вспомогательного 'is' основной глагол ставится в форму -ing: «{subj} is …-ing» описывает действие, которое происходит сейчас."
        }
      },
      {
        "id": "pc-plural-are",
        "type": "fill_in_blank",
        "cefrMin": "A0",
        "cefrMax": "A2",
        "pattern": "At the moment {subj} are ___ in the office. (hint: {verb})",
        "slots": {
          "subj": {
            "pool": "subjPlural"
          },
          "verb": {
            "pool": "verbs"
          }
        },
        "deriveKey": "present-participle-form",
        "rationale": {
          "en": "Plural and 'you/we/they' subjects take 'are' + the -ing form: '{subj} are …-ing' marks an action in progress now.",
          "ru": "С подлежащими во множественном числе и 'you/we/they' употребляется 'are' + форма -ing: «{subj} are …-ing» обозначает действие, идущее прямо сейчас."
        }
      }
