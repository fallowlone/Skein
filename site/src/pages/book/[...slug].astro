---
import { getCollection, render } from "astro:content";
import Book from "../../layouts/Book.astro";

export async function getStaticPaths() {
  const entries = await getCollection("book", ({ data }) => !data.draft);
  const sorted = [...entries].sort((a, b) => {
    if (a.data.pillar !== b.data.pillar) return a.data.pillar.localeCompare(b.data.pillar);
    if (a.data.chapter !== b.data.chapter) return a.data.chapter.localeCompare(b.data.chapter);
    return a.data.order - b.data.order;
  });

  return sorted.map((entry, i) => {
    const prevEntry = sorted[i - 1] ?? null;
    const nextEntry = sorted[i + 1] ?? null;
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: prevEntry ? { title: prevEntry.data.title, slug: prevEntry.id } : null,
        next: nextEntry ? { title: nextEntry.data.title, slug: nextEntry.id } : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---
<Book
  title={entry.data.title}
  pillar={entry.data.pillar}
  chapter={entry.data.chapter}
  depth={entry.data.depth}
  sources={entry.data.sources}
  summary={entry.data.summary}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
</Book>
