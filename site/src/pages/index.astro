---
import "../styles/global.css";
import { getCollection } from "astro:content";
import TitleBar from "../components/brand/TitleBar.astro";

const entries = await getCollection("book", ({ data }) => !data.draft);
const sorted = [...entries].sort((a, b) => {
  if (a.data.pillar !== b.data.pillar) return a.data.pillar.localeCompare(b.data.pillar);
  if (a.data.chapter !== b.data.chapter) return a.data.chapter.localeCompare(b.data.chapter);
  return a.data.order - b.data.order;
});
const byPillar = new Map<string, typeof sorted>();
for (const e of sorted) {
  if (!byPillar.has(e.data.pillar)) byPillar.set(e.data.pillar, []);
  byPillar.get(e.data.pillar)!.push(e);
}
const pillars = [...byPillar.entries()];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>awesome-everything — a visual book on fullstack engineering</title>
  </head>
  <body class="min-h-screen bg-white text-bbg-ink">
    <TitleBar headline="A visual book on fullstack engineering" />
    <main class="max-w-[1100px] mx-auto px-4 md:px-12 pt-12 pb-24">
      <p class="text-lg text-bbg-muted leading-relaxed mb-16 max-w-[760px]">
        Long-form, scroll-driven chapters on the systems behind everyday software. Animated diagrams sit beside the prose, not instead of it. Built for middle+ to senior fullstack engineers.
      </p>

      {pillars.map(([pillar, pieces]) => (
        <section class="mb-16">
          <h2 class="uppercase tracking-wider text-xs font-bold text-bbg-muted mb-4">{pillar}</h2>
          <ul class="space-y-3">
            {pieces.map((p) => (
              <li>
                <a
                  href={`/book/${p.id}/`}
                  class="block group rounded-xl border-2 border-dashed border-panel-lilac-ink bg-panel-lilac hover:bg-panel-lilac/70 transition p-6"
                >
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="text-2xl font-extrabold text-bbg-ink group-hover:text-panel-lilac-ink transition">
                      {p.data.title}
                    </h3>
                    <span class="text-xs uppercase tracking-wider text-bbg-muted font-bold shrink-0">{p.data.pillar}</span>
                  </div>
                  <p class="mt-3 text-bbg-ink/80 leading-relaxed text-[15px]">{p.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      {pillars.length === 0 && (
        <p class="text-bbg-muted italic">No chapters yet. Add an .mdx file under <code class="font-mono">src/content/book/</code>.</p>
      )}
    </main>
  </body>
</html>
