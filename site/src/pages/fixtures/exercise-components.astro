---
import Topic from "../../layouts/Topic.astro";
import Quiz from "../../components/pedagogy/Quiz.astro";
import DragOrder from "../../components/pedagogy/DragOrder.astro";
import TraceScenario from "../../components/pedagogy/TraceScenario.astro";
import DebugLog from "../../components/pedagogy/DebugLog.astro";
import TradeoffMatrix from "../../components/pedagogy/TradeoffMatrix.astro";

const DEBUG_OUTPUT = `const Cart = ({ items }) => {
  const [total, setTotal] = useState(0);
  useEffect(() => {
    setTotal(items.reduce((s, x) => s + x.price, 0));
  });  // ← no deps array
  return <div>Итого: {total}</div>;
};`;
---
<Topic title="Exercise components fixture" lang="ru">
  <Quiz
    id="q-useeffect"
    pieceSlug="fixtures/exercise-components"
    lang="ru"
    question="Какое утверждение про React useEffect верно?"
    choices={[
      { label: "Эффект выполняется до коммита в DOM, синхронно.", misconception: "Эффекты выполняются после коммита, асинхронно — чтобы не блокировать paint." },
      { label: "useEffect нельзя использовать дважды в одном компоненте.", misconception: "Можно. React выполняет эффекты в порядке их объявления." },
      { label: "Cleanup-функция вызывается перед каждым повторным запуском эффекта.", correct: true },
      { label: "Массив зависимостей опционален и поведение не меняется.", misconception: "Без массива зависимостей эффект выполняется после каждого рендера — это намеренное и заметное поведение." },
    ]}
  />

  <DragOrder
    id="do-http-request"
    pieceSlug="fixtures/exercise-components"
    lang="ru"
    prompt="Расположите этапы HTTP-запроса по порядку"
    items={[
      "DNS-запрос: резолвинг домена в IP-адрес",
      "TCP-handshake (3-way)",
      "TLS-handshake и обмен сертификатами",
      "Отправка HTTP-запроса",
      "Получение HTTP-ответа",
    ]}
  />

  <TraceScenario
    id="ts-setstate"
    pieceSlug="fixtures/exercise-components"
    lang="ru"
    scenario="Что происходит, когда вы вызываете setState() в обработчике события?"
    steps={[
      { prompt: "Click handler invokes setState(...)", reveal: "React schedules an update — current execution continues uninterrupted. The state value you read after setState is still the previous value (closure capture)." },
      { prompt: "React batches subsequent setState calls in the same handler", reveal: "Multiple setState calls within one event are merged into a single re-render. Since React 18, this batching extends to promises, timeouts, and native events." },
      { prompt: "Handler returns; React processes pending updates", reveal: "The reconciler walks the fiber tree, computing the next state and diffing the next render against the current tree." },
      { prompt: "Commit phase applies DOM mutations", reveal: "Refs are attached, layout effects (useLayoutEffect) fire synchronously before the browser paints." },
      { prompt: "Browser paints; passive effects run after", reveal: "useEffect callbacks run asynchronously, so the user sees the new frame before side-effects fire." },
    ]}
  />

  <DebugLog
    id="dl-infinite-render"
    pieceSlug="fixtures/exercise-components"
    lang="ru"
    title="Этот компонент рендерится в бесконечном цикле. Почему?"
    output={DEBUG_OUTPUT}
    outputLang="tsx"
    question="Что произойдёт, если у useEffect не указать массив зависимостей? Какие операции внутри тогда вызовут повторный рендер?"
    hint="Что произойдёт, если у useEffect не указать массив зависимостей? Какие операции внутри тогда вызовут повторный рендер?"
    answer="useEffect без массива зависимостей выполняется после каждого рендера. setTotal() вызывает повторный рендер → эффект снова → цикл. Исправить: добавить [items] как зависимость, или (лучше) вычислить total прямо в render — это derived state."
  />

  <TradeoffMatrix
    id="tm-counter-storage"
    pieceSlug="fixtures/exercise-components"
    lang="ru"
    prompt="Какое хранилище лучше для счётчика просмотров реального времени, пик 100k writes/sec?"
    options={[
      {
        name: "PostgreSQL",
        summary: "ACID, реляционная, row-level locking",
        justification: "На каждый INCR — лок строки + WAL + fsync. На 100k/sec упрётся в IOPS ещё до CPU. Подойдёт для тех счётчиков, что можно агрегировать пачкой.",
      },
      {
        name: "Redis (INCR)",
        summary: "in-memory, атомарные счётчики, AOF для durability",
        correct: true,
        justification: "Атомарный INCR над in-memory структурой — порядка миллиона ops/sec на один узел. AOF every-sec даёт приемлемый durability при минимальной нагрузке. Это эталонный кейс для Redis.",
      },
      {
        name: "DynamoDB",
        summary: "managed NoSQL, eventual consistency",
        justification: "Поддерживает atomic counters, но WCU стоят дорого на write-heavy нагрузках, а eventual consistency может неприятно удивить, если читаете тот же ключ сразу после записи.",
      },
      {
        name: "MongoDB",
        summary: "document store, $inc атомарен per-document",
        justification: "$inc атомарен на уровне документа, но journaling + replica sync сильно ограничивают throughput одного шарда. Без шардирования по hot keys упрётесь в одну primary-ноду.",
      },
    ]}
  />
</Topic>
