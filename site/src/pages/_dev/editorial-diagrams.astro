---
/**
 * Dev-only gallery for the editorial diagram archetypes. Not linked in nav.
 * Used to visually verify the editorial aesthetic and to prove the diagrams
 * render island-free (grep built HTML for `<astro-island` → must be 0).
 */
import EditorialDiagram from "~/components/diagram/EditorialDiagram.astro";

const samples = [
  {
    kind: "arc",
    genre: "present perfect",
    hero: "shipped",
    labels: ["past", "now", "future"],
    note: "it's live now",
    label: "A finished action whose result is live in the present.",
    caption: "arc — a past act whose result lands on NOW",
  },
  {
    kind: "timeline",
    genre: "request lifecycle",
    labels: ["accept", "parse", "route", "respond"],
    label: "Stages a request passes through, in order.",
    caption: "timeline — ordered points on an axis",
  },
  {
    kind: "contrast-pair",
    genre: "consistency",
    labels: ["strong", "eventual"],
    note: "pick per read path",
    label: "Strong vs eventual consistency, side by side.",
    caption: "contrast-pair — two options across a divider",
  },
  {
    kind: "transformation",
    genre: "compile step",
    labels: ["source", "bytecode"],
    label: "Source transformed into bytecode.",
    caption: "transformation — before → after",
  },
  {
    kind: "map",
    genre: "status codes",
    items: ["200→OK", "404→Not Found", "503→Unavailable"],
    label: "Status codes mapped to their meanings.",
    caption: "map — key → value rows",
  },
  {
    kind: "branch",
    genre: "load balancer",
    labels: ["node A", "node B", "node C"],
    label: "One balancer fanning out to three nodes.",
    caption: "branch — one source → many targets",
  },
  {
    kind: "scale",
    genre: "cache tiers",
    labels: ["disk", "RAM", "CPU L1"],
    label: "Cache tiers from slow/large to fast/small.",
    caption: "scale — layered growth",
  },
  {
    kind: "highlight",
    genre: "hot path",
    labels: ["recv", "decode", "compute", "encode", "send"],
    focus: 2,
    label: "The compute stage dominates the hot path.",
    caption: "highlight — one focus token in a row",
  },
  {
    kind: "slot-fill",
    genre: "pipeline gap",
    labels: ["extract", "___", "load"],
    label: "The missing transform stage between extract and load.",
    caption: "slot-fill — the gap to fill",
  },
  {
    kind: "swap",
    genre: "blue-green",
    labels: ["blue (live)", "green (idle)"],
    note: "flip on deploy",
    label: "Blue and green environments swap on deploy.",
    caption: "swap — two states exchanging roles",
  },
];

const hues = [
  "var(--d-systems, var(--accent))",
  "var(--d-math, var(--accent))",
  "var(--accent)",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Editorial diagram gallery</title>
    <style>
      body { max-width: 880px; margin: 0 auto; padding: 32px 16px 96px; font-family: system-ui, sans-serif; }
      h1 { font-size: 20px; }
      h2 { font-size: 14px; margin-top: 40px; color: #555; font-family: ui-monospace, monospace; }
    </style>
  </head>
  <body>
    <h1>Editorial diagram gallery</h1>
    <p>Each archetype via <code>EditorialDiagram</code>. Static SVG, zero hydration islands.</p>
    {samples.map((s, i) => (
      <section>
        <h2>{s.kind}</h2>
        <EditorialDiagram {...s} hue={hues[i % hues.length]} />
      </section>
    ))}
  </body>
</html>
