---
// Static 404 — Cloudflare Pages serves dist/404.html for any unmatched route.
// Bilingual on one page: a 404 has no locale context to detect server-side.
import "~/styles/global.css";
import ThemeBoot from "~/components/brand/ThemeBoot.astro";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 — Skein</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ThemeBoot />
  </head>
  <body class="min-h-screen bg-paper text-ink flex items-center justify-center px-6">
    <main class="text-center max-w-xl w-full">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted mb-4">404 · not found · такой страницы нет</p>
      <h1 class="poster-giant poster-hero-size" aria-label="404">
        <span class="pg-solid" aria-hidden="true">404</span>
        <span class="pg-outline" aria-hidden="true">Lost?</span>
      </h1>
      <p class="text-sm text-muted mt-6 mb-2">The lesson may have moved, or the link is stale.</p>
      <p class="text-sm text-muted mb-8">Урок мог переехать, или ссылка устарела.</p>
      <p class="flex items-center justify-center gap-4 text-sm">
        <a class="underline underline-offset-4" href="/en/">English atlas →</a>
        <a class="underline underline-offset-4" href="/ru/">Русский атлас →</a>
      </p>
    </main>
  </body>
</html>
