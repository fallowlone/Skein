---
import { Input as ShadcnInput } from "~/components/ui/input";
import Topic from "../../../layouts/Topic.astro";
import { type Locale, isLocale, t } from "../../../i18n";
import { glossary } from "../../../scripts/glossary-data";
import { selectOther } from "~/scripts/build-incremental";

type Row = {
  key: string;
  label: string;
  definition: string | null;
  excerpt: string | null;
};
type Group = { letter: string; rows: Row[] };

export async function getStaticPaths() {
  const mockupResolveReference = "A per-entity resolver function required by the Apollo Federation subgraph spec. When the router needs to fetch an entity by its key, it calls this resolver with a representation object and expects the full entity in return.";

  function excerpt(def: string | undefined, n = 96): string | null {
    if (!def) return null;
    return def.length > n ? def.slice(0, n).trimEnd() + "…" : def;
  }
  const paths: { params: { lang: string }; props: { groups: Group[]; total: number } }[] = [];
  for (const lang of ["en", "ru"] as const) {
    const rows: Row[] = Object.entries(glossary).map(([key, e]) => {
      const definition = (lang === "en" && key === "resolve_reference" ? mockupResolveReference : lang === "en" ? e.defEn : e.defRu) ?? null;
      return { key, label: e[lang], definition, excerpt: excerpt(definition ?? undefined) };
    });
    rows.sort((a, b) => a.label.localeCompare(b.label, lang));

    const byLetter = new Map<string, Row[]>();
    for (const r of rows) {
      const first = r.label[0]?.toUpperCase() ?? "#";
      const letter = /[A-ZА-Я]/.test(first) ? first : "#";
      if (!byLetter.has(letter)) byLetter.set(letter, []);
      byLetter.get(letter)!.push(r);
    }
    const groups: Group[] = [...byLetter.entries()]
      .sort((a, b) => a[0].localeCompare(b[0], lang))
      .map(([letter, gr]) => ({ letter, rows: gr }));

    paths.push({ params: { lang }, props: { groups, total: rows.length } });
  }
  return selectOther(paths);
}

const { lang } = Astro.params as { lang: Locale };
if (!isLocale(lang)) throw new Error("bad lang");
const { groups, total } = Astro.props as { groups: Group[]; total: number };
---

<Topic title={t("nav.glossary", lang)} lang={lang}>
  <div class="glossary-page max-w-[1080px] mx-auto px-4 lg:px-4 mt-6">
    <h1 class="font-display text-[clamp(28px,4vw,40px)] font-bold leading-[1.1] tracking-[-0.02em] m-0 text-ink">
      {t("nav.glossary", lang)}
    </h1>
    <p class="text-ink-2 leading-relaxed mt-3 mb-6">{t("glossary.intro", lang)}</p>

    <ShadcnInput
      id="gloss-search"
      type="search"
      aria-label={lang === "en" ? "Search glossary terms" : "Поиск по терминам"}
      placeholder={lang === "en" ? `Search ${total} terms…` : `Поиск среди ${total} терминов…`}
      class="w-full max-w-[380px] bg-card border border-rule-strong rounded-[3px] px-3 py-2 text-ink text-[14px] mb-8"
    />

    <div class="glossary-index-grid grid grid-cols-[28px_1fr] gap-6">
      <nav class="sticky top-6 self-start flex flex-col gap-0.5" aria-label={t("a11y.nav.azIndex", lang)}>
        {groups.map((g) => (
          <a href={`#L-${g.letter}`} class="font-mono text-[11px] text-ac hover:text-ink text-center">{g.letter}</a>
        ))}
      </nav>

      <div id="gloss-list">
        {groups.map((g) => (
          <section>
            <h2 id={`L-${g.letter}`} class="font-mono text-[15px] font-bold text-ac border-b border-rule pb-1 mt-8 mb-2 scroll-mt-6">
              {g.letter}
            </h2>
            {g.rows.map((r) => (
              <a
                href={`/${lang}/glossary/${r.key}/`}
                class="gloss-row block py-3 border-t border-rule first:border-t-0 group"
                data-label={r.label.toLowerCase()}
                data-term={r.label}
                data-definition={r.definition ?? ""}
              >
                <span class="font-display font-bold text-ink text-[16px] group-hover:text-ac">{r.label}</span>
                {r.excerpt ? (
                  <span class="text-ink-2 text-[13.5px] ml-2">{r.excerpt}</span>
                ) : (
                  <span class="text-muted-2 text-[12px] italic ml-2">
                    {lang === "en" ? "definition pending" : "определение готовится"}
                  </span>
                )}
              </a>
            ))}
          </section>
        ))}
        <p id="gloss-empty" hidden class="text-muted py-8">
          {lang === "en" ? "No terms match." : "Ничего не найдено."}
        </p>
      </div>
    </div>
  </div>

  <aside
    id="gloss-deep-dive"
    class="gloss-deep-dive"
    role="dialog"
    aria-modal="false"
    aria-labelledby="gloss-deep-title"
    hidden
  >
    <header class="gloss-deep-head">
      <h2 id="gloss-deep-title" class="gloss-deep-title" tabindex="-1"></h2>
      <button
        type="button"
        class="gloss-deep-close"
        data-gloss-close
        aria-label={lang === "en" ? "Close Deep Dive" : "Закрыть Deep Dive"}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <div class="gloss-deep-tabs" role="tablist" aria-label={lang === "en" ? "Glossary sections" : "Разделы термина"}>
      <button type="button" class="gloss-deep-tab is-active" role="tab" aria-selected="true" data-gloss-tab="definition">
        {lang === "en" ? "Definition" : "Определение"}
      </button>
      <button type="button" class="gloss-deep-tab" role="tab" aria-selected="false" data-gloss-tab="deep">
        Deep Dive
      </button>
    </div>

    <div class="gloss-deep-scroll">
      <section id="gloss-deep-definition" class="gloss-definition-card">
        <p id="gloss-deep-definition-text" class="gloss-definition-text"></p>
        <button
          type="button"
          class="gloss-copy"
          data-gloss-copy
          aria-label={lang === "en" ? "Copy definition" : "Скопировать определение"}
          title={lang === "en" ? "Copy definition" : "Скопировать определение"}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="8" y="8" width="10" height="11" rx="1" />
            <path d="M16 8V5H6a1 1 0 0 0-1 1v10h3" />
          </svg>
        </button>
      </section>

      <div id="gloss-deep-senior" class="gloss-senior">
        <section class="gloss-lock-section">
          <div class="gloss-lock-heading">
            <h3>{lang === "en" ? "Why it matters at senior level" : "Почему это важно на senior-уровне"}</h3>
            <span class="gloss-supporter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2" /><rect x="5" y="10" width="14" height="10" rx="2" /></svg>Supporter</span>
          </div>
          <div class="gloss-blur-lines" aria-hidden="true"><i></i><i></i><i></i></div>
          <p class="gloss-unlocked-copy" hidden>
            {lang === "en" ? "Senior context for this term is not authored yet." : "Senior-контекст для этого термина ещё не подготовлен."}
          </p>
        </section>

        <section class="gloss-lock-section gloss-lock-section-long">
          <div class="gloss-lock-heading">
            <h3>{lang === "en" ? "Common pitfalls" : "Частые ошибки"}</h3>
            <span class="gloss-supporter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2" /><rect x="5" y="10" width="14" height="10" rx="2" /></svg>Supporter</span>
          </div>
          <div class="gloss-blur-lines gloss-blur-lines-long" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <p class="gloss-unlocked-copy" hidden>
            {lang === "en" ? "Pitfall notes for this term are not authored yet." : "Разбор частых ошибок для этого термина ещё не подготовлен."}
          </p>
        </section>

        <section class="gloss-lock-section">
          <div class="gloss-lock-heading">
            <h3>{lang === "en" ? "Where to learn in Skein" : "Где изучить в Skein"}</h3>
            <span class="gloss-supporter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2" /><rect x="5" y="10" width="14" height="10" rx="2" /></svg>Supporter</span>
          </div>
          <div class="gloss-blur-lines" aria-hidden="true"><i></i><i></i><i></i></div>
          <p class="gloss-unlocked-copy" hidden>
            <a id="gloss-deep-term-link" href={`/${lang}/glossary/`}>
              {lang === "en" ? "Open the term hub for lesson links and related concepts." : "Открыть страницу термина со ссылками на уроки и связанные понятия."}
            </a>
          </p>
        </section>
      </div>
    </div>

    <footer class="gloss-deep-footer">
      <a class="gloss-unlock" href={`/${lang}/settings#coach-plan`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2" /><rect x="5" y="10" width="14" height="10" rx="2" /></svg>
        {lang === "en" ? "Unlock Deep Dives" : "Открыть Deep Dives"}
      </a>
      <button type="button" class="gloss-keep-reading" data-gloss-close>
        {lang === "en" ? "Keep reading free definitions" : "Продолжить читать бесплатные определения"}
      </button>
    </footer>
  </aside>

  <script is:inline>
    (function () {
      var input = document.getElementById("gloss-search");
      var rows = Array.prototype.slice.call(document.querySelectorAll(".gloss-row"));
      var sections = Array.prototype.slice.call(document.querySelectorAll("#gloss-list section"));
      var empty = document.getElementById("gloss-empty");
      if (!input) return;
      input.addEventListener("input", function () {
        var q = input.value.trim().toLowerCase();
        var shown = 0;
        rows.forEach(function (row) {
          var hit = q === "" || row.getAttribute("data-label").indexOf(q) !== -1;
          row.hidden = !hit;
          if (hit) shown++;
        });
        sections.forEach(function (s) {
          var any = s.querySelectorAll(".gloss-row:not([hidden])").length > 0;
          s.hidden = !any;
          var h2 = s.querySelector("h2[id]");
          if (h2) {
            var link = document.querySelector('nav[aria-label] a[href="#' + h2.id + '"]');
            if (link) link.hidden = !any;
          }
        });
        if (empty) empty.hidden = shown !== 0;
      });

      var drawer = document.getElementById("gloss-deep-dive");
      var title = document.getElementById("gloss-deep-title");
      var definition = document.getElementById("gloss-deep-definition-text");
      var copyButton = drawer && drawer.querySelector("[data-gloss-copy]");
      var closeButtons = drawer ? Array.prototype.slice.call(drawer.querySelectorAll("[data-gloss-close]")) : [];
      var tabs = drawer ? Array.prototype.slice.call(drawer.querySelectorAll("[data-gloss-tab]")) : [];
      var termLink = document.getElementById("gloss-deep-term-link");
      var lastTrigger = null;
      var entitlementRequested = false;

      function setSupporter(unlocked) {
        if (!drawer) return;
        drawer.classList.toggle("is-supporter", unlocked);
        Array.prototype.slice.call(drawer.querySelectorAll(".gloss-unlocked-copy")).forEach(function (node) {
          node.hidden = !unlocked;
        });
      }

      function requestEntitlement() {
        if (entitlementRequested) return;
        entitlementRequested = true;
        fetch("/api/entitlements", { credentials: "same-origin" })
          .then(function (response) { return response.ok ? response.json() : null; })
          .then(function (status) { setSupporter(Boolean(status && status.entitlements && status.entitlements.coach)); })
          .catch(function () {});
      }

      function setTab(name) {
        tabs.forEach(function (tab) {
          var active = tab.getAttribute("data-gloss-tab") === name;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", active ? "true" : "false");
        });
      }

      function openDrawer(row) {
        if (!drawer || !title || !definition) return;
        lastTrigger = row;
        title.textContent = row.getAttribute("data-term") || "";
        definition.textContent = row.getAttribute("data-definition") || (document.documentElement.lang === "ru" ? "Определение готовится." : "Definition pending.");
        if (termLink) termLink.setAttribute("href", row.getAttribute("href") || `/${document.documentElement.lang}/glossary/`);
        drawer.hidden = false;
        requestEntitlement();
        setTab("definition");
        drawer.scrollTop = 0;
        var scroll = drawer.querySelector(".gloss-deep-scroll");
        if (scroll) scroll.scrollTop = 0;
        var close = drawer.querySelector(".gloss-deep-close");
        if (close) close.focus();
      }

      function closeDrawer() {
        if (!drawer || drawer.hidden) return;
        drawer.hidden = true;
        if (lastTrigger && document.contains(lastTrigger)) lastTrigger.focus();
      }

      rows.forEach(function (row) {
        row.addEventListener("click", function (event) {
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          openDrawer(row);
        });
      });

      closeButtons.forEach(function (button) { button.addEventListener("click", closeDrawer); });

      tabs.forEach(function (tab) {
        tab.addEventListener("click", function () {
          var name = tab.getAttribute("data-gloss-tab");
          setTab(name);
          var target = document.getElementById(name === "deep" ? "gloss-deep-senior" : "gloss-deep-definition");
          if (target) target.scrollIntoView({ block: "start", behavior: "smooth" });
        });
      });

      if (copyButton) {
        copyButton.addEventListener("click", function () {
          if (!definition || !definition.textContent || !navigator.clipboard) return;
          navigator.clipboard.writeText(definition.textContent).catch(function () {});
        });
      }

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && drawer && !drawer.hidden) closeDrawer();
      });
    })();
  </script>

  <style>
    :global(.oa-shell) { --rail-w-wide: 215px; }

    .glossary-page { transition: margin-right .18s ease; }

    .glossary-index-grid { margin-left: -48px; }

    .gloss-row {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .gloss-row > span { vertical-align: baseline; }

    .gloss-deep-dive {
      position: fixed;
      inset: 0 0 0 auto;
      z-index: 60;
      width: min(426px, 100vw);
      height: 100dvh;
      background: color-mix(in srgb, var(--paper) 96%, transparent);
      border-left: 1px solid var(--rule-strong);
      box-shadow: -14px 0 34px -28px rgba(26, 25, 22, .45);
      display: flex;
      flex-direction: column;
      backdrop-filter: blur(8px);
    }

    .gloss-deep-dive[hidden] { display: none; }

    .gloss-deep-head {
      min-height: 102px;
      padding: 23px 54px 20px 28px;
      border-bottom: 1px solid var(--rule-strong);
      position: relative;
      display: flex;
      align-items: center;
    }

    .gloss-deep-title {
      margin: 0;
      font-family: var(--font-display);
      font-size: 23px;
      line-height: 1.12;
      font-weight: 700;
      letter-spacing: -.02em;
      color: var(--ink);
      overflow-wrap: anywhere;
    }

    .gloss-deep-close {
      position: absolute;
      top: 21px;
      right: 20px;
      width: 36px;
      height: 36px;
      padding: 8px;
      border: 0;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }

    .gloss-deep-close:hover { background: var(--paper-2); }
    .gloss-deep-close svg, .gloss-copy svg, .gloss-supporter svg, .gloss-unlock svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .gloss-deep-tabs {
      min-height: 52px;
      display: flex;
      gap: 11px;
      align-items: stretch;
      padding: 0 16px;
      border-bottom: 1px solid var(--rule);
    }

    .gloss-deep-tab {
      position: relative;
      padding: 0 14px;
      border: 0;
      background: transparent;
      color: var(--muted-2);
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }

    .gloss-deep-tab.is-active { color: var(--ink); }
    .gloss-deep-tab.is-active::after {
      content: "";
      position: absolute;
      height: 2px;
      left: 0;
      right: 0;
      bottom: -1px;
      background: var(--accent-bright);
    }

    .gloss-deep-scroll {
      min-height: 0;
      flex: 1;
      overflow-y: auto;
      overscroll-behavior: contain;
      scroll-behavior: smooth;
    }

    .gloss-definition-card {
      position: relative;
      margin: 20px 14px 26px;
      min-height: 158px;
      padding: 31px 46px 26px 20px;
      border: 1px solid var(--rule);
      border-radius: 6px;
      background: color-mix(in srgb, var(--card) 55%, transparent);
      scroll-margin-top: 10px;
    }

    .gloss-definition-text {
      margin: 0;
      color: var(--ink-2);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.9;
    }

    .gloss-copy {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 30px;
      height: 30px;
      padding: 6px;
      border: 0;
      background: transparent;
      color: var(--muted-2);
      cursor: pointer;
    }

    .gloss-copy:hover { color: var(--ink); }

    .gloss-senior { padding: 0 14px; scroll-margin-top: 8px; }

    .gloss-lock-section {
      min-height: 186px;
      padding: 52px 7px 30px;
      border-top: 1px solid var(--rule);
    }

    .gloss-lock-section:first-child { border-top: 0; padding-top: 55px; }
    .gloss-lock-section-long { min-height: 218px; }

    .gloss-lock-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    .gloss-lock-heading h3 {
      margin: 0;
      color: var(--ink);
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.3;
      font-weight: 700;
    }

    .gloss-supporter {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex: 0 0 auto;
      padding: 6px 9px;
      border: 1px solid var(--rule);
      border-radius: 5px;
      color: var(--ink-2);
      font-family: var(--font-mono);
      font-size: 9.5px;
      line-height: 1;
    }

    .gloss-supporter svg { width: 13px; height: 13px; }

    .gloss-blur-lines {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 0 6px 0 4px;
      filter: blur(3.4px);
      opacity: .18;
      pointer-events: none;
    }

    .gloss-blur-lines i {
      display: block;
      height: 8px;
      border-radius: 999px;
      background: var(--ink);
    }

    .gloss-blur-lines i:nth-child(1) { width: 94%; }
    .gloss-blur-lines i:nth-child(2) { width: 78%; }
    .gloss-blur-lines i:nth-child(3) { width: 88%; }
    .gloss-blur-lines-long i:nth-child(4) { width: 71%; }

    .gloss-unlocked-copy {
      margin: 0 4px;
      color: var(--ink-2);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.65;
    }

    .gloss-unlocked-copy a { color: var(--accent-bright); }
    .gloss-deep-dive.is-supporter .gloss-supporter,
    .gloss-deep-dive.is-supporter .gloss-blur-lines,
    .gloss-deep-dive.is-supporter .gloss-deep-footer { display: none; }

    .gloss-deep-footer {
      padding: 18px 20px 90px;
      background: color-mix(in srgb, var(--paper) 96%, transparent);
    }

    .gloss-unlock {
      min-height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      border: 1px solid var(--accent-bright);
      border-radius: 4px;
      background: var(--accent-bright);
      color: white;
      font-family: var(--font-mono);
      font-size: 12px;
      text-decoration: none;
    }

    .gloss-unlock:hover { filter: brightness(.94); text-decoration: none; }
    .gloss-unlock svg { width: 17px; height: 17px; }

    .gloss-keep-reading {
      display: block;
      margin: 17px auto 0;
      padding: 0;
      border: 0;
      border-bottom: 1px solid currentColor;
      background: transparent;
      color: var(--accent-bright);
      font-size: 11px;
      line-height: 1.4;
      cursor: pointer;
    }

    @media (max-width: 719px) {
      .gloss-deep-dive { width: 100vw; }
      .gloss-deep-head { min-height: 86px; }
      .gloss-definition-card { min-height: 138px; }
      .glossary-index-grid { margin-left: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .glossary-page, .gloss-deep-scroll { transition: none; scroll-behavior: auto; }
    }
  </style>
</Topic>
