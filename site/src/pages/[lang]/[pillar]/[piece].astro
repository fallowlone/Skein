---
import { getCollection, render } from "astro:content";
import Chapter from "../../../layouts/Chapter.astro";
import { type Locale, isLocale, t } from "../../../i18n";

export async function getStaticPaths() {
  const all = await getCollection("book");
  return all.map((entry) => ({
    params: {
      lang: entry.data.lang,
      pillar: entry.data.pillar,
      piece: entry.data.slug,
    },
    props: { entry },
  }));
}

const { lang, pillar } = Astro.params as {
  lang: Locale;
  pillar: string;
  piece: string;
};
if (!isLocale(lang)) throw new Error("bad lang");

const { entry } = Astro.props;
const { Content } = await render(entry);

const chapter = (await getCollection("chapters")).find(
  (c) => c.data.slug === entry.data.chapter
);
---

<Chapter
  title={entry.data.title}
  lang={lang}
  pillarSlug={entry.data.pillar}
  chapterSlug={entry.data.chapter}
  currentPiece={entry.data.slug}
  sources={entry.data.sources}
  depth={entry.data.depth}
>
  {entry.data.status === "stub" ? (
    <div class="rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 px-8 py-10 text-center">
      <div class="text-2xl font-extrabold text-bbg-ink mb-2">
        {t("stub.heading", lang)}
      </div>
      <p class="text-bbg-muted">{t("stub.body", lang)}</p>
      {chapter && (
        <p class="mt-4 text-bbg-ink">
          <strong>Crux:</strong> {chapter.data.crux[lang]}
        </p>
      )}
    </div>
  ) : (
    <Content />
  )}
</Chapter>
