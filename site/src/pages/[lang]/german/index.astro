---
import Topic from "~/layouts/Topic.astro";
import GermanDashboard from "~/components/german/GermanDashboard.tsx";
import Today from "~/components/german/Today.tsx";
import { type Locale, isLocale, t } from "~/i18n";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ru" } }];
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error("bad lang");
const L = lang === "en"
  ? { today: "Today", lede: "German for Engineers" }
  : { today: "Сегодня", lede: "Немецкий для инженеров" };
---
<Topic title={t("nav.german", lang)} lang={lang}>
  <div class="max-w-[760px] mx-auto mb-10">
    <div class="meta mb-2">{t("nav.german", lang)}</div>
    <h1 class="font-display text-[32px] font-bold tracking-[-0.015em] m-0 text-ink mb-1">{L.lede}</h1>
  </div>

  <section class="mb-12">
    <GermanDashboard client:visible lang={lang} />
  </section>

  <section class="mb-14">
    <div class="meta mb-4 max-w-[620px] mx-auto">{L.today}</div>
    <Today client:visible lang={lang} />
  </section>
</Topic>
