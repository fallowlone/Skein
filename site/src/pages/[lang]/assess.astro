---
// [assess-engine-replan] evidence model C1-C4 — page exists, paths empty, UI gated
// site/src/pages/[lang]/assess.astro
import Atlas from "~/layouts/Atlas.astro";
import AssessFlow from "~/components/assess/AssessFlow.tsx";
import { isLocale, t, type Locale } from "~/i18n";
import "~/styles/assess-screen.css";

// [assess-engine-replan] no paths — evidence model C1-C4, merged surface-gated
export function getStaticPaths() {
  return [];
}

const params = Astro.params as { lang?: string };
const lang: Locale = params.lang && isLocale(params.lang) ? params.lang : "en";
---

<Atlas title={t("assess.title", lang)} lang={lang} description={t("assess.blurb", lang)}>
  <div class="oa-wrap" style="padding-bottom: var(--s-9);">
    <header class="poster-head">
      <p class="ph-kicker"><span>№00</span><span>{t("assess.kicker", lang)}</span></p>
      <h1 class="poster-giant poster-page-size" style="margin-top: var(--s-4);">
        <span class="pg-solid">{t("assess.title", lang)}</span>
      </h1>
      <p class="ph-blurb">{t("assess.blurb", lang)}</p>
    </header>
    <AssessFlow client:only="preact" lang={lang} />
  </div>
</Atlas>
