---
import { getCollection, getEntry } from "astro:content";
import Lesson from "~/layouts/Lesson.astro";
import AstEN, { frontmatter as AstMetaEN } from "~/content/lessons/en/js-engine/01-how-js-runs/01-source-to-ast/index.mdx";
import AstRU, { frontmatter as AstMetaRU } from "~/content/lessons/ru/js-engine/01-how-js-runs/01-source-to-ast/index.mdx";
import LazyEN, { frontmatter as LazyMetaEN } from "~/content/lessons/en/js-engine/01-how-js-runs/02-lazy-parsing/index.mdx";
import LazyRU, { frontmatter as LazyMetaRU } from "~/content/lessons/ru/js-engine/01-how-js-runs/02-lazy-parsing/index.mdx";
import DispatchEN, { frontmatter as DispatchMetaEN } from "~/content/lessons/en/js-engine/01-how-js-runs/04-interpreter-loop/index.mdx";
import DispatchRU, { frontmatter as DispatchMetaRU } from "~/content/lessons/ru/js-engine/01-how-js-runs/04-interpreter-loop/index.mdx";
import ShapeEN, { frontmatter as ShapeMetaEN } from "~/content/lessons/en/js-engine/03-hidden-classes/02-shape-transitions/index.mdx";
import ShapeRU, { frontmatter as ShapeMetaRU } from "~/content/lessons/ru/js-engine/03-hidden-classes/02-shape-transitions/index.mdx";
import IcEN, { frontmatter as IcMetaEN } from "~/content/lessons/en/js-engine/03-hidden-classes/04-inline-caches/index.mdx";
import IcRU, { frontmatter as IcMetaRU } from "~/content/lessons/ru/js-engine/03-hidden-classes/04-inline-caches/index.mdx";
import DeoptEN, { frontmatter as DeoptMetaEN } from "~/content/lessons/en/js-engine/04-the-jit/05-deoptimization/index.mdx";
import DeoptRU, { frontmatter as DeoptMetaRU } from "~/content/lessons/ru/js-engine/04-the-jit/05-deoptimization/index.mdx";
import EventLoopEN, { frontmatter as EventLoopMetaEN } from "~/content/lessons/en/js-engine/07-async-deep/01-event-loop-recap/index.mdx";
import EventLoopRU, { frontmatter as EventLoopMetaRU } from "~/content/lessons/ru/js-engine/07-async-deep/01-event-loop-recap/index.mdx";
import IgnitionEN, { frontmatter as IgnitionMetaEN } from "~/content/lessons/en/js-engine/01-how-js-runs/03-ignition-bytecode/index.mdx";
import IgnitionRU, { frontmatter as IgnitionMetaRU } from "~/content/lessons/ru/js-engine/01-how-js-runs/03-ignition-bytecode/index.mdx";
import ValueEN, { frontmatter as ValueMetaEN } from "~/content/lessons/en/js-engine/02-values-and-memory/01-value-representation/index.mdx";
import ValueRU, { frontmatter as ValueMetaRU } from "~/content/lessons/ru/js-engine/02-values-and-memory/01-value-representation/index.mdx";
import SmiEN, { frontmatter as SmiMetaEN } from "~/content/lessons/en/js-engine/02-values-and-memory/02-smis-and-doubles/index.mdx";
import SmiRU, { frontmatter as SmiMetaRU } from "~/content/lessons/ru/js-engine/02-values-and-memory/02-smis-and-doubles/index.mdx";
import PointerEN, { frontmatter as PointerMetaEN } from "~/content/lessons/en/js-engine/02-values-and-memory/03-pointer-tagging/index.mdx";
import PointerRU, { frontmatter as PointerMetaRU } from "~/content/lessons/ru/js-engine/02-values-and-memory/03-pointer-tagging/index.mdx";
import MapsEN, { frontmatter as MapsMetaEN } from "~/content/lessons/en/js-engine/03-hidden-classes/01-shapes-and-maps/index.mdx";
import MapsRU, { frontmatter as MapsMetaRU } from "~/content/lessons/ru/js-engine/03-hidden-classes/01-shapes-and-maps/index.mdx";
import lessonGraph from "~/content/path/lesson-graph.json";
import { indexedLessons } from "~/scripts/lesson-index";

const previews = {
  "js-engine/01-how-js-runs/01-source-to-ast": { en: [AstEN, AstMetaEN], ru: [AstRU, AstMetaRU] },
  "js-engine/01-how-js-runs/02-lazy-parsing": { en: [LazyEN, LazyMetaEN], ru: [LazyRU, LazyMetaRU] },
  "js-engine/01-how-js-runs/03-ignition-bytecode": { en: [IgnitionEN, IgnitionMetaEN], ru: [IgnitionRU, IgnitionMetaRU] },
  "js-engine/01-how-js-runs/04-interpreter-loop": { en: [DispatchEN, DispatchMetaEN], ru: [DispatchRU, DispatchMetaRU] },
  "js-engine/02-values-and-memory/01-value-representation": { en: [ValueEN, ValueMetaEN], ru: [ValueRU, ValueMetaRU] },
  "js-engine/02-values-and-memory/02-smis-and-doubles": { en: [SmiEN, SmiMetaEN], ru: [SmiRU, SmiMetaRU] },
  "js-engine/02-values-and-memory/03-pointer-tagging": { en: [PointerEN, PointerMetaEN], ru: [PointerRU, PointerMetaRU] },
  "js-engine/03-hidden-classes/01-shapes-and-maps": { en: [MapsEN, MapsMetaEN], ru: [MapsRU, MapsMetaRU] },
  "js-engine/03-hidden-classes/02-shape-transitions": { en: [ShapeEN, ShapeMetaEN], ru: [ShapeRU, ShapeMetaRU] },
  "js-engine/03-hidden-classes/04-inline-caches": { en: [IcEN, IcMetaEN], ru: [IcRU, IcMetaRU] },
  "js-engine/04-the-jit/05-deoptimization": { en: [DeoptEN, DeoptMetaEN], ru: [DeoptRU, DeoptMetaRU] },
  "js-engine/07-async-deep/01-event-loop-recap": { en: [EventLoopEN, EventLoopMetaEN], ru: [EventLoopRU, EventLoopMetaRU] },
} as const;

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [
    "js-engine/01-how-js-runs/01-source-to-ast",
    "js-engine/01-how-js-runs/02-lazy-parsing",
    "js-engine/01-how-js-runs/03-ignition-bytecode",
    "js-engine/01-how-js-runs/04-interpreter-loop",
    "js-engine/02-values-and-memory/01-value-representation",
    "js-engine/02-values-and-memory/02-smis-and-doubles",
    "js-engine/02-values-and-memory/03-pointer-tagging",
    "js-engine/03-hidden-classes/01-shapes-and-maps",
    "js-engine/03-hidden-classes/02-shape-transitions",
    "js-engine/03-hidden-classes/04-inline-caches",
    "js-engine/04-the-jit/05-deoptimization",
    "js-engine/07-async-deep/01-event-loop-recap",
  ].flatMap((key) => {
    const [track, unit, lesson] = key.split("/");
    return ["en", "ru"].map((lang) => ({ params: { lang, track, unit, lesson } }));
  });
}

const { track, unit, lesson } = Astro.params;
const key = `${track}/${unit}/${lesson}` as keyof typeof previews;
const lang = (Astro.params.lang === "ru" ? "ru" : "en") as "en" | "ru";
const selected = previews[key]?.[lang];
if (!selected) throw new Error(`Unknown local lesson preview: ${key}`);
const [Content, meta] = selected;
const [tracks, units, practice] = await Promise.all([
  getCollection("tracks"),
  getCollection("units"),
  getEntry("practice", key),
]);
const trackData = tracks.find((entry) => entry.data.slug === track)?.data;
const unitData = units.find((entry) => entry.data.track === track && entry.data.slug === unit)?.data;
const lessonMeta = Object.fromEntries(indexedLessons(lang).map((entry) => [
  `${entry.track}/${entry.unit}/${entry.slug}`,
  { title: entry.title, track: entry.track, unit: entry.unit, slug: entry.slug },
]));
---

<Lesson
  title={meta.title}
  lang={lang}
  trackSlug={track!}
  unitSlug={unit!}
  slug={lesson!}
  summary={meta.summary}
  estMin={meta.estMin}
  order={meta.order}
  sources={meta.sources}
  lessonType={meta.lessonType}
  level={meta.level}
  lessonKey={key}
  prereqs={meta.prereqs}
  practice={practice?.data.tasks ?? null}
  concepts={meta.concepts}
  runtime={{
    track: trackData,
    unit: unitData,
    graph: lessonGraph[key as keyof typeof lessonGraph],
    lessonMeta,
  }}
>
  <Content />
</Lesson>
