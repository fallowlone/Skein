---
import Atlas from "~/layouts/Atlas.astro";
import { getCollection } from "astro:content";
import { type Locale, isLocale } from "~/i18n";
import { nextTrackByOrder } from "~/components/atlas/next-track";
import { selectOther } from "~/scripts/build-incremental";
import { t } from "~/i18n";
import { projectFeedsFrom, projectsForTrack } from "~/scripts/project-index";

export async function getStaticPaths() {
  const tracks = await getCollection("tracks");
  return selectOther(
    tracks.flatMap((tr) =>
      (["en", "ru"] as const).map((lang) => ({
        params: { lang, track: tr.data.slug },
      })),
    ),
  );
}

const { lang, track } = Astro.params as { lang: Locale; track: string };
if (!isLocale(lang)) throw new Error("bad lang");

const allTracks = await getCollection("tracks");
const trackEntry = allTracks.find((t) => t.data.slug === track);
if (!trackEntry) throw new Error(`Unknown track: ${track}`);

const units = (await getCollection("units"))
  .filter((u) => u.data.track === track)
  .sort((a, b) => a.data.order - b.data.order);

const allLessons = await getCollection("lessons", (l) => l.data.lang === lang && l.data.track === track);
const lessonByKey = new Map(allLessons.map((l) => [`${l.data.unit}/${l.data.slug}`, l]));
const lessonCount = units.reduce((acc, u) => acc + u.data.lessons.length, 0);
const totalMin = allLessons.reduce((acc, l) => acc + l.data.estMin, 0);
const trackHours = Math.max(1, Math.round(totalMin / 60));

const tracksLite = allTracks
  .map((t) => ({ slug: t.data.slug, order: t.data.order, title: t.data.title[lang], blurb: t.data.blurb[lang] }))
  .sort((a, b) => a.order - b.order);
const next = nextTrackByOrder(tracksLite, trackEntry.data.order);

const hasLab = (await getCollection("lab")).some((l) => l.data.track === track);

// W2.4b — guided projects related to this track (via `tracks` or feedsFrom).
const allProjects = await getCollection("projects");
const projectsLite = allProjects.map((p) => ({
  slug: p.data.slug,
  tracks: p.data.tracks,
  feedsFrom: projectFeedsFrom(p.data),
}));
const projectBySlug = new Map(allProjects.map((p) => [p.data.slug, p]));
const trackProjects = projectsForTrack(projectsLite, track)
  .map((s) => projectBySlug.get(s))
  .filter((p): p is NonNullable<typeof p> => p != null)
  .map((p) => ({ slug: p.data.slug, title: p.data.title[lang], pitch: p.data.pitch[lang] }));
const labLabel = lang === "en" ? "Open the Mastery Lab" : "Открыть Лабораторию мастерства";
const labBlurb = lang === "en"
  ? "Curated hands-on challenges: build, diagnose, master."
  : "Курируемые hands-on челленджи: строй, диагностируй, овладей.";

const firstUnit = units[0];
const firstLessonSlug = firstUnit?.data.lessons[0];
const firstLessonHref = firstLessonSlug && firstUnit
  ? `/${lang}/learn/${track}/${firstUnit.data.slug}/${firstLessonSlug}/`
  : `/${lang}/learn/${track}/`;

const DOMAIN: Record<string, string> = {
  lilac: "var(--d-network)", mint: "var(--d-data)", peach: "var(--d-frontend)",
  sky: "var(--d-backend)", rose: "var(--d-ai)",
};
const dvar = DOMAIN[trackEntry.data.color] ?? "var(--accent)";

// Map track color to the CSS variable name suffix used in --d-* tokens.
const HUE_VAR: Record<string, string> = {
  lilac: "d-network", mint: "d-data", peach: "d-frontend",
  sky: "d-backend", rose: "d-ai",
};
const hueVar = HUE_VAR[trackEntry.data.color] ?? "accent";

// Practice task counts by lessonKey for client-side state derivation.
const practiceByKey = new Map(
  (await getCollection("practice")).map((p) => [p.data.lessonKey, p.data.tasks.length])
);

const L = {
  start: lang === "en" ? "Start track" : "Начать трек",
  units: lang === "en" ? "units" : "юнитов",
  lessons: lang === "en" ? "lessons" : "уроков",
  min: lang === "en" ? "min" : "мин",
  hours: lang === "en" ? "h" : "ч",
  nextUp: lang === "en" ? "Next track" : "Следующий трек",
};
---

<Atlas title={trackEntry.data.title[lang]} lang={lang}>
  <div class="oa-wrap-narrow" style="padding-bottom: var(--s-9);">
    <header class="oa-pagehead">
      <p class="kicker"><span class="domain-tag" style={`--d: ${dvar};`}><span class="sq"></span>{track}</span></p>
      <h1 style="margin-top: var(--s-4);">{trackEntry.data.title[lang]}</h1>
      <p class="ph-blurb">{trackEntry.data.blurb[lang]}</p>
      <p class="ph-meta">
        <span>{units.length} {L.units}</span><span>·</span><span>{lessonCount} {L.lessons}</span><span>·</span><span>~{trackHours} {L.hours}</span>
      </p>
      <a class="oa-btn oa-btn-primary" href={firstLessonHref} style="margin-top: var(--s-5);">
        {L.start} <span class="arrow">→</span>
      </a>
    </header>

    {hasLab ? (
      <a class="track-card" href={`/${lang}/learn/${track}/lab/`} style="margin-top: var(--s-5);">
        <div class="tc-meta"><span class="tc-num">★ Lab</span></div>
        <h4>{labLabel}</h4>
        <p class="tc-blurb">{labBlurb}</p>
      </a>
    ) : null}

    <div data-track={track} data-lang={lang}>
      {units.map((u) => (
        <section class="oa-unit" data-unit={u.data.slug} style={`--d:var(--${hueVar})`}>
          <div class="oa-unit-head">
            <span class="u-num">{String(u.data.order).padStart(2, "0")}</span>
            <h3 class="u-name-text">{u.data.title[lang]}</h3>
            <span class="u-crux">{u.data.crux[lang]}</span>
            <span class="u-count"></span>
          </div>
          <div class="u-track" data-track-roll></div>
          <div class="oa-lessons">
            {u.data.lessons.map((slug, idx) => {
              const entry = lessonByKey.get(`${u.data.slug}/${slug}`);
              const lessonKey = `${track}/${u.data.slug}/${slug}`;
              const taskCount = practiceByKey.get(lessonKey) ?? 0;
              const prereqs = entry?.data.prereqs ?? [];
              return (
                <a
                  class="oa-lesson"
                  href={`/${lang}/learn/${track}/${u.data.slug}/${slug}/`}
                  data-key={lessonKey}
                  data-slug={slug}
                  data-tasks={taskCount}
                  data-prereqs={JSON.stringify(prereqs)}
                >
                  <span class="l-num">{String(idx + 1).padStart(2, "0")}</span>
                  <span class="l-mid">
                    <span class="l-title">{entry?.data.title ?? slug}</span>
                  </span>
                  {entry?.data.estMin ? <span class="l-min">{entry.data.estMin} {L.min}</span> : null}
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    {trackProjects.length > 0 ? (
      <section class="track-projects" style="margin-top: var(--s-7);">
        <div class="tp-head">
          <h3>{t("track.projects.heading", lang)}</h3>
          <p class="tp-sub">{t("track.projects.sub", lang)}</p>
        </div>
        <div class="tp-list">
          {trackProjects.map((p) => (
            <a class="track-card tp-card" href={`/${lang}/projects/${p.slug}`}>
              <div class="tc-meta"><span class="tc-num">◆ {t("nav.projects", lang)}</span></div>
              <h4>{p.title}</h4>
              <p class="tc-blurb">{p.pitch}</p>
            </a>
          ))}
        </div>
      </section>
    ) : null}

    {next ? (
      <a class="track-card" href={`/${lang}/learn/${next.slug}/`} style="margin-top: var(--s-7);">
        <div class="tc-meta"><span class="tc-num">{L.nextUp}</span></div>
        <h4>{next.title}</h4>
        <p class="tc-blurb">{next.blurb}</p>
      </a>
    ) : null}
  </div>
</Atlas>

<style>
  .track-projects { display: block; }
  .tp-head { margin-bottom: var(--s-4); }
  .tp-head h3 { margin: 0; }
  .tp-sub {
    margin: var(--s-2) 0 0; color: var(--muted);
    font-size: var(--fs-small);
  }
  .tp-list { display: grid; gap: var(--s-3); }
  .tp-card { margin-top: 0 !important; }
</style>

<style is:global>
  /* ── Lesson-states overlay — scoped under .oa-unit to avoid .oa-lesson on the
        recommended list in learn/index.astro. The base atlas-kit.css .oa-lesson
        flex layout is preserved on non-unit contexts.
     ──────────────────────────────────────────────────────────────────────────── */

  /* Row grid — overrides atlas-kit flex only inside a unit */
  .oa-unit .oa-lesson {
    position: relative;
    display: grid;
    grid-template-columns: 24px 1fr auto;
    align-items: center;
    gap: var(--s-3);
    padding: 10px var(--s-4);
    background: var(--card);
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease),
      background var(--dur-1) var(--ease),
      box-shadow var(--dur-1) var(--ease);
  }
  .oa-unit .oa-lesson:hover { text-decoration: none; }
  .oa-unit a.oa-lesson { cursor: pointer; }
  .oa-unit a.oa-lesson:hover {
    background: var(--card-2);
    border-color: var(--hairline-strong);
  }
  .oa-unit .oa-lesson:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--r-sm);
  }

  /* gap between rows */
  .oa-unit .oa-lessons {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 0;
  }

  /* ── Marker slot ── */
  .oa-unit .oa-lesson .l-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
    text-align: center;
    width: 24px;
    letter-spacing: 0.02em;
    min-width: unset;
  }
  .oa-unit .oa-lesson .l-check,
  .oa-unit .oa-lesson .l-lock {
    width: 24px;
    display: grid;
    place-items: center;
  }
  .oa-unit .oa-lesson .l-check svg { width: 17px; height: 17px; color: var(--ok); }
  .oa-unit .oa-lesson .l-lock svg { width: 15px; height: 15px; color: var(--faint); }

  /* ── Body ── */
  .oa-unit .oa-lesson .l-mid {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .oa-unit .oa-lesson .l-title {
    font-family: var(--font-display);
    font-size: var(--fs-h6);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: var(--ink);
    flex: unset;
  }
  .oa-unit .oa-lesson .l-sub {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .oa-unit .oa-lesson .l-min {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--faint);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ── Fraction bar ── */
  .oa-unit .l-frac {
    width: 30px;
    height: 5px;
    border-radius: var(--r-pill);
    flex-shrink: 0;
    background: color-mix(in srgb, var(--ink) 12%, transparent);
    overflow: hidden;
  }
  .oa-unit .l-frac > i {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: inherit;
  }

  /* ── Review badge ── */
  .oa-unit .l-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: var(--r-sm);
    border: 0.5px solid currentColor;
    line-height: 1.3;
    white-space: nowrap;
  }
  .oa-unit .l-badge .bdot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }
  .oa-unit .l-badge.review { color: var(--warn); }

  /* ── Current marker ── */
  .oa-unit .l-cur {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
  }
  .oa-unit .l-cur .cur-mark { font-size: 11px; }

  /* ── State 2 · IN PROGRESS ── */
  .oa-unit .oa-lesson.is-inprogress .l-sub { color: var(--accent-2); }
  .oa-unit .oa-lesson.is-inprogress .l-frac {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  /* ── State 3 · COMPLETED ── */
  .oa-unit .oa-lesson.is-completed {
    background: color-mix(in srgb, var(--ok) 5%, var(--card));
    border-color: color-mix(in srgb, var(--ok) 24%, var(--hairline-2));
  }
  .oa-unit .oa-lesson.is-completed .l-title { color: var(--ink-2); }
  .oa-unit .oa-lesson.is-completed .l-sub {
    color: color-mix(in srgb, var(--ok) 65%, var(--muted));
  }
  .oa-unit .oa-lesson.is-completed .l-min { color: var(--faint); }
  .oa-unit a.oa-lesson.is-completed:hover {
    border-color: color-mix(in srgb, var(--ok) 42%, transparent);
  }

  /* ── State 4 · DUE FOR REVIEW ── */
  .oa-unit .oa-lesson.is-due {
    background: color-mix(in srgb, var(--ok) 4%, var(--card));
  }
  .oa-unit .oa-lesson.is-due .l-sub { color: var(--muted); }
  .oa-unit a.oa-lesson.is-due:hover {
    border-color: color-mix(in srgb, var(--warn) 45%, transparent);
  }

  /* ── State 5 · CURRENT ── */
  .oa-unit .oa-lesson.is-current { box-shadow: inset 2px 0 0 var(--accent); }
  .oa-unit .oa-lesson.is-current.is-completed { box-shadow: inset 2px 0 0 var(--accent); }

  /* ── State 6 · LOCKED ── */
  .oa-unit .oa-lesson.is-locked {
    border-style: dashed;
    background: transparent;
    opacity: 0.72;
    cursor: not-allowed;
  }
  .oa-unit .oa-lesson.is-locked .l-title { color: var(--muted); }
  .oa-unit .oa-lesson.is-locked .l-sub { color: var(--faint); }

  /* ── Unit rollup: u-count + u-track (inside .oa-unit-head) ── */
  .oa-unit .u-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .oa-unit .u-count b { color: var(--ink); font-weight: 600; }

  /* Segmented track bar — shown between unit header and lesson list */
  .oa-unit .u-track {
    display: flex;
    gap: 3px;
    margin-bottom: var(--s-2);
  }
  .oa-unit .u-track:empty { display: none; }
  .oa-unit .u-seg {
    flex: 1;
    height: 4px;
    border-radius: 1px;
    position: relative;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .oa-unit .u-seg.done { background: var(--ok); }
  .oa-unit .u-seg.partial > i {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--p, 50%);
    background: var(--accent);
  }
  .oa-unit .u-seg.due { background: var(--ok); }
  .oa-unit .u-seg.due::after {
    content: "";
    position: absolute;
    top: 0; bottom: 0; right: 0;
    width: 34%;
    background: var(--warn);
  }
  .oa-unit .u-seg.locked {
    background: repeating-linear-gradient(
      45deg,
      transparent 0 3px,
      color-mix(in srgb, var(--ink) 12%, transparent) 3px 6px
    );
  }

  /* Fully-completed unit */
  .oa-unit.is-done {
    background: color-mix(in srgb, var(--ok) 5%, var(--card));
    border-color: color-mix(in srgb, var(--ok) 26%, var(--hairline-2));
    box-shadow: inset 2px 0 0 var(--ok);
  }
  .oa-unit.is-done .u-name-text { color: var(--ink-2); }

  .oa-unit .u-check {
    width: 17px;
    height: 17px;
    color: var(--ok);
    display: inline-block;
    vertical-align: middle;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const root = document.querySelector<HTMLElement>("[data-track][data-lang]");
    if (!root) return;

    const lang = root.dataset.lang ?? "en";
    const track = root.dataset.track ?? "";

    // ── i18n strings ──
    const i18n = {
      banked:       lang === "ru" ? "сдано"          : "banked",
      current:      lang === "ru" ? "текущий"        : "current",
      reviewDue:    lang === "ru" ? "пора повторить" : "review due",
      locked:       lang === "ru" ? "заблокирован"   : "locked",
      doneWord:     lang === "ru" ? "готово"         : "done",
      practiceFrac: (d: number, t: number) =>
        lang === "ru" ? `${d} / ${t} практики` : `${d} / ${t} practice`,
    };

    // ── Inline SVG strings ──
    const CHECK_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>`;
    const LOCK_SVG  = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="10.5" width="14" height="9" rx="1.6"/><path d="M8 10.5V7.2a4 4 0 018 0v3.3"/></svg>`;

    // ── Read stores (guard JSON.parse, tolerate missing) ──
    let history: Record<string, unknown> = {};
    let reviewStore: Record<string, { lessonKey: string; dueAt: number }> = {};
    let lastSlug = "";

    try {
      const raw = localStorage.getItem("awesome.user-state.v1");
      if (raw) {
        const parsed = JSON.parse(raw) as { history?: Record<string, unknown> };
        history = parsed.history ?? {};
      }
    } catch { /* tolerate */ }

    try {
      const raw = localStorage.getItem("atlas.review.v1");
      if (raw) {
        reviewStore = JSON.parse(raw) as Record<string, { lessonKey: string; dueAt: number }>;
      }
    } catch { /* tolerate */ }

    try {
      const raw = localStorage.getItem(`atlas.last.${lang}.${track}`);
      if (raw) {
        const parsed = JSON.parse(raw) as { slug?: string };
        lastSlug = parsed.slug ?? "";
      }
    } catch { /* tolerate */ }

    const now = Date.now();

    // ── Per-lesson practice stores ──
    const allRows = Array.from(root.querySelectorAll<HTMLElement>(".oa-lesson"));

    // Build per-row state in two passes (locked needs completed-set from first pass).
    type RowState = {
      el: HTMLElement;
      slug: string;
      key: string;
      tasks: number;
      prereqs: string[];
      completed: boolean;
      due: boolean;
      inprogress: boolean;
      isCurrent: boolean;
      doneCount: number;
    };

    const states: RowState[] = allRows.map((el) => {
      const slug     = el.dataset.slug ?? "";
      const key      = el.dataset.key  ?? "";
      const tasks    = Number(el.dataset.tasks ?? 0);
      const prereqs  = (() => {
        try { return JSON.parse(el.dataset.prereqs ?? "[]") as string[]; }
        catch { return [] as string[]; }
      })();

      const visited = slug in history;

      // Practice tasks from per-lesson store
      let doneCount = 0;
      try {
        const pRaw = localStorage.getItem(`atlas.practice.${key}`);
        if (pRaw) {
          const pData = JSON.parse(pRaw) as Record<string, string>;
          doneCount = Object.values(pData).filter((v) => v === "done").length;
        }
      } catch { /* tolerate */ }

      const completed  = tasks > 0 && doneCount >= tasks;
      const reviewDue  = Object.values(reviewStore).some(
        (c) => c.lessonKey === key && c.dueAt <= now,
      );
      const due        = completed && reviewDue;
      const inprogress = !completed && visited;
      const isCurrent  = lastSlug !== "" && lastSlug === slug;

      return { el, slug, key, tasks, prereqs, completed, due, inprogress, isCurrent, doneCount };
    });

    // Completed slug set for prereq checks
    const completedSlugs = new Set(states.filter((s) => s.completed).map((s) => s.slug));

    // A unit's assessment lessons (quiz-*/project/capstone) carry no prereqs of their own,
    // so they would always be open even inside a locked unit. Gate them by concept progress:
    // they unlock only once every concept lesson of the same unit is completed. Concept lessons
    // are numeric-prefixed (`NN-…`); assessments are not — a content-agnostic signal.
    const isAssessment = (slug: string) => /^(quiz|project|capstone|drill|exam|recall)/.test(slug);
    const unitOfKey = (key: string) => key.split("/")[1] ?? "";
    const unitConceptsDone = new Map<string, boolean>();
    {
      const byUnit = new Map<string, RowState[]>();
      for (const s of states) {
        const u = unitOfKey(s.key);
        const arr = byUnit.get(u);
        if (arr) arr.push(s);
        else byUnit.set(u, [s]);
      }
      for (const [u, rows] of byUnit) {
        const concepts = rows.filter((r) => !isAssessment(r.slug));
        // No concept lessons in the unit → nothing to gate behind; leave assessments open.
        unitConceptsDone.set(u, concepts.length === 0 || concepts.every((r) => r.completed));
      }
    }

    // ── Apply DOM mutations per row ──
    for (const s of states) {
      const { el, slug, tasks, prereqs, completed, due, inprogress, isCurrent, doneCount } = s;

      // locked = (concept) has an unmet prereq, OR (assessment) its unit's concepts aren't all done
      const prereqLock = prereqs.length > 0 && prereqs.some((p) => !completedSlugs.has(p));
      const assessLock = isAssessment(slug) && unitConceptsDone.get(unitOfKey(s.key)) === false;
      const isLocked = prereqLock || assessLock;

      // Apply state classes
      if (isLocked) {
        el.classList.add("is-locked");
        el.setAttribute("aria-disabled", "true");
        el.setAttribute("tabindex", "-1");
        // If it's an anchor, prevent navigation
        if (el.tagName === "A") {
          el.addEventListener("click", (e) => { e.preventDefault(); }, { capture: true });
        }
      } else {
        if (completed) el.classList.add("is-completed");
        if (due)       el.classList.add("is-due");
        if (inprogress) el.classList.add("is-inprogress");
        if (isCurrent) el.classList.add("is-current");
      }

      // Swap marker
      const numEl = el.querySelector(".l-num");
      if (isLocked && numEl) {
        const lockSpan = document.createElement("span");
        lockSpan.className = "l-lock";
        lockSpan.innerHTML = LOCK_SVG;
        numEl.replaceWith(lockSpan);
      } else if (completed && numEl) {
        const checkSpan = document.createElement("span");
        checkSpan.className = "l-check";
        checkSpan.innerHTML = CHECK_SVG;
        numEl.replaceWith(checkSpan);
      }

      // Inject .l-sub content
      const midEl = el.querySelector(".l-mid");
      if (!midEl) continue;

      if (isLocked) {
        const sub = document.createElement("span");
        sub.className = "l-sub";
        sub.textContent = i18n.locked;
        midEl.appendChild(sub);
      } else if (due) {
        const sub = document.createElement("span");
        sub.className = "l-sub";
        sub.innerHTML = `<span class="l-badge review"><span class="bdot"></span>${i18n.reviewDue}</span>`;
        midEl.appendChild(sub);
      } else if (completed) {
        const sub = document.createElement("span");
        sub.className = "l-sub";
        sub.textContent = i18n.banked;
        midEl.appendChild(sub);
      } else {
        // Build sub for in-progress / current
        const parts: string[] = [];
        if (isCurrent) {
          parts.push(`<span class="l-cur"><span class="cur-mark">&#9658;</span>${i18n.current}</span>`);
        }
        if (inprogress && tasks > 0) {
          const pct = tasks > 0 ? Math.round((doneCount / tasks) * 100) : 0;
          parts.push(`<span class="l-frac"><i style="width:${pct}%"></i></span>${i18n.practiceFrac(doneCount, tasks)}`);
        }
        if (parts.length > 0) {
          const sub = document.createElement("span");
          sub.className = "l-sub";
          sub.innerHTML = parts.join("");
          midEl.appendChild(sub);
        }
      }
    }

    // ── Per-unit rollup ──
    const unitSections = Array.from(root.querySelectorAll<HTMLElement>(".oa-unit[data-unit]"));
    for (const unitEl of unitSections) {
      const unitRows = Array.from(unitEl.querySelectorAll<HTMLElement>(".oa-lesson"));
      const total   = unitRows.length;
      let doneCount = 0;
      let partialCount = 0;
      let lockedCount = 0;

      const segs: string[] = [];

      for (const rowEl of unitRows) {
        const isCompleted  = rowEl.classList.contains("is-completed");
        const isDue        = rowEl.classList.contains("is-due");
        const isInprogress = rowEl.classList.contains("is-inprogress");
        const isLocked     = rowEl.classList.contains("is-locked");

        if (isCompleted) doneCount++;
        if (isInprogress) partialCount++;
        if (isLocked) lockedCount++;

        // Build segment
        if (isCompleted && isDue) {
          segs.push(`<span class="u-seg due"></span>`);
        } else if (isCompleted) {
          segs.push(`<span class="u-seg done"></span>`);
        } else if (isInprogress) {
          const tasks     = Number(rowEl.dataset.tasks ?? 0);
          const key       = rowEl.dataset.key ?? "";
          let donePrc = 0;
          try {
            const pRaw = localStorage.getItem(`atlas.practice.${key}`);
            if (pRaw) {
              const pData = JSON.parse(pRaw) as Record<string, string>;
              const d = Object.values(pData).filter((v) => v === "done").length;
              donePrc = tasks > 0 ? Math.round((d / tasks) * 100) : 50;
            }
          } catch { /* tolerate */ }
          segs.push(`<span class="u-seg partial"><i style="--p:${donePrc}%"></i></span>`);
        } else if (isLocked) {
          segs.push(`<span class="u-seg locked"></span>`);
        } else {
          segs.push(`<span class="u-seg"></span>`);
        }
      }

      // Fill u-count
      const countEl = unitEl.querySelector<HTMLElement>(".u-count");
      if (countEl && total > 0) {
        countEl.innerHTML = `<b>${doneCount}</b> / ${total} ${i18n.doneWord}`;
      }

      // Fill u-track
      const trackEl = unitEl.querySelector<HTMLElement>("[data-track-roll]");
      if (trackEl) {
        trackEl.innerHTML = segs.join("");
        trackEl.setAttribute("role", "img");
        trackEl.setAttribute(
          "aria-label",
          `${doneCount} of ${total} lessons done`,
        );
      }

      // Mark fully-done unit
      if (total > 0 && doneCount === total) {
        unitEl.classList.add("is-done");
        // Prepend check to unit name
        const nameEl = unitEl.querySelector<HTMLElement>(".u-name-text");
        if (nameEl) {
          const checkSvg = document.createElement("svg");
          checkSvg.setAttribute("viewBox", "0 0 24 24");
          checkSvg.setAttribute("fill", "none");
          checkSvg.setAttribute("stroke", "currentColor");
          checkSvg.setAttribute("stroke-width", "2.1");
          checkSvg.setAttribute("stroke-linecap", "round");
          checkSvg.setAttribute("stroke-linejoin", "round");
          checkSvg.className = "u-check";
          checkSvg.innerHTML = `<path d="M20 6L9 17l-5-5"/>`;
          nameEl.parentNode?.insertBefore(checkSvg, nameEl);
        }
      }
    }
  });
</script>
