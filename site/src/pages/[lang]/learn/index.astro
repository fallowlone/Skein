---
import { getCollection } from "astro:content";
import Topic from "../../../layouts/Topic.astro";
import { type Locale, isLocale, t } from "../../../i18n";
import { selectOther } from "~/scripts/build-incremental";

export function getStaticPaths() {
  return selectOther((["en", "ru"] as const).map((lang) => ({ params: { lang } })));
}

const { lang } = Astro.params as { lang: Locale };
if (!isLocale(lang)) throw new Error("bad lang");

const tracks = (await getCollection("tracks")).sort((a, b) => a.data.order - b.data.order);
const units = await getCollection("units");

const lessonCount = (slug: string): number =>
  units.filter((u) => u.data.track === slug).reduce((acc, u) => acc + u.data.lessons.length, 0);
const unitCount = (slug: string): number => units.filter((u) => u.data.track === slug).length;

// map track color → extensible domain hue var (matches the home masthead)
const DOMAIN: Record<string, string> = {
  lilac: "var(--d-network)", mint: "var(--d-data)", peach: "var(--d-frontend)",
  sky: "var(--d-backend)", rose: "var(--d-ai)",
};

const unitsLbl = (n: number) => `${n} ${t("home.track.units", lang)}`;
const lessonsLbl = (n: number) => `${n} ${t("home.track.lessons", lang)}`;
const title = lang === "ru" ? "Учиться с нуля" : "Learn from zero";
---

<Topic title={title} lang={lang} sources={[]}>
  <div class="oa-wrap" style="padding-block: var(--s-8) var(--s-9);">
    <h1 class="serif" style="font-size: var(--fs-h1); font-weight: 460; letter-spacing: -0.02em; margin-bottom: var(--s-6);">{title}</h1>
    <div class="oa-band-grid">
      {tracks.map((tr) => (
        <a class="track-card" href={`/${lang}/learn/${tr.data.slug}/`} style={`--d: ${DOMAIN[tr.data.color] ?? "var(--hairline-strong)"};`}>
          <div class="tc-meta">
            <span class="domain-tag"><span class="sq"></span>{tr.data.slug}</span>
            <span class="tc-num">{unitsLbl(unitCount(tr.data.slug))} · {lessonsLbl(lessonCount(tr.data.slug))}</span>
          </div>
          <h4>{tr.data.title[lang]}</h4>
          <p class="tc-blurb">{tr.data.blurb[lang]}</p>
        </a>
      ))}
    </div>
  </div>
</Topic>
