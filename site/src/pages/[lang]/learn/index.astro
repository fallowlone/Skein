---
import { Input as ShadcnInput } from "~/components/ui/input";
import { getCollection } from "astro:content";
import Topic from "../../../layouts/Topic.astro";
import { type Locale, isLocale, t } from "../../../i18n";
import { TRACK_BAND, BANDS, type Band } from "~/components/atlas/track-band";
import type { Track } from "~/types";
import { selectOther } from "~/scripts/build-incremental";
import { indexedLessons } from "~/scripts/lesson-index";

export function getStaticPaths() {
  return selectOther((["en", "ru"] as const).map((lang) => ({ params: { lang } })));
}

const { lang } = Astro.params as { lang: Locale };
if (!isLocale(lang)) throw new Error("bad lang");

const tracks = (await getCollection("tracks")).sort((a, b) => a.data.order - b.data.order);
const units = await getCollection("units");
// estMin is identical across locales; count one lang to avoid double-summing.
const lessonsEn = indexedLessons("en");

const lessonCount = (slug: string): number =>
  units.filter((u) => u.data.track === slug).reduce((acc, u) => acc + u.data.lessons.length, 0);
const unitCount = (slug: string): number => units.filter((u) => u.data.track === slug).length;

const minutesByTrack = new Map<string, number>();
for (const lesson of lessonsEn) {
  minutesByTrack.set(lesson.track, (minutesByTrack.get(lesson.track) ?? 0) + lesson.estMin);
}
const hoursLbl = (slug: string): string =>
  `~${Math.max(1, Math.round((minutesByTrack.get(slug) ?? 0) / 60))} ${t("home.track.hours", lang)}`;

// Magistral order for a from-scratch junior: CS basics → typescript → node/backend → databases → apis → docker.
const RECOMMENDED = ["base-cs", "typescript", "node", "backend", "databases", "apis", "docker"];
const recommended = RECOMMENDED.map((slug) => tracks.find((tr) => tr.data.slug === slug)).filter(
  (tr): tr is (typeof tracks)[number] => Boolean(tr),
);

const unitsLbl = (n: number) => `${n} ${t("home.track.units", lang)}`;
const lessonsLbl = (n: number) => `${n} ${t("home.track.lessons", lang)}`;
const title = lang === "ru" ? "Учиться с нуля" : "Learn from zero";
const hubKicker = lang === "ru"
  ? `Атлас треков · ${tracks.length} треков · ${lessonsEn.length} уроков`
  : `Track atlas · ${tracks.length} tracks · ${lessonsEn.length} lessons`;
const hubAccent = lang === "ru" ? "С нуля — до сеньора" : "From zero to senior";

type Row = { slug: Track; order: number; title: string; blurb: string; lessons: number; units: number };
const byBand: Record<Band, Row[]> = { advanced: [], middle: [], surface: [], foundations: [] };
for (const tr of tracks) {
  const slug = tr.data.slug as Track;
  byBand[TRACK_BAND[slug]].push({
    slug, order: tr.data.order, title: tr.data.title[lang], blurb: tr.data.blurb[lang],
    lessons: lessonCount(slug), units: unitCount(slug),
  });
}
---

<Topic title={title} lang={lang} sources={[]} navDock>
  <div class="oa-wrap poster-track" style="padding-block: var(--s-8) var(--s-9);">
    <header class="poster-head" style="margin-bottom: var(--s-6);">
      <p class="ph-kicker"><span>№00</span><span>{hubKicker}</span></p>
      <h1 class="poster-giant poster-page-size" style="margin-top: var(--s-4);">
        <span class="pg-solid">{title}</span>
        <span class="pg-accent">{hubAccent}</span>
      </h1>
    </header>

    <div class="track-search">
      <label class="track-search-label" for="trackFilter">{t("learn.search.label", lang)}</label>
      <ShadcnInput
        type="search"
        id="trackFilter"
        leadingIcon="search"
        class="track-search-input"
        autocomplete="off"
        placeholder={t("learn.search.placeholder", lang)}
        aria-describedby="trackFilterCount"
      />
      <p class="track-search-empty" id="trackFilterEmpty" hidden>{t("learn.search.empty", lang)}</p>
      <p class="sr-only" id="trackFilterCount" role="status" aria-live="polite"></p>
    </div>

    {recommended.length > 0 && (
      <section class="track-card" data-recommended style="margin-bottom: var(--s-7); --d: var(--accent);">
        <div class="tc-meta">
          <span class="domain-tag"><span class="sq"></span>{t("learn.recommended.title", lang)}</span>
        </div>
        <p class="tc-blurb" style="margin: var(--s-2) 0 var(--s-4);">{t("learn.recommended.note", lang)}</p>
        <div class="oa-lessons" style="padding-left: 0;">
          {recommended.map((tr, i) => (
            <a class="oa-lesson" href={`/${lang}/learn/${tr.data.slug}/`}>
              <span class="l-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="l-title">{tr.data.title[lang]}</span>
              <span class="l-min">{hoursLbl(tr.data.slug)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {BANDS.map((band) => (
      byBand[band].length ? (
        <section class="poster-band" data-band>
          <div class="poster-sec-head">
            <h2>{t(`home.band.${band}`, lang)}</h2>
            <span>{t(`home.band.${band}.note`, lang)}</span>
          </div>
          <div class="poster-rows">
            {byBand[band].map((row) => (
              <a
                class="poster-row"
                data-track-card
                data-search={`${row.title} ${row.blurb} ${row.slug} ${band}`.toLowerCase()}
                href={`/${lang}/learn/${row.slug}/`}
              >
                <span class="pr-num">{String(row.order).padStart(2, "0")}</span>
                <span class="pr-name">{row.title}</span>
                <span class="pr-meta">{unitsLbl(row.units)} · {lessonsLbl(row.lessons)} · {hoursLbl(row.slug)}</span>
                <span class="pr-arr" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </section>
      ) : null
    ))}
  </div>

  <script is:inline>
    (function () {
      const input = document.getElementById("trackFilter");
      if (!input) return;
      const cards = Array.from(document.querySelectorAll("[data-track-card]"));
      const bands = Array.from(document.querySelectorAll("[data-band]"));
      const recommended = document.querySelector("[data-recommended]");
      const emptyMsg = document.getElementById("trackFilterEmpty");
      const countMsg = document.getElementById("trackFilterCount");

      function apply() {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        cards.forEach((card) => {
          const hay = card.getAttribute("data-search") || "";
          const match = q === "" || hay.indexOf(q) !== -1;
          card.hidden = !match;
          if (match) shown++;
        });
        // Hide a band whose every card is filtered out.
        bands.forEach((band) => {
          const anyVisible = band.querySelector("[data-track-card]:not([hidden])");
          band.hidden = !anyVisible;
        });
        // The curated "recommended" block only makes sense with no active query.
        if (recommended) recommended.hidden = q !== "";
        if (emptyMsg) emptyMsg.hidden = shown !== 0;
        if (countMsg) countMsg.textContent = String(shown);
      }

      input.addEventListener("input", apply);
      apply();
    })();
  </script>
</Topic>

<style>
  .track-search { margin-bottom: var(--s-6); }
  .track-search-label {
    display: block; font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
    margin-bottom: 8px;
  }
  .track-search-input {
    width: 100%; max-width: 420px;
    font: inherit; font-size: 15px; color: var(--ink);
    background: var(--card); border: 0.5px solid var(--hairline-2);
    border-radius: 0; padding: 10px 14px;
    transition: border-color .14s;
  }
  .poster-band { margin-top: var(--s-8); }
  .poster-band .poster-sec-head { margin-bottom: 6px; }
  .track-search [data-slot="input-wrap"] { max-width: 420px; }
  .track-search .track-search-input { max-width: none; }
  .track-search-input:focus {
    outline: none; border-color: var(--accent);
  }
  .track-search-empty {
    margin-top: 12px; color: var(--muted); font-size: 14px;
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
