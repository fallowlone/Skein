---
import Atlas from "~/layouts/Atlas.astro";
import { getCollection } from "astro:content";
import { t, isLocale, type Locale } from "~/i18n";
import { TRACK_BAND, BANDS, type Band } from "~/components/atlas/track-band";
import type { Track } from "~/types";
import { selectOther } from "~/scripts/build-incremental";
import HomeResume from "~/components/atlas/HomeResume.astro";
import AtlasPreview from "~/components/atlas/AtlasPreview.astro";

export function getStaticPaths() {
  return selectOther([{ params: { lang: "en" } }, { params: { lang: "ru" } }]);
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale: ${lang}`);

const tracks = (await getCollection("tracks")).sort((a, b) => a.data.order - b.data.order);
const units = await getCollection("units");

const lessonCount = (slug: string): number =>
  units.filter((u) => u.data.track === slug).reduce((acc, u) => acc + u.data.lessons.length, 0);
const unitCount = (slug: string): number => units.filter((u) => u.data.track === slug).length;

// map track color → extensible domain hue var
const DOMAIN: Record<string, string> = {
  lilac: "var(--d-network)", mint: "var(--d-data)", peach: "var(--d-frontend)",
  sky: "var(--d-backend)", rose: "var(--d-ai)",
};

type Row = { slug: Track; title: string; blurb: string; lessons: number; units: number; color: string };
const byBand: Record<Band, Row[]> = { advanced: [], middle: [], surface: [], foundations: [] };
for (const tr of tracks) {
  const slug = tr.data.slug as Track;
  byBand[TRACK_BAND[slug]].push({
    slug, title: tr.data.title[lang], blurb: tr.data.blurb[lang],
    lessons: lessonCount(slug), units: unitCount(slug), color: tr.data.color,
  });
}

const totalTracks = tracks.length;
const totalLessons = tracks.reduce((a, tr) => a + lessonCount(tr.data.slug), 0);
const kicker = lang === "en"
  ? `THE ATLAS · ${totalTracks} TRACKS · ${totalLessons} LESSONS`
  : `АТЛАС · ${totalTracks} ТРЕКОВ · ${totalLessons} УРОКОВ`;
const proof = t("home.proof", lang)
  .replace("{lessons}", String(totalLessons))
  .replace("{tracks}", String(totalTracks));

// 1-Question Gate: each choice maps to a real track; picking one retargets the
// "Open my route" CTA and the recommended-start line.
const gateChoices = [
  { key: "design", slug: "system-design" },
  { key: "backend", slug: "backend" },
  { key: "frontend", slug: "frontend" },
  { key: "devops", slug: "deployment" },
  { key: "ai", slug: "ai-llm" },
] as const;
const trackTitle = Object.fromEntries(tracks.map((tr) => [tr.data.slug, tr.data.title[lang]]));
const defaultStart = "deployment";
const unitsLbl = (n: number) => `${n} ${t("home.track.units", lang)}`;
const lessonsLbl = (n: number) => `${n} ${t("home.track.lessons", lang)}`;

// Site-level structured data. Per-lesson LearningResource graphs live in Lesson.astro.
const SITE_ORIGIN = "https://fallowlone.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: t("site.title", lang),
  description: t("site.tagline", lang),
  inLanguage: lang,
  url: new URL(`/${lang}/`, SITE_ORIGIN).href,
  publisher: { "@type": "Organization", name: t("site.title", lang), url: SITE_ORIGIN },
};
---

<Atlas title={t("nav.atlas.atlas", lang)} lang={lang} jsonLd={jsonLd} minimalRail>
  <section class="oa-hero">
    <div class="contour-field"></div>
    <div class="oa-wrap oa-hero-grid">
      <div class="hero-copy">
        <p class="kicker">{kicker}</p>
        <h1>
          {t("home.title1", lang)} <em>{t("home.title2", lang)}</em>
        </h1>
        <p class="hero-crux">{t("home.crux", lang)}</p>
        <div class="hero-actions">
          <a class="oa-btn oa-btn-primary" href={`/${lang}/calibrate/`}>
            {t("home.cta.start", lang)}<span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hero-gate">
          <p class="gate-question">{t("home.gate.question", lang)}</p>
          <div class="gate-chips" role="group" aria-label={t("home.gate.question", lang)}>
            {gateChoices.map((c) => (
              <button
                type="button"
                class="gate-chip"
                data-track={c.slug}
                data-units={unitCount(c.slug)}
                data-title={trackTitle[c.slug]}
              >
                {t(`home.gate.chip.${c.key}`, lang)}
              </button>
            ))}
          </div>
          <p class="gate-recommended" data-tpl={t("home.gate.recommended", lang)}>
            <svg class="gate-spark" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2l2.3 7.7L22 12l-7.7 2.3L12 22l-2.3-7.7L2 12l7.7-2.3Z" />
            </svg>
            <span class="gate-rec-text">
              {t("home.gate.recommended", lang)
                .replace("{track}", trackTitle[defaultStart])
                .replace("{units}", String(unitCount(defaultStart)))}
            </span>
          </p>
          <a class="oa-btn oa-btn-primary gate-cta" id="gate-cta" href={`/${lang}/calibrate/`}>
            {t("home.gate.cta", lang)}<span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="gate-browse" href={`/${lang}/learn/`}>{t("home.cta.browse", lang)}</a>
        </div>
        <p class="hero-proof">
          <span class="proof-avatars" aria-hidden="true">
            {[0, 1, 2].map(() => (
              <span class="proof-avatar">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="8.2" r="3.8" /><path d="M4.5 20.5c0-3.9 3.4-6.2 7.5-6.2s7.5 2.3 7.5 6.2z" /></svg>
              </span>
            ))}
          </span>
          <span>{proof}</span>
        </p>
      </div>
      <div class="hero-map">
        <AtlasPreview lang={lang} />
      </div>
    </div>
  </section>

  <style>
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3);
      margin-top: var(--s-6);
    }
    /* social-proof line under the CTA — mono, wraps to two short lines */
    .hero-proof {
      display: flex;
      align-items: flex-start;
      gap: var(--s-3);
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.55;
      color: var(--muted);
      margin-top: var(--s-5);
    }
    .proof-avatars { display: flex; flex-shrink: 0; margin-top: 2px; }
    .proof-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--card-2); border: 2px solid var(--card);
      display: grid; place-items: center; overflow: hidden;
    }
    .proof-avatar + .proof-avatar { margin-left: -9px; }
    .proof-avatar svg { width: 22px; height: 22px; fill: var(--muted-2); }

    /* 1-Question Gate — mobile variant: the first calibration step inlined into
       the hero. Desktop keeps the Atlas Preview hero, so the gate hides ≥720px. */
    .hero-gate { display: none; }
    @media (max-width: 719.98px) {
      .hero-gate { display: block; }
      /* gate replaces the plain CTA on mobile */
      .hero-actions { display: none; }
      .gate-question {
        font-family: var(--font-display);
        font-size: 20px;
        line-height: 1.3;
        color: var(--muted);
        margin-top: var(--s-6);
      }
      .gate-chips {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s-2);
        margin-top: var(--s-5);
      }
      .gate-chip {
        appearance: none;
        cursor: pointer;
        font: 500 var(--fs-meta) / 1 var(--font-body);
        color: var(--ink-2);
        background: var(--card);
        border: 0.5px solid var(--hairline-2);
        border-radius: var(--r-pill);
        padding: 11px 16px;
        transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
      }
      .gate-chip[data-selected] {
        border-color: var(--accent);
        background: var(--accent-ghost);
        color: var(--ink);
      }
      .gate-recommended {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: var(--s-5);
        font-size: var(--fs-meta);
        line-height: 1.45;
        color: var(--muted-2);
      }
      .gate-spark {
        width: 18px;
        height: 18px;
        fill: var(--accent-bright);
        flex-shrink: 0;
        margin-top: 2px;
      }
      .gate-cta {
        width: 100%;
        justify-content: center;
        margin-top: var(--s-5);
        padding-block: 15px;
      }
      .gate-browse {
        display: inline-block;
        margin-top: var(--s-6);
        font-family: var(--font-display);
        font-size: var(--fs-h5);
        color: var(--ink);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
      }
      /* the report's mobile mockup reverts the proof line to large serif */
      .hero-proof {
        font-family: var(--font-display);
        font-size: var(--fs-h5);
        line-height: 1.45;
        align-items: center;
        margin-top: var(--s-6);
      }
      .proof-avatars { margin-top: 0; }
      .proof-avatar { width: 44px; height: 44px; }
    }
  </style>

  <script>
    // 1-Question Gate: picking a choice retargets the recommended-start line and
    // carries the choice into the calibration flow via ?start=<slug>.
    (function () {
      const chips = Array.from(document.querySelectorAll<HTMLElement>(".gate-chip"));
      const rec = document.querySelector<HTMLElement>(".gate-recommended");
      const text = rec?.querySelector<HTMLElement>(".gate-rec-text");
      const cta = document.getElementById("gate-cta");
      if (!chips.length || !rec || !text || !cta) return;
      const tpl = rec.getAttribute("data-tpl") ?? "";
      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          for (const c of chips) c.removeAttribute("data-selected");
          chip.setAttribute("data-selected", "");
          const { track = "", units = "", title = "" } = chip.dataset;
          text.textContent = tpl.replace("{track}", title).replace("{units}", units);
          cta.href = `${cta.href.split("?")[0]}?start=${encodeURIComponent(track)}`;
        });
      });
    })();
  </script>

  <div class="oa-wrap" style="padding-bottom: var(--s-9);">
    <HomeResume lang={lang} />
    {BANDS.map((band) => (
      byBand[band].length ? (
        <section class="oa-band">
          <header class="band-head">
            <span class="band-label">{t(`home.band.${band}`, lang)}</span>
            <span class="band-note">{t(`home.band.${band}.note`, lang)}</span>
          </header>
          <div class="oa-band-grid">
            {byBand[band].map((row) => (
              <a class="track-card" href={`/${lang}/learn/${row.slug}/`} style={`--d: ${DOMAIN[row.color] ?? "var(--hairline-strong)"};`}>
                <div class="tc-meta">
                  <span class="domain-tag"><span class="sq"></span>{row.slug}</span>
                  <span class="tc-num">{unitsLbl(row.units)} · {lessonsLbl(row.lessons)}</span>
                </div>
                <h2>{row.title}</h2>
                <p class="tc-blurb">{row.blurb}</p>
              </a>
            ))}
          </div>
        </section>
      ) : null
    ))}
  </div>
</Atlas>
