---
import { getCollection } from "astro:content";
import Topic from "../../layouts/Topic.astro";
import HeroBlock from "../../components/brand/HeroBlock.astro";
import PillarGrid from "../../components/nav/PillarGrid.astro";
import SpiralThreadsIndex from "../../components/nav/SpiralThreadsIndex.astro";
import Pretest from "../../components/pedagogy/Pretest.tsx";
import ContinueLearning from "../../components/nav/ContinueLearning.tsx";
import ProgressOverview from "../../components/nav/ProgressOverview.tsx";
import { t, isLocale, type Locale } from "../../i18n";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ru" } }];
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale: ${lang}`);

const pillars = await getCollection("pillars");
const chapters = await getCollection("chapters");
const book = await getCollection("book");

type PillarColor = "lilac" | "mint" | "peach" | "sky" | "rose";

const pillarColorBySlug: Record<string, PillarColor> = {};
for (const p of pillars) pillarColorBySlug[p.data.slug] = p.data.color as PillarColor;

const chapterTitleByPillar: Record<string, string> = {};
for (const c of chapters) chapterTitleByPillar[c.data.pillar] = c.data.title[lang];

const pieceMap: Record<
  string,
  {
    pillar: string;
    pillarColor: PillarColor;
    chapter: string;
    chapterTitle: string;
    title: string;
  }
> = {};

for (const entry of book) {
  if (entry.data.lang !== lang) continue;
  pieceMap[entry.data.slug] = {
    pillar: entry.data.pillar,
    pillarColor: pillarColorBySlug[entry.data.pillar] ?? "lilac",
    chapter: entry.data.chapter,
    chapterTitle: chapterTitleByPillar[entry.data.pillar] ?? entry.data.pillar,
    title: entry.data.title,
  };
}

const totalPieces = book.length;
const readyPieces = book.filter((e) => e.data.status === "ready").length;
const totalPillars = pillars.length;

const readyByPillar: Record<string, number> = {};
const totalByPillar: Record<string, number> = {};
for (const entry of book) {
  totalByPillar[entry.data.pillar] = (totalByPillar[entry.data.pillar] ?? 0) + 1;
  if (entry.data.status === "ready") {
    readyByPillar[entry.data.pillar] = (readyByPillar[entry.data.pillar] ?? 0) + 1;
  }
}
const readyPillars = pillars.filter(
  (p) =>
    (readyByPillar[p.data.slug] ?? 0) > 0 &&
    (readyByPillar[p.data.slug] ?? 0) === (totalByPillar[p.data.slug] ?? -1),
).length;
---

<Topic title={t("nav.home", lang)} lang={lang}>
  <HeroBlock lang={lang} />
  <Pretest client:only="preact" lang={lang} />
  <ContinueLearning client:visible lang={lang} pieceMap={pieceMap} />
  <ProgressOverview
    client:visible
    lang={lang}
    totalPieces={totalPieces}
    readyPieces={readyPieces}
    totalPillars={totalPillars}
    readyPillars={readyPillars}
  />
  <PillarGrid lang={lang} />
  <SpiralThreadsIndex lang={lang} />
</Topic>
