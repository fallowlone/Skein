---
import Atlas from "~/layouts/Atlas.astro";
import { getCollection } from "astro:content";
import { t, isLocale, type Locale } from "~/i18n";
import { TRACK_BAND, BANDS, type Band } from "~/components/atlas/track-band";
import type { Track } from "~/types";
import { selectOther } from "~/scripts/build-incremental";
import HomeResume from "~/components/atlas/HomeResume.astro";
import PosterFill from "~/components/atlas/PosterFill.astro";

export function getStaticPaths() {
  return selectOther([{ params: { lang: "en" } }, { params: { lang: "ru" } }]);
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale: ${lang}`);

const tracks = (await getCollection("tracks")).sort((a, b) => a.data.order - b.data.order);
const units = await getCollection("units");

const lessonCount = (slug: string): number =>
  units.filter((u) => u.data.track === slug).reduce((acc, u) => acc + u.data.lessons.length, 0);
const unitCount = (slug: string): number => units.filter((u) => u.data.track === slug).length;

type Row = { slug: Track; order: number; title: string; blurb: string; lessons: number; units: number; color: string };
const byBand: Record<Band, Row[]> = { advanced: [], middle: [], surface: [], foundations: [] };
for (const tr of tracks) {
  const slug = tr.data.slug as Track;
  byBand[TRACK_BAND[slug]].push({
    slug, order: tr.data.order, title: tr.data.title[lang], blurb: tr.data.blurb[lang],
    lessons: lessonCount(slug), units: unitCount(slug), color: tr.data.color,
  });
}
// Marquee lanes: real track slugs, uppercased, doubled for a seamless loop.
const marqueeSlugs = tracks.map((tr) => tr.data.slug.toUpperCase());

const totalTracks = tracks.length;
const totalLessons = tracks.reduce((a, tr) => a + lessonCount(tr.data.slug), 0);
const kicker = lang === "en"
  ? `THE ATLAS · ${totalTracks} TRACKS · ${totalLessons} LESSONS`
  : `АТЛАС · ${totalTracks} ТРЕКОВ · ${totalLessons} УРОКОВ`;
const proof = t("home.proof", lang)
  .replace("{lessons}", String(totalLessons))
  .replace("{tracks}", String(totalTracks));

const unitsLbl = (n: number) => `${n} ${t("home.track.units", lang)}`;
const lessonsLbl = (n: number) => `${n} ${t("home.track.lessons", lang)}`;

// Site-level structured data. Per-lesson LearningResource graphs live in Lesson.astro.
const SITE_ORIGIN = "https://fallowlone.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: t("site.title", lang),
  description: t("site.tagline", lang),
  inLanguage: lang,
  url: new URL(`/${lang}/`, SITE_ORIGIN).href,
  publisher: { "@type": "Organization", name: t("site.title", lang), url: SITE_ORIGIN },
};
---

<Atlas title={t("nav.atlas.atlas", lang)} lang={lang} jsonLd={jsonLd}>
  <section class="poster-hero">
    <div class="oa-wrap">
      <p class="kicker poster-kicker"><span class="pk-n">№001</span><span>{t("home.poster.kicker", lang)}</span><span>{kicker}</span></p>
      <h1 class="poster-giant poster-hero-size">
        <span class="pg-solid">Skein</span>
        <PosterFill text={t("home.poster.outline", lang)} drift shift />
        <span class="pg-accent">{t("home.poster.accent", lang)}</span>
      </h1>
      <div class="poster-sub">
        <p class="poster-crux">{t("home.crux", lang)}</p>
        <div>
          <p class="poster-proof">{proof}</p>
          <div class="poster-actions">
            <a class="oa-btn oa-btn-primary" href={`/${lang}/calibrate/`}>
              {t("home.cta.start", lang)}<span class="arrow" aria-hidden="true">→</span>
            </a>
            <a class="poster-ghost" href="#tracks">{t("home.cta.browse", lang)}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="poster-marquee" aria-hidden="true">
    <div class="pm-lane">{marqueeSlugs.concat(marqueeSlugs).map((s) => (<span>{s}<span class="pm-dot"> ●</span></span>))}</div>
  </div>
  <div class="poster-marquee pm-rev" aria-hidden="true">
    <div class="pm-lane">{marqueeSlugs.concat(marqueeSlugs).map((s) => (<span>{s}<span class="pm-dot"> —</span></span>))}</div>
  </div>

  <div class="oa-wrap" id="tracks">
    <HomeResume lang={lang} />
    {BANDS.map((band) => (
      byBand[band].length ? (
        <section class="poster-band">
          <div class="poster-sec-head">
            <h2>{t(`home.band.${band}`, lang)}</h2>
            <span>{t(`home.band.${band}.note`, lang)}</span>
          </div>
          <div class="poster-rows">
            {byBand[band].map((row) => (
              <a class="poster-row" href={`/${lang}/learn/${row.slug}/`}>
                <span class="pr-num">{String(row.order).padStart(2, "0")}</span>
                <span class="pr-name">{row.title}</span>
                <span class="pr-meta">{unitsLbl(row.units)} · {lessonsLbl(row.lessons)}</span>
                <span class="pr-arr" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </section>
      ) : null
    ))}

    <section class="poster-method">
      <div class="poster-sec-head">
        <h2>{t("home.poster.method", lang)}</h2>
        <span>{t("home.poster.methodNote", lang)}</span>
      </div>
      <div class="pm-grid">
        {[1, 2, 3].map((n) => (
          <div class="pm-cell">
            <p class="pm-k">{t(`home.method.${n}.k`, lang)}</p>
            <h3>{t(`home.method.${n}.h`, lang)}</h3>
            <p>{t(`home.method.${n}.p`, lang)}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <a class="poster-slab" href={`/${lang}/calibrate/`} style="margin-top: var(--s-9);">
    <div class="oa-wrap">
      <p class="ps-mono">{t("home.slab.meta", lang)}</p>
      <p class="ps-big">{t("home.slab.big", lang)}</p>
    </div>
  </a>
  <div class="oa-wrap" style="padding-bottom: var(--s-9);"></div>
<script>
  // Kinetic drift of the outline line — transform only, off under reduced motion.
  const line = document.querySelector("[data-drift]");
  if (line && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        (line as HTMLElement).style.transform = `translateX(${Math.min(window.scrollY * 0.12, 120)}px)`;
        ticking = false;
      });
    }, { passive: true });
  }
</script>

<style>
  .poster-hero { padding-block: 64px 48px; overflow: clip; }
  /* Home hero type: smaller; ATLAS sits half a word right (pg-shift). */
  .poster-hero .poster-hero-size {
    font-size: clamp(56px, 15vw, 200px);
  }
  .poster-kicker {
    display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap;
    border-top: 1px solid var(--rule-strong); padding-top: 14px;
  }
  .poster-kicker .pk-n { color: var(--poster-accent); font-weight: 700; }
  .poster-hero h1 { margin-top: 24px; }
  .poster-sub {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 32px;
    margin-top: 36px;
  }
  .poster-crux { font-size: 19px; line-height: 1.5; max-width: 44ch; }
  .poster-proof {
    font-family: var(--font-mono); font-size: 11px; line-height: 1.6;
    letter-spacing: 0.02em; text-transform: uppercase; color: var(--muted);
    max-width: 52ch;
  }
  .poster-proof::before { content: "● "; color: var(--poster-accent); }
  .poster-actions { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; margin-top: 22px; }
  /* Poster CTA: sharp brutalist slab, Oswald label — home scope only. */
  .poster-actions .oa-btn-primary {
    border-radius: 0;
    font-family: var(--font-poster); font-weight: 600; font-size: 17px;
    text-transform: uppercase; letter-spacing: 0.05em;
    padding: 15px 26px;
  }
  .poster-actions .oa-btn-primary:active { transform: none; }
  .poster-ghost {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em;
    text-transform: uppercase; border-bottom: 1px solid var(--rule-strong); padding-bottom: 2px;
  }
  .poster-ghost:hover { color: var(--poster-accent); border-color: var(--poster-accent); }
  .poster-band { margin-top: var(--s-8); }
  .poster-band .poster-sec-head { margin-bottom: 6px; }
  .poster-method { margin-top: var(--s-8); }
  .pm-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--rule-strong);
  }
  .pm-cell { padding: 18px 20px 24px 0; }
  .pm-cell + .pm-cell { border-left: 1px solid var(--rule); padding-left: 20px; }
  .pm-cell .pm-k {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--poster-accent); margin: 0;
  }
  .poster-method .pm-cell h3 {
    font-family: var(--font-poster); font-weight: 600;
    font-size: clamp(24px, 2.6vw, 38px); text-transform: uppercase;
    margin: 10px 0 8px; line-height: 1;
  }
  .pm-cell p { font-size: 15px; line-height: 1.6; color: var(--muted); margin: 0; max-width: 34ch; }
  .poster-slab .oa-wrap { padding-block: 44px; }
  @media (max-width: 900px) {
    .poster-sub { grid-template-columns: 1fr; }
    .pm-grid { grid-template-columns: 1fr; }
    .pm-cell + .pm-cell { border-left: 0; border-top: 1px solid var(--rule); padding-left: 0; }
  }
</style>

</Atlas>
