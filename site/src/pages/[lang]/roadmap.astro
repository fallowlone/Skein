---
import Topic from "../../layouts/Topic.astro";
import CompetencyMap from "../../components/progression/CompetencyMap.tsx";
import { type Locale, isLocale, t } from "../../i18n";
import { getCollection } from "astro:content";
import unitsData from "../../content/units.json";
import type { RoadmapContent } from "../../scripts/progression/competency-inputs";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ru" } }];
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error("bad lang");

// Content I/O stays in the route; the island is content-agnostic. Assemble a
// serializable bundle: ready units per track + practice task metadata (with an
// objective/subjective flag derived from the full task here, not in the island).
const units = (unitsData as any[]).filter((u) => u.status === "ready");

const practiceEntries = await getCollection("practice");
const practiceByTrack = new Map<string, { lessonKey: string; tasks: { id: string; objective: boolean }[] }[]>();
for (const e of practiceEntries) {
  const d = e.data as any;
  const tasks = d.tasks.map((task: any) => ({
    id: task.id,
    objective:
      task.type === "sandbox" ||
      (task.type === "diagnose" && task.grading?.mode === "blanks") ||
      (task.type === "fix" && task.grading?.mode === "exec"),
  }));
  const list = practiceByTrack.get(d.track) ?? [];
  list.push({ lessonKey: d.lessonKey, tasks });
  practiceByTrack.set(d.track, list);
}

const unitsByTrack = new Map<string, { id: string; slug: string; order: number; lessons: string[] }[]>();
for (const u of units) {
  const list = unitsByTrack.get(u.track) ?? [];
  list.push({ id: u.id, slug: u.slug, order: u.order, lessons: u.lessons });
  unitsByTrack.set(u.track, list);
}

const content: RoadmapContent = {
  tracks: [...unitsByTrack.keys()].map((track) => ({
    track: track as any,
    readyUnits: unitsByTrack.get(track)!,
    practiceByLesson: practiceByTrack.get(track) ?? [],
  })),
};
---
<Topic title={t("roadmap.title", lang)} lang={lang}>
  <h1 class="text-3xl font-extrabold mb-2">{t("roadmap.title", lang)}</h1>
  <CompetencyMap client:only="preact" lang={lang} content={content} />
</Topic>
