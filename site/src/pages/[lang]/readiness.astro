---
import Topic from "../../layouts/Topic.astro";
import ReadinessDashboard from "../../components/progression/ReadinessDashboard.tsx";
import { type Locale, isLocale, t } from "../../i18n";
import { selectOther } from "~/scripts/build-incremental";

export function getStaticPaths() {
  return selectOther([{ params: { lang: "en" } }, { params: { lang: "ru" } }]);
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error("bad lang");
---
<Topic title={t("readiness.title", lang)} lang={lang}>
  <header class="rd-top">
    <h1 class="text-3xl font-extrabold">{t("readiness.title", lang)}</h1>
    <p class="rd-intro">{t("readiness.intro", lang)}</p>
  </header>
  {/* SSR fallback: ReadinessDashboard is a client:only island; this shows until the
      bundle mounts (and for brand-new visitors), then the island removes it. */}
  <div id="readiness-fallback" class="rd-fallback">
    <p class="rd-fb-lead">{t("readiness.loading", lang)}</p>
  </div>
  <ReadinessDashboard client:only="preact" lang={lang} />
</Topic>

<style is:global>
  .rd-top { margin: 0 0 28px; }
  .rd-intro { color: var(--muted); font-size: 15px; line-height: 1.6; margin: 8px 0 0; max-width: 52ch; }
  .rd-fallback {
    border: 0.5px solid var(--hairline-2); border-radius: var(--r-md);
    padding: 28px 24px; max-width: 480px;
  }
  .rd-fb-lead { color: var(--muted); font-size: 15px; margin: 0; }

  .rd-grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .rd-card {
    border: 0.5px solid var(--hairline-2); border-radius: var(--r-md);
    padding: 20px 22px; background: var(--card, transparent);
    display: flex; flex-direction: column; gap: 10px;
  }
  .rd-head {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--muted);
  }
  /* rank card: tinted by the learner's rank color via --rk */
  .rd-rank { border-left: 2px solid var(--rk, var(--accent)); }
  .rd-rank-label {
    font-family: var(--font-display); font-size: 22px; line-height: 1.1;
    color: var(--rk, var(--ink)); display: flex; align-items: center; gap: 8px;
  }
  .rd-ico { font-size: 20px; }
  .rd-rating { font-family: var(--font-mono); font-size: 28px; font-weight: 700; color: var(--ink); }
  .rd-moved { font-size: 13px; color: var(--muted); }
  .rd-meaning { font-size: 12px; color: var(--muted); }
  .rd-evidence {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.02em;
    color: var(--accent); background: var(--accent-ghost, transparent);
    padding: 3px 8px; border-radius: var(--r-sm); align-self: flex-start;
  }

  .rd-card p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--ink-2, var(--ink)); }
  .rd-strong { font-weight: 600; }
  .rd-muted { color: var(--muted); }

  .rd-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .rd-list li { font-size: 14px; }
  .rd-list a { color: var(--accent); text-decoration: none; border-bottom: 0.5px solid transparent; }
  .rd-list a:hover { border-bottom-color: var(--accent); }

  .rd-iv { display: flex; flex-direction: column; gap: 10px; }
  .rd-iv-score { font-family: var(--font-mono); font-size: 30px; font-weight: 700; color: var(--ink); }
  .rd-iv-bar { height: 6px; border-radius: 3px; background: var(--hairline); overflow: hidden; }
  .rd-iv-bar > span { display: block; height: 100%; background: var(--accent); border-radius: 3px; }
  .rd-iv-cta, .rd-card a {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.03em;
    color: var(--accent); text-decoration: none;
  }
  .rd-iv-cta { border-bottom: 0.5px solid var(--accent); align-self: flex-start; }
  .rd-iv-cta:hover { opacity: 0.8; }

  /* re-calibration nudge: prominent, accent-tinted, sits above the grid */
  .rd-recal {
    display: flex; flex-direction: column; gap: 8px;
    border: 0.5px solid var(--accent); border-left: 2px solid var(--accent);
    background: var(--accent-ghost, transparent); border-radius: var(--r-md);
    padding: 16px 20px; margin: 0 0 18px;
  }
  .rd-recal p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--ink); max-width: 60ch; }
  .rd-recal-cta {
    align-self: flex-start; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.03em;
    color: var(--accent); text-decoration: none; border-bottom: 0.5px solid var(--accent);
  }
  .rd-recal-cta:hover { opacity: 0.8; }

  /* ── Forecast Builder ──────────────────────────────────────────────────────
     Interactive mini-builder inside the forecast card: target + deadline feed
     a locked projection timeline. PRO badges mark the locked instrument. */
  .rd-head-row {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
  }
  .rd-pro {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em;
    color: var(--muted); border: 0.5px solid var(--hairline-strong);
    border-radius: var(--r-sm); padding: 2px 7px; line-height: 1.3;
    background: var(--card-2, transparent);
  }
  .rd-fb-hint { color: var(--muted); }
  .rd-fb-form {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px;
  }
  .rd-fb-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .rd-fb-label { font-size: 12px; color: var(--muted); }
  .rd-fb-field select,
  .rd-fb-field input[type='date'] {
    font: inherit; font-size: 13px; color: var(--ink);
    background: var(--card); border: 0.5px solid var(--hairline-strong);
    border-radius: var(--r-sm); padding: 7px 9px; width: 100%;
  }
  .rd-fb-field select:focus-visible,
  .rd-fb-field input[type='date']:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 1px;
  }
  .rd-fb-chart-head { margin-top: 6px; }
  .rd-chart { width: 100%; height: auto; display: block; }
  .rd-chart-y, .rd-chart-x {
    font-family: var(--font-mono); font-size: 9.5px; fill: var(--muted);
  }
  .rd-chart-axis { stroke: var(--hairline-strong); stroke-width: 0.5; }
  .rd-chart-deadline {
    stroke: var(--faint); stroke-width: 0.8; stroke-dasharray: 1.5 3;
  }
  .rd-chart-solid,
  .rd-chart-dashed {
    fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round;
  }
  .rd-chart-dashed { stroke-dasharray: 4 4; stroke-width: 1.3; }
  .rd-chart-dot { fill: var(--accent); }
  .rd-fb-unlock { margin: 2px 0 0; font-size: 13px; color: var(--ink-2, var(--ink)); }
  /* a.rd-fb-* — bumped specificity to beat the legacy `.rd-card a` mono/accent rule */
  a.rd-fb-primary, a.rd-fb-secondary {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    border-radius: var(--r-sm); padding: 9px 14px;
    font-family: inherit; font-size: 13.5px; letter-spacing: normal;
    text-decoration: none; width: 100%;
    transition: background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  a.rd-fb-primary {
    background: var(--accent); color: var(--on-accent, #fff); font-weight: 550;
    border: 0.5px solid var(--accent);
  }
  a.rd-fb-primary:hover { background: color-mix(in srgb, var(--accent) 85%, var(--ink)); text-decoration: none; }
  .rd-pro-chip {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em;
    background: var(--card); color: var(--accent);
    border-radius: var(--r-sm); padding: 2px 6px; line-height: 1.3;
  }
  a.rd-fb-secondary {
    background: var(--card); color: var(--ink);
    border: 0.5px solid var(--hairline-strong);
  }
  a.rd-fb-secondary:hover { background: var(--card-2); border-color: var(--ink); text-decoration: none; }
  .rd-forecast { gap: 12px; }
  @media (max-width: 560px) {
    .rd-fb-form { grid-template-columns: 1fr; }
  }
</style>
