---
import Topic from "../../layouts/Topic.astro";
import { type Locale, isLocale, t } from "../../i18n";
import { selectOther } from "~/scripts/build-incremental";

export function getStaticPaths() {
  return selectOther([{ params: { lang: "en" } }, { params: { lang: "ru" } }]);
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error("bad lang");

const copy = {
  en: {
    sections: [
      {
        nav: "1. Service",
        summary: "Skein is free to use for personal learning. Content may change or become unavailable at any time. We don’t guarantee accuracy or availability.",
        title: "1. The service",
        body: "The content is provided free of charge, as-is, for personal learning. It may change or become unavailable at any time. No warranty of accuracy or availability is given.",
      },
      {
        nav: "2. Accounts",
        summary: "GitHub OAuth is used for sign-in, progress sync, and matching an optional GitHub Sponsors Coach entitlement. We don’t collect your email or scan repositories.",
        title: "2. Accounts",
        body: "Sign-in uses GitHub OAuth. We store your GitHub id, username, chosen nickname, avatar URL, and the time you accepted these Terms. If you use Skein Coach through GitHub Sponsors, we also store the linked sponsorship id, sponsor GitHub id, tier, price metadata, privacy level, and sponsorship status needed to maintain the entitlement. We do not collect your email or scan your repositories (scope: read:user).",
      },
      {
        nav: "3. Data & deletion",
        summary: "Your learning progress belongs to you. Signed-in progress can sync across devices. Managed Coach grading sends only the submitted task context and answer to Anthropic. Account deletion removes synced progress and linked sponsorship metadata.",
        title: "3. Your data & deletion",
        body: "Your learning progress is yours. It syncs to your account so it follows you across devices. When you explicitly request managed Coach grading, Skein sends Anthropic the current practice task, constraints, grading rubric/model answer context, and the learner response you submitted; your broader progress history is not sent. You can delete your account at any time from the Account page; deletion permanently removes your account, synced progress, entitlements, AI usage records, and linked GitHub sponsorship metadata held for that account.",
      },
      {
        nav: "4. Acceptable use",
        summary: "Use Skein for learning without disrupting the service. Don’t scrape at scale or bypass rate limits. Don’t use the service to harm others.",
        title: "4. Acceptable use",
        body: "Do not abuse the service: no automated scraping at scale, no attempts to disrupt availability, no circumventing rate limits, no using the service to harm others.",
      },
      {
        nav: "5. Changes",
        summary: "These Terms may change as Skein evolves. Material changes increase the Terms version. You’ll be asked to accept material changes again.",
        title: "5. Changes",
        body: "These Terms may be updated. Material changes bump the Terms version and you will be asked to accept again. Continued use after acceptance means you agree.",
      },
    ],
    summaryLabel: "TL;DR",
  },
  ru: {
    sections: [
      {
        nav: "1. Сервис",
        summary: "Skein бесплатен для личного обучения. Контент может измениться или стать недоступным в любой момент. Мы не гарантируем точность или доступность.",
        title: "1. Сервис",
        body: "Контент предоставляется бесплатно, «как есть», для личного обучения. Он может меняться или становиться недоступным в любой момент. Гарантии точности или доступности не предоставляются.",
      },
      {
        nav: "2. Аккаунты",
        summary: "GitHub OAuth используется для входа, синхронизации прогресса и привязки необязательного Coach-доступа через GitHub Sponsors. Мы не собираем email и не читаем репозитории.",
        title: "2. Аккаунты",
        body: "Вход выполняется через GitHub OAuth. Мы храним ваш GitHub id, имя пользователя, выбранный никнейм, URL аватара и время принятия этих Условий. Если вы используете Skein Coach через GitHub Sponsors, мы также храним связанный sponsorship id, GitHub id спонсора, тариф, платёжные метаданные, privacy level и статус sponsorship, необходимые для поддержки entitlement. Мы не собираем email и не читаем ваши репозитории (scope: read:user).",
      },
      {
        nav: "3. Данные и удаление",
        summary: "Ваш учебный прогресс принадлежит вам. После входа он может синхронизироваться между устройствами. Managed Coach отправляет Anthropic только контекст отправленного задания и ваш ответ. Удаление аккаунта удаляет синхронизированный прогресс и связанные sponsorship-данные.",
        title: "3. Ваши данные и удаление",
        body: "Ваш учебный прогресс принадлежит вам. Он синхронизируется с аккаунтом, чтобы быть доступным на всех устройствах. Когда вы явно запускаете managed Coach grading, Skein отправляет Anthropic текущее практическое задание, ограничения, rubric/model answer контекст и отправленный вами ответ; остальная история прогресса не отправляется. Вы можете удалить аккаунт в любой момент на странице Кабинета; удаление безвозвратно стирает аккаунт, синхронизированный прогресс, entitlements, записи использования AI и связанные с аккаунтом метаданные GitHub sponsorship.",
      },
      {
        nav: "4. Допустимое использование",
        summary: "Используйте Skein для обучения, не нарушая работу сервиса. Не запускайте массовый скрейпинг и не обходите лимиты. Не используйте сервис во вред другим.",
        title: "4. Допустимое использование",
        body: "Не злоупотребляйте сервисом: никакого массового автоматического скрейпинга, попыток нарушить доступность, обхода лимитов запросов или использования сервиса во вред другим.",
      },
      {
        nav: "5. Изменения",
        summary: "Условия могут меняться вместе со Skein. Существенные изменения повышают версию Условий. После существенных изменений вас попросят принять их заново.",
        title: "5. Изменения",
        body: "Эти Условия могут обновляться. Существенные изменения повышают версию Условий, и вас попросят принять их заново. Продолжение использования после принятия означает согласие.",
      },
    ],
    summaryLabel: "КРАТКО",
  },
} as const;

const c = copy[lang];
---
<Topic title={t("terms.title", lang)} lang={lang}>
  <article class="terms-map" data-terms-map>
    <h1>{t("terms.title", lang)}</h1>

    <nav class="terms-route" aria-label={t("terms.title", lang)}>
      {c.sections.map((section, index) => (
        <button type="button" class="terms-stop" data-terms-stop={index} aria-current={index === 0 ? "step" : undefined}>
          <span class="stop-dot" aria-hidden="true"></span>
          <span>{section.nav}</span>
        </button>
      ))}
    </nav>

    <div class="terms-cards">
      {c.sections.map((section, index) => (
        <section class="terms-card" data-terms-card={index} hidden={index !== 0}>
          <div class="terms-summary">
            <p class="terms-eyebrow">{c.summaryLabel}</p>
            <p class="summary-copy">{section.summary}</p>
          </div>
          <div class="legal-copy">
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </div>
        </section>
      ))}
    </div>
  </article>

  <script>
    const root = document.querySelector<HTMLElement>("[data-terms-map]");
    if (root) {
      const stops = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-terms-stop]"));
      const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-terms-card]"));
      for (const stop of stops) {
        stop.addEventListener("click", () => {
          const index = stop.dataset.termsStop;
          for (const item of stops) {
            if (item === stop) item.setAttribute("aria-current", "step");
            else item.removeAttribute("aria-current");
          }
          for (const card of cards) card.hidden = card.dataset.termsCard !== index;
        });
      }
    }
  </script>
</Topic>

<style>
  .terms-map { width: min(100%, 1016px); margin: 0 auto; padding-top: 29px; }
  .terms-map > h1 { margin: 0 0 52px; font-size: 36px; line-height: 1; letter-spacing: -0.03em; }
  .terms-route { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0 6px 36px; }
  .terms-stop { position: relative; display: grid; grid-template-rows: 18px auto; justify-items: start; gap: 11px; min-width: 0; min-height: 44px; padding: 0 8px 0 0; border: 0; background: transparent; color: var(--ink-2); text-align: left; cursor: pointer; font: 11px/1.25 var(--font-mono); }
  .terms-stop::after { content: ""; position: absolute; top: 7px; left: 14px; right: -1px; height: 1px; background: var(--rule-strong); }
  .terms-stop:last-child::after { display: none; }
  .stop-dot { position: relative; z-index: 1; width: 15px; height: 15px; border: 1px solid var(--ink); border-radius: 50%; background: var(--paper); }
  .terms-stop[aria-current="step"] { color: var(--ink); }
  .terms-stop[aria-current="step"] .stop-dot { background: var(--ink); }
  .terms-card { display: grid; gap: 0; }
  .terms-card[hidden] { display: none; }
  .terms-summary { padding: 25px 30px 26px; border: 1px solid var(--rule-strong); border-radius: 3px; background: var(--paper-2); }
  .terms-eyebrow { margin: 0 0 10px; font: 600 10px/1 var(--font-mono); letter-spacing: .12em; color: var(--muted); }
  .summary-copy { margin: 0; max-width: 69ch; font-family: var(--font-body); font-size: 17px; line-height: 1.5; font-weight: 520; color: var(--ink); }
  .legal-copy { padding: 35px 2px 0; color: var(--ink); }
  .legal-copy h2 { margin: 0 0 13px; font-family: var(--font-display); font-size: 24px; line-height: 1.15; font-weight: 620; letter-spacing: -0.02em; }
  .legal-copy p { margin: 0; max-width: 78ch; font-family: var(--font-body); font-size: 15px; line-height: 1.65; color: var(--ink-2); }
  .terms-stop:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; border-radius: 2px; }

  @media (max-width: 780px) {
    .terms-map { padding-top: 4px; }
    .terms-map > h1 { margin-bottom: 30px; font-size: 32px; }
    .terms-route { grid-template-columns: 1fr; gap: 0; margin: 0 0 18px; border: 1px solid var(--rule-strong); border-radius: 5px; overflow: hidden; }
    .terms-stop { grid-template-columns: 18px 1fr; grid-template-rows: auto; align-items: center; gap: 10px; padding: 10px 12px; border-bottom: 1px solid var(--rule); }
    .terms-stop:last-child { border-bottom: 0; }
    .terms-stop::after { display: none; }
    .stop-dot { width: 12px; height: 12px; }
    .terms-summary { padding: 22px 20px; }
    .summary-copy { font-size: 16px; }
    .legal-copy { padding-top: 28px; }
    .legal-copy h2 { font-size: 22px; }
  }
</style>
