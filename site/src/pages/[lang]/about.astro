---
import Topic from "../../layouts/Topic.astro";
import { type Locale, isLocale } from "../../i18n";
import "../../styles/screen-kit.css";
import "../../styles/about-screen.css";
import { selectOther } from "~/scripts/build-incremental";

export function getStaticPaths() {
  return selectOther([{ params: { lang: "en" } }, { params: { lang: "ru" } }]);
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error("bad lang");

const en = {
  kicker: "About the rating",
  title: "What does senior mean?",
  sub: "The ladder isn't about years served. It tracks how much you can be trusted to own — and that maps onto how the market reads junior, middle, and senior.",
  juniorH: "Junior — work under supervision",
  juniorB: "A junior ships real code, but inside guardrails. Someone breaks the work into tickets, reviews every PR, and catches the edge cases you didn't see yet. You're learning the codebase and the craft; mistakes are expected and cheap because someone is watching the blast radius.",
  middleH: "Middle — own features end to end",
  middleB: "A middle engineer takes a fuzzy feature and lands it without hand-holding: design, implementation, tests, rollout. You review other people's code and your judgement on small tradeoffs is trusted. You still escalate the big architectural calls — but day-to-day, you're autonomous.",
  seniorH: "Senior — own systems and outcomes",
  seniorB: "A senior makes the systemic calls: which tradeoff, which failure mode you can live with, what to cut. You're the one paged at 3am who actually fixes the incident, and the one who mentors so the team doesn't repeat it. The job stops being \"write this code\" and becomes \"make this part of the system reliably someone's problem to no longer worry about.\"",
  measureH: "How this site measures it",
  measureB: "Calibration places you with a short adaptive test, not a quiz score. From there a personalized path picks what to learn next at your depth. As you work through it, your per-domain rating moves — and the rank ladder reflects it. It's a self-assessment, not a certificate; the anchor ranks below are marked with the hiring bar they roughly line up to.",
};
const ru = {
  kicker: "О рейтинге",
  title: "Что значит senior?",
  sub: "Лестница — не про годы стажа. Она отражает, сколько тебе можно доверить владеть, и это ложится на то, как рынок читает junior, middle и senior.",
  juniorH: "Junior — работа под присмотром",
  juniorB: "Джун пишет реальный код, но внутри ограничителей. Кто-то режет работу на задачи, проверяет каждый PR и ловит краевые случаи, которые ты пока не видишь. Ты осваиваешь кодовую базу и ремесло; ошибки ожидаемы и дёшевы, потому что кто-то следит за радиусом поражения.",
  middleH: "Middle — фичи целиком, самостоятельно",
  middleB: "Middle берёт размытую фичу и доводит её без присмотра: дизайн, реализация, тесты, выкатка. Ты ревьюишь чужой код, и твоему суждению по мелким tradeoff'ам доверяют. Крупные архитектурные решения ты всё ещё эскалируешь — но в повседневке ты автономен.",
  seniorH: "Senior — системы и результат",
  seniorB: "Senior принимает системные решения: какой tradeoff, с каким режимом отказа можно жить, что вырезать. Это тебя будят в 3 часа ночи — и ты реально чинишь инцидент, а потом менторишь, чтобы команда его не повторила. Работа перестаёт быть «напиши этот код» и становится «сделай так, чтобы эта часть системы перестала быть чьей-то болью».",
  measureH: "Как это измеряет сайт",
  measureB: "Калибровка определяет твой уровень коротким адаптивным тестом, а не баллом за викторину. Дальше персональный план подбирает, что учить следующим на твоей глубине. По мере прохождения рейтинг по доменам сдвигается, и ранговая лестница это отражает. Это самооценка, а не сертификат; опорные ранги ниже помечены тем рыночным уровнем, которому они примерно соответствуют.",
};
const c = lang === "ru" ? ru : en;
const title = lang === "ru" ? "Что значит senior?" : "What does senior mean?";
---
<Topic title={title} lang={lang}>
  <main class="page">
    <div class="wrap screen">
      <section class="screen-head">
        <div>
          <div class="kicker">{c.kicker}</div>
          <h1 class="sh-title" id="what-senior-means">{c.title}</h1>
          <p class="sh-sub">{c.sub}</p>
        </div>
      </section>

      <div class="about-levels">
        <article class="lvl-card" data-tier="junior">
          <h2 class="lvl-h">{c.juniorH}</h2>
          <p class="lvl-b">{c.juniorB}</p>
        </article>
        <article class="lvl-card" data-tier="middle">
          <h2 class="lvl-h">{c.middleH}</h2>
          <p class="lvl-b">{c.middleB}</p>
        </article>
        <article class="lvl-card" data-tier="senior">
          <h2 class="lvl-h">{c.seniorH}</h2>
          <p class="lvl-b">{c.seniorB}</p>
        </article>
      </div>

      <section class="about-measure panel">
        <h2 class="lvl-h">{c.measureH}</h2>
        <p class="lvl-b">{c.measureB}</p>
      </section>
    </div>
  </main>
</Topic>
