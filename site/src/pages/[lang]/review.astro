---
import Topic from "../../layouts/Topic.astro";
import ReviewSession from "../../components/pedagogy/ReviewSession.tsx";
import { type Locale, isLocale, t } from "../../i18n";
import { selectOther } from "~/scripts/build-incremental";

export function getStaticPaths() {
  return selectOther([{ params: { lang: "en" } }, { params: { lang: "ru" } }]);
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error("bad lang");
---
<Topic title={t("review.title", lang)} lang={lang}>
  <h1 class="text-3xl font-extrabold mb-6">{t("review.title", lang)}</h1>
  {/* SSR fallback: ReviewSession is a client:only island, so nothing renders
      until the JS bundle mounts. This skeleton mirrors the review card's layout
      so the page looks styled from first paint; ReviewSession removes it on
      mount and for brand-new visitors (no cards yet). */}
  <div id="review-fallback" class="my-10" aria-hidden="true">
    <div class="rounded-[var(--r-lg)] border-[0.5px] border-hairline-2 bg-card shadow-soft p-6 sm:p-7 animate-pulse">
      <div class="flex items-center justify-between mb-4">
        <span class="meta">{t("review.title", lang)}</span>
        <span class="h-3 w-16 rounded bg-hairline-2"></span>
      </div>
      <div class="h-[3px] w-full rounded-full bg-hairline-2 mb-6"></div>
      <div class="space-y-3 mb-8">
        <div class="h-5 w-4/5 rounded bg-hairline-2"></div>
        <div class="h-5 w-3/5 rounded bg-hairline-2"></div>
      </div>
      <div class="h-8 w-36 rounded-[var(--r-sm)] bg-hairline-2"></div>
    </div>
  </div>
  <ReviewSession client:only="preact" lang={lang} />
</Topic>
