---
import Topic from "~/layouts/Topic.astro";
import GrammarTopicView from "~/components/english/grammar/GrammarTopic.tsx";
import "~/components/english/grammar/grammar.css";
import { grammarTopics, grammarById } from "~/english/data/grammar/index";
import { FAMILIES } from "~/english/data/grammar/families";
import type { GrammarTopic } from "~/english/grammar-types";
import { type Locale, isLocale, t } from "~/i18n";
import { selectOther } from "~/scripts/build-incremental";
import { shardPaths } from "~/scripts/build-shard";

export function getStaticPaths() {
  const langs = ["en", "ru"] as const;
  const paths = grammarTopics.flatMap((tp) =>
    langs.map((lang) => ({ params: { lang, topic: tp.id } })),
  );
  const filtered = selectOther(paths);
  return shardPaths(filtered, (p) => `${p.params.lang}/${p.params.topic}`);
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error("bad lang");
const topicId = Astro.params.topic as string;
const topic = grammarById.get(topicId);
if (!topic) throw new Error(`unknown grammar topic: ${topicId}`);

const familyTitle = FAMILIES.find((f) => f.id === topic.family)?.title ?? { en: topic.family, ru: topic.family };

const related = topic.related
  .map((id) => grammarById.get(id))
  .filter((r): r is GrammarTopic => Boolean(r))
  .slice(0, 4)
  .map((r) => ({ id: r.id, title: r.title, family: r.family }));

const crossSpecs = topic.crossTopic
  .map((id) => grammarById.get(id))
  .filter((s): s is GrammarTopic => Boolean(s?.gen))
  .map((s) => ({ id: s.id, spec: s.gen! }));

const back = lang === "ru" ? "← Грамматика" : "← Grammar";
---
<Topic title={`${topic.title[lang]} · ${t("nav.english", lang)}`} lang={lang}>
  <div class="mb-2 text-[12px]">
    <a class="meta" href={`/${lang}/english/grammar`}>{back}</a>
  </div>
  <GrammarTopicView
    client:visible
    lang={lang}
    topic={topic}
    familyTitle={familyTitle}
    related={related}
    crossSpecs={crossSpecs}
    byok={false}
  />
</Topic>
