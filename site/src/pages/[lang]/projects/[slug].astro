---
import Atlas from "~/layouts/Atlas.astro";
import { getCollection } from "astro:content";
import { isLocale, type Locale } from "~/i18n";
import CapstonePath, { type GuidedMilestone } from "~/components/projects/CapstonePath.tsx";
import { selectOther } from "~/scripts/build-incremental";
import { readdirSync, statSync, existsSync, readFileSync } from "node:fs";
import { join } from "node:path";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const langs: Locale[] = ["en", "ru"];
  return selectOther(
    langs.flatMap((lang) =>
      projects.map((p) => ({ params: { lang, slug: p.data.slug }, props: { project: p.data } })),
    ),
  );
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale: ${lang}`);
const { project: p } = Astro.props;
const tt = (en: string, ru: string) => (lang === "ru" ? ru : en);

// Normalise milestones to the guided shape: legacy plain {en,ru} → a title-only
// stub (still trackable), guided objects pass through unchanged.
const guidedMilestones: GuidedMilestone[] = (p.milestones as any[]).map((m, i) =>
  m && typeof m === "object" && typeof m.id === "string"
    ? (m as GuidedMilestone)
    : { id: `m${i + 1}`, title: m, goal: { en: "", ru: "" }, definitionOfDone: [] },
);

// Read the starter scaffold's file tree straight off disk at render time (build + dev),
// so no generated index is needed. `bun run build:starters` separately zips it for download.
function scaffoldTree(slug: string): { files: string[]; test: string } | null {
  const base = join(process.cwd(), "projects-workbench", slug);
  const scaffold = join(base, "scaffold");
  if (!existsSync(scaffold)) return null;
  const files: string[] = [];
  const walk = (dir: string, rel: string) => {
    for (const e of readdirSync(dir).sort()) {
      const full = join(dir, e);
      const r = rel ? `${rel}/${e}` : e;
      if (statSync(full).isDirectory()) walk(full, r);
      else files.push(r);
    }
  };
  walk(scaffold, "");
  let test = "bun test";
  try { test = JSON.parse(readFileSync(join(base, "manifest.json"), "utf8")).test ?? "bun test"; } catch { /* default */ }
  return { files, test };
}
const starter = p.workbench ? scaffoldTree(p.slug) : null;

// The learner repo mirrors every workbench scaffold (generated by
// scripts/sync-projects-repo.mjs). Solutions live only upstream, so linking here
// hands over the starter without spoiling it — and a fork gets CI grading for free.
const REPO = "fallowlone/awesome-everything-projects";
const projectUrl = `https://github.com/${REPO}/tree/main/projects/${p.slug}`;
const degitCmd = `npx degit ${REPO}/projects/${p.slug} ${p.slug}`;

const L = {
  back: tt("All projects", "Все проекты"),
  category: tt("Category", "Категория"),
  deliverable: tt("Deliverable", "Результат"),
  skills: tt("Skills", "Навыки"),
  stack: tt("Suggested stack", "Рекомендуемый стек"),
  milestones: tt("Milestones", "Этапы"),
  stretch: tt("Make it senior", "Сделай по-сеньорски"),
  resources: tt("Resources", "Материалы"),
  starter: tt("Starter", "Стартер"),
  openOnGithub: tt("Open on GitHub", "Открыть на GitHub"),
  grabIt: tt("Grab just this project", "Забрать только этот проект"),
  copy: tt("Copy", "Копировать"),
  copied: tt("Copied", "Скопировано"),
  howToVerify: tt("Verify yourself", "Проверь себя"),
  verifySteps: tt("Implement the stubs, then run the tests until they pass:",
    "Реализуй заглушки, затем гоняй тесты, пока не позеленеют:"),
  gradeHint: tt(
    "Fork the repo and push your work — the grade workflow runs the suite plus static checks on your own runners.",
    "Форкни репозиторий и запушь свою работу — workflow grade прогонит тесты и статические проверки на твоих раннерах.",
  ),
  rubric: tt("Rubric", "Рубрика"),
  junior: tt("Junior", "Джуниор"),
  mid: tt("Mid", "Миддл"),
  senior: tt("Senior", "Сеньор"),
  reference: tt("Reference walkthrough (spoiler)", "Эталонный разбор (спойлер)"),
};
---
<Atlas title={tt(p.title.en, p.title.ru)} lang={lang}>
  <div class="oa-wrap" style="padding-bottom: var(--s-9);">
    <a href={`/${lang}/projects`} class="text-sm text-muted">← {L.back}</a>
    <header class="oa-pagehead oa-pagehead-wide mt-2">
      <p class="kicker">{p.category} · {p.difficulty} · {p.estDays}d</p>
      <h1>{tt(p.title.en, p.title.ru)}</h1>
      <p class="ph-blurb">{tt(p.pitch.en, p.pitch.ru)}</p>
    </header>

    {p.brief && <section class="prose-block my-6">{tt(p.brief.en, p.brief.ru)}</section>}

    <section class="my-6">
      <h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-1">{L.deliverable}</h2>
      <p class="prose-block">{tt(p.deliverable.en, p.deliverable.ru)}</p>
    </section>

    <CapstonePath client:visible lang={lang} slug={p.slug} milestones={guidedMilestones} />

    {starter && (
      <section class="my-6">
        <h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-2">{L.starter}</h2>
        <div class="starter-card">
          <div class="sc-head">
            <svg class="sc-mark" viewBox="0 0 16 16" width="22" height="22" aria-hidden="true">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            <div class="sc-id">
              <p class="sc-repo">{REPO}</p>
              <p class="sc-path">projects/{p.slug}</p>
            </div>
            <a class="oa-btn oa-btn-primary oa-btn-sm" href={projectUrl} target="_blank" rel="noopener noreferrer">
              {L.openOnGithub} ↗
            </a>
          </div>

          <ul class="sc-files">
            {starter.files.map((f) => <li>{f}</li>)}
          </ul>

          <div class="sc-grab">
            <span class="sc-grab-label">{L.grabIt}</span>
            <code class="sc-cmd" id="degit-cmd">{degitCmd}</code>
            <button type="button" class="oa-btn oa-btn-secondary oa-btn-sm sc-copy"
              data-cmd={degitCmd} data-copied={L.copied}>{L.copy}</button>
          </div>

          <p class="sc-hint">{L.verifySteps} <code>{starter.test}</code></p>
          <p class="sc-hint">{L.gradeHint}</p>
        </div>
      </section>
    )}

    {p.rubric && (
      <section class="my-6">
        <h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-2">{L.rubric}</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="text-left text-muted">
                <th class="border-b border-rule p-2"></th>
                <th class="border-b border-rule p-2 font-mono uppercase tracking-wide text-xs">{L.junior}</th>
                <th class="border-b border-rule p-2 font-mono uppercase tracking-wide text-xs">{L.mid}</th>
                <th class="border-b border-rule p-2 font-mono uppercase tracking-wide text-xs">{L.senior}</th>
              </tr>
            </thead>
            <tbody>
              {p.rubric.map((row) => (
                <tr class="align-top">
                  <th scope="row" class="border-b border-rule p-2 text-left font-semibold">{tt(row.dimension.en, row.dimension.ru)}</th>
                  <td class="border-b border-rule p-2">{tt(row.junior.en, row.junior.ru)}</td>
                  <td class="border-b border-rule p-2">{tt(row.mid.en, row.mid.ru)}</td>
                  <td class="border-b border-rule p-2">{tt(row.senior.en, row.senior.ru)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {p.reference && (
      <details class="my-6">
        <summary class="text-sm font-mono uppercase tracking-wide text-muted cursor-pointer">{L.reference}</summary>
        <div class="prose-block mt-3 space-y-2">{p.reference.map((s) => <p>{tt(s.en, s.ru)}</p>)}</div>
      </details>
    )}

    <section class="my-6">
      <h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-2">{L.stretch}</h2>
      <ul class="list-disc pl-5 space-y-1">{p.seniorStretch.map((s) => <li>{tt(s.en, s.ru)}</li>)}</ul>
    </section>

    <section class="my-6 flex flex-wrap gap-2">
      <div class="w-full"><h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-1">{L.skills}</h2></div>
      {p.skills.map((s) => <span class="text-[11px] font-mono px-2 py-0.5 rounded-full border border-rule text-muted">{s}</span>)}
    </section>

    {p.stack && <section class="my-6 flex flex-wrap gap-2">
      <div class="w-full"><h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-1">{L.stack}</h2></div>
      {p.stack.map((s) => <span class="text-[11px] font-mono px-2 py-0.5 rounded-full border border-rule text-muted">{s}</span>)}
    </section>}

    {p.resources && <section class="my-6">
      <h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-2">{L.resources}</h2>
      <ul class="list-disc pl-5 space-y-1">{p.resources.map((r) => <li><a class="text-ok" href={r.url} rel="noopener noreferrer">{r.label}</a></li>)}</ul>
    </section>}
  </div>
</Atlas>

<style>
  .starter-card {
    border: 0.5px solid var(--rule);
    border-radius: var(--r-md);
    background: var(--card);
    padding: var(--s-5);
    max-width: 90ch;
  }
  .sc-head { display: flex; align-items: center; gap: var(--s-4); flex-wrap: wrap; }
  .sc-mark { color: var(--ink); flex: none; }
  .sc-id { min-width: 0; margin-right: auto; }
  .sc-repo { font-family: var(--font-mono); font-size: var(--fs-small); color: var(--ink); }
  .sc-path { font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
  .sc-files {
    display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4);
    list-style: none; padding: 0;
    margin-top: var(--s-4); padding-top: var(--s-4);
    border-top: 0.5px solid var(--hairline);
    font-family: var(--font-mono); font-size: 11px; color: var(--muted);
  }
  .sc-grab { display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; margin-top: var(--s-4); }
  .sc-grab-label {
    font-family: var(--font-mono); font-size: var(--fs-mono-label);
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
    width: 100%;
  }
  .sc-cmd {
    /* Wrap rather than scroll: a half-visible command reads as truncated, and the
       learner needs to see the whole thing before trusting the copy button. */
    flex: 1 1 340px; min-width: 0; white-space: pre-wrap; word-break: break-all;
    font-family: var(--font-mono); font-size: var(--fs-small);
    background: var(--code-bg, var(--card-2)); color: var(--code-ink, var(--ink));
    border: 0.5px solid var(--hairline-2); border-radius: var(--r-sm);
    padding: 7px 10px;
  }
  .sc-hint { font-size: var(--fs-small); color: var(--muted); margin-top: var(--s-3); line-height: 1.5; }
  .sc-hint code { font-family: var(--font-mono); color: var(--ink); }
</style>

<script>
  // Copy-to-clipboard for the degit command. Kept as a page script rather than an
  // island: no state, no hydration, and the button is inert-but-harmless if it fails.
  document.querySelectorAll<HTMLButtonElement>(".sc-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const cmd = btn.dataset.cmd ?? "";
      try {
        await navigator.clipboard.writeText(cmd);
      } catch {
        return; // clipboard blocked (insecure context / denied) — leave the label alone
      }
      const original = btn.textContent;
      btn.textContent = btn.dataset.copied ?? "Copied";
      setTimeout(() => { btn.textContent = original; }, 1600);
    });
  });
</script>
