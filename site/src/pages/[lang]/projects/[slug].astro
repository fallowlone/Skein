---
import Atlas from "~/layouts/Atlas.astro";
import { getCollection } from "astro:content";
import { isLocale, type Locale } from "~/i18n";
import CapstonePath, { type GuidedMilestone } from "~/components/projects/CapstonePath.tsx";
import { selectOther } from "~/scripts/build-incremental";
import { readdirSync, statSync, existsSync, readFileSync } from "node:fs";
import { join } from "node:path";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const langs: Locale[] = ["en", "ru"];
  return selectOther(
    langs.flatMap((lang) =>
      projects.map((p) => ({ params: { lang, slug: p.data.slug }, props: { project: p.data } })),
    ),
  );
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale: ${lang}`);
const { project: p } = Astro.props;
const tt = (en: string, ru: string) => (lang === "ru" ? ru : en);

// Normalise milestones to the guided shape: legacy plain {en,ru} → a title-only
// stub (still trackable), guided objects pass through unchanged.
const guidedMilestones: GuidedMilestone[] = (p.milestones as any[]).map((m, i) =>
  m && typeof m === "object" && typeof m.id === "string"
    ? (m as GuidedMilestone)
    : { id: `m${i + 1}`, title: m, goal: { en: "", ru: "" }, definitionOfDone: [] },
);

// Read the starter scaffold's file tree straight off disk at render time (build + dev),
// so no generated index is needed. `bun run build:starters` separately zips it for download.
function scaffoldTree(slug: string): { files: string[]; test: string } | null {
  const base = join(process.cwd(), "projects-workbench", slug);
  const scaffold = join(base, "scaffold");
  if (!existsSync(scaffold)) return null;
  const files: string[] = [];
  const walk = (dir: string, rel: string) => {
    for (const e of readdirSync(dir).sort()) {
      const full = join(dir, e);
      const r = rel ? `${rel}/${e}` : e;
      if (statSync(full).isDirectory()) walk(full, r);
      else files.push(r);
    }
  };
  walk(scaffold, "");
  let test = "bun test";
  try { test = JSON.parse(readFileSync(join(base, "manifest.json"), "utf8")).test ?? "bun test"; } catch { /* default */ }
  return { files, test };
}
const starter = p.workbench ? scaffoldTree(p.slug) : null;

const L = {
  back: tt("All projects", "Все проекты"),
  category: tt("Category", "Категория"),
  deliverable: tt("Deliverable", "Результат"),
  skills: tt("Skills", "Навыки"),
  stack: tt("Suggested stack", "Рекомендуемый стек"),
  milestones: tt("Milestones", "Этапы"),
  stretch: tt("Make it senior", "Сделай по-сеньорски"),
  resources: tt("Resources", "Материалы"),
  starter: tt("Starter", "Стартер"),
  download: tt("Download starter (.zip)", "Скачать стартер (.zip)"),
  howToVerify: tt("Verify yourself", "Проверь себя"),
  verifySteps: tt("Unzip, implement the stubs, then run the tests until they pass:",
    "Распакуй, реализуй заглушки, затем гоняй тесты, пока не позеленеют:"),
  rubric: tt("Rubric", "Рубрика"),
  junior: tt("Junior", "Джуниор"),
  mid: tt("Mid", "Миддл"),
  senior: tt("Senior", "Сеньор"),
  reference: tt("Reference walkthrough (spoiler)", "Эталонный разбор (спойлер)"),
};
---
<Atlas title={tt(p.title.en, p.title.ru)} lang={lang}>
  <div class="oa-wrap" style="padding-bottom: var(--s-9);">
    <a href={`/${lang}/projects`} class="text-sm text-muted">← {L.back}</a>
    <header class="oa-pagehead mt-2">
      <p class="kicker">{p.category} · {p.difficulty} · {p.estDays}d</p>
      <h1>{tt(p.title.en, p.title.ru)}</h1>
      <p class="ph-blurb">{tt(p.pitch.en, p.pitch.ru)}</p>
    </header>

    {p.brief && <section class="prose-block my-6">{tt(p.brief.en, p.brief.ru)}</section>}

    <section class="my-6">
      <h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-1">{L.deliverable}</h2>
      <p>{tt(p.deliverable.en, p.deliverable.ru)}</p>
    </section>

    <CapstonePath client:visible lang={lang} slug={p.slug} milestones={guidedMilestones} />

    {starter && (
      <section class="my-6">
        <h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-2">{L.starter}</h2>
        <ul class="font-mono text-xs text-muted mb-3 list-none pl-0 space-y-0.5">
          {starter.files.map((f) => <li>{f}</li>)}
        </ul>
        <a class="text-ok" href={`/project-starters/${p.slug}.zip`}>{L.download}</a>
        <p class="mt-3 text-sm">{L.verifySteps} <code class="font-mono">{starter.test}</code></p>
      </section>
    )}

    {p.rubric && (
      <section class="my-6">
        <h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-2">{L.rubric}</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="text-left text-muted">
                <th class="border-b border-rule p-2"></th>
                <th class="border-b border-rule p-2 font-mono uppercase tracking-wide text-xs">{L.junior}</th>
                <th class="border-b border-rule p-2 font-mono uppercase tracking-wide text-xs">{L.mid}</th>
                <th class="border-b border-rule p-2 font-mono uppercase tracking-wide text-xs">{L.senior}</th>
              </tr>
            </thead>
            <tbody>
              {p.rubric.map((row) => (
                <tr class="align-top">
                  <th scope="row" class="border-b border-rule p-2 text-left font-semibold">{tt(row.dimension.en, row.dimension.ru)}</th>
                  <td class="border-b border-rule p-2">{tt(row.junior.en, row.junior.ru)}</td>
                  <td class="border-b border-rule p-2">{tt(row.mid.en, row.mid.ru)}</td>
                  <td class="border-b border-rule p-2">{tt(row.senior.en, row.senior.ru)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {p.reference && (
      <details class="my-6">
        <summary class="text-sm font-mono uppercase tracking-wide text-muted cursor-pointer">{L.reference}</summary>
        <div class="prose-block mt-3 space-y-2">{p.reference.map((s) => <p>{tt(s.en, s.ru)}</p>)}</div>
      </details>
    )}

    <section class="my-6">
      <h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-2">{L.stretch}</h2>
      <ul class="list-disc pl-5 space-y-1">{p.seniorStretch.map((s) => <li>{tt(s.en, s.ru)}</li>)}</ul>
    </section>

    <section class="my-6 flex flex-wrap gap-2">
      <div class="w-full"><h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-1">{L.skills}</h2></div>
      {p.skills.map((s) => <span class="text-[11px] font-mono px-2 py-0.5 rounded-full border border-rule text-muted">{s}</span>)}
    </section>

    {p.stack && <section class="my-6 flex flex-wrap gap-2">
      <div class="w-full"><h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-1">{L.stack}</h2></div>
      {p.stack.map((s) => <span class="text-[11px] font-mono px-2 py-0.5 rounded-full border border-rule text-muted">{s}</span>)}
    </section>}

    {p.resources && <section class="my-6">
      <h2 class="text-sm font-mono uppercase tracking-wide text-muted mb-2">{L.resources}</h2>
      <ul class="list-disc pl-5 space-y-1">{p.resources.map((r) => <li><a class="text-ok" href={r.url} rel="noopener noreferrer">{r.label}</a></li>)}</ul>
    </section>}
  </div>
</Atlas>
