---
import Atlas from "~/layouts/Atlas.astro";
import ProjectsFilter, { type ProjectCard } from "~/components/projects/ProjectsFilter.tsx";
import { getCollection } from "astro:content";
import { t, isLocale, type Locale } from "~/i18n";
import { selectOther } from "~/scripts/build-incremental";

export function getStaticPaths() {
  return selectOther([{ params: { lang: "en" } }, { params: { lang: "ru" } }]);
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale: ${lang}`);

// Project the entries down to what the filter island actually renders, in this
// locale only. Handing it `p.data` serialised every milestone/rubric/reference
// of all 51 projects in both languages into the island's `props` attribute —
// 1.57 MB of HTML on this page alone.
const projects: ProjectCard[] = (await getCollection("projects")).map((p) => ({
  slug: p.data.slug,
  title: p.data.title[lang],
  pitch: p.data.pitch[lang],
  tracks: p.data.tracks,
  difficulty: p.data.difficulty,
  category: p.data.category,
  estDays: p.data.estDays,
  workbench: p.data.workbench,
}));
---

<Atlas title={t("projects.title", lang)} lang={lang}>
  <div class="oa-wrap" style="padding-bottom: var(--s-9);">
    <header class="poster-head">
      <p class="ph-kicker"><span>№00</span><span>{t("projects.kicker", lang)} · {projects.length}</span></p>
      <h1 class="poster-giant poster-page-size" style="margin-top: var(--s-4);">
        <span class="pg-solid">{t("projects.title", lang)}</span>
      </h1>
      <p class="ph-blurb">{t("projects.crux", lang)}</p>
    </header>
    <ProjectsFilter client:visible lang={lang} projects={projects} />
  </div>
</Atlas>
