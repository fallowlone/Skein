---
import Topic from "../../layouts/Topic.astro";
import InterviewQABank from "../../components/interview/InterviewQABank.tsx";
import { type Locale, isLocale, t } from "../../i18n";
import { selectOther } from "~/scripts/build-incremental";
import iqData from "~/data/interview-questions.json";

export function getStaticPaths() {
  return selectOther([{ params: { lang: "en" } }, { params: { lang: "ru" } }]);
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error("bad lang");

const categories = Object.keys(iqData).sort();
const totalQuestions = Object.values(iqData).reduce((sum, c) => sum + c.questions.length, 0);
---
<Topic title={t("interviewQA.title", lang)} lang={lang} description={t("interviewQA.subtitle", lang)}>
  <h1 class="text-3xl font-extrabold mb-2">{t("interviewQA.title", lang)}</h1>
  <p class="text-muted mb-6">{t("interviewQA.subtitle", lang)} · {totalQuestions} questions</p>
  <InterviewQABank client:only="preact" lang={lang} categories={categories} data={iqData} />
</Topic>
