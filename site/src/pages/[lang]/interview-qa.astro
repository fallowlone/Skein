---
import Topic from "../../layouts/Topic.astro";
import InterviewQABank from "../../components/interview/InterviewQABank.tsx";
import { type Locale, isLocale, t } from "../../i18n";
import { selectOther } from "~/scripts/build-incremental";
import iqData from "~/data/interview-questions.json";

export function getStaticPaths() {
  return selectOther([{ params: { lang: "en" } }, { params: { lang: "ru" } }]);
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error("bad lang");

const categories = Object.keys(iqData).sort();
const totalQuestions = Object.values(iqData).reduce((sum, c) => sum + c.questions.length, 0);

const mapCopy = lang === "ru"
  ? {
      map: "Карта",
      legend: "Легенда",
      topic: "Тема",
      subtopic: "Подтема",
      related: "Связано с",
      optional: "Опционально",
      guided: "Guided routes (Supporter)",
      guidedSub: "Маршруты (подписка)",
      unlock: "Открыть маршруты",
      info: "Карта компетенций Angular",
    }
  : {
      map: "Map",
      legend: "Legend",
      topic: "Topic",
      subtopic: "Subtopic",
      related: "Related to",
      optional: "Optional",
      guided: "Guided routes (Supporter)",
      guidedSub: "Маршруты (подписка)",
      unlock: "Unlock routes",
      info: "Angular competency map",
    };
---
<Topic title={t("interviewQA.title", lang)} lang={lang} description={t("interviewQA.subtitle", lang)}>
  <aside class="skill-map-rail" aria-labelledby="skill-map-title">
    <header class="skill-map-head">
      <div class="skill-map-title-row">
        <h2 id="skill-map-title">{mapCopy.map}</h2>
        <span class="skill-map-info" title={mapCopy.info} aria-label={mapCopy.info}>i</span>
      </div>
      <span class="skill-map-minus" aria-hidden="true">−</span>
    </header>

    <svg class="skill-map-graph" viewBox="0 0 272 408" role="img" aria-label={mapCopy.info}>
      <g class="skill-map-edges">
        <line x1="136" y1="55" x2="136" y2="174" />
        <line x1="49" y1="111" x2="136" y2="174" />
        <line x1="223" y1="111" x2="136" y2="174" />
        <line x1="48" y1="174" x2="136" y2="174" />
        <line x1="224" y1="174" x2="136" y2="174" />
        <line x1="74" y1="249" x2="136" y2="174" />
        <line x1="204" y1="249" x2="136" y2="174" />
        <line x1="136" y1="174" x2="136" y2="326" />
        <line x1="136" y1="326" x2="58" y2="394" />
        <line x1="136" y1="326" x2="211" y2="394" />
      </g>

      <g class="skill-map-junctions" aria-hidden="true">
        <circle cx="136" cy="110" r="3.5" />
        <circle cx="91" cy="142" r="3.5" />
        <circle cx="181" cy="142" r="3.5" />
        <circle cx="91" cy="174" r="3.5" />
        <circle cx="181" cy="174" r="3.5" />
        <circle cx="103" cy="214" r="3.5" />
        <circle cx="171" cy="214" r="3.5" />
        <circle cx="136" cy="249" r="3.5" />
        <circle cx="96" cy="360" r="3.5" />
        <circle cx="174" cy="360" r="3.5" />
      </g>

      <g class="skill-map-nodes">
        <g transform="translate(94 18)"><rect width="84" height="36"/><text x="42" y="22">Concurrency</text></g>
        <g transform="translate(17 93)"><rect width="62" height="36"/><text x="31" y="22">RxJS</text></g>
        <g transform="translate(184 93)"><rect width="82" height="36"/><text x="41" y="22">Components</text></g>
        <g transform="translate(15 156)"><rect width="55" height="36"/><text x="27.5" y="22">DI</text></g>
        <g class="primary" transform="translate(96 151)"><rect width="80" height="46"/><text x="40" y="28">Angular</text></g>
        <g transform="translate(202 156)"><rect width="63" height="36"/><text x="31.5" y="22">Router</text></g>
        <g transform="translate(24 226)"><rect width="94" height="47"/><text x="47" y="20"><tspan x="47">State</tspan><tspan x="47" dy="14">Management</tspan></text></g>
        <g transform="translate(177 231)"><rect width="62" height="36"/><text x="31" y="22">Forms</text></g>
        <g transform="translate(94 307)"><rect width="84" height="37"/><text x="42" y="23">Performance</text></g>
        <g transform="translate(23 376)"><rect width="70" height="32"/><text x="35" y="20">Caching</text></g>
        <g transform="translate(174 376)"><rect width="78" height="32"/><text x="39" y="20">DB Indexes</text></g>
      </g>
    </svg>

    <section class="skill-map-box skill-map-legend" aria-label={mapCopy.legend}>
      <h3>{mapCopy.legend}</h3>
      <div class="legend-row"><span class="legend-topic" aria-hidden="true"></span><span>{mapCopy.topic}</span></div>
      <div class="legend-row"><span class="legend-subtopic" aria-hidden="true"></span><span>{mapCopy.subtopic}</span></div>
      <div class="legend-row"><span class="legend-related" aria-hidden="true"></span><span>{mapCopy.related}</span></div>
      <div class="legend-row"><span class="legend-optional" aria-hidden="true"></span><span>{mapCopy.optional}</span></div>
    </section>

    <section class="skill-map-box guided-routes" aria-label={mapCopy.guided}>
      <div class="guided-head">
        <div>
          <h3>{mapCopy.guided}</h3>
          <p>{mapCopy.guidedSub}</p>
        </div>
        <svg class="lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      </div>

      <div class="guided-list">
        {[
          ["Senior Backend", "30 days"],
          ["System Design", "14 days"],
          ["Fullstack Breadth", "21 days"],
        ].map(([title, days]) => (
          <div class="guided-route">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M9 4 3 6.2v13.6L9 17.6l6 2.2 6-2.2V4.2l-6 2.2L9 4Z"/><path d="M9 4v13.6M15 6.4V20"/></svg>
            <strong>{title}</strong><span>— {days}</span>
          </div>
        ))}
      </div>

      <a class="guided-unlock" href={`/${lang}/settings/`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        <span>{mapCopy.unlock}</span>
      </a>
    </section>
  </aside>

  <h1 class="text-3xl font-extrabold mb-2">{t("interviewQA.title", lang)}</h1>
  <p class="text-muted mb-6">{t("interviewQA.subtitle", lang)} · {totalQuestions} questions</p>
  <InterviewQABank client:only="preact" lang={lang} categories={categories} data={iqData} />
</Topic>

<style is:global>
  @media (min-width: 1100px) {
    .oa-shell { --rail-w-wide: 204px; }
    .oa-main { margin-left: 505px; }
    .oa-main > main {
      max-width: none;
      margin-inline: 0;
      padding-left: 36px;
      padding-right: 42px;
    }
  }
</style>

<style>
  .skill-map-rail { display: none; }

  @media (min-width: 1100px) {
    .skill-map-rail {
      position: fixed;
      z-index: 42;
      inset: 0 auto 0 204px;
      display: block;
      width: 301px;
      overflow-y: auto;
      padding: 25px 10px 28px;
      background: var(--paper-2);
      border-right: 1px solid var(--hairline-2);
      scrollbar-width: thin;
    }

    .skill-map-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 13px 10px 14px;
      color: var(--ink);
    }
    .skill-map-title-row { display: flex; align-items: center; gap: 7px; }
    .skill-map-head h2 {
      margin: 0;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 650;
      line-height: 1;
    }
    .skill-map-info {
      width: 13px;
      height: 13px;
      display: inline-grid;
      place-items: center;
      border: 1px solid var(--ink-2);
      border-radius: 50%;
      font-family: var(--font-body);
      font-size: 9px;
      font-weight: 600;
      line-height: 1;
      color: var(--ink-2);
    }
    .skill-map-minus { font-size: 16px; line-height: 1; color: var(--ink-2); }

    .skill-map-graph {
      display: block;
      width: 272px;
      height: 408px;
      margin: 24px auto 27px;
      overflow: visible;
      color: var(--ink-2);
    }
    .skill-map-edges line {
      stroke: var(--hairline-strong);
      stroke-width: 1;
      vector-effect: non-scaling-stroke;
    }
    .skill-map-junctions circle {
      fill: var(--paper-2);
      stroke: var(--ink-2);
      stroke-width: 1.1;
      vector-effect: non-scaling-stroke;
    }
    .skill-map-nodes rect {
      fill: var(--paper-2);
      stroke: var(--hairline-strong);
      stroke-width: 1;
      rx: 3;
      vector-effect: non-scaling-stroke;
    }
    .skill-map-nodes text {
      fill: var(--ink-2);
      font-family: var(--font-mono);
      font-size: 10.5px;
      text-anchor: middle;
      letter-spacing: 0.01em;
    }
    .skill-map-nodes .primary rect { fill: var(--card); }
    .skill-map-nodes .primary text { fill: var(--ink); font-size: 12px; font-weight: 700; }

    .skill-map-box {
      margin: 0 4px 14px;
      padding: 15px 13px;
      border: 1px solid var(--hairline-2);
      border-radius: var(--r-md);
      background: color-mix(in srgb, var(--paper-2) 92%, var(--card));
    }
    .skill-map-box h3 {
      margin: 0;
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 650;
      color: var(--ink);
    }
    .skill-map-legend { padding-block: 14px 18px; }
    .skill-map-legend h3 { margin-bottom: 12px; }
    .legend-row {
      display: flex;
      align-items: center;
      min-height: 21px;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--ink-2);
    }
    .legend-topic, .legend-subtopic {
      display: inline-block;
      border: 1px solid var(--ink-2);
      border-radius: 50%;
      background: var(--paper-2);
      flex: 0 0 auto;
    }
    .legend-topic { width: 11px; height: 11px; }
    .legend-subtopic { width: 7px; height: 7px; margin-left: 2px; margin-right: 2px; }
    .legend-related, .legend-optional {
      width: 14px;
      height: 1px;
      flex: 0 0 auto;
      background: var(--ink-2);
    }
    .legend-optional {
      height: 0;
      background: none;
      border-top: 1px dotted var(--ink-2);
    }

    .guided-routes { padding: 15px 11px 12px; }
    .guided-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
    .guided-head p {
      margin: 3px 0 0;
      font-size: 12px;
      line-height: 1.25;
      color: var(--muted);
    }
    .guided-head .lock { width: 17px; height: 17px; stroke-width: 1.5; }
    .guided-list { display: grid; gap: 7px; margin-top: 19px; }
    .guided-route {
      min-height: 38px;
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 0 10px;
      border: 1px solid var(--hairline-2);
      border-radius: var(--r-md);
      background: var(--paper-2);
      font-size: 10px;
      white-space: nowrap;
      color: var(--ink);
    }
    .guided-route svg { width: 17px; height: 17px; stroke-width: 1.4; flex: 0 0 auto; }
    .guided-route strong { font-weight: 650; }
    .guided-route span { color: var(--muted); }
    .guided-unlock {
      height: 39px;
      margin-top: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-radius: var(--r-md);
      background: var(--ink);
      color: var(--paper);
      font-size: 12px;
      font-weight: 600;
      text-decoration: none;
    }
    .guided-unlock:hover { color: var(--paper); text-decoration: none; opacity: .9; }
    .guided-unlock svg { width: 16px; height: 16px; stroke-width: 1.6; }
  }
</style>
