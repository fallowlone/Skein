---
import Topic from "../../layouts/Topic.astro";
import glossary from "../../i18n/glossary.json";
import { type Locale, isLocale, t } from "../../i18n";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ru" } }];
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error("bad lang");

type GlossEntry = { en: string; ru: string; defEn?: string; defRu?: string };
const entries = Object.values(glossary as Record<string, GlossEntry>)
  .map((e) => ({ label: e[lang], def: lang === "en" ? e.defEn : e.defRu }))
  .filter((e): e is { label: string; def: string } => Boolean(e.def))
  .sort((a, b) => a.label.localeCompare(b.label, lang));
---
<Topic title={t("nav.glossary", lang)} lang={lang}>
  <div class="max-w-[760px] mx-auto px-4 lg:px-8 mt-6">
    <h1 class="font-display text-[clamp(28px,4vw,40px)] font-bold leading-[1.1] tracking-[-0.02em] m-0 text-ink">
      {t("nav.glossary", lang)}
    </h1>
    <p class="text-ink-2 leading-relaxed mt-3 mb-8">{t("glossary.intro", lang)}</p>
    <dl class="m-0">
      {entries.map((e) => (
        <div class="py-4 border-t border-rule">
          <dt class="font-display font-bold text-ink text-[17px] mb-1">{e.label}</dt>
          <dd class="text-ink-2 leading-relaxed m-0">{e.def}</dd>
        </div>
      ))}
    </dl>
  </div>
</Topic>
