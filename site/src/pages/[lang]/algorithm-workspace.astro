---
import Atlas from "~/layouts/Atlas.astro";
import { getCollection } from "astro:content";
import { isLocale, t, type Locale } from "~/i18n";
import { selectOther } from "~/scripts/build-incremental";
import AlgorithmWorkspace, { type BankProblem } from "~/components/algo/workspace/AlgorithmWorkspace";
import { buildThreeSum } from "~/components/algo/workspace/problem-3sum";

export function getStaticPaths() {
  return selectOther((["en", "ru"] as const).map((lang) => ({ params: { lang } })));
}

const lang = Astro.params.lang as Locale;
if (!isLocale(lang)) throw new Error(`Unknown locale: ${lang}`);

const drillUnits = await getCollection("drill");
const arraysUnit = drillUnits.find((u) => u.data.track === "algorithms" && u.data.unit === "02-arrays-strings");
if (!arraysUnit) throw new Error("algorithm-workspace: missing algorithms/02-arrays-strings drill data");
const threeSum = arraysUnit.data.problems.find((p) => p.id === "3sum");
if (!threeSum) throw new Error("algorithm-workspace: missing the 3sum drill entry");

const problem = buildThreeSum({
  id: threeSum.id,
  leetcodeId: threeSum.leetcodeId,
  slug: threeSum.slug,
  title: threeSum.title,
  difficulty: threeSum.difficulty,
  pattern: threeSum.pattern,
  targetMinutes: threeSum.targetMinutes,
  companies: threeSum.companies,
  hints: threeSum.hints,
  followUp: threeSum.followUp,
});

const bankProblems: BankProblem[] = drillUnits
  .filter((u) => u.data.track === "algorithms")
  .flatMap((u) => u.data.problems.map((p) => ({
    id: p.id,
    leetcodeId: p.leetcodeId,
    title: p.title,
    pattern: p.pattern,
    difficulty: p.difficulty,
    targetMinutes: p.targetMinutes,
    companies: p.companies,
    unit: u.data.unit,
  })))
  .sort((a, b) => a.leetcodeId - b.leetcodeId);
---

<Atlas title={t("algoWorkspace.title", lang)} lang={lang} description={t("algoWorkspace.blurb", lang)} cspExtra="wasm">
  <div class="oa-wrap" style="padding-bottom: var(--s-9);">
    <header class="oa-pagehead oa-pagehead-wide">
      <p class="kicker">{t("algoWorkspace.kicker", lang)}</p>
      <h1>{t("algoWorkspace.title", lang)}</h1>
      <p class="ph-blurb">{t("algoWorkspace.blurb", lang)}</p>
    </header>
    <AlgorithmWorkspace
      client:only="preact"
      lang={lang}
      problem={problem}
      bankProblems={bankProblems}
      trackHref={`/${lang}/learn/algorithms`}
    />
  </div>
</Atlas>
