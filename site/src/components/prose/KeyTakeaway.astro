---
type Props = { title?: string };
const { title = "key takeaway" } = Astro.props;
---
<aside data-lesson-section="key-takeaway" class="kt-panel my-10">
  <div class="meta kt-label">{title}</div>
  <div class="font-display italic text-[19px] leading-snug text-ink" style="font-variation-settings: 'opsz' 144, 'SOFT' 70;">
    <slot />
  </div>
</aside>

<style>
  /* Accent-ghost tint + full padding frame + 4px radius, replacing the bare
     left border. Tokens resolve in both themes. */
  .kt-panel {
    background: var(--accent-ghost);
    border: var(--rule-w) solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--s-5);
  }
  .kt-panel .kt-label {
    color: var(--accent);
    margin-bottom: var(--s-2);
  }
</style>
