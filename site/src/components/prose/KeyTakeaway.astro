---
type Props = { title?: string };
const { title = "Key takeaway" } = Astro.props;
---
<div class="my-8 rounded-xl bg-bbg-success/5 border-2 border-bbg-success p-6 max-w-[820px]">
  <div class="flex items-center gap-2 mb-2">
    <span class="w-6 h-6 rounded-full bg-bbg-success grid place-items-center text-white text-sm font-extrabold">✓</span>
    <span class="font-bold text-bbg-success uppercase text-xs tracking-wider">{title}</span>
  </div>
  <div class="text-bbg-ink leading-relaxed"><slot /></div>
</div>
