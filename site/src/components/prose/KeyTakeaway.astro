---
type Props = { title?: string };
const { title = "key takeaway" } = Astro.props;
---
<aside data-lesson-section="key-takeaway" class="kt-panel my-10">
  <div class="meta kt-label">{title}</div>
  <div class="font-display italic text-[19px] leading-snug text-ink" style="font-variation-settings: 'opsz' 144, 'SOFT' 70;">
    <slot />
  </div>
</aside>

<style>

  /* Editorial emphasis: centered serif statement between hairlines, no card.
     Keeps the label quiet; whitespace does the containing. */
  .kt-panel {
    background: transparent;
    border: none;
    border-top: 0.5px solid var(--hairline-2);
    border-bottom: 0.5px solid var(--hairline-2);
    border-radius: 0;
    padding: var(--s-6) var(--s-4);
    text-align: center;
  }
  .kt-panel .kt-label {
    font-family: var(--font-body);
    color: var(--muted);
    margin-bottom: var(--s-3);
  }
</style>
