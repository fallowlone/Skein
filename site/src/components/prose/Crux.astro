---
type Props = { id?: string };
const { id = "crux" } = Astro.props;
---
<aside id={id} data-lesson-section="crux" class="crux-panel my-10">
  <div class="meta crux-label">crux</div>
  <div data-text-class="crux" class="font-display italic text-[22px] leading-snug text-ink" style="font-variation-settings: 'opsz' 144, 'SOFT' 100;">
    <slot />
  </div>
</aside>

<style>

  /* Editorial thesis: pull-quote voice — hairline over/under, no filled box.
     Keeps the CRUX label quiet so the serif sentence carries the weight. */
  .crux-panel {
    background: transparent;
    border: none;
    border-top: 0.5px solid var(--hairline-2);
    border-bottom: 0.5px solid var(--hairline-2);
    border-radius: 0;
    padding: var(--s-4) 0;
  }
  .crux-panel .crux-label {
    font-family: var(--font-body);
    color: var(--muted);
    margin-bottom: var(--s-2);
  }
</style>
