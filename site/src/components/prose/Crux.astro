---
type Props = { id?: string };
const { id = "crux" } = Astro.props;
---
<aside id={id} data-lesson-section="crux" class="crux-panel my-10">
  <div class="meta crux-label">crux</div>
  <div data-text-class="crux" class="font-display italic text-[22px] leading-snug text-ink" style="font-variation-settings: 'opsz' 144, 'SOFT' 100;">
    <slot />
  </div>
</aside>

<style>
  /* Lilac panel (style-guide signature) — pillar tint + left accent + sharp 2px
     radius framing the crux, replacing the bare hairlines. Both themes resolve
     via tokens. */
  .crux-panel {
    background: var(--p-lilac-bg);
    border: var(--rule-w) solid color-mix(in srgb, var(--p-lilac) 40%, transparent);
    border-left: 3px solid var(--p-lilac);
    border-radius: var(--radius);
    padding: var(--s-5) var(--s-5) var(--s-5) calc(var(--s-5) - 1px);
  }
  .crux-panel .crux-label {
    color: var(--p-lilac);
    margin-bottom: var(--s-3);
  }
</style>
