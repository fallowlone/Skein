---
type Tone = "info" | "warn" | "success" | "note";
type Props = { tone?: Tone; title?: string };
const { tone = "info", title } = Astro.props;
const color: Record<Tone, string> = {
  info:    "var(--accent)",
  warn:    "var(--warn)",
  success: "var(--ok)",
  note:    "var(--muted)",
};
---
<aside class="callout-panel my-6 max-w-[820px]" style={`--tone:${color[tone]};`}>
  {title && <div class="meta callout-label mb-2">{title}</div>}
  <div class="text-ink leading-relaxed text-[15px]"><slot /></div>
</aside>

<style>
  /* Tone tint (~8% of the tone color) + full padding frame + 4px radius,
     replacing the bare left border. --tone is set per-instance from the tone
     map; tokens resolve in both themes. */
  .callout-panel {
    background: color-mix(in srgb, var(--tone) 8%, var(--card));
    border: var(--rule-w) solid color-mix(in srgb, var(--tone) 28%, transparent);
    border-left: 2px solid var(--tone);
    border-radius: var(--radius-lg);
    padding: var(--s-4) var(--s-5);
  }
  .callout-panel .callout-label { color: var(--tone); }
</style>
