---
type Tone = "info" | "warn" | "success" | "note";
type Props = { tone?: Tone; title?: string };
const { tone = "info", title } = Astro.props;
const ring = {
  info:    "border-bbg-purple bg-panel-lilac",
  warn:    "border-bbg-warn bg-rose-50",
  success: "border-bbg-success bg-panel-mint",
  note:    "border-yellow-700 bg-yellow-50",
}[tone];
const titleColor = {
  info:    "text-bbg-purple",
  warn:    "text-bbg-warn",
  success: "text-bbg-success",
  note:    "text-yellow-800",
}[tone];
---
<aside class={`my-6 rounded-xl border-l-4 ${ring} p-5 max-w-[820px]`}>
  {title && <div class={`font-bold mb-2 ${titleColor}`}>{title}</div>}
  <div class="text-bbg-ink leading-relaxed text-[15px]"><slot /></div>
</aside>
