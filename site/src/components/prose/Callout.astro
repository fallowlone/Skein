---
type Tone = "info" | "warn" | "success" | "note";
type Props = { tone?: Tone; title?: string };
const { tone = "info", title } = Astro.props;
const color: Record<Tone, string> = {
  info:    "var(--accent)",
  warn:    "var(--warn)",
  success: "var(--ok)",
  note:    "var(--muted)",
};
---
<aside class="my-6 pl-5 border-l-2 max-w-[820px]" style={`border-color:${color[tone]};`}>
  {title && <div class="meta mb-2" style={`color:${color[tone]};`}>{title}</div>}
  <div class="text-ink leading-relaxed text-[15px]"><slot /></div>
</aside>
