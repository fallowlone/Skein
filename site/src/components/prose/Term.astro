---
import glossary from "../../i18n/glossary.json";
import type { Locale } from "../../i18n";

type GlossEntry = { en: string; ru: string; defEn?: string; defRu?: string };
type Props = { k: string; lang: Locale };

const { k, lang } = Astro.props;
const entry = (glossary as Record<string, GlossEntry>)[k];
const definition = entry ? (lang === "en" ? entry.defEn : entry.defRu) : undefined;
---
<dfn class="gloss font-medium text-ink not-italic" title={definition}><slot /></dfn>
