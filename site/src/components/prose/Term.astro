---
import glossary from "../../i18n/glossary.json";
import { localeFromPath, type Locale } from "../../i18n";

type GlossEntry = { en: string; ru: string; defEn?: string; defRu?: string };
type Props = {
  /** Glossary key. Content authors write `slug`; `k` is the legacy alias. */
  slug?: string;
  k?: string;
  /** Optional override; normally derived from the page URL. */
  lang?: Locale;
};

const { slug, k, lang: langProp } = Astro.props;

// Content calls this component as `<Term slug="heap">` — 607 of 611 usages, and
// none of them pass `lang`. The old signature read only `k` and a required
// `lang`, so `entry` was always undefined: no definition ever reached the page
// and the glossary tooltip was dead site-wide. Accept both names and derive the
// locale from the route.
const key = slug ?? k;
const lang: Locale = langProp ?? localeFromPath(Astro.url.pathname);
const entry = key ? (glossary as Record<string, GlossEntry>)[key] : undefined;
const definition = entry ? (lang === "en" ? entry.defEn : entry.defRu) : undefined;

// The definition used to ride in `title`, which Topic.astro's tooltip script then
// stripped (to suppress the duplicate native tooltip) — leaving a focusable
// element with no accessible name or description. It now ships as a hidden
// sibling referenced via aria-describedby: the custom tooltip stays purely
// visual and assistive tech gets the same text. A term can repeat on a page,
// hence the per-instance id suffix.
const defId = definition
  ? `gloss-${String(key).replace(/[^a-zA-Z0-9_-]/g, "-")}-${Math.random().toString(36).slice(2, 8)}`
  : undefined;
---
<dfn
  class="gloss font-medium text-ink not-italic"
  data-definition={definition}
  aria-describedby={defId}
  tabindex={definition ? "0" : undefined}
><slot /></dfn>{definition && <span id={defId} hidden>{definition}</span>}
