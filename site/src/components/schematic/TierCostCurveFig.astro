---
/**
 * TierCostCurveFig — Tier-B learning figure.
 *
 * The four V8 tiers as a cost-versus-speed curve: Ignition
 * (zero compile cost, slowest run), Sparkplug (microseconds
 * to template bytecode), Maglev (milliseconds, light
 * optimisation), TurboFan (tens-to-hundreds of ms, full
 * optimisation). A function moves right only when invocation
 * and back-edge budgets say it earned the compile.
 *
 * Server-rendered; the is:inline script walks the tiers.
 * Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "TIER COST CURVE",
    title: "Four tiers trade compile cost for run speed",
    label: "Ignition interprets at zero compile cost, Sparkplug templates bytecode in microseconds, Maglev lightly optimises in milliseconds, TurboFan fully optimises in tens to hundreds of milliseconds.",
    thesis: "A function moves right only when its budgets say it earned the compile.",
    caption: "The climb is budgeted, not free: invocation counts and back-edge heat pay for each tier's compile time. Cold code stays left forever — that is the whole point of tiering.",
    scope: "V8-SPECIFIC MODEL",
    curve: "COMPILE COST → RUN SPEED",
    budgets: "WHAT EARNS THE CLIMB",
    tiers: [
      { name: "Ignition", compile: "0 cost", run: "interpret", note: "zero compile cost — every function starts here" },
      { name: "Sparkplug", compile: "µs", run: "baseline", note: "templates bytecode to machine code in microseconds" },
      { name: "Maglev", compile: "ms", run: "mid-tier", note: "light optimisation in milliseconds — warms fast" },
      { name: "TurboFan", compile: "10–100 ms", run: "optimised", note: "full optimisation: inlining, escape analysis, scheduling" },
    ],
    invocations: "invocation count + back-edge heat",
    cold: "COLD STAYS LEFT",
    coldBody: "Cold code never pays for a compile it will not recoup. Tiering is a bet the engine only makes when the odds say it wins.",
  },
  ru: {
    category: "КРИВАЯ СТОИМОСТИ ТИРОВ",
    title: "Четыре tier'а меняют стоимость компиляции на скорость запуска",
    label: "Ignition интерпретирует с нулевой стоимостью компиляции, Sparkplug шаблонизирует bytecode за микросекунды, Maglev легко оптимизирует за миллисекунды, TurboFan оптимизирует полностью за десятки-сотни миллисекунд.",
    thesis: "Функция движется вправо, только когда её бюджеты говорят, что компиляция окупится.",
    caption: "Подъём бюджетирован, не бесплатен: счётчики вызовов и жар обратных рёбер платят за время компиляции каждого tier'а. Холодный код навсегда остаётся слева — в этом весь смысл tiering'а.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    curve: "СТОИМОСТЬ КОМПИЛЯЦИИ → СКОРОСТЬ",
    budgets: "ЧТО ЗАРАБАТЫВАЕТ ПОДЪЁМ",
    tiers: [
      { name: "Ignition", compile: "0 cost", run: "interpret", note: "нулевая стоимость компиляции — здесь начинает каждая функция" },
      { name: "Sparkplug", compile: "µs", run: "baseline", note: "шаблонизирует bytecode в machine code за микросекунды" },
      { name: "Maglev", compile: "ms", run: "mid-tier", note: "лёгкая оптимизация за миллисекунды — быстро прогревается" },
      { name: "TurboFan", compile: "10–100 ms", run: "optimised", note: "полная оптимизация: inlining, escape analysis, scheduling" },
    ],
    invocations: "счётчик вызовов + жар обратных рёбер",
    cold: "ХОЛОДНЫЙ ОСТАЁТСЯ СЛЕВА",
    coldBody: "Холодный код никогда не платит за компиляцию, которая не окупится. Tiering — это ставка, которую движок делает, только когда odds говорят о выигрыше.",
  },
} as const;

const t = copy[lang];
const tiers = t.tiers;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="tcf" data-tcf>
    <div class="tcf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="tcf-head">
      <TechnicalLabel tone="muted" size="xs">{t.curve}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.budgets}</TechnicalLabel>
    </div>

    <ol class="tcf-tiers">
      {tiers.map((r, i) => (
        <li class="tcf-tier" data-tcf-tier={i}>
          <div class="tcf-tier-main">
            <MachineValue value={r.name} tone={i === 3 ? "accent" : undefined} />
            <MachineValue value={r.compile} />
            <MachineValue value={r.run} tone={i === 0 ? "muted" : undefined} />
          </div>
          <p class="tcf-tier-note">{r.note}</p>
        </li>
      ))}
    </ol>

    <p class="tcf-budgets">
      <TechnicalLabel tone="muted" size="xs">BUDGETS</TechnicalLabel>
      {t.invocations}
    </p>
    <p class="tcf-cold">
      <TechnicalLabel tone="muted" size="xs">{t.cold}</TechnicalLabel>
      {t.coldBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the tiers left to right.
  // All tiers are server-rendered — no-JS readers see the whole curve.
  (() => {
    const roots = document.querySelectorAll("[data-tcf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const tiers = root.querySelectorAll("[data-tcf-tier]");
      if (!tiers.length) continue;
      if (reduceMotion) {
        tiers.forEach((el) => el.classList.add("tcf-tier-live"));
        continue;
      }
      let n = 0;
      const show = (k) => {
        tiers.forEach((el, j) => {
          el.classList.toggle("tcf-tier-live", j === k);
          el.classList.toggle("tcf-tier-done", j < k);
        });
      };
      show(0);
      setInterval(() => {
        n = (n + 1) % (tiers.length + 1);
        show(n);
      }, 2400);
    }
  })();
</script>

<style>
  .tcf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .tcf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .tcf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tcf-tiers {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tcf-tier {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 10px 12px;
    border-left: 2px solid var(--hairline-2);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .tcf-tier + .tcf-tier { border-top: 0.5px solid var(--hairline-2); }

  .tcf-tier-main {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .tcf-tier-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    text-align: right;
    overflow-wrap: anywhere;
  }

  .tcf-tier-live { border-left-color: var(--accent); background: var(--accent-wash, var(--card)); }
  .tcf-tier-done { border-left-color: var(--hairline-strong); }

  .tcf-budgets,
  .tcf-cold {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .tcf-tier-note { text-align: left; }
    .tcf-tier { padding: 10px 8px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tcf-tier {
      animation: tcf-tier-in var(--dur-2) var(--ease) both;
    }
    .tcf-tier:nth-child(2) { animation-delay: 120ms; }
    .tcf-tier:nth-child(3) { animation-delay: 240ms; }
    .tcf-tier:nth-child(4) { animation-delay: 360ms; }
    @keyframes tcf-tier-in {
      from { opacity: 0; transform: translateX(-6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
