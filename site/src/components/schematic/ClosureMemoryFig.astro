---
/**
 * ClosureMemoryFig — Tier-B learning figure.
 *
 * The shared-context trap: the compiler makes one Context
 * per scope, not one per closure. Two sibling closures
 * point at the same Context, so keeping the small one
 * alive keeps the big array alive through the shared
 * scope — reachability runs root → closure → Context →
 * the array the small closure never reads.
 *
 * Server-rendered; the is:inline script walks the
 * retainer path. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "SHARED CONTEXT",
    title: "Siblings share one Context — keep one, pin all",
    label: "Both closures point at the same scope Context, so returning small keeps big alive: reachability runs root to closure to Context to the array it never reads.",
    thesis: "A closure pins its whole scope — audit what else shares that Context.",
    caption: "The compiler allocates one Context per scope, not one per function. When small and big share a scope, the cheapest sibling inherits the dearest sibling's baggage: a function returning 42 pins a 40 MB array.",
    scope: "V8-SPECIFIC MODEL",
    path: "THE RETAINER PATH",
    rule: "ONE CONTEXT PER SCOPE",
    pathNodes: [
      { name: "root", note: "keep holds small — the entry point of the path" },
      { name: "small()", note: "returns 42 — never reads big" },
      { name: "shared Context", note: "scope slots: both siblings' free variables" },
      { name: "big array", note: "~40 MB — pinned through the shared slot" },
    ],
    flow: [
      { state: "keep alive", log: "root → small" },
      { state: "Context reached", log: "small → Context" },
      { state: "big reached", log: "Context → big array" },
      { state: "pinned", log: "42 pins 40 MB" },
    ],
    perScope: "PER SCOPE — NOT PER CLOSURE",
    perScopeBody: "The compiler makes one Context per scope, not one per function. Siblings share it, so the cheapest sibling inherits the dearest sibling's baggage.",
    sever: "SEVER THE PATH — THREE FIXES",
    severBody: "Null the big reference, split scopes so small is born elsewhere, or avoid capturing big in the first place. DevTools retainers show obj to Context to fn.",
  },
  ru: {
    category: "ОБЩИЙ CONTEXT",
    title: "Сиблинги делят один Context — держи одного, прикрепи всех",
    label: "Оба замыкания указывают на один и тот же Context области, поэтому возврат small держит big живым: достижимость идёт root → closure → Context → массив, который она никогда не читает.",
    thesis: "Замыкание прикрепляет всю свою область — проверяй, кто ещё делит этот Context.",
    caption: "Компилятор выделяет один Context на область, а не на функцию. Когда small и big делят область, дешёвый сиблинг наследует багаж дорогого: функция, возвращающая 42, прикрепляет массив в 40 MB.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    path: "ПУТЬ УДЕРЖАНИЯ",
    rule: "ОДИН CONTEXT НА ОБЛАСТЬ",
    pathNodes: [
      { name: "root", note: "keep держит small — точка входа пути" },
      { name: "small()", note: "возвращает 42 — big никогда не читает" },
      { name: "общий Context", note: "слоты области: свободные переменные обоих сиблингов" },
      { name: "big array", note: "~40 MB — прикреплён через общий слот" },
    ],
    flow: [
      { state: "живой", log: "root → small" },
      { state: "Context достигнут", log: "small → Context" },
      { state: "big достигнут", log: "Context → big array" },
      { state: "прикреплён", log: "42 держит 40 MB" },
    ],
    perScope: "НА ОБЛАСТЬ — НЕ НА ЗАМЫКАНИЕ",
    perScopeBody: "Компилятор делает один Context на область, а не на функцию. Сиблинги делят его, поэтому дешёвый сиблинг наследует багаж дорогого.",
    sever: "РАЗОРВИ ПУТЬ — ТРИ СПОСОБА",
    severBody: "Обнулите ссылку на big, разделите области, чтобы small родился elsewhere, или не захватывайте big вовсе. DevTools retainers покажет obj → Context → fn.",
  },
} as const;

const t = copy[lang];
const pathNodes = t.pathNodes;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="cmf" data-cmf>
    <div class="cmf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="cmf-head">
      <TechnicalLabel tone="muted" size="xs">{t.path}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="cmf-path">
      {pathNodes.map((n, i) => (
        <li class="cmf-node" data-cmf-node={i}>
          <div class="cmf-node-main">
            <MachineValue value={n.name} tone={i === 1 ? "accent" : i === 3 ? "danger" : undefined} />
            {i < pathNodes.length - 1 && (
              <span class="cmf-arrow" aria-hidden="true">→</span>
            )}
          </div>
          <p class="cmf-node-note">{n.note}</p>
        </li>
      ))}
    </ol>

    <ol class="cmf-flow">
      {flow.map((s, i) => (
        <li class="cmf-step" data-cmf-step={i} hidden={i !== 0}>
          <span class="cmf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "danger" : undefined} />
        </li>
      ))}
    </ol>

    <p class="cmf-perscope">
      <TechnicalLabel tone="muted" size="xs">{t.perScope}</TechnicalLabel>
      {t.perScopeBody}
    </p>
    <p class="cmf-sever">
      <TechnicalLabel tone="ok" size="xs">{t.sever}</TechnicalLabel>
      {t.severBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the retainer path.
  // Step 0 is server-rendered; the script replays the pinning story.
  (() => {
    const roots = document.querySelectorAll("[data-cmf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-cmf-step]");
      const nodes = root.querySelectorAll("[data-cmf-node]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        nodes.forEach((el, j) => {
          el.classList.toggle("cmf-node-live", j === Math.min(n, nodes.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .cmf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .cmf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .cmf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cmf-path {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cmf-node {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .cmf-node-main {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cmf-arrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--hairline-strong);
  }

  .cmf-node-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .cmf-node-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .cmf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cmf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .cmf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .cmf-perscope,
  .cmf-sever {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .cmf-path { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .cmf-path { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cmf-node {
      animation: cmf-node-in var(--dur-2) var(--ease) both;
    }
    .cmf-node:nth-child(2) { animation-delay: 100ms; }
    .cmf-node:nth-child(3) { animation-delay: 200ms; }
    .cmf-node:nth-child(4) { animation-delay: 300ms; }
    @keyframes cmf-node-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
