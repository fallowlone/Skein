---
/**
 * ICLadderFig — Tier-B learning figure.
 *
 * The one-way IC ladder at a single access site: uninitialized
 * → premonomorphic → monomorphic (the target, ~1 cycle) →
 * polymorphic (2–4 maps, short scan) → megamorphic (5+, the
 * site gives up and probes the shared stub cache). The causal
 * hinge: the ladder never climbs back — a megamorphic site
 * stays megamorphic for the FeedbackVector's life.
 *
 * Complements ICStateStepper (which walks the three states
 * interactively) with the full five-stage history, including
 * the two cold states the stepper skips.
 *
 * Server-rendered; the is:inline script walks the ladder. Zero
 * hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "IC LADDER",
    title: "One shape flies, two to four scan, five plus probes the world",
    label: "The five IC states at one access site, in observation order: uninitialized, premonomorphic, monomorphic, polymorphic, megamorphic. One-way — never climbs back.",
    thesis: "Monomorphic is the target state — keep hot sites on one shape.",
    caption: "One map means compare-and-load (~1 cycle). Two to four maps mean a short guarded scan. Five or more and V8 stops tracking this site: the slot points at the shared stub cache and every access pays a hash probe.",
    scope: "V8-SPECIFIC MODEL",
    ladder: "THE ONE-WAY LADDER",
    maps: "MAPS SEEN AT THIS SITE",
    rungs: [
      { name: "uninitialized", maps: "0 maps", note: "the slot never ran — no handler emitted" },
      { name: "premonomorphic", maps: "1 sighting", note: "map recorded, no handler — waiting to confirm it is stable" },
      { name: "monomorphic", maps: "1 map · ~1 cycle", note: "compare-and-load: the fast case, the target state" },
      { name: "polymorphic", maps: "2–4 maps", note: "short guarded scan — handlers checked in observation order" },
      { name: "megamorphic", maps: "5+ → stub cache", note: "site gives up on shape guards; probes the shared global stub cache" },
    ],
    premono: "PREMONO — SKIP ONE-SHOTS",
    premonoBody: "The first hit only records the map without emitting a handler. A path that runs once never pays for an IC it will not reuse.",
    oneway: "ONE-WAY",
    onewayBody: "A megamorphic site stays megamorphic for the FeedbackVector's life. Fix the shapes upstream or get fresh feedback.",
  },
  ru: {
    category: "ЛЕСТНИЦА IC",
    title: "Одна форма летит, две-четыре сканируют, пять и более зондируют весь мир",
    label: "Пять состояний IC на одном сайте доступа, в порядке наблюдений: uninitialized, premonomorphic, monomorphic, polymorphic, megamorphic. Односторонняя — никогда не поднимается обратно.",
    thesis: "Monomorphic — целевое состояние: держите горячие сайты на одной форме.",
    caption: "Один Map — это compare-and-load (~1 cycle). Два-четыре Map — короткий guarded scan. Пять и более — V8 перестаёт отслеживать этот сайт: слот указывает на общий stub cache, и каждый доступ платит hash probe.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    ladder: "ОДНОСТОРОННЯЯ ЛЕСТНИЦА",
    maps: "MAP НАБЛЮДАЛСЯ НА ЭТОМ САЙТЕ",
    rungs: [
      { name: "uninitialized", maps: "0 map", note: "слот не запускался — handler не излучён" },
      { name: "premonomorphic", maps: "1 наблюдение", note: "map записан, handler нет — ждёт подтверждения стабильности" },
      { name: "monomorphic", maps: "1 map · ~1 cycle", note: "compare-and-load: быстрый случай, целевое состояние" },
      { name: "polymorphic", maps: "2–4 map", note: "короткий guarded scan — handlers проверяются в порядке наблюдений" },
      { name: "megamorphic", maps: "5+ → stub cache", note: "сайт сдаётся: зондирует общий глобальный stub cache" },
    ],
    premono: "PREMONO — ПРОПУСКАЙТЕ ОДНОРАЗОВЫЕ",
    premonoBody: "Первое попадание только записывает map без излучения handler. Путь, который выполняется один раз, не заплатит за IC, который не будет переиспользован.",
    oneway: "ОДНОСТОРОННЯЯ",
    onewayBody: "Мегаморфный сайт остаётся мегаморфным до конца жизни FeedbackVector. Чините формы выше по потоку или получайте свежую обратную связь.",
  },
} as const;

const t = copy[lang];
const rungs = t.rungs;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="icl" data-icl>
    <div class="icl-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="icl-head">
      <TechnicalLabel tone="muted" size="xs">{t.ladder}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.maps}</TechnicalLabel>
    </div>

    <ol class="icl-ladder">
      {rungs.map((r, i) => (
        <li class="icl-rung" data-icl-rung={i}>
          <div class="icl-rung-main">
            <MachineValue value={r.name} tone={i === 2 ? "ok" : i >= 4 ? "danger" : undefined} />
            <MachineValue value={r.maps} tone={i === 2 ? "ok" : i >= 4 ? "danger" : undefined} />
          </div>
          <p class="icl-rung-note">{r.note}</p>
        </li>
      ))}
    </ol>

    <p class="icl-premono">
      <TechnicalLabel tone="muted" size="xs">{t.premono}</TechnicalLabel>
      {t.premonoBody}
    </p>
    <p class="icl-oneway">
      <TechnicalLabel tone="danger" size="xs">{t.oneway}</TechnicalLabel>
      {t.onewayBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: climb the one-way ladder.
  // All rungs are server-rendered — no-JS readers see them all.
  (() => {
    const roots = document.querySelectorAll("[data-icl]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const rungs = root.querySelectorAll("[data-icl-rung]");
      if (!rungs.length) continue;
      if (reduceMotion) {
        rungs.forEach((el) => el.classList.add("icl-rung-live"));
        continue;
      }
      let n = 0;
      const show = (k) => {
        rungs.forEach((el, j) => {
          el.classList.toggle("icl-rung-live", j === k);
          el.classList.toggle("icl-rung-done", j < k);
        });
      };
      show(0);
      setInterval(() => {
        n = (n + 1) % (rungs.length + 1);
        show(n);
      }, 2200);
    }
  })();
</script>

<style>
  .icl {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .icl-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .icl-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .icl-ladder {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .icl-rung {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 10px 12px;
    border-left: 2px solid var(--hairline-2);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .icl-rung + .icl-rung { border-top: 0.5px solid var(--hairline-2); }

  .icl-rung-main {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .icl-rung-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    text-align: right;
    overflow-wrap: anywhere;
  }

  .icl-rung-live { border-left-color: var(--accent); background: var(--accent-wash, var(--card)); }
  .icl-rung-done { border-left-color: var(--hairline-strong); }

  .icl-premono,
  .icl-oneway {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .icl-rung-note { text-align: left; }
    .icl-rung { padding: 10px 8px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .icl-rung {
      animation: icl-rung-in var(--dur-2) var(--ease) both;
    }
    .icl-rung:nth-child(2) { animation-delay: 100ms; }
    .icl-rung:nth-child(3) { animation-delay: 200ms; }
    .icl-rung:nth-child(4) { animation-delay: 300ms; }
    .icl-rung:nth-child(5) { animation-delay: 400ms; }
    @keyframes icl-rung-in {
      from { opacity: 0; transform: translateX(-6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
