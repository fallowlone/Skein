---
/**
 * WriteBarrierFig — Tier-B learning figure.
 *
 * The write barrier: one store, two duties. When the
 * mutator stores a pointer into a heap slot, the
 * barrier checks (a) marking state — a white target
 * must be greys so the tri-color invariant holds —
 * and (b) the old-to-young direction — the slot is
 * recorded in the remembered set so the scavenger
 * can scan it. Smi and immediates skip this.
 *
 * Server-rendered; the is:inline script replays the
 * store. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "WRITE BARRIER",
    title: "One store, two duties",
    label: "When the mutator stores a pointer into a heap slot, the barrier greys a white target — keeping the tri-color invariant — and records an old-to-young slot in the remembered set.",
    thesis: "Keep the tri-color invariant and skip old-space scans — one small barrier does both.",
    caption: "Every pointer store passes through the barrier before it lands. The check is cheap — a couple of compares — and it is what lets the young generation collect without scanning the entire old generation.",
    scope: "V8-SPECIFIC MODEL",
    duties: "ONE STORE · TWO DUTIES",
    set: "THE REMEMBERED SET",
    stages: [
      { name: "mutator", note: "obj.field = target — a pointer lands in a heap slot" },
      { name: "barrier", note: "checks marking state and the old → young direction" },
      { name: "grey target", note: "a white target is pushed to the marking worklist" },
      { name: "remember slot", note: "an old → young slot lands in the remembered set" },
    ],
    flow: [
      { state: "store issued", log: "obj.field = target" },
      { state: "barrier runs", log: "marking? · old→young?" },
      { state: "target greyed", log: "grey target → worklist" },
      { state: "slot remembered", log: "Scavenge reads it" },
    ],
    duty: "WHY BOTH",
    dutyBody: "Greys preserve the mark invariant (no black-to-white edge); the remembered set preserves the generation invariant (a young object is reachable from old space without scanning old space).",
    skip: "SMI AND IMMEDIATES SKIP THIS",
    skipBody: "Stores of Smis and other non-pointer immediates cannot create a heap edge, so the barrier is not invoked — the common case stays cheap.",
  },
  ru: {
    category: "БАРИЕР ЗАПИСИ",
    title: "Одна запись, две обязанности",
    label: "Когда мутатор записывает указатель в слот кучи, барьер серует белую цель — сохраняя трёхцветный инвариант — и записывает old-to-young слот в remembered set.",
    thesis: "Сохраняйте трёхцветный инвариант и пропускайте сканирование old space — один маленький барьер делает оба.",
    caption: "Каждая запись указателя проходит через барьер перед тем, как приземлиться. Проверка дешёвая — пара сравнений — и именно она позволяет молодому поколению собираться без сканирования всей старой кучи.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    duties: "ОДНА ЗАПИСЬ · ДВЕ ОБЯЗАННОСТИ",
    set: "REMEMBERED SET",
    stages: [
      { name: "мутатор", note: "obj.field = target — указатель приземляется в слоте кучи" },
      { name: "барьер", note: "проверяет состояние маркировки и направление old → young" },
      { name: "серая цель", note: "белая цель добавляется в рабочий список маркировки" },
      { name: "запомнить слот", note: "old → young слот попадает в remembered set" },
    ],
    flow: [
      { state: "запись выдана", log: "obj.field = target" },
      { state: "барьер работает", log: "маркировка? · old→young?" },
      { state: "цель сера", log: "серая цель → worklist" },
      { state: "слот запомнен", log: "Scavenge его читает" },
    ],
    duty: "ПОЧЕМУ ОБА",
    dutyBody: "Серые сохраняют инвариант маркировки (нет ребра black-to-white); remembered set сохраняет инвариант поколений (молодой объект достижим из old space без сканирования old space).",
    skip: "SMI И НЕПОСРЕДСТВЕННЫЕ ПРОПУСКАЮТ",
    skipBody: "Записи Smi и других непосредственных не-указателей не могут создать ребро кучи, поэтому барьер не вызывается — типичный случай остаётся дешёвым.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="wbf" data-wbf>
    <div class="wbf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="wbf-head">
      <TechnicalLabel tone="muted" size="xs">{t.duties}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.set}</TechnicalLabel>
    </div>

    <ol class="wbf-stages">
      {stages.map((s, i) => (
        <li class="wbf-stage" data-wbf-stage={i}>
          <div class="wbf-stage-main">
            <MachineValue value={s.name} tone={i === 1 ? "accent" : undefined} />
          </div>
          <p class="wbf-stage-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="wbf-flow">
      {flow.map((s, i) => (
        <li class="wbf-step" data-wbf-step={i} hidden={i !== 0}>
          <span class="wbf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="wbf-duty">
      <TechnicalLabel tone="accent" size="xs">{t.duty}</TechnicalLabel>
      {t.dutyBody}
    </p>
    <p class="wbf-skip">
      <TechnicalLabel tone="muted" size="xs">{t.skip}</TechnicalLabel>
      {t.skipBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: replay the store.
  // Step 0 is server-rendered; the script replays the barrier duties.
  (() => {
    const roots = document.querySelectorAll("[data-wbf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-wbf-step]");
      const stages = root.querySelectorAll("[data-wbf-stage]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        stages.forEach((el, j) => {
          el.classList.toggle("wbf-stage-live", j === Math.min(n, stages.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .wbf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .wbf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .wbf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .wbf-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wbf-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .wbf-stage-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .wbf-stage-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .wbf-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .wbf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wbf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .wbf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .wbf-duty,
  .wbf-skip {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .wbf-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .wbf-stages { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .wbf-stage {
      animation: wbf-stage-in var(--dur-2) var(--ease) both;
    }
    .wbf-stage:nth-child(2) { animation-delay: 100ms; }
    .wbf-stage:nth-child(3) { animation-delay: 200ms; }
    .wbf-stage:nth-child(4) { animation-delay: 300ms; }
    @keyframes wbf-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
