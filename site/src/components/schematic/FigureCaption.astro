---
/**
 * FigureCaption — Editorial caption accompanying schematic figures.
 *
 * Typography:
 *   - Figure number in mono small caps
 *   - Conceptual takeaway in editorial serif/italic
 *   - Optional technical notes in mono/sans
 */
interface Props {
  num?: string | number;
  class?: string;
}

const { num, class: className = "" } = Astro.props;
const numStr = num !== undefined ? String(num).padStart(2, "0") : undefined;
---

<figcaption class:list={["sk-fig-caption", className]}>
  {numStr && <span class="sk-fc-num">FIG. {numStr}</span>}
  <div class="sk-fc-body">
    <slot />
  </div>
</figcaption>

<style>
  .sk-fig-caption {
    margin-top: 18px;
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .sk-fc-num {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--d, var(--accent));
    padding-top: 1px;
  }

  .sk-fc-body {
    flex: 1;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .sk-fc-body :global(strong),
  .sk-fc-body :global(b) {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 600;
    color: var(--ink);
  }

  .sk-fc-body :global(code) {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 12px;
    background: var(--card);
    border: 0.5px solid var(--hairline-2);
    padding: 1px 4px;
    border-radius: var(--r-sm);
  }

  @media (max-width: 640px) {
    .sk-fig-caption {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
