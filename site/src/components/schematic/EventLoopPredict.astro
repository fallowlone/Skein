    thesis: "The checkpoint — not the Promise — decides the order.",
    caption: "The synchronous script is one task: it prints the first and last lines and queues the Promise reaction. The host's microtask checkpoint then runs that reaction before any timer task is selected — so the console reads start, end, promise, timeout.",
    scope: "HTML EVENT-LOOP MODEL",
    program: "PROGRAM",
    stack: "CALL STACK",
    micro: "MICROTASK QUEUE",
    task: "TASK QUEUE",
    console: "CONSOLE OUTPUT",
    predict: "PREDICT",
    run: "RUN",
    reset: "RESET",
    hint: "predict the order, then run",
    live: "console",
    empty: "empty",
    steps: [
      {
        label: "Task selected: the whole script",
        body: "The host selects the script task and calls into V8. The call stack holds the script frame; both queues are empty. Nothing has printed yet.",
        stack: ["script frame"],
        micro: [],
        task: [],
        out: [],
        outNote: "—",
      },
      {
        label: 'console.log("start") runs',
        body: "The first statement executes and prints immediately: output is synchronous. start lands on the console; the frame pops and the script continues.",
