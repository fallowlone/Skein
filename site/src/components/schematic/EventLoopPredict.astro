---
/**
 * EventLoopPredict — Tier-A canvas figure (interactive).
 *
 * Asks the reader to predict the console output of the canonical
 * four-line program (log a first line, arm a zero-millisecond
 * timer, queue a Promise reaction, log a last line) before
 * running it — then replays the host's processing model turn by
 * turn so the prediction can be checked against the mechanism.
 *
 * The three lanes (CALL STACK / MICROTASK QUEUE / TASK QUEUE)
 * fill and drain as the steps advance. The stack lane shows the
 * frame currently executing, so the pivotal step is visible:
 * the microtask checkpoint runs while the stack is EMPTY, which
 * is why the Promise reaction prints before the timer task is
 * ever selected. The ordering is the host's, not the Promise's.
 *
 * All steps are server-rendered in the DOM, so the full
 * mechanism is readable with JS off; PREDICT/RUN replays the
 * causality rather than being the only path to it. Zero
 * hydration islands: the control script is `is:inline`
 * progressive enhancement.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "EVENT LOOP · PREDICT THE OUTPUT",
    title: "Predict the console, then watch the host drain it",
