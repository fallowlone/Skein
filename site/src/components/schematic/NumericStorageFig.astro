---
import SkeinFigure from "./SkeinFigure.astro";

interface Props { lang?: "en" | "ru" }
const { lang = "en" } = Astro.props;
const t = {
  en: {
    category: "V8 · NUMBER STORAGE",
    title: "The storage location decides whether a double needs a box",
    label: "Three V8 storage paths. A common compressed tagged slot holds a 31-bit signed Smi and a zero tag bit. A non-Smi number in a tagged slot is represented through a tagged pointer to a HeapNumber object with a Map field and a 64-bit double value. In a packed double array or Float64Array, elements occupy raw 64-bit double slots without a separate HeapNumber for each stored element.",
    thesis: "A fraction needs double bits; it does not always need a separate heap box.",
    caption: "Conceptual V8 layouts, not to scale. The 32-bit tagged slot assumes pointer compression; optimized registers and other configurations can differ.",
    tagged: "TAGGED SLOT · 32 BITS",
    smi: "INLINE SMI",
    smiNote: "31-bit signed payload · low tag = 0",
    ref: "HEAP REFERENCE",
    refNote: "tagged offset · low tag = 1",
    heap: "HEAPNUMBER · EXPLODED VIEW",
    map: "MAP FIELD",
    mapNote: "identifies the object layout",
    value: "DOUBLE PAYLOAD",
    valueNote: "64-bit IEEE-754 · 3.14",
    direct: "DIRECT DOUBLE STORAGE",
    array: "PACKED_DOUBLE_ELEMENTS / Float64Array",
    arrayNote: "each occupied numeric slot stores raw double bits",
    zero: "Smi itself needs no heap object",
  },
  ru: {
    category: "V8 · ХРАНЕНИЕ ЧИСЕЛ",
    title: "Место хранения определяет, нужна ли для double обёртка",
    label: "Три пути хранения чисел в V8. Типичный сжатый тегированный слот содержит 31-битное знаковое Smi с младшим тег-битом 0. Не-Smi число в таком слоте представляется тегированным указателем на HeapNumber с полем Map и 64-битным значением double. В числовом массиве PACKED_DOUBLE_ELEMENTS или Float64Array элементы занимают слоты с сырыми 64-битными double без отдельного HeapNumber на каждый хранимый элемент.",
    thesis: "Дроби нужны биты double, но отдельная обёртка в куче нужна не всегда.",
    caption: "Упрощённые раскладки V8, не в масштабе. Слот 32 бита предполагает сжатые указатели; регистры и другие конфигурации могут отличаться.",
    tagged: "ТЕГИРОВАННЫЙ СЛОТ · 32 БИТА",
    smi: "SMI ВНУТРИ СЛОТА",
    smiNote: "31-битное целое · младший тег = 0",
    ref: "ССЫЛКА В КУЧУ",
    refNote: "тегированное смещение · младший тег = 1",
    heap: "HEAPNUMBER · СЛОИ",
    map: "ПОЛЕ MAP",
    mapNote: "определяет раскладку объекта",
    value: "ЗНАЧЕНИЕ DOUBLE",
    valueNote: "64 бита IEEE-754 · 3.14",
    direct: "ПРЯМОЕ ХРАНЕНИЕ DOUBLE",
    array: "PACKED_DOUBLE_ELEMENTS / Float64Array",
    arrayNote: "каждый занятый числовой слот содержит биты double",
    zero: "Самому Smi не нужен объект в куче",
  },
}[lang];
---

<SkeinFigure num="01" category={t.category} title={t.title} label={t.label} thesis={t.thesis} caption={t.caption} span="learning" variant="clean" hue="var(--ink-2)">
  <div class="drawing">
    <div class="topline" aria-hidden="true">01 / {t.tagged}</div>
    <div class="paths">
      <div class="smi-path">
        <div class="word"><span>42</span><b>0</b></div>
        <div class="leader" aria-hidden="true"></div>
        <strong>{t.smi}</strong>
        <small>{t.smiNote}</small>
        <p>{t.zero}</p>
      </div>
      <div class="heap-path">
        <div class="word"><span>offset</span><b>1</b></div>
        <div class="leader" aria-hidden="true"></div>
        <strong>{t.ref}</strong>
        <small>{t.refNote}</small>
        <div class="stack-label">02 / {t.heap}</div>
        <div class="exploded" aria-hidden="true">
          <div class="plate map-plate"><span>Map</span></div>
          <div class="guides"></div>
          <div class="plate value-plate"><span>3.14</span></div>
        </div>
        <div class="parts"><span><b>{t.map}</b><small>{t.mapNote}</small></span><span><b>{t.value}</b><small>{t.valueNote}</small></span></div>
      </div>
    </div>
    <div class="direct">
      <div><strong>03 / {t.direct}</strong><span>{t.array}</span></div>
      <div class="raw" aria-hidden="true"><span>1.0</span><span>3.14</span><span>2.5</span></div>
      <p>{t.arrayNote}</p>
    </div>
  </div>
</SkeinFigure>

<style>
  .drawing { --fig-accent: #a74a31; padding: 24px; background-color: var(--paper); background-image: linear-gradient(color-mix(in srgb, var(--ink) 3%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 3%, transparent) 1px, transparent 1px); background-size: 12px 12px; color: var(--ink); }
  .topline, .stack-label, .direct strong { font: 600 10px/1.5 var(--font-mono); letter-spacing: .1em; color: var(--muted); }
  .paths { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 34px; padding-top: 28px; }
  .smi-path, .heap-path { min-width: 0; }
  .word { display: flex; width: min(100%, 240px); height: 52px; border: 1px solid var(--ink-2); background: var(--paper); box-sizing: border-box; font: 15px var(--font-mono); }
  .word span { flex: 1; display: grid; place-items: center; }
  .word b { width: 38px; display: grid; place-items: center; border-left: 1px solid var(--ink-2); color: var(--fig-accent); }
  .leader { width: 1px; height: 26px; margin-left: 50px; border-left: 1px solid var(--ink-2); }
  .smi-path > strong, .heap-path > strong { display: block; font: 600 11px/1.5 var(--font-mono); letter-spacing: .06em; }
  .smi-path > small, .heap-path > small, .parts small { display: block; font: 11px/1.5 var(--font-body); color: var(--muted); }
  .smi-path p { max-width: 240px; margin-top: 40px; border-top: 1px solid var(--hairline-strong); padding-top: 12px; font: 13px/1.5 var(--font-body); }
  .stack-label { margin-top: 34px; }
  .exploded { position: relative; width: min(100%, 280px); height: 205px; margin: 55px 0 0 10px; }
  .plate { position: absolute; width: 180px; height: 65px; display: grid; place-items: center; border: 1px solid var(--ink-2); background: var(--paper); transform: skewY(-18deg); box-shadow: 8px 8px 0 color-mix(in srgb, var(--ink) 7%, var(--paper)); font: 14px var(--font-mono); }
  .plate span { transform: skewY(18deg); }
  .map-plate { left: 15px; top: 8px; }
  .value-plate { left: 51px; top: 78px; border-color: var(--fig-accent); }
  .value-plate span { color: var(--fig-accent); }
  .guides { position: absolute; left: 52px; top: 60px; width: 140px; height: 52px; border-left: 1px dashed var(--ink-2); border-right: 1px dashed var(--ink-2); transform: skewY(-18deg); }
  .parts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding-top: 8px; }
  .parts b { font: 600 10px/1.4 var(--font-mono); }
  .direct { display: grid; grid-template-columns: 1fr 1.1fr; gap: 12px 24px; align-items: center; margin-top: 30px; padding-top: 18px; border-top: 1px solid var(--hairline-strong); }
  .direct strong, .direct span { display: block; }
  .direct span { margin-top: 5px; font: 11px/1.5 var(--font-mono); overflow-wrap: anywhere; }
  .raw { display: flex; border: 1px solid var(--ink-2); background: var(--paper); }
  .raw span { flex: 1; min-width: 0; margin: 0; padding: 12px 2px; text-align: center; font: 12px var(--font-mono); }
  .raw span + span { border-left: 1px solid var(--hairline-strong); }
  .direct p { grid-column: 2; margin: 0; font: 12px/1.5 var(--font-body); color: var(--muted); }
  :global([data-theme='dark']) .drawing { --fig-accent: #e07855; }
  @media (max-width: 600px) {
    .drawing { padding: 18px 12px; }
    .paths { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: 20px; }
    .smi-path { padding-bottom: 22px; border-bottom: 1px solid var(--hairline-strong); }
    .smi-path p { margin-top: 18px; }
    .stack-label { margin-top: 24px; }
    .direct { grid-template-columns: minmax(0, 1fr); gap: 10px; margin-top: 24px; }
    .direct p { grid-column: auto; }
    .parts { max-width: 330px; }
  }
</style>
