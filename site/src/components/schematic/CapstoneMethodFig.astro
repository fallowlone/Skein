---
/**
 * CapstoneMethodFig — Tier-B learning figure.
 *
 * The capstone method: profile first to name the
 * dominant cost, identify the engine mechanism behind
 * it (shape divergence, Smi overflow, GC churn,
 * scheduling pressure), apply one targeted change,
 * then re-measure against the same guarded benchmark
 * before climbing to the next layer.
 *
 * Server-rendered; the is:inline script replays the
 * method loop. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "CAPSTONE METHOD",
    title: "Profile first — then name the mechanism",
    label: "Find the dominant cost, name the engine mechanism behind it, change exactly one thing, then re-measure against the same guarded benchmark before moving to the next layer.",
    thesis: "Profile first, name the engine mechanism, change one variable, gate the win.",
    caption: "The capstone handler combines four distinct costs: shape divergence, a Smi deopt, GC churn, and scheduling pressure. Fix the dominant one first, verify, then repeat.",
    scope: "METHODOLOGY",
    loop: "THE DISCIPLINED LOOP",
    rule: "ONE MECHANISM AT A TIME",
    stages: [
      { name: "measure", note: "profile until one dominant cost is clearly visible" },
      { name: "name mechanism", note: "shape divergence · Smi deopt · GC churn · schedule" },
      { name: "target fix", note: "apply the smallest change addressing that mechanism" },
      { name: "verify & gate", note: "re-measure on guarded bench, then repeat for next layer" },
    ],
    flow: [
      { state: "profiling", log: "--prof · --trace-deopt" },
      { state: "mechanism named", log: "shape / Smi / GC / schedule" },
      { state: "one fix applied", log: "target dominant cost" },
      { state: "verified & gated", log: "guarded benchmark ✓" },
    ],
    order: "ORDER — DOMINANT FIRST",
    orderBody: "Fixing GC churn while a deopt loop still burns 90% of your time is wasted effort. Rank costs, then eliminate them in descending order.",
    gate: "GATE THE WIN",
    gateBody: "A benchmark without a CI gate decays within two refactors. Make every performance win verifiable and permanent.",
  },
  ru: {
    category: "МЕТОД CAPSTONE",
    title: "Сначала профилируйте — затем называйте механизм",
    label: "Найдите доминирующую стоимость, назовите механизм движка за ней, измените ровно одну вещь, затем перемерьте на том же бенчмарке перед переходом к следующему слою.",
    thesis: "Сначала профиль, назовите механизм, измените одну переменную, зафиксируйте выигрыш.",
    caption: "Capstone-обработчик объединяет четыре разные стоимости: расхождение форм, деоптимизацию Smi, нагрузку на GC и давление планировщика. Исправьте доминирующую первой.",
    scope: "МЕТОДОЛОГИЯ",
    loop: "ДИСЦИПЛИНИРОВАННЫЙ ЦИКЛ",
    rule: "ОДИН МЕХАНИЗМ ЗА РАЗ",
    stages: [
      { name: "измерение", note: "профилируйте, пока не станет видна доминирующая стоимость" },
      { name: "назвать механизм", note: "расхождение форм · деопт Smi · нагрузка GC · планировщик" },
      { name: "точечный фикс", note: "примените минимальное изменение против этого механизма" },
      { name: "проверить и закрепить", note: "перемерьте на бенчмарке с гейтом, затем к следующему" },
    ],
    flow: [
      { state: "профилирование", log: "--prof · --trace-deopt" },
      { state: "механизм назван", log: "форма / Smi / GC / очередь" },
      { state: "один фикс", log: "против главной стоимости" },
      { state: "проверено с гейтом", log: "бенчмарк зафиксирован ✓" },
    ],
    order: "ПОРЯДОК — ГЛАВНОЕ СНАЧАЛА",
    orderBody: "Оптимизировать GC, пока цикл деоптимизации сжигает 90% времени, бессмысленно. Ранжируйте стоимости и устраняйте сверху вниз.",
    gate: "ЗАКРЕПИТЕ ВЫИГРЫШ",
    gateBody: "Бенчмарк без гейта в CI деградирует за пару рефакторингов. Делайте каждый выигрыш проверяемым и постоянным.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="cmf" data-cmf>
    <div class="cmf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="cmf-head">
      <TechnicalLabel tone="muted" size="xs">{t.loop}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="cmf-stages">
      {stages.map((s, i) => (
        <li class="cmf-stage" data-cmf-stage={i}>
          <div class="cmf-stage-main">
            <MachineValue value={s.name} tone={i === 1 ? "accent" : i === 3 ? "ok" : undefined} />
          </div>
          <p class="cmf-stage-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="cmf-flow">
      {flow.map((s, i) => (
        <li class="cmf-step" data-cmf-step={i} hidden={i !== 0}>
          <span class="cmf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="cmf-order">
      <TechnicalLabel tone="warn" size="xs">{t.order}</TechnicalLabel>
      {t.orderBody}
    </p>
    <p class="cmf-gate">
      <TechnicalLabel tone="ok" size="xs">{t.gate}</TechnicalLabel>
      {t.gateBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the capstone loop.
  (() => {
    const roots = document.querySelectorAll("[data-cmf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-cmf-step]");
      const stages = root.querySelectorAll("[data-cmf-stage]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        stages.forEach((el, j) => {
          el.classList.toggle("cmf-stage-live", j === Math.min(n, stages.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .cmf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .cmf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .cmf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cmf-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cmf-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .cmf-stage-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cmf-stage-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .cmf-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .cmf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cmf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .cmf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .cmf-order,
  .cmf-gate {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .cmf-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .cmf-stages { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cmf-stage {
      animation: cmf-stage-in var(--dur-2) var(--ease) both;
    }
    .cmf-stage:nth-child(2) { animation-delay: 100ms; }
    .cmf-stage:nth-child(3) { animation-delay: 200ms; }
    .cmf-stage:nth-child(4) { animation-delay: 300ms; }
    @keyframes cmf-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
