---
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "MAP ANATOMY",
    title: "The object holds values; the Map holds the layout",
    label:
      "A JavaScript object body stores the map pointer plus anonymous value slots. Its shared Map stores the layout: instance size, a DescriptorArray resolving names to field indices and representations, elements kind, prototype, back-pointer, and transitions.",
    thesis: "Layout knowledge lives once, one indirection away — the object itself is almost empty.",
    caption:
      "Property x was resolved to field index 0 once, at the Map level. Every object sharing this Map reads p.x as: load map pointer, compare to the expected Map, load slot 0. No name compare, no hash lookup.",
    objLabel: "OBJECT BODY · PER INSTANCE",
    mapLabel: "MAP · ONE PER LAYOUT, SHARED",
    descLabel: "DESCRIPTORARRAY",
    header: "header",
    mapPtr: "map ptr",
    propsPtr: "properties ptr",
    elementsPtr: "elements ptr",
    slot: "slot",
    inObject: "in-object slots",
    instanceSize: "instance size",
    typeBits: "type + bit-fields",
    descCount: "own descriptors",
    descPtr: "DescriptorArray ptr",
    elementsKind: "elements kind",
    prototype: "prototype ptr",
    backPtr: "back-pointer",
    transitionsPtr: "transitions ptr",
    key: "key",
    field: "field#",
    rep: "rep",
    const: "const",
    attrs: "attrs",
    smi: "Smi",
    double: "Double",
    heapObject: "HeapObject",
    ptr: "ptr",
    arrow: "→",
    readPath: "read path",
    readSteps: "load map · compare · load slot 0",
    shared: "1 Map · N objects",
    inObjectNote: "in-object",
    scope: "V8-SPECIFIC MODEL",
  },
  ru: {
    category: "АНАТОМИЯ MAP",
    title: "Объект хранит значения; Map хранит раскладку",
    label:
      "Тело объекта JavaScript хранит указатель на map плюс анонимные слоты значений. Общая Map хранит раскладку: размер экземпляра, DescriptorArray, сопоставляющий имена с индексами полей и представлениями, elements kind, прототип, back-pointer и transitions.",
    thesis: "Знание о раскладке живёт один раз, на одном уровне косвенности — сам объект почти пуст.",
    caption:
      "Свойство x было сопоставлено с индексом поля 0 один раз, на уровне Map. Каждый объект с этой Map читает p.x так: загрузить указатель map, сравнить с ожидаемой Map, загрузить слот 0. Ни сравнения имён, ни хеш-поиска.",
    objLabel: "ТЕЛО ОБЪЕКТА · НА ЭКЗЕМПЛЯР",
    mapLabel: "MAP · ПО ОДНОЙ НА РАСКЛАДКУ, ОБЩАЯ",
    descLabel: "DESCRIPTORARRAY",
    header: "заголовок",
    mapPtr: "указ. map",
    propsPtr: "указ. properties",
    elementsPtr: "указ. elements",
    slot: "слот",
    inObject: "внутриобъектные слоты",
    instanceSize: "размер экземпляра",
    typeBits: "тип + битовые поля",
    descCount: "собственные дескрипторы",
    descPtr: "указ. DescriptorArray",
    elementsKind: "elements kind",
    prototype: "указ. прототипа",
    backPtr: "back-pointer",
    transitionsPtr: "transitions",
    key: "ключ",
    field: "поле#",
    rep: "предст.",
    const: "const",
    attrs: "атрибуты",
    smi: "Smi",
    double: "Double",
    heapObject: "HeapObject",
    ptr: "указ.",
    arrow: "→",
    readPath: "путь чтения",
    readSteps: "загрузить map · сравнить · загрузить слот 0",
    shared: "1 Map · N объектов",
    inObjectNote: "внутри объекта",
    scope: "V8-СПЕЦИФИЧНАЯ МОДЕЛЬ",
  },
} as const;

const t = copy[lang];
---

<SkeinFigure
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="canvas"
  variant="canvas"
>
  <div class="map-layout">
    <!-- Object body -->
    <section class="obj-panel" aria-label={t.objLabel}>
      <TechnicalLabel tone="muted" size="xs">{t.objLabel}</TechnicalLabel>
      <div class="obj-body">
        <div class="obj-word obj-map-ptr"><MachineValue name={t.mapPtr} value="→" variant="plain" size="sm" tone="accent" /></div>
        <div class="obj-word"><MachineValue name={t.propsPtr} value="…" variant="plain" size="sm" tone="dim" /></div>
        <div class="obj-word"><MachineValue name={t.elementsPtr} value="…" variant="plain" size="sm" tone="dim" /></div>
        <div class="obj-word obj-slot"><MachineValue name={`${t.slot} 0`} value="1" variant="plain" size="sm" /></div>
        <div class="obj-word obj-slot"><MachineValue name={`${t.slot} 1`} value="2.5" variant="plain" size="sm" /></div>
      </div>
      <TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.inObject}</TechnicalLabel>
      <div class="obj-arrow" aria-hidden="true">
        <span class="obj-arrow-line"></span>
        <MachineValue name={t.mapPtr} value="" variant="plain" size="sm" tone="accent" />
      </div>
    </section>

    <!-- Map -->
    <section class="map-panel" aria-label={t.mapLabel}>
      <div class="map-panel-head">
        <TechnicalLabel tone="accent" size="xs">{t.mapLabel}</TechnicalLabel>
        <TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel>
      </div>
      <div class="map-grid">
        <div class="map-field"><TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.instanceSize}</TechnicalLabel><MachineValue value="32 B" size="sm" /></div>
        <div class="map-field"><TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.typeBits}</TechnicalLabel><MachineValue value="JS_OBJECT" size="sm" /></div>
        <div class="map-field"><TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.descCount}</TechnicalLabel><MachineValue value="2" size="sm" /></div>
        <div class="map-field map-field-ptr"><TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.descPtr}</TechnicalLabel><MachineValue value={`${t.arrow}`} size="sm" tone="accent" /></div>
        <div class="map-field"><TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.elementsKind}</TechnicalLabel><MachineValue value="PACKED" size="sm" /></div>
        <div class="map-field"><TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.prototype}</TechnicalLabel><MachineValue value={t.ptr} size="sm" tone="dim" /></div>
        <div class="map-field"><TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.backPtr}</TechnicalLabel><MachineValue value={t.ptr} size="sm" tone="dim" /></div>
        <div class="map-field"><TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.transitionsPtr}</TechnicalLabel><MachineValue value={t.ptr} size="sm" tone="dim" /></div>
      </div>
    </section>

    <!-- DescriptorArray -->
    <section class="desc-panel" aria-label={t.descLabel}>
      <div class="desc-panel-head">
        <TechnicalLabel tone="muted" size="xs">{t.descLabel}</TechnicalLabel>
      </div>
      <div class="desc-table">
        <div class="desc-row desc-row-head" aria-hidden="true">
          <span>{t.key}</span><span>{t.field}</span><span>{t.rep}</span><span>{t.const}</span><span>{t.attrs}</span>
        </div>
        <div class="desc-row">
          <MachineValue value="x" size="sm" tone="accent" /><MachineValue value="0" size="sm" /><MachineValue value={t.smi} size="sm" /><MachineValue value="✓" size="sm" tone="ok" /><MachineValue value="W·E·C" size="sm" tone="dim" />
        </div>
        <div class="desc-row">
          <MachineValue value="y" size="sm" tone="accent" /><MachineValue value="1" size="sm" /><MachineValue value={t.double} size="sm" /><MachineValue value="✓" size="sm" tone="ok" /><MachineValue value="W·E·C" size="sm" tone="dim" />
        </div>
      </div>
      <TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.inObjectNote}</TechnicalLabel>
    </section>
  </div>

  <div class="map-readpath">
    <TechnicalLabel tone="muted" size="xs">{t.readPath}</TechnicalLabel>
    <MachineValue value={t.readSteps} variant="pill" size="sm" tone="accent" />
    <MachineValue value={t.shared} variant="pill" size="sm" tone="ok" />
  </div>
</SkeinFigure>

<style>
  .map-layout {
    display: grid;
    grid-template-columns: minmax(240px, 0.9fr) minmax(300px, 1.1fr);
    grid-template-areas:
      "obj map"
      "desc map";
    gap: 24px 28px;
    align-items: start;
    min-width: 760px;
  }

  .obj-panel { grid-area: obj; }
  .map-panel { grid-area: map; }
  .desc-panel { grid-area: desc; }

  /* Object body: word-sized slots */
  .obj-body {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
    margin: 10px 0 6px;
  }

  .obj-word {
    padding: 6px 4px;
    text-align: center;
    background: var(--card);
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    min-width: 0;
  }

  .obj-map-ptr {
    border-color: color-mix(in srgb, var(--d, var(--accent)) 45%, transparent);
    background: color-mix(in srgb, var(--d, var(--accent)) 8%, var(--card));
  }

  .obj-slot {
    background: color-mix(in srgb, var(--ok) 6%, var(--card));
  }

  .obj-arrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }

  .obj-arrow-line {
    flex: 1;
    height: 0.5px;
    background: repeating-linear-gradient(
      90deg,
      var(--d, var(--accent)) 0 6px,
      transparent 6px 10px
    );
  }

  /* Map panel */
  .map-panel {
    padding: 14px 16px;
    background: var(--paper);
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
  }

  .map-panel-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 0.5px solid var(--hairline);
  }

  .map-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 14px;
  }

  .map-field {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 7px 9px;
    background: var(--card);
    border: 0.5px solid var(--hairline);
    border-radius: var(--r-sm);
  }

  .map-field-ptr {
    border-color: color-mix(in srgb, var(--d, var(--accent)) 45%, transparent);
    background: color-mix(in srgb, var(--d, var(--accent)) 8%, var(--card));
  }

  /* DescriptorArray table */
  .desc-panel-head {
    margin-bottom: 10px;
  }

  .desc-table {
    display: grid;
    gap: 4px;
  }

  .desc-row {
    display: grid;
    grid-template-columns: 1fr 0.7fr 1.2fr 0.6fr 1fr;
    gap: 6px;
    align-items: center;
    padding: 6px 9px;
    background: var(--card);
    border: 0.5px solid var(--hairline);
    border-radius: var(--r-sm);
  }

  .desc-row-head {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    background: transparent;
    border-style: dashed;
  }

  .map-readpath {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
    padding-top: 16px;
    border-top: 0.5px solid var(--hairline);
  }

  @media (max-width: 640px) {
    .map-layout {
      grid-template-areas: "obj" "map" "desc";
      grid-template-columns: minmax(0, 1fr);
      min-width: 0;
      gap: 20px;
    }
    .obj-body { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .map-grid { grid-template-columns: minmax(0, 1fr); }
    .desc-row { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
</style>
