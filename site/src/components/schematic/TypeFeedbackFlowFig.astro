---
/**
 * TypeFeedbackFlowFig — Tier-B learning figure.
 *
 * The feedback loop: Ignition observes every IC site while it
 * interprets (maps, call targets, operand types) and records
 * the observations into the closure's feedback vector;
 * Maglev and TurboFan only read that vector. Clean monomorphic
 * feedback becomes fast specialised code; polluted feedback
 * becomes generic dispatch.
 *
 * Server-rendered; the is:inline script replays the
 * observe → record → specialise chain. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "TYPE FEEDBACK LOOP",
    title: "The optimiser specialises only on what the interpreter observed",
    label: "Ignition watches every IC site while it interprets — maps, call targets, operand types — and records them into the closure's feedback vector. Maglev and TurboFan only read that vector.",
    thesis: "Keep slots monomorphic and the code stays fast; pollute one and it goes generic for good.",
    caption: "The interpreter is the sensor, the feedback vector is the log, the optimiser is the reader. No observation at interpretation time means no specialisation at compile time — the optimiser never guesses, it only reads.",
    scope: "V8-SPECIFIC MODEL",
    chain: "OBSERVE → RECORD → SPECIALISE",
    stages: [
      { name: "observe", out: "Ignition watches the site", note: "maps at property loads, targets at calls, operand types at bins" },
      { name: "record", out: "feedback vector slot", note: "per-site state in the closure — the only channel to the optimiser" },
      { name: "specialise", out: "Maglev · TurboFan read", note: "clean monomorphic feedback → fast specialised code" },
      { name: "go generic", out: "polluted feedback", note: "polymorphic or megamorphic slot → generic dispatch, for good" },
    ],
    sensor: "THE SENSOR",
    sensorBody: "Ignition is instrumented: every load, call, and binary operation writes its observation into the vector as it runs. Interpretation is not just execution — it is measurement.",
    pollute: "POLLUTION IS PERMANENT",
    polluteBody: "One polymorphic call site in a hot loop makes the compiled code generic for that slot. Fix the call sites upstream — the vector does not forget.",
  },
  ru: {
    category: "ПЕТЛЯ ОБРАТНОЙ СВЯЗИ",
    title: "Оптимизатор специализируется только на том, что наблюдал интерпретатор",
    label: "Ignition наблюдает каждый IC-сайт во время интерпретации — map'ы, цели вызовов, типы операндов — и записывает их в feedback vector замыкания. Maglev и TurboFan только читают этот vector.",
    thesis: "Держите слоты monomorphic — и код остаётся быстрым; загрязните один — и он навсегда уходит в generic.",
    caption: "Интерпретатор — это сенсор, feedback vector — это журнал, оптимизатор — это читатель. Нет наблюдения в момент интерпретации — нет специализации в момент компиляции: оптимизатор не угадывает, он только читает.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    chain: "НАБЛЮДАЙ → ЗАПИСЫВАЙ → СПЕЦИАЛИЗИРУЙ",
    stages: [
      { name: "observe", out: "Ignition наблюдает сайт", note: "map'ы при загрузках, цели при вызовах, типы операндов в бинарных" },
      { name: "record", out: "слот feedback vector", note: "per-site состояние в замыкании — единственный канал к оптимизатору" },
      { name: "specialise", out: "читают Maglev · TurboFan", note: "чистый monomorphic feedback → быстрый специализированный код" },
      { name: "go generic", out: "загрязнённый feedback", note: "polymorphic или megamorphic слот → generic dispatch, навсегда" },
    ],
    sensor: "СЕНСОР",
    sensorBody: "Ignition инструментирован: каждая загрузка, вызов и бинарная операция пишет своё наблюдение в vector во время выполнения. Интерпретация — это не только исполнение, это измерение.",
    pollute: "ЗАГРЯЗНЕНИЕ ПОСТОЯННО",
    polluteBody: "Один polymorphic сайт вызова в горячем цикле делает скомпилированный код generic для этого слота. Чините сайты вызовов выше по потоку — vector не забывает.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="tff" data-tff>
    <div class="tff-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="tff-head">
      <TechnicalLabel tone="muted" size="xs">{t.chain}</TechnicalLabel>
    </div>

    <ol class="tff-stages">
      {stages.map((s, i) => (
        <li class="tff-stage" data-tff-stage={i}>
          <div class="tff-stage-head">
            <MachineValue value={s.name} tone={i === 3 ? "danger" : i === 2 ? "ok" : "accent"} />
            <MachineValue value={s.out} tone={i === 3 ? "danger" : undefined} />
          </div>
          <p class="tff-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <p class="tff-sensor">
      <TechnicalLabel tone="accent" size="xs">{t.sensor}</TechnicalLabel>
      {t.sensorBody}
    </p>
    <p class="tff-pollute">
      <TechnicalLabel tone="danger" size="xs">{t.pollute}</TechnicalLabel>
      {t.polluteBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the observe→record→specialise chain.
  // All stages are server-rendered — no-JS readers see the whole loop.
  (() => {
    const roots = document.querySelectorAll("[data-tff]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const stages = root.querySelectorAll("[data-tff-stage]");
      if (!stages.length) continue;
      if (reduceMotion) {
        stages.forEach((el) => el.classList.add("tff-stage-live"));
        continue;
      }
      let n = 0;
      const show = (k) => {
        stages.forEach((el, j) => {
          el.classList.toggle("tff-stage-live", j === k);
          el.classList.toggle("tff-stage-done", j < k);
        });
      };
      show(0);
      setInterval(() => {
        n = (n + 1) % (stages.length + 1);
        show(n);
      }, 2400);
    }
  })();
</script>

<style>
  .tff {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .tff-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .tff-head {
    display: flex;
    align-items: baseline;
  }

  .tff-stages {
    display: grid;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tff-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .tff-stage-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tff-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .tff-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }
  .tff-stage-done { border-color: var(--hairline-strong); }

  .tff-sensor,
  .tff-pollute {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tff-stage {
      animation: tff-stage-in var(--dur-2) var(--ease) both;
    }
    .tff-stage:nth-child(2) { animation-delay: 120ms; }
    .tff-stage:nth-child(3) { animation-delay: 240ms; }
    .tff-stage:nth-child(4) { animation-delay: 360ms; }
    @keyframes tff-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
