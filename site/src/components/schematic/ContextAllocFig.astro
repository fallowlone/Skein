---
/**
 * ContextAllocFig — Tier-B learning figure.
 *
 * Per-iteration context allocation: `let` in a loop
 * body creates a fresh binding — and a fresh Context
 * — per iteration, so each closure captures its own
 * value (fns[3]() returns 3). `var` shares one
 * binding and one Context across all iterations, so
 * every closure sees the last value. Correctness vs
 * allocation count.
 *
 * Server-rendered; the is:inline script walks the
 * loop turns. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "CONTEXT ALLOCATION",
    title: "Capture decides allocation — let multiplies, var shares",
    label: "Each loop turn captures a binding: let makes a fresh binding and a fresh Context per turn (n Contexts), var makes one binding shared by all turns (1 Context).",
    thesis: "Capture decides allocation — let multiplies it per turn, var shares it once.",
    caption: "The classic last-value bug is an allocation question. With let, fns[3]() really returns 3 because each closure holds its own binding. With var, every closure reads the same final value — one Context, one shared slot.",
    scope: "V8-SPECIFIC MODEL",
    turns: "PER ITERATION",
    verdict: "WHO SEES WHAT",
    turns: [
      { name: "looping", note: "the loop turns n times" },
      { name: "capturing", note: "each body captures its binding" },
      { name: "let · n Contexts", note: "fresh binding, fresh Context each turn" },
      { name: "var · 1 Context", note: "one binding, one Context shared" },
    ],
    flow: [
      { state: "looping", log: "n iterations" },
      { state: "capturing", log: "closure per turn" },
      { state: "let", log: "n Contexts" },
      { state: "var", log: "1 Context" },
    ],
    correct: "CORRECT — LET WINS BY DEFAULT",
    correctBody: "Per-iteration bindings fix the classic last-value bug: fns[3]() really returns 3. Pay the n allocations gladly unless the loop is hot.",
    hot: "HOT — HOIST OR SHARE",
    hotBody: "In a genuinely hot closure-creating loop, hoist the work out of the loop or share one binding so the GC traces one Context, not n.",
  },
  ru: {
    category: "ВЫДЕЛЕНИЕ CONTEXT'ОВ",
    title: "Захват решает выделение — let умножает, var делит",
    label: "Каждый виток цикла захватывает привязку: let создаёт свежую привязку и свежий Context на виток (n Context'ов), var — одну привязку, разделяемую всеми витками (1 Context).",
    thesis: "Захват решает выделение — let умножает его на каждом витке, var делит один раз.",
    caption: "Классический баг последнего значения — вопрос выделения. С let fns[3]() действительно возвращает 3, потому что каждое замыкание держит свою привязку. С var все замыкания читают одно финальное значение — один Context, один общий слот.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    turns: "НА ИТЕРАЦИЮ",
    verdict: "КТО ЧТО ВИДИТ",
    turns: [
      { name: "цикл", note: "цикл делает n витков" },
      { name: "захват", note: "каждое тело захватывает свою привязку" },
      { name: "let · n Context", note: "свежая привязка, свежий Context каждый виток" },
      { name: "var · 1 Context", note: "одна привязка, один Context на всех" },
    ],
    flow: [
      { state: "цикл", log: "n итераций" },
      { state: "захват", log: "замыкание на виток" },
      { state: "let", log: "n Context" },
      { state: "var", log: "1 Context" },
    ],
    correct: "ВЕРНО — LET ПО УМОЛЧАНИЮ",
    correctBody: "Привязки на итерацию чинят классический баг последнего значения: fns[3]() действительно возвращает 3. Платите n выделениями с радостью, если только цикл не горячий.",
    hot: "ГОРЯЧИЙ — ВЫНОСИТЕ ИЛИ ДЕЛИТЕ",
    hotBody: "В по-настоящему горячем цикле с созданием замыканий выносите работу из цикла или делите одну привязку, чтобы GC трассировал один Context, а не n.",
  },
} as const;

const t = copy[lang];
const turns = t.turns;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="caf" data-caf>
    <div class="caf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="caf-head">
      <TechnicalLabel tone="muted" size="xs">{t.turns}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.verdict}</TechnicalLabel>
    </div>

    <ol class="caf-turns">
      {turns.map((n, i) => (
        <li class="caf-turn" data-caf-turn={i}>
          <div class="caf-turn-main">
            <MachineValue value={n.name} tone={i === 2 ? "warn" : i === 3 ? "ok" : undefined} />
          </div>
          <p class="caf-turn-note">{n.note}</p>
        </li>
      ))}
    </ol>

    <ol class="caf-flow">
      {flow.map((s, i) => (
        <li class="caf-step" data-caf-step={i} hidden={i !== 0}>
          <span class="caf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 2 ? "warn" : i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="caf-correct">
      <TechnicalLabel tone="ok" size="xs">{t.correct}</TechnicalLabel>
      {t.correctBody}
    </p>
    <p class="caf-hot">
      <TechnicalLabel tone="warn" size="xs">{t.hot}</TechnicalLabel>
      {t.hotBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the loop turns.
  // Step 0 is server-rendered; the script replays the capture story.
  (() => {
    const roots = document.querySelectorAll("[data-caf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-caf-step]");
      const turns = root.querySelectorAll("[data-caf-turn]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        turns.forEach((el, j) => {
          el.classList.toggle("caf-turn-live", j === Math.min(n, turns.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .caf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .caf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .caf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .caf-turns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .caf-turn {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .caf-turn-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .caf-turn-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .caf-turn-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .caf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .caf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .caf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .caf-correct,
  .caf-hot {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .caf-turns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .caf-turns { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .caf-turn {
      animation: caf-turn-in var(--dur-2) var(--ease) both;
    }
    .caf-turn:nth-child(2) { animation-delay: 100ms; }
    .caf-turn:nth-child(3) { animation-delay: 200ms; }
    .caf-turn:nth-child(4) { animation-delay: 300ms; }
    @keyframes caf-turn-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
