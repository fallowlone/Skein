---
/**
 * RetainerPathFig — Tier-B learning figure.
 *
 * A leak is a retainer path: a module-scoped
 * cache root reaches an entry whose value is
 * never evicted, the entry reaches a request
 * context, and the context captured a huge
 * buffer that is logically dead. Cut any one
 * link and the whole chain collects; a WeakMap
 * lets the key drop instead.
 *
 * Server-rendered; the is:inline script walks
 * the path. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "RETAINER PATH",
    title: "One live path keeps a dead object",
    label: "A module-scoped cache root reaches an entry the Map never evicts, the entry reaches a request context, and the context captured a huge buffer that is logically dead. Cut any link and it all collects.",
    thesis: "Nothing is leaked — something is reachable. Find the path, cut a link.",
    caption: "The heap does not know the buffer is dead; it only knows a root can still reach it. Every leak is a retainer path, and every fix severs one link in it.",
    scope: "V8-SPECIFIC MODEL",
    chain: "THE CHAIN",
    fix: "THE CUT",
    chainNodes: [
      { name: "cache", note: "module-scoped Map — a GC root by tenure" },
      { name: "entry", note: "value never evicted — the Map keeps it reachable" },
      { name: "req context", note: "captured closure from the request" },
      { name: "big buffer", note: "logically dead, physically retained — the leak" },
    ],
    flow: [
      { state: "path alive", log: "cache → entry" },
      { state: "closure pinned", log: "entry → context" },
      { state: "buffer held", log: "context → 40 MB" },
      { state: "cut", log: "any link → free" },
    ],
    cut: "CUT ONE LINK",
    cutBody: "Delete the entry, clear the map on completion, or null the captured field. Any single cut makes the whole tail unreachable — the collector reclaims the chain in one pass.",
    weak: "WEAKMAP LETS THE KEY DROP",
    weakBody: "A WeakMap holds keys weakly: when nothing else references a key, its entry collects with it. Reachability becomes the eviction policy.",
  },
  ru: {
    category: "ПУТЬ УДЕРЖАНИЯ",
    title: "Один живой путь держит мёртвый объект",
    label: "Кеш-модуль (Map на уровне модуля) достигает записи, которую Map никогда не вытесняет, запись достигает контекста запроса, а контекст захватил огромный буфер, логически мёртвый. Отрежьте любое звено — и всё соберётся.",
    thesis: "Ничего не течёт — что-то достижимо. Найдите путь, отрежьте звено.",
    caption: "Куча не знает, что буфер мёртв; она знает лишь, что root всё ещё может его достичь. Каждая утечка — это путь удержания, и каждое исправление разрывает одно звено в нём.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    chain: "ЦЕПОЧКА",
    fix: "РАЗРЕЗ",
    chainNodes: [
      { name: "кеш", note: "Map уровня модуля — root по принадлежности" },
      { name: "запись", note: "значение никогда не вытесняется — Map держит его достижимым" },
      { name: "контекст", note: "захваченное замыкание запроса" },
      { name: "буфер", note: "логически мёртв, физически удержан — утечка" },
    ],
    flow: [
      { state: "путь жив", log: "кеш → запись" },
      { state: "замыкание", log: "запись → контекст" },
      { state: "буфер держат", log: "контекст → 40 МБ" },
      { state: "разрез", log: "любое звено → free" },
    ],
    cut: "ОТРЕЖЬТЕ ОДНО ЗВЕНО",
    cutBody: "Удалите запись, очистите map по завершению или обнулите захваченное поле. Любой единичный разрез делает весь хвост недостижимым — коллектор собирает цепочку за один проход.",
    weak: "WEAKMAP ПОЗВОЛЯЕТ КЛЮЧУ УПАСТЬ",
    weakBody: "WeakMap держит ключи слабо: когда больше ничего не ссылается на ключ, его запись собирается вместе с ним. Достижимость становится политикой вытеснения.",
  },
} as const;

const t = copy[lang];
const chainNodes = t.chainNodes;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="rpf" data-rpf>
    <div class="rpf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="rpf-head">
      <TechnicalLabel tone="muted" size="xs">{t.chain}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.fix}</TechnicalLabel>
    </div>

    <ol class="rpf-chain">
      {chainNodes.map((n, i) => (
        <li class="rpf-node" data-rpf-node={i}>
          <div class="rpf-node-main">
            <MachineValue value={n.name} tone={i === 0 ? "accent" : i === 3 ? "danger" : undefined} />
          </div>
          <p class="rpf-node-note">{n.note}</p>
        </li>
      ))}
    </ol>

    <ol class="rpf-flow">
      {flow.map((s, i) => (
        <li class="rpf-step" data-rpf-step={i} hidden={i !== 0}>
          <span class="rpf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="rpf-cut">
      <TechnicalLabel tone="ok" size="xs">{t.cut}</TechnicalLabel>
      {t.cutBody}
    </p>
    <p class="rpf-weak">
      <TechnicalLabel tone="muted" size="xs">{t.weak}</TechnicalLabel>
      {t.weakBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the retainer path.
  // Step 0 is server-rendered; the script replays the chain.
  (() => {
    const roots = document.querySelectorAll("[data-rpf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-rpf-step]");
      const nodes = root.querySelectorAll("[data-rpf-node]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        nodes.forEach((el, j) => {
          el.classList.toggle("rpf-node-live", j <= Math.min(n, nodes.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .rpf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .rpf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .rpf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .rpf-chain {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rpf-node {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .rpf-node-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .rpf-node-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .rpf-node-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .rpf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rpf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .rpf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .rpf-cut,
  .rpf-weak {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .rpf-chain { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .rpf-chain { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rpf-node {
      animation: rpf-node-in var(--dur-2) var(--ease) both;
    }
    .rpf-node:nth-child(2) { animation-delay: 100ms; }
    .rpf-node:nth-child(3) { animation-delay: 200ms; }
    .rpf-node:nth-child(4) { animation-delay: 300ms; }
    @keyframes rpf-node-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
