---
/**
 * HandshakeLatencyFig (FIG. 01) — The One-RTT Handshake Tax.
 * Island-free: inline SVG + semantic HTML.
 * Tier A: Major Reference Figure.
 */
import SkeinFigure from "./SkeinFigure.astro";

interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}

const { lang = "en", span = "learning" } = Astro.props;

const copy = {
  en: {
    category: "LATENCY COST",
    title: "The One-Round-Trip Cost of Connection Setup",
    label: "Timeline showing the one-round-trip TCP connection setup, ending with a final ACK that may already carry application payload, compared across LAN, continental, and intercontinental distances.",
    thesis: "One round trip sets up the connection; the final packet may already carry data.",
    caption: "One round trip (SYN → SYN-ACK → ACK) is mandatory. The third packet may already carry the initial payload — an HTTP GET or a TLS ClientHello — so useful data starts at +1.0 RTT rather than waiting for a fourth exchange.",
    client: "CLIENT",
    server: "SERVER",
    syn: "SYN (propose seq=x)",
    synack: "SYN-ACK (ack=x+1, propose seq=y)",
    ack: "ACK (ack=y+1) + First Data",
    taxLabel: "HANDSHAKE TAX: 1.0 RTT",
    payloadZero: "SYN and SYN-ACK normally carry no application payload",
    payloadFlow: "First app bytes travel with final ACK (HTTP / TLS)",
    scenariosTitle: "ILLUSTRATIVE RTT EXAMPLES",
    scenariosUnit: "1 RTT setup",
    zeroBadge: "SETUP",
    lan: "Same Datacenter LAN",
    lanTime: "~0.5 ms",
    lanNote: "negligible tax",
    continental: "Cross-Continent (e.g. Frankfurt → London)",
    continentalTime: "~30 ms",
    continentalNote: "noticeable hitch",
    intercontinental: "Transoceanic / Mobile 4G (NY → Tokyo)",
    intercontinentalTime: "~180 ms",
    intercontinentalNote: "dominant delay",
  },
  ru: {
    category: "СТОИМОСТЬ ЗАДЕРЖКИ",
    title: "Цена установки соединения — один round-trip",
    label: "Временная шкала установки TCP-соединения за один полный round-trip (RTT): финальный ACK уже может нести данные приложения; показано сравнение для локального, континентального и межконтинентального расстояний.",
    thesis: "Один round-trip устанавливает соединение; последний пакет уже может нести данные.",
    caption: "Один round-trip (SYN → SYN-ACK → ACK) обязателен. Третий пакет уже может нести первые данные — HTTP GET или TLS ClientHello, — поэтому полезная передача начинается на +1.0 RTT, без дополнительного обмена.",
    client: "КЛИЕНТ",
    server: "СЕРВЕР",
    syn: "SYN (предлагает seq=x)",
    synack: "SYN-ACK (ack=x+1, предлагает seq=y)",
    ack: "ACK (ack=y+1) + Первые данные",
    taxLabel: "НАЛОГ РУКОПОЖАТИЯ: 1.0 RTT",
    payloadZero: "SYN и SYN-ACK обычно не несут данные приложения",
    payloadFlow: "Первые байты передаются вместе с ACK (HTTP / TLS)",
    scenariosTitle: "ПРИМЕРЫ RTT ДЛЯ ИЛЛЮСТРАЦИИ",
    scenariosUnit: "установка за 1 RTT",
    zeroBadge: "УСТАНОВКА",
    lan: "Локальная сеть ЦОД",
    lanTime: "~0,5 мс",
    lanNote: "неощутимый налог",
    continental: "Внутри континента (Франкфурт → Лондон)",
    continentalTime: "~30 мс",
    continentalNote: "заметная пауза",
    intercontinental: "Межконтинентальный / 4G (Нью-Йорк → Токио)",
    intercontinentalTime: "~180 мс",
    intercontinentalNote: "доминирует во времени ответа",
  },
}[lang];
---

<SkeinFigure
  num="01"
  category={copy.category}
  title={copy.title}
  label={copy.label}
  thesis={copy.thesis}
  caption={copy.caption}
  span={span}
  hue="var(--d-network)"
  variant="clean"
>
  <div class="sk-latency-grid">
    <div class="sk-latency-timeline">
      <svg viewBox="0 0 460 270" class="sk-lt-svg" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <defs>
          <marker id="sk-lt-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--ink)" />
          </marker>
          <marker id="sk-lt-arrow-green" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--ok)" />
          </marker>
        </defs>

        <text x="60" y="24" text-anchor="middle" class="sk-svg-actor">{copy.client}</text>
        <line x1="60" y1="34" x2="60" y2="255" class="sk-svg-lifeline" />

        <text x="400" y="24" text-anchor="middle" class="sk-svg-actor">{copy.server}</text>
        <line x1="400" y1="34" x2="400" y2="255" class="sk-svg-lifeline" />

        <text x="24" y="58" class="sk-svg-time">t₀</text>
        <text x="14" y="118" class="sk-svg-time">+0.5 RTT</text>
        <text x="14" y="178" class="sk-svg-time">+1.0 RTT</text>

        <line x1="60" y1="54" x2="394" y2="114" class="sk-svg-msg" marker-end="url(#sk-lt-arrow)" />
        <text x="210" y="62" text-anchor="middle" class="sk-svg-msglabel">① {copy.syn}</text>

        <line x1="400" y1="114" x2="66" y2="174" class="sk-svg-msg" marker-end="url(#sk-lt-arrow)" />
        <text x="250" y="156" text-anchor="middle" class="sk-svg-msglabel">② {copy.synack}</text>

        <line x1="60" y1="174" x2="394" y2="234" class="sk-svg-msg sk-svg-msg-ok" marker-end="url(#sk-lt-arrow-green)" />
        <text x="210" y="188" text-anchor="middle" class="sk-svg-msglabel sk-msg-ok">③ {copy.ack}</text>

        <path d="M424 54 L436 54 L436 174 L424 174" fill="none" stroke="var(--d, var(--accent))" stroke-width="1.5" />
        <line x1="436" y1="114" x2="444" y2="114" stroke="var(--d, var(--accent))" stroke-width="1.5" />
        <text x="448" y="118" class="sk-svg-bracket-text" transform="rotate(90, 448, 118)" text-anchor="middle">{copy.taxLabel}</text>

        <rect x="60" y="244" width="340" height="18" rx="2" class="sk-svg-payload-zone" />
        <text x="230" y="256" text-anchor="middle" class="sk-svg-payload-text">{copy.payloadFlow}</text>
      </svg>
    </div>

    <div class="sk-latency-scenarios">
      <div class="sk-scenarios-head">
        <span class="sk-scenarios-kicker">{copy.scenariosTitle}</span>
        <span class="sk-scenarios-unit">{copy.scenariosUnit}</span>
      </div>

      <div class="sk-scenarios-list">
        <div class="sk-scenario-item">
          <div class="sk-sc-row">
            <span class="sk-sc-name">{copy.lan}</span>
            <span class="sk-sc-time sk-tone-ok">{copy.lanTime}</span>
          </div>
          <div class="sk-sc-bar-track">
            <div class="sk-sc-bar-fill sk-fill-ok" style="width: 3%;"></div>
          </div>
          <span class="sk-sc-sub">{copy.lanNote}</span>
        </div>

        <div class="sk-scenario-item">
          <div class="sk-sc-row">
            <span class="sk-sc-name">{copy.continental}</span>
            <span class="sk-sc-time sk-tone-warn">{copy.continentalTime}</span>
          </div>
          <div class="sk-sc-bar-track">
            <div class="sk-sc-bar-fill sk-fill-warn" style="width: 28%;"></div>
          </div>
          <span class="sk-sc-sub">{copy.continentalNote}</span>
        </div>

        <div class="sk-scenario-item">
          <div class="sk-sc-row">
            <span class="sk-sc-name">{copy.intercontinental}</span>
            <span class="sk-sc-time sk-tone-danger">{copy.intercontinentalTime}</span>
          </div>
          <div class="sk-sc-bar-track">
            <div class="sk-sc-bar-fill sk-fill-danger" style="width: 95%;"></div>
          </div>
          <span class="sk-sc-sub">{copy.intercontinentalNote}</span>
        </div>
      </div>

      <div class="sk-scenarios-footer">
        <div class="sk-zero-bytes">
          <span class="sk-zb-badge">{copy.zeroBadge}</span>
          <span class="sk-zb-text">{copy.payloadZero}</span>
        </div>
      </div>
    </div>
  </div>
</SkeinFigure>

<style>
  .sk-latency-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 40px);
    align-items: start;
  }

  @media (max-width: 820px) {
    .sk-latency-grid {
      grid-template-columns: 1fr;
    }
  }

  .sk-latency-timeline {
    width: 100%;
    min-width: 0;
  }

  .sk-lt-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .sk-svg-actor {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    fill: var(--ink);
  }

  .sk-svg-lifeline {
    stroke: var(--hairline-strong);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }

  .sk-svg-time {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--muted);
  }

  .sk-svg-msg {
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .sk-svg-msg-ok {
    stroke: var(--ok);
    stroke-width: 1.8;
  }

  .sk-svg-msglabel {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .sk-msg-ok {
    fill: var(--ok);
    font-weight: 600;
  }

  .sk-svg-bracket-text {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    fill: var(--d, var(--accent));
  }

  .sk-svg-payload-zone {
    fill: color-mix(in srgb, var(--ok) 10%, transparent);
    stroke: color-mix(in srgb, var(--ok) 35%, transparent);
    stroke-width: 0.5;
  }

  .sk-svg-payload-text {
    font-family: var(--font-body);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    fill: var(--ok);
  }

  /* Flattened scenarios column: hairline rule instead of nested card */
  .sk-latency-scenarios {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-left: clamp(16px, 2.5vw, 24px);
    border-left: 1px solid var(--hairline-strong);
  }

  @media (max-width: 820px) {
    .sk-latency-scenarios {
      padding-left: 0;
      border-left: none;
      padding-top: 20px;
      border-top: 1px solid var(--hairline-strong);
    }
  }

  .sk-scenarios-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 8px;
    border-bottom: 0.5px solid var(--hairline);
  }

  .sk-scenarios-kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sk-scenarios-unit {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--d, var(--accent));
    font-weight: 500;
  }

  .sk-scenarios-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .sk-scenario-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sk-sc-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 12.5px;
  }

  .sk-sc-name {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--ink);
  }

  .sk-sc-time {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .sk-tone-ok {
    color: var(--ok);
  }
  .sk-tone-warn {
    color: var(--warn);
  }
  .sk-tone-danger {
    color: var(--danger);
  }

  .sk-sc-bar-track {
    height: 3px;
    background: var(--hairline);
    border-radius: var(--r-pill);
    overflow: hidden;
  }

  .sk-sc-bar-fill {
    height: 100%;
    border-radius: var(--r-pill);
    transition: width var(--dur-2) var(--ease);
  }

  .sk-fill-ok {
    background: var(--ok);
  }
  .sk-fill-warn {
    background: var(--warn);
  }
  .sk-fill-danger {
    background: var(--danger);
  }

  .sk-sc-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 11px;
    color: var(--ink-2);
  }

  .sk-scenarios-footer {
    padding-top: 10px;
    border-top: 0.5px solid var(--hairline);
  }

  .sk-zero-bytes {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sk-zb-badge {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: color-mix(in srgb, var(--danger) 10%, transparent);
    border: 0.5px solid color-mix(in srgb, var(--danger) 30%, transparent);
    color: var(--danger);
    padding: 2px 6px;
    border-radius: var(--r-sm);
  }

  .sk-zb-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 12px;
    color: var(--muted);
  }
</style>
