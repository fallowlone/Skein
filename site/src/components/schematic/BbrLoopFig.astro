---
/**
 * BbrLoopFig — Tier-B learning figure.
 *
 * The BBR control loop: measure the delivery rate and the minimum
 * RTT, multiply them into the bandwidth-delay product, then pace
 * sends to fill — but not overflow — the bottleneck. Packet loss
 * is ignored as a congestion signal; the model, not the loss,
 * decides.
 *
 * Server-rendered; the is:inline script replays the loop.
 * Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "CONGESTION CONTROL",
    title: "Model the pipe, ignore the drops",
    label: "The BBR control loop: measure delivered-byte rate and minimum RTT, multiply them to get the bandwidth-delay product, pace sends to fill but not overflow the bottleneck; packet loss is ignored as a congestion signal.",
    thesis: "BBR paces to a model of the pipe — loss is noise, not a brake.",
    caption: "Classic TCP backs off at loss; BBR instead estimates bottleneck bandwidth and minimum RTT, then paces at BDP. Loss on a clean path does not slow it down — that is the whole point, and the controversy.",
    scope: "GOOGLE BBR, 2016",
    loop: "THE CONTROL LOOP",
    rule: "LOSS = NOISE",
    stages: [
      { name: "measure path", note: "delivery rate + min-RTT sampling" },
      { name: "model bottleneck", note: "BDP = bandwidth × RTT" },
      { name: "pace sends", note: "fill the pipe, never overflow it" },
      { name: "ignore loss", note: "not a congestion signal here" },
    ],
    flow: [
      { state: "sampling", log: "delivery rate · min-RTT" },
      { state: "modelling", log: "BDP = BW × RTT" },
      { state: "pacing", log: "send at BDP rate" },
      { state: "steady", log: "full pipe, no loss ✓" },
    ],
    bdp: "THE MODEL — BANDWIDTH-DELAY PRODUCT",
    bdpBody: "BDP is the bytes that fill the path: rate × RTT. Pacing at BDP keeps the bottleneck saturated without queueing — no standing queue means no self-inflicted loss.",
    controversy: "WHY IT DIVIDES OPINION",
    controversyBody: "BBR's loss-insensitivity can starve loss-based flows sharing the same bottleneck, and early versions underestimated buffer needs on shallow paths. Fairness, not speed, is the live debate.",
  },
  ru: {
    category: "КОНТРОЛЬ ПЕРЕГРУЗКИ",
    title: "Модель трубы, а не капли",
    label: "Цикл управления BBR: измерить скорость доставки байтов и минимальный RTT, перемножить их в bandwidth-delay product, отправлять с темпом, заполняющим — но не переполняющим — узкое место; потеря пакетов игнорируется как сигнал перегрузки.",
    thesis: "BBR держит темп по модели трубы — потеря шум, а не тормоз.",
    caption: "Классический TCP отступает при потерях; BBR оценивает пропускную способность узкого места и минимальный RTT, затем держит темп на уровне BDP. Потеря на чистом пути его не замедляет — в этом весь смысл и вся полемика.",
    scope: "GOOGLE BBR, 2016",
    loop: "ЦИКЛ УПРАВЛЕНИЯ",
    rule: "ПОТЕРЯ = ШУМ",
    stages: [
      { name: "измерить путь", note: "выборка delivery rate + min-RTT" },
      { name: "смоделировать узкое место", note: "BDP = bandwidth × RTT" },
      { name: "держать темп", note: "заполнять трубу, не переливать" },
      { name: "игнорировать потерю", note: "здесь это не сигнал перегрузки" },
    ],
    flow: [
      { state: "выборка", log: "delivery rate · min-RTT" },
      { state: "модель", log: "BDP = BW × RTT" },
      { state: "темп", log: "отправка на скорости BDP" },
      { state: "устойчивое", log: "полная труба, нет потерь ✓" },
    ],
    bdp: "МОДЕЛЬ — BANDWIDTH-DELAY PRODUCT",
    bdpBody: "BDP — это байты, заполняющие путь: скорость × RTT. Темп на уровне BDP держит узкое место насыщенным без очереди — нет постоянной очереди, нет самонанесённых потерь.",
    controversy: "ПОЧЕМУ ЭТО РАЗДЕЛЯЕТ МНЕНИЯ",
    controversyBody: "Нечувствительность BBR к потерям может голодить loss-based потоки на том же узком месте, а ранние версии недооценивали буферы на мелких путях. Дискуссия — о справедливости, не о скорости.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="bbf" data-bbf>
    <div class="bbf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="bbf-head">
      <TechnicalLabel tone="muted" size="xs">{t.loop}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="bbf-stages">
      {stages.map((s, i) => (
        <li class="bbf-stage" data-bbf-stage={i}>
          <div class="bbf-stage-main">
            <MachineValue value={s.name} tone={i === 3 ? "warn" : i === 2 ? "accent" : undefined} />
          </div>
          <p class="bbf-stage-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="bbf-flow">
      {flow.map((s, i) => (
        <li class="bbf-step" data-bbf-step={i} hidden={i !== 0}>
          <span class="bbf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="bbf-bdp">
      <TechnicalLabel tone="muted" size="xs">{t.bdp}</TechnicalLabel>
      {t.bdpBody}
    </p>
    <p class="bbf-controversy">
      <TechnicalLabel tone="warn" size="xs">{t.controversy}</TechnicalLabel>
      {t.controversyBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: run the control loop.
  (() => {
    const roots = document.querySelectorAll("[data-bbf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-bbf-step]");
      const stages = root.querySelectorAll("[data-bbf-stage]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        stages.forEach((el, j) => {
          el.classList.toggle("bbf-stage-live", j === Math.min(n, stages.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .bbf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .bbf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .bbf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .bbf-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bbf-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .bbf-stage-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .bbf-stage-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .bbf-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .bbf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bbf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .bbf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .bbf-bdp,
  .bbf-controversy {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .bbf-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .bbf-stages { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bbf-stage {
      animation: bbf-stage-in var(--dur-2) var(--ease) both;
    }
    .bbf-stage:nth-child(2) { animation-delay: 100ms; }
    .bbf-stage:nth-child(3) { animation-delay: 200ms; }
    .bbf-stage:nth-child(4) { animation-delay: 300ms; }
    @keyframes bbf-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
