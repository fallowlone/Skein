---
/**
 * DiagnosisLoopFig — Tier-B learning figure.
 *
 * The engine is instrumented — read its events.
 * Reproduce deterministically, run under the
 * right trace flag, read the emitted events
 * to name the cause, then fix the data or
 * control flow that produced them. You never
 * tune the engine; the engine is the
 * instrument, not the target.
 *
 * Server-rendered; the is:inline script walks
 * the loop. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "OPT/DEOPT DIAGNOSIS",
    title: "The engine is instrumented — read its events",
    label: "Reproduce deterministically, run it under the right trace flag, read the emitted events to name the cause, then fix the data or control flow that produced them. You never tune the engine.",
    thesis: "Reproduce, trace, read, fix the input.",
    caption: "--trace-opt and --trace-deopt emit the optimiser's decisions as they happen. The loop closes when the same repro runs clean and stays clean.",
    scope: "V8 TOOLING",
    loop: "THE DIAGNOSIS LOOP",
    tools: "TOOLS",
    stages: [
      { name: "reproduce", note: "deterministic — the slow path on demand" },
      { name: "trace", note: "--trace-opt / --trace-deopt / %natives" },
      { name: "read events", note: "name the exact cause in the log" },
      { name: "fix data", note: "re-verify the same repro until clean" },
    ],
    flow: [
      { state: "repro", log: "deterministic harness" },
      { state: "trace", log: "--trace-opt / --trace-deopt" },
      { state: "cause", log: "wrong map · not a Smi" },
      { state: "fix", log: "fix data → re-run ✓" },
    ],
    d8: "D8 — QUIETER EXPERIMENTS",
    d8Body: "For one-off probes d8 has no Node noise. For your real app, node --prof or --cpu-prof shows where samples actually land.",
    natives: "%NATIVES — FORCE THE QUESTION",
    nativesBody: "Under --allow-natives-syntax, %GetOptimizationStatus(fn) reads tier bits directly instead of inferring them from log lines.",
  },
  ru: {
    category: "ДИАГНОСТИКА OPT/DEOPT",
    title: "Движок инструментирован — читайте его события",
    label: "Воспроизведите детерминистично, запустите под правильным trace-флагом, прочитайте emitted-события, назовите причину, затем исправьте данные или поток управления, которые их породили. Двигать движок нельзя.",
    thesis: "Воспроизведите, трассируйте, прочитайте, исправьте вход.",
    caption: "--trace-opt и --trace-deopt испускают решения оптимизатора по мере их совершения. Цикл замыкается, когда тот же repro работает чисто и остаётся чистым.",
    scope: "ИНСТРУМЕНТЫ V8",
    loop: "ДИАГНОСТИЧЕСКИЙ ЦИКЛ",
    tools: "ИНСТРУМЕНТЫ",
    stages: [
      { name: "воспроизвести", note: "детерминистично — медленный путь по требованию" },
      { name: "трассировать", note: "--trace-opt / --trace-deopt / %natives" },
      { name: "читать события", note: "назвать точную причину в логе" },
      { name: "исправить данные", note: "перепроверить тот же repro до чистоты" },
    ],
    flow: [
      { state: "repro", log: "детерминистичный harness" },
      { state: "trace", log: "--trace-opt / --trace-deopt" },
      { state: "причина", log: "не та map · не Smi" },
      { state: "исправлено", log: "fix data → re-run ✓" },
    ],
    d8: "D8 — ТИШЕ ЭКСПЕРИМЕНТОВ",
    d8Body: "Для разовых зондов d8 не имеет шума Node. Для реального приложения node --prof или --cpu-prof показывает, где реально падают сэмплы.",
    natives: "%NATIVES — ЗАДАТЬ ВОПРОС ВЛОВЬ",
    nativesBody: "Под --allow-natives-syntax %GetOptimizationStatus(fn) читает биты тира напрямую, а не выводит их из строк лога.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="dlf" data-dlf>
    <div class="dlf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="dlf-head">
      <TechnicalLabel tone="muted" size="xs">{t.loop}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.tools}</TechnicalLabel>
    </div>

    <ol class="dlf-stages">
      {stages.map((s, i) => (
        <li class="dlf-stage" data-dlf-stage={i}>
          <div class="dlf-stage-main">
            <MachineValue value={s.name} tone={i === 1 ? "accent" : i === 3 ? "ok" : undefined} />
          </div>
          <p class="dlf-stage-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="dlf-flow">
      {flow.map((s, i) => (
        <li class="dlf-step" data-dlf-step={i} hidden={i !== 0}>
          <span class="dlf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="dlf-d8">
      <TechnicalLabel tone="muted" size="xs">{t.d8}</TechnicalLabel>
      {t.d8Body}
    </p>
    <p class="dlf-natives">
      <TechnicalLabel tone="warn" size="xs">{t.natives}</TechnicalLabel>
      {t.nativesBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the diagnosis loop.
  // Step 0 is server-rendered; the script replays the loop.
  (() => {
    const roots = document.querySelectorAll("[data-dlf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-dlf-step]");
      const stages = root.querySelectorAll("[data-dlf-stage]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        stages.forEach((el, j) => {
          el.classList.toggle("dlf-stage-live", j === Math.min(n, stages.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .dlf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .dlf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .dlf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .dlf-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dlf-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .dlf-stage-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .dlf-stage-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .dlf-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .dlf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dlf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .dlf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .dlf-d8,
  .dlf-natives {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .dlf-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .dlf-stages { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dlf-stage {
      animation: dlf-stage-in var(--dur-2) var(--ease) both;
    }
    .dlf-stage:nth-child(2) { animation-delay: 100ms; }
    .dlf-stage:nth-child(3) { animation-delay: 200ms; }
    .dlf-stage:nth-child(4) { animation-delay: 300ms; }
    @keyframes dlf-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
