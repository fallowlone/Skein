---
/**
 * TwoQueueTurnFig — Tier-B learning figure.
 *
 * One macrotask per turn, microtasks drained
 * to empty. Each turn dequeues exactly one
 * macrotask so the host can render between
 * them, then the engine drains the entire
 * microtask queue FIFO before anything else
 * runs. Chains are atomic; a microtask that
 * enqueues starves the host.
 *
 * Server-rendered; the is:inline script walks
 * the turn. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "TWO QUEUES",
    title: "One macrotask, then every microtask",
    label: "Each turn dequeues exactly one macrotask so the host can render between them, then the engine drains the entire microtask queue to empty before anything else runs.",
    thesis: "Macrotasks are rationed — microtasks are exhaustive.",
    caption: "The asymmetry is the design: one macrotask per turn keeps the host responsive; draining microtasks to empty makes an entire promise chain atomic.",
    scope: "EVENT-LOOP MODEL",
    turn: "ONE TURN",
    rule: "1 vs ALL",
    stages: [
      { name: "dequeue ONE", note: "macrotask queue — timers, IO, input" },
      { name: "run + enqueue", note: "promise reactions queue as microtasks" },
      { name: "drain ALL", note: "microtask queue FIFO, to empty" },
      { name: "render", note: "host gets the loop back — then one more task" },
    ],
    flow: [
      { state: "dequeue", log: "ONE macrotask" },
      { state: "reactions", log: "then → microtasks" },
      { state: "drain", log: "ALL microtasks" },
      { state: "render", log: "host · next task" },
    ],
    atomic: "ATOMIC — A CHAIN COMPLETES WHOLE",
    atomicBody: "Because the drain is exhaustive, an entire promise chain finishes before the next timer or render. That is the coherence the design buys.",
    starve: "STARVATION — A MICROTASK THAT ENQUEUES",
    starveBody: "A microtask scheduling another microtask keeps the queue non-empty, so the host never gets the loop back: no render, no timers, no input.",
  },
  ru: {
    category: "ДВЕ ОЧЕРЕДИ",
    title: "Один макрозадача, затем все микрозадачи",
    label: "Каждый оборот извлекает ровно одну макрозадачу, чтобы хост мог отрисовать между ними, затем движок опустошает всю очередь микрозадач до пустоты, прежде чем запустится что-то ещё.",
    thesis: "Макрозадачи нормируются — микрозадачи исчерпывающие.",
    caption: "Асимметрия — дизайн: одна макрозадача на оборот держит хост отзывчивым; опустошение микрозадач до пустоты делает всю цепочку промисов атомарной.",
    scope: "МОДЕЛЬ EVENT LOOP",
    turn: "ОДИН ОБОРОТ",
    rule: "1 vs ВСЕ",
    stages: [
      { name: "извлечь ОДНУ", note: "очередь макрозадач — таймеры, IO, ввод" },
      { name: "выполнить + добавить", note: "реакции промисов становятся микрозадачами" },
      { name: "слить ВСЕ", note: "очередь микрозадач FIFO, до пустоты" },
      { name: "отрисовать", note: "хост возвращает цикл — затем ещё одна задача" },
    ],
    flow: [
      { state: "извлечение", log: "ОДНА макрозадача" },
      { state: "реакции", log: "then → микрозадачи" },
      { state: "слив", log: "ВСЕ микрозадачи" },
      { state: "отрисовка", log: "хост · след. задача" },
    ],
    atomic: "АТОМЕННО — ЦЕПОЧКА ЗАВЕРШАЕТСЯ ЦЕЛИКОМ",
    atomicBody: "Потому что слив исчерпывающий, вся цепочка промисов завершается до следующего таймера или отрисовки. Это та когерентность, которую дизайн покупает.",
    starve: "ГИБЕЛЬ — МИКРОЗАДАЧА, ЧТО ДОБАВЛЯЕТ",
    starveBody: "Микрозадача, планирующая микрозадачу, держит очередь непустой, так что хост никогда не получает цикл: ни отрисовки, ни таймеров, ни ввода.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="tqf" data-tqf>
    <div class="tqf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="tqf-head">
      <TechnicalLabel tone="muted" size="xs">{t.turn}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="tqf-stages">
      {stages.map((s, i) => (
        <li class="tqf-stage" data-tqf-stage={i}>
          <div class="tqf-stage-main">
            <MachineValue value={s.name} tone={i === 0 ? "accent" : i === 2 ? "warn" : undefined} />
          </div>
          <p class="tqf-stage-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="tqf-flow">
      {flow.map((s, i) => (
        <li class="tqf-step" data-tqf-step={i} hidden={i !== 0}>
          <span class="tqf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="tqf-atomic">
      <TechnicalLabel tone="ok" size="xs">{t.atomic}</TechnicalLabel>
      {t.atomicBody}
    </p>
    <p class="tqf-starve">
      <TechnicalLabel tone="danger" size="xs">{t.starve}</TechnicalLabel>
      {t.starveBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk one turn.
  // Step 0 is server-rendered; the script replays the queue cadence.
  (() => {
    const roots = document.querySelectorAll("[data-tqf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-tqf-step]");
      const stages = root.querySelectorAll("[data-tqf-stage]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        stages.forEach((el, j) => {
          el.classList.toggle("tqf-stage-live", j === Math.min(n, stages.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .tqf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .tqf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .tqf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tqf-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tqf-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .tqf-stage-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tqf-stage-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .tqf-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .tqf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tqf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .tqf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .tqf-atomic,
  .tqf-starve {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .tqf-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .tqf-stages { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tqf-stage {
      animation: tqf-stage-in var(--dur-2) var(--ease) both;
    }
    .tqf-stage:nth-child(2) { animation-delay: 100ms; }
    .tqf-stage:nth-child(3) { animation-delay: 200ms; }
    .tqf-stage:nth-child(4) { animation-delay: 300ms; }
    @keyframes tqf-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
