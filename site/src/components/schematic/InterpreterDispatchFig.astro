---
import SkeinFigure from "./SkeinFigure.astro";

interface Props { lang?: "en" | "ru" }
const { lang = "en" } = Astro.props;
const t = {
  en: {
    category: "IGNITION · ONE DISPATCH",
    title: "An opcode selects a handler; the handler passes on the state",
    label: "Conceptual Ignition dispatch for Add r0. The bytecode pointer selects Add in the bytecode array; the dispatch table points to its handler. With register r0 containing 7 and accumulator containing 5, the handler computes 12 in the accumulator, records operation feedback in the named slot, advances the pointer to Return, and dispatches again. Loop back-edges and function returns, not every bytecode, reduce the interrupt budget.",
    thesis: "The loop is a handoff between handlers, not a return to one central switch.",
    caption: "Conceptual trace, not a literal bytecode dump. Handler and feedback details vary by operation and V8 version.",
    array: "BYTECODE ARRAY",
    pointer: "PC →",
    current: "CURRENT INSTRUCTION",
    next: "NEXT",
    table: "DISPATCH TABLE",
    lookup: "opcode Add → handler address",
    handler: "ADD HANDLER",
    before: "INPUT STATE",
    operation: "read r0 + accumulator",
    after: "OUTPUT STATE",
    feedback: "feedback slot ← observed operands",
    advance: "advance PC past operands → Return",
    budget: "INTERRUPT BUDGET",
    budgetNote: "Updated at loop back-edges and returns; underflow asks the tiering manager what to do next.",
  },
  ru: {
    category: "IGNITION · ОДНА ДИСПЕТЧЕРИЗАЦИЯ",
    title: "Опкод выбирает обработчик; обработчик передаёт состояние дальше",
    label: "Упрощённая диспетчеризация Ignition для Add r0. Указатель выбирает Add в массиве байт-кода; таблица диспетчеризации ведёт к обработчику. При r0 равном 7 и аккумуляторе 5 обработчик получает 12 в аккумуляторе, записывает наблюдения в слот обратной связи, переводит указатель на Return и диспетчеризует следующую инструкцию. Бюджет прерываний уменьшается на обратных переходах цикла и возвратах, а не на каждой инструкции.",
    thesis: "Цикл передаёт управление между обработчиками, а не возвращается к общему switch.",
    caption: "Упрощённая трасса, не буквальный дамп байт-кода. Детали обработчика и обратной связи зависят от операции и версии V8.",
    array: "МАССИВ БАЙТ-КОДА",
    pointer: "PC →",
    current: "ТЕКУЩАЯ ИНСТРУКЦИЯ",
    next: "СЛЕДУЮЩАЯ",
    table: "ТАБЛИЦА ДИСПЕТЧЕРИЗАЦИИ",
    lookup: "опкод Add → адрес обработчика",
    handler: "ОБРАБОТЧИК ADD",
    before: "ВХОДНОЕ СОСТОЯНИЕ",
    operation: "прочитать r0 + аккумулятор",
    after: "ВЫХОДНОЕ СОСТОЯНИЕ",
    feedback: "слот обратной связи ← наблюдаемые операнды",
    advance: "продвинуть PC за операнды → Return",
    budget: "БЮДЖЕТ ПРЕРЫВАНИЙ",
    budgetNote: "Обновляется на обратных переходах и возвратах; при исчерпании менеджер ярусов решает, что делать дальше.",
  },
}[lang];
---

<SkeinFigure num="01" category={t.category} title={t.title} label={t.label} thesis={t.thesis} caption={t.caption} span="learning" variant="clean" hue="var(--ink-2)">
  <div class="schematic">
    <div class="tape">
      <div class="label">01 / {t.array}</div>
      <div class="tape-row"><span>01</span><code>LdaSmi 7</code></div>
      <div class="tape-row"><span>02</span><code>Star r0</code></div>
      <div class="tape-row"><span>03</span><code>LdaSmi 5</code></div>
      <div class="tape-row active"><span>PC</span><code>Add r0, [slot]</code><i aria-hidden="true">→</i></div>
      <div class="tape-row"><span>05</span><code>Return</code></div>
      <div class="callout"><span class="leader" aria-hidden="true"></span>{t.current}</div>
    </div>

    <div class="bridge">
      <div class="label">02 / {t.table}</div>
      <div class="bridge-line" aria-hidden="true"><span>→</span></div>
      <div class="lookup"><strong>Add</strong><span>→</span><code>&amp;handler</code></div>
      <div class="bridge-line" aria-hidden="true"><span>→</span></div>
      <div class="bridge-note">{t.lookup}</div>
    </div>

    <div class="machine">
      <div class="label">03 / {t.handler}</div>
      <div class="mechanism">
        <svg class="wires" viewBox="0 0 340 214" preserveAspectRatio="none" aria-hidden="true">
          <path d="M72 38 V70 L170 106 M268 38 V70 L170 106" />
          <path class="accent-wire" d="M170 129 V178" />
          <circle cx="170" cy="106" r="31" />
          <path class="guide" d="M72 70 H36 M268 70 H304 M170 178 H312" />
        </svg>
        <div class="input left"><span>r0</span><strong>7</strong></div>
        <div class="input right"><span>ACC</span><strong>5</strong></div>
        <div class="plus" aria-hidden="true">+</div>
        <div class="output"><span>ACC</span><strong>12</strong></div>
      </div>
      <div class="operation">{t.operation}</div>
      <div class="after"><span class="leader" aria-hidden="true"></span>{t.feedback}</div>
      <div class="after"><span class="leader" aria-hidden="true"></span>{t.advance}</div>
    </div>

    <div class="budget"><strong>{t.budget}</strong><span>{t.budgetNote}</span></div>
  </div>
</SkeinFigure>

<style>
  .schematic { --diagram-accent: #a74a31; display: grid; grid-template-columns: minmax(0, 1fr) minmax(110px, .56fr) minmax(0, 1.2fr); gap: 20px; padding: 28px 22px 20px; background-color: var(--paper); background-image: linear-gradient(color-mix(in srgb, var(--ink) 3%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 3%, transparent) 1px, transparent 1px); background-size: 12px 12px; color: var(--ink); }
  .label { min-height: 34px; font: 600 10px/1.4 var(--font-mono); letter-spacing: .11em; color: var(--muted); text-transform: uppercase; }
  .tape, .bridge, .machine { min-width: 0; }
  .tape { padding-top: 8px; }
  .tape-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) 18px; align-items: center; min-height: 42px; border-bottom: 1px solid var(--hairline-strong); background: var(--paper); padding: 0 6px; }
  .tape-row:first-of-type { border-top: 1px solid var(--hairline-strong); }
  .tape-row span { font: 10px var(--font-mono); color: var(--muted); }
  .tape-row code { font: 11px/1.4 var(--font-mono); white-space: nowrap; color: var(--ink); background: none; padding: 0; border: 0; }
  .tape-row i { font: 17px var(--font-mono); font-style: normal; color: var(--diagram-accent); }
  .tape-row.active { border-left: 2px solid var(--diagram-accent); border-bottom-color: var(--diagram-accent); }
  .tape-row.active span, .tape-row.active code { color: var(--diagram-accent); font-weight: 700; }
  .callout, .after, .bridge-note { font: 10px/1.45 var(--font-mono); color: var(--muted); }
  .callout { display: flex; gap: 8px; align-items: center; margin-top: 20px; }
  .leader { display: inline-block; width: 24px; min-width: 24px; border-top: 1px solid var(--ink-2); }
  .bridge { padding-top: 8px; display: flex; flex-direction: column; align-items: stretch; }
  .bridge .label { text-align: center; }
  .bridge-line { display: grid; align-items: center; grid-template-columns: 1fr 14px; gap: 0; margin-top: 100px; color: var(--diagram-accent); font: 16px var(--font-mono); }
  .bridge-line::before { content: ''; display: block; border-top: 1px solid var(--diagram-accent); }
  .lookup { display: flex; justify-content: space-between; align-items: center; gap: 3px; padding: 10px 4px; border-block: 1px solid var(--ink-2); font: 11px var(--font-mono); white-space: nowrap; }
  .lookup strong { color: var(--diagram-accent); }
  .lookup code { font: 10px var(--font-mono); padding: 0; background: none; color: var(--ink); }
  .bridge-line + .lookup + .bridge-line { margin-top: 16px; }
  .bridge-note { margin-top: 22px; text-align: center; }
  .machine { padding-top: 8px; }
  .mechanism { position: relative; height: 214px; margin-top: 18px; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: var(--ink-2); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .wires .accent-wire { stroke: var(--diagram-accent); stroke-width: 1.5; }
  .wires .guide { stroke: var(--muted); stroke-dasharray: 3 5; opacity: .6; }
  .input, .output { position: absolute; z-index: 1; display: flex; justify-content: space-between; align-items: center; gap: 12px; width: 92px; height: 30px; padding: 0 7px; border: 1px solid var(--ink-2); background: var(--paper); font: 11px var(--font-mono); box-sizing: border-box; }
  .input.left { left: calc(21.2% - 46px); top: 8px; }
  .input.right { left: calc(78.8% - 46px); top: 8px; }
  .output { left: calc(50% - 46px); top: 177px; border-color: var(--diagram-accent); }
  .output strong { color: var(--diagram-accent); }
  .plus { position: absolute; left: calc(50% - 12px); top: 94px; z-index: 1; font: 20px/24px var(--font-mono); text-align: center; width: 24px; height: 24px; }
  .operation { margin: 0 0 16px; padding-top: 12px; border-top: 1px solid var(--hairline-strong); font: 11px/1.4 var(--font-body); text-align: center; }
  .after { display: flex; gap: 8px; align-items: baseline; padding: 8px 0; border-top: 1px solid var(--hairline); }
  .budget { grid-column: 1 / -1; display: grid; grid-template-columns: 185px 1fr; gap: 18px; margin-top: 14px; border-top: 1px solid var(--hairline-strong); padding-top: 18px; }
  .budget strong { font: 600 10px/1.45 var(--font-mono); letter-spacing: .1em; }
  .budget span { font: 12px/1.5 var(--font-body); color: var(--muted); }
  :global([data-theme='dark']) .schematic { --diagram-accent: #e07855; }
  @media (max-width: 700px) {
    .schematic { grid-template-columns: minmax(0, 1fr); gap: 22px; padding: 18px 0; background-size: 12px 12px; }
    .label { min-height: 26px; padding-inline: 12px; font-size: 11px; }
    .tape, .bridge, .machine { padding-top: 0; }
    .tape-row { margin-inline: 12px; }
    .tape-row code { font-size: 12px; }
    .callout { margin: 14px 12px 0; font-size: 11px; }
    .bridge { align-items: center; }
    .bridge .label { align-self: stretch; text-align: left; }
    .bridge-line { display: block; width: 1px; height: 24px; margin: 0; border-left: 1px solid var(--diagram-accent); }
    .bridge-line::before, .bridge-line span { display: none; }
    .lookup { width: 190px; font-size: 12px; background: var(--paper); }
    .bridge-line + .lookup + .bridge-line { margin: 0; }
    .bridge-note { margin: 8px 0 0; font-size: 11px; }
    .mechanism { margin-inline: 0; }
    .operation { margin-inline: 12px; }
    .after { margin-inline: 12px; font-size: 11px; }
    .budget { grid-column: auto; grid-template-columns: 1fr; gap: 8px; margin: 0 12px; }
    .budget strong { font-size: 11px; }
  }
</style>
