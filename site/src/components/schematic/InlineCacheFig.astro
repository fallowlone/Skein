---
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "INLINE CACHE · LOAD SITE",
    title: "One property access learns a shape, then turns repetition into a guarded load",
    label: "V8-specific load inline-cache lifecycle for p.x: the first receiver misses, runtime resolves the field and records map plus handler in the FeedbackVector, the same map later hits, and a different map returns to the miss path.",
    thesis: "The fast path is learned from observation: guard the receiver Map, then apply the recorded handler.",
    caption: "For a plain in-object field, the handler can be a Smi-encoded field index. A different receiver Map cannot reuse that handler blindly; the miss runtime updates or extends the feedback instead.",
    scope: "V8-SPECIFIC MODEL",
    first: "FIRST EXECUTION · LEARN",
    repeat: "REPEATED EXECUTION · HIT",
    different: "DIFFERENT SHAPE · MISS",
    callSite: "CALL SITE",
    receiver: "RECEIVER MAP",
    slot: "FEEDBACKVECTOR SLOT",
    runtime: "IC MISS RUNTIME",
    result: "RESULT",
    resultValue: "value of x",
    empty: "empty",
    resolve: "resolve x → field #0",
    record: "record observation",
    compare: "compare maps",
    apply: "apply handler",
    mismatch: "map mismatch",
    evolve: "update / extend feedback",
  },
  ru: {
    category: "INLINE CACHE · LOAD-САЙТ",
    title: "Один доступ к свойству изучает форму, а повтор превращается в guarded load",
    label: "V8-специфичный жизненный цикл load inline cache для p.x: первый receiver промахивается, runtime разрешает поле и записывает map плюс handler в FeedbackVector, тот же map затем попадает в быстрый путь, а другой map возвращается в miss-path.",
    thesis: "Быстрый путь рождается из наблюдения: проверь Map receiver'а, затем примени записанный handler.",
    caption: "Для простого in-object-поля handler может быть Smi-кодированным индексом поля. Другой receiver Map нельзя слепо обслужить тем же handler: miss-runtime обновляет или расширяет feedback.",
    scope: "V8-СПЕЦИФИЧНАЯ МОДЕЛЬ",
    first: "ПЕРВЫЙ ЗАПУСК · ОБУЧЕНИЕ",
    repeat: "ПОВТОРНЫЙ ЗАПУСК · HIT",
    different: "ДРУГАЯ ФОРМА · MISS",
    callSite: "МЕСТО ДОСТУПА",
    receiver: "MAP RECEIVER'А",
    slot: "СЛОТ FEEDBACKVECTOR",
    runtime: "RUNTIME ПРОМАХА IC",
    result: "РЕЗУЛЬТАТ",
    resultValue: "значение x",
    empty: "пусто",
    resolve: "найти x → поле #0",
    record: "записать наблюдение",
    compare: "сравнить maps",
    apply: "применить handler",
    mismatch: "maps не совпали",
    evolve: "обновить / расширить feedback",
  },
} as const;

const t = copy[lang];
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="canvas"
  variant="canvas"
>
  <div class="ic-schematic">
    <div class="ic-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <section class="ic-row learn">
      <TechnicalLabel tone="accent" size="xs">{t.first}</TechnicalLabel>
      <div class="ic-flow">
        <div class="ic-node">
          <TechnicalLabel tone="muted" size="xs">{t.callSite}</TechnicalLabel>
          <MachineValue value="p.x" tone="accent" />
        </div>
        <span class="ic-arrow" aria-hidden="true">→</span>
        <div class="ic-node">
          <TechnicalLabel tone="muted" size="xs">{t.receiver}</TechnicalLabel>
          <MachineValue name="map" value="M_Point" />
        </div>
        <span class="ic-arrow" aria-hidden="true">→</span>
        <div class="ic-node slot-empty">
          <TechnicalLabel tone="muted" size="xs">{t.slot}</TechnicalLabel>
          <MachineValue value={t.empty} tone="dim" />
        </div>
        <span class="ic-arrow warn" aria-hidden="true">→</span>
        <div class="ic-node runtime">
          <TechnicalLabel tone="warn" size="xs">{t.runtime}</TechnicalLabel>
          <MachineValue value={t.resolve} tone="warn" size="sm" />
        </div>
      </div>
      <div class="ic-delta">
        <TechnicalLabel tone="accent" size="xs">{t.record}</TechnicalLabel>
        <MachineValue name="map" value="M_Point" tone="accent" />
        <span aria-hidden="true">+</span>
        <MachineValue name="handler" value="Smi(field #0)" tone="accent" />
      </div>
    </section>

    <section class="ic-row hit">
      <TechnicalLabel tone="ok" size="xs">{t.repeat}</TechnicalLabel>
      <div class="ic-flow compact">
        <MachineValue value="p.x" />
        <span class="ic-arrow" aria-hidden="true">→</span>
        <MachineValue name="receiver.map" value="M_Point" />
        <span class="ic-op">{t.compare}</span>
        <MachineValue name="cached.map" value="M_Point" tone="ok" />
        <span class="ic-arrow ok" aria-hidden="true">→</span>
        <MachineValue name="handler" value="Smi(field #0)" tone="ok" />
        <span class="ic-op">{t.apply}</span>
        <MachineValue name={t.result.toLowerCase()} value={t.resultValue} tone="ok" />
      </div>
    </section>

    <section class="ic-row miss">
      <TechnicalLabel tone="danger" size="xs">{t.different}</TechnicalLabel>
      <div class="ic-flow compact">
        <MachineValue value="p.x" />
        <span class="ic-arrow" aria-hidden="true">→</span>
        <MachineValue name="receiver.map" value="M_Other" tone="danger" />
        <span class="ic-op">{t.mismatch}</span>
        <MachineValue name="cached.map" value="M_Point" />
        <span class="ic-arrow danger" aria-hidden="true">→</span>
        <MachineValue value={t.evolve} tone="danger" />
      </div>
    </section>
  </div>
</SkeinFigure>

<style>
  .ic-schematic {
    min-width: 930px;
    display: grid;
    gap: 26px;
  }

  .ic-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -8px;
  }

  .ic-row {
    display: grid;
    gap: 14px;
    padding-block: 4px 22px;
    border-bottom: 0.5px solid var(--hairline-2);
  }

  .ic-row:last-child {
    border-bottom: 0;
    padding-bottom: 4px;
  }

  .ic-flow {
    display: grid;
    grid-template-columns: minmax(120px, 0.8fr) auto minmax(130px, 0.9fr) auto minmax(150px, 1fr) auto minmax(180px, 1.2fr);
    gap: 12px;
    align-items: center;
  }

  .ic-flow.compact {
    grid-template-columns: repeat(9, max-content);
    justify-content: start;
    gap: 10px;
  }

  .ic-node {
    display: grid;
    gap: 8px;
    align-content: start;
    min-height: 58px;
    padding-left: 12px;
    border-left: 0.5px solid var(--hairline-strong);
  }

  .ic-node.runtime {
    border-left-color: color-mix(in srgb, var(--warn) 68%, var(--hairline));
  }

  .ic-arrow {
    font-family: var(--font-mono);
    font-size: 20px;
    color: var(--muted);
  }

  .ic-arrow.ok { color: var(--ok); }
  .ic-arrow.warn { color: var(--warn); }
  .ic-arrow.danger { color: var(--danger); }

  .ic-delta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-left: 286px;
    padding-left: 14px;
    border-left: 1px solid color-mix(in srgb, var(--d, var(--accent)) 55%, var(--hairline));
  }

  .ic-delta > span[aria-hidden="true"] {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .ic-op {
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 1.3;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 1380px) {
    .ic-schematic { min-width: 0; }
    .ic-flow.compact { display: flex; flex-wrap: wrap; }
    .ic-delta { margin-left: 0; }
  }

  @media (max-width: 640px) {
    .ic-flow, .ic-flow.compact { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: start; gap: 8px; }
    .ic-arrow { justify-self: center; transform: rotate(90deg); }
    .ic-node { width: 100%; min-height: 0; box-sizing: border-box; }
    .ic-delta { padding-left: 10px; }
    .ic-schematic :global(.sk-mv) { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
    .ic-op { white-space: normal; }
  }
</style>
