---
/**
 * MachineValue — Monospace machine values, protocol fields, sequence counters,
 * and addresses.
 *
 * Distinct from editorial prose (serif) and technical labels (sans).
 * Follows the Skein schematic typography rules:
 *   MONO -> machine state / sequence numbers / protocol fields / addresses
 */
interface Props {
  /** Optional field name, e.g. "seq", "ack", "port", "state" */
  name?: string;
  /** Value string or number, e.g. "42,000,000", "SYN", "ESTABLISHED" */
  value?: string | number;
  val?: string | number;
  /** Tone for semantic feedback */
  tone?: "neutral" | "ok" | "warn" | "danger" | "accent" | "dim";
  /** Visual variant: "plain" code, "chip" bordered box, or "pill" */
  variant?: "plain" | "chip" | "pill";
  /** Size variant */
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  name,
  value,
  val,
  tone = "neutral",
  variant = "chip",
  size = "md",
  class: className = "",
} = Astro.props;

const displayVal = value ?? val;
---

<code
  class:list={[
    "sk-mv",
    `sk-mv-variant-${variant}`,
    `sk-mv-tone-${tone}`,
    `sk-mv-size-${size}`,
    className,
  ]}
>
  {name && <span class="sk-mv-k">{name}=</span>}
  <span class="sk-mv-v"><slot>{displayVal}</slot></span>
</code>

<style>
  .sk-mv {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
    white-space: nowrap;
    border-radius: var(--r-sm);
  }

  /* Sizes */
  .sk-mv-size-sm {
    font-size: 11px;
    padding: 1px 4px;
  }
  .sk-mv-size-md {
    font-size: 12.5px;
    padding: 2px 6px;
  }
  .sk-mv-size-lg {
    font-size: 14px;
    padding: 3px 8px;
  }

  /* Variants */
  .sk-mv-variant-plain {
    background: transparent;
    border: none;
    padding: 0;
  }

  .sk-mv-variant-chip {
    background: var(--card);
    border: 0.5px solid var(--hairline-2);
  }

  .sk-mv-variant-pill {
    border-radius: var(--r-pill);
    padding-inline: 10px;
    background: var(--card);
    border: 0.5px solid var(--hairline-2);
  }

  /* Key vs Value */
  .sk-mv-k {
    color: var(--muted);
    font-weight: 400;
    margin-right: 2px;
  }

  .sk-mv-v {
    font-weight: 500;
  }

  /* Tones */
  .sk-mv-tone-neutral .sk-mv-v {
    color: var(--ink);
  }

  .sk-mv-tone-accent {
    border-color: color-mix(in srgb, var(--d, var(--accent)) 40%, transparent);
    background: color-mix(in srgb, var(--d, var(--accent)) 8%, var(--card));
  }
  .sk-mv-tone-accent .sk-mv-v {
    color: var(--d, var(--accent));
  }

  .sk-mv-tone-ok {
    border-color: color-mix(in srgb, var(--ok) 40%, transparent);
    background: color-mix(in srgb, var(--ok) 8%, var(--card));
  }
  .sk-mv-tone-ok .sk-mv-v {
    color: var(--ok);
  }

  .sk-mv-tone-warn {
    border-color: color-mix(in srgb, var(--warn) 40%, transparent);
    background: color-mix(in srgb, var(--warn) 8%, var(--card));
  }
  .sk-mv-tone-warn .sk-mv-v {
    color: var(--warn);
  }

  .sk-mv-tone-danger {
    border-color: color-mix(in srgb, var(--danger) 40%, transparent);
    background: color-mix(in srgb, var(--danger) 8%, var(--card));
  }
  .sk-mv-tone-danger .sk-mv-v {
    color: var(--danger);
  }

  .sk-mv-tone-dim .sk-mv-v {
    color: var(--muted);
  }
</style>
