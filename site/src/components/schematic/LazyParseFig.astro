---
import SkeinFigure from "./SkeinFigure.astro";

interface Props { lang?: "en" | "ru" }
const { lang = "en" } = Astro.props;
const t = {
  en: {
    category: "PARSING · DEFERRED WORK",
    title: "The PreParser leaves enough information to return later",
    label: "When V8 parses outer(id), it can preparse nested inner without building inner's AST. The PreParser records the source span, checks syntax, and tracks that inner references id so outer can allocate it correctly. If inner is never called, its full parse and bytecode generation do not occur. On first call, V8 fully parses and compiles inner.",
    thesis: "Deferring the tree does not mean forgetting the scope.",
    caption: "Conceptual V8 path for a nested function eligible for lazy parsing. Actual eager or lazy decisions depend on syntax and engine heuristics.",
    source: "SOURCE · outer(id)",
    mark: "inner body deferred",
    first: "INITIAL PASS",
    preparse: "PREPARSE inner",
    metadata: "small metadata retained",
    span: "source span",
    errors: "syntax / early errors",
    reference: "inner references id",
    context: "outer keeps id in context",
    fork: "WHAT HAPPENS NEXT?",
    never: "inner never called",
    saved: "no inner AST or bytecode needed",
    called: "first call of inner",
    compile: "full parse → AST → bytecode",
    cost: "preparse + later full parse",
  },
  ru: {
    category: "ПАРСИНГ · ОТЛОЖЕННАЯ РАБОТА",
    title: "PreParser сохраняет достаточно данных, чтобы вернуться позже",
    label: "При разборе outer(id) V8 может пре-парсить вложенную inner без построения её AST. PreParser сохраняет диапазон исходника, проверяет синтаксис и отслеживает ссылку inner на id, чтобы outer корректно разместила переменную. Если inner не вызывают, полного парсинга и генерации байт-кода для неё нет. При первом вызове V8 полностью разбирает и компилирует inner.",
    thesis: "Отложить дерево — не значит забыть область видимости.",
    caption: "Упрощённый путь V8 для вложенной функции, подходящей для ленивого парсинга. Решение о жадном или ленивом разборе зависит от синтаксиса и эвристик движка.",
    source: "ИСХОДНИК · outer(id)",
    mark: "тело inner отложено",
    first: "ПЕРВЫЙ ПРОХОД",
    preparse: "PREPARSE inner",
    metadata: "сохранены небольшие метаданные",
    span: "диапазон исходника",
    errors: "синтаксис / ранние ошибки",
    reference: "inner ссылается на id",
    context: "outer хранит id в контексте",
    fork: "ЧТО ДАЛЬШЕ?",
    never: "inner не вызвана",
    saved: "AST и байт-код inner не нужны",
    called: "первый вызов inner",
    compile: "полный парсинг → AST → байт-код",
    cost: "пре-парсинг + поздний полный разбор",
  },
}[lang];
---

<SkeinFigure num="01" category={t.category} title={t.title} label={t.label} thesis={t.thesis} caption={t.caption} span="learning" variant="clean" hue="var(--ink-2)">
  <div class="diagram">
    <section class="source" aria-label={t.source}>
      <div class="kicker">{t.source}</div>
      <div class="code"><span>01</span><code>function outer(id) {'{'}</code></div>
      <div class="code focus"><span>02</span><code>  function inner() {'{'}</code></div>
      <div class="code focus"><span>03</span><code>    return id;</code><i aria-hidden="true">←</i></div>
      <div class="code focus"><span>04</span><code>  {'}'}</code></div>
      <div class="code"><span>05</span><code>  return inner;</code></div>
      <div class="code"><span>06</span><code>{'}'}</code></div>
      <div class="source-note"><span class="marker" aria-hidden="true"></span>{t.mark}</div>
    </section>

    <div class="connector" aria-hidden="true"><span>→</span></div>

    <section class="initial">
      <div class="kicker">{t.first}</div>
      <div class="mechanism"><strong>{t.preparse}</strong><span>{t.metadata}</span></div>
      <div class="facts">
        <div><span>01</span>{t.span}</div>
        <div><span>02</span>{t.errors}</div>
        <div><span>03</span>{t.reference}</div>
      </div>
      <div class="context"><span class="line" aria-hidden="true">↳</span>{t.context}</div>
    </section>

    <div class="outcomes">
      <div class="kicker">{t.fork}</div>
      <div class="outcome"><span class="branch" aria-hidden="true">↳</span><div><strong>{t.never}</strong><small>{t.saved}</small></div></div>
      <div class="outcome called"><span class="branch" aria-hidden="true">↳</span><div><strong>{t.called}</strong><small>{t.compile}</small><em>{t.cost}</em></div></div>
    </div>
  </div>
</SkeinFigure>

<style>
  .diagram { display: grid; grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr); gap: 24px; color: var(--ink); }
  section { min-width: 0; }
  .kicker { margin-bottom: 18px; font: 600 10px/1.4 var(--font-mono); letter-spacing: .12em; color: var(--muted); }
  .source { position: relative; padding: 18px 18px 36px; border-top: 1px solid var(--ink-2); background: color-mix(in srgb, var(--paper) 94%, var(--ink)); }
  .code { display: flex; gap: 14px; align-items: baseline; padding: 5px 0; white-space: nowrap; }
  .code span { min-width: 18px; font: 10px var(--font-mono); color: var(--muted); }
  .code code { font: 12px/1.45 var(--font-mono); color: var(--ink); background: none; padding: 0; border: 0; }
  .code.focus { border-left: 1px solid var(--ink-2); margin-left: 7px; padding-left: 10px; }
  .code.focus span { margin-left: -18px; background: var(--paper); }
  .code i { font: 15px var(--font-mono); color: var(--ink-2); }
  .source-note { position: absolute; left: 18px; right: 18px; bottom: 12px; display: flex; gap: 8px; align-items: center; font: 10px var(--font-mono); color: var(--muted); }
  .marker { width: 18px; border-top: 1px solid var(--ink-2); }
  .connector { display: grid; place-items: center; color: var(--ink-2); font: 24px var(--font-mono); }
  .initial { padding-top: 18px; border-top: 1px solid var(--ink-2); }
  .mechanism { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; padding-bottom: 14px; border-bottom: 1px solid var(--hairline); }
  .mechanism strong { font: 600 13px var(--font-mono); }
  .mechanism span { font: 12px var(--font-body); color: var(--muted); }
  .facts { display: grid; gap: 0; }
  .facts div { display: flex; gap: 13px; align-items: baseline; padding: 10px 0; border-bottom: 1px solid var(--hairline); font: 13px/1.4 var(--font-body); }
  .facts span { font: 10px var(--font-mono); color: var(--muted); }
  .context { display: flex; gap: 10px; align-items: baseline; padding: 13px 0; font: 12px/1.4 var(--font-body); color: var(--ink-2); }
  .line { font: 16px var(--font-mono); }
  .outcomes { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 28px; margin-top: 4px; border-top: 1px solid var(--hairline-strong); padding-top: 18px; }
  .outcomes .kicker { grid-column: 1 / -1; margin: 0; }
  .outcome { display: flex; gap: 14px; padding: 10px 0 14px; border-bottom: 1px solid var(--hairline); }
  .branch { font: 18px var(--font-mono); color: var(--muted); }
  .outcome div { display: grid; gap: 7px; }
  .outcome strong { font: 600 13px var(--font-body); }
  .outcome small, .outcome em { font: 11px/1.45 var(--font-mono); color: var(--muted); }
  .outcome.called { border-bottom-color: var(--ink-2); }
  .outcome.called em { font-style: normal; color: var(--ink-2); }
  @media (max-width: 700px) {
    .diagram { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .connector { transform: rotate(90deg); }
    .outcomes { grid-column: auto; grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .outcomes .kicker { grid-column: auto; }
  }
</style>
