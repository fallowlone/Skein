---
import SkeinFigure from "./SkeinFigure.astro";

interface Props { lang?: "en" | "ru" }
const { lang = "en" } = Astro.props;
const t = {
  en: {
    category: "V8 · HEAP SPACES",
    title: "New space is disposable; survival decides where data lives",
    label: "Conceptual V8 heap layout. Bump-pointer allocation fills one semi-space of new space. When it fills, Scavenge copies survivors into the other semi-space or promotes them to old space; large, compiled, and immutable data live in separate spaces. Sizes and thresholds are illustrative.",
    thesis: "Allocate with one pointer bump; pay only for what survives.",
    caption: "Thresholds such as about 600 KB and new-space size vary by V8 version and flags. The discipline stays: cheap birth, paid retention.",
    birth: "01 / BIRTH · BUMP ALLOC IN FROM-SPACE",
    barNote: "fast path: check top + bytes, then top += bytes · full when top would pass limit",
    spaces: "02 / WHEN FULL · SCAVENGE COPIES SURVIVORS OUT",
    fromSpace: "FROM-SPACE · allocate here",
    toSpace: "TO-SPACE · empty reserve",
    tenured: "OLD SPACE · tenured survivors",
    pSurvive: "survived once — copied to to-space",
    pPromote: "survived twice — promoted to old space",
    pDead: "dead — abandoned in from-space, never touched",
    pHuge: "above about 600 KB — allocated in large-object space directly",
    pCode: "JIT code and immutable roots live apart; roots can be shared across isolates",
    layout: "03 / ONE OBJECT, IN ORDER",
    map: "MAP · offset 0",
    mapNote: "kind + layout",
    props: "properties ptr",
    elems: "elements ptr",
    slots: "in-object slots",
    slotsNote: "first properties inline · one load",
  },
  ru: {
    category: "V8 · ПРОСТРАНСТВА КУЧИ",
    title: "New space одноразовый; выживание решает, где жить данным",
    label: "Условная раскладка кучи V8. Bump-аллокация заполняет один semi-space в new space. Когда он заполняется, Scavenge копирует выживших в другой semi-space или продвигает в old space; большие, скомпилированные и неизменяемые данные живут в отдельных пространствах. Размеры и пороги условные.",
    thesis: "Аллоцируй одним сдвигом указателя; плати только за выжившее.",
    caption: "Пороги вроде около 600 KB и размер new space зависят от версии V8 и флагов. Дисциплина не меняется: дешёвое рождение, платное удержание.",
    birth: "01 / РОЖДЕНИЕ · СДВИГ-УКАЗАТЕЛЬ ВО FROM-SPACE",
    barNote: "быстрый путь: проверь top + bytes, затем top += bytes · полон, когда top пройдёт limit",
    spaces: "02 / ЗАПОЛНЕН · SCAVENGE ВЫВОЗИТ ВЫЖИВШИХ",
    fromSpace: "FROM-SPACE · аллокация здесь",
    toSpace: "TO-SPACE · пустой резерв",
    tenured: "OLD SPACE · долгожители",
    pSurvive: "пережил один раз — скопирован в to-space",
    pPromote: "пережил дважды — продвинут в old space",
    pDead: "мёртвые — брошены во from-space, их не трогают",
    pHuge: "выше около 600 KB — сразу в пространство больших объектов",
    pCode: "JIT-код и неизменяемые корни живут отдельно; корни можно делить между изолятами",
    layout: "03 / ОДИН ОБЪЕКТ, ПО ПОРЯДКУ",
    map: "MAP · смещение 0",
    mapNote: "вид + раскладка",
    props: "указатель свойств",
    elems: "указатель элементов",
    slots: "in-object слоты",
    slotsNote: "первые свойства внутри · одна загрузка",
  },
}[lang];
---

<SkeinFigure num="01" category={t.category} title={t.title} label={t.label} thesis={t.thesis} caption={t.caption} span="learning" variant="clean" hue="var(--ink-2)">
  <div class="drawing">
    <div class="birth">
      <strong>{t.birth}</strong>
      <div class="bar" aria-hidden="true">
        <div class="alloc"></div>
        <div class="alloc"></div>
        <div class="alloc"></div>
        <div class="alloc"></div>
        <div class="topmarker"><span>top</span></div>
        <div class="free"></div>
        <div class="limit"><span>limit</span></div>
      </div>
      <small>{t.barNote}</small>
    </div>
    <div class="spaces-label">{t.spaces}</div>
    <div class="scene" aria-hidden="true">
      <div class="plates">
        <div class="plate newspace"><span>BASE</span></div>
        <div class="object"><span>NEW SPACE</span><small>{t.fromSpace} / {t.toSpace}</small></div>
        <div class="plate old"><span>BASE</span></div>
        <div class="object lower"><span>{t.tenured}</span></div>
      </div>
    </div>
    <ol class="paths">
      <li><b>→</b><span>{t.pSurvive}</span></li>
      <li><b>→</b><span>{t.pPromote}</span></li>
      <li class="dead"><b>×</b><span>{t.pDead}</span></li>
      <li><b>→</b><span>{t.pHuge}</span></li>
      <li><b>→</b><span>{t.pCode}</span></li>
    </ol>
    <div class="layout">
      <strong>{t.layout}</strong>
      <div class="strip">
        <div class="cell map"><span>{t.map}</span><small>{t.mapNote}</small></div>
        <div class="cell"><span>{t.props}</span></div>
        <div class="cell"><span>{t.elems}</span></div>
        <div class="cell"><span>{t.slots}</span><small>{t.slotsNote}</small></div>
      </div>
    </div>
  </div>
</SkeinFigure>

<style>
  .drawing { --fig-accent: #a74a31; padding: 24px; background-color: var(--paper); background-image: linear-gradient(color-mix(in srgb, var(--ink) 3%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 3%, transparent) 1px, transparent 1px); background-size: 12px 12px; color: var(--ink); }
  .birth > strong, .spaces-label, .layout > strong { display: block; font: 600 10px/1.5 var(--font-mono); letter-spacing: .08em; color: var(--muted); }
  .birth small { display: block; margin-top: 8px; font: 11px/1.5 var(--font-body); color: var(--muted); }
  .bar { display: flex; align-items: stretch; height: 52px; margin-top: 12px; border: 1px solid var(--ink-2); background: var(--paper); }
  .alloc { flex: 1; min-width: 0; border-right: 1px solid var(--hairline-strong); background: color-mix(in srgb, var(--ink) 7%, var(--paper)); }
  .topmarker { display: grid; place-items: center; padding: 0 10px; border-right: 1px dashed var(--fig-accent); font: 600 11px var(--font-mono); color: var(--fig-accent); }
  .free { flex: 2; min-width: 0; }
  .limit { display: grid; place-items: center; padding: 0 10px; border-left: 1px solid var(--ink-2); font: 600 11px var(--font-mono); color: var(--ink-2); }
  .spaces-label { margin-top: 34px; }
  .scene { height: 210px; position: relative; overflow: hidden; }
  .plates { position: relative; height: 100%; }
  .plate { position: absolute; left: 6%; width: 60%; height: 62px; display: flex; align-items: end; padding: 0 18px 12px; border: 1px solid var(--ink-2); background: color-mix(in srgb, var(--paper) 90%, var(--ink)); box-shadow: 9px 9px 0 color-mix(in srgb, var(--ink) 8%, var(--paper)); transform: skewY(-7deg); box-sizing: border-box; font: 11px var(--font-mono); }
  .plate span { transform: skewY(7deg); }
  .plate.newspace { top: 46px; }
  .plate.old { top: 128px; }
  .object { position: absolute; left: 56%; top: 30px; width: 220px; min-height: 70px; display: grid; align-content: center; justify-items: center; gap: 4px; padding: 10px; border: 1px solid var(--fig-accent); background: var(--paper); box-shadow: 7px 7px 0 color-mix(in srgb, var(--fig-accent) 12%, var(--paper)); transform: skewY(-7deg); box-sizing: border-box; text-align: center; }
  .object.lower { top: 118px; }
  .object span, .object small { transform: skewY(7deg); }
  .object span { font: 600 10px/1.3 var(--font-mono); letter-spacing: .06em; color: var(--fig-accent); }
  .object small { font: 10px var(--font-mono); color: var(--ink-2); }
  .paths { list-style: none; margin: 18px 0 0; padding: 16px 0 0; border-top: 1px solid var(--hairline-strong); display: grid; gap: 8px; }
  .paths li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 8px; align-items: baseline; font: 13px/1.5 var(--font-body); color: var(--ink-2); }
  .paths b { font: 600 14px var(--font-mono); color: var(--fig-accent); }
  .paths li.dead b { color: var(--muted); }
  .layout { margin-top: 28px; border-top: 1px solid var(--hairline-strong); padding-top: 16px; }
  .strip { display: grid; grid-template-columns: 1.2fr 1fr 1fr 1.3fr; gap: 0; margin-top: 12px; border: 1px solid var(--ink-2); }
  .cell { min-width: 0; padding: 12px 10px; background: var(--paper); }
  .cell + .cell { border-left: 1px solid var(--hairline-strong); }
  .cell.map { border-left: 2px solid var(--fig-accent); }
  .cell span { display: block; font: 600 10px/1.4 var(--font-mono); letter-spacing: .05em; color: var(--ink); overflow-wrap: anywhere; }
  .cell small { display: block; margin-top: 4px; font: 11px/1.4 var(--font-body); color: var(--muted); }
  :global([data-theme='dark']) .drawing { --fig-accent: #e07855; }
  @media (max-width: 640px) {
    .drawing { padding: 18px 12px; }
    .bar { height: 48px; }
    .scene { height: 240px; }
    .plate { left: 3%; width: 78%; }
    .object { left: 30%; top: 36px; width: 62%; }
    .object.lower { top: 132px; }
    .strip { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .cell:nth-child(3) { border-left: 0; border-top: 1px solid var(--hairline-strong); }
    .cell:nth-child(4) { border-top: 1px solid var(--hairline-strong); }
  }
</style>
