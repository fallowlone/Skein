---
/**
 * CwndPhasesFig — Tier-B learning figure.
 *
 * The congestion-window phase machine: slow start doubles cwnd
 * per RTT until ssthresh, congestion avoidance grows it one MSS
 * per RTT, and loss cuts the window and restarts the cycle.
 * Growth rate is the mechanism; loss is the only brake.
 *
 * Server-rendered; the is:inline script replays the cycle.
 * Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "CONGESTION CONTROL",
    title: "The window grows, loss cuts it",
    label: "The congestion-window phase machine: slow start doubles cwnd each RTT until ssthresh, congestion avoidance then grows it one MSS per RTT, and loss reduces the window and restarts the cycle.",
    thesis: "Growth rate is the mechanism; loss is the only brake.",
    caption: "Initial window is 10 MSS. Slow start is exponential, congestion avoidance is linear — the switch point is ssthresh. Every loss event halves (or resets) the window and the phases resume.",
    scope: "RFC 5681 SHAPE",
    phases: "THE PHASE MACHINE",
    rule: "LOSS = BRAKE",
    phasesList: [
      { name: "initial", note: "cwnd = 10 MSS on first flight" },
      { name: "slow start", note: "×2 per RTT — exponential" },
      { name: "ssthresh", note: "switch point to linear growth" },
      { name: "congestion avoidance", note: "+1 MSS per RTT — linear" },
      { name: "loss", note: "reduce cwnd, cycle resumes" },
    ],
    flow: [
      { state: "iw10", log: "cwnd = 10 MSS" },
      { state: "doubling", log: "×2 per RTT" },
      { state: "threshold", log: "cwnd ≥ ssthresh" },
      { state: "linear", log: "+1 MSS / RTT" },
      { state: "loss event", log: "cwnd cut" },
      { state: "resumed", log: "cycle restarts ✓" },
    ],
    switch: "THE SWITCH — ssthresh",
    switchBody: "Below ssthresh the sender doubles; at or above it, one MSS per RTT. The threshold is what turns exponential hunger into linear caution.",
    brake: "LOSS IS THE ONLY SIGNAL",
    brakeBody: "Classic TCP infers congestion from loss alone — delay, jitter, and buffer occupancy are invisible. That is the limitation BBR was built to escape.",
  },
  ru: {
    category: "КОНТРОЛЬ ПЕРЕГРУЗКИ",
    title: "Окно растёт, потеря режет",
    label: "Конечный автомат фаз окна перегрузки: slow start удваивает cwnd каждый RTT до ssthresh, congestion avoidance растёт на один MSS за RTT, а потеря уменьшает окно и перезапускает цикл.",
    thesis: "Скорость роста — механизм; потеря — единственный тормоз.",
    caption: "Начальное окно — 10 MSS. Slow start экспоненциальный, congestion avoidance линеен — точка переключения ssthresh. Каждая потеря делит (или сбрасывает) окно, фазы возобновляются.",
    scope: "ФОРМА RFC 5681",
    phases: "КОНЕЧНЫЙ АВТОМАТ ФАЗ",
    rule: "ПОТЕРЯ = ТОРМОЗ",
    phasesList: [
      { name: "начальное", note: "cwnd = 10 MSS на первом полёте" },
      { name: "slow start", note: "×2 за RTT — экспонента" },
      { name: "ssthresh", note: "точка перехода к линейному росту" },
      { name: "congestion avoidance", note: "+1 MSS за RTT — линейно" },
      { name: "потеря", note: "уменьшить cwnd, цикл возобновляется" },
    ],
    flow: [
      { state: "iw10", log: "cwnd = 10 MSS" },
      { state: "удвоение", log: "×2 за RTT" },
      { state: "порог", log: "cwnd ≥ ssthresh" },
      { state: "линейный", log: "+1 MSS / RTT" },
      { state: "потеря", log: "cwnd срезан" },
      { state: "возобновлён", log: "цикл перезапущен ✓" },
    ],
    switch: "ПЕРЕКЛЮЧЕНИЕ — ssthresh",
    switchBody: "Ниже ssthresh отправитель удваивает; на пороге или выше — один MSS за RTT. Порог превращает экспоненциальный голод в линейную осторожность.",
    brake: "ПОТЕРЯ — ЕДИНСТВЕННЫЙ СИГНАЛ",
    brakeBody: "Классический TCP выводит перегрузку только из потерь — задержка, джиттер и заполнение буферов невидимы. Это ограничение, от которого создан BBR.",
  },
} as const;

const t = copy[lang];
const phasesList = t.phasesList;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="cpf" data-cpf>
    <div class="cpf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="cpf-head">
      <TechnicalLabel tone="muted" size="xs">{t.phases}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="cpf-phases">
      {phasesList.map((p, i) => (
        <li class="cpf-phase" data-cpf-phase={i}>
          <div class="cpf-phase-main">
            <MachineValue value={p.name} tone={i === 1 ? "accent" : i === 3 ? "accent" : i === 4 ? "danger" : undefined} />
          </div>
          <p class="cpf-phase-note">{p.note}</p>
        </li>
      ))}
    </ol>

    <ol class="cpf-flow">
      {flow.map((s, i) => (
        <li class="cpf-step" data-cpf-step={i} hidden={i !== 0}>
          <span class="cpf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 5 ? "ok" : i === 4 ? "danger" : undefined} />
        </li>
      ))}
    </ol>

    <p class="cpf-switch">
      <TechnicalLabel tone="muted" size="xs">{t.switch}</TechnicalLabel>
      {t.switchBody}
    </p>
    <p class="cpf-brake">
      <TechnicalLabel tone="warn" size="xs">{t.brake}</TechnicalLabel>
      {t.brakeBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: replay the congestion cycle.
  (() => {
    const roots = document.querySelectorAll("[data-cpf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-cpf-step]");
      const phases = root.querySelectorAll("[data-cpf-phase]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        phases.forEach((el, j) => {
          el.classList.toggle("cpf-phase-live", j === Math.min(n, phases.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .cpf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .cpf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .cpf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cpf-phases {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cpf-phase {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .cpf-phase-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cpf-phase-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .cpf-phase-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .cpf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cpf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .cpf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .cpf-switch,
  .cpf-brake {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .cpf-phases { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .cpf-phases { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cpf-phase {
      animation: cpf-phase-in var(--dur-2) var(--ease) both;
    }
    .cpf-phase:nth-child(2) { animation-delay: 70ms; }
    .cpf-phase:nth-child(3) { animation-delay: 140ms; }
    .cpf-phase:nth-child(4) { animation-delay: 210ms; }
    .cpf-phase:nth-child(5) { animation-delay: 280ms; }
    @keyframes cpf-phase-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
