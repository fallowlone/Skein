---
/**
 * PromiseStateListsFig — Tier-B learning figure.
 *
 * A promise is a state, a result, and two lists.
 * Pending holds fulfilled and rejected reaction
 * lists; settling fills the result, discards
 * the lists, and schedules one microtask job
 * per reaction — each carrying the downstream
 * promise it settles. Settle-once is the
 * load-bearing invariant.
 *
 * Server-rendered; the is:inline script settles
 * it. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "PROMISE INTERNALS",
    title: "A state, a result, and two lists",
    label: "Pending holds two reaction lists; settling fills the result, discards the lists, and schedules one microtask job per reaction — each carrying the downstream promise it settles.",
    thesis: "Pending collects handlers, settle fires them once.",
    caption: "State settles exactly once. Every ordering rule downstream depends on it: after leaving pending, no later resolve or reject can change the outcome or fire more reactions.",
    scope: "PROMISE MODEL",
    anatomy: "THE ANATOMY",
    settle: "SETTLE-ONCE",
    stages: [
      { name: "pending", note: "state + two reaction lists" },
      { name: "then registers", note: "reaction pushed to the matching list" },
      { name: "settle once", note: "result written, lists discarded" },
      { name: "enqueue jobs", note: "one microtask per reaction, FIFO" },
    ],
    flow: [
      { state: "pending", log: "state · 2 lists" },
      { state: "reaction", log: "then → list" },
      { state: "settled", log: "result · lists gone" },
      { state: "jobs", log: "reaction → job ✓" },
    ],
    invariant: "SETTLE-ONCE — THE LOAD-BEARING INVARIANT",
    invariantBody: "After leaving pending, no later resolve or reject can change the outcome or fire more reactions. Every ordering rule downstream depends on it.",
    capability: "CAPABILITY — WHY CHAINING WORKS",
    capabilityBody: "Each reaction carries the resolve and reject of the promise .then returned, so fulfilling upstream settles downstream exactly once.",
  },
  ru: {
    category: "ВНУТРЕННОСТИ ПРОМИСОВ",
    title: "Состояние, результат и два списка",
    label: "Pending держит два списка реакций; settle записывает результат, отбрасывает списки и планирует по одной микрозадаче на реакцию — каждая несёт downstream-промис, который она settle'ит.",
    thesis: "Pending собирает обработчики, settle срабатывает однажды.",
    caption: "Состояние settle'ится ровно один раз. Каждое правило порядка ниже зависит от этого: покинув pending, поздний resolve или reject не может изменить исход или вызвать новые реакции.",
    scope: "МОДЕЛЬ ПРОМИСОВ",
    anatomy: "АНАТОМИЯ",
    settle: "SETTLE-ОДИН РАЗ",
    stages: [
      { name: "pending", note: "состояние + два списка реакций" },
      { name: "then регистрирует", note: "реакция добавлена в свой список" },
      { name: "settle один раз", note: "результат записан, списки отброшены" },
      { name: "задачи в очередь", note: "по микрозадаче на реакцию, FIFO" },
    ],
    flow: [
      { state: "pending", log: "состояние · 2 списка" },
      { state: "реакция", log: "then → список" },
      { state: "settled", log: "результат · списков нет" },
      { state: "задачи", log: "реакция → job ✓" },
    ],
    invariant: "SETTLE-ОДИН РАЗ — НЕСУЩИЙ ИНВАРИАНТ",
    invariantBody: "Покинув pending, поздний resolve или reject не может изменить исход или вызвать новые реакции. Каждое правило порядка ниже зависит от этого.",
    capability: "CAPABILITY — ПОЧЕМУ РАБОТАЕТ ЦЕПОЧКА",
    capabilityBody: "Каждая реакция несёт resolve и reject промиса, который вернул .then, так что fulfilment вверх по цепи settle'ит вниз ровно один раз.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="psf" data-psf>
    <div class="psf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="psf-head">
      <TechnicalLabel tone="muted" size="xs">{t.anatomy}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.settle}</TechnicalLabel>
    </div>

    <ol class="psf-stages">
      {stages.map((s, i) => (
        <li class="psf-stage" data-psf-stage={i}>
          <div class="psf-stage-main">
            <MachineValue value={s.name} tone={i === 2 ? "ok" : undefined} />
          </div>
          <p class="psf-stage-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="psf-flow">
      {flow.map((s, i) => (
        <li class="psf-step" data-psf-step={i} hidden={i !== 0}>
          <span class="psf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="psf-invariant">
      <TechnicalLabel tone="ok" size="xs">{t.invariant}</TechnicalLabel>
      {t.invariantBody}
    </p>
    <p class="psf-capability">
      <TechnicalLabel tone="muted" size="xs">{t.capability}</TechnicalLabel>
      {t.capabilityBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: settle the promise.
  // Step 0 is server-rendered; the script replays the settle.
  (() => {
    const roots = document.querySelectorAll("[data-psf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-psf-step]");
      const stages = root.querySelectorAll("[data-psf-stage]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        stages.forEach((el, j) => {
          el.classList.toggle("psf-stage-live", j === Math.min(n, stages.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .psf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .psf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .psf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .psf-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .psf-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .psf-stage-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .psf-stage-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .psf-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .psf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .psf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .psf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .psf-invariant,
  .psf-capability {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .psf-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .psf-stages { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .psf-stage {
      animation: psf-stage-in var(--dur-2) var(--ease) both;
    }
    .psf-stage:nth-child(2) { animation-delay: 100ms; }
    .psf-stage:nth-child(3) { animation-delay: 200ms; }
    .psf-stage:nth-child(4) { animation-delay: 300ms; }
    @keyframes psf-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
