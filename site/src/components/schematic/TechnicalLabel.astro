---
/**
 * TechnicalLabel — Sans-serif labels for actors, headers, and protocol roles.
 *
 * Distinct from editorial prose (serif) and machine values (mono).
 * Follows the Skein schematic typography rules:
 *   SANS -> labels / UI / actor names / directions
 */
interface Props {
  as?: "span" | "div" | "p";
  size?: "xs" | "sm" | "md" | "lg";
  tone?: "muted" | "ink" | "accent" | "ok" | "warn" | "danger";
  tracking?: "normal" | "wide" | "wider";
  uppercase?: boolean;
  class?: string;
}

const {
  as: Tag = "span",
  size = "sm",
  tone = "ink",
  tracking = "wide",
  uppercase = true,
  class: className = "",
} = Astro.props;
---

<Tag
  class:list={[
    "sk-tech-label",
    `sk-tl-size-${size}`,
    `sk-tl-tone-${tone}`,
    `sk-tl-track-${tracking}`,
    { "sk-tl-upper": uppercase },
    className,
  ]}
>
  <slot />
</Tag>

<style>
  .sk-tech-label {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.25;
  }

  .sk-tl-upper {
    text-transform: uppercase;
  }

  /* Size scale */
  .sk-tl-size-xs {
    font-size: 10px;
  }
  .sk-tl-size-sm {
    font-size: 11.5px;
  }
  .sk-tl-size-md {
    font-size: 13px;
  }
  .sk-tl-size-lg {
    font-size: 15px;
  }

  /* Tracking scale */
  .sk-tl-track-normal {
    letter-spacing: normal;
  }
  .sk-tl-track-wide {
    letter-spacing: 0.08em;
  }
  .sk-tl-track-wider {
    letter-spacing: 0.16em;
  }

  /* Tone scale */
  .sk-tl-tone-muted {
    color: var(--muted);
  }
  .sk-tl-tone-ink {
    color: var(--ink);
  }
  .sk-tl-tone-accent {
    color: var(--d, var(--accent));
  }
  .sk-tl-tone-ok {
    color: var(--ok);
  }
  .sk-tl-tone-warn {
    color: var(--warn);
  }
  .sk-tl-tone-danger {
    color: var(--danger);
  }
</style>
