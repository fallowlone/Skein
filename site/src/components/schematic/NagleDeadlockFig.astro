---
/**
 * NagleDeadlockFig — Tier-B learning figure.
 *
 * The Nagle + delayed-ACK deadlock: Nagle holds CMD2 until CMD1
 * is ACKed while the server's delayed-ACK timer holds that ACK
 * for up to 40 ms — a 40 ms stall the application never asked
 * for. The escape is TCP_NODELAY or full-sized segments.
 *
 * Server-rendered; the is:inline script replays the timeline.
 * Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "PATHOLOGY",
    title: "Nagle meets delayed ACK — 40 ms stall",
    label: "The Nagle plus delayed-ACK deadlock: the client sends CMD1, Nagle then holds CMD2 waiting for an ACK while the server's delayed-ACK timer holds that ACK for up to 40 ms.",
    thesis: "Two innocent optimizations conspire into a 40 ms stall.",
    caption: "Nagle coalesces small writes; delayed ACK waits for a second segment before acknowledging. Back-to-back small writes hit both at once. The fix is TCP_NODELAY — or writes sized to a full MSS.",
    scope: "RFC 896 × RFC 1122",
    actors: "TWO ACTORS, ONE TIMER",
    rule: "40 MS UNINVITED",
    timeline: [
      { state: "write(CMD1)", log: "client → server, sent at once" },
      { state: "Nagle holds", log: "CMD2 waits: CMD1 unACKed" },
      { state: "timer holds", log: "server ACK ≤ 40 ms" },
      { state: "ACK fires", log: "CMD2 released" },
      { state: "stall over", log: "40 ms recovered ✓" },
    ],
    deadlock: "THE DEADLOCK",
    deadlockBody: "Nagle's rule: while a small segment is unacknowledged, send no more small segments. Delayed ACK: acknowledge every second segment, or the first after 40 ms. CMD2 satisfies both conditions at once.",
    escape: "THE ESCAPE — TCP_NODELAY",
    escapeBody: "Disabling Nagle (TCP_NODELAY) makes every write go out immediately. The cost is more small packets; the gain is latency the application controls, not the timers'.",
  },
  ru: {
    category: "ПАТОЛОГИЯ",
    title: "Nagle встречает delayed ACK — остановка 40 мс",
    label: "Deadlock Nagle + delayed ACK: клиент отправляет CMD1, затем Nagle держит CMD2 в ожидании ACK, пока таймер delayed-ACK сервера держит тот ACK до 40 мс.",
    thesis: "Две невинные оптимизации сговорились в 40-миллисекундную остановку.",
    caption: "Nagle склеивает мелкие записи; delayed ACK ждёт второго сегмента перед подтверждением. Мелкие записи подряд попадают в оба условия. Лечение — TCP_NODELAY или записи размером с полный MSS.",
    scope: "RFC 896 × RFC 1122",
    actors: "ДВА АКТОРА, ОДИН ТАЙМЕР",
    rule: "40 МС НЕ ПРИГЛАШАЛИ",
    timeline: [
      { state: "write(CMD1)", log: "клиент → сервер, отправлен сразу" },
      { state: "Nagle держит", log: "CMD2 ждёт: CMD1 без ACK" },
      { state: "таймер держит", log: "ACK сервера ≤ 40 мс" },
      { state: "ACK сработал", log: "CMD2 отпущен" },
      { state: "остановка кончилась", log: "40 мс возвращены ✓" },
    ],
    deadlock: "DEADLOCK",
    deadlockBody: "Правило Nagle: пока маленький сегмент не подтверждён, новых маленьких не посылать. Delayed ACK: подтверждать каждый второй сегмент или первый через 40 мс. CMD2 удовлетворяет обоим условиям разом.",
    escape: "ВЫХОД — TCP_NODELAY",
    escapeBody: "Отключение Nagle (TCP_NODELAY) отправляет каждую запись немедленно. Цена — больше маленьких пакетов; выигрыш — задержкой управляет приложение, а не таймеры.",
  },
} as const;

const t = copy[lang];
const timeline = t.timeline;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="ndf" data-ndf>
    <div class="ndf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="ndf-head">
      <TechnicalLabel tone="muted" size="xs">{t.actors}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="ndf-timeline">
      {timeline.map((s, i) => (
        <li class="ndf-step" data-ndf-step={i} hidden={i !== 0}>
          <span class="ndf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 4 ? "ok" : i === 2 || i === 1 ? "warn" : undefined} />
        </li>
      ))}
    </ol>

    <p class="ndf-deadlock">
      <TechnicalLabel tone="warn" size="xs">{t.deadlock}</TechnicalLabel>
      {t.deadlockBody}
    </p>
    <p class="ndf-escape">
      <TechnicalLabel tone="ok" size="xs">{t.escape}</TechnicalLabel>
      {t.escapeBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: replay the stall.
  (() => {
    const roots = document.querySelectorAll("[data-ndf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-ndf-step]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .ndf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .ndf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .ndf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ndf-timeline {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ndf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 10px 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
  }

  .ndf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .ndf-deadlock,
  .ndf-escape {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .ndf-step { flex-direction: column; align-items: flex-start; gap: 4px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ndf-step {
      animation: ndf-step-in var(--dur-2) var(--ease) both;
    }
    .ndf-step:nth-child(2) { animation-delay: 70ms; }
    .ndf-step:nth-child(3) { animation-delay: 140ms; }
    .ndf-step:nth-child(4) { animation-delay: 210ms; }
    .ndf-step:nth-child(5) { animation-delay: 280ms; }
    @keyframes ndf-step-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
