---
/**
 * ShapeDisciplineFig — Tier-B learning figure.
 *
 * Six habits keep the speculation alive: fixed
 * construction order (one transition path),
 * no delete — null instead (no dictionary
 * mode), one element kind (PACKED_SMI kept),
 * uniform arguments and stable callees
 * (monomorphic sites), bounded integers
 * (guards keep passing). Each break costs a
 * known fast path.
 *
 * Server-rendered; the is:inline script walks
 * the discipline. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "SHAPE DISCIPLINE",
    title: "Six habits keep the speculation alive",
    label: "Each rule pairs the habit that holds a fast path with the anti-pattern that breaks its mechanism: fixed construction order, no delete, one element kind, uniform arguments, bounded Smis, stable dispatch.",
    thesis: "Never surprise the optimiser.",
    caption: "Shape transitions, dictionary mode, element kinds, IC states, and Smi range are all mechanisms you have already read. Here they are habits — each break costs a known fast path.",
    scope: "V8 DISCIPLINE",
    habits: "THE DISCIPLINE",
    rule: "EVERY RULE HAS A MECHANISM",
    habitsList: [
      { name: "fixed order", note: "same transition path — one shape" },
      { name: "no delete", note: "null instead — fast properties, no dict mode" },
      { name: "one kind", note: "PACKED_SMI preserved — raw loads stay legal" },
      { name: "stable sites", note: "same shapes + callees — monomorphic" },
      { name: "bounded ints", note: "stay Smi — guards keep passing" },
    ],
    flow: [
      { state: "one shape", log: "constant field order" },
      { state: "still fast", log: "no dict mode" },
      { state: "one kind", log: "PACKED_SMI" },
      { state: "mono site", log: "same shapes + callees" },
      { state: "guards pass", log: "no Smi overflow ✓" },
    ],
    checklist: "CHECKLIST — EVERY RULE HAS A MECHANISM",
    checklistBody: "Shape transitions, dictionary mode, element kinds, IC states, and Smi range are all lessons you already read. Here they are habits.",
    widening: "ARRAY WIDTH — ONE-WAY WIDENING",
    wideningBody: "Mixing a double into a Smi array widens it to PACKED_DOUBLE permanently. Values never narrow back — pick the kind at construction.",
  },
  ru: {
    category: "ДИСЦИПЛИНА ФОРМ",
    title: "Шесть привычек держат спекуляцию живой",
    label: "Каждое правило соединяет привычку, удерживающую быстрый путь, с антипаттерном, ломающим его механизм: фиксированный порядок конструирования, никакого delete, один элемент-kind, однородные аргументы, ограниченные Smi, стабильный dispatch.",
    thesis: "Никогда не удивляйте оптимизатор.",
    caption: "Переходы форм, dictionary mode, element kinds, состояния IC и диапазон Smi — механизмы, уже прочитанные вами. Здесь они привычки — каждый сбой стоит известного быстрого пути.",
    scope: "ДИСЦИПЛИНА V8",
    habits: "ДИСЦИПЛИНА",
    rule: "У КАЖДОГО ПРАВИЛА ЕСТЬ МЕХАНИЗМ",
    habitsList: [
      { name: "фиксированный порядок", note: "тот же путь перехода — одна форма" },
      { name: "без delete", note: "вместо null — быстрые свойства, без dict mode" },
      { name: "один kind", note: "PACKED_SMI сохранён — сырые загрузки законны" },
      { name: "стабильные сайты", note: "те же shapes + callees — monomorphic" },
      { name: "ограниченные int", note: "остаются Smi — guards проходят" },
    ],
    flow: [
      { state: "одна форма", log: "постоянный порядок полей" },
      { state: "всё ещё быстро", log: "нет dict mode" },
      { state: "один kind", log: "PACKED_SMI" },
      { state: "mono сайт", log: "те же shapes + callees" },
      { state: "guards проходят", log: "нет переполнения Smi ✓" },
    ],
    checklist: "ЧЕКЛИСТ — У КАЖДОГО ПРАВИЛА ЕСТЬ МЕХАНИЗМ",
    checklistBody: "Переходы форм, dictionary mode, element kinds, состояния IC и диапазон Smi — это уроки, уже прочитанные вами. Здесь они привычки.",
    widening: "ШИРИНА МАССИВА — РАСШИРЕНИЕ В ОДНУ СТОРОНУ",
    wideningBody: "Смешивание double в Smi-массив расширяет его до PACKED_DOUBLE навсегда. Значения уже не сужаются — выбирайте kind при конструировании.",
  },
} as const;

const t = copy[lang];
const habitsList = t.habitsList;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="sdf" data-sdf>
    <div class="sdf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="sdf-head">
      <TechnicalLabel tone="muted" size="xs">{t.habits}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="sdf-habits">
      {habitsList.map((h, i) => (
        <li class="sdf-habit" data-sdf-habit={i}>
          <div class="sdf-habit-main">
            <MachineValue value={h.name} tone={i === 0 ? "accent" : undefined} />
          </div>
          <p class="sdf-habit-note">{h.note}</p>
        </li>
      ))}
    </ol>

    <ol class="sdf-flow">
      {flow.map((s, i) => (
        <li class="sdf-step" data-sdf-step={i} hidden={i !== 0}>
          <span class="sdf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 4 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="sdf-checklist">
      <TechnicalLabel tone="muted" size="xs">{t.checklist}</TechnicalLabel>
      {t.checklistBody}
    </p>
    <p class="sdf-widening">
      <TechnicalLabel tone="warn" size="xs">{t.widening}</TechnicalLabel>
      {t.wideningBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the discipline.
  // Step 0 is server-rendered; the script replays the five habits.
  (() => {
    const roots = document.querySelectorAll("[data-sdf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-sdf-step]");
      const habits = root.querySelectorAll("[data-sdf-habit]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        habits.forEach((el, j) => {
          el.classList.toggle("sdf-habit-live", j === Math.min(n, habits.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .sdf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .sdf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .sdf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .sdf-habits {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sdf-habit {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .sdf-habit-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .sdf-habit-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .sdf-habit-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .sdf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sdf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .sdf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .sdf-checklist,
  .sdf-widening {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .sdf-habits { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .sdf-habits { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sdf-habit {
      animation: sdf-habit-in var(--dur-2) var(--ease) both;
    }
    .sdf-habit:nth-child(2) { animation-delay: 80ms; }
    .sdf-habit:nth-child(3) { animation-delay: 160ms; }
    .sdf-habit:nth-child(4) { animation-delay: 240ms; }
    .sdf-habit:nth-child(5) { animation-delay: 320ms; }
    @keyframes sdf-habit-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
