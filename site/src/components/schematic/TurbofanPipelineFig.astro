---
/**
 * TurbofanPipelineFig — Tier-B learning figure.
 *
 * TurboFan's front-to-back pipeline: bytecode + feedback enter
 * as a sea-of-nodes graph; the front phases (parse to graph,
 * type, lower) reason abstractly; the middle phases rewrite
 * (inlining, escape analysis); the back phases commit to the
 * machine (schedule, instruction selection, register
 * allocation). Pure computation floats until scheduling pins it.
 *
 * Server-rendered; the is:inline script walks the phases.
 * Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "TURBOFAN PIPELINE",
    title: "From bytecode to native, one pass at a time",
    label: "TurboFan turns bytecode plus feedback into a sea-of-nodes graph, types and lowers it, rewrites it with inlining and escape analysis, then schedules, selects instructions, and allocates registers.",
    thesis: "TurboFan reasons about a graph abstractly up front and commits to the machine late.",
    caption: "The front phases never see a machine: they build and rewrite a graph where every value is a node and every dependency is an edge. Only the back phases pick instructions and registers — which is why pure computation floats until scheduling pins it where it is cheapest.",
    scope: "V8-SPECIFIC MODEL",
    phasesHead: "FRONT → MIDDLE → BACK",
    groups: "THREE PHASE GROUPS",
    phases: [
      { group: "front", name: "graph", out: "bytecode → sea of nodes", note: "every value a node, every dependency an edge" },
      { group: "front", name: "type + lower", out: "typed, lowered graph", note: "types flow through the graph; high-level ops become low-level" },
      { group: "middle", name: "rewrite", out: "inlining · escape analysis", note: "calls folded in, non-escaping objects scalar-replaced" },
      { group: "back", name: "schedule", out: "machine commitment", note: "instruction selection + register allocation pin the graph to silicon" },
    ],
    front: "FRONT — REASON ABSTRACTLY",
    frontBody: "Graph construction, typing, and lowering never see a register. Optimisation decisions here are machine-independent — the same rewrite applies to any target.",
    back: "BACK — COMMIT LATE",
    backBody: "Scheduling decides where each node lands in instruction order. Pure computation floats until this phase pins it — that is why hoisting and redundancy elimination pay off.",
  },
  ru: {
    category: "КОНВЕЙЕР TURBOFAN",
    title: "От bytecode к native — по одному проходу",
    label: "TurboFan превращает bytecode плюс feedback в sea-of-nodes граф, типизирует и понижает его, переписывает с inlining'ом и escape analysis, затем планирует, выбирает инструкции и распределяет регистры.",
    thesis: "TurboFan рассуждает о графе абстрактно в начале и коммитит к машине поздно.",
    caption: "Фронтальные фазы никогда не видят машину: они строят и переписывают граф, где каждое значение — узел, а каждая зависимость — ребро. Только задние фазы выбирают инструкции и регистры — поэтому чистые вычисления плавают, пока scheduling не закрепит их там, где дешевле всего.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    phasesHead: "ФРОНТ → СЕРЕДИНА → ЗАДНИК",
    groups: "ТРИ ГРУППЫ ФАЗ",
    phases: [
      { group: "front", name: "graph", out: "bytecode → sea of nodes", note: "каждое значение — узел, каждая зависимость — ребро" },
      { group: "front", name: "type + lower", out: "типизированный пониженный граф", note: "типы текут через граф; высокоуровневые ops становятся низкоуровневыми" },
      { group: "middle", name: "rewrite", out: "inlining · escape analysis", note: "вызовы сворачиваются внутрь, не escaping объекты заменяются скалярами" },
      { group: "back", name: "schedule", out: "коммит к машине", note: "instruction selection + register allocation закрепляют граф на кремнии" },
    ],
    front: "ФРОНТ — РАССУЖДАЙ АБСТРАКТНО",
    frontBody: "Построение графа, типизация и понижение никогда не видят регистр. Решения оптимизации здесь не зависят от машины — та же перезапись применима к любой цели.",
    back: "ЗАДНИК — КОММТЬТИ ПОЗДНО",
    backBody: "Scheduling решает, где каждый узел окажется в порядке инструкций. Чистые вычисления плавают, пока эта фаза не закрепит их — поэтому hoisting и elimination избыточности окупаются.",
  },
} as const;

const t = copy[lang];
const phases = t.phases;
const groupTone = { front: "accent", middle: "warn", back: "ok" } as const;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="tfp" data-tfp>
    <div class="tfp-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="tfp-head">
      <TechnicalLabel tone="muted" size="xs">{t.phasesHead}</TechnicalLabel>
      <TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.groups}</TechnicalLabel>
    </div>

    <ol class="tfp-phases">
      {phases.map((p, i) => (
        <li class="tfp-phase" data-tfp-phase={i}>
          <div class="tfp-phase-head">
            <TechnicalLabel tone={groupTone[p.group]} size="xs">{p.group}</TechnicalLabel>
            <MachineValue value={p.name} tone={groupTone[p.group]} />
            <MachineValue value={p.out} />
          </div>
          <p class="tfp-note">{p.note}</p>
        </li>
      ))}
    </ol>

    <p class="tfp-front">
      <TechnicalLabel tone="accent" size="xs">{t.front}</TechnicalLabel>
      {t.frontBody}
    </p>
    <p class="tfp-back">
      <TechnicalLabel tone="ok" size="xs">{t.back}</TechnicalLabel>
      {t.backBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the pipeline phases.
  // All phases are server-rendered — no-JS readers see the whole pipeline.
  (() => {
    const roots = document.querySelectorAll("[data-tfp]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const phases = root.querySelectorAll("[data-tfp-phase]");
      if (!phases.length) continue;
      if (reduceMotion) {
        phases.forEach((el) => el.classList.add("tfp-phase-live"));
        continue;
      }
      let n = 0;
      const show = (k) => {
        phases.forEach((el, j) => {
          el.classList.toggle("tfp-phase-live", j === k);
          el.classList.toggle("tfp-phase-done", j < k);
        });
      };
      show(0);
      setInterval(() => {
        n = (n + 1) % (phases.length + 1);
        show(n);
      }, 2400);
    }
  })();
</script>

<style>
  .tfp {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .tfp-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .tfp-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tfp-phases {
    display: grid;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tfp-phase {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-left-width: 2px;
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .tfp-phase-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tfp-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .tfp-phase-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }
  .tfp-phase-done { border-color: var(--hairline-strong); }

  .tfp-front,
  .tfp-back {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tfp-phase {
      animation: tfp-phase-in var(--dur-2) var(--ease) both;
    }
    .tfp-phase:nth-child(2) { animation-delay: 120ms; }
    .tfp-phase:nth-child(3) { animation-delay: 240ms; }
    .tfp-phase:nth-child(4) { animation-delay: 360ms; }
    @keyframes tfp-phase-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
