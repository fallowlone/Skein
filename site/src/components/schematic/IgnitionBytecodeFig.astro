---
import SkeinFigure from "./SkeinFigure.astro";

interface Props { lang?: "en" | "ru" }
const { lang = "en" } = Astro.props;
const t = {
  en: {
    category: "IGNITION · REGISTER MACHINE",
    title: "One accumulator carries the result; one slot remembers the types",
    label: "Trace of add(1, 2): argument registers a0 and a1 hold 1 and 2. Ldar a1 loads 2 into the accumulator. Add a0, feedback slot 0, computes 1 plus 2 and records Smi feedback during that instruction. Return yields 3.",
    thesis: "The value flows forward; the type observation stays behind.",
    caption: "Illustrative trace of V8 bytecode for add(a, b). Bytecode operands and offsets can vary by V8 version.",
    frame: "CALL FRAME · add(1, 2)",
    sequence: "BYTECODE STREAM",
    before: "ACC BEFORE",
    after: "ACC AFTER",
    effect: "SIDE EFFECT",
    load: "load b",
    sum: "a + acc",
    return: "return acc",
    none: "—",
    record: "slot 0 ← Smi operands",
    feedback: "FEEDBACK VECTOR",
    note: "Once the feedback vector is allocated, Add updates this slot as it executes. The slot is not another bytecode; the JIT can read it later.",
  },
  ru: {
    category: "IGNITION · РЕГИСТРОВАЯ МАШИНА",
    title: "Аккумулятор несёт результат, слот запоминает типы",
    label: "Трассировка add(1, 2): регистры аргументов a0 и a1 хранят 1 и 2. Ldar a1 загружает 2 в аккумулятор. Add a0 со слотом обратной связи 0 вычисляет 1 плюс 2 и во время той же инструкции записывает сведения о типах Smi. Return возвращает 3.",
    thesis: "Значение идёт дальше; наблюдение о типах остаётся.",
    caption: "Упрощённая трассировка байт-кода V8 для add(a, b). Операнды и смещения могут отличаться между версиями V8.",
    frame: "ФРЕЙМ ВЫЗОВА · add(1, 2)",
    sequence: "ПОТОК БАЙТ-КОДА",
    before: "ACC ДО",
    after: "ACC ПОСЛЕ",
    effect: "ПОБОЧНЫЙ ЭФФЕКТ",
    load: "загрузить b",
    sum: "a + acc",
    return: "вернуть acc",
    none: "—",
    record: "слот 0 ← операнды Smi",
    feedback: "FEEDBACK VECTOR",
    note: "После выделения вектора Add обновляет этот слот во время исполнения. Слот не является отдельным байт-кодом; позже JIT может его прочитать.",
  },
}[lang];
const rows = [
  { op: "Ldar a1", action: t.load, before: "?", after: "2", effect: t.none },
  { op: "Add a0, [0]", action: t.sum, before: "2", after: "3", effect: t.record },
  { op: "Return", action: t.return, before: "3", after: "3", effect: t.none },
];
---

<SkeinFigure num="01" category={t.category} title={t.title} label={t.label} thesis={t.thesis} caption={t.caption} span="canvas">
  <div class="bytecode-figure">
    <div class="registers">
      <span class="eyebrow">{t.frame}</span>
      <div class="register-bank"><span><b>a0</b><code>1</code></span><span><b>a1</b><code>2</code></span></div>
    </div>
    <div class="stream">
      <span class="eyebrow">{t.sequence}</span>
      <div class="column-head" aria-hidden="true"><span></span><span>{t.before}</span><span>{t.after}</span><span>{t.effect}</span></div>
      <ol>
        {rows.map((row, index) => <li class:list={{ add: index === 1 }}>
          <div class="instruction"><span class="index">0{index + 1}</span><code>{row.op}</code><small>{row.action}</small></div>
          <div class="value" data-label={t.before}><code>{row.before}</code></div>
          <div class="value result" data-label={t.after}><code>{row.after}</code></div>
          <div class="effect" data-label={t.effect}>{row.effect}</div>
        </li>)}
      </ol>
    </div>
    <div class="feedback"><span class="eyebrow">{t.feedback}</span><code>[0]  Smi</code><div class="feedback-note">{t.note}</div></div>
  </div>
</SkeinFigure>

<style>
  .bytecode-figure { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .eyebrow { display: block; font: 600 10px/1.4 var(--font-mono); letter-spacing: .12em; color: var(--muted); }
  .registers { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .register-bank { display: flex; gap: 8px; }
  .register-bank span { display: flex; align-items: center; gap: 14px; padding: 7px 11px; border: 1px solid var(--hairline-strong); background: var(--paper); }
  .register-bank b { font: 600 11px var(--font-mono); color: var(--muted); }
  .register-bank code, .value code, .feedback code { font: 600 15px var(--font-mono); color: var(--ink); }
  .stream { border-top: 1px solid var(--hairline-strong); padding-top: 16px; }
  .column-head, li { display: grid; grid-template-columns: minmax(180px, 1.4fr) minmax(70px, .5fr) minmax(70px, .5fr) minmax(160px, 1fr); gap: 16px; align-items: center; }
  .column-head { margin: 12px 0 8px; font: 600 10px var(--font-mono); color: var(--muted); letter-spacing: .08em; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { min-height: 70px; padding: 9px 12px; border-top: 1px solid var(--hairline); }
  li.add { background: color-mix(in srgb, var(--accent) 7%, var(--paper)); border-left: 2px solid var(--accent); }
  .instruction { display: grid; grid-template-columns: 24px 1fr; gap: 2px 10px; }
  .instruction code { font: 600 14px var(--font-mono); color: var(--ink); white-space: nowrap; }
  .instruction small { grid-column: 2; font: 12px var(--font-body); color: var(--muted); }
  .index { grid-row: span 2; font: 11px var(--font-mono); color: var(--accent); }
  .result code { color: var(--accent); }
  .effect { font: 11px/1.5 var(--font-mono); color: var(--ink-2); }
  .feedback { display: flex; align-items: baseline; gap: 16px; border-top: 1px solid var(--hairline-strong); padding-top: 16px; }
  .feedback code { white-space: nowrap; color: var(--accent); }
  .feedback-note { max-width: 54ch; margin-left: auto; font: 12px/1.5 var(--font-body); color: var(--muted); }
  @media (max-width: 700px) {
    .column-head { display: none; }
    li { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 14px; padding: 14px 8px; }
    .instruction { grid-column: 1 / -1; }
    .value::before, .effect::before { content: attr(data-label); display: block; margin-bottom: 2px; font: 600 9px var(--font-mono); letter-spacing: .06em; color: var(--muted); }
    .effect { grid-column: 1 / -1; }
    .feedback { display: grid; gap: 8px; }
    .feedback-note { margin: 0; }
  }
  @media (max-width: 390px) { .registers { align-items: flex-start; flex-direction: column; } }
</style>
