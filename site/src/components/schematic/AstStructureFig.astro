---
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "SOURCE STRUCTURE",
    title: "A flat token stream becomes a nested syntax tree",
    label:
      "Source const x equals 42 is scanned into five tokens, then parsed into a conceptual tree connecting the declaration, binding, and initializer before bytecode generation.",
    thesis: "Tokens preserve sequence; the AST adds grammatical structure.",
    caption:
      "The parser does not merely relabel tokens. It establishes parent-child relationships between a declaration, its binding, and its initializer. This is a simplified syntax tree, not a dump of V8 node names.",
    source: "SOURCE",
    tokens: "TOKENS",
    tree: "AST · STRUCTURE",
    scan: "scan",
    parse: "parse",
    consequence: "structure recovered",
  },
  ru: {
    category: "СТРУКТУРА ИСХОДНИКА",
    title: "Плоский поток токенов становится вложенным синтаксическим деревом",
    label:
      "Исходник const x равно 42 сканируется в пять токенов, затем парсится в условное дерево, связывающее объявление, имя и начальное значение перед генерацией байт-кода.",
    thesis: "Токены сохраняют порядок; AST добавляет грамматическую структуру.",
    caption:
      "Парсер не просто переименовывает токены. Он связывает объявление, имя переменной и начальное значение. Это упрощённая схема синтаксиса, а не точные имена узлов V8.",
    source: "ИСХОДНИК",
    tokens: "ТОКЕНЫ",
    tree: "AST · СТРУКТУРА",
    scan: "сканирование",
    parse: "парсинг",
    consequence: "структура восстановлена",
  },
} as const;

const t = copy[lang];
---

<SkeinFigure
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
  variant="canvas"
>
  <div class="ast-flow">
    <section class="ast-source">
      <TechnicalLabel tone="muted" size="xs">{t.source}</TechnicalLabel>
      <pre><code><span>const</span> x = 42;</code></pre>
    </section>

    <div class="ast-arrow" aria-hidden="true">
      <span>→</span>
      <TechnicalLabel tone="accent" size="xs">{t.scan}</TechnicalLabel>
    </div>

    <section class="ast-tokens">
      <TechnicalLabel tone="muted" size="xs">{t.tokens}</TechnicalLabel>
      <div class="token-row">
        <MachineValue value="Keyword(const)" size="sm" />
        <MachineValue value="Identifier(x)" size="sm" />
        <MachineValue value="=" size="sm" />
        <MachineValue value="Number(42)" size="sm" />
        <MachineValue value=";" size="sm" />
      </div>
    </section>

    <div class="ast-arrow" aria-hidden="true">
      <span>→</span>
      <TechnicalLabel tone="accent" size="xs">{t.parse}</TechnicalLabel>
    </div>

    <section class="ast-tree">
      <TechnicalLabel tone="muted" size="xs">{t.tree}</TechnicalLabel>
      <div class="tree" aria-hidden="true">
        <div class="tree-node root"><code>declaration</code></div>
        <div class="tree-stem"></div>
        <div class="tree-node"><code>const binding</code></div>
        <div class="tree-fork"></div>
        <div class="tree-leaves">
          <div class="tree-node leaf"><code>name</code><small>x</small></div>
          <div class="tree-node leaf"><code>initializer</code><small>42</small></div>
        </div>
      </div>
      <TechnicalLabel tone="ok" size="xs">{t.consequence}</TechnicalLabel>
    </section>
  </div>
</SkeinFigure>

<style>
  .ast-flow {
    display: grid;
    grid-template-columns: minmax(130px, 0.8fr) auto minmax(220px, 1.25fr) auto minmax(260px, 1.35fr);
    gap: 18px;
    align-items: center;
    min-width: 760px;
  }

  section {
    min-width: 0;
  }

  .ast-source,
  .ast-tokens,
  .ast-tree {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  pre {
    margin: 0;
    padding: 16px;
    border-top: 0.5px solid var(--hairline-2);
    border-bottom: 0.5px solid var(--hairline-2);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.5;
    background: color-mix(in srgb, var(--card) 72%, transparent);
  }

  pre span {
    color: var(--d, var(--accent));
  }

  .token-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ast-arrow {
    display: grid;
    place-items: center;
    gap: 4px;
    color: var(--d, var(--accent));
  }

  .ast-arrow > span {
    font-family: var(--font-mono);
    font-size: 24px;
    line-height: 1;
  }

  .tree {
    display: grid;
    justify-items: center;
  }

  .tree-node {
    min-width: 164px;
    padding: 8px 10px;
    border: 0.5px solid var(--hairline-strong);
    background: var(--paper);
    text-align: center;
  }

  .tree-node code {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink);
  }

  .tree-node small {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--d, var(--accent));
  }

  .tree-node.root {
    border-color: color-mix(in srgb, var(--d, var(--accent)) 48%, var(--hairline));
  }

  .tree-stem {
    width: 0.5px;
    height: 16px;
    background: var(--hairline-strong);
  }

  .tree-fork {
    width: 58%;
    height: 18px;
    border-top: 0.5px solid var(--hairline-strong);
    border-left: 0.5px solid var(--hairline-strong);
    border-right: 0.5px solid var(--hairline-strong);
  }

  .tree-leaves {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .tree-node.leaf {
    min-width: 0;
  }

  @media (max-width: 860px) {
    .ast-flow {
      min-width: 700px;
      gap: 12px;
    }
  }

  @media (max-width: 640px) {
    .ast-flow { grid-template-columns: minmax(0, 1fr); min-width: 0; gap: 14px; }
    .ast-arrow > span { transform: rotate(90deg); }
    .token-row :global(.sk-mv) { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
  }
</style>
