---
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "MAP GENERALIZATION",
    title: "When widening deprecates a shape, instances migrate later",
    label:
      "One V8-specific field representation path: objects share Map M1 with temp stored as Smi, a float assignment creates a live Double Map M2 and deprecates M1, while existing objects keep M1 until a later access migrates them.",
    thesis: "The Map changes globally, but object migration is paid locally and lazily.",
    caption:
      "V8 does not maintain a list of every object using M1, so it cannot rewrite all instances eagerly. The new representation becomes authoritative in M2; stale objects are repaired individually when a slow path notices the deprecated Map.",
    scope: "V8-SPECIFIC MODEL",
    before: "BEFORE · SHARED NARROW MAP",
    widen: "ONE STORE · WIDEN REPRESENTATION",
    after: "AFTER · LAZY INSTANCE MIGRATION",
    shared: "objects share M1",
    store: "obj.temp=98.6",
    deprecated: "M1 deprecated",
    migrate: "later access",
    repaired: "instance now points to M2",
  },
  ru: {
    category: "ОБОБЩЕНИЕ MAP",
    title: "Если расширение устаревает форму, экземпляры мигрируют позже",
    label:
      "Один из V8-специфичных путей обобщения поля: множество объектов разделяют Map M1 с temp как Smi, присваивание float создаёт живой Double Map M2 и помечает M1 deprecated, а существующие объекты сохраняют M1 до последующего доступа, который их мигрирует.",
    thesis: "Map меняется глобально, но цена миграции объектов платится локально и лениво.",
    caption:
      "V8 не хранит список всех объектов с M1, поэтому не может переписать их сразу. Новое representation становится актуальным в M2; устаревшие объекты чинятся по одному, когда slow path замечает deprecated Map.",
    scope: "V8-СПЕЦИФИЧНАЯ МОДЕЛЬ",
    before: "ДО · ОБЩИЙ УЗКИЙ MAP",
    widen: "ОДИН STORE · РАСШИРЕНИЕ REPRESENTATION",
    after: "ПОСЛЕ · ЛЕНИВАЯ МИГРАЦИЯ",
    shared: "объекты разделяют M1",
    store: "obj.temp=98.6",
    deprecated: "M1 deprecated",
    migrate: "следующее обращение",
    repaired: "экземпляр теперь указывает на M2",
  },
} as const;

const t = copy[lang];
---

<SkeinFigure
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="canvas"
  variant="clean"
>
  <div class="migration">
    <div class="migration-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <section>
      <TechnicalLabel tone="muted" size="xs">{t.before}</TechnicalLabel>
      <div class="map-line">
        <MachineValue name="map" value="M1" tone="accent" />
        <MachineValue name="temp" value="Smi" />
      </div>
      <p>{t.shared}</p>
      <div class="objects" aria-hidden="true"><span>a</span><span>b</span><span>c</span><span>…</span></div>
    </section>

    <div class="migration-arrow">
      <MachineValue value={t.store} tone="warn" size="sm" />
      <span aria-hidden="true">→</span>
    </div>

    <section>
      <TechnicalLabel tone="warn" size="xs">{t.widen}</TechnicalLabel>
      <div class="map-line split">
        <div><MachineValue name="map" value="M1" tone="warn" /><small>{t.deprecated}</small></div>
        <span aria-hidden="true">→</span>
        <div><MachineValue name="map" value="M2" tone="ok" /><MachineValue name="temp" value="Double" tone="ok" size="sm" /></div>
      </div>
    </section>

    <div class="migration-arrow">
      <MachineValue value={t.migrate} tone="accent" size="sm" />
      <span aria-hidden="true">→</span>
    </div>

    <section>
      <TechnicalLabel tone="ok" size="xs">{t.after}</TechnicalLabel>
      <div class="instance">
        <MachineValue name="object" value="b" />
        <span aria-hidden="true">→</span>
        <MachineValue name="map" value="M2" tone="ok" />
      </div>
      <p>{t.repaired}</p>
    </section>
  </div>
</SkeinFigure>

<style>
  .migration {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 126px minmax(0, 1.2fr) 126px minmax(0, 1fr);
    gap: 8px;
    align-items: center;
    padding-block: 6px;
  }

  .migration :global(.sk-mv) { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }

  .migration-scope {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    margin-bottom: 2px;
  }

  section {
    min-width: 0;
    min-height: 132px;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 14px 0 14px 14px;
    border-left: 1px solid var(--hairline-strong);
  }

  section p {
    margin: 0 !important;
    font-family: var(--font-body) !important;
    font-size: 11.5px !important;
    line-height: 1.45 !important;
    color: var(--muted) !important;
  }

  .map-line,
  .instance,
  .objects {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .objects span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 0.5px solid var(--hairline-strong);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-2);
  }

  .map-line.split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 9px;
  }

  .map-line.split > div {
    display: grid;
    gap: 5px;
    align-content: start;
  }

  .map-line small {
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--warn);
  }

  .migration-arrow {
    display: grid;
    justify-items: center;
    gap: 7px;
  }

  .migration-arrow > span,
  .instance > span,
  .map-line.split > span {
    font-family: var(--font-mono);
    color: var(--d, var(--accent));
  }

  @media (max-width: 640px) {
    .migration { grid-template-columns: minmax(0, 1fr); min-width: 0; gap: 10px; }
    .migration-scope { grid-column: auto; justify-content: flex-start; }
    .migration-arrow > span { transform: rotate(90deg); }
    section { min-height: 0; }
    .map-line.split { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }
  }
</style>
