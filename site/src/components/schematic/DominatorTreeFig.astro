---
/**
 * DominatorTreeFig — Tier-B learning figure.
 *
 * Dominator trees answer "who keeps this alive?":
 * the GC root dominates everything; an app
 * singleton dominates a cache Map whose shallow
 * size is trivial but whose retained size is the
 * whole entry subtree. Sort by retained size,
 * then read the retainer path — the top row is
 * where the heap actually lives.
 *
 * Server-rendered; the is:inline script walks
 * the tree. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "DOMINATOR TREE",
    title: "Shallow size lies — retained size tells",
    label: "The GC root dominates everything; an app singleton dominates a cache Map whose shallow size is trivial while its retained size is the whole entry subtree. Sort by retained size, read the retainer path.",
    thesis: "Read retained size, then walk the retainer path — the top row is where the heap lives.",
    caption: "A dominates B when every path from the root to B passes through A. The dominator tree collapses that into one line per object: the shallow size is the object alone; the retained size is everything it alone keeps alive.",
    scope: "V8-SPECIFIC MODEL",
    tree: "THE TREE",
    sortHead: "RETAINED SORT",
    rows: [
      { name: "GC root", shallow: "—", retained: "whole heap", note: "dominates every object — the tree's root" },
      { name: "app singleton", shallow: "small", retained: "subtree", note: "dominates the cache Map it owns" },
      { name: "cache Map", shallow: "trivial", retained: "entries", note: "shallow is the map shell; retained is every entry it alone keeps" },
      { name: "entries", shallow: "big", retained: "big", note: "the actual heap mass — reachable only through the map" },
    ],
    flow: [
      { state: "snapshot", log: "heap snapshot" },
      { state: "sort", log: "by retained size" },
      { state: "top row", log: "cache Map" },
      { state: "path", log: "root → map" },
    ],
    rule: "THE RULE",
    ruleBody: "Sort by retained size, not shallow. A Map with a tiny shell and a huge subtree is the leak — the entries row alone cannot tell you where to cut.",
    read: "READ THE RETAINER PATH",
    readBody: "Clicking an entry shows its retainer path: root → singleton → cache Map → entry. That path is the fix list — sever the weakest link you can afford.",
  },
  ru: {
    category: "ДЕРЕВО ДОМИНАТОРОВ",
    title: "Shallow size врёт — retained size говорит",
    label: "GC root доминирует всем; app singleton доминирует cache Map, чей shallow size тривиален, а retained size — всё поддерево записей. Сортируйте по retained size, читайте путь удержания.",
    thesis: "Читайте retained size, затем идите по пути удержания — верхняя строка — где живёт куча.",
    caption: "A доминирует B, когда каждый путь от root к B проходит через A. Дерево доминаторов сворачивает это в одну строку на объект: shallow size — сам объект; retained size — всё, что он один держит живым.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    tree: "ДЕРЕВО",
    sortHead: "СОРТИРОВКА",
    rows: [
      { name: "GC root", shallow: "—", retained: "вся куча", note: "доминирует каждым объектом — корень дерева" },
      { name: "app singleton", shallow: "мало", retained: "поддерево", note: "доминирует принадлежащей ему cache Map" },
      { name: "cache Map", shallow: "тривиально", retained: "записи", note: "shallow — оболочка map; retained — каждая запись, которую она одна держит" },
      { name: "записи", shallow: "много", retained: "много", note: "собственно масса кучи — достижима только через map" },
    ],
    flow: [
      { state: "снимок", log: "снимок кучи" },
      { state: "сортировка", log: "по retained size" },
      { state: "верхняя строка", log: "cache Map" },
      { state: "путь", log: "root → map" },
    ],
    rule: "ПРАВИЛО",
    ruleBody: "Сортируйте по retained size, а не shallow. Map с крошечной оболочкой и огромным поддеревом — утечка; строка записей сама по себе не скажет, где резать.",
    read: "ЧИТАЙТЕ ПУТЬ УДЕРЖАНИЯ",
    readBody: "Клик по записи показывает её путь удержания: root → singleton → cache Map → запись. Этот путь — список исправлений; разорвите самое слабое звено, которое можете себе позволить.",
  },
} as const;

const t = copy[lang];
const rows = t.rows;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="dtf" data-dtf>
    <div class="dtf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="dtf-head">
      <TechnicalLabel tone="muted" size="xs">{t.tree}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.sortHead}</TechnicalLabel>
    </div>

    <div class="dtf-cols">
      <span class="dtf-col-name"><TechnicalLabel tone="muted" size="xs">DOMINATOR</TechnicalLabel></span>
      <span class="dtf-col-shallow"><TechnicalLabel tone="muted" size="xs">SHALLOW</TechnicalLabel></span>
      <span class="dtf-col-retained"><TechnicalLabel tone="muted" size="xs">RETAINED</TechnicalLabel></span>
    </div>

    <ol class="dtf-rows">
      {rows.map((r, i) => (
        <li class="dtf-row" data-dtf-row={i}>
          <MachineValue value={r.name} tone={i === 2 ? "accent" : i === 0 ? "ok" : undefined} />
          <span class="dtf-shallow">{r.shallow}</span>
          <span class="dtf-retained">{r.retained}</span>
        </li>
      ))}
    </ol>
    <p class="dtf-note">{rows[2].note}</p>

    <ol class="dtf-flow">
      {flow.map((s, i) => (
        <li class="dtf-step" data-dtf-step={i} hidden={i !== 0}>
          <span class="dtf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="dtf-rule">
      <TechnicalLabel tone="accent" size="xs">{t.rule}</TechnicalLabel>
      {t.ruleBody}
    </p>
    <p class="dtf-read">
      <TechnicalLabel tone="muted" size="xs">{t.read}</TechnicalLabel>
      {t.readBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the measurement.
  // Step 0 is server-rendered; the script replays the sort.
  (() => {
    const roots = document.querySelectorAll("[data-dtf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-dtf-step]");
      const rows = root.querySelectorAll("[data-dtf-row]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        rows.forEach((el, j) => {
          el.classList.toggle("dtf-row-live", j === Math.min(n, rows.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .dtf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .dtf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .dtf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .dtf-cols,
  .dtf-row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 12px;
    align-items: baseline;
  }

  .dtf-row {
    padding: 10px 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .dtf-row-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .dtf-shallow,
  .dtf-retained {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .dtf-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .dtf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dtf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .dtf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .dtf-rule,
  .dtf-read {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .dtf-cols { display: none; }
    .dtf-row { grid-template-columns: 1fr; gap: 4px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dtf-row {
      animation: dtf-row-in var(--dur-2) var(--ease) both;
    }
    .dtf-row:nth-child(2) { animation-delay: 100ms; }
    .dtf-row:nth-child(3) { animation-delay: 200ms; }
    .dtf-row:nth-child(4) { animation-delay: 300ms; }
    @keyframes dtf-row-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
