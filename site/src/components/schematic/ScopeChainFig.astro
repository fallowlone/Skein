---
/**
 * ScopeChainFig — Tier-B learning figure.
 *
 * Lexical scope resolution: the parser bakes every free
 * variable into a (depth, slot) pair at compile time via
 * ScopeInfo; at runtime a read is outer-pointer hops plus
 * one indexed load. The chain: inner Context → outer
 * scopes → script → global. No hashing, no names at
 * runtime — unless `with` or sloppy `eval` poisons it.
 *
 * Server-rendered; the is:inline script walks the chain
 * hops. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "SCOPE CHAIN",
    title: "Names resolve at compile time, slots at runtime",
    label: "ScopeInfo resolves each variable to a fixed depth-and-slot pair at compile time. At runtime the read is outer-pointer hops plus one indexed load — no hashing, no names.",
    thesis: "Lexical nesting becomes fixed hops — unless with or eval hides the names.",
    caption: "The inner Context points outward through outer scopes to script and global. A free variable read walks the recorded depth, then loads the slot — the compiler already knows exactly where to stop.",
    scope: "V8-SPECIFIC MODEL",
    chain: "THE RUNTIME CHAIN",
    cost: "COST OF ONE READ",
    chainNodes: [
      { name: "inner()", note: "locals: registers · free: Context slots" },
      { name: "outer()", note: "one hop: outer pointer, then indexed slot load" },
      { name: "script", note: "let / const cells live here, above the scopes" },
      { name: "global", note: "var + function declarations — the chain ends" },
    ],
    hops: [
      { state: "inner Context", log: "slot: i" },
      { state: "hop outer", log: "→ total slot" },
      { state: "chain ends", log: "script · global" },
      { state: "resolved", log: "(1, 0) · 1 load" },
    ],
    compile: "COMPILE-TIME — NAMES DIE EARLY",
    compileBody: "The parser bakes total into (depth 1, slot 0) inside the bytecode. At runtime no name exists to look up.",
    poison: "POISONED BY DYNAMIC SCOPE",
    poisonBody: "A with block or sloppy eval hides names until runtime, so the compiler emits a slow named lookup and the scope resists optimisation.",
  },
  ru: {
    category: "ЦЕПОЧКА ОБЛАСТЕЙ",
    title: "Имена резолвятся на компиляции, слоты — в рантайме",
    label: "ScopeInfo резолвит каждую переменную в фиксированную пару depth+slot на компиляции. В рантайме чтение — это hops по outer-указателям плюс один индексированный load, без хеширования и имён.",
    thesis: "Лексическая вложенность становится фиксированными hops — если только with или eval не прячут имена.",
    caption: "Внутренний Context указывает наружу через внешние области к script и global. Чтение свободной переменной идёт на записанную depth, затем грузит слот — компилятор уже точно знает, где остановиться.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    chain: "ЦЕПОЧКА В РАНТАЙМЕ",
    cost: "СТОИМОСТЬ ОДНОГО ЧТЕНИЯ",
    chainNodes: [
      { name: "inner()", note: "локали: регистры · свободные: слоты Context" },
      { name: "outer()", note: "один hop: outer-указатель, затем индексированный load слота" },
      { name: "script", note: "ячейки let / const живут здесь, над областями" },
      { name: "global", note: "var + объявления функций — цепочка заканчивается" },
    ],
    hops: [
      { state: "внутренний Context", log: "слот: i" },
      { state: "hop наружу", log: "→ слот total" },
      { state: "цепочка закончилась", log: "script · global" },
      { state: "разрешено", log: "(1, 0) · 1 load" },
    ],
    compile: "КОМПИЛЯЦИЯ — ИМЕНА УМИРАЮТ РАНЬШЕ",
    compileBody: "Парсер запекает total в (depth 1, slot 0) внутри bytecode. В рантайме имени для поиска не существует.",
    poison: "ОТРАВЛЕНО ДИНАМИЧЕСКОЙ ОБЛАСТЬЮ",
    poisonBody: "Блок with или нестрогий eval прячут имена до рантайма, поэтому компилятор испускает медленный именной lookup и область сопротивляется оптимизации.",
  },
} as const;

const t = copy[lang];
const chainNodes = t.chainNodes;
const hops = t.hops;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="scf" data-scf>
    <div class="scf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="scf-head">
      <TechnicalLabel tone="muted" size="xs">{t.chain}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.cost}</TechnicalLabel>
    </div>

    <ol class="scf-chain">
      {chainNodes.map((n, i) => (
        <li class="scf-node" data-scf-node={i}>
          <div class="scf-node-main">
            <MachineValue value={n.name} tone={i === 0 ? "accent" : undefined} />
            <MachineValue value={`(depth ${i})`} tone="dim" />
          </div>
          <p class="scf-node-note">{n.note}</p>
        </li>
      ))}
    </ol>

    <ol class="scf-hops">
      {hops.map((s, i) => (
        <li class="scf-hop" data-scf-hop={i} hidden={i !== 0}>
          <span class="scf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="scf-compile">
      <TechnicalLabel tone="muted" size="xs">{t.compile}</TechnicalLabel>
      {t.compileBody}
    </p>
    <p class="scf-poison">
      <TechnicalLabel tone="danger" size="xs">{t.poison}</TechnicalLabel>
      {t.poisonBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the chain hops.
  // Step 0 is server-rendered; the script replays the resolution.
  (() => {
    const roots = document.querySelectorAll("[data-scf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const hops = root.querySelectorAll("[data-scf-hop]");
      const nodes = root.querySelectorAll("[data-scf-node]");
      if (!hops.length) continue;
      let i = 0;
      const show = (n) => {
        hops.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        nodes.forEach((el, j) => {
          el.classList.toggle("scf-node-live", j === Math.min(n, nodes.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        hops.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % hops.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .scf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .scf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .scf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .scf-chain {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .scf-node {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-left-width: 2px;
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .scf-node-main {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .scf-node-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .scf-node-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .scf-hops {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .scf-hop {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .scf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .scf-compile,
  .scf-poison {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .scf-chain { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .scf-chain { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .scf-node {
      animation: scf-node-in var(--dur-2) var(--ease) both;
    }
    .scf-node:nth-child(2) { animation-delay: 100ms; }
    .scf-node:nth-child(3) { animation-delay: 200ms; }
    .scf-node:nth-child(4) { animation-delay: 300ms; }
    @keyframes scf-node-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
