---
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "SHAPE TRANSITIONS",
    title: "Insertion order chooses a path through one shared Map tree",
    label:
      "A shared transition tree begins at the empty Map. Adding x then y reuses the same branch for repeated objects, while adding y then x creates a different branch and a different final Map.",
    thesis: "Same property order converges on the same Map; different order diverges structurally.",
    caption:
      "The second x→y object allocates no Maps because both transition edges already exist. The y→x object cannot reuse that path: transition edges are keyed from the current Map, so it enters another branch and downstream inline caches observe another shape.",
    shared: "SHARED TRANSITION TREE",
    reuse: "REUSE",
    diverge: "DIVERGENCE",
    sameOrder: "same insertion order",
    otherOrder: "different insertion order",
    zeroMaps: "0 new Maps",
    newBranch: "new branch",
    scope: "V8-SPECIFIC MODEL",
  },
  ru: {
    category: "ПЕРЕХОДЫ ФОРМ",
    title: "Порядок добавления выбирает путь по общему дереву Map",
    label:
      "Общее дерево переходов начинается с пустой Map. Добавление x затем y повторно использует одну ветку, а добавление y затем x создаёт другую ветку и другую конечную Map.",
    thesis: "Одинаковый порядок свойств сходится к одной Map; другой порядок структурно расходится.",
    caption:
      "Второй объект x→y не создаёт Maps: оба ребра уже существуют. Объект y→x не может использовать этот путь, потому что переход ищется от текущей Map; он попадает в другую ветку, и inline cache видит другую форму.",
    shared: "ОБЩЕЕ ДЕРЕВО ПЕРЕХОДОВ",
    reuse: "ПОВТОРНОЕ ИСПОЛЬЗОВАНИЕ",
    diverge: "РАСХОЖДЕНИЕ",
    sameOrder: "тот же порядок",
    otherOrder: "другой порядок",
    zeroMaps: "0 новых Maps",
    newBranch: "новая ветка",
    scope: "V8-СПЕЦИФИЧНАЯ МОДЕЛЬ",
  },
} as const;

const t = copy[lang];
---

<SkeinFigure
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
  variant="canvas"
>
  <div class="shape-layout">
    <section class="shape-tree">
      <div class="shape-tree-head">
        <TechnicalLabel tone="muted" size="xs">{t.shared}</TechnicalLabel>
        <TechnicalLabel tone="accent" size="xs">{t.scope}</TechnicalLabel>
      </div>
      <div class="map root"><MachineValue value="M0 · {}" tone="accent" /></div>
      <div class="fork" aria-hidden="true"></div>
      <div class="branches">
        <div class="branch reuse">
          <span class="edge"><span>+ x</span></span>
          <div class="map"><MachineValue value="M1 · {x}" /></div>
          <span class="edge"><span>+ y</span></span>
          <div class="map leaf"><MachineValue value="M2 · {x,y}" tone="ok" /></div>
        </div>
        <div class="branch diverge">
          <span class="edge"><span>+ y</span></span>
          <div class="map"><MachineValue value="M3 · {y}" /></div>
          <span class="edge"><span>+ x</span></span>
          <div class="map leaf"><MachineValue value="M4 · {y,x}" tone="warn" /></div>
        </div>
      </div>
    </section>

    <section class="shape-cases">
      <div class="case ok">
        <TechnicalLabel tone="ok" size="xs">{t.reuse}</TechnicalLabel>
        <code>a: {} → +x → +y</code>
        <code>b: {} → +x → +y</code>
        <p>{t.sameOrder}</p>
        <MachineValue value={t.zeroMaps} tone="ok" size="sm" />
      </div>
      <div class="case warn">
        <TechnicalLabel tone="warn" size="xs">{t.diverge}</TechnicalLabel>
        <code>c: {} → +y → +x</code>
        <p>{t.otherOrder}</p>
        <MachineValue value={t.newBranch} tone="warn" size="sm" />
      </div>
    </section>
  </div>
</SkeinFigure>

<style>
  .shape-layout {
    display: grid;
    grid-template-columns: minmax(420px, 1.4fr) minmax(250px, 0.8fr);
    gap: 36px;
    align-items: center;
    min-width: 720px;
  }

  .shape-tree {
    display: grid;
    justify-items: center;
  }

  .shape-tree-head {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .map {
    padding: 7px 9px;
    background: var(--paper);
  }

  .fork {
    width: 50%;
    height: 24px;
    border-left: 0.5px solid var(--hairline-strong);
    border-right: 0.5px solid var(--hairline-strong);
    border-bottom: 0.5px solid var(--hairline-strong);
  }

  .branches {
    width: 76%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
  }

  .branch {
    display: grid;
    justify-items: center;
  }

  .edge {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 38px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
  }

  .edge::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 0.5px;
    background: var(--hairline-strong);
    z-index: 0;
  }

  .edge::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: calc(50% - 3px);
    width: 6px;
    height: 6px;
    border-right: 0.5px solid var(--hairline-strong);
    border-bottom: 0.5px solid var(--hairline-strong);
    transform: rotate(45deg);
  }

  .edge > span {
    position: relative;
    z-index: 1;
    padding-inline: 6px;
    background: var(--paper);
  }

  .shape-cases {
    display: grid;
    gap: 18px;
  }

  .case {
    padding: 16px 0 16px 18px;
    border-left: 1px solid var(--hairline-strong);
  }

  .case.ok {
    border-left-color: color-mix(in srgb, var(--ok) 65%, var(--hairline));
  }

  .case.warn {
    border-left-color: color-mix(in srgb, var(--warn) 65%, var(--hairline));
  }

  .case code {
    display: block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-2);
  }

  .case p {
    margin: 8px 0;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .shape-layout { grid-template-columns: minmax(0, 1fr); min-width: 0; gap: 24px; }
    .shape-tree-head { flex-wrap: wrap; }
    .branches { width: 100%; gap: 4px; }
    .branch { min-width: 0; }
    .case { padding-left: 12px; }
  }
</style>
