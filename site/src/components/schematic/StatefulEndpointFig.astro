---
/**
 * StatefulEndpointFig — Stateless IP Forwarding vs Stateful TCP Endpoint State.
 *
 * Tier B: Supporting Technical Diagram.
 * Embedded cleanly in explanation with compact technical labels.
 *
 * Answers: "What state actually exists at each endpoint after the handshake?"
 * Shows:
 *   - Network Core (Standard IP forwarding does not maintain per-TCP-connection state).
 *   - Stateful TCP Endpoints (TCB: Transmission Control Block):
 *     - Receive / Send sliding window buffers
 *     - Monotonic sequence tracking pointers (SND.UNA, SND.NXT, RCV.NXT)
 *     - Dynamic retransmission timers (SRTT / RTO)
 *     - Connection state machine status (ESTABLISHED)
 *   - Architectural qualification note regarding stateful middleboxes (NAT / firewalls).
 *
 * Island-free: inline HTML/SVG.
 */
import StateBadge from "./StateBadge.astro";
import MachineValue from "./MachineValue.astro";

interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}

const { lang = "en", span = "learning" } = Astro.props;

const copy = {
  en: {
    label: "Architectural comparison contrasting standard stateless IP packet forwarding in the network core against the Transmission Control Block (TCB) state maintained in operating system memory at TCP endpoints.",
    thesis: "Reliability is not a property of the network; it is memory at the two edges.",
    caption: "Standard IP forwarding keeps no per-connection record, so retransmission, reordering and flow control live at the TCP endpoints. Exact TCB metadata and buffer sizing are implementation-dependent.",
    techTag: "SYSTEM ARCHITECTURE · END-TO-END PRINCIPLE",
    l3Label: "L3 NETWORK LAYER",
    datagramLabel: "IP Datagram",
    fibLabel: "FIB Match",
    egressLabel: "Egress Port",
    l4Label: "L4 TRANSPORT LAYER",
    ipTitle: "NETWORK CORE (STANDARD IP FORWARDING)",
    ipSubtitle: "Standard forwarding model · stateless fabric (illustrative)",
    ipStatement: "Standard IP forwarding does not maintain per-TCP-connection state.",
    ipTrait1: "Packets routed independently by destination address",
    ipTrait2: "No connection records, seq counters, or socket buffers",
    ipTrait3: "No memory of previous packets or lost data",
    middleboxNote: "Note: Stateful middleboxes (NATs, firewalls) may track flow tuples, but standard L3 routing does not. TCP control structures and socket buffers are implementation-dependent.",
    tcpTitle: "ENDPOINTS (TRANSMISSION CONTROL BLOCK)",
    tcpSubtitle: "Connection-specific TCP state (TCB metadata, implementation-dependent)",
    bufferSection: "SLIDING WINDOW BUFFERS",
    rxBuffer: "Receive Buffer (reordering & reassembly)",
    txBuffer: "Send Buffer (inflight unacknowledged bytes)",
    seqTracking: "SEQUENCE TRACKING POINTERS",
    timersSection: "RETRANSMISSION & FLOW TIMERS",
    rtoDesc: "Dynamic RTO calculated from continuous RTT sampling",
  },
  ru: {
    label: "Архитектурная схема, противопоставляющая стандартную маршрутизацию IP в центре сети детальному блоку управления передачей (TCB) в операционной системе на концах соединения.",
    thesis: "Надёжность — не свойство сети, а память на двух концах.",
    caption: "Стандартная IP-маршрутизация не хранит записи отдельных соединений, поэтому повторная передача, упорядочивание и управление потоком живут на конечных TCP-узлах. Точный состав TCB и размеры буферов зависят от реализации.",
    techTag: "АРХИТЕКТУРА СИСТЕМЫ · СКВОЗНОЙ ПРИНЦИП (END-TO-END)",
    l3Label: "L3 · СЕТЕВОЙ УРОВЕНЬ",
    datagramLabel: "IP-датаграмма",
    fibLabel: "Поиск в FIB",
    egressLabel: "Выходной порт",
    l4Label: "L4 · ТРАНСПОРТНЫЙ УРОВЕНЬ",
    ipTitle: "ЦЕНТР СЕТИ (МАРШРУТИЗАЦИЯ IP)",
    ipSubtitle: "Стандартная модель маршрутизации · фабрика без состояния (иллюстрация)",
    ipStatement: "Стандартная IP-маршрутизация не хранит состояние отдельных TCP-соединений.",
    ipTrait1: "Пакеты направляются независимо по IP-адресу назначения",
    ipTrait2: "Нет записей соединений, счётчиков seq или буферов сокетов",
    ipTrait3: "Сеть не помнит предшествующие пакеты или потери",
    middleboxNote: "Примечание: middlebox-устройства (NAT, межсетевые экраны) могут отслеживать сессии, но базовая L3-маршрутизация этого не требует. Структуры управления TCP и размеры буферов зависят от реализации.",
    tcpTitle: "ОКОНЕЧНЫЕ УЗЛЫ (TCB В ПАМЯТИ ОС)",
    tcpSubtitle: "Состояние соединения TCP (метаданные TCB, зависит от реализации)",
    bufferSection: "БУФЕРЫ СКОЛЬЗЯЩЕГО ОКНА",
    rxBuffer: "Буфер приёма (сборка неупорядоченных байт)",
    txBuffer: "Буфер отправки (хранение до получения ACK)",
    seqTracking: "УКАЗАТЕЛИ НОМЕРОВ ПОСЛЕДОВАТЕЛЬНОСТИ",
    timersSection: "ТАЙМЕРЫ ПОВТОРНОЙ ПЕРЕДАЧИ",
    rtoDesc: "Динамический RTO на основе скользящего замера RTT",
  },
}[lang];
---

<figure
  data-lesson-visual
  data-span={span}
  class={`sk-sep-figure sk-span-${span}`}
  aria-label={copy.label}
>
  <div class="sk-sep-topline" aria-hidden="true">
    <span class="sk-sep-badge">{copy.techTag}</span>
  </div>

  <div class="sk-sep-grid">
    {/* Router column */}
    <div class="sk-sep-col sk-sep-col-router">
      <div class="sk-sep-header">
        <span class="sk-sep-kicker">{copy.l3Label}</span>
        <h4 class="sk-sep-name">{copy.ipTitle}</h4>
        <p class="sk-sep-sub">{copy.ipSubtitle}</p>
      </div>

      <div class="sk-router-viz">
        <div class="sk-router-flow">
          <span class="sk-rf-node">{copy.datagramLabel}</span>
          <span class="sk-rf-arr">→</span>
          <span class="sk-rf-lookup">[ {copy.fibLabel} ]</span>
          <span class="sk-rf-arr">→</span>
          <span class="sk-rf-node">{copy.egressLabel}</span>
        </div>
        <p class="sk-rf-statement">{copy.ipStatement}</p>
      </div>

      <ul class="sk-sep-traits">
        <li>✕ {copy.ipTrait1}</li>
        <li>✕ {copy.ipTrait2}</li>
        <li>✕ {copy.ipTrait3}</li>
      </ul>

      <div class="sk-sep-middlebox-note">
        <span class="sk-mb-icon">ℹ</span>
        <span class="sk-mb-text">{copy.middleboxNote}</span>
      </div>
    </div>

    {/* TCP TCB column */}
    <div class="sk-sep-col sk-sep-col-tcp">
      <div class="sk-sep-header">
        <div class="sk-tcb-title-row">
          <span class="sk-sep-kicker">{copy.l4Label}</span>
          <StateBadge state="ESTABLISHED" size="sm" />
        </div>
        <h4 class="sk-sep-name">{copy.tcpTitle}</h4>
        <p class="sk-sep-sub">{copy.tcpSubtitle}</p>
      </div>

      <div class="sk-tcb-content">
        <div class="sk-tcb-section">
          <span class="sk-sec-title">{copy.bufferSection}</span>
          <div class="sk-buf-bars">
            <div class="sk-buf-item">
              <span class="sk-buf-name">{copy.rxBuffer}</span>
              <div class="sk-buf-track">
                <div class="sk-buf-fill sk-fill-accent" style="width: 45%;"></div>
              </div>
            </div>
            <div class="sk-buf-item">
              <span class="sk-buf-name">{copy.txBuffer}</span>
              <div class="sk-buf-track">
                <div class="sk-buf-fill sk-fill-ok" style="width: 65%;"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="sk-tcb-section">
          <span class="sk-sec-title">{copy.seqTracking}</span>
          <div class="sk-seq-chips">
            <MachineValue name="SND.UNA" val={lang === "ru" ? "42 000 001" : "42,000,001"} size="sm" tone="neutral" />
            <MachineValue name="SND.NXT" val={lang === "ru" ? "42 001 460" : "42,001,460"} size="sm" tone="accent" />
            <MachineValue name="RCV.NXT" val={lang === "ru" ? "99 000 001" : "99,000,001"} size="sm" tone="ok" />
          </div>
        </div>

        <div class="sk-tcb-section">
          <span class="sk-sec-title">{copy.timersSection}</span>
          <div class="sk-timer-row">
            <MachineValue name="SRTT" val={lang === "ru" ? "32 мс" : "32 ms"} size="sm" tone="neutral" />
            <MachineValue name="RTO" val={lang === "ru" ? "200 мс" : "200 ms"} size="sm" tone="warn" />
            <span class="sk-timer-desc">{copy.rtoDesc}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <figcaption class="sk-sep-caption">
    <span class="sk-sep-thesis">{copy.thesis}</span>
    <span class="sk-sep-caption-text">{copy.caption}</span>
  </figcaption>
</figure>

<style>
  .sk-sep-figure {
    position: relative;
    margin: 36px 0;
    padding: 0;
    box-sizing: border-box;
  }

  .sk-span-reading {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
  }

  .sk-span-learning {
    width: 100%;
    max-width: 860px;
  }

  .sk-span-canvas {
    width: 100%;
    max-width: 1140px;
  }

  .sk-sep-topline {
    margin-bottom: 12px;
  }

  .sk-sep-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .sk-sep-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(20px, 3.5vw, 36px);
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline-strong);
    padding: 18px 0;
  }

  @media (max-width: 780px) {
    .sk-sep-grid {
      grid-template-columns: 1fr;
    }
  }

  .sk-sep-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sk-sep-col-router {
    border-left: 2px solid var(--hairline-strong);
    padding-left: 14px;
  }

  .sk-sep-col-tcp {
    border-left: 2px solid var(--d, var(--accent));
    padding-left: 14px;
  }

  .sk-sep-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sk-tcb-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sk-sep-kicker {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .sk-sep-name {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .sk-sep-sub {
    margin: 0;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--muted);
    line-height: 1.4;
  }

  /* Router visual flow */
  .sk-router-viz {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 12px;
    background: transparent;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .sk-router-flow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-2);
  }

  .sk-rf-node {
    font-weight: 600;
  }

  .sk-rf-lookup {
    color: var(--d, var(--accent));
    font-weight: 600;
  }

  .sk-rf-arr {
    color: var(--muted);
  }

  .sk-rf-statement {
    margin: 0;
    font-family: var(--font-body);
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .sk-sep-traits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--muted);
  }

  .sk-sep-middlebox-note {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding-top: 8px;
    border-top: 0.5px solid var(--hairline);
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 1.4;
    color: var(--muted);
  }

  .sk-mb-icon {
    font-family: var(--font-mono);
    font-weight: bold;
    color: var(--muted);
    flex-shrink: 0;
  }

  /* TCP TCB structure */
  .sk-tcb-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 6px;
    border-top: 1px solid var(--hairline);
  }

  .sk-tcb-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sk-sec-title {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .sk-buf-bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sk-buf-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sk-buf-name {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--ink-2);
  }

  .sk-buf-track {
    height: 4px;
    background: var(--hairline);
    border-radius: var(--r-pill);
    overflow: hidden;
  }

  .sk-buf-fill {
    height: 100%;
    border-radius: var(--r-pill);
  }

  .sk-fill-accent {
    background: var(--d, var(--accent));
  }
  .sk-fill-ok {
    background: var(--ok);
  }

  .sk-seq-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .sk-timer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .sk-timer-desc {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--muted);
  }

  .sk-sep-caption {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sk-sep-thesis {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .sk-sep-caption-text {
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--muted);
  }
</style>
