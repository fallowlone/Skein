---
/**
 * ReachabilityWaveFig — Tier-B learning figure.
 *
 * Reachability as a wave: roots (stack, globals,
 * embedder handles) reach A, B, and C through live
 * edges, while X and Y point only at each other.
 * The trace marks everything on a root path and
 * reclaims the unreached island — cycles included.
 * Never enumerate the dead; trace the live and take
 * the rest.
 *
 * Server-rendered; the is:inline script replays the
 * wave. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "REACHABILITY",
    title: "Reachable is live — the island is garbage",
    label: "Roots reach A, B, and C through live edges while X and Y point only at each other. The trace marks everything on a root path and reclaims the unreached island — cycles included.",
    thesis: "Never enumerate the dead — trace the live and take the rest.",
    caption: "The collector does not hunt for garbage; it floods from the roots and whatever the flood misses is dead. Two objects referencing each other are still garbage if no root can reach them.",
    scope: "V8-SPECIFIC MODEL",
    graph: "THE LIVE GRAPH",
    wave: "THE WAVE",
    nodes: [
      { name: "roots", note: "stack · globals · embedder handles — always live" },
      { name: "A", note: "reached from roots — live" },
      { name: "B", note: "reached through A — live" },
      { name: "C", note: "reached from roots — live" },
      { name: "X ↔ Y", note: "an island: references intact, no root path — garbage" },
    ],
    waves: [
      { state: "roots live", log: "roots · always live" },
      { state: "tracing", log: "roots → A · C → B" },
      { state: "live marked", log: "A · B · C live" },
      { state: "island garbage", log: "X↔Y · no path" },
    ],
    cycle: "CYCLES GET NO RESCUE",
    cycleBody: "X and Y keep each other alive by mutual reference, but the GC never follows a path that does not start at a root. Reference counting would leak this; tracing collects it.",
  },
  ru: {
    category: "ДОСТИЖИМОСТЬ",
    title: "Достижимо — значит живо, остров — мусор",
    label: "Roots достигают A, B и C через живые рёбра, а X и Y указывают только друг на друга. Трассировка помечает всё на пути от root и reclaim'ает недостижимый остров — циклы включительно.",
    thesis: "Не перечисляйте мёртвых — трассируйте живых и забирайте остальное.",
    caption: "Коллектор не охотится за мусором — он затапливает от roots, и всё, что поток не достиг, мертво. Два объекта, ссылающиеся друг на друга, всё ещё мусор, если ни один root их не достигает.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    graph: "ЖИВОЙ ГРАФ",
    wave: "ВОЛНА",
    nodes: [
      { name: "roots", note: "стек · глобалы · handles — всегда живы" },
      { name: "A", note: "достигнут от roots — жив" },
      { name: "B", note: "достигнут через A — жив" },
      { name: "C", note: "достигнут от roots — жив" },
      { name: "X ↔ Y", note: "остров: ссылки целы, пути от root нет — мусор" },
    ],
    waves: [
      { state: "roots живы", log: "roots · всегда живы" },
      { state: "трассировка", log: "roots → A · C → B" },
      { state: "живые помечены", log: "A · B · C живы" },
      { state: "остров — мусор", log: "X↔Y · нет пути" },
    ],
    cycle: "ЦИКЛЫ НЕ СПАСАЮТ",
    cycleBody: "X и Y держат друг друга живыми по взаимной ссылке, но GC никогда не идёт по пути, не начинающемуся от root. Reference counting утечёт здесь; tracing собирает.",
  },
} as const;

const t = copy[lang];
const nodes = t.nodes;
const waves = t.waves;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="rwf" data-rwf>
    <div class="rwf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="rwf-head">
      <TechnicalLabel tone="muted" size="xs">{t.graph}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.wave}</TechnicalLabel>
    </div>

    <ol class="rwf-nodes">
      {nodes.map((n, i) => (
        <li class="rwf-node" data-rwf-node={i}>
          <div class="rwf-node-main">
            <MachineValue value={n.name} tone={i === 4 ? "danger" : i === 0 ? "accent" : undefined} />
          </div>
          <p class="rwf-node-note">{n.note}</p>
        </li>
      ))}
    </ol>

    <ol class="rwf-waves">
      {waves.map((s, i) => (
        <li class="rwf-step" data-rwf-step={i} hidden={i !== 0}>
          <span class="rwf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "danger" : undefined} />
        </li>
      ))}
    </ol>

    <p class="rwf-cycle">
      <TechnicalLabel tone="danger" size="xs">{t.cycle}</TechnicalLabel>
      {t.cycleBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: replay the reachability wave.
  // Step 0 is server-rendered; the script replays the flood.
  (() => {
    const roots = document.querySelectorAll("[data-rwf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-rwf-step]");
      const nodes = root.querySelectorAll("[data-rwf-node]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        nodes.forEach((el, j) => {
          el.classList.toggle("rwf-node-live", j === Math.min(n, nodes.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .rwf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .rwf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .rwf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .rwf-nodes {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rwf-node {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .rwf-node-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .rwf-node-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .rwf-node-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .rwf-waves {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rwf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .rwf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .rwf-cycle {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .rwf-nodes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .rwf-nodes { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rwf-node {
      animation: rwf-node-in var(--dur-2) var(--ease) both;
    }
    .rwf-node:nth-child(2) { animation-delay: 80ms; }
    .rwf-node:nth-child(3) { animation-delay: 160ms; }
    .rwf-node:nth-child(4) { animation-delay: 240ms; }
    .rwf-node:nth-child(5) { animation-delay: 320ms; }
    @keyframes rwf-node-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
