---
import SkeinFigure from "./SkeinFigure.astro";

interface Props { lang?: "en" | "ru" }
const { lang = "en" } = Astro.props;
const t = {
  en: {
    category: "V8 · POINTER COMPRESSION",
    title: "One base turns a 32-bit tagged offset into a full address",
    label: "Illustrative pointer-compression calculation. A 32-bit slot stores tagged value 0x00001001: offset 0x1000 plus low tag bit 1. Adding a 4-gigabyte-aligned cage base 0x0000000100000000 yields tagged pointer 0x0000000100001001. Removing the tag gives the aligned HeapObject address 0x0000000100001000. Other configurations and references may use different layouts.",
    thesis: "The high address bits are shared; each slot stores only the low tagged bits.",
    caption: "Illustrative addresses. The cage reserves an address range; 4 GB is not a promise that 4 GB of physical memory is allocated.",
    slot: "01 / COMPRESSED TAGGED SLOT",
    tag: "low bit 1 · heap reference",
    base: "02 / SHARED CAGE BASE",
    aligned: "4 GB aligned",
    cage: "4 GB ADDRESS RANGE · NOT TO SCALE",
    object: "HEAP OBJECT",
    offset: "offset 0x1000",
    sum: "03 / DECOMPRESS",
    full: "tagged pointer",
    clear: "clear tag",
    actual: "aligned object address",
  },
  ru: {
    category: "V8 · СЖАТИЕ УКАЗАТЕЛЕЙ",
    title: "Общая база превращает 32-битное смещение в полный адрес",
    label: "Условный расчёт сжатого указателя. 32-битный слот хранит тегированное значение 0x00001001: смещение 0x1000 и младший тег-бит 1. Прибавление выровненной по 4 ГБ базы области 0x0000000100000000 даёт тегированный указатель 0x0000000100001001. После снятия тега получаем выровненный адрес HeapObject 0x0000000100001000. Другие конфигурации и виды ссылок могут отличаться.",
    thesis: "Старшие биты адреса общие; слот хранит только младшие биты и тег.",
    caption: "Адреса условные. Область резервирует адресное пространство; 4 ГБ не означают выделение 4 ГБ физической памяти.",
    slot: "01 / СЖАТЫЙ ТЕГИРОВАННЫЙ СЛОТ",
    tag: "младший бит 1 · ссылка в куче",
    base: "02 / ОБЩАЯ БАЗА ОБЛАСТИ",
    aligned: "выравнивание по 4 ГБ",
    cage: "АДРЕСНАЯ ОБЛАСТЬ 4 ГБ · НЕ В МАСШТАБЕ",
    object: "ОБЪЕКТ КУЧИ",
    offset: "смещение 0x1000",
    sum: "03 / ВОССТАНОВЛЕНИЕ АДРЕСА",
    full: "тегированный указатель",
    clear: "снять тег",
    actual: "выровненный адрес объекта",
  },
}[lang];
---

<SkeinFigure num="01" category={t.category} title={t.title} label={t.label} thesis={t.thesis} caption={t.caption} span="learning" variant="clean" hue="var(--ink-2)">
  <div class="drawing">
    <div class="inputs">
      <div class="input">
        <strong>{t.slot}</strong>
        <div class="word"><code>0x0000_100</code><b>1</b></div>
        <span>{t.tag}</span>
      </div>
      <div class="plus" aria-hidden="true">+</div>
      <div class="input">
        <strong>{t.base}</strong>
        <div class="word"><code>0x0000_0001_0000_0000</code></div>
        <span>{t.aligned}</span>
      </div>
    </div>

    <div class="cage-label">{t.cage}</div>
    <div class="cage-scene" aria-hidden="true">
      <div class="cage-plane"><span>BASE</span></div>
      <div class="object"><span>{t.object}</span><small>{t.offset}</small></div>
    </div>

    <div class="result">
      <strong>{t.sum}</strong>
      <div class="addresses">
        <div><span>{t.full}</span><code>0x0000_0001_0000_1001</code></div>
        <div class="result-arrow"><span aria-hidden="true">→</span><small>{t.clear}</small></div>
        <div><span>{t.actual}</span><code>0x0000_0001_0000_1000</code></div>
      </div>
    </div>
  </div>
</SkeinFigure>

<style>
  .drawing { --fig-accent: #a74a31; padding: 24px; background-color: var(--paper); background-image: linear-gradient(color-mix(in srgb, var(--ink) 3%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 3%, transparent) 1px, transparent 1px); background-size: 12px 12px; color: var(--ink); }
  .inputs { display: grid; grid-template-columns: minmax(0, 1fr) 20px minmax(0, 1.3fr); gap: 12px; align-items: center; }
  .input { min-width: 0; }
  .input strong, .cage-label, .result > strong { display: block; font: 600 10px/1.5 var(--font-mono); letter-spacing: .08em; color: var(--muted); }
  .word { display: flex; width: 100%; min-height: 54px; margin: 12px 0 6px; border: 1px solid var(--ink-2); background: var(--paper); align-items: center; justify-content: center; box-sizing: border-box; }
  .word code { font: 13px/1.4 var(--font-mono); white-space: nowrap; }
  .word code, .addresses code { background: transparent; border: 0; padding: 0; }
  .word b { align-self: stretch; display: grid; place-items: center; padding: 0 10px; border-left: 1px solid var(--ink-2); font: 600 14px var(--font-mono); color: var(--fig-accent); }
  .input > span { font: 11px/1.5 var(--font-body); color: var(--muted); }
  .plus { text-align: center; font: 22px var(--font-display); }
  .cage-label { margin-top: 36px; }
  .cage-scene { height: 205px; position: relative; overflow: hidden; }
  .cage-plane { position: absolute; left: 6%; top: 55px; width: 83%; height: 82px; display: flex; justify-content: space-between; align-items: end; padding: 0 18px 14px; border: 1px solid var(--ink-2); background: color-mix(in srgb, var(--paper) 90%, var(--ink)); box-shadow: 9px 9px 0 color-mix(in srgb, var(--ink) 8%, var(--paper)); transform: skewY(-7deg); box-sizing: border-box; font: 11px var(--font-mono); }
  .cage-plane span { transform: skewY(7deg); }
  .object { position: absolute; left: 53%; top: 42px; width: 142px; min-height: 70px; display: grid; align-content: center; justify-items: center; gap: 4px; border: 1px solid var(--fig-accent); background: var(--paper); box-shadow: 7px 7px 0 color-mix(in srgb, var(--fig-accent) 12%, var(--paper)); transform: skewY(-7deg); box-sizing: border-box; }
  .object span, .object small { transform: skewY(7deg); }
  .object span { font: 600 10px/1.3 var(--font-mono); letter-spacing: .06em; color: var(--fig-accent); }
  .object small { font: 10px var(--font-mono); color: var(--ink-2); }
  .result { border-top: 1px solid var(--hairline-strong); padding-top: 16px; }
  .addresses { display: grid; grid-template-columns: minmax(0, 1fr) 130px minmax(0, 1fr); align-items: center; gap: 14px; margin-top: 12px; }
  .addresses > div:not(.result-arrow) { min-width: 0; display: grid; gap: 6px; }
  .addresses span { font: 11px/1.5 var(--font-body); color: var(--muted); }
  .addresses code { font: 12px/1.5 var(--font-mono); white-space: nowrap; }
  .result-arrow { display: flex; align-items: center; gap: 8px; }
  .result-arrow span { font: 20px var(--font-display); color: var(--fig-accent); }
  .result-arrow small { font: 10px/1.3 var(--font-body); color: var(--muted); }
  :global([data-theme='dark']) .drawing { --fig-accent: #e07855; }
  @media (max-width: 640px) {
    .drawing { padding: 18px 12px; }
    .inputs { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .plus { line-height: 1; }
    .word { justify-content: flex-start; padding-left: 12px; }
    .cage-label { margin-top: 22px; }
    .cage-scene { height: 190px; }
    .cage-plane { left: 3%; top: 58px; width: 90%; height: 86px; }
    .object { left: 44%; top: 46px; width: 45%; min-height: 62px; }
    .addresses { grid-template-columns: minmax(0, 1fr); gap: 6px; }
  }
</style>
