---
/**
 * StorageModesFig — Tier-B learning figure.
 *
 * The three property storage modes as a cost cliff: in-object slots
 * (one load), PropertyArray spill (one extra dereference), and
 * dictionary mode (a hash probe — permanent, usually after a delete).
 * The causal hinge: delete drops a shape to dictionary mode and it
 * never climbs back; only a fresh object recovers fast properties.
 *
 * Server-rendered; the is:inline script walks the four states. Zero
 * hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "STORAGE MODES",
    title: "Where the field lives decides the cost of one property read",
    label: "The same property resolves three ways: in-object slot (one load), PropertyArray spill (one extra dereference), or dictionary-mode hash probe — the last reached by delete, and permanent.",
    thesis: "Inline is one load, spill is two, dictionary is a hash probe forever — never delete a hot field.",
    caption: "In-object slots sit after the object header. Extra fields spill to the PropertyArray but keep fixed offsets. A delete collapses the layout into a NameDictionary; the object never recovers fast properties.",
    scope: "V8-SPECIFIC MODEL",
    modes: "THREE STORAGES · ONE CLIFF",
    cliff: "COST PER READ",
    modes: [
      { name: "in-object", cost: "1 load", note: "slot sits after the header — the fastest read in the engine" },
      { name: "PropertyArray", cost: "+1 deref", note: "extra fields spill here; fixed offsets, IC-friendly" },
      { name: "dictionary", cost: "~50–100x", note: "NameDictionary hash probe — usually after a delete, permanent" },
    ],
    flow: [
      { state: "in-object", log: "inline · 1 load" },
      { state: "PropertyArray", log: "spill · +1 deref" },
      { state: "still fast", log: "offset · IC ok" },
      { state: "dictionary", log: "delete → dict" },
    ],
    permanent: "PERMANENT",
    permanentBody: "Once dictionary mode, always dictionary mode. Only a fresh object recovers fast properties — assign `null` instead of deleting.",
    slack: "MEASURE AFTER WARM-UP",
    slackBody: "Early instances carry padding slots. Slack tracking trims them after a construction threshold, so object size settles only after warm-up.",
  },
  ru: {
    category: "РЕЖИМЫ ХРАНЕНИЯ",
    title: "Где лежит поле, решает стоимость одного чтения свойства",
    label: "Одно и то же свойство разрешается тремя способами: in-object slot (1 load), PropertyArray spill (+1 deref) или dictionary-mode hash probe — последний достигается delete и постоянен.",
    thesis: "Inline — один load, spill — два, dictionary — hash probe навсегда — никогда не удаляйте горячее поле.",
    caption: "In-object slots лежат после заголовка объекта. Дополнительные поля spill'ятся в PropertyArray, но сохраняют фиксированные offsets. delete схлопывает layout в NameDictionary; объект не восстанавливает быстрые свойства.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    modes: "ТРИ РЕЖИМА · ОДНА УТЕС",
    cliff: "СТОИМОСТЬ ЧТЕНИЯ",
    modes: [
      { name: "in-object", cost: "1 load", note: "slot лежит после заголовка — самое быстрое чтение в движке" },
      { name: "PropertyArray", cost: "+1 deref", note: "дополнительные поля spill'ятся сюда; фиксированные offsets, IC-дружественные" },
      { name: "dictionary", cost: "~50–100x", note: "hash probe по NameDictionary — обычно после delete, постоянно" },
    ],
    flow: [
      { state: "in-object", log: "inline · 1 load" },
      { state: "PropertyArray", log: "spill · +1 deref" },
      { state: "still fast", log: "offset · IC ok" },
      { state: "dictionary", log: "delete → dict" },
    ],
    permanent: "ПОСТОЯННО",
    permanentBody: "Dictionary mode навсегда. Только новый объект восстанавливает быстрые свойства — присвойте `null` вместо delete.",
    slack: "ИЗМЕРЯЙТЕ ПОСЛЕ ПРОГРЕВА",
    slackBody: "Ранние экземпляры несут padding slots. Slack tracking обрезает их после порога конструкций, поэтому размер объекта стабилизируется только после прогрева.",
  },
} as const;

const t = copy[lang];
const modes = t.modes;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="smf" data-smf>
    <div class="smf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="smf-head">
      <TechnicalLabel tone="muted" size="xs">{t.modes}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.cliff}</TechnicalLabel>
    </div>

    <ol class="smf-modes">
      {modes.map((m, i) => (
        <li class="smf-mode" data-smf-mode={i}>
          <div class="smf-mode-main">
            <MachineValue value={m.name} tone={i === 2 ? "danger" : i === 0 ? "ok" : "warn"} />
            <MachineValue value={m.cost} tone={i === 2 ? "danger" : undefined} />
          </div>
          <p class="smf-mode-note">{m.note}</p>
        </li>
      ))}
    </ol>

    <ol class="smf-flow">
      {flow.map((s, i) => (
        <li class="smf-step" data-smf-step={i} hidden={i !== 0}>
          <span class="smf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "danger" : undefined} />
        </li>
      ))}
    </ol>

    <p class="smf-permanent">
      <TechnicalLabel tone="danger" size="xs">{t.permanent}</TechnicalLabel>
      {t.permanentBody}
    </p>
    <p class="smf-slack">
      <TechnicalLabel tone="muted" size="xs">{t.slack}</TechnicalLabel>
      {t.slackBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the storage-mode flow.
  // Step 0 is server-rendered; the script replays the spill story.
  (() => {
    const roots = document.querySelectorAll("[data-smf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-smf-step]");
      const modes = root.querySelectorAll("[data-smf-mode]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        modes.forEach((el, j) => {
          el.classList.toggle("smf-mode-live", j === Math.min(n, modes.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .smf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .smf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .smf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .smf-modes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .smf-mode {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease);
  }

  .smf-mode-main {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .smf-mode-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  .smf-mode-live { border-color: var(--accent); }

  .smf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .smf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .smf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .smf-permanent,
  .smf-slack {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .smf-modes { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .smf-mode {
      animation: smf-mode-in var(--dur-2) var(--ease) both;
    }
    .smf-mode:nth-child(2) { animation-delay: 120ms; }
    .smf-mode:nth-child(3) { animation-delay: 240ms; }
    @keyframes smf-mode-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
