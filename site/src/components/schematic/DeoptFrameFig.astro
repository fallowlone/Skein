---
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "DEOPT · FRAME TRANSLATION",
    title: "A failed guard reconstructs the interpreter state, value by value",
    label:
      "Conceptual V8 example: optimized execution fails a type guard. Deoptimization metadata maps live machine values back into interpreter registers so execution can resume at the corresponding bytecode position.",
    thesis: "Deoptimization is a state translation, not a restart.",
    caption:
      "Illustrative values and slots, not a captured V8 frame. Compile-time metadata describes where live values reside and how to reconstruct the interpreter state, including representation changes when needed.",
    optimized: "OPTIMIZED FRAME",
    failure: "GUARD FAILS",
    metadata: "DEOPT METADATA",
    interpreter: "RECONSTRUCTED IGNITION FRAME",
    resume: "resume at saved bytecode offset",
    map1: "machine register → interpreter slot",
    map2: "stack slot → interpreter slot",
    map3: "raw float64 → tagged Number value",
    map4: "incoming value → interpreter slot",
    scope: "CONCEPTUAL V8 EXAMPLE",
  },
  ru: {
    category: "ДЕОПТ · ПЕРЕВОД ФРЕЙМА",
    title: "Провал guard восстанавливает состояние интерпретатора значение за значением",
    label:
      "Упрощённый пример V8: оптимизированное исполнение проваливает проверку типа. Метаданные деоптимизации связывают живые машинные значения с регистрами интерпретатора, чтобы продолжить исполнение с соответствующей позиции байт-кода.",
    thesis: "Деоптимизация — это перевод состояния, а не перезапуск.",
    caption:
      "Значения и слоты приведены для примера, это не снимок фрейма V8. Метаданные компиляции указывают, где находятся живые значения и как восстановить состояние интерпретатора, включая преобразование представления при необходимости.",
    optimized: "ОПТИМИЗИРОВАННЫЙ ФРЕЙМ",
    failure: "GUARD ПАДАЕТ",
    metadata: "МЕТАДАННЫЕ ДЕОПТА",
    interpreter: "ВОССТАНОВЛЕННЫЙ ФРЕЙМ IGNITION",
    resume: "продолжить с сохранённого смещения байт-кода",
    map1: "машинный регистр → слот интерпретатора",
    map2: "слот стека → слот интерпретатора",
    map3: "raw float64 → тегированное значение Number",
    map4: "входное значение → слот интерпретатора",
    scope: "УПРОЩЁННЫЙ ПРИМЕР V8",
  },
} as const;

const t = copy[lang];
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="canvas"
  variant="canvas"
>
  <div class="deopt-grid">
    <section class="frame opt">
      <div class="frame-head">
        <TechnicalLabel tone="accent" size="xs">{t.optimized}</TechnicalLabel>
        <TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel>
      </div>
      <div class="slots">
        <MachineValue name="register" value="i = 37" tone="accent" />
        <MachineValue name="stack slot" value="total = 120" />
        <MachineValue name="float64" value="ratio = 1.5" tone="warn" />
        <MachineValue name="input" value='"x" (not Smi)' tone="danger" />
      </div>
      <MachineValue value="CheckSmi(value) ✕" tone="danger" />
    </section>

    <div class="deopt-bridge">
      <TechnicalLabel tone="danger" size="xs">{t.failure}</TechnicalLabel>
      <span class="arrow" aria-hidden="true">→</span>
      <div class="metadata">
        <TechnicalLabel tone="muted" size="xs">{t.metadata}</TechnicalLabel>
        <code>{t.map1}</code>
        <code>{t.map2}</code>
        <code>{t.map3}</code>
        <code>{t.map4}</code>
        <MachineValue name="bytecode" value="resume point" tone="accent" size="sm" />
      </div>
      <span class="arrow" aria-hidden="true">→</span>
    </div>

    <section class="frame ignition">
      <TechnicalLabel tone="ok" size="xs">{t.interpreter}</TechnicalLabel>
      <div class="slots">
        <MachineValue name="slot i" value="37" tone="ok" />
        <MachineValue name="slot total" value="120" tone="ok" />
        <MachineValue name="slot ratio" value="Number(1.5)" tone="ok" />
        <MachineValue name="slot input" value='"x"' tone="ok" />
      </div>
      <div class="resume">
        <span aria-hidden="true">↳</span>
        <TechnicalLabel tone="ok" size="xs">{t.resume}</TechnicalLabel>
      </div>
    </section>
  </div>
</SkeinFigure>

<style>
  .deopt-grid {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(290px, 1.25fr) minmax(220px, 1fr);
    gap: 22px;
    align-items: center;
    min-width: 760px;
  }

  .frame {
    display: grid;
    gap: 14px;
    padding: 18px;
    border-top: 0.5px solid var(--hairline-strong);
    border-bottom: 0.5px solid var(--hairline-strong);
    background: color-mix(in srgb, var(--card) 68%, transparent);
  }

  .frame-head {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: baseline;
  }

  .slots {
    display: grid;
    gap: 7px;
    align-items: start;
  }

  .slots :global(.sk-mv) {
    width: fit-content;
  }

  .deopt-bridge {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px;
    align-items: center;
  }

  .deopt-bridge > :global(.sk-tech-label) {
    grid-column: 1 / -1;
    justify-self: center;
  }

  .metadata {
    display: grid;
    gap: 7px;
    padding: 14px 16px;
    border-left: 1px solid color-mix(in srgb, var(--d, var(--accent)) 52%, var(--hairline));
    background: color-mix(in srgb, var(--d, var(--accent)) 5%, transparent);
  }

  .metadata code {
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .arrow {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--d, var(--accent));
  }

  .resume {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ok);
  }

  .resume > span {
    font-family: var(--font-mono);
    font-size: 18px;
  }

  @media (max-width: 640px) {
    .deopt-grid { grid-template-columns: minmax(0, 1fr); min-width: 0; gap: 14px; }
    .deopt-bridge { grid-template-columns: minmax(0, 1fr); justify-items: stretch; }
    .deopt-bridge > :global(.sk-tech-label) { grid-column: auto; }
    .arrow { justify-self: center; transform: rotate(90deg); }
    .frame :global(.sk-mv) { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
    .metadata code { overflow-wrap: anywhere; }
  }
</style>
