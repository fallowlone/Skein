---
/**
 * ICStateStepper — Tier-A canvas figure (interactive).
 *
 * Shows one property-access site (`p.x`) evolving through the three
 * inline-cache states as receiver Maps are observed over time:
 *
 *   MONOMORPHIC  — one receiver Map; the slot holds one guarded entry
 *   POLYMORPHIC  — two Maps; the slot holds one entry per shape
 *   MEGAMORPHIC  — too many Maps; the slot gives up on shape guards
 *
 * Interaction replays causality: Step advances the observation feed, the
 * feedback slot updates, and the state label changes. All three states are
 * server-rendered in the DOM, so the full mechanism is readable with JS
 * off — the interaction replays the explanation, it is not the only path
 * to it. Zero hydration islands: the control script is `is:inline`
 * progressive enhancement.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "INLINE CACHE · STATE EVOLUTION",
    title: "Observation history decides the state of one access site",
    label: "Interactive stepper for one load site, p.x, observed across three receiver Maps. Step advances the observation feed; the FeedbackVector slot and the IC state label change with it.",
    thesis: "The slot's state is the history of what this site has seen — not a property of the code.",
    caption: "Monomorphic is the fast case. Polymorphic still serves per-shape guarded handlers. Megamorphic is the point where shape guards stop paying for themselves and the site falls back to the generic lookup path.",
    scope: "V8-SPECIFIC MODEL",
    callSite: "CALL SITE",
    feed: "OBSERVATION FEED",
    feedHint: "receivers observed, in order",
    slot: "FEEDBACKVECTOR SLOT",
    state: "IC STATE",
    step: "STEP",
    reset: "RESET",
    live: "IC state",
    mono: {
      name: "MONOMORPHIC",
      label: "IC STATE · MONOMORPHIC",
      body: "Every receiver so far shares one Map. The slot stores a single map-plus-handler pair, so the guard is one pointer comparison and the handler is a direct field load.",
      slotMap: "M_Point",
      slotHandler: "Smi(field #0)",
      slotNote: "1 entry · guard: map == M_Point",
    },
    poly: {
      name: "POLYMORPHIC",
      label: "IC STATE · POLYMORPHIC",
      body: "A second Map appeared. The slot now holds one guarded entry per shape — two pointer comparisons, each with its own handler. Still fast: the common case is checked first.",
      slotMap: "M_Point + M_Rect",
      slotHandler: "Smi(field #0) · Smi(field #1)",
      slotNote: "2 entries · guards checked in observation order",
    },
    mega: {
      name: "MEGAMORPHIC",
      label: "IC STATE · MEGAMORPHIC",
      body: "Too many Maps for guarded entries to pay off. The slot abandons shape-specific state and the site takes the generic path: a full map lookup on every access.",
      slotMap: "generic",
      slotHandler: "lookup at runtime",
      slotNote: "state given up · no per-shape guards",
    },
  },
  ru: {
    category: "INLINE CACHE · ЭВОЛЮЦИЯ СОСТОЯНИЯ",
    title: "История наблюдений решает состояние сайта доступа",
    label: "Интерактивный стepper для сайта загрузки p.x, наблюдаемого через три receiver Map. Шаг продвигает ленту наблюдений; слот FeedbackVector и метка IC-состояния меняются вместе с ней.",
    thesis: "Состояние слота — это история того, что видел этот сайт, а не свойство кода.",
    caption: "Мономорфный случай — быстрый. Полиморфный всё ещё обслуживает guarded handler на каждую форму. Мегаморфный — точка, где guards по формам перестают окупаться, и сайт уходит на общий путь lookup.",
    scope: "V8-СПЕЦИФИЧНАЯ МОДЕЛЬ",
    callSite: "САЙТ ДОСТУПА",
    feed: "ЛЕНТА НАБЛЮДЕНИЙ",
    feedHint: "наблюдённые receiver, по порядку",
    slot: "СЛОТ FEEDBACKVECTOR",
    state: "IC-СОСТОЯНИЕ",
    step: "ШАГ",
    reset: "СБРОС",
    live: "IC-состояние",
    mono: {
      name: "МОНОМОРФНЫЙ",
      label: "IC-СОСТОЯНИЕ · МОНОМОРФНЫЙ",
      body: "Все receiver до сих пор разделяют один Map. Слот хранит одну пару map-plus-handler, поэтому guard — это одно сравнение указателей, а handler — прямая загрузка поля.",
      slotMap: "M_Point",
      slotHandler: "Smi(field #0)",
      slotNote: "1 запись · guard: map == M_Point",
    },
    poly: {
      name: "ПОЛИМОРФНЫЙ",
      label: "IC-СОСТОЯНИЕ · ПОЛИМОРФНЫЙ",
      body: "Появился второй Map. Слот теперь хранит одну guarded запись на форму — два сравнения указателей, у каждого свой handler. Всё ещё быстро: частый случай проверяется первым.",
      slotMap: "M_Point + M_Rect",
      slotHandler: "Smi(field #0) · Smi(field #1)",
      slotNote: "2 записи · guards проверяются в порядке наблюдений",
    },
    mega: {
      name: "МЕГАМОРФНЫЙ",
      label: "IC-СОСТОЯНИЕ · МЕГАМОРФНЫЙ",
      body: "Слишком много Map, чтобы guarded записи окупались. Слот отказывается от state по формам, и сайт берёт общий путь: полный lookup по map при каждом доступе.",
      slotMap: "generic",
      slotHandler: "lookup в runtime",
      slotNote: "состояние сдано · нет guards по формам",
    },
  },
} as const;

const t = copy[lang];

// Observation sequences per state — the feed the stepper walks.
const feeds = {
  en: [
    ["M_Point"],
    ["M_Point", "M_Rect", "M_Point"],
    ["M_Point", "M_Rect", "M_User", "M_Str", "M_Arr", "…"],
  ],
  ru: [
    ["M_Point"],
    ["M_Point", "M_Rect", "M_Point"],
    ["M_Point", "M_Rect", "M_User", "M_Str", "M_Arr", "…"],
  ],
} as const;
const feed = feeds[lang];

const states = [
  { key: "mono", tone: "ok" as const, data: t.mono },
  { key: "poly", tone: "warn" as const, data: t.poly },
  { key: "mega", tone: "danger" as const, data: t.mega },
];
---

<SkeinFigure
  num="02"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="canvas"
  variant="canvas"
>
  <div class="icss" data-icss>
    <div class="icss-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="icss-call">
      <TechnicalLabel tone="muted" size="xs">{t.callSite}</TechnicalLabel>
      <MachineValue value="p.x" tone="accent" />
    </div>

    <section class="icss-feed" aria-label={t.feed}>
      <div class="icss-feed-head">
        <TechnicalLabel tone="muted" size="xs">{t.feed}</TechnicalLabel>
        <TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.feedHint}</TechnicalLabel>
      </div>
      <ol class="icss-feed-list">
        {feed.map((sequence, i) => (
          <li class="icss-seq" data-icss-seq={i} hidden={i !== 0}>
            {sequence.map((map, j) => (
              <MachineValue name={j === 0 ? "recv" : undefined} value={map} tone={i === 2 && j >= 3 ? "dim" : i === 1 ? "warn" : "accent"} />
            ))}
            {i === 2 && <span class="icss-more" aria-hidden="true">→ …</span>}
          </li>
        ))}
      </ol>
    </section>

    <section class="icss-slot" aria-label={t.slot}>
      <div class="icss-slot-head">
        <TechnicalLabel tone="muted" size="xs">{t.slot}</TechnicalLabel>
        <TechnicalLabel tone="accent" size="xs" class="icss-state-label" data-icss-state-label>{t.state}: {states[0].data.name}</TechnicalLabel>
      </div>

      <div class="icss-states">
        {states.map((s, i) => (
          <article class="icss-state" data-icss-state={s.key} hidden={i !== 0}>
            <p class="icss-state-name">
              <TechnicalLabel tone={s.tone} size="xs">{s.data.label}</TechnicalLabel>
            </p>
            <p class="icss-state-body">{s.data.body}</p>
            <div class="icss-slot-entries">
              <MachineValue name="map" value={s.data.slotMap} tone={s.tone} />
              <MachineValue name="handler" value={s.data.slotHandler} tone={s.tone} size="sm" />
              <span class="icss-slot-note">{s.data.slotNote}</span>
            </div>
          </article>
        ))}
      </div>

      <p class="icss-live" data-icss-live aria-live="polite">{t.live}: {states[0].data.name}</p>
    </section>

    <div class="icss-controls">
      <button type="button" class="icss-btn" data-icss-step>
        {t.step} <span aria-hidden="true">▸</span>
      </button>
      <button type="button" class="icss-btn icss-btn-ghost" data-icss-reset>{t.reset}</button>
    </div>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the three states. All states are already
  // in the DOM (index 0 visible), so no-JS readers see the monomorphic
  // state and its explanation; this script only replays the causality.
  (() => {
    const roots = document.querySelectorAll("[data-icss]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const seqs = root.querySelectorAll("[data-icss-seq]");
      const states = root.querySelectorAll("[data-icss-state]");
      const label = root.querySelector("[data-icss-state-label]");
      const live = root.querySelector("[data-icss-live]");
      const stepBtn = root.querySelector("[data-icss-step]");
      const resetBtn = root.querySelector("[data-icss-reset]");
      if (!seqs.length || !states.length || !stepBtn) continue;

      let index = 0;
      const names = Array.from(states).map((el) => {
        const nameEl = el.querySelector(".icss-state-name");
        return nameEl ? nameEl.textContent?.replace(/^IC[- ]STATE ·\s*/i, "").trim() : "";
      });
      const livePrefix = live ? live.textContent?.split(":")[0] ?? "" : "";

      const show = (i: number) => {
        seqs.forEach((el, j) => { el.toggleAttribute("hidden", j !== i); });
        states.forEach((el, j) => { el.toggleAttribute("hidden", j !== i); });
        if (label && names[i]) label.textContent = label.textContent?.replace(/[^:]+$/, names[i]);
        if (live && names[i]) live.textContent = `${livePrefix}: ${names[i]}`;
      };

      stepBtn.addEventListener("click", () => {
        index = (index + 1) % states.length;
        show(index);
      });
      resetBtn?.addEventListener("click", () => {
        index = 0;
        show(0);
      });
      if (!reduceMotion) show(0);
    }
  })();
</script>

<style>
  .icss {
    min-width: 930px;
    display: grid;
    gap: 24px;
  }

  .icss-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .icss-call {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-left: 12px;
    border-left: 0.5px solid var(--hairline-strong);
  }

  .icss-feed,
  .icss-slot {
    display: grid;
    gap: 12px;
    padding-block: 6px 18px;
    border-bottom: 0.5px solid var(--hairline-2);
  }

  .icss-slot {
    border-bottom: 0;
    padding-bottom: 4px;
  }

  .icss-feed-head,
  .icss-slot-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .icss-feed-list {
    display: grid;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .icss-seq {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .icss-more {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .icss-state-name {
    margin: 0;
  }

  .icss-state-body {
    margin: 0;
    max-width: 780px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .icss-slot-entries {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 0.5px dashed var(--hairline-2);
  }

  .icss-slot-note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .icss-live {
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .icss-controls {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }

  .icss-btn {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 9px 18px;
    border-radius: var(--r-sm);
    border: 0.5px solid var(--hairline-strong);
    background: var(--card);
    color: var(--ink);
    transition: background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  .icss-btn:hover { border-color: var(--accent); }
  .icss-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .icss-btn:active { transform: translateY(1px); }
  .icss-btn-ghost {
    background: transparent;
    color: var(--muted);
  }
  .icss-btn-ghost:hover { color: var(--ink); }

  @media (prefers-reduced-motion: no-preference) {
    .icss-state {
      animation: icss-state-in var(--dur-2) var(--ease) both;
    }
    @keyframes icss-state-in {
      from { opacity: 0; transform: translateY(-4px); }
      to   { opacity: 1; transform: none; }
    }
  }

  @media (max-width: 1100px) {
    .icss { min-width: 0; }
  }

  @media (max-width: 640px) {
    .icss { gap: 18px; }
    .icss-call { flex-wrap: wrap; }
    .icss-state-body { font-size: 13px; }
    .icss-slot-entries { row-gap: 6px; }
    .icss-controls { justify-content: stretch; }
    .icss-btn { flex: 1 1 auto; }
  }
</style>
