---
/**
 * NetCardsFig — a set of peer items as a card grid, optionally grouped (each card lists
 * children). Replaces hierarchy-tree and quadrant infographics in the networking track.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";

interface Card { label: string; desc?: string; items?: string[] }
interface Props { title?: string; desc?: string; cards: Card[]; label: string; caption?: string; hue?: string; lang?: string }
const { title, desc, cards, label, caption, hue = "var(--d-network)" } = Astro.props;
---

<SkeinFigure label={label} caption={caption} span="learning" hue={hue}>
  <div class="netf-root" role="group" aria-label={label}>
    {(title || desc) && (
      <div class="netf-head">
        {title && <h4 class="netf-head-title">{title}</h4>}
        {desc && <p class="netf-head-desc">{desc}</p>}
      </div>
    )}
    <ul class="netcards">
      {cards.map((c, i) => (
        <li class="netcard" style={`--k:${i}`}>
          <span class="netcard-label">{c.label}</span>
          {c.desc && <span class="netcard-desc">{c.desc}</span>}
          {c.items && c.items.length > 0 && <ul class="netcard-items">{c.items.map((it) => <li>{it}</li>)}</ul>}
        </li>
      ))}
    </ul>
  </div>
</SkeinFigure>

<style>
  .netcards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; }
  .netcard { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; border: 1px solid var(--hairline-2); border-top: 3px solid var(--d, var(--accent)); border-radius: var(--r-sm); background: var(--card); }
  .netcard-label { font: 600 14px/1.35 var(--font-body); color: var(--ink); overflow-wrap: anywhere; }
  .netcard-desc { font: 13px/1.5 var(--font-body); color: var(--ink-2); overflow-wrap: anywhere; }
  .netcard-items { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .netcard-items li { font: 12px/1.3 var(--font-mono); color: var(--ink-2); padding: 4px 8px; border-radius: 999px; background: color-mix(in srgb, var(--d, var(--accent)) 9%, transparent); overflow-wrap: anywhere; }
</style>
