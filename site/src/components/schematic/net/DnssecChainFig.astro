---
/**
 * DnssecChainFig — the chain of trust from the root anchor to one A record, with failure scenarios.
 * Answers: "Which link broke, and why do only some users see SERVFAIL?"
 * Four scenarios (healthy, KSK rollover without a DS update, expired RRSIG, unsigned zone) show
 * the three validation outcomes, secure / bogus / insecure, for validating and non-validating resolvers.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";
import MachineValue from "../MachineValue.astro";

interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}
const { lang = "en", span = "learning" } = Astro.props;

type Scenario = "healthy" | "rollover" | "expired" | "unsigned";
type LinkState = "ok" | "broken" | "absent";
const SCENARIOS: { id: Scenario; links: LinkState[]; result: "secure" | "bogus" | "insecure" }[] = [
  { id: "healthy", links: ["ok", "ok", "ok", "ok"], result: "secure" },
  { id: "rollover", links: ["ok", "ok", "broken", "ok"], result: "bogus" },
  { id: "expired", links: ["ok", "ok", "ok", "broken"], result: "bogus" },
  { id: "unsigned", links: ["ok", "ok", "absent", "absent"], result: "insecure" },
];

const copy = {
  en: {
    category: "CHAIN OF TRUST",
    title: "Break one link and watch who notices",
    label: "Interactive DNSSEC chain from the root trust anchor down to the A record of example.com, with four scenarios: healthy, a KSK rollover that forgot to update the DS record in the parent, an expired RRSIG on the A record, and an unsigned zone. For each, the figure shows what a validating and a non-validating resolver return.",
    thesis: "A broken chain is not an outage for everyone: only validating resolvers refuse the answer.",
    caption: "Roughly a third of users sit behind validating resolvers (Cloudflare, Google, Quad9, many ISPs), so a DNSSEC mistake looks like a random partial outage.",
    zones: [
      { name: "Trust anchor", rec: "root KSK digest · built into the resolver" },
      { name: ". (root)", rec: "DNSKEY: KSK + ZSK" },
      { name: "com.", rec: "DS in root · DNSKEY: KSK + ZSK" },
      { name: "example.com.", rec: "DS in com. · DNSKEY: KSK + ZSK" },
      { name: "example.com. A", rec: "203.0.113.10 + RRSIG" },
    ],
    scenK: "Scenario",
    scen: { healthy: "Healthy chain", rollover: "KSK rolled, DS not updated", expired: "RRSIG expired", unsigned: "Zone not signed" },
    link: ["anchor matches the root KSK", "root ZSK signs com. DS = hash(com. KSK)", "com. DS = hash(example.com. KSK)", "example.com. ZSK signature over the A RRset"],
    linkState: { ok: "verified", broken: "fails", absent: "no DS: chain ends", skipped: "not checked" },
    validating: "Validating resolver", nonValidating: "Non-validating resolver",
    res: {
      secure: ["SECURE", "Answer with AD=1"], bogus: ["BOGUS", "SERVFAIL, no answer"], insecure: ["INSECURE", "Answer, AD=0"],
      plain: ["NOT CHECKED", "Answer, AD=0"],
    },
    why: {
      healthy: "Every DS in a parent matches the child's KSK and every RRSIG verifies, so the resolver can prove the answer came from the zone owner unmodified.",
      rollover: "example.com published a new KSK but the com. zone still holds the DS hash of the old one. The resolver cannot link the zones, marks the answer bogus, and returns SERVFAIL rather than an unproven address.",
      expired: "RRSIGs carry an expiry date. If re-signing stops (a broken cron job, a frozen signer), signatures lapse and every validating resolver starts failing at once when caches empty.",
      unsigned: "com. proves, with a signed denial, that example.com has no DS. The zone is provably unsigned, so the resolver returns the answer as insecure. Not protected, but not broken.",
    },
  },
  ru: {
    category: "ЦЕПОЧКА ДОВЕРИЯ",
    title: "Сломай одно звено и посмотри, кто заметит",
    label: "Интерактивная цепочка DNSSEC от root trust anchor до A-записи example.com с четырьмя сценариями: исправная цепочка, rollover KSK без обновления DS у родителя, истёкший RRSIG на A-записи и неподписанная зона. Для каждого показано, что вернут валидирующий и невалидирующий резолверы.",
    thesis: "Сломанная цепочка — сбой не для всех: ответ отвергают только валидирующие резолверы.",
    caption: "Примерно треть пользователей сидит за валидирующими резолверами (Cloudflare, Google, Quad9, многие провайдеры), поэтому ошибка DNSSEC выглядит как случайный частичный сбой.",
    zones: [
      { name: "Trust anchor", rec: "digest root KSK · встроен в резолвер" },
      { name: ". (root)", rec: "DNSKEY: KSK + ZSK" },
      { name: "com.", rec: "DS в root · DNSKEY: KSK + ZSK" },
      { name: "example.com.", rec: "DS в com. · DNSKEY: KSK + ZSK" },
      { name: "example.com. A", rec: "203.0.113.10 + RRSIG" },
    ],
    scenK: "Сценарий",
    scen: { healthy: "Цепочка исправна", rollover: "KSK сменён, DS не обновлён", expired: "RRSIG истёк", unsigned: "Зона не подписана" },
    link: ["anchor совпадает с root KSK", "root ZSK подписывает DS com. = hash(KSK com.)", "DS com. = hash(KSK example.com.)", "подпись ZSK example.com. над A RRset"],
    linkState: { ok: "проверено", broken: "не сходится", absent: "нет DS: цепочка кончается", skipped: "не проверяется" },
    validating: "Валидирующий резолвер", nonValidating: "Невалидирующий резолвер",
    res: {
      secure: ["SECURE", "Ответ с AD=1"], bogus: ["BOGUS", "SERVFAIL, ответа нет"], insecure: ["INSECURE", "Ответ, AD=0"],
      plain: ["НЕ ПРОВЕРЯЕТ", "Ответ, AD=0"],
    },
    why: {
      healthy: "Каждый DS у родителя совпадает с KSK потомка, и каждый RRSIG проверяется, поэтому резолвер может доказать, что ответ пришёл от владельца зоны без изменений.",
      rollover: "example.com опубликовал новый KSK, а зона com. всё ещё хранит DS-хэш старого. Резолвер не может связать зоны, помечает ответ как bogus и возвращает SERVFAIL вместо недоказанного адреса.",
      expired: "У RRSIG есть срок действия. Если переподпись остановилась (сломанный cron, замёрзший signer), подписи истекают, и все валидирующие резолверы начинают падать разом, как только опустеют кэши.",
      unsigned: "com. доказывает подписанным отрицанием, что у example.com нет DS. Зона доказуемо не подписана, поэтому резолвер возвращает ответ как insecure. Не защищено, но и не сломано.",
    },
  },
}[lang];
const tone = { secure: "ok", bogus: "danger", insecure: "warn" } as const;
---

<SkeinFigure num="04" category={copy.category} title={copy.title} label={copy.label} thesis={copy.thesis} caption={copy.caption} span={span} hue="var(--d-network)">
  <div class="netf-root" data-netf-dnssec data-sf-all role="group" aria-label={copy.title}>
    <div class="netf-seg netf-js-only" role="group" aria-label={copy.scenK}>
      <span class="netf-seg-k">{copy.scenK}</span>
      {SCENARIOS.map((s) => <button type="button" class="netf-chip" data-sf-mode={s.id} aria-pressed={s.id === "healthy" ? "true" : "false"}>{copy.scen[s.id]}</button>)}
    </div>

    {SCENARIOS.map((s) => (
      <article class="netf-panel" data-sf-panel data-sf-group={s.id} data-sf-default={s.id === "healthy" ? "" : undefined} aria-label={copy.scen[s.id]}>
        <span class="netf-kicker netf-nojs-only">{copy.scen[s.id]}</span>
        <div class="dnsc-layout">
          <ol class="dnsc-chain">
            {copy.zones.map((z, i) => {
              const before = i === 0 ? "ok" : s.links[i - 1];
              const label = before === "absent" && i > 1 && s.links[i - 2] === "absent" ? "skipped" : before;
              const reached = i === 0 || s.links.slice(0, i).every((l) => l === "ok");
              return (
                <li class="dnsc-item">
                  {i > 0 && (
                    <div class="dnsc-link" data-state={before}>
                      <span class="dnsc-link-mark" aria-hidden="true">{before === "ok" ? "✓" : before === "broken" ? "✕" : "∅"}</span>
                      <span class="dnsc-link-text">{copy.link[i - 1]}</span>
                      <span class="dnsc-link-state">{copy.linkState[label]}</span>
                    </div>
                  )}
                  <div class="dnsc-zone" data-reached={reached ? "" : undefined}>
                    <span class="dnsc-zone-name">{z.name}</span>
                    <span class="dnsc-zone-rec">{z.rec}</span>
                  </div>
                </li>
              );
            })}
          </ol>

          <div class="dnsc-out">
            <div class="dnsc-res" data-tone={tone[s.result]}>
              <span class="netf-k">{copy.validating}</span>
              <MachineValue size="md" tone={tone[s.result]} val={copy.res[s.result][0]} />
              <span class="dnsc-res-v">{copy.res[s.result][1]}</span>
            </div>
            <div class="dnsc-res" data-tone="dim">
              <span class="netf-k">{copy.nonValidating}</span>
              <MachineValue size="md" tone="dim" val={copy.res.plain[0]} />
              <span class="dnsc-res-v">{copy.res.plain[1]}</span>
            </div>
            <p class="netf-note">{copy.why[s.id]}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</SkeinFigure>

<style>
  .dnsc-layout { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .dnsc-chain { list-style: none; margin: 0; padding: 0; }
  .dnsc-zone { display: flex; flex-direction: column; gap: 2px; padding: 10px 14px; border: 1px solid var(--hairline-2); border-radius: var(--r-sm); background: var(--card); opacity: 0.55; }
  .dnsc-zone[data-reached] { opacity: 1; }
  .dnsc-zone-name { font: 600 13.5px/1.3 var(--font-mono); color: var(--ink); }
  .dnsc-zone-rec { font: 12px/1.4 var(--font-body); color: var(--muted); }
  .dnsc-link { display: grid; grid-template-columns: 22px 1fr auto; align-items: center; gap: 8px; margin-left: 18px; padding: 8px 0 8px 14px; border-left: 2px solid var(--ok); }
  .dnsc-link[data-state="broken"] { border-left: 2px dashed var(--danger); }
  .dnsc-link[data-state="absent"] { border-left: 2px dotted var(--hairline-strong); }
  .dnsc-link-mark { font: 700 13px/1 var(--font-mono); color: var(--ok); }
  .dnsc-link[data-state="broken"] .dnsc-link-mark, .dnsc-link[data-state="broken"] .dnsc-link-state { color: var(--danger); }
  .dnsc-link[data-state="absent"] .dnsc-link-mark, .dnsc-link[data-state="absent"] .dnsc-link-state { color: var(--muted); }
  .dnsc-link-text { font: 12px/1.4 var(--font-body); color: var(--ink-2); }
  .dnsc-link-state { font: 600 10px/1.2 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ok); white-space: nowrap; }
  .dnsc-out { display: flex; flex-direction: column; gap: 12px; }
  .dnsc-res { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px; border-radius: var(--r-sm); border: 1px solid var(--hairline-2); border-left-width: 3px; background: var(--card); }
  .dnsc-res[data-tone="ok"] { border-left-color: var(--ok); }
  .dnsc-res[data-tone="danger"] { border-left-color: var(--danger); }
  .dnsc-res[data-tone="warn"] { border-left-color: var(--warn); }
  .dnsc-res-v { font: 500 14px/1.4 var(--font-body); color: var(--ink); }
  @media (max-width: 720px) { .dnsc-layout { grid-template-columns: 1fr; } .dnsc-link { grid-template-columns: 22px 1fr; } .dnsc-link-state { grid-column: 2; } }
</style>

<script>
  import { initModes, onEachRoot } from "./stepper";
  onEachRoot("[data-netf-dnssec]", initModes);
</script>
