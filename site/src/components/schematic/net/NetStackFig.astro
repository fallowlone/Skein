---
/**
 * NetStackFig — ordered layers (protocol stack, chain, header fields) as numbered strata.
 * Drop-in for StackDiagram (same layers/label/caption/hue props). Label and note sit in a
 * two-column grid that collapses to one column on narrow screens, so long notes wrap.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";

interface Layer { label: string; note?: string }
interface Props { layers: Layer[]; label: string; caption?: string; hue?: string; title?: string; desc?: string; lang?: string }
const { layers, label, caption, hue = "var(--d-network)", title, desc } = Astro.props;
---

<SkeinFigure label={label} caption={caption} span="learning" hue={hue}>
  <div class="netf-root">
    {(title || desc) && (
      <div class="netf-head">
        {title && <h4 class="netf-head-title">{title}</h4>}
        {desc && <p class="netf-head-desc">{desc}</p>}
      </div>
    )}
  <ol class="netstack" aria-label={label}>
    {layers.map((l, i) => (
      <li class="netstack-layer" style={`--t:${layers.length > 1 ? i / (layers.length - 1) : 0}`}>
        <span class="netstack-i" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <span class="netstack-label">{l.label}</span>
        {l.note && <span class="netstack-note">{l.note}</span>}
      </li>
    ))}
  </ol>
  </div>
</SkeinFigure>

<style>
  .netstack { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .netstack-layer {
    display: grid; grid-template-columns: 32px minmax(120px, 0.9fr) minmax(0, 1.6fr); align-items: baseline; gap: 4px 14px;
    padding: 12px 16px; border-radius: var(--r-sm); border: 1px solid var(--hairline-2);
    border-left: 3px solid color-mix(in srgb, var(--d, var(--accent)) calc(45% + var(--t) * 55%), var(--hairline));
    background: color-mix(in srgb, var(--d, var(--accent)) calc(3% + var(--t) * 8%), var(--card));
  }
  .netstack-i { font: 700 11px/1.3 var(--font-mono); color: var(--d, var(--accent)); }
  .netstack-label { font: 600 14px/1.35 var(--font-body); color: var(--ink); overflow-wrap: anywhere; }
  .netstack-note { font: 12.5px/1.45 var(--font-mono); color: var(--ink-2); overflow-wrap: anywhere; }
  @media (max-width: 560px) {
    .netstack-layer { grid-template-columns: 28px minmax(0, 1fr); }
    .netstack-note { grid-column: 2; }
  }
</style>
