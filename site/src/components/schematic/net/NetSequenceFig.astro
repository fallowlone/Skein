---
/**
 * NetSequenceFig — a message exchange between actors, shown all at once or step by step.
 * Drop-in for SequenceDiagram (same actors/messages/label/caption/hue props) in the networking
 * track. Geometry lives in SVG; every word lives in HTML, so labels wrap and never overlap lines.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";
import { arcPath, placeAlongArcs } from "./geometry";
import { UI, type Lang } from "./i18n";

interface Msg { from: string; to: string; label: string; note?: string }
interface Props { actors: string[]; messages: Msg[]; label: string; caption?: string; hue?: string; lang?: Lang; title?: string; desc?: string }
const { actors, messages, label, caption, hue = "var(--d-network)", lang = "en", title, desc } = Astro.props;
const ui = UI[lang];

const COL = 160, ROW = 90, H = 180;
const W = actors.length * COL;
const ax = (name: string) => (Math.max(0, actors.indexOf(name)) + 0.5) * COL;
// Repeat messages over the same directed pair fan out by 14 units each, so the arcs never bundle.
const occ = messages.map((m, k) => messages.slice(0, k).filter((p) => p.from === m.from && p.to === m.to).length);
const lift = (m: Msg, k = 0) => Math.min(48, 22 + 12 * Math.abs(actors.indexOf(m.from) - actors.indexOf(m.to))) + Math.min(occ[k] ?? 0, 4) * 14;
const uid = label.replace(/[^a-z0-9]/gi, "").toLowerCase().slice(0, 20) || "seq";
const loop = (x: number) => `M${x - 8} ${ROW - 13} C${x - 26} ${ROW - 50} ${x + 26} ${ROW - 50} ${x + 8} ${ROW - 13}`;
const path = (m: Msg, k = 0) => (m.from === m.to ? loop(ax(m.from)) : arcPath(ax(m.from), ax(m.to), ROW, lift(m, k)));
const badges = placeAlongArcs(messages.map((m, k) => ({ x1: ax(m.from), x2: ax(m.to), lift: lift(m, k), loop: m.from === m.to })), ROW, 22, actors.map((a) => ({ x: ax(a), y: ROW })));
---

<SkeinFigure label={label} caption={caption} span="learning" hue={hue}>
  <div class="netf-root" data-sf-root data-netf-seq data-lang={lang} tabindex="0" role="group" aria-label={label}>
    {(title || desc) && (
      <div class="netf-head">
        {title && <h4 class="netf-head-title">{title}</h4>}
        {desc && <p class="netf-head-desc">{desc}</p>}
      </div>
    )}
    <div class="netf-seg netf-js-only" role="group" aria-label={ui.viewK}>
      <button type="button" class="netf-chip" data-sf-mode="all" aria-pressed="true">{ui.overview}</button>
      <button type="button" class="netf-chip" data-sf-mode="step" aria-pressed="false">{ui.stepwise}</button>
    </div>

    <article class="netf-panel" data-sf-panel data-sf-group="all" data-sf-default="">
      <div class="netf-stage">
        <svg viewBox={`0 0 ${W} ${H}`} class="netf-svg" style={`min-width:${Math.min(560, actors.length * 120)}px`} aria-hidden="true">
          <defs>
            <marker id={`${uid}-a`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--d, var(--accent))" /></marker>
          </defs>
          {messages.map((m, k) => <path d={path(m, k)} fill="none" stroke="var(--d, var(--accent))" stroke-width="1.6" opacity="0.75" marker-end={`url(#${uid}-a)`} />)}
          {actors.map((a) => <circle cx={ax(a)} cy={ROW} r="11" fill="var(--card)" stroke="var(--d, var(--accent))" stroke-width="1.6" />)}
          {messages.map((_, k) => { const p = badges[k]; return (
            <g><circle cx={p.x} cy={p.y} r="9" fill="var(--paper)" stroke="var(--d, var(--accent))" stroke-width="1.2" /><text x={p.x} y={p.y + 3.5} text-anchor="middle" class="netseq-num">{k + 1}</text></g>
          ); })}
        </svg>
        <div class="netseq-actors" style={`--n:${actors.length};min-width:${Math.min(560, actors.length * 120)}px`}>{actors.map((a) => <span>{a}</span>)}</div>
      </div>
      <ol class="netseq-list">
        {messages.map((m, k) => (
          <li><span class="netseq-n" aria-hidden="true">{k + 1}</span><span class="netseq-item"><span class="netseq-route">{m.from} → {m.to}</span><span class="netf-msg">{m.label}</span>{m.note && <span class="netf-note">{m.note}</span>}</span></li>
        ))}
      </ol>
    </article>

    {messages.map((m, i) => (
      <article class="netf-panel" data-sf-panel data-sf-group="step" hidden>
        <div class="netf-stage">
          <svg viewBox={`0 0 ${W} ${H}`} class="netf-svg" style={`min-width:${Math.min(560, actors.length * 120)}px`} aria-hidden="true">
            <defs>
              <marker id={`${uid}-s${i}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--d, var(--accent))" /></marker>
            </defs>
            {messages.slice(0, i).map((p, k) => <path d={path(p, k)} fill="none" stroke="var(--hairline-strong)" stroke-width="1.2" stroke-dasharray="3 3" />)}
            <path d={path(m, i)} fill="none" stroke="var(--d, var(--accent))" stroke-width="2.4" marker-end={`url(#${uid}-s${i})`} />
            {actors.map((a) => {
              const on = a === m.from || a === m.to;
              return <circle cx={ax(a)} cy={ROW} r="11" fill={on ? "color-mix(in srgb, var(--d, var(--accent)) 18%, var(--card))" : "var(--card)"} stroke={on ? "var(--d, var(--accent))" : "var(--hairline-2)"} stroke-width={on ? 1.8 : 1} />;
            })}
          </svg>
          <div class="netseq-actors" style={`--n:${actors.length};min-width:${Math.min(560, actors.length * 120)}px`}>{actors.map((a) => <span data-on={a === m.from || a === m.to ? "" : undefined}>{a}</span>)}</div>
        </div>
        <span class="netf-kicker">{ui.step(i + 1, messages.length)} · {m.from} → {m.to}</span>
        <p class="netf-msg netf-msg-lg">{m.label}</p>
        {m.note && <p class="netf-note">{m.note}</p>}
      </article>
    ))}

    <div class="netf-controls netf-js-only" data-seq-controls hidden>
      <button type="button" class="netf-btn" data-sf-prev>← {ui.prev}</button>
      <span class="netf-count" data-sf-count aria-live="polite"></span>
      <button type="button" class="netf-btn" data-sf-next>{ui.next} →</button>
    </div>
  </div>
</SkeinFigure>

<style>
  .netseq-num { font-family: var(--font-mono); font-size: 10px; font-weight: 700; fill: var(--ink); }
  .netseq-actors { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); padding-top: 2px; }
  .netseq-actors span { text-align: center; padding: 0 4px; font: 600 12.5px/1.3 var(--font-body); color: var(--ink); overflow-wrap: anywhere; }
  .netseq-actors span:not([data-on]) { color: var(--ink-2); }
  .netseq-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .netseq-list li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 10px; align-items: start; }
  .netseq-n { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font: 700 10.5px/1 var(--font-mono); color: var(--d, var(--accent)); border: 1.2px solid var(--d, var(--accent)); }
  .netseq-item { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .netseq-route { font: 600 10.5px/1.3 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
</style>

<script>
  import { initStepper, onEachRoot } from "./stepper";
  import { stepCount } from "./i18n";
  onEachRoot("[data-netf-seq]", (root) => {
    initStepper(root, stepCount(root.dataset.lang ?? "en"));
    const controls = root.querySelector<HTMLElement>("[data-seq-controls]");
    const sync = () => { if (controls) controls.hidden = root.querySelector('[data-sf-mode="step"]')?.getAttribute("aria-pressed") !== "true"; };
    root.querySelectorAll("[data-sf-mode]").forEach((b) => b.addEventListener("click", sync));
    sync();
  });
</script>
