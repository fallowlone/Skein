---
/**
 * DnsTtlSimFig — a resolver cache simulated over two hours for a chosen TTL and query rate.
 * Answers: "What does a TTL buy (hits, authoritative load) and what does it cost (staleness)?"
 * Arrivals are Poisson (seeded, so the picture is stable); the readout uses the closed form
 * hit rate = λT / (1 + λT). The record changes at minute 75, so stale answers are visible.
 * Without JS a static table of the closed-form values renders instead.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";
import { hitRate } from "./ttl-sim";

interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}
const { lang = "en", span = "learning" } = Astro.props;

const TTLS = [60, 300, 3600, 86400];
const RATES = [10, 100, 1000];


const copy = {
  en: {
    category: "CACHE ECONOMICS",
    title: "What a TTL buys, and what it costs",
    label: "Interactive simulation of a resolver cache over two hours. Choose a TTL and a query rate; the timeline marks cache misses, hits, and stale hits served after the record changes at minute 75, and the readout shows hit rate, queries reaching the authoritative server per hour, and the worst-case staleness.",
    thesis: "A longer TTL buys hits with staleness, and past an hour it mostly buys staleness.",
    caption: "Poisson arrivals; hit rate = λT / (1 + λT), where λ is queries per second and T is the TTL. The record changes at minute 75.",
    ttlK: "TTL", rateK: "Queries per hour",
    ttlLabels: ["60 s", "300 s", "1 h", "1 day"], rateLabels: ["10 / h", "100 / h", "1000 / h"],
    hitK: "Cache hit rate", authK: "Queries to authoritative / h", staleK: "Worst-case staleness",
    legend: { miss: "miss: walk the tree", hit: "hit", stale: "stale hit: old IP", band: "entry cached", change: "record changes" },
    axis: ["0 min", "75 min", "120 min"],
    durations: ["1 min", "5 min", "1 h", "1 day"],
    tableK: ["TTL", "Hit rate at 10 queries / h"],
  },
  ru: {
    category: "ЭКОНОМИКА КЭША",
    title: "Что покупает TTL и чего он стоит",
    label: "Интерактивная симуляция кэша резолвера за два часа. Выберите TTL и частоту запросов; на шкале отмечены промахи, попадания и устаревшие попадания после смены записи на 75-й минуте, а табло показывает долю попаданий, число запросов к authoritative в час и худший случай устаревания.",
    thesis: "Длинный TTL покупает попадания ценой устаревания, а после часа покупает в основном устаревание.",
    caption: "Пуассоновский поток; доля попаданий = λT / (1 + λT), где λ — запросов в секунду, T — TTL. Запись меняется на 75-й минуте.",
    ttlK: "TTL", rateK: "Запросов в час",
    ttlLabels: ["60 с", "300 с", "1 ч", "1 день"], rateLabels: ["10 / ч", "100 / ч", "1000 / ч"],
    hitK: "Доля попаданий", authK: "Запросов к authoritative / ч", staleK: "Худшее устаревание",
    legend: { miss: "промах: обход дерева", hit: "попадание", stale: "устаревшее: старый IP", band: "запись в кэше", change: "смена записи" },
    axis: ["0 мин", "75 мин", "120 мин"],
    durations: ["1 мин", "5 мин", "1 ч", "1 день"],
    tableK: ["TTL", "Доля попаданий при 10 запросах / ч"],
  },
}[lang];

---

<SkeinFigure num="03" category={copy.category} title={copy.title} label={copy.label} thesis={copy.thesis} caption={copy.caption} span={span} hue="var(--d-network)">
  <div class="netf-root" data-netf-ttl data-lang={lang} data-durations={JSON.stringify(copy.durations)} role="group" aria-label={copy.title}>
    <div class="netf-grid netf-js-only">
      <div class="netf-seg" role="group" aria-label={copy.ttlK}>
        <span class="netf-seg-k">{copy.ttlK}</span>
        {TTLS.map((t, i) => <button type="button" class="netf-chip" data-ttl={t} aria-pressed={t === 300 ? "true" : "false"}>{copy.ttlLabels[i]}</button>)}
      </div>
      <div class="netf-seg" role="group" aria-label={copy.rateK}>
        <span class="netf-seg-k">{copy.rateK}</span>
        {RATES.map((r, i) => <button type="button" class="netf-chip" data-rate={r} aria-pressed={r === 10 ? "true" : "false"}>{copy.rateLabels[i]}</button>)}
      </div>
    </div>

    <div class="netf-readout netf-js-only" aria-live="polite">
      <div class="netf-metric"><span class="netf-k">{copy.hitK}</span><span class="netf-metric-v" data-out-hit>—</span></div>
      <div class="netf-metric"><span class="netf-k">{copy.authK}</span><span class="netf-metric-v" data-out-auth>—</span></div>
      <div class="netf-metric"><span class="netf-k">{copy.staleK}</span><span class="netf-metric-v netf-tone-warn" data-out-stale>—</span></div>
    </div>

    <div class="netf-stage netf-js-only">
      <svg viewBox="0 0 640 132" class="netf-svg" style="min-width:0" aria-hidden="true" data-out-svg></svg>
    </div>
    <ul class="dnst-legend netf-js-only">
      <li><i class="dnst-sw dnst-miss"></i>{copy.legend.miss}</li>
      <li><i class="dnst-sw dnst-hit"></i>{copy.legend.hit}</li>
      <li><i class="dnst-sw dnst-stale"></i>{copy.legend.stale}</li>
      <li><i class="dnst-sw dnst-band"></i>{copy.legend.band}</li>
      <li><i class="dnst-sw dnst-change"></i>{copy.legend.change}</li>
    </ul>
    <p class="netf-note netf-js-only" data-out-note></p>
    <span hidden data-axis={JSON.stringify(copy.axis)}></span>

    <table class="dnst-table netf-nojs-only">
      <thead><tr><th>{copy.tableK[0]}</th><th>{copy.tableK[1]}</th></tr></thead>
      <tbody>{TTLS.map((t, i) => <tr><td>{copy.ttlLabels[i]}</td><td>{Math.round(hitRate(10, t) * 100)}%</td></tr>)}</tbody>
    </table>
  </div>
</SkeinFigure>

<style>
  .dnst-legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font: 12px/1.4 var(--font-body); color: var(--muted); }
  .dnst-legend li { display: flex; align-items: center; gap: 6px; }
  .dnst-sw { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }
  .dnst-miss { background: var(--danger); }
  .dnst-hit { background: var(--ok); }
  .dnst-stale { background: var(--warn); }
  .dnst-band { border-radius: 2px; background: color-mix(in srgb, var(--d, var(--accent)) 22%, transparent); }
  .dnst-change { width: 2px; border-radius: 0; height: 12px; background: var(--ink); }
  .dnst-table { border-collapse: collapse; font: 13px/1.5 var(--font-body); }
  .dnst-table th, .dnst-table td { text-align: left; padding: 6px 16px 6px 0; border-bottom: 0.5px solid var(--hairline); }
  .dnst-table th { font: 700 10px/1.4 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
</style>

<script>
  import { onEachRoot } from "./stepper";
  import { simulateCache, hitRate } from "./ttl-sim";

  const X0 = 20, X1 = 620, WINDOW_S = 7200, CHANGE_S = 4500;
  const xOf = (s: number) => X0 + ((X1 - X0) * s) / WINDOW_S;

  function fmtDuration(ttl: number, labels: string[]): string {
    return labels[[60, 300, 3600, 86400].indexOf(ttl)] ?? `${ttl} s`;
  }

  onEachRoot("[data-netf-ttl]", (root) => {
    if (root.dataset.js) return;
    const ru = root.dataset.lang === "ru";
    const durations: string[] = JSON.parse(root.dataset.durations ?? "[]");
    const axis: string[] = JSON.parse(root.querySelector<HTMLElement>("[data-axis]")?.dataset.axis ?? "[]");
    const svg = root.querySelector<SVGSVGElement>("[data-out-svg]")!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out-${k}]`)!;
    let ttl = 300, rate = 10;

    function render() {
      root.querySelectorAll<HTMLButtonElement>("[data-ttl]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.ttl) === ttl)));
      root.querySelectorAll<HTMLButtonElement>("[data-rate]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.rate) === rate)));
      const h = hitRate(rate, ttl);
      out("hit").textContent = `${h > 0.995 ? ">99" : Math.round(h * 100)}%`;
      out("auth").textContent = (rate * (1 - h)).toFixed(rate * (1 - h) < 10 ? 1 : 0);
      out("stale").textContent = fmtDuration(ttl, durations);

      const sim = simulateCache(rate, ttl, WINDOW_S, CHANGE_S);
      const parts: string[] = [];
      for (const b of sim.bands) parts.push(`<rect x="${xOf(b.from)}" y="44" width="${Math.max(1, xOf(Math.min(b.to, WINDOW_S)) - xOf(b.from))}" height="22" rx="2" fill="color-mix(in srgb, var(--d, var(--accent)) 20%, transparent)"/>`);
      const tickH = rate >= 1000 ? 7 : 10;
      for (const q of sim.queries) {
        const color = q.kind === "miss" ? "var(--danger)" : q.kind === "stale" ? "var(--warn)" : "var(--ok)";
        const y = q.kind === "miss" ? 26 : 82;
        parts.push(rate >= 100
          ? `<line x1="${xOf(q.t)}" x2="${xOf(q.t)}" y1="${y - tickH / 2}" y2="${y + tickH / 2}" stroke="${color}" stroke-width="${rate >= 1000 ? 0.6 : 1.2}"/>`
          : `<circle cx="${xOf(q.t)}" cy="${y}" r="4" fill="${color}"/>`);
      }
      parts.push(`<line x1="${xOf(CHANGE_S)}" x2="${xOf(CHANGE_S)}" y1="10" y2="98" stroke="var(--ink)" stroke-width="1.4" stroke-dasharray="4 3"/>`);
      parts.push(`<line x1="${X0}" x2="${X1}" y1="104" y2="104" stroke="var(--hairline-strong)"/>`);
      [0, CHANGE_S, WINDOW_S].forEach((s, i) => parts.push(`<text x="${xOf(s)}" y="122" text-anchor="${i === 0 ? "start" : i === 2 ? "end" : "middle"}" class="netf-node-sub">${axis[i] ?? ""}</text>`));
      svg.innerHTML = parts.join("");

      out("note").textContent = ru
        ? (sim.stale === 0 ? "В этом окне устаревших ответов нет." : `После смены отдано устаревших ответов: ${sim.stale}.`)
        : (sim.stale === 0 ? "No stale answers in this window." : `${sim.stale} stale answer${sim.stale === 1 ? "" : "s"} served after the change.`);
    }

    root.querySelectorAll<HTMLButtonElement>("[data-ttl]").forEach((b) => b.addEventListener("click", () => { ttl = Number(b.dataset.ttl); render(); }));
    root.querySelectorAll<HTMLButtonElement>("[data-rate]").forEach((b) => b.addEventListener("click", () => { rate = Number(b.dataset.rate); render(); }));
    root.dataset.js = "true";
    render();
  });
</script>
