---
/**
 * DnsPoisoningOddsFig — the attacker's odds in an off-path cache-poisoning race, layer by layer.
 * Answers: "Why did port randomisation matter, what did SAD DNS undo, and why is DNSSEC different?"
 * Entropy is summed in bits from the defences switched on; the readout converts it to the chance
 * per race (100 forged replies) and the races needed for a 50% success. Without JS, a static table.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";
import { poisoningOdds, fmtRaces } from "./poisoning";

interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}
const { lang = "en", span = "learning" } = Astro.props;

const copy = {
  en: {
    category: "ATTACK ECONOMICS",
    title: "How many races does a spoofer need?",
    label: "Interactive calculator for an off-path DNS cache-poisoning race against www.example.com. Toggle source-port randomisation, 0x20 case mixing, the SAD DNS port side channel and DNSSEC validation; the figure shows the entropy in bits, the chance one race succeeds with 100 forged replies, and how many races give the attacker even odds.",
    thesis: "Randomness only raises the price of a guess. DNSSEC removes the guess.",
    caption: "Model: 100 forged replies land before the real answer in each race; the 16-bit transaction ID is always present; 0x20 adds one bit per letter of www.example.com (13).",
    toggles: { port: "Source-port randomisation (+16 bits)", case0x20: "0x20 case mixing (+13 bits)", sad: "SAD DNS side channel leaks the port", dnssec: "DNSSEC validation, signed zone" },
    bitsK: "Entropy", chanceK: "Chance per race", racesK: "Races for 50% success",
    rejected: "forgery rejected", never: "never",
    tableK: ["Defences", "Bits", "Races for 50%"],
    rows: ["TXID only (pre-2008)", "+ port randomisation", "+ 0x20", "+ SAD DNS leak"],
    note: {
      weak: "With only a 16-bit ID, a few hundred races are enough. Kaminsky's insight was that the attacker can start a fresh race every time by querying random subdomains.",
      strong: "Each added bit doubles the work. At 32+ bits a blind attacker needs billions of races, which floods the resolver long before it pays off.",
      sad: "SAD DNS reads the source port through the ICMP rate-limit side channel, so port randomisation stops counting and the odds fall back toward the 2008 level.",
      dnssec: "Entropy no longer matters: a forged record has no valid signature, so a validating resolver discards it no matter how lucky the guess.",
    },
  },
  ru: {
    category: "ЭКОНОМИКА АТАКИ",
    title: "Сколько гонок нужно атакующему?",
    label: "Интерактивный калькулятор off-path гонки отравления DNS-кэша для www.example.com. Включайте рандомизацию порта источника, 0x20, побочный канал SAD DNS и валидацию DNSSEC; фигура показывает энтропию в битах, шанс выиграть одну гонку при 100 поддельных ответах и сколько гонок дают атакующему шанс 50%.",
    thesis: "Случайность лишь поднимает цену угадывания. DNSSEC убирает само угадывание.",
    caption: "Модель: в каждой гонке 100 поддельных ответов приходят раньше настоящего; 16-битный transaction ID есть всегда; 0x20 даёт один бит на каждую букву www.example.com (13).",
    toggles: { port: "Рандомизация порта источника (+16 бит)", case0x20: "Смешивание регистра 0x20 (+13 бит)", sad: "Побочный канал SAD DNS раскрывает порт", dnssec: "Валидация DNSSEC, зона подписана" },
    bitsK: "Энтропия", chanceK: "Шанс за гонку", racesK: "Гонок до 50% успеха",
    rejected: "подделка отвергнута", never: "никогда",
    tableK: ["Защиты", "Биты", "Гонок до 50%"],
    rows: ["Только TXID (до 2008)", "+ рандомизация порта", "+ 0x20", "+ утечка SAD DNS"],
    note: {
      weak: "С одним 16-битным ID хватает нескольких сотен гонок. Идея Каминского в том, что атакующий может начинать новую гонку снова и снова, запрашивая случайные поддомены.",
      strong: "Каждый добавленный бит удваивает работу. При 32+ битах слепому атакующему нужны миллиарды гонок, и он завалит резолвер раньше, чем это окупится.",
      sad: "SAD DNS считывает порт источника через побочный канал ICMP rate limit, поэтому рандомизация порта перестаёт работать, и шансы откатываются к уровню 2008 года.",
      dnssec: "Энтропия больше не важна: у поддельной записи нет валидной подписи, поэтому валидирующий резолвер отбросит её, как бы удачно ни было угадывание.",
    },
  },
}[lang];

const staticRows = [
  poisoningOdds({ port: false, case0x20: false, sad: false, dnssec: false }),
  poisoningOdds({ port: true, case0x20: false, sad: false, dnssec: false }),
  poisoningOdds({ port: true, case0x20: true, sad: false, dnssec: false }),
  poisoningOdds({ port: true, case0x20: true, sad: true, dnssec: false }),
];
---

<SkeinFigure num="06" category={copy.category} title={copy.title} label={copy.label} thesis={copy.thesis} caption={copy.caption} span={span} hue="var(--d-network)">
  <div class="netf-root" data-netf-poison data-never={copy.never} data-rejected={copy.rejected} data-notes={JSON.stringify(copy.note)} role="group" aria-label={copy.title}>
    <div class="dnsp-toggles netf-js-only">
      {(["port", "case0x20", "sad", "dnssec"] as const).map((k) => (
        <label class="dnsp-toggle"><input type="checkbox" data-def={k} checked={k === "port"} /> <span>{copy.toggles[k]}</span></label>
      ))}
    </div>

    <div class="netf-readout netf-js-only" aria-live="polite">
      <div class="netf-metric"><span class="netf-k">{copy.bitsK}</span><span class="netf-metric-v" data-out-bits>—</span></div>
      <div class="netf-metric"><span class="netf-k">{copy.chanceK}</span><span class="netf-metric-v" data-out-chance>—</span></div>
      <div class="netf-metric"><span class="netf-k">{copy.racesK}</span><span class="netf-metric-v" data-out-races>—</span></div>
    </div>
    <div class="netf-meter netf-js-only" aria-hidden="true"><span data-out-bar style="width:0%"></span></div>
    <p class="netf-note netf-js-only" data-out-note></p>

    <table class="dnsp-table netf-nojs-only">
      <thead><tr>{copy.tableK.map((h) => <th>{h}</th>)}</tr></thead>
      <tbody>{staticRows.map((r, i) => <tr><td>{copy.rows[i]}</td><td>{r.bits}</td><td>{fmtRaces(r.racesFor50)}</td></tr>)}</tbody>
    </table>
  </div>
</SkeinFigure>

<style>
  .dnsp-toggles { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 8px; }
  .dnsp-toggle { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 12px; border: 1px solid var(--hairline-2); border-radius: var(--r-sm); background: var(--card); font: 13.5px/1.35 var(--font-body); color: var(--ink); cursor: pointer; }
  .dnsp-toggle:has(input:checked) { border-color: var(--d, var(--accent)); background: color-mix(in srgb, var(--d, var(--accent)) 8%, var(--card)); }
  .dnsp-toggle input { width: 18px; height: 18px; accent-color: var(--d, var(--accent)); flex-shrink: 0; }
  .dnsp-table { border-collapse: collapse; font: 13px/1.5 var(--font-body); }
  .dnsp-table th, .dnsp-table td { text-align: left; padding: 6px 16px 6px 0; border-bottom: 0.5px solid var(--hairline); }
  .dnsp-table th { font: 700 10px/1.4 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
</style>

<script>
  import { onEachRoot } from "./stepper";
  import { poisoningOdds, oddsNote, fmtRaces, fmtChance, type Defences } from "./poisoning";

  onEachRoot("[data-netf-poison]", (root) => {
    if (root.dataset.js) return;
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>("[data-def]"));
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out-${k}]`)!;
    const notes: Record<string, string> = JSON.parse(root.dataset.notes ?? "{}");
    function render() {
      const d = Object.fromEntries(boxes.map((b) => [b.dataset.def, b.checked])) as unknown as Defences;
      const r = poisoningOdds(d);
      out("bits").textContent = d.dnssec ? "—" : `${r.bits}`;
      out("chance").textContent = d.dnssec ? root.dataset.rejected! : fmtChance(r.chancePerRace);
      out("races").textContent = d.dnssec ? root.dataset.never! : fmtRaces(r.racesFor50);
      out("bar").style.width = d.dnssec ? "100%" : `${Math.min(100, (r.bits / 48) * 100)}%`;
      out("note").textContent = notes[oddsNote(d)] ?? "";
    }
    boxes.forEach((b) => b.addEventListener("change", render));
    root.dataset.js = "true";
    render();
  });
</script>
