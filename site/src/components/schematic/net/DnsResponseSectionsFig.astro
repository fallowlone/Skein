---
/**
 * DnsResponseSectionsFig — the three responses of an iterative walk, opened up section by section.
 * Answers: "How does a referral differ from an answer inside the same DNS message format?"
 * Each step shows the header flags and the Question / Answer / Authority / Additional sections,
 * so the learner sees Answer stay empty and AA stay 0 until the zone owner replies.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";
import MachineValue from "../MachineValue.astro";
import { arcPath } from "./geometry";

interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}
const { lang = "en", span = "learning" } = Astro.props;

type NodeId = "resolver" | "root" | "tld" | "auth";
const NODES: { id: NodeId; x: number; sub: string }[] = [
  { id: "resolver", x: 80, sub: "recursive" }, { id: "root", x: 240, sub: "." }, { id: "tld", x: 400, sub: "uk." }, { id: "auth", x: 560, sub: "example.co.uk." },
];
const X = Object.fromEntries(NODES.map((n) => [n.id, n.x])) as Record<NodeId, number>;

const QUESTION = "cdn.example.co.uk.  IN  A";
interface Resp { server: NodeId; aa: 0 | 1; answer: string[]; authority: string[]; additional: string[] }
const RESPONSES: Resp[] = [
  { server: "root", aa: 0, answer: [], authority: ["uk.  172800  NS  ns.nic.uk."], additional: ["ns.nic.uk.  172800  A  193.0.0.1"] },
  { server: "tld", aa: 0, answer: [], authority: ["example.co.uk.  86400  NS  ns1.example.co.uk."], additional: ["ns1.example.co.uk.  86400  A  198.51.100.4"] },
  { server: "auth", aa: 1, answer: ["cdn.example.co.uk.  300  A  203.0.113.10"], authority: [], additional: [] },
];

const copy = {
  en: {
    category: "MESSAGE ANATOMY",
    title: "Referral or answer: read the four sections",
    label: "Interactive stepper through the three responses a recursive resolver receives for cdn.example.co.uk. Root and the uk TLD send referrals with an empty Answer section, NS records in Authority, glue addresses in Additional and AA=0. The authoritative server sends the answer in the Answer section with AA=1.",
    thesis: "A referral is not a wrong answer. It is a pointer, and the sections say which one you got.",
    caption: "Illustrative records. TTLs are typical: delegations live for days, the final record for minutes.",
    nodes: { resolver: "Resolver", root: "Root", tld: "TLD", auth: "Authoritative" },
    kind: ["Referral", "Referral", "Authoritative answer"],
    from: ["from the root", "from the uk. TLD", "from example.co.uk."],
    headerK: "Header", sectionK: { question: "Question", answer: "Answer", authority: "Authority", additional: "Additional" }, empty: "empty",
    nextK: "Resolver's next move",
    next: [
      "Ignore Answer (empty). Take an NS from Authority, use its glue address from Additional, ask the uk. servers. No extra lookup needed.",
      "Same move one level down. The glue matters here: ns1.example.co.uk lives inside the zone it serves, so without its address in Additional the resolver could never reach it.",
      "AA=1 and a populated Answer: this server owns the zone. Cache the record for 300 s and return it to the client. The walk is over.",
    ],
    prev: "Previous", nextBtn: "Next",
  },
  ru: {
    category: "АНАТОМИЯ СООБЩЕНИЯ",
    title: "Referral или ответ: читаем четыре секции",
    label: "Интерактивный stepper по трём ответам, которые рекурсивный резолвер получает для cdn.example.co.uk. Root и TLD uk присылают referral с пустой секцией Answer, NS-записями в Authority, glue-адресами в Additional и AA=0. Authoritative-сервер присылает ответ в секции Answer с AA=1.",
    thesis: "Referral — не неверный ответ. Это указатель, и секции говорят, что именно вы получили.",
    caption: "Иллюстративные записи. TTL типичные: делегирования живут днями, итоговая запись — минутами.",
    nodes: { resolver: "Резолвер", root: "Root", tld: "TLD", auth: "Authoritative" },
    kind: ["Referral", "Referral", "Authoritative-ответ"],
    from: ["от root", "от TLD uk.", "от example.co.uk."],
    headerK: "Заголовок", sectionK: { question: "Question", answer: "Answer", authority: "Authority", additional: "Additional" }, empty: "пусто",
    nextK: "Следующий ход резолвера",
    next: [
      "Answer пуст, его пропускаем. Берём NS из Authority, его glue-адрес из Additional и спрашиваем серверы uk. Дополнительный lookup не нужен.",
      "Тот же ход уровнем ниже. Здесь glue критичен: ns1.example.co.uk живёт внутри зоны, которую обслуживает, и без его адреса в Additional резолвер никогда бы до него не добрался.",
      "AA=1 и заполненный Answer: этот сервер владеет зоной. Кэшируем запись на 300 с и возвращаем клиенту. Обход закончен.",
    ],
    prev: "Назад", nextBtn: "Дальше",
  },
}[lang];

const sections = (r: Resp) => [
  { key: "question" as const, rows: [QUESTION], tone: "dim" },
  { key: "answer" as const, rows: r.answer, tone: "ok" },
  { key: "authority" as const, rows: r.authority, tone: "accent" },
  { key: "additional" as const, rows: r.additional, tone: "warn" },
];
---

<SkeinFigure num="02" category={copy.category} title={copy.title} label={copy.label} thesis={copy.thesis} caption={copy.caption} span={span} hue="var(--d-network)">
  <div class="netf-root" data-sf-root data-netf-sections tabindex="0" role="group" aria-label={copy.title} data-lang={lang}>
    {RESPONSES.map((r, i) => (
      <article class="netf-panel" data-sf-panel data-sf-group="" data-sf-default="" aria-label={`${copy.kind[i]} ${copy.from[i]}`}>
        <div class="netf-stage">
          <svg viewBox="0 0 640 124" class="netf-svg" aria-hidden="true">
            <defs>
              <marker id={`dnss-a-${i}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                <path d="M0 1.5 L8 5 L0 8.5 z" fill={r.aa ? "var(--ok)" : "var(--d, var(--accent))"} />
              </marker>
            </defs>
            {RESPONSES.slice(0, i).map((p) => (
              <path d={arcPath(X[p.server], X.resolver)} fill="none" stroke="var(--hairline-strong)" stroke-width="1.2" stroke-dasharray="3 3" />
            ))}
            <path d={arcPath(X.resolver, X[r.server])} fill="none" stroke="var(--hairline-strong)" stroke-width="1.2" />
            <path d={arcPath(X[r.server], X.resolver)} fill="none" stroke={r.aa ? "var(--ok)" : "var(--d, var(--accent))"} stroke-width="2.2" marker-end={`url(#dnss-a-${i})`} />
            {NODES.map((n) => {
              const on = n.id === "resolver" || n.id === r.server;
              return (
                <g>
                  <circle cx={n.x} cy="60" r="11" fill={on ? "color-mix(in srgb, var(--d, var(--accent)) 18%, var(--card))" : "var(--card)"} stroke={on ? "var(--d, var(--accent))" : "var(--hairline-2)"} stroke-width={on ? 1.8 : 1} />
                  <text x={n.x} y="94" text-anchor="middle" class="netf-node-label">{copy.nodes[n.id]}</text>
                  <text x={n.x} y="107" text-anchor="middle" class="netf-node-sub">{n.sub}</text>
                </g>
              );
            })}
          </svg>
        </div>

        <span class="netf-kicker">{i + 1} / {RESPONSES.length} · {copy.from[i]}</span>
        <h4 class="netf-title">{copy.kind[i]}</h4>

        <div class="dnss-msg">
          <div class="dnss-head">
            <span class="netf-k">{copy.headerK}</span>
            <span class="dnss-flags">
              <MachineValue size="sm" tone="dim" val="QR=1" />
              <MachineValue size="sm" tone={r.aa ? "ok" : "warn"} val={`AA=${r.aa}`} />
              <MachineValue size="sm" tone="dim" val="RCODE=NOERROR" />
            </span>
          </div>
          {sections(r).map((s) => (
            <div class="dnss-sec" data-empty={s.rows.length ? undefined : ""} data-tone={s.tone}>
              <span class="dnss-sec-k">{copy.sectionK[s.key]} <span class="dnss-n">{s.rows.length}</span></span>
              <div class="dnss-rows">
                {s.rows.length ? s.rows.map((row) => <code>{row}</code>) : <span class="dnss-empty">{copy.empty}</span>}
              </div>
            </div>
          ))}
        </div>

        <div class="netf-row" style="justify-content:flex-start"><span class="netf-k">{copy.nextK}</span></div>
        <p class="netf-note">{copy.next[i]}</p>
      </article>
    ))}

    <div class="netf-controls netf-js-only">
      <button type="button" class="netf-btn" data-sf-prev>← {copy.prev}</button>
      <span class="netf-count" data-sf-count aria-live="polite"></span>
      <button type="button" class="netf-btn" data-sf-next>{copy.nextBtn} →</button>
    </div>
  </div>
</SkeinFigure>

<style>
  .dnss-msg { border: 1px solid var(--hairline-2); border-radius: var(--r-sm); background: var(--card); overflow: hidden; }
  .dnss-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--hairline); }
  .dnss-flags { display: flex; flex-wrap: wrap; gap: 6px; }
  .dnss-sec { display: grid; grid-template-columns: 130px 1fr; gap: 10px; padding: 10px 14px; border-left: 3px solid transparent; }
  .dnss-sec + .dnss-sec { border-top: 0.5px solid var(--hairline); }
  .dnss-sec[data-tone="ok"]:not([data-empty]) { border-left-color: var(--ok); background: color-mix(in srgb, var(--ok) 6%, transparent); }
  .dnss-sec[data-tone="accent"]:not([data-empty]) { border-left-color: var(--d, var(--accent)); background: color-mix(in srgb, var(--d, var(--accent)) 6%, transparent); }
  .dnss-sec[data-tone="warn"]:not([data-empty]) { border-left-color: var(--warn); background: color-mix(in srgb, var(--warn) 7%, transparent); }
  .dnss-sec-k { font-family: var(--font-mono); font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .dnss-n { color: var(--muted); font-weight: 500; margin-left: 4px; }
  .dnss-rows { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .dnss-rows code { font-family: var(--font-mono); font-size: 12px; color: var(--ink); white-space: pre-wrap; overflow-wrap: anywhere; background: none; padding: 0; }
  .dnss-empty { font-family: var(--font-mono); font-size: 12px; color: var(--muted); font-style: italic; }
  @media (max-width: 560px) { .dnss-sec { grid-template-columns: 1fr; gap: 4px; } }
</style>

<script>
  import { initStepper, onEachRoot } from "./stepper";
  onEachRoot("[data-netf-sections]", (root) => {
    const ru = root.dataset.lang === "ru";
    initStepper(root, (n, t) => (ru ? `ОТВЕТ ${n} ИЗ ${t}` : `RESPONSE ${n} OF ${t}`));
  });
</script>
