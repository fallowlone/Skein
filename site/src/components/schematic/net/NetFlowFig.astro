---
/**
 * NetFlowFig — a pipeline of stages, shown as a rail (wide, ≤6 stages) or a vertical track.
 * Drop-in for FlowDiagram (same nodes/edges/label/caption/hue/perRow props). Stages keep their
 * order; edges that skip ahead or loop back are listed on the stage they leave, so no line or
 * label ever crosses another. "Step by step" highlights one stage and its outgoing edges.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";
import { UI, type Lang } from "./i18n";

interface Node { id: string; label: string; sub?: string }
interface Edge { from: string; to: string; label?: string }
interface Props { nodes: Node[]; edges: Edge[]; label: string; caption?: string; hue?: string; perRow?: number; lang?: Lang; title?: string; desc?: string }
const { nodes, edges, label, caption, hue = "var(--d-network)", lang = "en", title, desc } = Astro.props;
const ui = UI[lang];

const pos = new Map(nodes.map((n, i) => [n.id, i]));
const name = (id: string) => nodes[pos.get(id) ?? 0]?.label ?? id;
const out = (id: string) => edges.filter((e) => e.from === id);
const isNext = (e: Edge) => (pos.get(e.to) ?? -1) === (pos.get(e.from) ?? -2) + 1;
const loopsBack = (e: Edge, i: number) => (pos.get(e.to) ?? 0) <= i;
const layout = nodes.length <= 6 ? "rail" : "track";
---

<SkeinFigure label={label} caption={caption} span="learning" hue={hue}>
  <div class="netf-root" data-netf-flow data-lang={lang} tabindex="0" role="group" aria-label={label}>
    {(title || desc) && (
      <div class="netf-head">
        {title && <h4 class="netf-head-title">{title}</h4>}
        {desc && <p class="netf-head-desc">{desc}</p>}
      </div>
    )}
    <div class="netf-seg netf-js-only" role="group" aria-label={ui.viewK}>
      <button type="button" class="netf-chip" data-flow-mode="all" aria-pressed="true">{ui.overview}</button>
      <button type="button" class="netf-chip" data-flow-mode="step" aria-pressed="false">{ui.stepwise}</button>
    </div>

    <ol class={`netflow netflow-${layout}`} style={`--n:${nodes.length}`}>
      {nodes.map((n, i) => (
        <li class="netflow-node" data-i={i}>
          <span class="netflow-dot" aria-hidden="true">{i + 1}</span>
          <span class="netflow-body">
            <span class="netflow-label">{n.label}</span>
            {n.sub && <span class="netflow-sub">{n.sub}</span>}
            {out(n.id).map((e) => isNext(e)
              ? e.label && <span class="netflow-edge">→ {e.label}</span>
              : <span class="netflow-edge netflow-jump">{loopsBack(e, i) ? `↺ ${ui.back}` : "→"} {name(e.to)}{e.label ? ` · ${e.label}` : ""}</span>)}
          </span>
        </li>
      ))}
    </ol>

    <div class="netf-controls netf-js-only" data-flow-controls hidden>
      <button type="button" class="netf-btn" data-flow-prev>← {ui.prev}</button>
      <span class="netf-count" data-flow-count aria-live="polite"></span>
      <button type="button" class="netf-btn" data-flow-next>{ui.next} →</button>
    </div>
  </div>
</SkeinFigure>

<style>
  .netflow { list-style: none; margin: 0; padding: 0; }
  .netflow-node { position: relative; display: flex; gap: 12px; transition: opacity 160ms ease; }
  .netflow-dot {
    flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; z-index: 1;
    font: 700 12px/1 var(--font-mono); color: var(--d, var(--accent)); background: var(--card); border: 1.6px solid var(--d, var(--accent));
  }
  .netflow-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .netflow-label { font: 600 14px/1.3 var(--font-body); color: var(--ink); overflow-wrap: anywhere; }
  .netflow-sub { font: 12px/1.4 var(--font-mono); color: var(--muted); overflow-wrap: anywhere; }
  .netflow-edge { font: 12px/1.4 var(--font-body); color: var(--ink-2); overflow-wrap: anywhere; }
  .netflow-jump { color: var(--warn); font-weight: 500; }

  /* Vertical track: connector runs down through the dots. */
  .netflow-track { display: flex; flex-direction: column; gap: 18px; }
  .netflow-track .netflow-node:not(:last-child)::before { content: ""; position: absolute; left: 14px; top: 30px; bottom: -18px; width: 2px; background: color-mix(in srgb, var(--d, var(--accent)) 40%, var(--hairline)); }

  /* Rail: equal columns, connector runs across behind the dots; text wraps inside each column. */
  .netflow-rail { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 0 12px; }
  .netflow-rail .netflow-node { flex-direction: column; align-items: center; text-align: center; }
  .netflow-rail .netflow-body { align-items: center; }
  .netflow-rail .netflow-node:not(:last-child)::before { content: ""; position: absolute; top: 14px; left: calc(50% + 15px); width: calc(100% - 30px + 12px); height: 2px; background: color-mix(in srgb, var(--d, var(--accent)) 40%, var(--hairline)); }
  @media (max-width: 680px) {
    .netflow-rail { display: flex; flex-direction: column; gap: 18px; }
    .netflow-rail .netflow-node { flex-direction: row; align-items: flex-start; text-align: left; }
    .netflow-rail .netflow-body { align-items: flex-start; }
    .netflow-rail .netflow-node:not(:last-child)::before { left: 14px; top: 30px; bottom: -18px; width: 2px; height: auto; }
  }

  [data-netf-flow][data-mode="step"] .netflow-node:not([data-on]) { opacity: 0.32; }
  [data-netf-flow][data-mode="step"] .netflow-node[data-on] .netflow-dot { background: var(--d, var(--accent)); color: var(--card); }
</style>

<script>
  import { onEachRoot } from "./stepper";
  import { stepCount } from "./i18n";
  onEachRoot("[data-netf-flow]", (root) => {
    if (root.dataset.js) return;
    const nodes = Array.from(root.querySelectorAll<HTMLElement>(".netflow-node"));
    const modes = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-flow-mode]"));
    const controls = root.querySelector<HTMLElement>("[data-flow-controls]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-flow-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-flow-next]")!;
    const count = root.querySelector<HTMLElement>("[data-flow-count]")!;
    const fmt = stepCount(root.dataset.lang ?? "en");
    let mode = "all", cur = 0;
    function render() {
      cur = Math.max(0, Math.min(nodes.length - 1, cur));
      root.dataset.mode = mode;
      modes.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.flowMode === mode)));
      controls.hidden = mode !== "step";
      nodes.forEach((n, i) => n.toggleAttribute("data-on", mode === "step" && i === cur));
      prev.disabled = cur === 0; next.disabled = cur === nodes.length - 1;
      count.textContent = fmt(cur + 1, nodes.length);
    }
    modes.forEach((b) => b.addEventListener("click", () => { mode = b.dataset.flowMode ?? "all"; cur = 0; render(); }));
    prev.addEventListener("click", () => { cur -= 1; render(); });
    next.addEventListener("click", () => { cur += 1; render(); });
    root.addEventListener("keydown", (e) => {
      if (mode !== "step" || (e.key !== "ArrowLeft" && e.key !== "ArrowRight")) return;
      e.preventDefault(); cur += e.key === "ArrowRight" ? 1 : -1; render();
    });
    root.dataset.js = "true";
    render();
  });
</script>
