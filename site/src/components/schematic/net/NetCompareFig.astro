---
/**
 * NetCompareFig — two options compared point by point. Replaces compare-binary "VS"
 * infographics in the networking track. Points are paired by index into rows, so each
 * difference reads across one row; on narrow screens a row stacks A above B.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";

interface Item { label: string; desc?: string }
interface Side { label: string; items: Item[] }
interface Props { title?: string; desc?: string; sides: [Side, Side]; label: string; caption?: string; hue?: string; lang?: string }
const { title, desc, sides, label, caption, hue = "var(--d-network)" } = Astro.props;
const rows = Math.max(sides[0].items.length, sides[1].items.length);
---

<SkeinFigure label={label} caption={caption} span="learning" hue={hue}>
  <div class="netf-root" role="group" aria-label={label}>
    {(title || desc) && (
      <div class="netf-head">
        {title && <h4 class="netf-head-title">{title}</h4>}
        {desc && <p class="netf-head-desc">{desc}</p>}
      </div>
    )}
    <div class="netcmp" role="table" aria-label={title ?? label}>
      <div class="netcmp-row netcmp-headrow" role="row">
        {sides.map((s, j) => <span class="netcmp-side" data-side={j} role="columnheader">{s.label}</span>)}
      </div>
      {Array.from({ length: rows }, (_, i) => (
        <div class="netcmp-row" role="row">
          {sides.map((s, j) => {
            const it = s.items[i];
            return (
              <div class="netcmp-cell" data-side={j} role="cell">
                <span class="netcmp-tag" aria-hidden="true">{s.label}</span>
                {it && <span class="netcmp-label">{it.label}</span>}
                {it?.desc && <span class="netcmp-desc">{it.desc}</span>}
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</SkeinFigure>

<style>
  .netcmp { display: flex; flex-direction: column; border: 1px solid var(--hairline-2); border-radius: var(--r-sm); overflow: hidden; background: var(--card); }
  .netcmp-row { display: grid; grid-template-columns: 1fr 1fr; }
  .netcmp-row + .netcmp-row { border-top: 0.5px solid var(--hairline); }
  .netcmp-headrow { background: color-mix(in srgb, var(--d, var(--accent)) 6%, var(--card)); }
  .netcmp-side { padding: 12px 16px; font: 700 12px/1.35 var(--font-mono); letter-spacing: 0.04em; overflow-wrap: anywhere; }
  .netcmp-side[data-side="0"] { color: var(--d, var(--accent)); }
  .netcmp-side[data-side="1"] { color: var(--warn); }
  .netcmp-cell { display: flex; flex-direction: column; gap: 4px; padding: 12px 16px; min-width: 0; }
  .netcmp-cell[data-side="1"] { border-left: 0.5px solid var(--hairline); }
  .netcmp-tag { display: none; font: 700 10px/1.3 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .netcmp-label { font: 600 14px/1.35 var(--font-body); color: var(--ink); overflow-wrap: anywhere; }
  .netcmp-desc { font: 13px/1.5 var(--font-body); color: var(--ink-2); overflow-wrap: anywhere; }
  @media (max-width: 600px) {
    .netcmp-headrow { display: none; }
    .netcmp-row { grid-template-columns: 1fr; }
    .netcmp-cell[data-side="1"] { border-left: 0; border-top: 0.5px dashed var(--hairline); }
    .netcmp-tag { display: block; }
  }
</style>
