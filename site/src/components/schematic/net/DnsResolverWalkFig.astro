---
/**
 * DnsResolverWalkFig — the recursive lookup as a stepper with three cache states.
 * Answers: "Where does the time of a DNS lookup go, and what does each cache layer remove?"
 * Cold walk (root → TLD → authoritative), warm resolver cache, and browser/OS cache share one
 * stage so the learner sees eight network legs collapse to two, then to zero.
 * Progressive enhancement: without JS the cold walk reads as stacked steps.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";
import MachineValue from "../MachineValue.astro";
import { arcPath } from "./geometry";

interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}
const { lang = "en", span = "learning" } = Astro.props;

type NodeId = "browser" | "resolver" | "root" | "tld" | "auth";
interface Step { from: NodeId; to: NodeId; msg: string; t: number; cache: string[]; title: string; note: string }

const NODES: { id: NodeId; x: number }[] = [
  { id: "browser", x: 60 }, { id: "resolver", x: 200 }, { id: "root", x: 340 }, { id: "tld", x: 460 }, { id: "auth", x: 580 },
];
const X = Object.fromEntries(NODES.map((n) => [n.id, n.x])) as Record<NodeId, number>;
const COLD_TOTAL = 100;

const C_COM = ".com NS → a.gtld-servers.net";
const C_EX = "example.com NS → ns1.example.com";
const C_A = "example.com A 203.0.113.10 · TTL 300";

const copy = {
  en: {
    category: "RESOLUTION PATH",
    title: "Where the milliseconds of a lookup go",
    label: "Interactive stepper of a DNS lookup for example.com in three cache states: a cold walk through root, TLD and authoritative servers taking about 100 ms, a warm resolver cache answering in about 10 ms, and a browser or OS cache answering without touching the network.",
    thesis: "Every cache layer deletes whole legs of the walk, not milliseconds from them.",
    caption: "Illustrative one-way delays: 5 ms to the resolver, 10 ms to a nearby anycast root, 15 ms to the TLD, 20 ms to the authoritative server.",
    modesK: "Cache state",
    modes: { cold: "Cold: nothing cached", resolver: "Warm resolver", browser: "Browser / OS cache" },
    nodes: { browser: ["Browser", "stub"], resolver: ["Resolver", "recursive"], root: ["Root", ". zone"], tld: ["TLD", ".com"], auth: ["Authoritative", "example.com"] },
    stepK: "STEP", elapsedK: "Elapsed", cacheK: "Resolver cache", empty: "empty", msgK: "Message",
    prev: "Previous", next: "Next",
    cold: [
      { title: "The browser asks its configured resolver", note: "The stub resolver in the OS sends one recursive question (RD=1) and waits. All the work happens on the resolver's side." },
      { title: "The resolver starts at the root", note: "It knows nothing about .com yet, so it asks one of the 13 root identities, served by the nearest anycast instance." },
      { title: "The root refers it to the .com servers", note: "The root does not know example.com. It returns a referral: the NS records for .com plus their addresses. The resolver caches them for days." },
      { title: "The resolver asks the .com TLD", note: "Same question, one level down the tree." },
      { title: "The TLD refers it to example.com's nameservers", note: "Another referral. The resolver now knows who is authoritative for example.com." },
      { title: "The resolver asks the authoritative server", note: "This is the only server that actually owns the answer." },
      { title: "The authoritative server answers", note: "A 203.0.113.10 with TTL 300 and the AA bit set. The resolver caches it for up to 300 seconds." },
      { title: "The resolver returns the answer", note: "About 100 ms in total, spent almost entirely on three round trips up and down the tree." },
    ],
    resolver: [
      { title: "The browser asks the resolver", note: "Another user of the same resolver looked up example.com a minute ago." },
      { title: "Cache hit at the resolver", note: "The resolver answers from cache with the remaining TTL (240 s). Six of eight legs disappear: about 10 ms, one round trip." },
    ],
    browser: [
      { title: "Cache hit in the browser or OS", note: "The answer is still in the local cache, so no packet leaves the machine. Under 1 ms. This is why a second visit feels instant." },
    ],
  },
  ru: {
    category: "ПУТЬ РАЗРЕШЕНИЯ",
    title: "Куда уходят миллисекунды lookup",
    label: "Интерактивный stepper DNS-lookup для example.com в трёх состояниях кэша: холодный обход root, TLD и authoritative примерно за 100 мс, тёплый кэш резолвера примерно за 10 мс и кэш браузера или ОС без обращения к сети.",
    thesis: "Каждый слой кэша удаляет целые отрезки обхода, а не миллисекунды из них.",
    caption: "Иллюстративные задержки в одну сторону: 5 мс до резолвера, 10 мс до ближайшего anycast-root, 15 мс до TLD, 20 мс до authoritative.",
    modesK: "Состояние кэша",
    modes: { cold: "Холодный: кэш пуст", resolver: "Тёплый резолвер", browser: "Кэш браузера / ОС" },
    nodes: { browser: ["Браузер", "stub"], resolver: ["Резолвер", "рекурсивный"], root: ["Root", "зона ."], tld: ["TLD", ".com"], auth: ["Authoritative", "example.com"] },
    stepK: "ШАГ", elapsedK: "Прошло", cacheK: "Кэш резолвера", empty: "пусто", msgK: "Сообщение",
    prev: "Назад", next: "Дальше",
    cold: [
      { title: "Браузер спрашивает свой резолвер", note: "Stub-резолвер ОС отправляет один рекурсивный вопрос (RD=1) и ждёт. Вся работа идёт на стороне резолвера." },
      { title: "Резолвер начинает с root", note: "Он ещё ничего не знает о .com, поэтому спрашивает один из 13 root-серверов, которого обслуживает ближайший anycast-экземпляр." },
      { title: "Root отсылает к серверам .com", note: "Root не знает example.com. Он возвращает referral: NS-записи .com с их адресами. Резолвер кэширует их на дни." },
      { title: "Резолвер спрашивает TLD .com", note: "Тот же вопрос, на уровень ниже по дереву." },
      { title: "TLD отсылает к nameserver'ам example.com", note: "Ещё один referral. Теперь резолвер знает, кто authoritative для example.com." },
      { title: "Резолвер спрашивает authoritative-сервер", note: "Это единственный сервер, которому на самом деле принадлежит ответ." },
      { title: "Authoritative отвечает", note: "A 203.0.113.10 с TTL 300 и битом AA. Резолвер кэширует ответ на срок до 300 секунд." },
      { title: "Резолвер возвращает ответ", note: "Всего около 100 мс, почти целиком на три round trip вверх и вниз по дереву." },
    ],
    resolver: [
      { title: "Браузер спрашивает резолвер", note: "Минуту назад example.com искал другой пользователь того же резолвера." },
      { title: "Попадание в кэш резолвера", note: "Резолвер отвечает из кэша с оставшимся TTL (240 с). Шесть из восьми отрезков исчезают: около 10 мс, один round trip." },
    ],
    browser: [
      { title: "Попадание в кэш браузера или ОС", note: "Ответ ещё в локальном кэше, поэтому ни один пакет не покидает машину. Меньше 1 мс. Поэтому повторный визит ощущается мгновенным." },
    ],
  },
}[lang];

const q = "A? example.com";
const coldSteps: Omit<Step, "title" | "note">[] = [
  { from: "browser", to: "resolver", msg: `${q} · RD=1`, t: 5, cache: [] },
  { from: "resolver", to: "root", msg: `${q} · RD=0`, t: 15, cache: [] },
  { from: "root", to: "resolver", msg: "referral: NS .com + glue", t: 25, cache: [C_COM] },
  { from: "resolver", to: "tld", msg: `${q} · RD=0`, t: 40, cache: [C_COM] },
  { from: "tld", to: "resolver", msg: "referral: NS example.com + glue", t: 55, cache: [C_COM, C_EX] },
  { from: "resolver", to: "auth", msg: `${q} · RD=0`, t: 75, cache: [C_COM, C_EX] },
  { from: "auth", to: "resolver", msg: "A 203.0.113.10 · TTL 300 · AA=1", t: 95, cache: [C_COM, C_EX, C_A] },
  { from: "resolver", to: "browser", msg: "A 203.0.113.10 · TTL 300", t: 100, cache: [C_COM, C_EX, C_A] },
];
const warm = [C_COM, C_EX, C_A.replace("300", "240")];
const groups: { mode: "cold" | "resolver" | "browser"; steps: (Omit<Step, "from" | "to"> & { from?: NodeId; to?: NodeId })[] }[] = [
  { mode: "cold", steps: coldSteps.map((s, i) => ({ ...s, ...copy.cold[i] })) },
  { mode: "resolver", steps: [
    { from: "browser", to: "resolver", msg: `${q} · RD=1`, t: 5, cache: warm, ...copy.resolver[0] },
    { from: "resolver", to: "browser", msg: "A 203.0.113.10 · TTL 240", t: 10, cache: warm, ...copy.resolver[1] },
  ] },
  { mode: "browser", steps: [{ msg: "cache hit · A 203.0.113.10", t: 0.5, cache: warm, ...copy.browser[0] }] },
];

const arc = (from: NodeId, to: NodeId) => arcPath(X[from], X[to]);
const fmt = (t: number) => (t < 1 ? "< 1 ms" : `${t} ms`);
---

<SkeinFigure num="01" category={copy.category} title={copy.title} label={copy.label} thesis={copy.thesis} caption={copy.caption} span={span} hue="var(--d-network)">
  <div class="netf-root" data-sf-root data-netf-walk tabindex="0" role="group" aria-label={copy.title} data-lang={lang}>
    <div class="netf-seg netf-js-only" role="group" aria-label={copy.modesK}>
      <span class="netf-seg-k">{copy.modesK}</span>
      {groups.map((g) => <button type="button" class="netf-chip" data-sf-mode={g.mode} aria-pressed={g.mode === "cold" ? "true" : "false"}>{copy.modes[g.mode]}</button>)}
    </div>

    {groups.map((g) => g.steps.map((s, i) => (
      <article class="netf-panel" data-sf-panel data-sf-group={g.mode} data-sf-default={g.mode === "cold" ? "" : undefined} aria-label={`${copy.modes[g.mode]} · ${s.title}`}>
        <div class="netf-stage">
          <svg viewBox="0 0 640 124" class="netf-svg" aria-hidden="true">
            <defs>
              <marker id={`dnsw-a-${g.mode}-${i}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                <path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--d, var(--accent))" />
              </marker>
            </defs>
            {g.steps.slice(0, i).map((p) => p.from && p.to && (
              <path d={arc(p.from, p.to)} fill="none" stroke="var(--hairline-strong)" stroke-width="1.2" stroke-dasharray="3 3" />
            ))}
            {s.from && s.to && (
              <path d={arc(s.from, s.to)} fill="none" stroke="var(--d, var(--accent))" stroke-width="2.2" marker-end={`url(#dnsw-a-${g.mode}-${i})`} />
            )}
            {NODES.map((n) => {
              const active = n.id === s.from || n.id === s.to || (!s.from && n.id === "browser");
              const [name, sub] = copy.nodes[n.id];
              return (
                <g opacity={g.mode !== "cold" && (n.id === "root" || n.id === "tld" || n.id === "auth") ? 0.35 : 1}>
                  <circle cx={n.x} cy="60" r="11" fill={active ? "color-mix(in srgb, var(--d, var(--accent)) 18%, var(--card))" : "var(--card)"} stroke={active ? "var(--d, var(--accent))" : "var(--hairline-2)"} stroke-width={active ? 1.8 : 1} />
                  <text x={n.x} y="94" text-anchor="middle" class="netf-node-label">{name}</text>
                  <text x={n.x} y="107" text-anchor="middle" class="netf-node-sub">{sub}</text>
                </g>
              );
            })}
          </svg>
        </div>

        <span class="netf-kicker">{copy.stepK} {i + 1} · {copy.modes[g.mode]}</span>
        <h4 class="netf-title">{s.title}</h4>
        <div class="netf-row"><span class="netf-k">{copy.msgK}</span><MachineValue size="sm" tone="accent" val={s.msg} /></div>

        <div class="netf-grid">
          <div>
            <div class="netf-row"><span class="netf-k">{copy.elapsedK}</span><span class="netf-v">{fmt(s.t)}</span></div>
            <div class="netf-meter" style="margin-top:8px"><span style={`width:${Math.max(1, (s.t / COLD_TOTAL) * 100)}%`}></span></div>
          </div>
          <div>
            <div class="netf-row"><span class="netf-k">{copy.cacheK}</span><span class="netf-v netf-tone-dim">{s.cache.length ? `${s.cache.length}` : copy.empty}</span></div>
            <ul class="dnsw-cache">{s.cache.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>
        <p class="netf-note">{s.note}</p>
      </article>
    )))}

    <div class="netf-controls netf-js-only">
      <button type="button" class="netf-btn" data-sf-prev>← {copy.prev}</button>
      <span class="netf-count" data-sf-count aria-live="polite"></span>
      <button type="button" class="netf-btn" data-sf-next>{copy.next} →</button>
    </div>
  </div>
</SkeinFigure>

<style>
  .dnsw-cache { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .dnsw-cache li { font-family: var(--font-mono); font-size: 11.5px; color: var(--ink-2); padding: 4px 8px; border-left: 2px solid var(--ok); background: color-mix(in srgb, var(--ok) 7%, transparent); }
</style>

<script>
  import { initStepper, onEachRoot } from "./stepper";
  onEachRoot("[data-netf-walk]", (root) => {
    const ru = root.dataset.lang === "ru";
    initStepper(root, (n, t) => (ru ? `ШАГ ${n} ИЗ ${t}` : `STEP ${n} OF ${t}`));
  });
</script>
