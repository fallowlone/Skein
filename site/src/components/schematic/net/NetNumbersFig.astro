---
/**
 * NetNumbersFig — reference numbers as a tile grid. Drop-in for NumbersCard (same
 * id/title/stats props) in the networking track; tiles wrap long values instead of
 * stretching a label and its value to opposite edges of a wide row.
 */
import "./net-fig.css";

interface Stat { label: string; value: string }
interface Props { id?: string; title?: string; stats: Stat[] }
const { id, title = "Typical timings", stats } = Astro.props;
---

<figure id={id} class="netnum" data-lesson-visual>
  <figcaption class="netf-kicker">{title}</figcaption>
  <dl class="netnum-grid">
    {stats.map((s) => (
      <div class="netnum-tile">
        <dt class="netnum-k">{s.label}</dt>
        <dd class="netnum-v">{s.value}</dd>
      </div>
    ))}
  </dl>
</figure>

<style>
  .netnum { margin: 36px 0; display: flex; flex-direction: column; gap: 12px; }
  .netnum-grid { margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
  .netnum-tile { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 6px; padding: 14px 16px; border: 1px solid var(--hairline-2); border-radius: var(--r-sm); background: var(--card); }
  .netnum-v { margin: 0; font: 600 16px/1.3 var(--font-mono); color: var(--ink); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .netnum-k { font: 12.5px/1.4 var(--font-body); color: var(--muted); overflow-wrap: anywhere; }
</style>
