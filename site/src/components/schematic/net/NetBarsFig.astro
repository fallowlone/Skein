---
/**
 * NetBarsFig — a labelled quantity comparison as horizontal bars.
 * Replaces chart-column / chart-bar / chart-line infographics in the networking track. Labels,
 * bars and values sit in a grid row each, so long labels wrap instead of colliding. When values
 * span 50× or more, a linear/log toggle keeps the small bars readable.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";
import { UI, type Lang } from "./i18n";

interface Value { label: string; value: number }
interface Props { title?: string; desc?: string; values: Value[]; unit?: string; label: string; caption?: string; hue?: string; lang?: Lang }
const { title, desc, values, unit = "", label, caption, hue = "var(--d-network)", lang = "en" } = Astro.props;
const ui = UI[lang];

const max = Math.max(...values.map((v) => v.value), 0);
const minPos = Math.min(...values.map((v) => v.value).filter((v) => v > 0));
const wide = max > 0 && Number.isFinite(minPos) && max / minPos >= 50;
const pct = (v: number) => (max > 0 ? Math.max(0.6, (v / max) * 100) : 0);
const logPct = (v: number) => (v > 0 && max > minPos ? Math.max(3, (Math.log10(v / minPos) / Math.log10(max / minPos)) * 97 + 3) : v > 0 ? 100 : 0);
const fmt = (v: number) => `${v.toLocaleString(lang === "ru" ? "ru-RU" : "en-US", { maximumFractionDigits: 2 })}${unit ? ` ${unit}` : ""}`;
---

<SkeinFigure label={label} caption={caption} span="learning" hue={hue}>
  <div class="netf-root" data-netf-bars role="group" aria-label={label}>
    {(title || desc) && (
      <div class="netf-head">
        {title && <h4 class="netf-head-title">{title}</h4>}
        {desc && <p class="netf-head-desc">{desc}</p>}
      </div>
    )}
    {wide && (
      <div class="netf-seg netf-js-only" role="group" aria-label={ui.scaleK}>
        <button type="button" class="netf-chip" data-scale="linear" aria-pressed="true">{ui.linear}</button>
        <button type="button" class="netf-chip" data-scale="log" aria-pressed="false">{ui.log}</button>
      </div>
    )}
    <ul class="netbars">
      {values.map((v) => (
        <li class="netbars-row" data-max={v.value === max ? "" : undefined}>
          <span class="netbars-label">{v.label}</span>
          <span class="netbars-track" aria-hidden="true"><span class="netbars-bar" style={`width:${pct(v.value)}%`} data-lin={pct(v.value)} data-log={logPct(v.value)}></span></span>
          <span class="netbars-v">{fmt(v.value)}</span>
        </li>
      ))}
    </ul>
  </div>
</SkeinFigure>

<style>
  .netbars { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .netbars-row { display: grid; grid-template-columns: minmax(120px, 34%) minmax(0, 1fr) auto; align-items: center; gap: 6px 14px; }
  .netbars-label { font: 13.5px/1.35 var(--font-body); color: var(--ink-2); overflow-wrap: anywhere; }
  .netbars-track { height: 14px; border-radius: 3px; background: color-mix(in srgb, var(--hairline) 70%, transparent); overflow: hidden; }
  .netbars-bar { display: block; height: 100%; border-radius: 3px; background: color-mix(in srgb, var(--d, var(--accent)) 70%, var(--card)); }
  .netbars-row[data-max] .netbars-bar { background: var(--d, var(--accent)); }
  .netbars-v { font: 600 13px/1.3 var(--font-mono); color: var(--ink); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  @media (max-width: 560px) {
    .netbars-row { grid-template-columns: minmax(0, 1fr) auto; }
    .netbars-label { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: no-preference) { .netbars-bar { transition: width 260ms ease; } }
</style>

<script>
  import { onEachRoot } from "./stepper";
  onEachRoot("[data-netf-bars]", (root) => {
    if (root.dataset.js) return;
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-scale]"));
    const bars = Array.from(root.querySelectorAll<HTMLElement>(".netbars-bar"));
    const set = (scale: string) => {
      btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.scale === scale)));
      bars.forEach((bar) => (bar.style.width = `${scale === "log" ? bar.dataset.log : bar.dataset.lin}%`));
    };
    btns.forEach((b) => b.addEventListener("click", () => set(b.dataset.scale ?? "linear")));
    root.dataset.js = "true";
  });
</script>
