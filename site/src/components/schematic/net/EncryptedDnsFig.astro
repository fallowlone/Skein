---
/**
 * EncryptedDnsFig — the same lookup over Do53, DoT, DoH and DoQ, seen from the wire.
 * Answers: "What does an on-path observer learn, and where does the trust move?"
 * Each transport highlights the encrypted leg on the path and fills a fixed set of rows
 * (visible name, port, blockability, blending, tampering), plus what still leaks.
 */
import "./net-fig.css";
import SkeinFigure from "../SkeinFigure.astro";
import MachineValue from "../MachineValue.astro";

interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}
const { lang = "en", span = "learning" } = Astro.props;

type Mode = "do53" | "dot" | "doh" | "doq";
type Tone = "ok" | "warn" | "danger";
const MODES: { id: Mode; name: string; wire: string; encrypted: boolean }[] = [
  { id: "do53", name: "Do53", wire: "UDP 53 · plaintext", encrypted: false },
  { id: "dot", name: "DoT", wire: "TCP 853 · TLS", encrypted: true },
  { id: "doh", name: "DoH", wire: "TCP 443 · HTTPS", encrypted: true },
  { id: "doq", name: "DoQ", wire: "UDP 853 · QUIC", encrypted: true },
];

const copy = {
  en: {
    category: "WHO SEES WHAT",
    title: "Encrypt the query, and trust moves to the resolver",
    label: "Interactive comparison of one DNS lookup over Do53, DoT, DoH and DoQ as seen by an on-path observer such as a Wi-Fi operator or ISP: whether the queried name is visible, which port is used, how easily it can be blocked, whether it blends with web traffic, and whether answers can be altered. A final row shows what still leaks.",
    thesis: "Encryption hides your lookups from the network, not from the resolver you chose.",
    caption: "Rows describe a typical deployment. DoT and DoQ share port 853; only DoH hides inside ordinary HTTPS on 443.",
    modeK: "Transport", cipher: "ciphertext",
    nodes: ["You", "On-path observer", "Resolver"], nodesSub: ["browser / OS", "Wi-Fi, ISP, censor", "1.1.1.1, 8.8.8.8, …"],
    rows: { name: "Queried name", port: "Port on the wire", block: "Blocking it", blend: "Looks like web traffic", tamper: "Can forge answers in transit" },
    values: {
      do53: { name: ["visible: www.example.com", "danger"], port: ["53 / UDP", "danger"], block: ["trivial", "danger"], blend: ["no", "danger"], tamper: ["yes", "danger"] },
      dot: { name: ["hidden", "ok"], port: ["853 / TCP", "warn"], block: ["one firewall rule", "warn"], blend: ["no", "warn"], tamper: ["no", "ok"] },
      doh: { name: ["hidden", "ok"], port: ["443 / TCP", "ok"], block: ["only by resolver IP", "ok"], blend: ["yes", "ok"], tamper: ["no", "ok"] },
      doq: { name: ["hidden", "ok"], port: ["853 / UDP", "warn"], block: ["one firewall rule", "warn"], blend: ["no", "warn"], tamper: ["no", "ok"] },
    } as Record<Mode, Record<string, [string, Tone]>>,
    resolverK: "The resolver still sees", resolverV: "every name you look up, your IP (and subnet via ECS if enabled)",
    leakK: "Still leaks to the observer", leakV: "the IP you connect to next, and the site name in TLS SNI unless the site supports ECH",
    note: {
      do53: "Every name crosses the network in plaintext. Anyone on the path can log it, block it by port, or race a forged answer.",
      dot: "The query is encrypted, but a dedicated port makes DoT easy to spot and to block wholesale.",
      doh: "The query rides inside HTTPS on 443. Blocking it means blocking specific resolver IPs, not a port.",
      doq: "Same privacy as DoT, over QUIC streams: no head-of-line blocking and connection migration across networks.",
    },
  },
  ru: {
    category: "КТО ЧТО ВИДИТ",
    title: "Зашифруйте запрос, и доверие переедет к резолверу",
    label: "Интерактивное сравнение одного DNS-запроса через Do53, DoT, DoH и DoQ глазами наблюдателя на пути, например оператора Wi-Fi или провайдера: видно ли запрошенное имя, какой порт используется, насколько легко заблокировать, сливается ли с веб-трафиком и можно ли подменить ответ. Последняя строка показывает, что утекает всё равно.",
    thesis: "Шифрование прячет ваши запросы от сети, но не от выбранного резолвера.",
    caption: "Строки описывают типичное развёртывание. DoT и DoQ делят порт 853; только DoH прячется в обычном HTTPS на 443.",
    modeK: "Транспорт", cipher: "шифротекст",
    nodes: ["Вы", "Наблюдатель на пути", "Резолвер"], nodesSub: ["браузер / ОС", "Wi-Fi, провайдер, цензор", "1.1.1.1, 8.8.8.8, …"],
    rows: { name: "Запрошенное имя", port: "Порт на проводе", block: "Заблокировать", blend: "Похоже на веб-трафик", tamper: "Подделать ответ по пути" },
    values: {
      do53: { name: ["видно: www.example.com", "danger"], port: ["53 / UDP", "danger"], block: ["тривиально", "danger"], blend: ["нет", "danger"], tamper: ["да", "danger"] },
      dot: { name: ["скрыто", "ok"], port: ["853 / TCP", "warn"], block: ["одно правило файрвола", "warn"], blend: ["нет", "warn"], tamper: ["нет", "ok"] },
      doh: { name: ["скрыто", "ok"], port: ["443 / TCP", "ok"], block: ["только по IP резолвера", "ok"], blend: ["да", "ok"], tamper: ["нет", "ok"] },
      doq: { name: ["скрыто", "ok"], port: ["853 / UDP", "warn"], block: ["одно правило файрвола", "warn"], blend: ["нет", "warn"], tamper: ["нет", "ok"] },
    } as Record<Mode, Record<string, [string, Tone]>>,
    resolverK: "Резолвер по-прежнему видит", resolverV: "каждое имя, которое вы ищете, ваш IP (и подсеть через ECS, если включён)",
    leakK: "Наблюдателю всё равно утекает", leakV: "IP, к которому вы подключитесь следом, и имя сайта в TLS SNI, если сайт не поддерживает ECH",
    note: {
      do53: "Каждое имя идёт по сети открытым текстом. Любой на пути может его записать, заблокировать по порту или подсунуть поддельный ответ.",
      dot: "Запрос зашифрован, но выделенный порт позволяет легко заметить DoT и заблокировать его целиком.",
      doh: "Запрос едет внутри HTTPS на 443. Чтобы его заблокировать, нужно блокировать конкретные IP резолверов, а не порт.",
      doq: "Та же приватность, что у DoT, поверх потоков QUIC: без head-of-line blocking и с миграцией соединения между сетями.",
    },
  },
}[lang];
const XS = [70, 320, 570];
---

<SkeinFigure num="05" category={copy.category} title={copy.title} label={copy.label} thesis={copy.thesis} caption={copy.caption} span={span} hue="var(--d-network)">
  <div class="netf-root" data-netf-encrypted data-sf-all role="group" aria-label={copy.title}>
    <div class="netf-seg netf-js-only" role="group" aria-label={copy.modeK}>
      <span class="netf-seg-k">{copy.modeK}</span>
      {MODES.map((m) => <button type="button" class="netf-chip" data-sf-mode={m.id} aria-pressed={m.id === "do53" ? "true" : "false"}>{m.name}</button>)}
    </div>

    {MODES.map((m) => (
      <article class="netf-panel" data-sf-panel data-sf-group={m.id} data-sf-default={m.id === "do53" ? "" : undefined} aria-label={m.name}>
        <span class="netf-kicker netf-nojs-only">{m.name}</span>
        <div class="netf-stage">
          <svg viewBox="0 0 640 116" class="netf-svg" aria-hidden="true">
            <line x1={XS[0]} y1="44" x2={XS[2]} y2="44" stroke={m.encrypted ? "var(--ok)" : "var(--danger)"} stroke-width={m.encrypted ? 6 : 2} stroke-linecap="round" opacity={m.encrypted ? 0.35 : 1} stroke-dasharray={m.encrypted ? undefined : "6 4"} />
            {m.encrypted && <line x1={XS[0]} y1="44" x2={XS[2]} y2="44" stroke="var(--ok)" stroke-width="1.6" />}
            <text x={(XS[0] + XS[1]) / 2} y="30" text-anchor="middle" class="netf-wire">{m.wire}</text>
            <text x={(XS[1] + XS[2]) / 2} y="30" text-anchor="middle" class={m.encrypted ? "netf-wire netf-wire-muted" : "netf-wire"}>{m.encrypted ? copy.cipher : "A? www.example.com"}</text>
            {XS.map((x, i) => (
              <g>
                <circle cx={x} cy="44" r={i === 1 ? 13 : 11} fill="var(--card)" stroke={i === 1 ? (m.encrypted ? "var(--hairline-2)" : "var(--danger)") : "var(--d, var(--accent))"} stroke-width="1.6" />
                {i === 1 && <text x={x} y="48" text-anchor="middle" class="netf-wire" fill={m.encrypted ? "var(--muted)" : "var(--danger)"}>{m.encrypted ? "?" : "!"}</text>}
                <text x={x} y="80" text-anchor="middle" class="netf-node-label">{copy.nodes[i]}</text>
                <text x={x} y="94" text-anchor="middle" class="netf-node-sub">{copy.nodesSub[i]}</text>
              </g>
            ))}
          </svg>
        </div>

        <div class="dnse-rows">
          {(Object.keys(copy.rows) as (keyof typeof copy.rows)[]).map((k) => (
            <div class="netf-row"><span class="netf-k">{copy.rows[k]}</span><MachineValue size="sm" tone={copy.values[m.id][k][1]} val={copy.values[m.id][k][0]} /></div>
          ))}
        </div>
        <p class="netf-note">{copy.note[m.id]}</p>
        <div class="dnse-fine">
          <p><span class="netf-k">{copy.resolverK}</span> {copy.resolverV}</p>
          <p><span class="netf-k">{copy.leakK}</span> {copy.leakV}</p>
        </div>
      </article>
    ))}
  </div>
</SkeinFigure>

<style>
  .dnse-rows { display: flex; flex-direction: column; }
  .dnse-fine { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px 24px; padding: 12px 14px; border-radius: var(--r-sm); background: color-mix(in srgb, var(--warn) 7%, transparent); border-left: 3px solid var(--warn); }
  .dnse-fine p { margin: 0; display: flex; flex-direction: column; gap: 4px; font: 13.5px/1.5 var(--font-body); color: var(--ink-2); }
</style>

<script>
  import { initModes, onEachRoot } from "./stepper";
  onEachRoot("[data-netf-encrypted]", initModes);
</script>
