---
/**
 * CallSiteIdentityFig — Tier-B learning figure.
 *
 * Call-site identity: a site that always sees callee
 * A stays monomorphic and inlines A — inlining
 * unlocks folding, scheduling, and escape analysis
 * across the boundary. Fed A through E, the site
 * degrades megamorphic into an opaque indirect call
 * nothing can cross. Fix: split identities onto
 * separate sites, or reuse one callback.
 *
 * Server-rendered; the is:inline script walks the
 * degradation. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "CALL-SITE IDENTITY",
    title: "One call site, one identity — or generic",
    label: "A call site that always sees fn A stays monomorphic and inlines A. A site fed A, B, C, D, E degrades megamorphic into an opaque indirect call nothing can cross.",
    thesis: "One identity per site inlines — spread identities across sites, not onto one line.",
    caption: "The IC slot at a call site records callee identity. One identity means the optimiser can inline the body and fold across the boundary; many identities mean a generic indirect call on every iteration.",
    scope: "V8-SPECIFIC MODEL",
    states: "CALL-SITE STATES",
    fix: "THE FIX",
    states: [
      { name: "call site", note: "one variable holding a fn — fn(x), one IC slot" },
      { name: "monomorphic", note: "always A: 1 callee — the body inlines" },
      { name: "megamorphic", note: "A…E: generic call — indirect, opaque" },
      { name: "split", note: "one identity per site — each site inlines" },
    ],
    flow: [
      { state: "call site", log: "fn(x) · IC slot" },
      { state: "monomorphic", log: "1 identity · inline" },
      { state: "megamorphic", log: "many → indirect" },
      { state: "split", log: "switch → mono each" },
    ],
    inline: "INLINE — THE WHOLE GAME",
    inlineBody: "Inlining unlocks folding, scheduling, and escape analysis across the boundary. A generic call blocks all of it on every iteration.",
    arrows: "FRESH ARROWS — NEW IDENTITIES",
    arrowsBody: "arr.map(x => f(x)) mints a new callback identity per call. Reuse one callback or hand-write the hot loop.",
  },
  ru: {
    category: "ИДЕНТИЧНОСТЬ САЙТА ВЫЗОВА",
    title: "Один сайт — одна идентичность, или generic",
    label: "Сайт вызова, всегда видящий fn A, остаётся monomorphic и инлайнит A. Сайт, кормленный A, B, C, D, E, деградирует в megamorphic — непрозрачный непрямой вызов, который нельзя пересечь.",
    thesis: "Одна идентичность на сайт инлайнится — размазывайте идентичности по сайтам, а не по одной строке.",
    caption: "IC-слот на сайте вызова записывает идентичность callee. Одна идентичность — оптимизатор может инлайнить тело и сворачивать через границу; много идентичностей — generic непрямой вызов на каждой итерации.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    states: "СОСТОЯНИЯ САЙТА ВЫЗОВА",
    fix: "ПОПРАВКА",
    states: [
      { name: "сайт вызова", note: "одна переменная с функцией — fn(x), один IC-слот" },
      { name: "monomorphic", note: "всегда A: 1 callee — тело инлайнится" },
      { name: "megamorphic", note: "A…E: generic вызов — непрямой, непрозрачный" },
      { name: "split", note: "одна идентичность на сайт — каждый сайт инлайнится" },
    ],
    flow: [
      { state: "сайт вызова", log: "fn(x) · IC-слот" },
      { state: "monomorphic", log: "1 идентичность · inline" },
      { state: "megamorphic", log: "много → indirect" },
      { state: "split", log: "switch → mono каждый" },
    ],
    inline: "INLINE — ВСЯ ИГРА",
    inlineBody: "Инлайнинг открывает свёртывание, scheduling и escape analysis через границу. Generic вызов блокирует всё это на каждой итерации.",
    arrows: "СВЕЖИЕ СТРЕЛКИ — НОВЫЕ ИДЕНТИЧНОСТИ",
    arrowsBody: "arr.map(x => f(x)) чеканит новую идентичность callback'а на каждый вызов. Переиспользуйте один callback или напишите горячий цикл руками.",
  },
} as const;

const t = copy[lang];
const states = t.states;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="csf" data-csf>
    <div class="csf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="csf-head">
      <TechnicalLabel tone="muted" size="xs">{t.states}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.fix}</TechnicalLabel>
    </div>

    <ol class="csf-states">
      {states.map((s, i) => (
        <li class="csf-state-card" data-csf-state={i}>
          <div class="csf-state-main">
            <MachineValue value={s.name} tone={i === 1 ? "ok" : i === 2 ? "danger" : undefined} />
          </div>
          <p class="csf-state-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="csf-flow">
      {flow.map((s, i) => (
        <li class="csf-step" data-csf-step={i} hidden={i !== 0}>
          <span class="csf-state-name">{s.state}</span>
          <MachineValue value={s.log} tone={i === 2 ? "danger" : i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="csf-inline">
      <TechnicalLabel tone="ok" size="xs">{t.inline}</TechnicalLabel>
      {t.inlineBody}
    </p>
    <p class="csf-arrows">
      <TechnicalLabel tone="warn" size="xs">{t.arrows}</TechnicalLabel>
      {t.arrowsBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the degradation.
  // Step 0 is server-rendered; the script replays the identity story.
  (() => {
    const roots = document.querySelectorAll("[data-csf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-csf-step]");
      const states = root.querySelectorAll("[data-csf-state]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        states.forEach((el, j) => {
          el.classList.toggle("csf-state-live", j === Math.min(n, states.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .csf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .csf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .csf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .csf-states {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .csf-state-card {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .csf-state-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .csf-state-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .csf-state-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .csf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .csf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .csf-state-name {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .csf-inline,
  .csf-arrows {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .csf-states { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .csf-states { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .csf-state-card {
      animation: csf-state-in var(--dur-2) var(--ease) both;
    }
    .csf-state-card:nth-child(2) { animation-delay: 100ms; }
    .csf-state-card:nth-child(3) { animation-delay: 200ms; }
    .csf-state-card:nth-child(4) { animation-delay: 300ms; }
    @keyframes csf-state-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
