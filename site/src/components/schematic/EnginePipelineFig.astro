---
/**
 * EnginePipelineFig — Tier-B learning figure.
 *
 * One function through the engine: source text → AST → bytecode →
 * (hot) machine code, with GC reclaiming dead objects underneath all
 * of it. The four stages are a pipeline the reader walks once; the
 * cold/hot fork at the JIT stage is the causal hinge — cold code
 * never leaves the interpreter, so it stays cheap.
 *
 * Server-rendered; the is:inline script only adds a stage-highlight
 * walk for readers with JS on. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "ENGINE PIPELINE",
    title: "Every function enters at the parser and climbs only if it proves hot",
    label: "One function through the engine: parse, bytecode, interpret, then JIT compile if hot. GC reclaims dead objects beneath every stage.",
    thesis: "Cold code never leaves the interpreter — that is why starting is cheap.",
    caption: "The fork at stage 3 is the whole adaptive story: heat earns machine code, cold stays bytecode. The GC is not a stage on the critical path — it reclaims underneath all of them.",
    scope: "V8-SPECIFIC MODEL",
    stage: "STAGE",
    cold: "COLD PATH",
    hot: "HOT PATH",
    stages: [
      { num: "01", name: "parse", out: "source → AST", note: "lazy pre-parse skips uncalled bodies" },
      { num: "02", name: "bytecode", out: "Ignition emits", note: "register VM, memory-light" },
      { num: "03", name: "interpret", out: "cold runs", note: "cheap start · every function begins here" },
      { num: "04", name: "JIT hot", out: "machine code", note: "earned by repeated heat only" },
    ],
    gc: "GC runs alongside everything — Orinoco reclaims dead objects while the pipeline works",
    fork: "fork: hot? climb to Sparkplug · Maglev · TurboFan",
  },
  ru: {
    category: "КОНВЕЙЕР ДВИЖКА",
    title: "Каждая функция входит в парсер и поднимается выше, только если доказала свою горячесть",
    label: "Одна функция через движок: parse, bytecode, interpret, затем JIT-компиляция если hot. GC reclaim'ит мёртвые объекты под всеми стадиями.",
    thesis: "Холодный код никогда не покидает интерпретатор — поэтому старт дешёвый.",
    caption: "Вилка на стадии 3 — вся адаптивная история: жар зарабатывает machine code, холод остаётся на bytecode. GC — не стадия на критическом пути: он reclaim'ит underneath всех них.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    stage: "СТАДИЯ",
    cold: "ХОЛОДНЫЙ ПУТЬ",
    hot: "ГОРЯЧИЙ ПУТЬ",
    stages: [
      { num: "01", name: "parse", out: "source → AST", note: "lazy pre-parse пропускает не вызванные тела" },
      { num: "02", name: "bytecode", out: "Ignition излучает", note: "register VM, мало памяти" },
      { num: "03", name: "interpret", out: "холодные запуски", note: "дешёвый старт · здесь начинает каждая функция" },
      { num: "04", name: "JIT hot", out: "machine code", note: "зарабатывается только повторным жаром" },
    ],
    gc: "GC работает параллельно всему — Orinoco reclaim'ит мёртвые объекты пока конвейер работает",
    fork: "вилка: hot? подъём к Sparkplug · Maglev · TurboFan",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="epf" data-epf>
    <div class="epf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <ol class="epf-stages">
      {stages.map((s, i) => (
        <li class="epf-stage" data-epf-stage={i}>
          <div class="epf-stage-head">
            <TechnicalLabel tone="muted" size="xs">{t.stage} {s.num}</TechnicalLabel>
            <MachineValue value={s.name} tone={i === 3 ? "accent" : undefined} />
          </div>
          <p class="epf-out">{s.out}</p>
          <p class="epf-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <div class="epf-fork" aria-hidden="true">
      <span class="epf-fork-cold">{t.cold}</span>
      <span class="epf-fork-line" />
      <span class="epf-fork-hot">{t.hot}</span>
    </div>
    <p class="epf-fork-note">{t.fork}</p>

    <p class="epf-gc">
      <TechnicalLabel tone="muted" size="xs">GC</TechnicalLabel>
      {t.gc}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the stages, highlighting each.
  // Every stage is already in the DOM — no-JS readers see the whole
  // pipeline; this script only adds the sequential emphasis.
  (() => {
    const roots = document.querySelectorAll("[data-epf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const stages = root.querySelectorAll("[data-epf-stage]");
      if (!stages.length) continue;
      if (reduceMotion) {
        stages.forEach((el) => el.classList.add("epf-stage-live"));
        continue;
      }
      let i = 0;
      const show = (n) => {
        stages.forEach((el, j) => {
          el.classList.toggle("epf-stage-live", j === n);
          el.classList.toggle("epf-stage-done", j < n);
        });
      };
      show(0);
      setInterval(() => {
        i = (i + 1) % (stages.length + 1);
        show(i === stages.length ? 0 : i);
      }, 2400);
    }
  })();
</script>

<style>
  .epf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .epf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .epf-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .epf-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .epf-stage-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .epf-out {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .epf-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  .epf-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }
  .epf-stage-done { border-color: var(--hairline-strong); }

  .epf-fork {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-block: 6px;
    border-block: 0.5px dashed var(--hairline-2);
  }

  .epf-fork-cold,
  .epf-fork-hot {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .epf-fork-hot { color: var(--accent); }

  .epf-fork-line {
    flex: 1;
    height: 0.5px;
    background: var(--hairline-2);
  }

  .epf-fork-note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .epf-gc {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .epf-stages { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .epf-stages { grid-template-columns: 1fr; }
    .epf-fork-cold, .epf-fork-hot { font-size: 10px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .epf-stage {
      animation: epf-stage-in var(--dur-2) var(--ease) both;
    }
    .epf-stage:nth-child(2) { animation-delay: 120ms; }
    .epf-stage:nth-child(3) { animation-delay: 240ms; }
    .epf-stage:nth-child(4) { animation-delay: 360ms; }
    @keyframes epf-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
