---
/**
 * TcpStateMachineFig — Tier-B learning figure.
 *
 * The TCP connection lifecycle as a state machine: open walks
 * CLOSED → SYN-SENT → ESTABLISHED, close walks ESTABLISHED →
 * FIN-WAIT-1 → FIN-WAIT-2 → TIME-WAIT → CLOSED. TIME-WAIT
 * exists to let the final ACK be retransmitted and to drain
 * delayed duplicates; its 2·MSL dwell is the cost of a clean
 * close, not a bug.
 *
 * Server-rendered; the is:inline script replays the open and
 * close traversals. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "STATE MACHINE",
    title: "One connection, two traversals",
    label: "The TCP lifecycle as a state machine: open walks CLOSED to SYN-SENT to ESTABLISHED; close walks ESTABLISHED through FIN-WAIT-1, FIN-WAIT-2 and TIME-WAIT back to CLOSED.",
    thesis: "States exist to make an unreliable network look like a ordered byte stream.",
    caption: "Open is three packets; close is four. TIME-WAIT dwells 2·MSL so the final ACK can be retransmitted and delayed duplicates drain — the price of a clean close.",
    scope: "RFC 793 LIFECYCLE",
    open: "OPEN — CLIENT SENDS SYN",
    close: "CLOSE — EITHER END CAN START",
    rule: "TIME-WAIT ≠ BROKEN",
    states: [
      { name: "CLOSED", note: "no connection" },
      { name: "SYN-SENT", note: "SYN out, waiting for SYN-ACK" },
      { name: "ESTABLISHED", note: "both sides synchronized" },
      { name: "FIN-WAIT-1", note: "FIN sent, awaiting ACK" },
      { name: "FIN-WAIT-2", note: "FIN ACKed, awaiting peer FIN" },
      { name: "TIME-WAIT", note: "2·MSL dwell, drains duplicates" },
    ],
    flow: [
      { state: "open", log: "SYN → SYN-SENT" },
      { state: "synchronized", log: "SYN-ACK → ESTABLISHED" },
      { state: "closing", log: "FIN → FIN-WAIT-1" },
      { state: "half-closed", log: "ACK → FIN-WAIT-2" },
      { state: "waiting", log: "FIN → TIME-WAIT" },
      { state: "gone", log: "2·MSL → CLOSED ✓" },
    ],
    timewait: "WHY TIME-WAIT WAITS",
    timewaitBody: "A lost final ACK must be retransmittable, so the endpoint stays reachable for 2·MSL. The same window lets delayed duplicates from the old connection expire before the port is reused.",
  },
  ru: {
    category: "КОНЕЧНЫЙ АВТОМАТ",
    title: "Одно соединение — два обхода",
    label: "Жизненный цикл TCP как конечный автомат: открытие идёт CLOSED → SYN-SENT → ESTABLISHED; закрытие — ESTABLISHED через FIN-WAIT-1, FIN-WAIT-2 и TIME-WAIT обратно в CLOSED.",
    thesis: "Состояния делают ненадёжную сеть похожей на упорядоченный поток байтов.",
    caption: "Открытие — три пакета; закрытие — четыре. TIME-WAIT держится 2·MSL, чтобы финальный ACK можно было передать повторно и ушли дубликаты — цена чистого закрытия.",
    scope: "ЖИЗНЕННЫЙ ЦИКЛ RFC 793",
    open: "ОТКРЫТИЕ — КЛИЕНТ ПОСЫЛАЕТ SYN",
    close: "ЗАКРЫТИЕ — НАЧИНАЕТ ЛЮБАЯ СТОРОНА",
    rule: "TIME-WAIT ≠ СБОЙ",
    states: [
      { name: "CLOSED", note: "нет соединения" },
      { name: "SYN-SENT", note: "SYN отправлен, ждём SYN-ACK" },
      { name: "ESTABLISHED", note: "обе стороны синхронизированы" },
      { name: "FIN-WAIT-1", note: "FIN отправлен, ждём ACK" },
      { name: "FIN-WAIT-2", note: "FIN подтверждён, ждём FIN пира" },
      { name: "TIME-WAIT", note: "держка 2·MSL, дубликаты уходят" },
    ],
    flow: [
      { state: "открытие", log: "SYN → SYN-SENT" },
      { state: "синхронизация", log: "SYN-ACK → ESTABLISHED" },
      { state: "закрытие", log: "FIN → FIN-WAIT-1" },
      { state: "полузакрытие", log: "ACK → FIN-WAIT-2" },
      { state: "ожидание", log: "FIN → TIME-WAIT" },
      { state: "закрыто", log: "2·MSL → CLOSED ✓" },
    ],
    timewait: "ПОЧЕМУ TIME-WAIT ЖДЁТ",
    timewaitBody: "Потерянный финальный ACK должен быть повторно передаваем — endpoint остаётся доступным 2·MSL. То же окно даёт дубликатам от старого соединения expire до переиспользования порта.",
  },
} as const;

const t = copy[lang];
const states = t.states;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="tsm" data-tsm>
    <div class="tsm-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="tsm-head">
      <TechnicalLabel tone="muted" size="xs">{t.open}</TechnicalLabel>
      <TechnicalLabel tone="muted" size="xs">{t.close}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="tsm-states">
      {states.map((s, i) => (
        <li class="tsm-state" data-tsm-state={i}>
          <MachineValue value={s.name} tone={i === 2 ? "ok" : i === 5 ? "warn" : undefined} variant="chip" size="sm" />
          <p class="tsm-state-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="tsm-flow">
      {flow.map((s, i) => (
        <li class="tsm-step" data-tsm-step={i} hidden={i !== 0}>
          <span class="tsm-state-name">{s.state}</span>
          <MachineValue value={s.log} tone={i === 5 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="tsm-note">
      <TechnicalLabel tone="warn" size="xs">{t.timewait}</TechnicalLabel>
      {t.timewaitBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: replay open, then close.
  (() => {
    const roots = document.querySelectorAll("[data-tsm]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-tsm-step]");
      const states = root.querySelectorAll("[data-tsm-state]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        states.forEach((el, j) => {
          el.classList.toggle("tsm-state-live", j <= Math.min(n, states.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        states.forEach((el) => el.classList.add("tsm-state-live"));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .tsm {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .tsm-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .tsm-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tsm-states {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tsm-state {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .tsm-state-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .tsm-state-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .tsm-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tsm-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .tsm-state-name {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .tsm-note {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .tsm-states { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .tsm-states { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tsm-state {
      animation: tsm-state-in var(--dur-2) var(--ease) both;
    }
    .tsm-state:nth-child(2) { animation-delay: 60ms; }
    .tsm-state:nth-child(3) { animation-delay: 120ms; }
    .tsm-state:nth-child(4) { animation-delay: 180ms; }
    .tsm-state:nth-child(5) { animation-delay: 240ms; }
    .tsm-state:nth-child(6) { animation-delay: 300ms; }
    @keyframes tsm-state-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
