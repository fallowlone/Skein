---
/**
 * SkeinFigure — The canonical editorial figure container for the
 * Skein Editorial Schematic Language.
 *
 * Emits semantic HTML: <figure data-lesson-visual data-span={span}>
 * satisfying the lesson visual lint contract while establishing the
 * newspaper/print editorial aesthetic:
 *
 *   - Editorial Header: "FIG. 01", category tag, serif title, hairline divider
 *   - Drawing Canvas: clean negative space with subtle cartographic grid
 *   - Caption: conceptual serif conclusion / mono notes below
 *
 * Three-width breakout support:
 *   - reading:  ~640–700px (standard measure)
 *   - learning: ~760–860px (wide drills / side-by-side)
 *   - canvas:   ~1000–1200px (full visual canvas breakout)
 */
interface Props {
  /** Figure number, e.g. "01", "02", "03" */
  num?: string | number;
  /** Editorial serif title for the figure */
  title?: string;
  /** Categorical topic tag, e.g. "LATENCY COST", "PROTOCOL RITUAL", "STATE MACHINE" */
  category?: string;
  /** Accessible explanation of what the figure demonstrates */
  label: string;
  /**
   * Optional concise conceptual thesis, set in editorial serif italic.
   * Keep it to one short sentence: the typography contract is
   * "one serif thesis + sans-serif technical clarification".
   */
  thesis?: string;
  /** Optional technical clarification rendered in sans-serif below the thesis */
  caption?: string;
  /** Layout width tier: "reading" (default ~680px), "learning" (~840px), "canvas" (~1120px) */
  span?: "reading" | "learning" | "canvas";
  /** Optional theme hue token (e.g. var(--d-network)) */
  hue?: string;
  /** Optional borderless / minimal variant */
  variant?: "framed" | "canvas" | "clean";
}

const {
  num,
  title,
  category,
  label,
  thesis,
  caption,
  span = "canvas",
  hue,
  variant = "canvas",
} = Astro.props;

const numStr = num !== undefined ? String(num).padStart(2, "0") : undefined;
---

<figure
  data-lesson-visual
  data-span={span}
  class={`sk-figure sk-span-${span} sk-variant-${variant}`}
  style={hue ? `--d: ${hue};` : undefined}
  aria-label={label}
>
  {(numStr || title || category) && (
    <div class="sk-figure-head" aria-hidden="true">
      <div class="sk-figure-meta">
        {numStr && <span class="sk-figure-num">FIG. {numStr}</span>}
        {numStr && category && <span class="sk-figure-sep">/</span>}
        {category && <span class="sk-figure-cat">{category}</span>}
      </div>
      {title && <h3 class="sk-figure-title">{title}</h3>}
      <div class="sk-figure-rule"></div>
    </div>
  )}

  <div class="sk-figure-body">
    <slot />
  </div>

  {(thesis || caption) && (
    <figcaption class="sk-figure-caption">
      {numStr && <span class="sk-cap-num">FIG. {numStr}</span>}
      <span class="sk-cap-body">
        {thesis && <span class="sk-cap-thesis">{thesis}</span>}
        {caption && <span class="sk-cap-text">{caption}</span>}
      </span>
    </figcaption>
  )}
</figure>

<style>
  .sk-figure {
    position: relative;
    margin: 44px 0;
    padding: 0;
    color: var(--ink);
    box-sizing: border-box;
  }

  /* Three-width sizing tiers */
  .sk-span-reading {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
  }

  .sk-span-learning {
    width: 100%;
    max-width: 860px;
  }

  .sk-span-canvas {
    width: 100%;
    max-width: 1140px;
  }

  /* Figure header */
  .sk-figure-head {
    margin-bottom: 20px;
  }

  .sk-figure-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sk-figure-num {
    color: var(--d, var(--accent));
  }

  .sk-figure-sep {
    color: var(--hairline-strong);
    font-weight: 300;
  }

  .sk-figure-cat {
    color: var(--muted);
    letter-spacing: 0.12em;
  }

  .sk-figure-title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 480;
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .sk-figure-rule {
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--hairline-strong) 0%,
      var(--hairline) 70%,
      transparent 100%
    );
  }

  /* Variant styling */

  .sk-variant-canvas .sk-figure-body {
    position: relative;
    padding: clamp(20px, 3.5vw, 36px) clamp(16px, 3vw, 32px);
    /* Barely-visible atmosphere: schematic must work without the grid. */
    background:
      linear-gradient(color-mix(in srgb, var(--hairline) 24%, transparent) 0.5px, transparent 0.5px),
      linear-gradient(90deg, color-mix(in srgb, var(--hairline) 24%, transparent) 0.5px, transparent 0.5px),
      var(--paper);
    background-size: 28px 28px;
    border-top: 0.5px solid var(--hairline-2);
    border-bottom: 0.5px solid var(--hairline-2);
    border-radius: 2px;
    overflow-x: auto;
  }

  .sk-variant-framed .sk-figure-body {
    padding: clamp(20px, 3vw, 32px);
    background: var(--paper);
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-md);
    overflow-x: auto;
  }

  .sk-variant-clean .sk-figure-body {
    padding: 12px 0;
    background: transparent;
    overflow-x: auto;
  }

  /* Caption: one serif conceptual thesis + sans-serif technical clarification */
  .sk-figure-caption {
    margin-top: 16px;
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  .sk-cap-num {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--d, var(--accent));
  }

  .sk-cap-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .sk-cap-thesis {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .sk-cap-text {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .sk-figure-caption {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
