---
/**
 * AwaitSuspendFig — Tier-B learning figure.
 *
 * Desugaring one await: the async body runs
 * synchronously to the await, subscribes a
 * resume continuation via PromiseResolve,
 * returns a pending promise, and the host is
 * free until the operand settles and the
 * continuation runs as a microtask. Two
 * awaits make three slices — not atomic.
 *
 * Server-rendered; the is:inline script walks
 * the suspension. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "AWAIT DESUGARING",
    title: "Await suspends the frame and returns the thread",
    label: "The async body runs synchronously to the await, subscribes a resume continuation, then returns a pending promise. The host is free until the operand settles and the continuation runs as a microtask.",
    thesis: "Run to await · return · resume by microtask.",
    caption: "The driver that resumes an async function runs on the microtask queue. The thread is free in between — which is why an async body is not one unit of work.",
    scope: "ASYNC MODEL",
    desugar: "DESUGARING ONE AWAIT",
    tick: "ONE TICK",
    stages: [
      { name: "run sync", note: "the body executes up to await x" },
      { name: "subscribe", note: "PromiseResolve(x) registers the resume reaction" },
      { name: "return", note: "pending promise out — the host is free" },
      { name: "resume", note: "settle runs the continuation as a microtask" },
    ],
    flow: [
      { state: "running", log: "body → await x" },
      { state: "subscribed", log: "PromiseResolve · resume" },
      { state: "suspended", log: "return · host free" },
      { state: "resumed", log: "reaction job → resume ✓" },
    ],
    sliced: "SLICED — NOT ONE UNIT",
    slicedBody: "Two awaits make three slices, each interleaving with every other pending microtask. That is why an async body is not atomic.",
    oneTick: "ONE TICK — SINCE V8 7.2",
    oneTickBody: "await p on a native promise used to cost about three ticks; the optimized path lands near p.then's single tick.",
  },
  ru: {
    category: "ДЕСАГАРИНГ AWAIT",
    title: "Await приостанавливает кадр и отдаёт поток",
    label: "Тело async выполняется синхронно до await, подписывает continuation возобновления, затем возвращает pending-промис. Хост свободен, пока операнд не settle'ится и continuation не запустится как микрозадача.",
    thesis: "Выполнить до await · вернуть · возобновить микрозадачей.",
    caption: "Драйвер, возобновляющий async-функцию, работает на очереди микрозадач. Поток между ними свободен — поэтому тело async не есть единица работы.",
    scope: "МОДЕЛЬ ASYNC",
    desugar: "ДЕСАГАРИНГ ОДНОГО AWAIT",
    tick: "ОДИН ТИК",
    stages: [
      { name: "синхронный прогон", note: "тело выполняется до await x" },
      { name: "подписка", note: "PromiseResolve(x) регистрирует реакцию возобновления" },
      { name: "возврат", note: "pending-промис наружу — хост свободен" },
      { name: "возобновление", note: "settle запускает continuation как микрозадачу" },
    ],
    flow: [
      { state: "выполнение", log: "тело → await x" },
      { state: "подписка", log: "PromiseResolve · resume" },
      { state: "пауза", log: "return · хост свободен" },
      { state: "возобновление", log: "реакция → resume ✓" },
    ],
    sliced: "НАРЕЗАННОЕ — НЕ ЕДИНИЦА",
    slicedBody: "Два await дают три слайса, каждый чередуется с любой другой ожидающей микрозадачей. Поэтому тело async не атомарно.",
    oneTick: "ОДИН ТИК — С V8 7.2",
    oneTickBody: "await p на нативном промисе раньше стоил около трёх тиков; оптимизированный путь выходит почти на один тик p.then.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="asf" data-asf>
    <div class="asf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="asf-head">
      <TechnicalLabel tone="muted" size="xs">{t.desugar}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.tick}</TechnicalLabel>
    </div>

    <ol class="asf-stages">
      {stages.map((s, i) => (
        <li class="asf-stage" data-asf-stage={i}>
          <div class="asf-stage-main">
            <MachineValue value={s.name} tone={i === 3 ? "ok" : undefined} />
          </div>
          <p class="asf-stage-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="asf-flow">
      {flow.map((s, i) => (
        <li class="asf-step" data-asf-step={i} hidden={i !== 0}>
          <span class="asf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="asf-sliced">
      <TechnicalLabel tone="warn" size="xs">{t.sliced}</TechnicalLabel>
      {t.slicedBody}
    </p>
    <p class="asf-oneTick">
      <TechnicalLabel tone="muted" size="xs">{t.oneTick}</TechnicalLabel>
      {t.oneTickBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: suspend and resume.
  // Step 0 is server-rendered; the script replays the suspension.
  (() => {
    const roots = document.querySelectorAll("[data-asf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-asf-step]");
      const stages = root.querySelectorAll("[data-asf-stage]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        stages.forEach((el, j) => {
          el.classList.toggle("asf-stage-live", j === Math.min(n, stages.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .asf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .asf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .asf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .asf-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .asf-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .asf-stage-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .asf-stage-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .asf-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .asf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .asf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .asf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .asf-sliced,
  .asf-oneTick {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .asf-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .asf-stages { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .asf-stage {
      animation: asf-stage-in var(--dur-2) var(--ease) both;
    }
    .asf-stage:nth-child(2) { animation-delay: 100ms; }
    .asf-stage:nth-child(3) { animation-delay: 200ms; }
    .asf-stage:nth-child(4) { animation-delay: 300ms; }
    @keyframes asf-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
