---
/**
 * TricolorMarkFig — Tier-B learning figure.
 *
 * Tri-color marking: white objects are unproven,
 * grey objects are the worklist frontier, black
 * objects are scanned and safe. Roots grey their
 * referents; the marker pops a grey object, greys
 * its white referents, and blackens it. When the
 * grey frontier drains, every remaining white
 * object is unreachable — sweep it.
 *
 * Server-rendered; the is:inline script drains the
 * frontier. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "TRI-COLOR MARK",
    title: "The wavefront sweeps white into garbage",
    label: "Roots grey their referents, the marker pops a grey object, greys its white referents, and blackens it. When the grey frontier drains, every remaining white object is unreachable.",
    thesis: "White is unproven, grey is the frontier, black is done — drain grey and the rest is garbage.",
    caption: "The invariant is the whole algorithm: no black object may point at a white one. The marker maintains it by greying referents before blackening, so nothing live is ever left white when the frontier empties.",
    scope: "V8-SPECIFIC MODEL",
    colors: "THREE COLORS",
    sweep: "THE SWEEP",
    colors: [
      { name: "white", note: "unproven — never visited; at the end, garbage" },
      { name: "grey", note: "the worklist frontier — referents not yet scanned" },
      { name: "black", note: "scanned and safe — on a root path, fully explored" },
    ],
    flow: [
      { state: "roots grey", log: "W0 · W1 frontier" },
      { state: "pop + grey", log: "W1 → W2" },
      { state: "drain", log: "W2 → W3" },
      { state: "white left", log: "W4 = garbage" },
    ],
    invariant: "THE INVARIANT",
    invariantBody: "No black object points at a white one. The marker greys referents before blackening, so a live object can never be left white when the frontier drains.",
    sweepNote: "THEN SWEEP",
    sweepBody: "Sweep walks the heap once and frees every object still white — the color tells it what to reclaim without a second trace.",
  },
  ru: {
    category: "ТРЁХЦВЕТНАЯ МЕТКА",
    title: "Волна сгребает белое в мусор",
    label: "Roots серят свои referent'ы, маркер вынимает серый объект, серует его белые referent'ы и чернеет. Когда серый фронт опустеет, каждый оставшийся белый объект недостижим.",
    thesis: "Белое — не доказано, серое — фронт, чёрное — готово; опорожните серое, и остальное — мусор.",
    caption: "Инвариант — весь алгоритм: чёрный объект не может указывать на белый. Маркер поддерживает его, серуя referent'ов перед почернением, так что при опустошении фронта живое не остаётся белым.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    colors: "ТРИ ЦВЕТА",
    sweep: "СГРЕБАНИЕ",
    colors: [
      { name: "белое", note: "не доказано — не посещено; в конце — мусор" },
      { name: "серое", note: "фронт рабочего списка — referent'ы ещё не сканированы" },
      { name: "чёрное", note: "сканировано и безопасно — на пути от root, полностью исследовано" },
    ],
    flow: [
      { state: "roots серы", log: "W0 · W1 фронт" },
      { state: "вынимать + серить", log: "W1 → W2" },
      { state: "сток", log: "W2 → W3" },
      { state: "белое осталось", log: "W4 = мусор" },
    ],
    invariant: "ИНВАРИАНТ",
    invariantBody: "Чёрный объект не указывает на белый. Маркер серует referent'ов перед почернением, так что при опустошении фронта живой объект не может остаться белым.",
    sweepNote: "ЗАТЕМ СГРЕБАНИЕ",
    sweepBody: "Sweep обходит кучу один раз и освобождает всё ещё белое — цвет говорит, что reclaim'ать, без второй трассировки.",
  },
} as const;

const t = copy[lang];
const colors = t.colors;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="tmf" data-tmf>
    <div class="tmf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="tmf-head">
      <TechnicalLabel tone="muted" size="xs">{t.colors}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.sweep}</TechnicalLabel>
    </div>

    <ol class="tmf-colors">
      {colors.map((c, i) => (
        <li class="tmf-color" data-tmf-color={i}>
          <div class="tmf-color-main">
            <MachineValue value={c.name} tone={i === 0 ? "danger" : i === 1 ? "warn" : "ok"} />
          </div>
          <p class="tmf-color-note">{c.note}</p>
        </li>
      ))}
    </ol>

    <ol class="tmf-flow">
      {flow.map((s, i) => (
        <li class="tmf-step" data-tmf-step={i} hidden={i !== 0}>
          <span class="tmf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "danger" : undefined} />
        </li>
      ))}
    </ol>

    <p class="tmf-invariant">
      <TechnicalLabel tone="accent" size="xs">{t.invariant}</TechnicalLabel>
      {t.invariantBody}
    </p>
    <p class="tmf-sweep">
      <TechnicalLabel tone="muted" size="xs">{t.sweepNote}</TechnicalLabel>
      {t.sweepBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: drain the grey frontier.
  // Step 0 is server-rendered; the script replays the marking.
  (() => {
    const roots = document.querySelectorAll("[data-tmf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-tmf-step]");
      const colors = root.querySelectorAll("[data-tmf-color]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        colors.forEach((el, j) => {
          el.classList.toggle("tmf-color-live", j === Math.min(n + 1, colors.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .tmf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .tmf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .tmf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tmf-colors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tmf-color {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .tmf-color-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tmf-color-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .tmf-color-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .tmf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tmf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .tmf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .tmf-invariant,
  .tmf-sweep {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .tmf-colors { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tmf-color {
      animation: tmf-color-in var(--dur-2) var(--ease) both;
    }
    .tmf-color:nth-child(2) { animation-delay: 100ms; }
    .tmf-color:nth-child(3) { animation-delay: 200ms; }
    @keyframes tmf-color-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
