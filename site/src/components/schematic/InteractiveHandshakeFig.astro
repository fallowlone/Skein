---
/**
 * InteractiveHandshakeFig (FIG. 03) — Primary Interactive Reference Handshake Stepper.
 *
 * The definitive Skein interaction reference and the widest (canvas) breakout.
 * Answers: "What exactly does each side know and guarantee after each step?"
 *
 * Every step explicitly exposes:
 *   MESSAGE            — what travelled on the wire
 *   WHAT CHANGED       — the causal delta this segment produced
 *   CLIENT / SERVER    — state + local knowledge (ISN anchors)
 *   CONNECTION STATE   — CLOSED / LISTEN / SYN-SENT / SYN-RECEIVED / ESTABLISHED
 *
 * The sequence-number fields are the committed ISN anchors (x and y), which is
 * why they do not drift when the third ACK consumes a sequence number: the
 * final packet's only effect is the server's transition to ESTABLISHED.
 *
 * Progressive enhancement: full stacked no-JS reading experience; stepper +
 * keyboard navigation (Left/Right/Home/End) once JS is available.
 * Full bilingual support (EN/RU).
 */
import SkeinFigure from "./SkeinFigure.astro";
import StateBadge from "./StateBadge.astro";
import MachineValue from "./MachineValue.astro";

interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}

const { lang = "en", span = "canvas" } = Astro.props;

const copy = ({
  en: {
    category: "PROTOCOL SYNCHRONIZATION",
    title: "Client & Server Local Knowledge Across the Handshake",
    label: "Interactive stepper exposing the message on the wire, the state change it causes, and the local knowledge of both endpoints at every stage of the TCP handshake.",
    thesis: "The two ends do not become ready at the same moment.",
    caption: "At step 2 the client has already confirmed its own counter and is ESTABLISHED, while the server is still SYN-RECEIVED: it has sent y but cannot yet know whether y arrived. Step 3 exists solely to close that gap.",
    client: "CLIENT",
    server: "SERVER",
    stepLabel: "STEP",
    ofLabel: "OF",
    initialStepLabel: "INITIAL · STEP 0",
    prevBtn: "Previous step",
    nextBtn: "Next step",
    messageLabel: "MESSAGE",
    stateLabel: "CONNECTION STATE",
    myIsn: "MY ISN",
    peerIsn: "PEER ISN",
    whatChangedLabel: "WHAT CHANGED",
    mutationMarker: "changed by this segment",
    legend: "Highlighted fields changed because this segment arrived.",
    steps: [
      {
        kicker: "INITIAL STATE",
        title: "Step 0: Quiescent endpoints before any transmission",
        packet: "None · no segment in flight",
        tone: "dim",
        clientState: "CLOSED",
        clientIsn: "—",
        clientPeer: "unknown",
        serverState: "LISTEN",
        serverIsn: "—",
        serverPeer: "unknown",
        mutations: {
          clientState: false,
          clientIsn: false,
          clientPeer: false,
          serverState: false,
          serverIsn: false,
          serverPeer: false,
        },
        changed: "Nothing yet — no synchronization exists between the endpoints.",
        explanation: "The client socket is CLOSED. The server application has bound a port and is parked in LISTEN. Neither side knows the other's counter, so no segment can be interpreted yet.",
        asymmetryNote: null,
      },
      {
        kicker: "SYN SENT",
        title: "Step 1: Client proposes its initial sequence number",
        packet: "SYN · seq=x (42,000,000)",
        tone: "accent",
        clientState: "SYN-SENT",
        clientIsn: "42,000,000",
        clientPeer: "unknown",
        serverState: "LISTEN",
        serverIsn: "—",
        serverPeer: "unknown",
        mutations: {
          clientState: true,
          clientIsn: true,
          clientPeer: false,
          serverState: false,
          serverIsn: false,
          serverPeer: false,
        },
        changed: "Client state CLOSED → SYN-SENT and the client commits its own counter to x.",
        explanation: "The client picks a pseudorandom Initial Sequence Number x and sends SYN. It is now waiting for an answer; the server has not reacted yet because the segment is still travelling.",
        asymmetryNote: null,
      },
      {
        kicker: "SYN-ACK · ASYMMETRY",
        title: "Step 2: Server answers; only the client becomes synchronized",
        packet: "SYN-ACK · seq=y (99,000,000) ack=x+1 (42,000,001)",
        tone: "warn",
        clientState: "ESTABLISHED",
        clientIsn: "42,000,000",
        clientPeer: "99,000,000",
        serverState: "SYN-RECEIVED",
        serverIsn: "99,000,000",
        serverPeer: "42,000,000",
        mutations: {
          clientState: true,
          clientIsn: false,
          clientPeer: true,
          serverState: true,
          serverIsn: true,
          serverPeer: true,
        },
        changed: "Server state LISTEN → SYN-RECEIVED and the server commits y and learns x; the client learns y, confirms x arrived, and moves to ESTABLISHED.",
        explanation: "The server records x, allocates a half-open entry, chooses its own ISN y, and replies with SYN-ACK. The client reads ack=x+1 as proof that its counter arrived, stores y, and may attach application data to its next segment.",
        asymmetryNote: "Asymmetry: the client is already ESTABLISHED, while the server is still in SYN-RECEIVED and does not yet know whether y reached the client.",
      },
      {
        kicker: "MUTUAL SYNCHRONIZATION",
        title: "Step 3: The ACK completes the server's knowledge",
        packet: "ACK · seq=x+1 (42,000,001) ack=y+1 (99,000,001)",
        tone: "ok",
        clientState: "ESTABLISHED",
        clientIsn: "42,000,000",
        clientPeer: "99,000,000",
        serverState: "ESTABLISHED",
        serverIsn: "99,000,000",
        serverPeer: "42,000,000",
        mutations: {
          clientState: false,
          clientIsn: false,
          clientPeer: false,
          serverState: true,
          serverIsn: false,
          serverPeer: false,
        },
        changed: "Server state SYN-RECEIVED → ESTABLISHED; the server finally knows the client received y.",
        explanation: "The client acknowledges y (the +1 marks the one sequence number the SYN consumed). That ACK is the server's proof that the client is synchronized, so the entry is promoted to ESTABLISHED. Both directions now carry acknowledged, monotonically numbered bytes.",
        asymmetryNote: "Both endpoints are synchronized: every byte from here is numbered and acknowledged.",
      },
    ],
  },
  ru: {
    category: "СИНХРОНИЗАЦИЯ ПРОТОКОЛА",
    title: "Локальное знание клиента и сервера на каждом шаге",
    label: "Интерактивная пошаговая схема, показывающая сегмент на проводе, вызванное им изменение состояния и локальное знание обоих узлов на каждом этапе рукопожатия TCP.",
    thesis: "Два узла становятся готовыми не в один момент.",
    caption: "На шаге 2 клиент уже подтвердил свой счётчик и находится в ESTABLISHED, а сервер ещё в SYN-RECEIVED: он отправил y, но пока не знает, дошёл ли y. Шаг 3 нужен только для того, чтобы закрыть этот разрыв.",
    client: "КЛИЕНТ",
    server: "СЕРВЕР",
    stepLabel: "ШАГ",
    ofLabel: "ИЗ",
    initialStepLabel: "ИСХОДНОЕ · ШАГ 0",
    prevBtn: "Назад",
    nextBtn: "Вперёд",
    messageLabel: "СООБЩЕНИЕ",
    stateLabel: "СОСТОЯНИЕ СОЕДИНЕНИЯ",
    myIsn: "МОЙ ISN",
    peerIsn: "ISN СОСЕДА",
    whatChangedLabel: "ЧТО ИЗМЕНИЛОСЬ",
    mutationMarker: "изменено этим сегментом",
    legend: "Подсвеченные поля изменились, потому что пришёл этот сегмент.",
    steps: [
      {
        kicker: "ИСХОДНОЕ СОСТОЯНИЕ",
        title: "Шаг 0: Узлы в покое до начала передачи",
        packet: "Нет · сегментов в сети нет",
        tone: "dim",
        clientState: "CLOSED",
        clientIsn: "—",
        clientPeer: "неизвестен",
        serverState: "LISTEN",
        serverIsn: "—",
        serverPeer: "неизвестен",
        mutations: {
          clientState: false,
          clientIsn: false,
          clientPeer: false,
          serverState: false,
          serverIsn: false,
          serverPeer: false,
        },
        changed: "Пока ничего — синхронизации между узлами не существует.",
        explanation: "Сокет клиента CLOSED. Серверное приложение заняло порт и находится в LISTEN. Ни одна сторона не знает счётчик партнёра, поэтому сегмент пока невозможно проинтерпретировать.",
        asymmetryNote: null,
      },
      {
        kicker: "ОТПРАВЛЕН SYN",
        title: "Шаг 1: Клиент заявляет начальный номер последовательности",
        packet: "SYN · seq=x (42 000 000)",
        tone: "accent",
        clientState: "SYN-SENT",
        clientIsn: "42 000 000",
        clientPeer: "неизвестен",
        serverState: "LISTEN",
        serverIsn: "—",
        serverPeer: "неизвестен",
        mutations: {
          clientState: true,
          clientIsn: true,
          clientPeer: false,
          serverState: false,
          serverIsn: false,
          serverPeer: false,
        },
        changed: "Состояние клиента CLOSED → SYN-SENT, собственный счётчик зафиксирован на x.",
        explanation: "Клиент выбирает псевдослучайный ISN x и отправляет SYN. Теперь он ждёт ответа; сервер ещё не прореагировал, потому что сегмент в пути.",
        asymmetryNote: null,
      },
      {
        kicker: "SYN-ACK · АСИММЕТРИЯ",
        title: "Шаг 2: Сервер отвечает; синхронизируется только клиент",
        packet: "SYN-ACK · seq=y (99 000 000) ack=x+1 (42 000 001)",
        tone: "warn",
        clientState: "ESTABLISHED",
        clientIsn: "42 000 000",
        clientPeer: "99 000 000",
        serverState: "SYN-RECEIVED",
        serverIsn: "99 000 000",
        serverPeer: "42 000 000",
        mutations: {
          clientState: true,
          clientIsn: false,
          clientPeer: true,
          serverState: true,
          serverIsn: true,
          serverPeer: true,
        },
        changed: "Состояние сервера LISTEN → SYN-RECEIVED: он фиксирует y и узнаёт x; клиент узнаёт y, подтверждает доставку x и переходит в ESTABLISHED.",
        explanation: "Сервер записывает x, создаёт полуоткрытую запись, выбирает собственный ISN y и отвечает SYN-ACK. Клиент читает ack=x+1 как доказательство доставки своего счётчика, сохраняет y и уже может прикрепить данные к следующему сегменту.",
        asymmetryNote: "Асимметрия: клиент уже в ESTABLISHED, а сервер ещё в SYN-RECEIVED и не знает, дошёл ли до клиента y.",
      },
      {
        kicker: "ВЗАИМНАЯ СИНХРОНИЗАЦИЯ",
        title: "Шаг 3: ACK завершает знание сервера",
        packet: "ACK · seq=x+1 (42 000 001) ack=y+1 (99 000 001)",
        tone: "ok",
        clientState: "ESTABLISHED",
        clientIsn: "42 000 000",
        clientPeer: "99 000 000",
        serverState: "ESTABLISHED",
        serverIsn: "99 000 000",
        serverPeer: "42 000 000",
        mutations: {
          clientState: false,
          clientIsn: false,
          clientPeer: false,
          serverState: true,
          serverIsn: false,
          serverPeer: false,
        },
        changed: "Состояние сервера SYN-RECEIVED → ESTABLISHED: сервер наконец знает, что клиент получил y.",
        explanation: "Клиент подтверждает y (единица после выбора ISN помечает номер, израсходованный на SYN). Этот ACK — доказательство для сервера, что клиент синхронизирован, поэтому запись переводится в ESTABLISHED. Оба направления теперь пронумерованы и подтверждаются.",
        asymmetryNote: "Оба узла синхронизированы: каждый байт далее нумеруется и подтверждается.",
      },
    ],
  },
} as const)[lang];

const stepName = (i: number) =>
  i === 0 ? copy.initialStepLabel : `${copy.stepLabel} ${i} ${copy.ofLabel} ${copy.steps.length - 1}`;
---

<SkeinFigure
  num="03"
  category={copy.category}
  title={copy.title}
  label={copy.label}
  thesis={copy.thesis}
  caption={copy.caption}
  span={span}
  hue="var(--d-network)"
>
  <div
    class="sk-ihs-root"
    data-ihs-root
    tabindex="0"
    role="group"
    aria-label={`${copy.title}. ${copy.legend}`}
  >
    <div class="sk-ihs-panels">
      {copy.steps.map((st, i) => (
        <article class="sk-ihs-panel" data-ihs-panel={i} aria-label={`${stepName(i)}: ${st.kicker}`}>
          <div class="sk-ihs-head">
            <div class="sk-ihs-kicker-row">
              <span class="sk-ihs-step-k">{stepName(i)}</span>
              <span class="sk-ihs-kicker-tag">{st.kicker}</span>
            </div>
            <h4 class="sk-ihs-title">{st.title}</h4>
          </div>

          <div class="sk-ihs-message">
            <span class="sk-ihs-message-k">{copy.messageLabel}</span>
            <MachineValue size="sm" tone={st.tone} val={st.packet} />
          </div>

          <div class="sk-ihs-svg-wrap">
            <svg viewBox="0 0 540 86" class="sk-ihs-svg" aria-hidden="true">
              <defs>
                <marker id={`sk-ihs-arr-a-${i}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                  <path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--d, var(--accent))" />
                </marker>
                <marker id={`sk-ihs-arr-w-${i}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                  <path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--warn)" />
                </marker>
                <marker id={`sk-ihs-arr-o-${i}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                  <path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--ok)" />
                </marker>
              </defs>

              <line x1="80" y1="8" x2="80" y2="78" stroke="var(--hairline-strong)" stroke-width="1.2" stroke-dasharray="3 3" />
              <line x1="460" y1="8" x2="460" y2="78" stroke="var(--hairline-strong)" stroke-width="1.2" stroke-dasharray="3 3" />

              <circle cx="80" cy="18" r="12" fill="var(--card)" stroke="var(--hairline-2)" />
              <text x="80" y="22" text-anchor="middle" font-family="var(--font-mono)" font-size="10" font-weight="700" fill="var(--ink)">C</text>

              <circle cx="460" cy="18" r="12" fill="var(--card)" stroke="var(--hairline-2)" />
              <text x="460" y="22" text-anchor="middle" font-family="var(--font-mono)" font-size="10" font-weight="700" fill="var(--ink)">S</text>

              {i === 0 && (
                <text x="270" y="50" text-anchor="middle" class="sk-ihs-idle">
                  {copy.steps[0].kicker}
                </text>
              )}

              {i >= 1 && (
                <g>
                  <line x1="80" y1="46" x2="452" y2="64" stroke="var(--d, var(--accent))" stroke-width="2" marker-end={`url(#sk-ihs-arr-a-${i})`} />
                  <text x="270" y="50" text-anchor="middle" class="sk-ihs-wire sk-wire-accent">
                    ① SYN · seq=x
                  </text>
                </g>
              )}

              {i >= 2 && (
                <g>
                  <line x1="460" y1="32" x2="88" y2="50" stroke="var(--warn)" stroke-width="2" marker-end={`url(#sk-ihs-arr-w-${i})`} />
                  <text x="330" y="30" text-anchor="middle" class="sk-ihs-wire sk-wire-warn">
                    ② SYN-ACK · ack=x+1, seq=y
                  </text>
                </g>
              )}

              {i >= 3 && (
                <g>
                  <line x1="80" y1="72" x2="452" y2="78" stroke="var(--ok)" stroke-width="2" marker-end={`url(#sk-ihs-arr-o-${i})`} />
                  <text x="270" y="84" text-anchor="middle" class="sk-ihs-wire sk-wire-ok">
                    ③ ACK · ack=y+1
                  </text>
                </g>
              )}
            </svg>
          </div>

          <div class="sk-ihs-grid">
            {[
              {
                role: copy.client,
                state: st.clientState,
                isn: st.clientIsn,
                peer: st.clientPeer,
                m: st.mutations,
                isnTone: st.clientIsn === "—" ? "dim" : "accent",
              },
              {
                role: copy.server,
                state: st.serverState,
                isn: st.serverIsn,
                peer: st.serverPeer,
                m: st.mutations,
                isnTone: st.serverIsn === "—" ? "dim" : "warn",
              },
            ].map((side, s) => (
              <div class="sk-side-col">
                <span class="sk-side-role">{side.role}</span>

                <div class="sk-prop-row sk-prop-state" data-mutated={s === 0 ? (side.m.clientState ? "true" : undefined) : (side.m.serverState ? "true" : undefined)}>
                  <span class="sk-prop-k">{copy.stateLabel}</span>
                  <span class="sk-side-state-wrap">
                    <StateBadge state={side.state} size="sm" />
                  </span>
                  {(s === 0 ? side.m.clientState : side.m.serverState) && (
                    <span class="sk-sr-only">({copy.mutationMarker})</span>
                  )}
                </div>

                <div class="sk-prop-row" data-mutated={s === 0 ? (side.m.clientIsn ? "true" : undefined) : (side.m.serverIsn ? "true" : undefined)}>
                  <span class="sk-prop-k">{copy.myIsn}</span>
                  <MachineValue size="sm" val={side.isn} tone={side.isnTone as "dim" | "accent" | "warn"} />
                  {(s === 0 ? side.m.clientIsn : side.m.serverIsn) && (
                    <span class="sk-sr-only">({copy.mutationMarker})</span>
                  )}
                </div>

                <div class="sk-prop-row" data-mutated={s === 0 ? (side.m.clientPeer ? "true" : undefined) : (side.m.serverPeer ? "true" : undefined)}>
                  <span class="sk-prop-k">{copy.peerIsn}</span>
                  <MachineValue
                    size="sm"
                    val={side.peer}
                    tone={side.peer === "unknown" || side.peer === "неизвестен" ? "dim" : "ok"}
                  />
                  {(s === 0 ? side.m.clientPeer : side.m.serverPeer) && (
                    <span class="sk-sr-only">({copy.mutationMarker})</span>
                  )}
                </div>
              </div>
            ))}
          </div>

          {st.asymmetryNote && (
            <p class={`sk-ihs-asym ${i === 2 ? "sk-asym-warn" : "sk-asym-ok"}`}>
              <span class="sk-asym-ind">{i === 2 ? "⚡" : "✓"}</span>
              <span class="sk-asym-text">{st.asymmetryNote}</span>
            </p>
          )}

          <div class="sk-ihs-changed">
            <span class="sk-changed-k">{copy.whatChangedLabel}</span>
            <span class="sk-changed-v">{st.changed}</span>
          </div>

          <div class="sk-ihs-note">
            <p>{st.explanation}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="sk-ihs-controls" data-ihs-controls hidden>
      <button type="button" class="sk-ihs-btn" data-ihs-prev>
        ← {copy.prevBtn}
      </button>
      <div class="sk-ihs-dots" role="group" aria-label={`${copy.stepLabel} 0–${copy.steps.length - 1}`}>
        {copy.steps.map((st, i) => (
          <button
            type="button"
            class="sk-ihs-dot"
            data-ihs-dot={i}
            aria-label={`${stepName(i)}: ${st.kicker}`}
          />
        ))}
      </div>
      <button type="button" class="sk-ihs-btn" data-ihs-next>
        {copy.nextBtn} →
      </button>
    </div>

    <p class="sk-ihs-legend">{copy.legend}</p>
  </div>
</SkeinFigure>

<style>
  .sk-ihs-root {
    display: flex;
    flex-direction: column;
    gap: 16px;
    outline: none;
  }

  .sk-ihs-root:focus-visible {
    outline: 2px solid var(--d, var(--accent));
    outline-offset: 4px;
    border-radius: var(--r-sm);
  }

  .sk-ihs-panels {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .sk-ihs-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sk-ihs-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 10px;
    border-bottom: 0.5px solid var(--hairline);
  }

  .sk-ihs-kicker-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
  }

  .sk-ihs-step-k {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }


  /* Quiet step-phase tag: machine values stay the focus, not the label. */
  .sk-ihs-kicker-tag {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .sk-ihs-title {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.35;
    color: var(--ink);
  }

  .sk-ihs-message {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }

  .sk-ihs-message-k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .sk-ihs-svg-wrap {
    width: 100%;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 4px 0;
  }

  .sk-ihs-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .sk-ihs-idle {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    fill: color-mix(in srgb, var(--muted) 85%, transparent);
  }

  .sk-ihs-wire {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
  }

  .sk-wire-accent {
    fill: var(--d, var(--accent));
  }

  .sk-wire-warn {
    fill: color-mix(in srgb, var(--warn) 80%, var(--ink));
  }

  .sk-wire-ok {
    fill: var(--ok);
  }

  .sk-ihs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 3vw, 32px);
  }

  @media (max-width: 640px) {
    .sk-ihs-grid {
      grid-template-columns: 1fr;
    }
  }

  .sk-side-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 12px;
    border-left: 2px solid var(--hairline-strong);
  }

  .sk-side-role {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-2);
  }

  .sk-prop-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
    font-size: 12px;
    padding: 3px 5px;
    border-radius: var(--r-sm);
    transition: background var(--dur-2) var(--ease);
  }

  .sk-prop-state {
    align-items: center;
  }

  .sk-prop-k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .sk-side-state-wrap {
    display: inline-flex;
  }

  /* Mutation cue: wash + outline + dotted rule (never color alone) */
  [data-mutated="true"] {
    background: color-mix(in srgb, var(--d, var(--accent)) 8%, transparent);
    outline: 1px solid color-mix(in srgb, var(--d, var(--accent)) 28%, transparent);
    border-bottom: 1px dotted color-mix(in srgb, var(--d, var(--accent)) 55%, transparent);
  }

  .sk-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sk-ihs-asym {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    font-size: 12.5px;
  }

  .sk-asym-warn {
    background: color-mix(in srgb, var(--warn) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--warn) 32%, transparent);
  }

  .sk-asym-ok {
    background: color-mix(in srgb, var(--ok) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--ok) 28%, transparent);
  }

  .sk-asym-ind {
    flex-shrink: 0;
    font-size: 13px;
    font-weight: bold;
  }

  .sk-asym-text {
    font-family: var(--font-body);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .sk-ihs-changed {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 8px;
    border-top: 0.5px solid var(--hairline);
  }

  .sk-changed-k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--d, var(--accent));
  }

  .sk-changed-v {
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink);
  }

  .sk-ihs-note {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .sk-ihs-note p {
    margin: 0;
  }

  .sk-ihs-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 4px;
  }

  .sk-ihs-btn {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    background: var(--card);
    border: 0.5px solid var(--hairline-2);
    color: var(--ink);
    padding: 6px 14px;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .sk-ihs-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .sk-ihs-btn:not(:disabled):hover {
    border-color: var(--hairline-strong);
    background: color-mix(in srgb, var(--card) 80%, var(--paper));
  }

  .sk-ihs-btn:focus-visible {
    outline: 2px solid var(--d, var(--accent));
    outline-offset: 2px;
  }

  .sk-ihs-dots {
    display: flex;
    gap: 10px;
  }

  .sk-ihs-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--hairline-strong);
    cursor: pointer;
    padding: 0;
    transition: background var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }

  .sk-ihs-dot:focus-visible {
    outline: 2px solid var(--d, var(--accent));
    outline-offset: 2px;
  }

  .sk-ihs-dot.is-active {
    background: var(--d, var(--accent));
    border-color: var(--d, var(--accent));
  }

  .sk-ihs-legend {
    margin: 0;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .sk-prop-row,
    .sk-ihs-btn,
    .sk-ihs-dot {
      transition: none;
    }
    .sk-ihs-dot.is-active {
      transform: none;
    }
  }
</style>

<script>
  function initIhs(root: HTMLElement) {
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-ihs-panel]"));
    const controls = root.querySelector<HTMLElement>("[data-ihs-controls]");
    const prev = root.querySelector<HTMLButtonElement>("[data-ihs-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-ihs-next]");
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-ihs-dot]"));
    if (panels.length === 0 || !controls || !prev || !next) return;
    const prevButton = prev;
    const nextButton = next;

    let current = 0;

    function show(n: number) {
      current = Math.max(0, Math.min(panels.length - 1, n));
      panels.forEach((p, idx) => {
        p.hidden = idx !== current;
      });
      dots.forEach((d, idx) => {
        const on = idx === current;
        d.classList.toggle("is-active", on);
        if (on) d.setAttribute("aria-current", "true");
        else d.removeAttribute("aria-current");
      });
      prevButton.disabled = current === 0;
      nextButton.disabled = current === panels.length - 1;
    }

    root.setAttribute("data-ihs-active", "true");
    controls.hidden = false;

    prevButton.addEventListener("click", () => show(current - 1));
    nextButton.addEventListener("click", () => show(current + 1));
    dots.forEach((d, idx) => d.addEventListener("click", () => show(idx)));

    root.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        show(current + 1);
      } else if (event.key === "Home") {
        event.preventDefault();
        show(0);
      } else if (event.key === "End") {
        event.preventDefault();
        show(panels.length - 1);
      }
    });

    show(0);
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-ihs-root]").forEach(initIhs);
  }

  if (document.readyState !== "loading") setup();
  else document.addEventListener("DOMContentLoaded", setup);
</script>
