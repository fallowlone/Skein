---
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "HOST ↔ ENGINE · ONE TURN",
    title: "The host schedules the checkpoint after the callback",
    label:
      "Conceptual browser turn: the host selects a timer task; V8 runs its callback; control returns to the host; the host performs a microtask checkpoint before the next task. Rendering may follow when there is an opportunity.",
    thesis: "The browser performs a microtask checkpoint after the task, before another task or a rendering opportunity.",
    caption:
      "Conceptual HTML event-loop order. The host decides when to perform a checkpoint; V8 executes the queued JavaScript jobs. Rendering is optional on any particular turn.",
    scope: "BROWSER HOST + V8 MODEL",
    host: "HOST · BROWSER LOOP",
    engine: "ENGINE · V8",
    taskQueue: "TASK QUEUE",
    callStack: "JS CALL STACK",
    microtasks: "MICROTASK QUEUE",
    waiting: "host waits for callback",
    checkpoint: "microtask checkpoint",
    callbackDone: "callback returned",
    mayRender: "render if needed",
    nextTask: "next task blocked",
    nextTaskReady: "next task may run",
    phases: [
      { short: "Ready", title: "Before the turn", body: "The host has a runnable timer task. The engine is idle and the microtask queue is empty." },
      { short: "Call", title: "Host selects one task", body: "The host removes the timer callback from its task queue and calls into V8." },
      { short: "Run", title: "JavaScript runs to completion", body: "The callback owns the JS stack until it returns. It may enqueue Promise reactions, but they cannot interrupt the running callback." },
      { short: "Drain", title: "Host performs a checkpoint", body: "After the callback returns, the browser performs a microtask checkpoint. V8 runs queued jobs until the queue is empty, including jobs they enqueue." },
      { short: "Continue", title: "Host continues its loop", body: "The browser may update rendering when there is an opportunity, or proceed toward another task. Rendering is not guaranteed on every turn." },
    ],
  },
  ru: {
    category: "ХОСТ ↔ ДВИЖОК · ОДИН ОБОРОТ",
    title: "Хост назначает чекпоинт после колбэка",
    label:
      "Упрощённый оборот браузерного цикла: хост выбирает задачу таймера; V8 исполняет колбэк; управление возвращается хосту; хост выполняет чекпоинт микрозадач до следующей задачи. Рендер возможен при подходящем случае.",
    thesis: "Браузер выполняет чекпоинт после задачи — до следующей задачи или возможности рендера.",
    caption:
      "Упрощённый порядок HTML-цикла событий. Хост решает, когда выполнить чекпоинт; V8 исполняет поставленные в очередь JS jobs. Рендер не обязателен после каждого оборота.",
    scope: "МОДЕЛЬ БРАУЗЕРНОГО ХОСТА + V8",
    host: "ХОСТ · ЦИКЛ БРАУЗЕРА",
    engine: "ДВИЖОК · V8",
    taskQueue: "ОЧЕРЕДЬ ЗАДАЧ",
    callStack: "СТЕК ВЫЗОВОВ JS",
    microtasks: "ОЧЕРЕДЬ МИКРОЗАДАЧ",
    waiting: "хост ждёт колбэк",
    checkpoint: "чекпоинт микрозадач",
    callbackDone: "колбэк завершился",
    mayRender: "рендер при необходимости",
    nextTask: "следующая задача заблокирована",
    nextTaskReady: "можно взять следующую задачу",
    phases: [
      { short: "Готово", title: "До оборота", body: "У хоста есть готовая задача таймера. Движок простаивает, очередь микрозадач пуста." },
      { short: "Вызов", title: "Хост выбирает одну задачу", body: "Хост снимает callback таймера из своей очереди задач и вызывает V8." },
      { short: "JS", title: "JavaScript исполняется до конца", body: "Callback владеет стеком JS до возврата. Он может поставить реакции Promise в очередь, но они не могут прервать текущий callback." },
      { short: "Чекпоинт", title: "Хост выполняет чекпоинт", body: "После возврата колбэка браузер выполняет чекпоинт. V8 запускает jobs до опустошения очереди, включая новые jobs из этих jobs." },
      { short: "Далее", title: "Хост продолжает цикл", body: "Браузер может обновить изображение при возможности рендера или перейти к другой задаче. Рендер не гарантирован после каждого оборота." },
    ],
  },
} as const;

const t = copy[lang];
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="canvas"
  variant="canvas"
>
  <div class="turn" data-loop-turn data-step="4">
    <div class="turn-scope">
      <TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel>
    </div>

    <div class="turn-controls" data-turn-controls hidden>
      <span class="turn-controls-label">{lang === "ru" ? "Шаг" : "Step"}</span>
      {t.phases.map((phase, index) => (
        <button
          type="button"
          data-turn-step={index}
          data-announcement={`${phase.title}. ${phase.body}`}
          aria-pressed={index === 4 ? "true" : "false"}
        >
          <span>{String(index).padStart(2, "0")}</span>
          {phase.short}
        </button>
      ))}
    </div>

    <p class="turn-intro">{t.phases[0].body}</p>

    <div class="turn-actors" aria-hidden="true">
      <TechnicalLabel tone="accent" size="sm">{t.host}</TechnicalLabel>
      <div></div>
      <TechnicalLabel tone="accent" size="sm">{t.engine}</TechnicalLabel>
    </div>

    <div class="turn-sequence">
      <div class="turn-row" data-phase="1">
        <div class="turn-cell host-cell">
          <TechnicalLabel tone="muted" size="xs">{t.taskQueue}</TechnicalLabel>
          <div class="queue-line">
            <MachineValue value="timer callback" tone="accent" size="sm" />
            <MachineValue value="next task" tone="dim" size="sm" />
          </div>
        </div>
        <div class="turn-transfer">
          <span aria-hidden="true">→</span>
          <code>call</code>
        </div>
        <div class="turn-cell engine-cell">
          <TechnicalLabel tone="muted" size="xs">{t.callStack}</TechnicalLabel>
          <MachineValue value="timer()" tone="accent" size="sm" />
        </div>
      </div>

      <div class="turn-row" data-phase="2">
        <div class="turn-cell host-cell muted-cell">
          <TechnicalLabel tone="muted" size="xs">{t.waiting}</TechnicalLabel>
          <MachineValue value={t.nextTask} tone="dim" size="sm" />
        </div>
        <div class="turn-transfer quiet" aria-hidden="true"><span>·</span></div>
        <div class="turn-cell engine-cell">
          <TechnicalLabel tone="accent" size="xs">run-to-completion</TechnicalLabel>
          <div class="engine-state">
            <MachineValue name="stack" value="timer()" tone="accent" size="sm" />
            <MachineValue name="enqueue" value="promise.then" tone="warn" size="sm" />
          </div>
        </div>
      </div>

      <div class="turn-row" data-phase="3">
        <div class="turn-cell host-cell">
          <TechnicalLabel tone="warn" size="xs">{t.checkpoint}</TechnicalLabel>
          <MachineValue value={t.nextTask} tone="dim" size="sm" />
        </div>
        <div class="turn-transfer"><code>return</code><span aria-hidden="true">←</span></div>
        <div class="turn-cell engine-cell checkpoint-cell">
          <TechnicalLabel tone="muted" size="xs">{t.callbackDone}</TechnicalLabel>
          <div class="engine-state">
            <MachineValue name="stack" value="empty" tone="dim" size="sm" />
            <MachineValue name="microtask" value="promise.then()" tone="warn" size="sm" />
          </div>
        </div>
      </div>

      <div class="turn-row" data-phase="4">
        <div class="turn-cell host-cell return-cell">
          <TechnicalLabel tone="ok" size="xs">{t.mayRender}</TechnicalLabel>
          <MachineValue value={t.nextTaskReady} tone="ok" size="sm" />
        </div>
        <div class="turn-transfer quiet" aria-hidden="true"><span>·</span></div>
        <div class="turn-cell engine-cell muted-cell">
          <TechnicalLabel tone="muted" size="xs">{t.callStack}</TechnicalLabel>
          <MachineValue value="idle" tone="dim" size="sm" />
        </div>
      </div>
    </div>

    <ol class="turn-notes">
      {t.phases.slice(1).map((phase, index) => (
        <li data-note-phase={index + 1}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div><strong>{phase.title}</strong><p>{phase.body}</p></div>
        </li>
      ))}
    </ol>

    <p class="sr-only" aria-live="polite" data-turn-live>{`${t.phases[4].title}. ${t.phases[4].body}`}</p>
  </div>
</SkeinFigure>

<script>
  document.querySelectorAll<HTMLElement>("[data-loop-turn]").forEach((root) => {
    const controls = root.querySelector<HTMLElement>("[data-turn-controls]");
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-turn-step]"));
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-phase]"));
    const notes = Array.from(root.querySelectorAll<HTMLElement>("[data-note-phase]"));
    const live = root.querySelector<HTMLElement>("[data-turn-live]");
    if (!controls || buttons.length === 0) return;

    controls.hidden = false;

    const setStep = (nextStep: number) => {
      const step = Math.max(0, Math.min(4, nextStep));
      root.dataset.step = String(step);

      rows.forEach((row) => {
        const phase = Number(row.dataset.phase);
        row.dataset.status = phase < step ? "done" : phase === step ? "current" : "future";
      });
      notes.forEach((note) => {
        const phase = Number(note.dataset.notePhase);
        note.dataset.status = phase < step ? "done" : phase === step ? "current" : "future";
      });
      buttons.forEach((button) => {
        const active = Number(button.dataset.turnStep) === step;
        button.setAttribute("aria-pressed", active ? "true" : "false");
      });

      const activeButton = buttons.find((button) => Number(button.dataset.turnStep) === step);
      if (live && activeButton?.dataset.announcement) live.textContent = activeButton.dataset.announcement;
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => setStep(Number(button.dataset.turnStep)));
    });

    setStep(1);
  });
</script>

<style>
  .turn {
    min-width: 860px;
  }

  .turn-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 10px;
  }

  .turn-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 0.5px solid var(--hairline-2);
  }

  .turn-controls[hidden] { display: none; }

  .turn-intro { display: none; }
  .turn[data-step="0"] .turn-intro { display: block; }

  .turn-controls-label {
    margin-right: 4px;
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--muted);
  }

  .turn-controls button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 6px 9px;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 11.5px;
    cursor: pointer;
  }

  .turn-controls button > span {
    font-family: var(--font-mono);
    font-size: 9.5px;
  }

  .turn-controls button[aria-pressed="true"] {
    border-bottom-color: var(--d, var(--accent));
    color: var(--ink);
  }

  .turn-controls button:focus-visible {
    outline: 2px solid var(--d, var(--accent));
    outline-offset: 2px;
  }

  .turn-actors,
  .turn-row {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) 92px minmax(320px, 1.15fr);
    gap: 14px;
  }

  .turn-actors {
    align-items: end;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .turn-actors > :global(.sk-tech-label:last-child) { justify-self: start; }

  .turn-sequence {
    display: grid;
  }

  .turn-row {
    align-items: stretch;
    padding: 13px 0;
    border-bottom: 0.5px solid var(--hairline);
    transition: opacity 160ms ease, background 160ms ease;
  }

  .turn-cell {
    display: grid;
    align-content: center;
    gap: 8px;
    min-height: 58px;
    padding: 8px 12px;
    border-left: 1px solid var(--hairline-strong);
  }

  .engine-cell { border-left-color: color-mix(in srgb, var(--d, var(--accent)) 46%, var(--hairline)); }
  .checkpoint-cell { border-left-color: color-mix(in srgb, var(--warn) 62%, var(--hairline)); }
  .return-cell { border-left-color: color-mix(in srgb, var(--ok) 62%, var(--hairline)); }

  .queue-line,
  .engine-state {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .turn-transfer {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2px;
    color: var(--d, var(--accent));
  }

  .turn-transfer span {
    font-family: var(--font-mono);
    font-size: 22px;
    line-height: 1;
  }

  .turn-transfer code {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--muted);
  }

  .turn-transfer.quiet { color: var(--hairline-strong); }

  .muted-cell { color: var(--muted); }

  .turn-notes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    border-top: 0.5px solid var(--hairline-2);
  }

  .turn-notes li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 9px;
    padding: 14px 14px 0 0;
  }

  .turn-notes li + li { padding-left: 14px; border-left: 0.5px solid var(--hairline); }

  .turn-notes li > span {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--d, var(--accent));
  }

  .turn-notes strong {
    display: block;
    font-family: var(--font-body);
    font-size: 11.5px;
    line-height: 1.35;
    color: var(--ink);
  }

  .turn-notes p {
    margin: 5px 0 0 !important;
    font-family: var(--font-body) !important;
    font-size: 10.5px !important;
    line-height: 1.45 !important;
    color: var(--muted) !important;
  }

  .turn[data-step] .turn-row[data-status="future"],
  .turn[data-step] .turn-notes li[data-status="future"] { display: none; }

  .turn[data-step] .turn-row[data-status="current"] {
    background: color-mix(in srgb, var(--d, var(--accent)) 5%, transparent);
  }

  .turn[data-step] .turn-notes li[data-status="current"] strong { color: var(--d, var(--accent)); }
  .turn[data-step] .turn-row[data-status="done"] { opacity: 0.68; }

  @media (prefers-reduced-motion: reduce) {
    .turn-row { transition: none; }
  }

  @media (max-width: 960px) {
    .turn { min-width: 820px; }
    .turn-actors,
    .turn-row { grid-template-columns: minmax(240px, 1fr) 74px minmax(300px, 1.1fr); }
  }

  @media (max-width: 640px) {
    .turn { min-width: 0; }
    .turn-actors { display: none; }
    .turn-row { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .turn-transfer { min-height: 24px; }
    .turn-notes { grid-template-columns: minmax(0, 1fr); }
    .turn-notes li + li { padding-left: 0; border-left: 0; }
    .turn :global(.sk-mv) { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
  }
</style>
