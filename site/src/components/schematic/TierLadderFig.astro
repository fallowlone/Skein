---
/**
 * TierLadderFig — Tier-B learning figure.
 *
 * The tiering ladder every major engine converged on: interpreter at
 * the bottom (cheap, general), progressively optimising JIT tiers
 * above (expensive, specialised), promotion earned by invocation
 * heat. Hermes is marked as the deliberate opt-out: ahead-of-time
 * bytecode instead of the ladder.
 *
 * Server-rendered; the is:inline script walks run-count upward. Zero
 * hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "TIERING LADDER",
    title: "More invocations earn a higher tier — the ladder is the same in three engines",
    label: "The four V8 tiers as a ladder: Ignition interprets, Sparkplug baselines, Maglev optimises mid-tier, TurboFan fully optimises. Heat climbs the rungs; cold never does.",
    thesis: "The names change between engines — the mechanism ports.",
    caption: "V8: Ignition → Sparkplug → Maglev → TurboFan. JavaScriptCore: LLInt → Baseline → DFG → FTL. SpiderMonkey: Interpreter → Baseline → WarpMonkey. Hermes opts out entirely with ahead-of-time bytecode.",
    scope: "CROSS-ENGINE MODEL",
    rungs: "TIERS · CHEAPEST AT THE BOTTOM",
    heat: "INVOCATION HEAT",
    ladder: [
      { tier: "TurboFan", kind: "optimising JIT", note: "full optimisation · hottest code only" },
      { tier: "Maglev", kind: "mid-tier JIT", note: "moderate optimisation · warms fast" },
      { tier: "Sparkplug", kind: "baseline JIT", note: "cheap compile · no specialisation" },
      { tier: "Ignition", kind: "interpreter", note: "every function starts here" },
    ],
    hermes: "Hermes (React Native) opts out: compiles to bytecode ahead of time and ships it — faster start, less memory on mobile, lower peak throughput.",
    names: "V8 Map = SpiderMonkey Shape = JavaScriptCore Structure · deopt is bailout elsewhere",
  },
  ru: {
    category: "ЛЕСТНИЦА ТИРОВ",
    title: "Больше вызовов зарабатывает более высокий tier — лестница одинакова в трёх движках",
    label: "Четыре tier'а V8 как лестница: Ignition интерпретирует, Sparkplug даёт baseline, Maglev оптимизирует средний tier, TurboFan оптимизирует полностью. Жар поднимает по ступеням; холод — никогда.",
    thesis: "Имена меняются между движками — механизм портируется.",
    caption: "V8: Ignition → Sparkplug → Maglev → TurboFan. JavaScriptCore: LLInt → Baseline → DFG → FTL. SpiderMonkey: Interpreter → Baseline → WarpMonkey. Hermes отказывается от лестницы совсем — bytecode ahead-of-time.",
    scope: "КРОСС-ДВИЖКОВАЯ МОДЕЛЬ",
    rungs: "ТИРЫ · САМЫЙ ДЕШЁВЫЙ ВНИЗУ",
    heat: "ЖАР ВЫЗОВОВ",
    ladder: [
      { tier: "TurboFan", kind: "оптимизирующий JIT", note: "полная оптимизация · только самый горячий код" },
      { tier: "Maglev", kind: "средний JIT", note: "умеренная оптимизация · быстро прогревается" },
      { tier: "Sparkplug", kind: "базовый JIT", note: "дешёвая компиляция · без специализации" },
      { tier: "Ignition", kind: "интерпретатор", note: "здесь начинает каждая функция" },
    ],
    hermes: "Hermes (React Native) отказывается: компилирует в bytecode ahead-of-time и шиппит его — быстрее старт, меньше памяти на mobile, ниже пиковая пропускная способность.",
    names: "V8 Map = SpiderMonkey Shape = JavaScriptCore Structure · deopt в других — bailout",
  },
} as const;

const t = copy[lang];
const rungs = t.ladder;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="tl" data-tl>
    <div class="tl-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="tl-head">
      <TechnicalLabel tone="muted" size="xs">{t.rungs}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.heat}</TechnicalLabel>
    </div>

    <ol class="tl-ladder">
      {rungs.map((r, i) => (
        <li class="tl-rung" data-tl-rung={i}>
          <div class="tl-rung-main">
            <MachineValue value={r.tier} tone={i === 0 ? "accent" : undefined} />
            <span class="tl-rung-kind">{r.kind}</span>
          </div>
          <p class="tl-rung-note">{r.note}</p>
        </li>
      ))}
    </ol>

    <p class="tl-hermes">
      <TechnicalLabel tone="warn" size="xs">OPT-OUT</TechnicalLabel>
      {t.hermes}
    </p>
    <p class="tl-names">
      <TechnicalLabel tone="muted" size="xs">PORTING</TechnicalLabel>
      {t.names}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: climb the ladder with invocation heat.
  // All rungs are server-rendered — no-JS readers see the whole ladder.
  (() => {
    const roots = document.querySelectorAll("[data-tl]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const rungs = root.querySelectorAll("[data-tl-rung]");
      if (!rungs.length) continue;
      if (reduceMotion) {
        rungs.forEach((el) => el.classList.add("tl-rung-live"));
        continue;
      }
      // Rungs are listed top (hot) to bottom (cold); heat climbs 0..3
      // rungs from the cold end, then resets.
      let n = 0;
      const show = (k) => {
        const cold = rungs.length - 1;
        rungs.forEach((el, j) => {
          const depth = cold - j; // 0 = coldest rung
          el.classList.toggle("tl-rung-live", depth === k);
          el.classList.toggle("tl-rung-done", depth < k);
        });
      };
      show(0);
      setInterval(() => {
        n = (n + 1) % (rungs.length + 2);
        show(n >= rungs.length ? 0 : n);
      }, 2200);
    }
  })();
</script>

<style>
  .tl {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .tl-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .tl-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tl-ladder {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tl-rung {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 10px 12px;
    border-left: 2px solid var(--hairline-2);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .tl-rung + .tl-rung { border-top: 0.5px solid var(--hairline-2); }

  .tl-rung-main {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .tl-rung-kind {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .tl-rung-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    text-align: right;
    overflow-wrap: anywhere;
  }

  .tl-rung-live { border-left-color: var(--accent); background: var(--accent-wash, var(--card)); }
  .tl-rung-done { border-left-color: var(--hairline-strong); }

  .tl-hermes,
  .tl-names {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .tl-rung-note { text-align: left; }
    .tl-rung { padding: 10px 8px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tl-rung {
      animation: tl-rung-in var(--dur-2) var(--ease) both;
    }
    .tl-rung:nth-child(2) { animation-delay: 120ms; }
    .tl-rung:nth-child(3) { animation-delay: 240ms; }
    .tl-rung:nth-child(4) { animation-delay: 360ms; }
    @keyframes tl-rung-in {
      from { opacity: 0; transform: translateX(-6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
