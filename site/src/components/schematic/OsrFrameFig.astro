---
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "OSR · LIVE FRAME SWAP",
    title: "The same loop crosses tiers without restarting",
    label:
      "A long-running loop is executing in Ignition when its back-edge budget trips. V8 compiles an OSR entry at the loop header, transfers live loop variables into an optimized frame, and continues the same iteration sequence in machine code.",
    thesis: "OSR changes the frame under a running loop while preserving its live state.",
    caption:
      "Normal tier-up would help only the next function call. OSR instead creates a second legal entry point at the loop header. The values i, acc, and rows cross into the optimized frame, so completed iterations stay completed and the remaining iterations run faster.",
    before: "IGNITION · LOOP IN FLIGHT",
    trigger: "BACK-EDGE BUDGET = 0",
    compile: "COMPILE OSR ENTRY",
    after: "OPTIMIZED FRAME · SAME LOOP",
    header: "entry @ loop header",
    continue: "continue, do not restart",
  },
  ru: {
    category: "OSR · ПОДМЕНА ЖИВОГО ФРЕЙМА",
    title: "Тот же цикл меняет ярус без перезапуска",
    label:
      "Длинный цикл исполняется в Ignition, когда заканчивается бюджет обратных дуг. V8 компилирует OSR-вход в заголовке цикла, переносит живые переменные в оптимизированный фрейм и продолжает ту же последовательность итераций в машинном коде.",
    thesis: "OSR меняет фрейм под работающим циклом, сохраняя его живое состояние.",
    caption:
      "Обычное повышение яруса помогло бы только следующему вызову функции. OSR создаёт дополнительную допустимую точку входа в заголовке цикла. Значения i, acc и rows переходят в оптимизированный фрейм, поэтому выполненные итерации не повторяются, а оставшиеся ускоряются.",
    before: "IGNITION · ЦИКЛ В РАБОТЕ",
    trigger: "БЮДЖЕТ ОБРАТНЫХ ДУГ = 0",
    compile: "КОМПИЛЯЦИЯ OSR-ВХОДА",
    after: "ОПТИМИЗИРОВАННЫЙ ФРЕЙМ · ТОТ ЖЕ ЦИКЛ",
    header: "вход @ заголовок цикла",
    continue: "продолжить, не перезапускать",
  },
} as const;

const t = copy[lang];
---

<SkeinFigure
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
  variant="canvas"
>
  <div class="osr-layout">
    <section class="frame before">
      <TechnicalLabel tone="muted" size="xs">{t.before}</TechnicalLabel>
      <MachineValue name="i" value="500000" />
      <MachineValue name="acc" value="913742" />
      <MachineValue name="rows" value="0x7f…" />
      <div class="loop-code"><code>for (; i &lt; rows.length; i++)</code></div>
    </section>

    <div class="swap">
      <TechnicalLabel tone="warn" size="xs">{t.trigger}</TechnicalLabel>
      <span class="arrow" aria-hidden="true">→</span>
      <div class="osr-entry">
        <TechnicalLabel tone="accent" size="xs">{t.compile}</TechnicalLabel>
        <MachineValue value={t.header} tone="accent" size="sm" />
        <code>i · acc · rows</code>
      </div>
      <span class="arrow" aria-hidden="true">→</span>
    </div>

    <section class="frame after">
      <TechnicalLabel tone="ok" size="xs">{t.after}</TechnicalLabel>
      <MachineValue name="reg_i" value="500000" tone="ok" />
      <MachineValue name="reg_acc" value="913742" tone="ok" />
      <MachineValue name="reg_rows" value="0x7f…" tone="ok" />
      <div class="continuation">
        <span aria-hidden="true">↻</span>
        <TechnicalLabel tone="ok" size="xs">{t.continue}</TechnicalLabel>
      </div>
    </section>
  </div>
</SkeinFigure>

<style>
  .osr-layout {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(270px, 1.1fr) minmax(220px, 1fr);
    gap: 22px;
    align-items: center;
    min-width: 740px;
  }

  .frame {
    display: grid;
    gap: 9px;
    padding: 18px;
    border-top: 0.5px solid var(--hairline-strong);
    border-bottom: 0.5px solid var(--hairline-strong);
    background: color-mix(in srgb, var(--card) 68%, transparent);
  }

  .frame :global(.sk-mv) {
    width: fit-content;
  }

  .loop-code {
    margin-top: 5px;
    padding-top: 10px;
    border-top: 0.5px solid var(--hairline-2);
  }

  .loop-code code,
  .osr-entry code {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-2);
  }

  .swap {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px;
    align-items: center;
  }

  .swap > :global(.sk-tech-label) {
    grid-column: 1 / -1;
    justify-self: center;
  }

  .osr-entry {
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 14px 16px;
    border-left: 1px solid color-mix(in srgb, var(--d, var(--accent)) 52%, var(--hairline));
    background: color-mix(in srgb, var(--d, var(--accent)) 5%, transparent);
  }

  .arrow {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--d, var(--accent));
  }

  .continuation {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 5px;
    color: var(--ok);
  }

  .continuation > span {
    font-family: var(--font-mono);
    font-size: 20px;
  }
</style>
