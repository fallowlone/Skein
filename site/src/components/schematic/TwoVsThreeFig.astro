---
/**
 * TwoVsThreeFig — The Two-Message Failure vs Three-Message Proof.
 *
 * Tier B: Supporting Technical Diagram.
 * Embedded cleanly in explanation with compact technical labels.
 *
 * Answers: "Why three messages and not two?"
 * Centered on SYNCHRONIZATION:
 *   - After 2 messages, Client knows Server ISN y, but Server does not know if Client received y.
 *   - Mutual synchronization is not achieved until 3rd message (ACK).
 *   - Secondary scenario: delayed duplicate SYN safely resolved with RST or ACK verification.
 *
 * Island-free: inline SVG + semantic HTML.
 */
interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}

const { lang = "en", span = "learning" } = Astro.props;

const copy = {
  en: {
    label: "Side-by-side comparison demonstrating why a two-way handshake leaves the server's sequence number unconfirmed, whereas the three-way handshake establishes mutual synchronization.",
    thesis: "Two messages synchronize one side; three messages synchronize both.",
    caption: "After SYN-ACK the client knows y, but the server still cannot tell whether y was received — or whether the SYN was an old delayed duplicate. The third packet settles both questions at once.",
    techTag: "TECHNICAL COMPARISON · SYNCHRONIZATION INTEGRITY",
    twoBadge: "2 MESSAGES · INCOMPLETE",
    threeBadge: "3 MESSAGES · SOUND",
    clientStateLabel: "Client state:",
    serverStateLabel: "Server state:",
    staleDuplicateLabel: "Stale duplicate:",
    mutualProof: "MUTUAL PROOF",
    leftTitle: "HYPOTHETICAL 2-STEP (ASYMMETRIC)",
    leftSubtitle: "Server counter unacknowledged; delayed duplicate risk",
    rightTitle: "TCP 3-STEP (MUTUAL SYNCHRONIZATION)",
    rightSubtitle: "Both counters confirmed; safe stale rejection",
    client: "CLIENT",
    server: "SERVER",
    twoStep1: "SYN (seq=x)",
    twoStep2: "SYN-ACK (seq=y, ack=x+1)",
    twoSyncClient: "Client knows server received x and learns y",
    twoSyncServer: "Server does NOT know if client received y",
    twoDuplicateRisk: "Old delayed duplicate SYN leaves server half-open without confirmation",
    unconfirmedMark: "[ Server counter y unacknowledged ]",
    threeStep1: "① SYN (seq=x)",
    threeStep2: "② SYN-ACK (seq=y, ack=x+1)",
    threeStep3: "③ ACK (ack=y+1)",
    threeSyncClient: "Client confirms server ISN y and moves to ESTABLISHED",
    threeSyncServer: "Server receives ACK for y and moves to ESTABLISHED",
    threeDuplicateResolution: "Delayed duplicate SYN triggers SYN-ACK; client rejects with RST",
  },
  ru: {
    label: "Сравнительная схема, демонстрирующая, почему двухшаговое рукопожатие оставляет счётчик сервера неподтверждённым, а трёхшаговое обеспечивает взаимную синхронизацию.",
    thesis: "Два сообщения синхронизируют одну сторону, три — обе.",
    caption: "После SYN-ACK клиент знает y, а сервер всё ещё не может понять, дошёл ли y, — и не был ли SYN старым задержанным дубликатом. Третий пакет снимает оба вопроса сразу.",
    techTag: "ТЕХНИЧЕСКОЕ СРАВНЕНИЕ · НАДЁЖНОСТЬ СИНХРОНИЗАЦИИ",
    twoBadge: "2 СООБЩЕНИЯ · НЕПОЛНО",
    threeBadge: "3 СООБЩЕНИЯ · СИНХРОНИЗИРОВАНО",
    clientStateLabel: "Состояние клиента:",
    serverStateLabel: "Состояние сервера:",
    staleDuplicateLabel: "Задержанный дубликат:",
    mutualProof: "ВЗАИМНОЕ ПОДТВЕРЖДЕНИЕ",
    leftTitle: "ГИПОТЕТИЧЕСКИЙ 2-ШАГОВЫЙ ОБМЕН",
    leftSubtitle: "Счётчик сервера не подтверждён; риск задержанных дубликатов",
    rightTitle: "ТРЁХШАГОВЫЙ TCP (ВЗАИМНАЯ СИНХРОНИЗАЦИЯ)",
    rightSubtitle: "Оба счётчика подтверждены; безопасный сброс устаревших пакетов",
    client: "КЛИЕНТ",
    server: "СЕРВЕР",
    twoStep1: "SYN (seq=x)",
    twoStep2: "SYN-ACK (seq=y, ack=x+1)",
    twoSyncClient: "Клиент знает, что сервер получил x, и узнаёт y",
    twoSyncServer: "Сервер НЕ знает, получил ли клиент y",
    twoDuplicateRisk: "Старый задержанный дубликат SYN оставляет полуоткрытый сокет",
    unconfirmedMark: "[ Счётчик сервера y не подтверждён ]",
    threeStep1: "① SYN (seq=x)",
    threeStep2: "② SYN-ACK (seq=y, ack=x+1)",
    threeStep3: "③ ACK (ack=y+1)",
    threeSyncClient: "Клиент подтверждает ISN сервера y и переходит в ESTABLISHED",
    threeSyncServer: "Сервер получает ACK на y и переходит в ESTABLISHED",
    threeDuplicateResolution: "Задержанный SYN вызывает SYN-ACK; клиент сбрасывает его через RST",
  },
}[lang];
---

<figure
  data-lesson-visual
  data-span={span}
  class={`sk-tvt-figure sk-span-${span}`}
  aria-label={copy.label}
>
  <div class="sk-tvt-topline" aria-hidden="true">
    <span class="sk-tvt-badge">{copy.techTag}</span>
  </div>

  <div class="sk-tvt-grid">
    {/* Left Column: 2-step flaw */}
    <div class="sk-tvt-col sk-tvt-col-fail">
      <div class="sk-tvt-header">
        <span class="sk-tvt-pill sk-pill-warn">{copy.twoBadge}</span>
        <h4 class="sk-tvt-title">{copy.leftTitle}</h4>
        <p class="sk-tvt-subtitle">{copy.leftSubtitle}</p>
      </div>

      <div class="sk-tvt-svg-wrap">
        <svg viewBox="0 0 320 160" class="sk-tvt-svg" aria-hidden="true">
          <defs>
            <marker id="sk-tvt-arr-ink" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--ink)" />
            </marker>
            <marker id="sk-tvt-arr-warn" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--warn)" />
            </marker>
          </defs>
          <text x="40" y="18" class="sk-svg-actor">{copy.client}</text>
          <line x1="40" y1="26" x2="40" y2="150" stroke="var(--hairline-strong)" stroke-dasharray="3 3" />
          <text x="280" y="18" class="sk-svg-actor">{copy.server}</text>
          <line x1="280" y1="26" x2="280" y2="150" stroke="var(--hairline-strong)" stroke-dasharray="3 3" />

          <line x1="40" y1="46" x2="274" y2="76" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#sk-tvt-arr-ink)" />
          <text x="160" y="54" text-anchor="middle" class="sk-tvt-wiretext">① {copy.twoStep1}</text>

          <line x1="280" y1="86" x2="46" y2="116" stroke="var(--warn)" stroke-width="1.5" marker-end="url(#sk-tvt-arr-warn)" />
          <text x="160" y="96" text-anchor="middle" class="sk-tvt-wiretext sk-wire-warn">② {copy.twoStep2}</text>

          <text x="160" y="142" text-anchor="middle" class="sk-tvt-unconf">{copy.unconfirmedMark}</text>
        </svg>
      </div>

      <div class="sk-tvt-points">
        <div class="sk-point-item">
          <span class="sk-pt-label">{copy.clientStateLabel}</span>
          <span class="sk-pt-desc">{copy.twoSyncClient}</span>
        </div>
        <div class="sk-point-item sk-pt-flaw">
          <span class="sk-pt-label">{copy.serverStateLabel}</span>
          <span class="sk-pt-desc"><strong>{copy.twoSyncServer}</strong></span>
        </div>
        <div class="sk-point-item sk-pt-sub">
          <span class="sk-pt-label">{copy.staleDuplicateLabel}</span>
          <span class="sk-pt-desc">{copy.twoDuplicateRisk}</span>
        </div>
      </div>
    </div>

    {/* Right Column: 3-step proof */}
    <div class="sk-tvt-col sk-tvt-col-ok">
      <div class="sk-tvt-header">
        <span class="sk-tvt-pill sk-pill-ok">{copy.threeBadge}</span>
        <h4 class="sk-tvt-title">{copy.rightTitle}</h4>
        <p class="sk-tvt-subtitle">{copy.rightSubtitle}</p>
      </div>

      <div class="sk-tvt-svg-wrap">
        <svg viewBox="0 0 320 160" class="sk-tvt-svg" aria-hidden="true">
          <defs>
            <marker id="sk-tvt-arr-ok" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0 1.5 L8 5 L0 8.5 z" fill="var(--ok)" />
            </marker>
          </defs>
          <text x="40" y="18" class="sk-svg-actor">{copy.client}</text>
          <line x1="40" y1="26" x2="40" y2="150" stroke="var(--hairline-strong)" stroke-dasharray="3 3" />
          <text x="280" y="18" class="sk-svg-actor">{copy.server}</text>
          <line x1="280" y1="26" x2="280" y2="150" stroke="var(--hairline-strong)" stroke-dasharray="3 3" />

          <line x1="40" y1="42" x2="274" y2="68" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#sk-tvt-arr-ink)" />
          <text x="160" y="48" text-anchor="middle" class="sk-tvt-wiretext">{copy.threeStep1}</text>

          <line x1="280" y1="74" x2="46" y2="100" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#sk-tvt-arr-ink)" />
          <text x="160" y="80" text-anchor="middle" class="sk-tvt-wiretext">{copy.threeStep2}</text>

          <line x1="40" y1="106" x2="274" y2="132" stroke="var(--ok)" stroke-width="1.8" marker-end="url(#sk-tvt-arr-ok)" />
          <text x="160" y="112" text-anchor="middle" class="sk-tvt-wiretext sk-wire-ok">{copy.threeStep3} [{copy.mutualProof}]</text>
        </svg>
      </div>

      <div class="sk-tvt-points">
        <div class="sk-point-item">
          <span class="sk-pt-label">{copy.clientStateLabel}</span>
          <span class="sk-pt-desc">{copy.threeSyncClient}</span>
        </div>
        <div class="sk-point-item sk-pt-sound">
          <span class="sk-pt-label">{copy.serverStateLabel}</span>
          <span class="sk-pt-desc"><strong>{copy.threeSyncServer}</strong></span>
        </div>
        <div class="sk-point-item sk-pt-sub">
          <span class="sk-pt-label">{copy.staleDuplicateLabel}</span>
          <span class="sk-pt-desc">{copy.threeDuplicateResolution}</span>
        </div>
      </div>
    </div>
  </div>

  <figcaption class="sk-tvt-caption">
    <span class="sk-tvt-thesis">{copy.thesis}</span>
    <span class="sk-tvt-caption-text">{copy.caption}</span>
  </figcaption>
</figure>

<style>
  .sk-tvt-figure {
    position: relative;
    margin: 36px 0;
    padding: 0;
    box-sizing: border-box;
  }

  .sk-span-reading {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
  }

  .sk-span-learning {
    width: 100%;
    max-width: 860px;
  }

  .sk-span-canvas {
    width: 100%;
    max-width: 1140px;
  }

  .sk-tvt-topline {
    margin-bottom: 12px;
  }

  .sk-tvt-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }


  .sk-tvt-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 44px);
    border-top: 0.5px solid var(--hairline-2);
    border-bottom: 0.5px solid var(--hairline-2);
    padding: 22px 0;
  }

  @media (max-width: 760px) {
    .sk-tvt-grid {
      grid-template-columns: 1fr;
    }
  }

  .sk-tvt-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sk-tvt-col-fail {
    border-left: 2px solid var(--warn);
    padding-left: 14px;
  }

  .sk-tvt-col-ok {
    border-left: 2px solid var(--ok);
    padding-left: 14px;
  }

  .sk-tvt-header {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sk-tvt-pill {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 1px 5px;
    border-radius: var(--r-sm);
  }

  .sk-pill-warn {
    background: color-mix(in srgb, var(--warn) 12%, transparent);
    border: 0.5px solid color-mix(in srgb, var(--warn) 35%, transparent);
    color: color-mix(in srgb, var(--warn) 80%, var(--ink));
  }

  .sk-pill-ok {
    background: color-mix(in srgb, var(--ok) 12%, transparent);
    border: 0.5px solid color-mix(in srgb, var(--ok) 35%, transparent);
    color: var(--ok);
  }

  .sk-tvt-title {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .sk-tvt-subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--muted);
    line-height: 1.4;
  }

  .sk-tvt-svg-wrap {
    width: 100%;
    padding: 4px 0;
  }

  .sk-tvt-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .sk-svg-actor {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    fill: var(--ink);
    text-anchor: middle;
  }

  .sk-tvt-wiretext {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    fill: var(--ink-2);
  }

  .sk-wire-warn {
    fill: color-mix(in srgb, var(--warn) 80%, var(--ink));
    font-weight: 600;
  }

  .sk-wire-ok {
    fill: var(--ok);
    font-weight: 600;
  }

  .sk-tvt-unconf {
    font-family: var(--font-mono);
    font-size: 8.5px;
    fill: var(--muted);
    font-style: italic;
  }

  .sk-tvt-points {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
    line-height: 1.45;
    padding-top: 6px;
    border-top: 0.5px solid var(--hairline);
  }

  .sk-point-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sk-pt-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .sk-pt-desc {
    font-family: var(--font-body);
    color: var(--ink-2);
  }

  .sk-pt-flaw .sk-pt-desc {
    color: color-mix(in srgb, var(--warn) 90%, var(--ink));
  }

  .sk-pt-sound .sk-pt-desc {
    color: var(--ink);
  }

  .sk-pt-sub .sk-pt-desc {
    font-size: 11.5px;
    color: var(--muted);
  }

  .sk-tvt-caption {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sk-tvt-thesis {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .sk-tvt-caption-text {
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--muted);
  }
</style>
