---
/**
 * MetaphorMappingFig — Intuition -> Abstraction -> Implementation.
 *
 * Tier C: Integrated Micro-Diagram.
 * Demoted from FIG. 02 plate to an integrated editorial schematic table.
 * Uses semantic <figure data-lesson-visual data-span={span}> without heavy editorial plate chrome.
 *
 * Transforms the phone-call greeting into a rigorous editorial schematic mapping:
 *   1. Intuition: Conversational phone-call etiquette
 *   2. Abstraction: Two-way sequence number negotiation contract
 *   3. Implementation: Wire protocol flags and sequence math
 *
 * Island-free: inline HTML/SVG.
 */
import MachineValue from "./MachineValue.astro";

interface Props {
  lang?: "en" | "ru";
  span?: "reading" | "learning" | "canvas";
}

const { lang = "en", span = "learning" } = Astro.props;

const copy = {
  en: {
    label: "Three-column editorial table mapping the human phone call metaphor through its formal protocol abstraction down to exact TCP segment wire fields.",
    thesis: "Three messages are the mathematical minimum for synchronizing two independent counters.",
    caption: "Each SYN consumes exactly one sequence number, which is why the acknowledgement is the peer's number plus one.",
    colIntuition: "HUMAN INTUITION",
    colAbstraction: "PROTOCOL CONTRACT",
    colImplementation: "WIRE SEGMENT",
    step1Dial: '"Hello, can you hear me? My counter starts at 42,000,000."',
    step1Abs: "Client proposes its Initial Sequence Number (ISN_c). Server learns client's counter baseline.",
    step1Flag: "SYN",
    step1Seq: "42,000,000",
    step2Dial: '"Loud and clear! I expect byte 42,000,001. Can you hear me? My counter starts at 99,000,000."',
    step2Abs: "Server acknowledges client ISN (+1 consumed) and proposes its own server ISN_s in the same segment.",
    step2Flag: "SYN + ACK",
    step2Seq: "99,000,000",
    step2Ack: "42,000,001",
    step3Dial: '"Loud and clear! I expect byte 99,000,001. Go ahead, speak."',
    step3Abs: "Client acknowledges server ISN (+1 consumed). Both channels verified. Byte streaming begins.",
    step3Flag: "ACK",
    step3Seq: "42,000,001",
    step3Ack: "99,000,001",
    ackNone: "—",
  },
  ru: {
    label: "Трёхколоночная схема, сопоставляющая бытовую телефонную метафору с абстракцией протокола и точными полями TCP-сегмента на проводе.",
    thesis: "Три сообщения — математический минимум для синхронизации двух независимых счётчиков.",
    caption: "Каждый SYN занимает ровно один номер последовательности, поэтому подтверждение — это номер партнёра плюс один.",
    colIntuition: "ЧЕЛОВЕЧЕСКАЯ ИНТУИЦИЯ",
    colAbstraction: "КОНТРАКТ ПРОТОКОЛА",
    colImplementation: "СЕГМЕНТ В СЕТИ",
    step1Dial: "«Алло, меня слышно? Мой счётчик начинается с 42 000 000.»",
    step1Abs: "Клиент заявляет свой начальный номер (ISN_c). Сервер узнаёт базовую точку отсчёта клиента.",
    step1Flag: "SYN",
    step1Seq: "42 000 000",
    step2Dial: "«Слышу отлично! Жду байт 42 000 001. А меня слышно? Мой счётчик — 99 000 000.»",
    step2Abs: "Сервер подтверждает ISN клиента (+1 байт) и тем же сегментом заявляет собственный ISN_s.",
    step2Flag: "SYN + ACK",
    step2Seq: "99 000 000",
    step2Ack: "42 000 001",
    step3Dial: "«Слышу отлично! Жду байт 99 000 001. Начинай говорить.»",
    step3Abs: "Клиент подтверждает ISN сервера (+1 байт). Оба направления подтверждены. Поток открыт.",
    step3Flag: "ACK",
    step3Seq: "42 000 001",
    step3Ack: "99 000 001",
    ackNone: "—",
  },
}[lang];
---

<figure
  data-lesson-visual
  data-span={span}
  class={`sk-metaphor-integrated sk-span-${span}`}
  aria-label={copy.label}
>
  <div class="sk-metaphor-table">
    {/* Column Headers */}
    <div class="sk-mt-header" aria-hidden="true">
      <div class="sk-mt-th">{copy.colIntuition}</div>
      <div class="sk-mt-th">{copy.colAbstraction}</div>
      <div class="sk-mt-th">{copy.colImplementation}</div>
    </div>

    {/* Row 1: Step 1 */}
    <div class="sk-mt-row">
      <div class="sk-mt-cell sk-cell-intuition">
        <span class="sk-step-badge">1</span>
        <blockquote class="sk-dialogue-quote">
          {copy.step1Dial}
        </blockquote>
      </div>

      <div class="sk-mt-cell sk-cell-abstraction">
        <p class="sk-abs-text">{copy.step1Abs}</p>
        <span class="sk-arrow-symbol" aria-hidden="true">→</span>
      </div>

      <div class="sk-mt-cell sk-cell-implementation">
        <div class="sk-fields-stack">
          <div class="sk-flag-chip sk-flag-syn">{copy.step1Flag}</div>
          <div class="sk-packet-line">
            <MachineValue name="seq" val={copy.step1Seq} size="sm" tone="accent" />
            <span class="sk-packet-ack-dim">ack = {copy.ackNone}</span>
          </div>
        </div>
      </div>
    </div>

    {/* Row 2: Step 2 */}
    <div class="sk-mt-row">
      <div class="sk-mt-cell sk-cell-intuition">
        <span class="sk-step-badge">2</span>
        <blockquote class="sk-dialogue-quote">
          {copy.step2Dial}
        </blockquote>
      </div>

      <div class="sk-mt-cell sk-cell-abstraction">
        <p class="sk-abs-text">{copy.step2Abs}</p>
        <span class="sk-arrow-symbol" aria-hidden="true">←</span>
      </div>

      <div class="sk-mt-cell sk-cell-implementation">
        <div class="sk-fields-stack">
          <div class="sk-flag-chip sk-flag-synack">{copy.step2Flag}</div>
          <div class="sk-packet-line">
            <MachineValue name="seq" val={copy.step2Seq} size="sm" tone="warn" />
            <MachineValue name="ack" val={copy.step2Ack} size="sm" tone="ok" />
          </div>
        </div>
      </div>
    </div>

    {/* Row 3: Step 3 */}
    <div class="sk-mt-row">
      <div class="sk-mt-cell sk-cell-intuition">
        <span class="sk-step-badge">3</span>
        <blockquote class="sk-dialogue-quote">
          {copy.step3Dial}
        </blockquote>
      </div>

      <div class="sk-mt-cell sk-cell-abstraction">
        <p class="sk-abs-text">{copy.step3Abs}</p>
        <span class="sk-arrow-symbol" aria-hidden="true">→</span>
      </div>

      <div class="sk-mt-cell sk-cell-implementation">
        <div class="sk-fields-stack">
          <div class="sk-flag-chip sk-flag-ack">{copy.step3Flag}</div>
          <div class="sk-packet-line">
            <MachineValue name="seq" val={copy.step3Seq} size="sm" tone="neutral" />
            <MachineValue name="ack" val={copy.step3Ack} size="sm" tone="ok" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <figcaption class="sk-metaphor-caption">
    <span class="sk-metaphor-thesis">{copy.thesis}</span>
    <span class="sk-metaphor-caption-text">{copy.caption}</span>
  </figcaption>
</figure>

<style>
  .sk-metaphor-integrated {
    position: relative;
    margin: 36px 0;
    padding: 0;
    box-sizing: border-box;
  }

  .sk-span-reading {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
  }

  .sk-span-learning {
    width: 100%;
    max-width: 860px;
  }

  .sk-span-canvas {
    width: 100%;
    max-width: 1140px;
  }

  .sk-metaphor-table {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline-strong);
    background: transparent;
  }

  .sk-mt-header {
    display: grid;
    grid-template-columns: 1.15fr 1.35fr 1.1fr;
    border-bottom: 1px solid var(--hairline);
    padding: 8px 12px;
  }

  .sk-mt-th {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .sk-mt-row {
    display: grid;
    grid-template-columns: 1.15fr 1.35fr 1.1fr;
    border-bottom: 0.5px solid var(--hairline);
    padding: 16px 12px;
    align-items: center;
    gap: 16px;
  }

  .sk-mt-row:last-child {
    border-bottom: none;
  }

  /* Cell 1: Intuition */
  .sk-cell-intuition {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .sk-step-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid var(--hairline-strong);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--ink-2);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .sk-dialogue-quote {
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink);
    border: none;
  }

  /* Cell 2: Abstraction with column hairline dividers */
  .sk-cell-abstraction {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-left: 1px solid var(--hairline);
    border-right: 1px solid var(--hairline);
    padding-inline: 16px;
    min-height: 100%;
  }

  .sk-abs-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .sk-arrow-symbol {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--d, var(--accent));
    flex-shrink: 0;
    opacity: 0.7;
  }

  /* Cell 3: Implementation */
  .sk-cell-implementation {
    display: flex;
    align-items: center;
  }

  .sk-fields-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .sk-flag-chip {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 1px 6px;
    border-radius: var(--r-sm);
  }

  .sk-flag-syn {
    background: color-mix(in srgb, var(--d, var(--accent)) 10%, transparent);
    border: 0.5px solid color-mix(in srgb, var(--d, var(--accent)) 35%, transparent);
    color: var(--d, var(--accent));
  }

  .sk-flag-synack {
    background: color-mix(in srgb, var(--warn) 12%, transparent);
    border: 0.5px solid color-mix(in srgb, var(--warn) 35%, transparent);
    color: color-mix(in srgb, var(--warn) 80%, var(--ink));
  }

  .sk-flag-ack {
    background: color-mix(in srgb, var(--ok) 10%, transparent);
    border: 0.5px solid color-mix(in srgb, var(--ok) 35%, transparent);
    color: var(--ok);
  }

  .sk-packet-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .sk-packet-ack-dim {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  /* Integrated caption: serif thesis + sans technical clarification */
  .sk-metaphor-caption {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sk-metaphor-thesis {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .sk-metaphor-caption-text {
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .sk-mt-header {
      display: none;
    }
    .sk-mt-row {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 14px 4px;
    }
    .sk-cell-abstraction {
      border-left: none;
      border-right: none;
      padding-inline: 0;
      padding-block: 8px;
      border-top: 0.5px dashed var(--hairline);
      border-bottom: 0.5px dashed var(--hairline);
    }
  }
</style>
