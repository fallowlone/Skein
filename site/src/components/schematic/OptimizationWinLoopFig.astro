---
/**
 * OptimizationWinLoopFig — Tier-B learning figure.
 *
 * The loop that produces every optimization win:
 * profile first to rank costs, name the mechanism
 * with a trace flag (--trace-deopt, %DebugPrint),
 * fix the data layout or control flow, and gate
 * the win in CI so the next refactor cannot silently
 * erode it. Never guess; attack the dominant cost only.
 *
 * Server-rendered; the is:inline script loops the stages.
 * Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "OPTIMISATION LOOP",
    title: "Never guess — profile, name, fix, gate",
    label: "Measure to find the single dominant cost, name the mechanism with a trace flag, fix the data or control flow, then gate the win in CI so the next refactor cannot silently erode it.",
    thesis: "The cause is almost never in the engine — measure, name it, fix the input, and gate the win.",
    caption: "Optimization is a loop, not a checklist. Fixing the second-biggest cost while the first still dominates is wasted work; an unwatched win erodes in the next commit.",
    scope: "V8-SPECIFIC MODEL",
    stages: "THE FOUR-STAGE LOOP",
    rule: "TOP COST FIRST",
    stages: [
      { name: "measure", note: "profile first; rank costs by time and allocation" },
      { name: "hypothesise", note: "name the mechanism via --trace-* or %DebugPrint" },
      { name: "fix data", note: "reshape inputs, typed arrays, or yield points" },
      { name: "gate win", note: "regression benchmark in CI keeps the fix permanent" },
    ],
    flow: [
      { state: "measuring", log: "profile first · rank costs" },
      { state: "hypothesising", log: "--trace-deopt · %DebugPrint" },
      { state: "fixing", log: "shapes · typed arrays · yield" },
      { state: "gating", log: "CI gate keeps it fixed ✓" },
    ],
    order: "ORDER — BIGGEST COST FIRST",
    orderBody: "Fixing the second-biggest cost while the biggest still dominates is wasted work. Rank costs, then attack only the top of the list.",
    gate: "GATE — WINS DECAY SILENTLY",
    gateBody: "An unwatched win erodes in the next refactor. A guarded benchmark in CI is what makes a fix permanent rather than a story.",
  },
  ru: {
    category: "ЦИКЛ ОПТИМИЗАЦИИ",
    title: "Не гадайте — профилируйте, называйте, чините, фиксируйте",
    label: "Измерьте, чтобы найти доминирующую стоимость, назовите механизм через флаг трассировки, исправьте данные или control flow, затем зафиксируйте выигрыш в CI.",
    thesis: "Причина почти никогда не в движке — измерьте, назовите, исправьте вход и зафиксируйте выигрыш.",
    caption: "Оптимизация — это цикл, а не чеклист. Исправление второй по величине стоимости, пока первая доминирует — пустая работа; незащищённый выигрыш разрушается в следующем коммите.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    stages: "ЧЕТЫРЁХСТАДИЙНЫЙ ЦИКЛ",
    rule: "ГЛАВНАЯ СТОИМОСТЬ ПЕРВОЙ",
    stages: [
      { name: "измерить", note: "профилируйте первым; ранжируйте стоимости по времени и аллокациям" },
      { name: "гипотеза", note: "назовите механизм через --trace-* или %DebugPrint" },
      { name: "исправить данные", note: "измените форму входных данных, типизированные массивы или yield" },
      { name: "зафиксировать", note: "бенчмарк-регрессия в CI делает исправление постоянным" },
    ],
    flow: [
      { state: "измерение", log: "профиль первым · ранжирование" },
      { state: "гипотеза", log: "--trace-deopt · %DebugPrint" },
      { state: "исправление", log: "формы · типизированные · yield" },
      { state: "фиксация", log: "CI-гейт сохраняет фикс ✓" },
    ],
    order: "ПОРЯДОК — ГЛАВНАЯ СТОИМОСТЬ ПЕРВОЙ",
    orderBody: "Исправление второй стоимости, пока первая доминирует — потерянное время. Ранжируйте расходы и атакуйте только верхушку списка.",
    gate: "ГЕЙТ — ВЫИГРЫШИ ТИХО УМИРАЮТ",
    gateBody: "Незащищённый выигрыш стирается в следующем рефакторинге. Защищённый бенчмарк в CI делает улучшение постоянным, а не временным.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="owl" data-owl>
    <div class="owl-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="owl-head">
      <TechnicalLabel tone="muted" size="xs">{t.stages}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="owl-stages">
      {stages.map((s, i) => (
        <li class="owl-stage" data-owl-stage={i}>
          <div class="owl-stage-main">
            <MachineValue value={s.name} tone={i === 0 ? "accent" : i === 3 ? "ok" : undefined} />
          </div>
          <p class="owl-stage-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="owl-flow">
      {flow.map((s, i) => (
        <li class="owl-step" data-owl-step={i} hidden={i !== 0}>
          <span class="owl-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="owl-order">
      <TechnicalLabel tone="warn" size="xs">{t.order}</TechnicalLabel>
      {t.orderBody}
    </p>
    <p class="owl-gate">
      <TechnicalLabel tone="ok" size="xs">{t.gate}</TechnicalLabel>
      {t.gateBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: loop the four stages.
  // Step 0 is server-rendered; the script replays the loop.
  (() => {
    const roots = document.querySelectorAll("[data-owl]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-owl-step]");
      const stages = root.querySelectorAll("[data-owl-stage]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        stages.forEach((el, j) => {
          el.classList.toggle("owl-stage-live", j === Math.min(n, stages.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .owl {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .owl-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .owl-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .owl-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .owl-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .owl-stage-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .owl-stage-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .owl-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .owl-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .owl-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .owl-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .owl-order,
  .owl-gate {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .owl-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .owl-stages { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .owl-stage {
      animation: owl-stage-in var(--dur-2) var(--ease) both;
    }
    .owl-stage:nth-child(2) { animation-delay: 100ms; }
    .owl-stage:nth-child(3) { animation-delay: 200ms; }
    .owl-stage:nth-child(4) { animation-delay: 300ms; }
    @keyframes owl-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
