---
/**
 * StateBadge — Displays a protocol connection state with strict semantic colors:
 *   - Green (ok):     ESTABLISHED (synchronized & ready)
 *   - Amber (warn):   SYN-SENT, SYN-RECEIVED, FIN-WAIT, CLOSE-WAIT (in-flight transitions)
 *   - Neutral/Muted:  CLOSED, LISTEN (quiescent resting states)
 *   - Red (danger):   TIMEOUT, RST, DROPPED (failures / aborted)
 */
interface Props {
  state: string;
  size?: "sm" | "md";
  showDot?: boolean;
}

const { state, size = "md", showDot = true } = Astro.props;

function getTone(s: string): "ok" | "warn" | "neutral" | "danger" {
  const norm = s.toUpperCase();
  if (norm === "ESTABLISHED") return "ok";
  if (
    norm.includes("SYN") ||
    norm.includes("WAIT") ||
    norm.includes("CLOSING") ||
    norm.includes("TRANSIT")
  ) {
    return "warn";
  }
  if (norm.includes("RST") || norm.includes("DROP") || norm.includes("TIMEOUT")) {
    return "danger";
  }
  return "neutral";
}

const tone = getTone(state);
---

<span class={`sk-state-badge sk-state-tone-${tone} sk-state-size-${size}`}>
  {showDot && <span class="sk-state-dot" aria-hidden="true" />}
  <span class="sk-state-name">{state}</span>
</span>

<style>
  .sk-state-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--r-sm);
    line-height: 1;
    white-space: nowrap;
    border: 0.5px solid transparent;
  }

  .sk-state-size-sm {
    font-size: 10px;
    padding: 3px 6px;
  }

  .sk-state-size-md {
    font-size: 11.5px;
    padding: 4px 8px;
  }

  .sk-state-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Tone: OK (Established) */
  .sk-state-tone-ok {
    background: color-mix(in srgb, var(--ok) 12%, var(--card));
    border-color: color-mix(in srgb, var(--ok) 35%, transparent);
    color: var(--ok);
  }
  .sk-state-tone-ok .sk-state-dot {
    background: var(--ok);
  }

  /* Tone: WARN (In-flight / Transition) */
  .sk-state-tone-warn {
    background: color-mix(in srgb, var(--warn) 14%, var(--card));
    border-color: color-mix(in srgb, var(--warn) 40%, transparent);
    color: color-mix(in srgb, var(--warn) 80%, var(--ink));
  }
  .sk-state-tone-warn .sk-state-dot {
    background: var(--warn);
  }

  /* Tone: NEUTRAL (Closed, Listen) */
  .sk-state-tone-neutral {
    background: var(--card);
    border-color: var(--hairline-2);
    color: var(--muted);
  }
  .sk-state-tone-neutral .sk-state-dot {
    background: var(--muted);
  }

  /* Tone: DANGER (RST, Drop) */
  .sk-state-tone-danger {
    background: color-mix(in srgb, var(--danger) 12%, var(--card));
    border-color: color-mix(in srgb, var(--danger) 35%, transparent);
    color: var(--danger);
  }
  .sk-state-tone-danger .sk-state-dot {
    background: var(--danger);
  }
</style>
