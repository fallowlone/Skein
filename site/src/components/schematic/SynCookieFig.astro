---
/**
 * SynCookieFig — Tier-B learning figure.
 *
 * The SYN cookie defense against SYN floods: the server encodes
 * its connection state into the SYN-ACK sequence number and
 * allocates no memory; when the final ACK returns it recomputes
 * the cookie and validates it. A stateless handshake that a
 * flood cannot exhaust, at the cost of a handful of TCP options.
 *
 * Server-rendered; the is:inline script replays the flow.
 * Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "FLOOD DEFENSE",
    title: "State in the sequence number",
    label: "The SYN cookie flow under flood: the server encodes connection state into the SYN-ACK sequence number and allocates no memory, then recomputes and validates the cookie when the ACK returns.",
    thesis: "A handshake that costs the server nothing until it is real.",
    caption: "The initial sequence number is MAC(secret + addresses + ports + MSS + timestamp). The ACK's acknowledgment number must equal cookie+1 — only a real client that received our SYN-ACK can produce it.",
    scope: "D. J. BERNSTEIN, 1996",
    flow: "THE STATELESS FLOW",
    rule: "NO request_sock, NO FLOOD",
    flowList: [
      { state: "SYN", note: "queue is over backlog — server stays stateless" },
      { state: "encode", note: "ISN = MAC(4-tuple + MSS + secret); nothing stored" },
      { state: "SYN-ACK", note: "seq = the cookie itself" },
      { state: "ACK", note: "ack = cookie + 1 — only a listener can send it" },
      { state: "validate", note: "recompute, compare, allocate" },
    ],
    encode: "THE ENCODING",
    encodeBody: "The cookie packs a timestamp, the MSS index, and a MAC over the 4-tuple into 32 bits. The server keeps no per-connection record — the SYN-ACK is the only state there is.",
    tradeoff: "THE TRADE-OFF",
    tradeoffBody: "SYN cookies win against floods but cannot carry every TCP option (window scale, timestamps, SACK). Some stacks enable them only under pressure, not always.",
  },
  ru: {
    category: "ЗАЩИТА ОТ ФЛОДА",
    title: "Состояние — в номере последовательности",
    label: "Поток SYN cookie под флодом: сервер кодирует состояние соединения в номер последовательности SYN-ACK и не аллоцирует память, затем пересчитывает и проверяет cookie, когда возвращается ACK.",
    thesis: "Рукопожатие, которое ничего не стоит серверу, пока оно не настоящее.",
    caption: "Начальный номер последовательности — это MAC(секрет + адреса + порты + MSS + timestamp). ACK должен нести cookie+1 — только настоящий клиент, получивший наш SYN-ACK, способен его выдать.",
    scope: "Д. ДЖ. БЕРНШТАЙН, 1996",
    flow: "БЕССОСТОЯТЕЛЬНЫЙ ПОТОК",
    rule: "НИ request_sock, НИ ФЛОДА",
    flowList: [
      { state: "SYN", note: "очередь переполнена — сервер остаётся бессостоятельным" },
      { state: "кодирование", note: "ISN = MAC(4-ка + MSS + секрет); ничего не хранится" },
      { state: "SYN-ACK", note: "seq = сам cookie" },
      { state: "ACK", note: "ack = cookie + 1 — может послать только слушатель" },
      { state: "проверка", note: "пересчитать, сравнить, аллоцировать" },
    ],
    encode: "КОДИРОВАНИЕ",
    encodeBody: "Cookie упаковывает timestamp, индекс MSS и MAC над 4-ка в 32 бита. Сервер не ведёт записи на соединение — SYN-ACK и есть всё состояние.",
    tradeoff: "КОМПРОМИСС",
    tradeoffBody: "SYN cookies побеждают флоды, но не могут нести все опции TCP (window scale, timestamps, SACK). Некоторые стеки включают их только под давлением, не всегда.",
  },
} as const;

const t = copy[lang];
const flowList = t.flowList;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="scf" data-scf>
    <div class="scf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="scf-head">
      <TechnicalLabel tone="muted" size="xs">{t.flow}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="scf-flow">
      {flowList.map((s, i) => (
        <li class="scf-step" data-scf-step={i}>
          <div class="scf-step-main">
            <MachineValue value={s.state} tone={i === 4 ? "ok" : i === 1 ? "accent" : undefined} variant="chip" size="sm" />
          </div>
          <p class="scf-step-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <p class="scf-encode">
      <TechnicalLabel tone="muted" size="xs">{t.encode}</TechnicalLabel>
      {t.encodeBody}
    </p>
    <p class="scf-tradeoff">
      <TechnicalLabel tone="warn" size="xs">{t.tradeoff}</TechnicalLabel>
      {t.tradeoffBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the stateless flow.
  (() => {
    const roots = document.querySelectorAll("[data-scf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-scf-step]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => {
          el.classList.toggle("scf-step-live", j === n);
          el.toggleAttribute("hidden", j > n);
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.classList.add("scf-step-live"));
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .scf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .scf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .scf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .scf-flow {
    display: grid;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .scf-step {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .scf-step-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .scf-step-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .scf-step-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .scf-encode,
  .scf-tradeoff {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .scf-step { padding: 10px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .scf-step {
      animation: scf-step-in var(--dur-2) var(--ease) both;
    }
    .scf-step:nth-child(2) { animation-delay: 70ms; }
    .scf-step:nth-child(3) { animation-delay: 140ms; }
    .scf-step:nth-child(4) { animation-delay: 210ms; }
    .scf-step:nth-child(5) { animation-delay: 280ms; }
    @keyframes scf-step-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
