---
/**
 * ScavengeFlipFig — Tier-B learning figure.
 *
 * The generational scavenger (Orinoco): new space is
 * two semi-spaces. A Scavenge evacuates roots and
 * remembered slots into to-space via a bump pointer,
 * then walks the copies breadth-first (Cheney scan
 * doubles the work queue), while dead objects are
 * simply abandoned in from-space. Cost is proportional
 * to the live set, not the heap. Second survival
 * promotes to old space.
 *
 * Server-rendered; the is:inline script replays the
 * flip. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "GENERATIONAL SCAVENGE",
    title: "The scavenger copies survivors, never touches dead",
    label: "A Scavenge flips the semi-spaces, evacuates roots and remembered slots into to-space, then walks the copies breadth-first while dead objects are simply abandoned in from-space.",
    thesis: "Copy survivors, flip the halves, and let the dead be reclaimed for free.",
    caption: "New space is two semi-spaces. Cost is proportional to the live set, not the heap: the collector touches only what it copies. An object that dies young is never visited at all.",
    scope: "V8-SPECIFIC MODEL",
    stages: "THE FLIP",
    rule: "COST ∝ LIVE SET",
    stages: [
      { name: "from-space", note: "the old half — holds everything allocated since the last flip" },
      { name: "to-space", note: "survivors copied here by bump pointer" },
      { name: "Cheney scan", note: "walk the queue; copy what the copies point at (BFS)" },
      { name: "old space", note: "a second survival promotes the object out of new space" },
    ],
    flow: [
      { state: "allocating", log: "bump pointer · new space" },
      { state: "evacuating", log: "roots + remembered → to" },
      { state: "scanning queue", log: "BFS copies referents" },
      { state: "reclaimed", log: "dead abandoned" },
    ],
    free: "DEAD COSTS ZERO",
    freeBody: "From-space is reset wholesale after the flip — no traversal, no free list, no bookkeeping. The dead were never visited, so reclaiming them is free.",
    promote: "SECOND SURVIVAL → OLD SPACE",
    promoteBody: "An object that survives two Scavenges is promoted to old space, where the major collector (mark-compact) handles it on a slower cadence.",
  },
  ru: {
    category: "ПОКОЛЕНИЕ СБОРКИ",
    title: "Сборщик копирует выживших, мёртвых не трогает",
    label: "Scavenge переворачивает полупространства, эвакуирует roots и remembered-слоты в to-space, затем обходит копии в ширину, пока мёртвые объекты просто остаются в from-space.",
    thesis: "Копируйте выживших, переворачивайте половины — и пусть мёртвые собираются бесплатно.",
    caption: "New space — это два полупространства. Стоимость пропорциональна живому набору, а не куче: коллектор трогает только то, что копирует. Объект, умерший молодым, не посещается вовсе.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    stages: "ПЕРЕВОРОТ",
    rule: "СТОИМОСТЬ ∝ ЖИВОЙ НАБОР",
    stages: [
      { name: "from-space", note: "старая половина — всё, выделенное с прошлого переворота" },
      { name: "to-space", note: "выжившие копируются сюда bump-указателем" },
      { name: "Cheney scan", note: "обход очереди; копирует то, на что указывают копии (BFS)" },
      { name: "old space", note: "второе выживание продвигает объект из new space" },
    ],
    flow: [
      { state: "выделение", log: "bump-указатель · new space" },
      { state: "эвакуация", log: "roots + remembered → to" },
      { state: "обход очереди", log: "BFS копирует referent'ов" },
      { state: "собрано", log: "мёртвые оставлены" },
    ],
    free: "МЁРТВЫЕ СТОЯТ НОЛЬ",
    freeBody: "From-space сбрасывается целиком после переворота — ни обхода, ни free list, ни bookkeeping'а. Мёртвые не были посещены, поэтому собрать их бесплатно.",
    promote: "ВТОРОЕ ВЫЖИВАНИЕ → OLD SPACE",
    promoteBody: "Объект, переживший два Scavenge, продвигается в old space, где мажорный коллектор (mark-compact) разбирается с ним на более медленном шаге.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="sff" data-sff>
    <div class="sff-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="sff-head">
      <TechnicalLabel tone="muted" size="xs">{t.stages}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="sff-stages">
      {stages.map((s, i) => (
        <li class="sff-stage" data-sff-stage={i}>
          <div class="sff-stage-main">
            <MachineValue value={s.name} tone={i === 1 ? "accent" : i === 3 ? "ok" : undefined} />
          </div>
          <p class="sff-stage-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="sff-flow">
      {flow.map((s, i) => (
        <li class="sff-step" data-sff-step={i} hidden={i !== 0}>
          <span class="sff-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="sff-free">
      <TechnicalLabel tone="muted" size="xs">{t.free}</TechnicalLabel>
      {t.freeBody}
    </p>
    <p class="sff-promote">
      <TechnicalLabel tone="ok" size="xs">{t.promote}</TechnicalLabel>
      {t.promoteBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: replay the scavenge flip.
  // Step 0 is server-rendered; the script replays the evacuation.
  (() => {
    const roots = document.querySelectorAll("[data-sff]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-sff-step]");
      const stages = root.querySelectorAll("[data-sff-stage]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        stages.forEach((el, j) => {
          el.classList.toggle("sff-stage-live", j === Math.min(n, stages.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .sff {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .sff-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .sff-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .sff-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sff-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .sff-stage-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .sff-stage-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .sff-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .sff-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sff-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .sff-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .sff-free,
  .sff-promote {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .sff-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .sff-stages { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sff-stage {
      animation: sff-stage-in var(--dur-2) var(--ease) both;
    }
    .sff-stage:nth-child(2) { animation-delay: 100ms; }
    .sff-stage:nth-child(3) { animation-delay: 200ms; }
    .sff-stage:nth-child(4) { animation-delay: 300ms; }
    @keyframes sff-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
