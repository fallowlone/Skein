---
/**
 * StringTreeFig — Tier-B learning figure.
 *
 * The string representation graph: two flat Seq leaves joined by a
 * ConsString node (O(1) concat), then a SlicedString view that pins
 * its parent alive until something forces a flatten into one flat
 * Seq string (O(n), once). The causal hinge: V8 defers copying
 * characters for as long as possible, and the price of the O(1)
 * operations is a pointer that can hold an enormous parent alive.
 *
 * Server-rendered; the is:inline script walks the four build steps.
 * Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "STRING GRAPH",
    title: "Strings are trees until something flattens them",
    label: "Two flat Seq leaves joined by a ConsString node, then a SlicedString view that pins its parent until flattening turns the tree into one flat string.",
    thesis: "Concat and slice are O(1) precisely because they copy no characters — the price is a live pointer.",
    caption: "a + b allocates one node with two pointers, not a copy. slice(i, j) allocates a view with offset + length. Indexing into the view pays the flatten once, O(n), and releases the parent.",
    scope: "V8-SPECIFIC MODEL",
    leaves: "FLAT LEAVES",
    graph: "THE GRAPH",
    nodes: {
      a: "Seq a",
      b: "Seq b",
      cons: "ConsString",
      slice: "SlicedString",
    },
    edges: "edges: cons → a · cons → b · slice → cons",
    costs: "costs: concat O(1) · slice O(1) · flatten O(n) once",
    steps: [
      { state: "leaves ready", log: "Seq a · Seq b" },
      { state: "cons built", log: "concat → ConsString · O(1)" },
      { state: "parent pinned", log: "slice → pins parent" },
      { state: "flattened", log: "flatten · O(n) once" },
    ],
    pin: "PIN RULE",
    pinBody: "A tiny slice keeps its whole parent alive. Force a flat copy (str + '' or repeated indexing) and let the GC reclaim the parent.",
    internal: "INTERNALISED",
    internalBody: "Property names are internalised in the string table — equality is one pointer comparison, not a character scan.",
  },
  ru: {
    category: "ГРАФ СТРОК",
    title: "Строки — деревья, пока что-то их не спрямит",
    label: "Два плоских Seq-листа, соединённых узлом ConsString, затем вид SlicedString, который держит родителя живым, пока спрямление не превратит дерево в одну плоскую строку.",
    thesis: "Concat и slice — O(1) именно потому, что не копируют символы — цена: живой указатель.",
    caption: "a + b выделяет один узел с двумя указателями, а не копию. slice(i, j) выделяет вид с offset + length. Индексация по виду платит за спрямление один раз, O(n), и отпускает родителя.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    leaves: "ПЛОСКИЕ ЛИСТЫ",
    graph: "ГРАФ",
    nodes: {
      a: "Seq a",
      b: "Seq b",
      cons: "ConsString",
      slice: "SlicedString",
    },
    edges: "рёбра: cons → a · cons → b · slice → cons",
    costs: "стоимости: concat O(1) · slice O(1) · flatten O(n) один раз",
    steps: [
      { state: "листы готовы", log: "Seq a · Seq b" },
      { state: "cons построен", log: "concat → ConsString · O(1)" },
      { state: "родитель закреплён", log: "slice → держит родителя" },
      { state: "спрямлён", log: "flatten · O(n) один раз" },
    ],
    pin: "ПРАВИЛО ЗАКРЫТИЯ",
    pinBody: "Крошечный slice держит живым весь родителя. Заставьте плоскую копию (str + '' или повторная индексация) — и GC reclaim'ит родителя.",
    internal: "INTERNALISED",
    internalBody: "Имена свойств internalised в таблице строк — сравнение это одно сравнение указателей, а не посимвольный скан.",
  },
} as const;

const t = copy[lang];
const steps = t.steps;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="stf" data-stf>
    <div class="stf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="stf-head">
      <TechnicalLabel tone="muted" size="xs">{t.leaves}</TechnicalLabel>
      <TechnicalLabel tone="muted" size="xs" tracking="normal" uppercase={false}>{t.graph}</TechnicalLabel>
    </div>

    <div class="stf-graph" role="img" aria-label={t.label}>
      <div class="stf-leaves">
        <MachineValue value={t.nodes.a} tone="ok" />
        <MachineValue value={t.nodes.b} tone="ok" />
      </div>
      <div class="stf-edges" aria-hidden="true">
        <span class="stf-edge stf-edge-a" />
        <span class="stf-edge stf-edge-b" />
        <span class="stf-edge stf-edge-slice" />
      </div>
      <div class="stf-nodes">
        <MachineValue value={t.nodes.cons} tone="accent" />
        <MachineValue value={t.nodes.slice} tone="warn" />
      </div>
    </div>

    <ol class="stf-steps">
      {steps.map((s, i) => (
        <li class="stf-step" data-stf-step={i} hidden={i !== 0}>
          <span class="stf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="stf-edges-note">{t.edges}</p>
    <p class="stf-costs">{t.costs}</p>

    <p class="stf-pin">
      <TechnicalLabel tone="warn" size="xs">{t.pin}</TechnicalLabel>
      {t.pinBody}
    </p>
    <p class="stf-internal">
      <TechnicalLabel tone="muted" size="xs">{t.internal}</TechnicalLabel>
      {t.internalBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the four build steps.
  // Step 0 is server-rendered visible; the script replays the build.
  (() => {
    const roots = document.querySelectorAll("[data-stf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-stf-step]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
      };
      show(0);
      if (reduceMotion) {
        // No-JS-motion readers keep step 0; show all states statically.
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .stf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .stf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .stf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .stf-graph {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 18px;
    padding: 18px 12px 14px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
  }

  .stf-leaves,
  .stf-nodes {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .stf-edges {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .stf-edge {
    position: absolute;
    background: var(--hairline-strong);
  }
  .stf-edge-a {
    left: calc(50% - 42px);
    top: 62px;
    width: 0.5px;
    height: 18px;
    transform: rotate(18deg);
    transform-origin: top;
  }
  .stf-edge-b {
    left: calc(50% + 42px);
    top: 62px;
    width: 0.5px;
    height: 18px;
    transform: rotate(-18deg);
    transform-origin: top;
  }
  .stf-edge-slice {
    left: calc(50% + 96px);
    top: 108px;
    width: 0.5px;
    height: 18px;
  }

  .stf-steps {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .stf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .stf-edges-note,
  .stf-costs {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .stf-pin,
  .stf-internal {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .stf-graph { padding: 14px 8px 12px; }
    .stf-edge-a, .stf-edge-b, .stf-edge-slice { display: none; }
    .stf-leaves, .stf-nodes { gap: 12px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .stf-graph {
      animation: stf-in var(--dur-2) var(--ease) both;
    }
    @keyframes stf-in {
      from { opacity: 0; transform: scale(0.98); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
