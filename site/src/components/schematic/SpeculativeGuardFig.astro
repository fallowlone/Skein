---
/**
 * SpeculativeGuardFig — Tier-B learning figure.
 *
 * The speculative contract: assume the fast case, guard it
 * cheaply, bail rarely. A guard is a one-instruction check
 * (map compare, type check) that costs almost nothing when
 * the assumption holds. When it fails, the optimized code
 * deopts at the exact instruction offset back to the
 * interpreter — the assumption was wrong, so throw the
 * compiled code away and resume in the interpreter.
 *
 * Server-rendered; the is:inline script replays the
 * assume → guard → run → (rare) bail loop. Zero hydration
 * islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "SPECULATIVE CONTRACT",
    title: "Assume fast, guard cheap, bail rare",
    label: "The optimiser assumes the fast case holds forever, guards each assumption with a one-instruction check, and deopts at the exact offset when a guard fails.",
    thesis: "Speculation pays only because the guard is cheaper than the work it protects.",
    caption: "A guard is not a test of the data — it is a bet recorded in machine code. Compare the map in one instruction: on a match, the optimised path continues at full speed; on a mismatch, control unwinds to the interpreter at the recorded bytecode offset, and the compiled code is thrown away.",
    scope: "V8-SPECIFIC MODEL",
    contract: "ASSUME → GUARD → RUN → (RARE) BAIL",
    guard: "THE GUARD IS THE PRICE",
    guardBody: "A map compare or type check is one instruction on the hot path — cheaper than the ten it protects. When it passes, speculation is nearly free.",
    bail: "BAIL = THROW IT AWAY",
    bailBody: "A failed guard deopts at the exact bytecode offset: live state is rebuilt in the interpreter frame (the inverse of OSR), and the compiled code is discarded.",
    flow: [
      { state: "assume", log: "shape stable" },
      { state: "guard", log: "cmp map · 1 instr" },
      { state: "pass", log: "fast path ✓" },
      { state: "fail", log: "deopt @ offset" },
    ],
  },
  ru: {
    category: "СПЕКУЛЯТИВНЫЙ КОНТРАКТ",
    title: "Предположи быстро, защищай дёшево, откатись редко",
    label: "Оптимизатор предполагает, что быстрый случай держится вечно, защищает каждое предположение одной инструкцией и делает deopt на точном offset, когда guard не проходит.",
    thesis: "Спекуляция окупается только потому, что guard дешевле работы, которую он защищает.",
    caption: "Guard — это не тест данных, а ставка, записанная в машинном коде. Сравнение map одной инструкцией: при совпадении быстрый путь идёт на полной скорости, при несовпадении управление разворачивается к интерпретатору на записанном bytecode offset, а скомпилированный код выбрасывается.",
    scope: "МОДЕЛЬ V8-СПЕЦИФИЧНА",
    contract: "ПРЕДПОЛОЖИ → ЗАЩИТИ → ВЫПОЛНИ → (РЕДКО) ОТКАТ",
    guard: "GUARD — ЭТО ЦЕНА",
    guardBody: "Сравнение map или проверка типа — одна инструкция на горячем пути, дешевле десяти, которые она защищает. Когда guard проходит, спекуляция почти бесплатна.",
    bail: "ОТКАТ = ВЫБРОСИТЬ",
    bailBody: "Проваленный guard делает deopt на точном bytecode offset: живое состояние пересобирается во фрейме интерпретатора (обратная сторона OSR), а скомпилированный код отбрасывается.",
    flow: [
      { state: "предположение", log: "форма стабильна" },
      { state: "guard", log: "cmp map · 1 instr" },
      { state: "проход", log: "быстрый путь ✓" },
      { state: "провал", log: "deopt @ offset" },
    ],
  },
} as const;

const t = copy[lang];
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="spg" data-spg>
    <div class="spg-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="spg-head">
      <TechnicalLabel tone="muted" size="xs">{t.contract}</TechnicalLabel>
    </div>

    <ol class="spg-flow">
      {flow.map((s, i) => (
        <li class="spg-step" data-spg-step={i} hidden={i !== 0}>
          <span class="spg-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "danger" : i === 2 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="spg-guard">
      <TechnicalLabel tone="accent" size="xs">{t.guard}</TechnicalLabel>
      {t.guardBody}
    </p>
    <p class="spg-bail">
      <TechnicalLabel tone="danger" size="xs">{t.bail}</TechnicalLabel>
      {t.bailBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: replay the assume→guard→run→bail loop.
  // Step 0 is server-rendered; the script replays the speculation story.
  (() => {
    const roots = document.querySelectorAll("[data-spg]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-spg-step]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .spg {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .spg-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .spg-head {
    display: flex;
    align-items: baseline;
  }

  .spg-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .spg-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .spg-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .spg-guard,
  .spg-bail {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: no-preference) {
    .spg-step {
      animation: spg-step-in var(--dur-2) var(--ease) both;
    }
    .spg-step:nth-child(2) { animation-delay: 100ms; }
    .spg-step:nth-child(3) { animation-delay: 200ms; }
    .spg-step:nth-child(4) { animation-delay: 300ms; }
    @keyframes spg-step-in {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
