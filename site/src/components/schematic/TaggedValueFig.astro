---
import SkeinFigure from "./SkeinFigure.astro";

interface Props { lang?: "en" | "ru" }
const { lang = "en" } = Astro.props;
const t = {
  en: {
    category: "V8 · TAGGED REPRESENTATION",
    title: "The same low bit selects two different interpretations",
    label: "A tagged value stored in V8's compressed heap is 32 bits. A low zero bit identifies an inline Smi integer. A low one bit identifies a tagged offset into the pointer-compression cage; resolving that pointer reaches a HeapObject whose first field is its Map. Null and undefined use the heap-object path.",
    thesis: "The tag describes the representation, not the JavaScript type.",
    caption: "Common compressed tagged heap representation on 64-bit V8. Runtime registers can use wider values; optimized fields and numeric arrays can use other layouts.",
    storage: "COMPRESSED TAGGED HEAP SLOT · 32 BITS",
    payload: "payload / offset",
    integerBits: "signed integer payload",
    offsetBits: "offset in cage",
    test: "TEST LOW BIT",
    smi: "0 · SMI",
    heap: "1 · HEAP REFERENCE",
    inline: "signed integer payload lives in the tagged bits",
    offset: "tagged offset + cage base → HeapObject",
    map: "OFFSET 0 · MAP FIELD",
    mapNote: "instance kind and layout metadata",
    oddball: "null / undefined / true / false → special heap objects",
    scope: "Tagged storage is a common format, not a rule for every optimized value.",
  },
  ru: {
    category: "V8 · ТЕГИ ЗНАЧЕНИЙ",
    title: "Один младший бит выбирает два разных прочтения",
    label: "Тегированное значение в сжатой куче V8 занимает 32 бита. Младший бит 0 означает целое Smi прямо в записи. Бит 1 означает тегированное смещение внутри области сжатых указателей; восстановленный указатель ведёт к HeapObject, первое поле которого содержит Map. Null и undefined идут путём объекта в куче.",
    thesis: "Тег описывает представление, а не тип JavaScript.",
    caption: "Распространённое сжатое тегированное представление в куче 64-битного V8. Регистры исполнения могут быть шире; оптимизированные поля и числовые массивы могут иметь другую раскладку.",
    storage: "СЖАТЫЙ ТЕГИРОВАННЫЙ СЛОТ КУЧИ · 32 БИТА",
    payload: "данные / смещение",
    integerBits: "знаковое целое",
    offsetBits: "смещение в области",
    test: "ПРОВЕРКА МЛАДШЕГО БИТА",
    smi: "0 · SMI",
    heap: "1 · ССЫЛКА В КУЧУ",
    inline: "знаковое целое хранится прямо в тегированных битах",
    offset: "тегированное смещение + база → HeapObject",
    map: "СМЕЩЕНИЕ 0 · ПОЛЕ MAP",
    mapNote: "метаданные о виде и раскладке",
    oddball: "null / undefined / true / false → особые объекты кучи",
    scope: "Тегированное хранение распространено, но не обязательно для каждого оптимизированного значения.",
  },
}[lang];
---

<SkeinFigure num="01" category={t.category} title={t.title} label={t.label} thesis={t.thesis} caption={t.caption} span="canvas">
  <div class="tag-figure">
    <div class="origin">
      <span class="small">{t.storage}</span>
      <div class="word" aria-hidden="true"><span>31</span><b>··· {t.payload} ···</b><strong>?</strong></div>
      <span class="test">{t.test} <span aria-hidden="true">↓</span></span>
    </div>
    <div class="paths">
      <section class="path smi">
        <h4>{t.smi}</h4>
        <div class="bits"><span>31</span><b>{t.integerBits}</b><strong>0</strong></div>
        <div class="detail">{t.inline}</div>
        <div class="endpoint"><code>42</code><span>← Smi(42)</span></div>
      </section>
      <section class="path heap">
        <h4>{t.heap}</h4>
        <div class="bits"><span>31</span><b>{t.offsetBits}</b><strong>1</strong></div>
        <div class="detail">{t.offset}</div>
        <div class="endpoint"><code>HeapObject</code><span>{t.map}</span></div>
        <small>{t.mapNote}</small>
        <div class="oddball">{t.oddball}</div>
      </section>
    </div>
    <div class="scope">{t.scope}</div>
  </div>
</SkeinFigure>

<style>
  .tag-figure { display: grid; gap: 28px; }
  .small, .test, .scope, h4, .endpoint span { font: 600 10px/1.5 var(--font-mono); letter-spacing: .09em; color: var(--muted); }
  .origin { display: grid; justify-items: center; gap: 12px; }
  .word, .bits { display: flex; align-items: center; border: 1px solid var(--hairline-strong); background: var(--paper); font: 11px var(--font-mono); }
  .word { width: min(100%, 430px); }
  .word span, .bits span { padding: 10px; color: var(--muted); }
  .word b, .bits b { flex: 1; min-width: 0; padding: 10px; text-align: center; font-weight: 500; color: var(--ink); }
  .word strong, .bits strong { padding: 10px 14px; border-left: 1px solid var(--hairline-strong); color: var(--accent); }
  .test { color: var(--accent); text-align: center; }
  .test span { display: block; font-size: 22px; line-height: 1; }
  .paths { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .path { min-width: 0; padding: 22px; border-top: 2px solid var(--hairline-strong); background: color-mix(in srgb, var(--card) 62%, transparent); }
  .path.smi { border-color: var(--accent); }
  .path.heap { border-color: var(--ink-2); }
  h4 { margin: 0 0 18px; color: var(--ink); }
  .detail { min-height: 42px; margin: 17px 0; font: 14px/1.45 var(--font-body); color: var(--ink-2); }
  .endpoint { display: flex; gap: 14px; align-items: center; padding: 14px 0; border-top: 1px solid var(--hairline); }
  .endpoint code { font: 600 14px var(--font-mono); color: var(--accent); }
  .endpoint span { margin-left: auto; text-align: right; }
  .path small { font: 12px/1.4 var(--font-body); color: var(--muted); }
  .oddball { margin-top: 14px; padding-top: 13px; border-top: 1px solid var(--hairline); font: 11px/1.5 var(--font-mono); color: var(--ink-2); }
  .scope { border-top: 1px solid var(--hairline-strong); padding-top: 14px; letter-spacing: 0; font-weight: 400; }
  @media (max-width: 700px) {
    .paths { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .path { padding: 18px; }
    .detail { min-height: 0; }
    .endpoint { flex-wrap: wrap; }
  }
</style>
