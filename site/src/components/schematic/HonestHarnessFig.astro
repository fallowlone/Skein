---
/**
 * HonestHarnessFig — Tier-B learning figure.
 *
 * An honest harness defeats every trap: unused
 * results let the optimiser delete the body and
 * fold the rest. Consume the result into a
 * sink, randomise inputs so constants cannot
 * fold, warm up past OSR to a steady tier,
 * then time steady-state work with allocation
 * isolated. An unused result is a 0 ms
 * phantom.
 *
 * Server-rendered; the is:inline script walks
 * the harness. Zero hydration islands.
 */
import MachineValue from "./MachineValue.astro";
import SkeinFigure from "./SkeinFigure.astro";
import TechnicalLabel from "./TechnicalLabel.astro";

interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    category: "BENCHMARK HARNESS",
    title: "An honest harness defeats every trap",
    label: "Unused results let the optimiser delete the body and fold the rest. Consume the result into a sink, randomise inputs, warm up past OSR, and isolate allocation before timing.",
    thesis: "If the result is unobserved, so is your measurement.",
    caption: "The traps are the optimiser doing its job: dead-code elimination, constant folding, and tiering all fire on a sloppy harness. Sound measurement makes the work observable and the inputs unknowable.",
    scope: "MEASUREMENT MODEL",
    path: "THE HONEST PATH",
    rule: "UNUSED RESULT → 0 MS PHANTOM",
    stages: [
      { name: "sink result", note: "black-hole consume — nothing is dead" },
      { name: "randomise", note: "inputs vary — no constant folding" },
      { name: "warm up", note: "reach a steady tier before timing" },
      { name: "time it", note: "isolate allocation from the measurement" },
    ],
    flow: [
      { state: "sink wired", log: "black-hole sink" },
      { state: "inputs vary", log: "no constant folding" },
      { state: "steady tier", log: "OSR paid" },
      { state: "real number", log: "steady-state cost ✓" },
    ],
    dce: "DCE — THE FIRST TRAP",
    dceBody: "If nobody observes the result, the optimiser may remove the work entirely. A black-hole sink keeps the computation observable so the timer measures real work.",
    micro: "MICRO VS MACRO — PICK THE RIGHT RIG",
    microBody: "A micro-benchmark answers 'is this primitive cheap', never 'is my feature fast'. Match the harness to the question or measure the wrong thing precisely.",
  },
  ru: {
    category: "HARNESS БЕНЧМАРКА",
    title: "Честный harness побеждает каждую ловушку",
    label: "Неиспользуемые результаты позволяют оптимизатору удалить тело и свернуть остальное. Потребите результат в sink, рандомизируйте входы, прогрейте мимо OSR и изолируйте аллокацию перед замером.",
    thesis: "Если результат не наблюдаем, не наблюдаем и ваш замер.",
    caption: "Ловушки — это оптимизатор, делающий свою работу: elimination мёртвого кода, свёртка констант и тиринг все срабатывают на небрежном harnessе. Звуковой замер делает работу наблюдаемой, а входы — незнаваемыми.",
    scope: "МОДЕЛЬ ИЗМЕРЕНИЯ",
    path: "ЧЕСТНЫЙ ПУТЬ",
    rule: "НЕИСПОЛЬЗУЕМЫЙ РЕЗУЛЬТАТ → ФАНТОМ 0 MS",
    stages: [
      { name: "sink результата", note: "black-hole consume — ничего не мертво" },
      { name: "рандомизация", note: "входы варьируются — нет свёртки констант" },
      { name: "прогрев", note: "достичь стабильного тира до замера" },
      { name: "замер", note: "аллокация изолирована от замера" },
    ],
    flow: [
      { state: "sink подключён", log: "black-hole sink" },
      { state: "входы варьируются", log: "нет свёртки констант" },
      { state: "стабильный тир", log: "OSR оплачен" },
      { state: "настоящее число", log: "стоимость steady-state ✓" },
    ],
    dce: "DCE — ПЕРВАЯ ЛОВУШКА",
    dceBody: "Если никто не наблюдает результат, оптимизатор может удалить работу целиком. Black-hole sink держит вычисление наблюдаемым, так что таймер меряет настоящую работу.",
    micro: "МИКРО ПРОТИВ МАКРО — ВЫБЕРИТЕ СТЕНД",
    microBody: "Микро-бенчмарк отвечает на вопрос 'дешёва ли эта примитивная операция', но никогда — 'быстра ли моя фича'. Согласуйте стенд с вопросом, или точно измерите не то.",
  },
} as const;

const t = copy[lang];
const stages = t.stages;
const flow = t.flow;
---

<SkeinFigure
  num="01"
  category={t.category}
  title={t.title}
  label={t.label}
  thesis={t.thesis}
  caption={t.caption}
  span="learning"
>
  <div class="hhf" data-hhf>
    <div class="hhf-scope"><TechnicalLabel tone="muted" size="xs">{t.scope}</TechnicalLabel></div>

    <div class="hhf-head">
      <TechnicalLabel tone="muted" size="xs">{t.path}</TechnicalLabel>
      <TechnicalLabel tone="accent" size="xs" tracking="normal" uppercase={false}>{t.rule}</TechnicalLabel>
    </div>

    <ol class="hhf-stages">
      {stages.map((s, i) => (
        <li class="hhf-stage" data-hhf-stage={i}>
          <div class="hhf-stage-main">
            <MachineValue value={s.name} tone={i === 0 ? "accent" : i === 3 ? "ok" : undefined} />
          </div>
          <p class="hhf-stage-note">{s.note}</p>
        </li>
      ))}
    </ol>

    <ol class="hhf-flow">
      {flow.map((s, i) => (
        <li class="hhf-step" data-hhf-step={i} hidden={i !== 0}>
          <span class="hhf-state">{s.state}</span>
          <MachineValue value={s.log} tone={i === 3 ? "ok" : undefined} />
        </li>
      ))}
    </ol>

    <p class="hhf-dce">
      <TechnicalLabel tone="warn" size="xs">{t.dce}</TechnicalLabel>
      {t.dceBody}
    </p>
    <p class="hhf-micro">
      <TechnicalLabel tone="muted" size="xs">{t.micro}</TechnicalLabel>
      {t.microBody}
    </p>
  </div>
</SkeinFigure>

<script is:inline>
  // Progressive enhancement: walk the honest harness.
  // Step 0 is server-rendered; the script replays the path.
  (() => {
    const roots = document.querySelectorAll("[data-hhf]");
    if (!roots.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const root of roots) {
      const steps = root.querySelectorAll("[data-hhf-step]");
      const stages = root.querySelectorAll("[data-hhf-stage]");
      if (!steps.length) continue;
      let i = 0;
      const show = (n) => {
        steps.forEach((el, j) => el.toggleAttribute("hidden", j !== n));
        stages.forEach((el, j) => {
          el.classList.toggle("hhf-stage-live", j === Math.min(n, stages.length - 1));
        });
      };
      show(0);
      if (reduceMotion) {
        steps.forEach((el) => el.toggleAttribute("hidden", false));
        continue;
      }
      setInterval(() => {
        i = (i + 1) % steps.length;
        show(i);
      }, 2600);
    }
  })();
</script>

<style>
  .hhf {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .hhf-scope {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -6px;
  }

  .hhf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hhf-stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hhf-stage {
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm);
    background: var(--card);
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .hhf-stage-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hhf-stage-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .hhf-stage-live { border-color: var(--accent); background: var(--accent-wash, var(--card)); }

  .hhf-flow {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hhf-step {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 4px;
    border-bottom: 0.5px dashed var(--hairline-2);
  }

  .hhf-state {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .hhf-dce,
  .hhf-micro {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  @media (max-width: 840px) {
    .hhf-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hhf-stages { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hhf-stage {
      animation: hhf-stage-in var(--dur-2) var(--ease) both;
    }
    .hhf-stage:nth-child(2) { animation-delay: 100ms; }
    .hhf-stage:nth-child(3) { animation-delay: 200ms; }
    .hhf-stage:nth-child(4) { animation-delay: 300ms; }
    @keyframes hhf-stage-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
