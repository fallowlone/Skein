---
// Global toast container mounted once in Topic.astro.
// Trigger from anywhere: window.dispatchEvent(new CustomEvent("toast", { detail: { msg, kind } }))
// kind: "ok" | "warn" | "danger" | "info" (default "info")
---
<div
  id="toast-stack"
  data-toast-stack
  class="fixed left-1/2 -translate-x-1/2 bottom-5 z-50 pointer-events-none flex flex-col items-center gap-2 max-w-[min(92vw,520px)]"
  aria-live="polite"
></div>

<script>
  type ToastKind = "ok" | "warn" | "danger" | "info";

  function ensureStack() {
    return document.getElementById("toast-stack");
  }

  function makeToast(msg: string, kind: ToastKind = "info"): HTMLElement {
    const tone =
      kind === "ok"
        ? "var(--ok)"
        : kind === "warn"
          ? "var(--warn)"
          : kind === "danger"
            ? "var(--danger)"
            : "var(--ink)";
    const el = document.createElement("div");
    el.setAttribute("role", "status");
    el.className =
      "pointer-events-auto bg-card border border-rule-strong rounded-[2px] px-4 py-2.5 shadow-soft-md font-mono text-[12px] text-ink flex items-center gap-2 max-w-full";
    el.style.borderLeft = `2px solid ${tone}`;
    el.style.opacity = "0";
    el.style.transform = "translateY(8px)";
    el.style.transition = "opacity .15s, transform .15s";
    el.innerHTML = `<span class="meta" style="color:${tone}">${kind}</span><span class="truncate">${msg}</span>`;
    return el;
  }

  function showToast(msg: string, kind: ToastKind = "info") {
    const stack = ensureStack();
    if (!stack) return;
    const t = makeToast(msg, kind);
    stack.appendChild(t);
    requestAnimationFrame(() => {
      t.style.opacity = "1";
      t.style.transform = "translateY(0)";
    });
    const dismiss = () => {
      t.style.opacity = "0";
      t.style.transform = "translateY(8px)";
      setTimeout(() => t.remove(), 160);
    };
    setTimeout(dismiss, 3000);
    t.addEventListener("click", dismiss);
  }

  window.addEventListener("toast", (e: Event) => {
    const detail = (e as CustomEvent).detail ?? {};
    showToast(String(detail.msg ?? ""), (detail.kind ?? "info") as ToastKind);
  });

  // Expose a typed helper too.
  (window as Window & { toast?: (msg: string, kind?: ToastKind) => void }).toast =
    (msg, kind = "info") => showToast(msg, kind);
</script>
