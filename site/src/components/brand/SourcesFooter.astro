---
type Props = { sources: string[] };
const { sources } = Astro.props;

function domain(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
}
function pathname(url: string): string {
  try {
    const u = new URL(url);
    return u.pathname === "/" ? "" : u.pathname;
  } catch {
    return "";
  }
}
---
{sources.length > 0 && (
  <details data-sources-panel class="max-w-[1200px] mx-auto px-4 lg:px-8 mt-10 mb-16 group">
    <summary class="list-none cursor-pointer flex items-center justify-between py-3 hr-top hr-bot">
      <div class="flex items-center gap-3">
        <span class="meta">sources</span>
        <span class="font-mono text-[12px] text-ink-2">{sources.length}</span>
      </div>
      <span class="font-mono text-[10.5px] uppercase tracking-wider text-muted flex items-center gap-1.5">
        <span class="group-open:hidden">expand</span>
        <span class="hidden group-open:inline">collapse</span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 group-open:rotate-180">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </span>
    </summary>
    <ol class="list-none m-0 p-0 mt-4 flex flex-col">
      {sources.map((s, i) => (
        <li class={`flex items-baseline gap-3 py-2 ${i > 0 ? "hl" : ""}`}>
          <span class="font-mono text-[10.5px] text-muted tabular-nums shrink-0 w-6">
            {String(i + 1).padStart(2, "0")}
          </span>
          <div class="min-w-0 flex-1">
            <a
              class="font-mono text-[12.5px] text-ink hover:underline break-all"
              href={s}
              target="_blank"
              rel="noreferrer noopener"
            >
              <span class="text-ink-2">{domain(s)}</span>
              <span class="text-muted">{pathname(s)}</span>
            </a>
          </div>
        </li>
      ))}
    </ol>
    <p class="mt-4 font-mono text-[10.5px] text-muted-2 leading-relaxed">
      Trademarks belong to their respective owners. Editorial reference only.
    </p>
  </details>
)}
