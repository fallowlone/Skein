---
type Props = { sources: string[] };
const { sources } = Astro.props;
---
{sources.length > 0 && (
<footer class="max-w-[1600px] mx-auto px-6 md:px-14 py-12 text-bbg-muted text-sm">
  <p class="font-semibold text-bbg-ink mb-2">Sources</p>
  <ul class="space-y-1">
    {sources.map((s) => (
      <li><a class="underline hover:text-bbg-ink break-all" href={s} target="_blank" rel="noreferrer">{s}</a></li>
    ))}
  </ul>
  <p class="mt-6 text-xs">Trademarks belong to their respective owners. Editorial reference only.</p>
</footer>
)}
