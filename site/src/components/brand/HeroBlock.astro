---
import { type Locale } from "../../i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

const copy = {
  en: {
    kicker: "curriculum",
    sub: "vol. iii · senior fullstack",
    title1: "Become",
    titleAccent: "senior",
    title2: "fullstack.",
    body: "16 pillars × 8 pieces × 2 languages. From",
    bodyMid: "to",
    cta: "Start with diagnostics",
    ctaSecondary: "See the map",
    signaturePiece: "databases/08 — putting it together",
    signatureLabel: "signature piece",
  },
  ru: {
    kicker: "курс",
    sub: "том iii · senior fullstack",
    title1: "Стань",
    titleAccent: "senior",
    title2: "fullstack.",
    body: "16 столпов × 8 пьес × 2 языка. От",
    bodyMid: "до",
    cta: "Начать с диагностики",
    ctaSecondary: "Посмотреть карту",
    signaturePiece: "databases/08 — putting it together",
    signatureLabel: "signature piece",
  },
}[lang];
---
<section class="relative py-12 md:py-16">
  <div class="meta mb-7">
    <span class="text-ink">{copy.kicker}</span>
    <span class="opacity-50 px-2">·</span>
    <span>{copy.sub}</span>
  </div>
  <div class="hr-top pt-6">
    <h1 class="font-display text-[clamp(48px,9vw,76px)] leading-[0.95] font-extrabold tracking-[-0.03em] m-0" style="text-wrap: pretty;">
      {copy.title1} <em class="font-display italic font-medium" style="color: var(--p-sky); font-variation-settings: 'opsz' 144, 'SOFT' 100;">{copy.titleAccent}</em><br />{copy.title2}
    </h1>
    <p class="text-[18px] leading-snug text-ink-2 max-w-[480px] mt-6">
      {copy.body} <span class="font-mono text-[15px] text-muted">HTTP</span> {copy.bodyMid} <span class="font-mono text-[15px] text-muted">Citus</span>.
    </p>
    <div class="flex flex-wrap items-center gap-5 mt-8">
      <button class="btn" type="button">
        {copy.cta}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
      <a class="btn link text-muted" href="#pillar-map">{copy.ctaSecondary}</a>
    </div>
  </div>
  <div class="hidden md:block absolute right-0 bottom-4 text-right">
    <div class="meta mb-1" style="font-size: 9.5px;">{copy.signatureLabel}</div>
    <a class="font-mono text-[11px] text-ink-2 hover:underline" href={`/${lang}/databases/08-putting-it-together/`}>{copy.signaturePiece}</a>
  </div>
</section>
