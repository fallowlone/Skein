---
type Props = { headline: string; wordmark?: boolean; lang?: "en" | "ru" };
const { headline, wordmark = true, lang } = Astro.props;
const homeHref = lang ? `/${lang}/` : "/";
---
<header class="sticky top-0 z-30 bg-white/90 backdrop-blur border-b border-gray-100">
  <div class="max-w-[1600px] mx-auto px-6 md:px-14 py-6 flex items-center gap-6">
    <a href={homeHref} class="block w-1.5 h-12 bg-bbg-teal rounded-sm hover:bg-bbg-purple transition-colors" aria-label="Home"></a>
    <h1 class="text-2xl md:text-3xl font-extrabold text-bbg-ink flex-1">{headline}</h1>
    <slot name="aside" />
    {wordmark && (
      <a href={homeHref} class="flex items-center gap-2 shrink-0 group" aria-label="Home">
        <span class="w-8 h-8 rounded-lg bg-bbg-teal grid place-items-center text-white font-extrabold group-hover:bg-bbg-purple transition-colors">A</span>
        <span class="font-extrabold text-bbg-purple text-lg group-hover:text-bbg-teal transition-colors">awesome</span>
      </a>
    )}
  </div>
</header>
