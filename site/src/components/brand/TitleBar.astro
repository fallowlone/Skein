---
import ThemeToggle from "./ThemeToggle.astro";
import GlobalSearch from "../nav/GlobalSearch.astro";
import { type Locale } from "../../i18n";

type Props = { headline: string; wordmark?: boolean; lang?: Locale };
const { headline, wordmark = true, lang } = Astro.props;
const homeHref = lang ? `/${lang}/` : "/";
const fallbackLang = (lang ?? "en") as Locale;
---
<header data-titlebar class="sticky top-0 z-40 bg-paper/95 backdrop-blur-sm border-b border-rule">
  <div class="max-w-[1600px] mx-auto px-4 md:px-8 py-2.5 flex items-center gap-3">
    <a
      href={homeHref}
      class="block w-1.5 h-7 self-stretch"
      style="background: var(--ink);"
      aria-label="Home"
    ></a>

    <a
      href={homeHref}
      class="flex items-baseline gap-1.5 shrink-0 group"
      aria-label="Home"
    >
      <span class="font-display text-[16px] font-extrabold tracking-[-0.01em] text-ink">awesome-everything</span>
      <span class="meta hidden sm:inline">curriculum</span>
    </a>

    <span class="flex-1" aria-hidden="true"></span>

    <div class="hidden md:flex items-center gap-2 shrink-0">
      <GlobalSearch lang={fallbackLang} />
      <ThemeToggle lang={fallbackLang} />
    </div>
    <slot name="aside" />

    {wordmark && (
      <a href={`/${fallbackLang}/glossary/`} class="btn ghost shrink-0" style="padding: 6px 8px; font-size: 11px;" aria-label="glossary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 19.5A2.5 2.5 0 016.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>
        </svg>
      </a>
    )}

    {wordmark && (
      <a href={`/${fallbackLang}/settings/`} class="btn ghost shrink-0" style="padding: 6px 8px; font-size: 11px;" aria-label="settings">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 005.5 15a1.65 1.65 0 00-1.51-1H4a2 2 0 110-4h.09A1.65 1.65 0 005.5 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H10a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06A1.65 1.65 0 0019.4 9c.06.21.1.42.1.65V10a2 2 0 110 4h-.09c-.23 0-.44.04-.65.1z"/>
        </svg>
      </a>
    )}
  </div>
</header>
