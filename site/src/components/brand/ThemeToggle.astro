---
import { type Locale } from "../../i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

const labels = {
  en: { theme: "theme", light: "light", dark: "dark" },
  ru: { theme: "тема", light: "light", dark: "dark" },
}[lang];
---
<button
  type="button"
  data-theme-toggle
  class="icon-btn"
  aria-label={labels.theme}
  title={labels.theme}
>
  <svg data-icon-light width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </svg>
  <svg data-icon-dark class="hidden" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
  </svg>
  <span data-theme-label class="font-mono text-[11px] uppercase tracking-wider">{labels.light}</span>
</button>

<script>
  function init() {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
      const lightIcon = btn.querySelector<HTMLElement>("[data-icon-light]");
      const darkIcon = btn.querySelector<HTMLElement>("[data-icon-dark]");
      const label = btn.querySelector<HTMLElement>("[data-theme-label]");

      function sync() {
        const t = document.documentElement.getAttribute("data-theme") ?? "light";
        if (lightIcon) lightIcon.classList.toggle("hidden", t === "dark");
        if (darkIcon) darkIcon.classList.toggle("hidden", t !== "dark");
        if (label) label.textContent = t;
      }

      btn.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme") ?? "light";
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem("awesome.theme", next);
        } catch {}
        sync();
        window.dispatchEvent(new CustomEvent("toast", { detail: { msg: `theme: ${next}`, kind: "info" } }));
      });

      sync();
    });
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
