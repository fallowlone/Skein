---
// Shared SEO head block: title, description, canonical, Open Graph, Twitter
// card, and en/ru hreflang alternates. Used by both Topic and Atlas layouts.
import { t, swapLocale, type Locale } from "~/i18n";

type Props = { title: string; lang: Locale; description?: string };
const { title, lang, description } = Astro.props;

const fullTitle = `${title} — ${t("site.title", lang)}`;
const desc = description ?? t("site.tagline", lang);
const site = Astro.site ?? new URL("https://fallowlone.com");
const canonical = new URL(Astro.url.pathname, site);

// hreflang alternates only make sense on locale-prefixed routes.
const isLocalized = /^\/(en|ru)(\/|$)/.test(Astro.url.pathname);
const enUrl = isLocalized ? new URL(swapLocale(Astro.url.pathname, "en"), site) : null;
const ruUrl = isLocalized ? new URL(swapLocale(Astro.url.pathname, "ru"), site) : null;
---
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical.href} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={t("site.title", lang)} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content={lang === "ru" ? "ru_RU" : "en_US"} />

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />

{enUrl && <link rel="alternate" hreflang="en" href={enUrl.href} />}
{ruUrl && <link rel="alternate" hreflang="ru" href={ruUrl.href} />}
{enUrl && <link rel="alternate" hreflang="x-default" href={enUrl.href} />}
