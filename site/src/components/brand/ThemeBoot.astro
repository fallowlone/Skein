---
// Boots theme + density attributes BEFORE first paint to avoid flash.
// Reads localStorage keys `awesome.theme` (light|dark) and
// `awesome.density` (compact|regular|spacious). Falls back to system pref
// for theme, "regular" for density.
---
<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem("awesome.theme");
      var theme;
      if (stored === "light" || stored === "dark") {
        theme = stored;
      } else {
        theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.setAttribute("data-theme", theme);
      var density = localStorage.getItem("awesome.density");
      if (density !== "compact" && density !== "regular" && density !== "spacious") density = "regular";
      document.documentElement.setAttribute("data-density", density);
    } catch (e) {
      document.documentElement.setAttribute("data-theme", "light");
      document.documentElement.setAttribute("data-density", "regular");
    }
  })();
</script>
