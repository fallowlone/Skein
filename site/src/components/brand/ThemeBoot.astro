---
// Boots theme + density attributes BEFORE first paint to avoid flash.
// Reads localStorage keys `skein.theme` (light|dark) and
// `skein.density` (compact|regular|spacious). Falls back to system pref
// for theme, "regular" for density.
---
<script is:inline>
  (function () {
    try {
      // One-time migration: rename legacy `awesome.*` keys to `skein.*` so
      // returning visitors keep their progress. Runs before any key is read.
      for (var i = localStorage.length - 1; i >= 0; i--) {
        var legacy = localStorage.key(i);
        if (legacy && legacy.indexOf("awesome.") === 0) {
          var renamed = "skein." + legacy.slice(8);
          if (localStorage.getItem(renamed) === null) {
            localStorage.setItem(renamed, localStorage.getItem(legacy));
          }
          localStorage.removeItem(legacy);
        }
      }
      var stored = localStorage.getItem("skein.theme");
      var theme;
      if (stored === "light" || stored === "dark") {
        theme = stored;
      } else {
        theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.setAttribute("data-theme", theme);
      var density = localStorage.getItem("skein.density");
      if (density !== "compact" && density !== "regular" && density !== "spacious") density = "regular";
      document.documentElement.setAttribute("data-density", density);
    } catch (e) {
      document.documentElement.setAttribute("data-theme", "light");
      document.documentElement.setAttribute("data-density", "regular");
    }
  })();
</script>
