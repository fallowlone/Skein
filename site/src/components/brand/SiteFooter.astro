---
import { t, type Locale } from "../../i18n";
import SkeinMark from "./SkeinMark.astro";
type Props = { lang: Locale };
const { lang } = Astro.props;
---
<footer class="pf max-w-[1200px] mx-auto px-4 lg:px-8">
  <SkeinMark cls="pf-logo" />
  <span class="pf-mark" aria-hidden="true">Skein®</span>
  <nav class="pf-nav" aria-label={t("a11y.nav.footer", lang)}>
    <a href={`/${lang}/terms`}>{t("terms.footer", lang)}</a>
    <a href={`/${lang}/glossary/`}>{t("nav.glossary", lang)}</a>
  </nav>
</footer>

<style>
  .pf { border-top: 1px solid var(--rule-strong); margin-top: 48px; padding: 22px 0 44px; }
  .pf-logo { height: 40px; width: auto; max-width: 100%; color: var(--ink); margin-bottom: 14px; }
  .pf-mark {
    display: block; text-decoration: none;
    font-family: var(--font-poster); font-weight: 600;
    font-size: clamp(56px, 8vw, 128px); line-height: 0.9;
    text-transform: uppercase; letter-spacing: 0.01em;
    color: transparent; -webkit-text-stroke: 1.5px var(--muted);
  }
  .pf-mark:hover { color: var(--poster-accent); -webkit-text-stroke-color: var(--poster-accent); }
  .pf-nav { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 16px; }
  .pf-nav a {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted); text-decoration: none;
  }
  .pf-nav a:hover { color: var(--poster-accent); }
</style>
