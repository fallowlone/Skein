---
type Props = { readingMin: number };
const { readingMin } = Astro.props;
---
<div
  data-reading-progress
  data-reading-min={readingMin}
  class="sticky top-[37px] z-20 h-[2px] bg-rule"
  aria-hidden="true"
>
  <div
    data-reading-fill
    class="h-full bg-ink origin-left"
    style="transform: scaleX(0); transform-origin: left center; transition: transform 60ms linear;"
  ></div>
</div>
<div
  data-reading-meta
  class="hidden md:block fixed bottom-3 left-4 z-30 font-mono text-[10.5px] text-muted bg-card border border-rule px-2 py-1 pointer-events-none rounded-[1px]"
  style="opacity: 0; transition: opacity .15s;"
>
  <span data-reading-pct>0%</span>
  <span class="opacity-50 px-1">·</span>
  <span data-reading-remaining>~{readingMin}m</span>
</div>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>("[data-reading-progress]");
    if (!root) return;
    const fill = root.querySelector<HTMLElement>("[data-reading-fill]");
    const meta = document.querySelector<HTMLElement>("[data-reading-meta]");
    const pctEl = meta?.querySelector<HTMLElement>("[data-reading-pct]");
    const remEl = meta?.querySelector<HTMLElement>("[data-reading-remaining]");
    const total = parseFloat(root.dataset.readingMin ?? "10");
    if (!fill) return;

    let scheduled = false;
    function tick() {
      scheduled = false;
      const doc = document.documentElement;
      const scrollTop = window.scrollY || doc.scrollTop;
      const max = doc.scrollHeight - window.innerHeight;
      const pct = max > 0 ? Math.min(1, Math.max(0, scrollTop / max)) : 0;
      fill!.style.transform = `scaleX(${pct})`;
      if (meta && pctEl && remEl) {
        meta.style.opacity = pct > 0.02 && pct < 0.98 ? "1" : "0";
        pctEl.textContent = `${Math.round(pct * 100)}%`;
        const remaining = Math.max(0, Math.round(total * (1 - pct)));
        remEl.textContent = `~${remaining}m`;
      }
    }
    function onScroll() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(tick);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    tick();
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
