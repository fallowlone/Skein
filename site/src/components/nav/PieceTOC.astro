---
import { type Locale } from "../../i18n";

type DepthIds = {
  mechanism: string;
  tradeoff: string;
  failure_mode: string;
  numbers: string;
};

type Props = {
  lang: Locale;
  depth?: DepthIds;
};

const { lang, depth } = Astro.props;

const depthLabels = {
  en: {
    mechanism: "Mechanism",
    tradeoff: "Tradeoff",
    failure: "Failure mode",
    numbers: "Numbers",
    onPage: "On this page",
  },
  ru: {
    mechanism: "Механика",
    tradeoff: "Trade-off",
    failure: "Режим отказа",
    numbers: "Числа",
    onPage: "На этой странице",
  },
}[lang];

const depthEntries = depth
  ? [
      { key: "mechanism" as const, id: depth.mechanism, label: depthLabels.mechanism, icon: "M3 5h18M3 12h18M3 19h12" },
      { key: "tradeoff" as const, id: depth.tradeoff, label: depthLabels.tradeoff, icon: "M3 12l4-4 4 4 4-4 4 4" },
      { key: "failure" as const, id: depth.failure_mode, label: depthLabels.failure, icon: "M12 2L2 22h20L12 2zM12 10v6M12 19v.01" },
      { key: "numbers" as const, id: depth.numbers, label: depthLabels.numbers, icon: "M4 6h16M4 12h16M4 18h10" },
    ]
  : [];
---
<aside data-piece-toc class="text-[12.5px]">
  {depthEntries.length > 0 && (
    <section class="mb-5">
      <div class="meta mb-2">depth · checkpoints</div>
      <ul class="list-none m-0 p-0 space-y-1">
        {depthEntries.map((d) => (
          <li>
            <a
              href={`#${d.id}`}
              data-toc-link
              data-toc-target={d.id}
              class="flex items-center gap-2 px-2 py-1.5 hover:bg-card-2 transition-colors rounded-[1px]"
            >
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-muted shrink-0">
                <path d={d.icon}/>
              </svg>
              <span class="text-ink-2 truncate">{d.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section>
    <div class="meta mb-2">{depthLabels.onPage}</div>
    <ol data-toc-list class="list-none m-0 p-0 space-y-1">
      <!-- populated by script -->
    </ol>
  </section>
</aside>

<script>
  function init() {
    const tocRoot = document.querySelector<HTMLElement>("[data-piece-toc]");
    const list = tocRoot?.querySelector<HTMLOListElement>("[data-toc-list]");
    if (!tocRoot || !list) return;

    const article = document.querySelector<HTMLElement>("article");
    if (!article) return;

    const headings = Array.from(article.querySelectorAll<HTMLHeadingElement>("h2"));
    headings.forEach((h, i) => {
      if (!h.id) h.id = `h${i + 1}-${(h.textContent ?? "").toLowerCase().replace(/[^\w]+/g, "-").slice(0, 40)}`;
    });

    if (headings.length === 0) {
      list.parentElement?.setAttribute("hidden", "true");
      return;
    }

    for (const h of headings) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `#${h.id}`;
      a.dataset.tocLink = "";
      a.dataset.tocTarget = h.id;
      a.className =
        "block px-2 py-1.5 text-ink-2 hover:bg-card-2 transition-colors rounded-[1px] truncate";
      a.textContent = h.textContent ?? "";
      li.appendChild(a);
      list.appendChild(li);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tocRoot.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach((link) => {
              link.classList.toggle(
                "bg-card-2",
                link.dataset.tocTarget === entry.target.id,
              );
              link.classList.toggle(
                "font-semibold",
                link.dataset.tocTarget === entry.target.id,
              );
            });
          }
        });
      },
      { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
    );
    headings.forEach((h) => observer.observe(h));

    // Also observe the depth-anchor targets if they exist
    tocRoot.querySelectorAll<HTMLAnchorElement>("[data-toc-target]").forEach((a) => {
      const id = a.dataset.tocTarget!;
      const target = document.getElementById(id);
      if (target && !headings.includes(target as HTMLHeadingElement)) {
        observer.observe(target);
      }
    });
  }

  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
