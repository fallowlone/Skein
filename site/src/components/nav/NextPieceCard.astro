---
import { getCollection, getEntry } from "astro:content";
import { type Locale } from "../../i18n";

type Props = {
  lang: Locale;
  pillarSlug: string;
  chapterSlug: string;
  currentPiece: string;
};

const { lang, pillarSlug, chapterSlug, currentPiece } = Astro.props;

const chapter = await getEntry("chapters", chapterSlug);
if (!chapter) return Astro.response;

const slugs = chapter.data.pieces;
const idx = slugs.indexOf(currentPiece);

let nextSlug: string | null = null;
let nextPillarSlug = pillarSlug;
let nextChapterTitle = "";
let nextPillarColor: "lilac" | "mint" | "peach" | "sky" | "rose" = "lilac";

if (idx >= 0 && idx < slugs.length - 1) {
  nextSlug = slugs[idx + 1];
  const pillar = await getEntry("pillars", pillarSlug);
  nextPillarColor = (pillar?.data.color ?? "lilac") as typeof nextPillarColor;
  nextChapterTitle = chapter.data.title[lang];
} else {
  const chapters = (await getCollection("chapters")).sort((a, b) => a.data.order - b.data.order);
  const here = chapters.findIndex((c) => c.data.slug === chapterSlug);
  const nextChapter = here >= 0 && here < chapters.length - 1 ? chapters[here + 1] : null;
  if (nextChapter) {
    nextSlug = nextChapter.data.pieces[0] ?? null;
    nextPillarSlug = nextChapter.data.pillar;
    nextChapterTitle = nextChapter.data.title[lang];
    const pillar = await getEntry("pillars", nextPillarSlug);
    nextPillarColor = (pillar?.data.color ?? "lilac") as typeof nextPillarColor;
  }
}

let nextTitle = "";
let nextSummary = "";
let nextReadingMin = 0;
let nextOrder = 1;
if (nextSlug) {
  const all = await getCollection(
    "book",
    (e) => e.data.lang === lang && e.data.slug === nextSlug,
  );
  const entry = all[0];
  if (entry) {
    nextTitle = entry.data.title;
    nextSummary = entry.data.summary;
    nextReadingMin = entry.data.readingMin;
    nextOrder = entry.data.order;
  }
}

const pillarColorVar: Record<string, string> = {
  lilac: "var(--p-lilac)",
  mint:  "var(--p-mint)",
  peach: "var(--p-peach)",
  sky:   "var(--p-sky)",
  rose:  "var(--p-rose)",
};

const labels = {
  en: { kicker: "Next up", open: "Open", min: "min" },
  ru: { kicker: "Дальше", open: "Открыть", min: "мин" },
}[lang];
---
{nextSlug && (
  <aside class="my-12">
    <a
      href={`/${lang}/${nextPillarSlug}/${nextSlug}/`}
      class="block relative bg-card border border-rule-strong rounded-[2px] hover:bg-card-2 transition-colors"
    >
      <span class="absolute left-0 top-0 bottom-0 w-[3px]" style={`background:${pillarColorVar[nextPillarColor]};`}></span>
      <div class="p-6 pl-8 flex flex-col md:flex-row md:items-center gap-5">
        <div class="flex-1 min-w-0">
          <div class="meta mb-2">
            <span>{labels.kicker}</span>
            <span class="opacity-50 px-1">·</span>
            <span>{nextPillarSlug} / {nextChapterTitle}</span>
          </div>
          <h3 class="font-display text-[22px] font-bold leading-tight tracking-[-0.015em] m-0 text-ink">
            <span class="text-muted font-mono text-[14px] mr-2">{String(nextOrder).padStart(2, "0")}</span>
            {nextTitle}
          </h3>
          <p class="text-[14px] text-ink-2 leading-relaxed mt-2 mb-0 max-w-[640px]">{nextSummary}</p>
          <div class="font-mono text-[10.5px] text-muted mt-3">
            ~{nextReadingMin} {labels.min}
          </div>
        </div>
        <div class="shrink-0 flex items-center gap-2 text-ink">
          <span class="font-mono text-[12px] uppercase tracking-wider">{labels.open}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </div>
      </div>
    </a>
  </aside>
)}
