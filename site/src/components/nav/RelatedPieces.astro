---
import { getCollection } from "astro:content";
import { type Locale } from "../../i18n";

type Props = {
  lang: Locale;
  pillarSlug: string;
  currentPiece: string;
  spiral: string[];
};

const { lang, pillarSlug, currentPiece, spiral } = Astro.props;

if (!spiral || spiral.length === 0) return Astro.response;

const pillars = await getCollection("pillars");
const pillarColorBySlug: Record<string, "lilac" | "mint" | "peach" | "sky" | "rose"> = {};
for (const p of pillars) {
  pillarColorBySlug[p.data.slug] = p.data.color as typeof pillarColorBySlug[string];
}

const all = await getCollection(
  "book",
  (e) =>
    e.data.lang === lang &&
    e.data.slug !== currentPiece &&
    e.data.status === "ready",
);

type Candidate = {
  slug: string;
  pillar: string;
  pillarColor: keyof typeof pillarColorBySlug;
  title: string;
  summary: string;
  threads: string[];
  overlap: number;
};

const candidates: Candidate[] = all
  .map((e) => {
    const threads = (e.data.spiral ?? []) as string[];
    const overlap = threads.filter((t) => spiral.includes(t)).length;
    return {
      slug: e.data.slug,
      pillar: e.data.pillar,
      pillarColor: (pillarColorBySlug[e.data.pillar] ?? "lilac") as keyof typeof pillarColorBySlug,
      title: e.data.title,
      summary: e.data.summary,
      threads,
      overlap,
    };
  })
  .filter((c) => c.overlap > 0 && c.pillar !== pillarSlug)
  .sort((a, b) => b.overlap - a.overlap)
  .slice(0, 3);

if (candidates.length === 0) {
  const sameThread = all
    .filter((e) => (e.data.spiral ?? []).some((t: string) => spiral.includes(t)))
    .slice(0, 3)
    .map<Candidate>((e) => ({
      slug: e.data.slug,
      pillar: e.data.pillar,
      pillarColor: (pillarColorBySlug[e.data.pillar] ?? "lilac") as keyof typeof pillarColorBySlug,
      title: e.data.title,
      summary: e.data.summary,
      threads: (e.data.spiral ?? []) as string[],
      overlap: 1,
    }));
  candidates.push(...sameThread);
}

const pillarColorVar: Record<string, string> = {
  lilac: "var(--p-lilac)",
  mint:  "var(--p-mint)",
  peach: "var(--p-peach)",
  sky:   "var(--p-sky)",
  rose:  "var(--p-rose)",
};

const heading = lang === "en" ? "By thread" : "По нити";
---
{candidates.length > 0 && (
  <section class="my-12">
    <div class="meta mb-3">related · spiral threads</div>
    <h3 class="font-display text-[18px] font-bold m-0 mb-4 text-ink">{heading}</h3>
    <ul class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {candidates.map((c) => {
        const shared = c.threads.filter((t) => spiral.includes(t));
        return (
          <li>
            <a
              href={`/${lang}/${c.pillar}/${c.slug}/`}
              class="block relative bg-card border border-rule-strong p-4 pl-5 hover:bg-card-2 transition-colors rounded-[2px] h-full"
            >
              <span class="absolute left-0 top-0 bottom-0 w-[2px]" style={`background:${pillarColorVar[c.pillarColor]};`}></span>
              <div class="meta mb-1">
                <span>{c.pillar}</span>
                {shared[0] && (
                  <>
                    <span class="opacity-50 px-1">·</span>
                    <span>↻ {shared[0]}</span>
                  </>
                )}
              </div>
              <div class="font-display text-[14.5px] font-semibold leading-snug text-ink mb-1.5" style="text-wrap: pretty;">
                {c.title}
              </div>
              <p class="text-[12px] text-muted leading-relaxed m-0 line-clamp-3">{c.summary}</p>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}
