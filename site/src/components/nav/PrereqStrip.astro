---
import { getCollection } from "astro:content";
import { type Locale } from "../../i18n";

type Props = {
  lang: Locale;
  pillarSlug: string;
  prereqs: string[];
};

const { lang, pillarSlug, prereqs } = Astro.props;

const allPieces = await getCollection("book", (e) => e.data.lang === lang);
const titleBySlug = new Map(allPieces.map((p) => [p.data.slug, p.data.title]));

const items = prereqs.map((slug) => ({
  slug,
  title: titleBySlug.get(slug) ?? slug,
}));

if (items.length === 0) return Astro.response;

const label = lang === "en" ? "Requires" : "Требует";
---
<nav aria-label={label} class="my-6">
  <div class="meta mb-2">{label}</div>
  <ul class="list-none m-0 p-0 flex flex-wrap gap-1.5" data-prereq-strip>
    {items.map((it) => (
      <li>
        <a
          href={`/${lang}/${pillarSlug}/${it.slug}/`}
          data-prereq-slug={it.slug}
          class="chip"
          data-visited="false"
        >
          <span data-prereq-state aria-hidden="true">○</span>
          <span class="font-mono text-[10.5px] text-muted">{it.slug.slice(0, 2)}</span>
          <span class="truncate max-w-[180px]">{it.title}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const KEY = "awesome.user-state.v1";
  function init() {
    let history: Record<string, unknown> = {};
    try {
      const raw = localStorage.getItem(KEY);
      if (raw) history = (JSON.parse(raw)?.history as Record<string, unknown>) ?? {};
    } catch {
      return;
    }
    document.querySelectorAll<HTMLElement>("[data-prereq-slug]").forEach((el) => {
      const slug = el.dataset.prereqSlug!;
      const visited = !!history[slug];
      el.dataset.visited = visited ? "true" : "false";
      const state = el.querySelector<HTMLElement>("[data-prereq-state]");
      if (state) state.textContent = visited ? "✓" : "○";
      if (visited) el.classList.add("text-ink");
    });
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
