---
import { type Locale } from "../../i18n";

type Adjacent = { slug: string; title: string } | null;

type Props = {
  lang: Locale;
  pillarSlug: string;
  pillarTitle: string;
  pillarColor: "lilac" | "mint" | "peach" | "sky" | "rose";
  chapterTitle: string;
  pieceOrder: number;
  pieceTitle: string;
  prev: Adjacent;
  next: Adjacent;
};

const {
  lang,
  pillarSlug,
  pillarTitle,
  pillarColor,
  chapterTitle,
  pieceOrder,
  pieceTitle,
  prev,
  next,
} = Astro.props;

const pillarColorVar: Record<string, string> = {
  lilac: "var(--p-lilac)",
  mint:  "var(--p-mint)",
  peach: "var(--p-peach)",
  sky:   "var(--p-sky)",
  rose:  "var(--p-rose)",
};

const tierLabels = {
  en: { jr: "jr", mid: "mid", sr: "sr" },
  ru: { jr: "jr", mid: "mid", sr: "sr" },
};
const labels = tierLabels[lang];
---
<header
  id="piece-header"
  data-piece-header
  class="sticky top-0 z-30 bg-paper/95 backdrop-blur-sm border-b border-rule"
>
  <div class="flex items-center gap-3 px-3 py-2 max-w-[1200px] mx-auto">
    <span
      class="pill-dot shrink-0"
      style={`background:${pillarColorVar[pillarColor] ?? "var(--rule-strong)"};`}
    ></span>
    <nav
      aria-label="breadcrumb"
      class="font-mono text-[11px] text-muted flex items-center gap-1.5 min-w-0 overflow-hidden"
    >
      <a class="hover:text-ink" href={`/${lang}/`}>{lang === "en" ? "home" : "главная"}</a>
      <span class="opacity-50">/</span>
      <a class="hover:text-ink truncate" href={`/${lang}/${pillarSlug}/`}>{pillarTitle}</a>
      <span class="opacity-50">/</span>
      <span class="truncate hidden md:inline">{chapterTitle}</span>
      <span class="opacity-50 hidden md:inline">/</span>
      <span class="text-ink-2 truncate">
        {String(pieceOrder).padStart(2, "0")} — {pieceTitle}
      </span>
    </nav>

    <span class="flex-1" aria-hidden="true"></span>

    <div class="tier-seg shrink-0 hidden sm:inline-flex" data-tier-segment>
      <span class="tier-thumb" aria-hidden="true"></span>
      <button type="button" data-tier="junior" data-active="false">{labels.jr}</button>
      <button type="button" data-tier="middle" data-active="true">{labels.mid}</button>
      <button type="button" data-tier="senior" data-active="false">{labels.sr}</button>
    </div>

    <div class="flex items-center gap-1 shrink-0">
      {prev ? (
        <a
          class="btn ghost px-2 py-1.5"
          style="font-size: 11px;"
          href={`/${lang}/${pillarSlug}/${prev.slug}/`}
          title={prev.title}
          aria-label={lang === "en" ? "previous piece" : "предыдущая пьеса"}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </a>
      ) : (
        <span class="btn ghost opacity-30 px-2 py-1.5 pointer-events-none" aria-hidden="true" style="font-size: 11px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </span>
      )}
      {next ? (
        <a
          class="btn ghost px-2 py-1.5"
          style="font-size: 11px;"
          href={`/${lang}/${pillarSlug}/${next.slug}/`}
          title={next.title}
          aria-label={lang === "en" ? "next piece" : "следующая пьеса"}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      ) : (
        <span class="btn ghost opacity-30 px-2 py-1.5 pointer-events-none" aria-hidden="true" style="font-size: 11px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </span>
      )}
    </div>
  </div>
</header>

<script>
  const KEY = "awesome.user-state.v1";

  function readTier(): "junior" | "middle" | "senior" {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return "middle";
      const parsed = JSON.parse(raw);
      const t = parsed?.tier;
      if (t === "junior" || t === "middle" || t === "senior") return t;
      return "middle";
    } catch {
      return "middle";
    }
  }

  function writeTier(tier: "junior" | "middle" | "senior") {
    try {
      const raw = localStorage.getItem(KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      parsed.tier = tier;
      parsed.manualTierFlips = (parsed.manualTierFlips ?? 0) + 1;
      localStorage.setItem(KEY, JSON.stringify(parsed));
    } catch {}
  }

  function applyActive(seg: HTMLElement, tier: string) {
    const buttons = Array.from(seg.querySelectorAll<HTMLButtonElement>("button[data-tier]"));
    const thumb = seg.querySelector<HTMLElement>(".tier-thumb");
    buttons.forEach((b) => {
      const active = b.dataset.tier === tier;
      b.dataset.active = active ? "true" : "false";
      if (active && thumb) {
        thumb.style.transform = `translateX(${b.offsetLeft}px)`;
        thumb.style.width = `${b.offsetWidth}px`;
      }
    });
  }

  function initSegment(seg: HTMLElement) {
    const tier = readTier();
    applyActive(seg, tier);
    seg.querySelectorAll<HTMLButtonElement>("button[data-tier]").forEach((b) => {
      b.addEventListener("click", () => {
        const t = b.dataset.tier as "junior" | "middle" | "senior";
        writeTier(t);
        applyActive(seg, t);
        document.dispatchEvent(new CustomEvent("tier-change", { detail: { tier: t } }));
      });
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-tier-segment]").forEach(initSegment);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
