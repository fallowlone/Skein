---
import { getCollection } from "astro:content";
import ProgressMeter from "../pedagogy/ProgressMeter.tsx";
import { type Locale, t } from "../../i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

const pillars = (await getCollection("pillars")).sort((a, b) => a.data.order - b.data.order);
const chapters = await getCollection("chapters");
const chapterByPillar = new Map(chapters.map((c) => [c.data.pillar, c.data]));

const pillarColor: Record<string, string> = {
  lilac: "var(--p-lilac)",
  mint:  "var(--p-mint)",
  peach: "var(--p-peach)",
  sky:   "var(--p-sky)",
  rose:  "var(--p-rose)",
};

const heading = lang === "en" ? "16 pillars" : "16 столпов";
const headingEm = lang === "en" ? "the map" : "карта";
const piecesLabel = lang === "en" ? "pieces" : "пьес";
const notStarted = lang === "en" ? "not started" : "не начат";
---
<section id="pillar-map" class="py-10">
  <header class="flex items-baseline justify-between mb-6">
    <h2 class="font-display text-[clamp(24px,3.5vw,30px)] font-bold tracking-[-0.015em] m-0">
      {heading} <em class="font-display italic font-normal text-muted">· {headingEm}</em>
    </h2>
    <span class="meta">{pillars.length} · {lang === "en" ? "ordered by role" : "по роли"}</span>
  </header>

  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    {
      pillars.map((p) => {
        const ch = chapterByPillar.get(p.data.slug);
        const pieces = ch?.pieces ?? [];
        const accent = pillarColor[p.data.color] ?? "var(--rule)";
        return (
          <li class="pillar-card-li flex">
            <a
              class="pillar-card group relative bg-card p-4 pl-5 min-h-[130px] w-full flex flex-col rounded-[2px] border border-rule-strong overflow-hidden"
              href={`/${lang}/${p.data.slug}/`}
              style={`--pillar-accent:${accent};`}
            >
              <span class="absolute left-0 top-0 bottom-0 w-[2px] transition-[width] duration-200 group-hover:w-[4px]" style={`background:${accent};`}></span>
              <div class="flex justify-between items-start mb-2">
                <span class="font-mono text-[11px] tabular-nums tracking-[0.05em] text-muted">{String(p.data.order).padStart(2, "0")}</span>
                <ProgressMeter client:visible slugs={pieces} variant="ring" size={26} />
              </div>
              <h3 class="font-display text-[15.5px] font-semibold leading-[1.2] tracking-[-0.005em] mt-0 mb-1 text-ink transition-transform duration-200 group-hover:translate-x-[2px]" style="text-wrap: pretty;">
                {p.data.title[lang]}
              </h3>
              <p class="text-[11.5px] text-muted leading-[1.4] flex-1">{p.data.blurb[lang]}</p>
              <div class="flex items-center justify-between mt-3">
                <span class="font-mono text-[10.5px] text-muted group-hover:text-ink transition-colors">
                  {pieces.length} {piecesLabel} <span class="inline-block transition-transform duration-200 group-hover:translate-x-[3px]">→</span>
                </span>
                <span class="font-mono text-[10.5px] text-muted-2">○ {notStarted}</span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .pillar-card-li { list-style: none; }
  .pillar-card {
    text-decoration: none;
    color: inherit;
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease, background 200ms ease;
    will-change: transform;
  }
  .pillar-card:hover {
    transform: translateY(-2px);
    border-color: var(--pillar-accent, var(--rule-strong));
    box-shadow: 0 6px 18px -8px var(--pillar-accent, rgba(0,0,0,0.2));
    background: var(--card-2);
  }
  .pillar-card:focus-visible {
    outline: 2px solid var(--pillar-accent, var(--accent));
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .pillar-card,
    .pillar-card * { transition: none !important; }
    .pillar-card:hover { transform: none; }
  }
</style>
