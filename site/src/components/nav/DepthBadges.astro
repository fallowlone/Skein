---
import { type Locale } from "../../i18n";

type Depth = {
  mechanism: string;
  tradeoff: string;
  failure_mode: string;
  numbers: string;
};

type Props = { lang: Locale; depth: Depth };
const { lang, depth } = Astro.props;

const labels = {
  en: { mechanism: "Mechanism", tradeoff: "Tradeoff", failure: "Failure mode", numbers: "Numbers", title: "depth checkpoints" },
  ru: { mechanism: "Механика", tradeoff: "Trade-off", failure: "Режим отказа", numbers: "Числа", title: "depth · контрольные точки" },
}[lang];

const items = [
  { id: depth.mechanism, label: labels.mechanism, color: "var(--p-sky)",   icon: "M3 5h18M3 12h18M3 19h12" },
  { id: depth.tradeoff,  label: labels.tradeoff,  color: "var(--p-peach)", icon: "M3 12l4-4 4 4 4-4 4 4" },
  { id: depth.failure_mode, label: labels.failure, color: "var(--danger)", icon: "M12 2L2 22h20L12 2zM12 10v6M12 19v.01" },
  { id: depth.numbers,   label: labels.numbers,   color: "var(--p-mint)",  icon: "M4 6h16M4 12h16M4 18h10" },
];
---
<aside class="my-5">
  <div class="meta mb-2">{labels.title}</div>
  <ul class="list-none m-0 p-0 flex flex-wrap gap-1.5">
    {items.map((it) => (
      <li>
        <a href={`#${it.id}`} class="chip" data-depth-anchor={it.id}>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={it.icon}/>
          </svg>
          <span class="pill-dot" style={`background:${it.color};`}></span>
          <span>{it.label}</span>
        </a>
      </li>
    ))}
  </ul>
</aside>
