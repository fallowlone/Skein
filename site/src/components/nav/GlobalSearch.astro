---
import { t, type Locale } from "../../i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

// The lesson index is no longer inlined here. It is fetched on demand from
// /<lang>/search-index.json the first time the user opens search — see the
// client script below. This keeps ~208 KiB out of every page's HTML.

const labels = {
  en: { open: "Search", placeholder: "Search lessons…", empty: "Type to search", noMatch: "No matches", field: "Search lessons" },
  ru: { open: "Поиск", placeholder: "Поиск по урокам…", empty: "Введите запрос", noMatch: "Ничего не найдено", field: "Поиск по урокам" },
}[lang];
---
<button
  type="button"
  data-search-open
  data-search-lang={lang}
  class="icon-btn"
  aria-label={labels.open}
  title={labels.open}
>
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"/>
    <path d="M21 21l-4.35-4.35"/>
  </svg>
  <span class="gs-trigger-label">{labels.open}</span>
  <span class="kbd gs-trigger-kbd" aria-hidden="true">⌘K</span>
</button>

<!--
  Right-side search drawer. ALL critical layout (overlay, panel position,
  slide, list reset) lives in the scoped <style> below — never on purge-prone
  arbitrary Tailwind utilities — so the overlay can never render unstyled.
-->
<div data-search-modal class="gs-overlay" role="dialog" aria-modal="true" aria-label={labels.open} aria-hidden="true">
  <aside class="gs-panel">
    <header class="gs-head">
      <svg class="gs-ico" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      <input
        data-search-input
        type="text"
        autocomplete="off"
        spellcheck="false"
        class="gs-input"
        placeholder={labels.placeholder}
        aria-label={labels.field}
      />
      <span class="kbd gs-esc">esc</span>
    </header>
    <ol
      data-search-results
      class="gs-list"
      data-empty-label={labels.empty}
      data-no-match-label={labels.noMatch}
      data-group-lessons-label={t("search.group.lessons", lang)}
      data-group-intext-label={t("search.group.inText", lang)}
      data-deep-searching-label={t("search.deep.searching", lang)}
    >
      <li class="gs-msg" data-search-empty>{labels.empty}</li>
    </ol>
  </aside>
</div>

<style>
  .gs-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--ink, #1a1a1a) 32%, transparent);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 180ms ease, visibility 0s linear 180ms;
  }
  .gs-overlay.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 180ms ease;
  }
  .gs-panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(92vw, 420px);
    display: flex;
    flex-direction: column;
    background: var(--card, #fbf7eb);
    border-left: 1px solid var(--rule-strong, rgba(0,0,0,0.18));
    box-shadow: -12px 0 40px -16px rgba(0, 0, 0, 0.35);
    transform: translateX(100%);
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .gs-overlay.open .gs-panel { transform: translateX(0); }
  .gs-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--rule, rgba(0,0,0,0.1));
  }
  .gs-ico { color: var(--muted, #6b6b6b); flex-shrink: 0; }
  .gs-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    font-family: var(--font-body, system-ui);
    font-size: 14px;
    color: var(--ink, #1a1a1a);
  }
  .gs-input::placeholder { color: var(--muted, #6b6b6b); }
  .gs-esc { flex-shrink: 0; }
  .gs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex: 1;
  }
  .gs-msg {
    padding: 28px 16px;
    text-align: center;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    color: var(--muted, #6b6b6b);
  }
  @media (prefers-reduced-motion: reduce) {
    .gs-overlay, .gs-panel { transition: none; }
  }
</style>

<script>
  import { createStalenessGuard, shouldScheduleDeep, isDeepResponseCurrent } from "../../scripts/search-staleness";

  type Hit = {
    slug: string;
    pillar: string;
    pillarColor: string;
    title: string;
    href: string;
    score: number;
  };

  interface DeepHit { slug: string; track: string; unit: string; title: string; href: string; snippet: string; }

  // Lazily fetched per-locale lesson index. Loaded once, on first search open,
  // from the static /<lang>/search-index.json asset — never inlined into HTML.
  let cachedIndex: Hit[] | null = null;
  let indexPromise: Promise<Hit[]> | null = null;
  function loadIndex(lang: string): Promise<Hit[]> {
    if (cachedIndex) return Promise.resolve(cachedIndex);
    if (!indexPromise) {
      indexPromise = fetch(`/${lang}/search-index.json`)
        .then((r) => (r.ok ? r.json() : []))
        .then((data: Hit[]) => { cachedIndex = data; return data; })
        .catch(() => { indexPromise = null; return []; });
    }
    return indexPromise;
  }

  const PILLAR_VAR: Record<string, string> = {
    lilac: "var(--p-lilac)",
    mint:  "var(--p-mint)",
    peach: "var(--p-peach)",
    sky:   "var(--p-sky)",
    rose:  "var(--p-rose)",
  };

  function score(item: { title: string; pillar: string; slug: string }, q: string): number {
    if (!q) return 0;
    const t = item.title.toLowerCase();
    const p = item.pillar.toLowerCase();
    const slug = item.slug.toLowerCase();
    let score = 0;
    if (t.includes(q)) score += 10;
    if (slug.includes(q)) score += 6;
    if (p.includes(q)) score += 4;
    return score;
  }

  /**
   * Build a result row as DOM nodes. Never innerHTML: Task 7 feeds server
   * snippets through `extra`, and lesson bodies are the source of that text.
   */
  function renderHit(o: {
    href: string; pillarColor: string; meta: string; title: string;
    extra?: Node;
  }): HTMLLIElement {
    const li = document.createElement("li");
    const a = document.createElement("a");
    a.href = o.href;
    a.className = "block px-4 py-3 hover:bg-card-2 border-b border-rule flex items-start gap-3";
    const dot = document.createElement("span");
    dot.className = "pill-dot mt-1.5";
    dot.style.background = PILLAR_VAR[o.pillarColor] ?? "var(--rule-strong)";
    const col = document.createElement("span");
    col.className = "flex-1 min-w-0";
    const meta = document.createElement("span");
    meta.className = "font-mono text-[10.5px] text-muted block";
    meta.textContent = o.meta;
    const title = document.createElement("span");
    title.className = "font-display text-[14px] font-semibold text-ink block truncate";
    title.textContent = o.title;
    col.append(meta, title);
    if (o.extra) col.appendChild(o.extra);
    a.append(dot, col);
    li.appendChild(a);
    return li;
  }

  function groupHeading(text: string): HTMLLIElement {
    const li = document.createElement("li");
    li.className = "px-4 pt-3 pb-1 font-mono text-[10px] uppercase tracking-wider text-muted";
    li.textContent = text;
    return li;
  }

  /**
   * ts_headline returns text with <mark> delimiters. Parse it into text nodes
   * and <mark> elements by hand — this string originates in lesson bodies and
   * must never be assigned to innerHTML.
   */
  function snippetNodes(snippet: string): DocumentFragment {
    const frag = document.createDocumentFragment();
    let marked = false;
    for (const part of snippet.split(/(<mark>|<\/mark>)/)) {
      if (part === "<mark>") { marked = true; continue; }
      if (part === "</mark>") { marked = false; continue; }
      if (!part) continue;
      if (marked) {
        const m = document.createElement("mark");
        m.textContent = part;         // textContent, never innerHTML
        frag.appendChild(m);
      } else {
        frag.appendChild(document.createTextNode(part));
      }
    }
    return frag;
  }

  function init() {
    // Multiple triggers can open the one modal (rail tool + drawer top-bar icon),
    // so bind them all — not just the first match.
    const openBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-search-open]"));
    const modal = document.querySelector<HTMLElement>("[data-search-modal]");
    const input = modal?.querySelector<HTMLInputElement>("[data-search-input]");
    const list = modal?.querySelector<HTMLOListElement>("[data-search-results]");
    if (!openBtns.length || !modal || !input || !list) return;

    // Only the rail trigger carries the locale; the bare top-bar icon does not.
    const lang = openBtns.find((b) => b.dataset.searchLang)?.dataset.searchLang ?? "en";
    const emptyLabel = list.dataset.emptyLabel ?? "";
    const noMatchLabel = list.dataset.noMatchLabel ?? "";
    const groupLessonsLabel = list.dataset.groupLessonsLabel ?? "";
    const groupInTextLabel = list.dataset.groupIntextLabel ?? "";
    const deepSearchingLabel = list.dataset.deepSearchingLabel ?? "";

    // Monotonic request id: a slower earlier request must never overwrite the
    // results of a later one the user is actually looking at.
    const deepGuard = createStalenessGuard();
    let deepTimer: number | undefined;

    function scheduleDeep(query: string, deepLang: string, onResults: (hits: DeepHit[]) => void) {
      window.clearTimeout(deepTimer);
      deepTimer = window.setTimeout(() => {
        const seq = deepGuard.start();
        fetch(`/api/search?q=${encodeURIComponent(query)}&lang=${deepLang}`)
          .then((r) => (r.ok ? r.json() : { results: [] }))
          .then((d: { results: DeepHit[] }) => {
            if (!deepGuard.accept(seq)) return;         // superseded — drop it
            if (input!.value.trim().toLowerCase() !== query) return;
            onResults(d.results ?? []);
          })
          .catch(() => {
            // A thrown fetch (offline, DNS failure, aborted connection) must
            // still resolve to an empty result set — not drop silently — or
            // the zero-local-results path is left showing "Searching lesson
            // text…" forever with nothing to clear it. Staleness still
            // governs: a superseded or abandoned request must not touch a
            // newer query's UI.
            if (!isDeepResponseCurrent(deepGuard.accept(seq), input!.value, query)) return;
            onResults([]);
          });
      }, 200);
    }

    // Renders the deep group. Also responsible for clearing whatever
    // placeholder `render()` left in place while this request was in
    // flight — either the "no local matches" empty state (when local did
    // find something and appended nothing else) or the deep-pending row
    // added below for the zero-local-results case.
    function renderDeep(hits: DeepHit[], localHrefs: Set<string>) {
      const pending = list!.querySelector<HTMLLIElement>("[data-deep-pending]");
      if (pending) pending.remove();
      const fresh = hits.filter((h) => !localHrefs.has(h.href));
      if (fresh.length === 0) {
        // Local also found nothing (that's the only way localHrefs is
        // empty here) and now the deep search confirms it too — only now
        // do we genuinely know there are no matches anywhere.
        if (localHrefs.size === 0) {
          const li = document.createElement("li");
          li.className = "px-4 py-6 text-center font-mono text-[11px] text-muted";
          li.textContent = noMatchLabel;
          list!.appendChild(li);
        }
        return;
      }
      // The endpoint returns a track, not a colour. Derive it from the local
      // index so deep rows carry the same track dot as local ones.
      const colorByTrack = new Map<string, string>();
      for (const it of cachedIndex ?? []) {
        if (!colorByTrack.has(it.pillar)) colorByTrack.set(it.pillar, it.pillarColor);
      }
      list!.appendChild(groupHeading(groupInTextLabel));
      for (const h of fresh) {
        const extra = document.createElement("span");
        extra.className = "text-[12px] text-muted block line-clamp-2 mt-1 gs-snippet";
        extra.appendChild(snippetNodes(h.snippet));
        list!.appendChild(renderHit({
          href: h.href, pillarColor: colorByTrack.get(h.track) ?? "lilac",
          meta: `${h.track} / ${h.slug}`, title: h.title, extra,
        }));
      }
    }

    function show(empty = true) {
      modal!.classList.add("open");
      modal!.setAttribute("aria-hidden", "false");
      // Warm the index the moment search opens, so it is ready by first keystroke.
      void loadIndex(lang);
      if (empty) {
        input!.value = "";
        render("");
      }
      setTimeout(() => input!.focus(), 30);
    }
    function hide() {
      modal!.classList.remove("open");
      modal!.setAttribute("aria-hidden", "true");
    }

    function render(q: string) {
      const query = q.trim().toLowerCase();
      list!.innerHTML = "";
      if (!query) {
        const li = document.createElement("li");
        li.className = "px-4 py-6 text-center font-mono text-[11px] text-muted";
        li.textContent = emptyLabel;
        list!.appendChild(li);
        return;
      }
      const index = cachedIndex;
      if (!index) {
        // Index still in flight: show the placeholder and re-render once it lands
        // (only if the query the user is looking at hasn't changed since).
        const li = document.createElement("li");
        li.className = "px-4 py-6 text-center font-mono text-[11px] text-muted";
        li.textContent = emptyLabel;
        list!.appendChild(li);
        void loadIndex(lang).then(() => {
          if (input!.value.trim().toLowerCase() === query) render(input!.value);
        });
        return;
      }
      const scored = index
        .map((it) => ({ ...it, score: score(it, query) }))
        .filter((it) => it.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8);
      if (scored.length === 0) {
        // The local substring index found nothing, but that is exactly the
        // case the deep (Postgres full-text) search exists for — a phrase
        // that lives only in a lesson body, or a Russian query in an
        // inflected form no title contains. Show a pending state instead of
        // claiming "no matches" and still ask the server.
        const li = document.createElement("li");
        li.className = "px-4 py-6 text-center font-mono text-[11px] text-muted";
        li.textContent = deepSearchingLabel;
        li.dataset.deepPending = "1";
        list!.appendChild(li);
        if (shouldScheduleDeep(query, scored.length)) {
          scheduleDeep(query, lang, (hits) => renderDeep(hits, new Set()));
        }
        return;
      }
      list!.appendChild(groupHeading(groupLessonsLabel));
      for (const hit of scored) {
        list!.appendChild(renderHit({
          href: hit.href, pillarColor: hit.pillarColor,
          meta: `${hit.pillar} / ${hit.slug}`, title: hit.title,
        }));
      }

      const localHrefs = new Set(scored.map((h) => h.href));
      if (shouldScheduleDeep(query, scored.length)) {
        scheduleDeep(query, lang, (hits) => renderDeep(hits, localHrefs));
      }
    }

    openBtns.forEach((b) => b.addEventListener("click", () => show()));
    input.addEventListener("input", () => render(input.value));
    modal.addEventListener("click", (e) => {
      if (e.target === modal) hide();
    });

    document.addEventListener("keydown", (e) => {
      const cmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k";
      if (cmdK) {
        e.preventDefault();
        show();
      }
      if (e.key === "Escape" && modal.classList.contains("open")) {
        hide();
      }
    });
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
