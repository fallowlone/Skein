---
import { getCollection } from "astro:content";
import { type Locale } from "../../i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

const tracks = await getCollection("tracks");
const trackColorBySlug: Record<string, string> = {};
for (const tr of tracks) trackColorBySlug[tr.data.slug] = tr.data.color;

const lessons = await getCollection("lessons", (e) => e.data.lang === lang && e.data.status === "ready");
const index = lessons.map((e) => ({
  slug: e.data.slug,
  pillar: e.data.track,
  pillarColor: trackColorBySlug[e.data.track] ?? "lilac",
  title: e.data.title,
  summary: e.data.summary,
  href: `/${lang}/learn/${e.data.track}/${e.data.unit}/${e.data.slug}/`,
}));

const labels = {
  en: { open: "Search", placeholder: "Search lessons…", empty: "Type to search", noMatch: "No matches" },
  ru: { open: "Поиск", placeholder: "Поиск по урокам…", empty: "Введите запрос", noMatch: "Ничего не найдено" },
}[lang];
---
<button
  type="button"
  data-search-open
  class="icon-btn"
  aria-label={labels.open}
  title={labels.open}
>
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"/>
    <path d="M21 21l-4.35-4.35"/>
  </svg>
  <span class="font-mono text-[11px] uppercase tracking-wider hidden md:inline">{labels.open}</span>
  <span class="kbd hidden md:inline-flex ml-1">⌘K</span>
</button>

<div
  data-search-modal
  class="fixed inset-0 z-50 hidden bg-paper/70 backdrop-blur-sm"
  aria-hidden="true"
>
  <div class="absolute left-1/2 top-[12vh] -translate-x-1/2 w-[min(92vw,640px)] bg-card border border-rule-strong rounded-[2px] shadow-soft-md flex flex-col max-h-[76vh]">
    <header class="flex items-center gap-2 px-4 py-3 border-b border-rule">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-muted">
        <circle cx="11" cy="11" r="7"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      <input
        data-search-input
        type="text"
        autocomplete="off"
        spellcheck="false"
        class="flex-1 bg-transparent outline-none font-body text-[14px] text-ink placeholder:text-muted"
        placeholder={labels.placeholder}
      />
      <span class="kbd shrink-0">esc</span>
    </header>
    <ol
      data-search-results
      class="list-none m-0 p-0 overflow-y-auto"
      data-empty-label={labels.empty}
      data-no-match-label={labels.noMatch}
    >
      <li class="px-4 py-6 text-center font-mono text-[11px] text-muted" data-search-empty>{labels.empty}</li>
    </ol>
  </div>
</div>

<script is:inline define:vars={{ index }}>
  window.__searchIndex = index;
</script>

<script>
  type Hit = {
    slug: string;
    pillar: string;
    pillarColor: string;
    title: string;
    summary: string;
    href: string;
    score: number;
  };

  const PILLAR_VAR: Record<string, string> = {
    lilac: "var(--p-lilac)",
    mint:  "var(--p-mint)",
    peach: "var(--p-peach)",
    sky:   "var(--p-sky)",
    rose:  "var(--p-rose)",
  };

  function score(item: { title: string; summary: string; pillar: string; slug: string }, q: string): number {
    if (!q) return 0;
    const t = item.title.toLowerCase();
    const s = item.summary.toLowerCase();
    const p = item.pillar.toLowerCase();
    const slug = item.slug.toLowerCase();
    let score = 0;
    if (t.includes(q)) score += 10;
    if (slug.includes(q)) score += 6;
    if (p.includes(q)) score += 4;
    if (s.includes(q)) score += 2;
    return score;
  }

  function init() {
    const openBtn = document.querySelector<HTMLButtonElement>("[data-search-open]");
    const modal = document.querySelector<HTMLElement>("[data-search-modal]");
    const input = modal?.querySelector<HTMLInputElement>("[data-search-input]");
    const list = modal?.querySelector<HTMLOListElement>("[data-search-results]");
    if (!openBtn || !modal || !input || !list) return;

    const index = ((window as unknown) as { __searchIndex: Hit[] }).__searchIndex ?? [];
    const emptyLabel = list.dataset.emptyLabel ?? "";
    const noMatchLabel = list.dataset.noMatchLabel ?? "";

    function show(empty = true) {
      modal!.classList.remove("hidden");
      modal!.setAttribute("aria-hidden", "false");
      if (empty) {
        input!.value = "";
        render("");
      }
      setTimeout(() => input!.focus(), 30);
    }
    function hide() {
      modal!.classList.add("hidden");
      modal!.setAttribute("aria-hidden", "true");
    }

    function render(q: string) {
      const query = q.trim().toLowerCase();
      list!.innerHTML = "";
      if (!query) {
        const li = document.createElement("li");
        li.className = "px-4 py-6 text-center font-mono text-[11px] text-muted";
        li.textContent = emptyLabel;
        list!.appendChild(li);
        return;
      }
      const scored = index
        .map((it) => ({ ...it, score: score(it, query) }))
        .filter((it) => it.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8);
      if (scored.length === 0) {
        const li = document.createElement("li");
        li.className = "px-4 py-6 text-center font-mono text-[11px] text-muted";
        li.textContent = noMatchLabel;
        list!.appendChild(li);
        return;
      }
      for (const hit of scored) {
        const li = document.createElement("li");
        li.innerHTML = `
          <a href="${hit.href}" class="block px-4 py-3 hover:bg-card-2 border-b border-rule flex items-start gap-3">
            <span class="pill-dot mt-1.5" style="background:${PILLAR_VAR[hit.pillarColor] ?? "var(--rule-strong)"};"></span>
            <span class="flex-1 min-w-0">
              <span class="font-mono text-[10.5px] text-muted block">${hit.pillar} / ${hit.slug}</span>
              <span class="font-display text-[14px] font-semibold text-ink block truncate">${hit.title}</span>
              <span class="text-[12px] text-muted block line-clamp-2 mt-1">${hit.summary}</span>
            </span>
          </a>`;
        list!.appendChild(li);
      }
    }

    openBtn.addEventListener("click", () => show());
    input.addEventListener("input", () => render(input.value));
    modal.addEventListener("click", (e) => {
      if (e.target === modal) hide();
    });

    document.addEventListener("keydown", (e) => {
      const cmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k";
      if (cmdK) {
        e.preventDefault();
        show();
      }
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        hide();
      }
    });
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
