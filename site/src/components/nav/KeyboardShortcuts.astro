---
import { type Locale } from "../../i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

const labels = {
  en: { meta: "shortcuts", search: "search", prev: "prev piece", next: "next piece", tier: "cycle tier", help: "this menu", expand: "expand", collapse: "collapse" },
  ru: { meta: "хоткеи", search: "поиск", prev: "пред. пьеса", next: "след. пьеса", tier: "тиры", help: "это меню", expand: "развернуть", collapse: "свернуть" },
}[lang];
---
<details data-shortcuts class="max-w-[1200px] mx-auto px-4 lg:px-8 mt-8 mb-12 group">
  <summary class="list-none cursor-pointer flex items-center justify-between py-2 hr-top">
    <span class="meta">{labels.meta}</span>
    <span class="font-mono text-[10.5px] text-muted flex items-center gap-1.5">
      <span class="group-open:hidden">{labels.expand}</span>
      <span class="hidden group-open:inline">{labels.collapse}</span>
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-open:rotate-180">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </span>
  </summary>
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-2 mt-3 mb-1 font-mono text-[12px]">
    <div class="flex items-center justify-between gap-2 py-1 hl">
      <dt class="text-muted">{labels.search}</dt>
      <dd class="flex items-center gap-1"><span class="kbd">⌘</span><span class="kbd">K</span></dd>
    </div>
    <div class="flex items-center justify-between gap-2 py-1 hl">
      <dt class="text-muted">{labels.prev}</dt>
      <dd><span class="kbd">k</span></dd>
    </div>
    <div class="flex items-center justify-between gap-2 py-1 hl">
      <dt class="text-muted">{labels.next}</dt>
      <dd><span class="kbd">j</span></dd>
    </div>
    <div class="flex items-center justify-between gap-2 py-1 hl">
      <dt class="text-muted">{labels.tier}</dt>
      <dd><span class="kbd">t</span></dd>
    </div>
    <div class="flex items-center justify-between gap-2 py-1 hl">
      <dt class="text-muted">{labels.help}</dt>
      <dd><span class="kbd">?</span></dd>
    </div>
  </dl>
</details>

<script>
  function init() {
    document.addEventListener("keydown", (e) => {
      const target = e.target as HTMLElement | null;
      if (target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable)) {
        return;
      }
      if (e.metaKey || e.ctrlKey || e.altKey) return;

      const key = e.key.toLowerCase();
      if (key === "j") {
        const next = document.querySelector<HTMLAnchorElement>("a[aria-label$='next piece']");
        if (next) {
          e.preventDefault();
          next.click();
        }
      } else if (key === "k") {
        const prev = document.querySelector<HTMLAnchorElement>("a[aria-label$='previous piece']");
        if (prev) {
          e.preventDefault();
          prev.click();
        }
      } else if (key === "t") {
        const seg = document.querySelector<HTMLElement>("[data-tier-segment]");
        if (seg) {
          e.preventDefault();
          const buttons = Array.from(seg.querySelectorAll<HTMLButtonElement>("button[data-tier]"));
          const activeIdx = buttons.findIndex((b) => b.dataset.active === "true");
          const next = buttons[(activeIdx + 1) % buttons.length];
          next?.click();
        }
      } else if (key === "?") {
        const details = document.querySelector<HTMLDetailsElement>("[data-shortcuts]");
        if (details) {
          e.preventDefault();
          details.open = !details.open;
        }
      }
    });
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
