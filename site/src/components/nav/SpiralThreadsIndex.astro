---
import { type Locale } from "../../i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

type Thread = {
  slug: "encapsulation" | "multiplexing" | "statefulness" | "latency";
  label: { en: string; ru: string };
  color: string;
};

const threads: Thread[] = [
  { slug: "encapsulation", label: { en: "encapsulation", ru: "инкапсуляция" },             color: "var(--p-lilac)" },
  { slug: "multiplexing",  label: { en: "multiplexing",  ru: "мультиплексирование" },      color: "var(--p-mint)" },
  { slug: "statefulness",  label: { en: "statefulness",  ru: "состояние" },                color: "var(--p-sky)" },
  { slug: "latency",       label: { en: "latency",       ru: "задержка" },                 color: "var(--p-peach)" },
];

const heading = lang === "en" ? "Cross-cutting threads" : "Сквозные нити";
const meta = lang === "en" ? "spiral · cross-cutting" : "spiral · сквозные";
const hint =
  lang === "en"
    ? "Concepts that surface across pillars. Follow the thread instead of the pillar."
    : "Концепты, возвращающиеся в разных столпах. Иди по нити, а не по столпу.";
---
<section class="my-8">
  <div class="meta mb-2">{meta}</div>
  <h3 class="font-display text-[18px] font-bold m-0 text-ink">{heading}</h3>
  <p class="text-[12.5px] text-muted leading-relaxed mt-2 mb-4 max-w-[420px]">{hint}</p>
  <div class="flex flex-wrap gap-2">
    {threads.map((th, i) => (
      <a class="chip" href={`/${lang}/threads/${th.slug}/`}>
        <span class="font-mono text-[9.5px] text-muted">§{String(i + 1).padStart(2, "0")}</span>
        <span class="pill-dot" style={`background:${th.color};`}></span>
        <span>{th.label[lang]}</span>
      </a>
    ))}
  </div>
</section>
