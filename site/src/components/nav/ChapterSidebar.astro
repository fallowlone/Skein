---
import { getCollection, getEntry } from "astro:content";
import ChapterSidebarTOC from "./ChapterSidebarTOC";
import type { Locale } from "../../i18n";

type Props = { lang: Locale; pillarSlug: string; chapterSlug: string; currentPiece?: string };
const { lang, pillarSlug, chapterSlug, currentPiece } = Astro.props;

const chapter = await getEntry("chapters", chapterSlug);
if (!chapter) throw new Error(`Chapter not found: ${chapterSlug}`);

const pieces = await getCollection("book", (e) => e.data.lang === lang && e.data.chapter === chapterSlug);

const orderedPieces = chapter.data.pieces
  .map((slug) => {
    const p = pieces.find((e) => e.data.slug === slug);
    return p
      ? {
          slug,
          title: p.data.title,
          readingMin: p.data.readingMin,
          spiral: p.data.spiral,
          status: p.data.status,
        }
      : null;
  })
  .filter(Boolean) as Array<{
    slug: string;
    title: string;
    readingMin: number;
    spiral: string[];
    status: string;
  }>;

const allPillarChapters = await getCollection("chapters", (c) => c.data.pillar === pillarSlug);
const pillarTotalPieces = allPillarChapters.reduce(
  (acc, c) => acc + c.data.pieces.length,
  0,
);
const readyHere = orderedPieces.filter((p) => p.status === "ready").length;
---

<aside class="text-[13px]">
  <div class="meta mb-1.5">
    <span>{String(chapter.data.order).padStart(2, "0")}</span>
    <span class="opacity-50 px-1">·</span>
    <span>{pillarSlug}</span>
  </div>
  <h3 class="font-display text-[18px] font-bold text-ink leading-tight m-0 mb-2 tracking-[-0.01em]">
    <a class="hover:underline" href={`/${lang}/${pillarSlug}/`}>{chapter.data.title[lang]}</a>
  </h3>
  <div class="font-mono text-[10.5px] text-muted mb-3">
    {readyHere}/{orderedPieces.length} ready · {pillarTotalPieces} total
  </div>
  <ChapterSidebarTOC
    client:visible
    pieces={orderedPieces}
    pillarSlug={pillarSlug}
    lang={lang}
    currentPiece={currentPiece}
  />
</aside>
