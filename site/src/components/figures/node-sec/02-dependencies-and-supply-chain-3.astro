---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Supply-chain hygiene: commit the lockfile, block install scripts, minimize dependencies, and pin scoped packages to a private registry",
    headline: "PIN · MINIMIZE · VERIFY",
    sub: "every dependency removed is attack surface removed",
    boxAHead: "commit package-lock.json",
    boxALine1: "exact versions + sha512 hashes",
    boxALine2: "review lock diffs like code",
    boxBHead: "npm ci --ignore-scripts",
    boxBLine1: "block lifecycle hooks",
    boxBLine2: "vet the few needing scripts",
    boxCHead: "minimize count + depth",
    boxCLine1: "drop what you never audit",
    boxCLine2: "most code is third-party",
    boxDHead: "scoped packages + .npmrc",
    boxDLine1: "pin scope to private registry",
    boxDLine2: "verify exact names",
    foot: "installing runs code from strangers",
    caption:
      "Supply-chain hygiene: commit the lockfile and review its diffs, install with npm ci --ignore-scripts for untrusted trees, minimize dependency count and depth, and use scoped packages pinned to a private registry with verified names.",
  },
  ru: {
    svgTitle: "Гигиена цепочки поставок: коммить lockfile, блокируй install-скрипты, минимизируй зависимости и пини scoped-пакеты к приватному реестру",
    headline: "ПИНИ · УЖИМАЙ · ПРОВЕРЯЙ",
    sub: "каждая удалённая зависимость — минус поверхность атаки",
    boxAHead: "коммить package-lock.json",
    boxALine1: "точные версии + sha512-хеши",
    boxALine2: "ревью диффа lock как кода",
    boxBHead: "npm ci --ignore-scripts",
    boxBLine1: "блокируй lifecycle-хуки",
    boxBLine2: "проверь тех, кому нужны скрипты",
    boxCHead: "минимум зависимостей",
    boxCLine1: "удали то, что не проаудируешь",
    boxCLine2: "большая часть кода — сторонняя",
    boxDHead: "scoped-пакеты + .npmrc",
    boxDLine1: "пини scope к приватному реестру",
    boxDLine2: "проверяй точные имена",
    foot: "установка — запуск кода от незнакомцев",
    caption:
      "Гигиена цепочки поставок: коммить lockfile и ревью его диффы, ставь через npm ci --ignore-scripts для недоверенных деревьев, минимизируй количество и глубину зависимостей, используй scoped-пакеты, запиненные к приватному реестру, с проверкой имён.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="100" width="360" height="108" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxAHead}</text>
    <text x="200" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxALine1}</text>
    <text x="200" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxALine2}</text>

    <rect x="420" y="100" width="360" height="108" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxBHead}</text>
    <text x="600" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxBLine1}</text>
    <text x="600" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxBLine2}</text>

    <rect x="20" y="232" width="360" height="108" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="200" y="264" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxCHead}</text>
    <text x="200" y="292" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxCLine1}</text>
    <text x="200" y="316" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxCLine2}</text>

    <rect x="420" y="232" width="360" height="108" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="264" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxDHead}</text>
    <text x="600" y="292" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxDLine1}</text>
    <text x="600" y="316" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxDLine2}</text>

    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
