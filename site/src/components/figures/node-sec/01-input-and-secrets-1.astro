---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Validate and reject versus sanitize and mutate: a schema check yields one typed trusted value or a 400, while sanitizing rewrites input into something wrong and maybe still dangerous",
    headline: "VALIDATE: REJECT, DON'T REWRITE",
    sub: "parse, don't validate — schema at the boundary",
    tagLeft: "validate + reject",
    leftTitle: "schema asks yes / no",
    leftRow1: "type, range, length",
    leftRow2: "allowlist shapes (zod / ajv / Joi)",
    leftRow3: "mismatch goes to 400 reject",
    leftRow4: "one typed trusted value",
    tagRight: "sanitize + mutate",
    rightTitle: "rewriting tries to clean",
    rightRow1: "strip / escape characters",
    rightRow2: "blocklist of foreseen patterns",
    rightRow3: "still dangerous, now wrong",
    rightRow4: "mutated untrusted input",
    foot: "reject keeps data honest; rewriting hides bugs",
    caption:
      "Parse, don't validate: a schema either accepts input as one typed, trusted value or rejects it with a 400. Sanitizing rewrites the input — a blocklist that misses what you didn't foresee and leaves the data wrong.",
  },
  ru: {
    svgTitle: "Валидируй и отклоняй против санитизируй и мутируй: проверка схемой даёт одно типизированное доверенное значение или 400, а санитизация переписывает ввод в нечто неверное и возможно всё ещё опасное",
    headline: "ВАЛИДИРУЙ: ОТКЛОНЯЙ, НЕ ПЕРЕПИСЫВАЙ",
    sub: "parse, don't validate — схема на границе",
    tagLeft: "валидируй + отклоняй",
    leftTitle: "схема спрашивает да / нет",
    leftRow1: "тип, диапазон, длина",
    leftRow2: "allowlist форм (zod / ajv / Joi)",
    leftRow3: "не совпало — 400, отклонить",
    leftRow4: "одно типизированное значение",
    tagRight: "санитизируй + мутируй",
    rightTitle: "переписывание чистит",
    rightRow1: "вырезает / экранирует символы",
    rightRow2: "блоклист предвиденных паттернов",
    rightRow3: "всё ещё опасно, уже неверно",
    rightRow4: "мутированный чужой ввод",
    foot: "отклонение честно; переписывание прячет баги",
    caption:
      "Parse, don't validate: схема либо принимает ввод как одно типизированное доверенное значение, либо отклоняет его с 400. Санитизация переписывает ввод — блоклист, который пропускает непредусмотренное и оставляет данные неверными.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="88" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <text x="595" y="88" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>

    <rect x="30" y="110" width="350" height="220" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="142" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <text x="205" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftRow1}</text>
    <text x="205" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftRow2}</text>
    <text x="205" y="244" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftRow3}</text>
    <text x="205" y="282" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftRow4}</text>

    <rect x="420" y="110" width="350" height="220" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="595" y="142" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    <text x="595" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightRow1}</text>
    <text x="595" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightRow2}</text>
    <text x="595" y="244" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightRow3}</text>
    <text x="595" y="282" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightRow4}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
