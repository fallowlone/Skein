---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Password hashing pipeline: random per-user salt, slow scrypt key-derivation tuned to about 100 to 250 milliseconds, constant-time compare",
    headline: "SLOW, SALTED, CONSTANT-TIME",
    sub: "a fast hash is the bug — SHA-256 falls at billions per second",
    step1: "salt",
    step2: "stretch",
    step3: "compare",
    b1t: "randomBytes(16)",
    b1s: "unique per user",
    b2t: "scrypt KDF",
    b2m: "N=16384, r=8, p=1",
    b2s: "one hash ~100-250 ms",
    b3t: "timingSafeEqual",
    b3s: "scans the full length",
    foot1: "SHA-256: billions of hashes/sec on GPU — speed is the vulnerability",
    foot2: "bcrypt truncates input at 72 bytes — pre-hash or use scrypt/argon2",
    caption:
      "Hash passwords with a slow, salted, memory-hard KDF tuned to about 100–250 ms per guess, a random salt per user, and a constant-time compare — never a fast hash or a short-circuiting comparison.",
  },
  ru: {
    svgTitle: "Конвейер хеширования паролей: случайная соль на пользователя, медленный scrypt на около 100–250 миллисекунд, сравнение за постоянное время",
    headline: "МЕДЛЕННО, С СОЛЬЮ, ЗА ПОСТОЯННОЕ ВРЕМЯ",
    sub: "быстрый хеш и есть баг — SHA-256 падает на миллиардах в секунду",
    step1: "соль",
    step2: "растяжение",
    step3: "сравнение",
    b1t: "randomBytes(16)",
    b1s: "уникальная на пользователя",
    b2t: "scrypt KDF",
    b2m: "N=16384, r=8, p=1",
    b2s: "один хеш ~100–250 мс",
    b3t: "timingSafeEqual",
    b3s: "сканирует всю длину",
    foot1: "SHA-256: миллиарды хешей/сек на GPU — скорость и есть уязвимость",
    foot2: "bcrypt режет вход на 72 байтах — предхешируй или бери scrypt/argon2",
    caption:
      "Хешируй пароли медленным, солёным, memory-hard KDF, настроенным на около 100–250 мс за попытку, со случайной солью на пользователя и сравнением за постоянное время — никаких быстрых хешей и сравнений с ранним выходом.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="ns8-arrow" viewBox="0 0 8 8" refX="8" refY="4" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0,0 L8,4 L0,8 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="130" y="106" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step1}</text>
    <text x="390" y="106" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step2}</text>
    <text x="660" y="106" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step3}</text>

    <rect x="30" y="130" width="200" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="130" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.b1t}</text>
    <text x="130" y="196" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b1s}</text>

    <rect x="270" y="130" width="240" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="390" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.b2t}</text>
    <text x="390" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b2m}</text>
    <text x="390" y="210" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b2s}</text>

    <rect x="550" y="130" width="220" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="660" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.b3t}</text>
    <text x="660" y="196" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b3s}</text>

    <line x1="238" y1="185" x2="262" y2="185" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns8-arrow)" />
    <line x1="518" y1="185" x2="542" y2="185" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns8-arrow)" />

    <text x="400" y="302" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="328" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
