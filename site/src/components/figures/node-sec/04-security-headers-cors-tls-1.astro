---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Security headers mapped to the attacks they block: CSP stops XSS, HSTS stops SSL-strip, frame controls stop clickjacking",
    headline: "ONE HEADER — ONE ATTACK",
    sub: "the cheapest layer you own",
    cspName: "Content-Security-Policy",
    cspDir: "script-src 'self'",
    cspHit: "stops XSS",
    hstsName: "Strict-Transport-Security",
    hstsDir: "max-age=31536000",
    hstsHit: "stops SSL-strip",
    frameName: "frame-ancestors / X-Frame-Options",
    frameDir: "frame-ancestors 'none'",
    frameHit: "stops clickjacking",
    foot: "set the wrong one and you get a false sense of safety",
    caption:
      "Each security header pairs with one named attack: CSP stops XSS, HSTS stops SSL-strip, and frame-ancestors / X-Frame-Options stop clickjacking.",
  },
  ru: {
    svgTitle: "Заголовки безопасности и атаки, которые они блокируют: CSP режет XSS, HSTS убивает SSL-strip, frame-контроли блокируют кликджекинг",
    headline: "ОДИН ЗАГОЛОВОК — ОДНА АТАКА",
    sub: "самый дешёвый слой, которым ты владеешь",
    cspName: "Content-Security-Policy",
    cspDir: "script-src 'self'",
    cspHit: "режет XSS",
    hstsName: "Strict-Transport-Security",
    hstsDir: "max-age=31536000",
    hstsHit: "убивает SSL-strip",
    frameName: "frame-ancestors / X-Frame-Options",
    frameDir: "frame-ancestors 'none'",
    frameHit: "блокируют кликджекинг",
    foot: "поставишь не тот — получишь ложное чувство защищённости",
    caption:
      "Каждый заголовок безопасности связан с одной атакой: CSP режет XSS, HSTS убивает SSL-strip, а frame-ancestors / X-Frame-Options блокируют кликджекинг.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="ns10-head" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="92" width="260" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="160" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cspName}</text>
    <text x="160" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cspDir}</text>
    <line x1="302" y1="130" x2="494" y2="130" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns10-head)" />
    <rect x="510" y="92" width="260" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="640" y="137" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cspHit}</text>

    <rect x="30" y="184" width="260" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="160" y="216" text-anchor="middle" font-size="12" fill="var(--ink)">{t.hstsName}</text>
    <text x="160" y="240" text-anchor="middle" font-size="11" fill="var(--ink)">{t.hstsDir}</text>
    <line x1="302" y1="222" x2="494" y2="222" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns10-head)" />
    <rect x="510" y="184" width="260" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="640" y="229" text-anchor="middle" font-size="12" fill="var(--ink)">{t.hstsHit}</text>

    <rect x="30" y="276" width="260" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="160" y="308" text-anchor="middle" font-size="11" fill="var(--ink)">{t.frameName}</text>
    <text x="160" y="332" text-anchor="middle" font-size="11" fill="var(--ink)">{t.frameDir}</text>
    <line x1="302" y1="314" x2="494" y2="314" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns10-head)" />
    <rect x="510" y="276" width="260" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="640" y="321" text-anchor="middle" font-size="12" fill="var(--ink)">{t.frameHit}</text>

    <text x="400" y="390" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
