---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "npm audit diffs the installed tree against the advisory database, gates CI on high severity, applies fixes, and behavior-aware scanners catch releases with no CVE yet",
    headline: "SCAN · GATE · FIX",
    sub: "audit sees only known, published issues",
    box1Head: "installed tree",
    box1Line1: "vs advisory database",
    box1Line2: "CVE + severity + fix path",
    box2Head: "npm audit",
    box2Line1: "--audit-level=high",
    box2Line2: "fail CI on high / critical",
    box2Line3: "cuts noise",
    box3Head: "npm audit fix",
    box3Line1: "safe semver fixes",
    box3Line2: "Dependabot / Renovate",
    box3Line3: "reviewable PRs",
    stripLine1: "Snyk / Socket: behavior, not just versions",
    stripLine2: "catches malicious releases with no CVE yet",
    foot: "audit is a floor, not a ceiling",
    caption:
      "npm audit diffs the installed tree against the advisory database and gates CI at --audit-level=high; npm audit fix plus Dependabot or Renovate automate upgrades, and a behavior-aware scanner like Snyk or Socket catches malicious releases that have no CVE yet.",
  },
  ru: {
    svgTitle: "npm audit сверяет установленное дерево с базой advisory, гейтит CI по высокой серьёзности, применяет фиксы, а поведенческие сканеры ловят релизы, у которых ещё нет CVE",
    headline: "СКАНИРОВАНИЕ · ГЕЙТ · ФИКС",
    sub: "аудит видит только известные проблемы",
    box1Head: "установленное дерево",
    box1Line1: "vs база advisory",
    box1Line2: "CVE + серьёзность + фикс",
    box2Head: "npm audit",
    box2Line1: "--audit-level=high",
    box2Line2: "ронять CI на high / critical",
    box2Line3: "срезает шум",
    box3Head: "npm audit fix",
    box3Line1: "безопасные semver-фиксы",
    box3Line2: "Dependabot / Renovate",
    box3Line3: "ревьюабельные PR",
    stripLine1: "Snyk / Socket: поведение, а не версии",
    stripLine2: "ловит вредоносные релизы, у которых ещё нет CVE",
    foot: "аудит — это пол, а не потолок",
    caption:
      "npm audit сверяет установленное дерево с базой advisory и гейтит CI на --audit-level=high; npm audit fix плюс Dependabot или Renovate автоматизируют апгрейды, а поведенческий сканер вроде Snyk или Socket ловит вредоносные релизы, у которых ещё нет CVE.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="110" width="236" height="132" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="138" y="142" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box1Head}</text>
    <text x="138" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Line1}</text>
    <text x="138" y="194" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Line2}</text>

    <line x1="256" y1="176" x2="264" y2="176" stroke="var(--muted)" stroke-width="2" />
    <polygon points="264,168 276,176 264,184" fill="var(--muted)" />

    <rect x="276" y="110" width="236" height="132" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="394" y="142" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box2Head}</text>
    <text x="394" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Line1}</text>
    <text x="394" y="194" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Line2}</text>
    <text x="394" y="216" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Line3}</text>

    <line x1="512" y1="176" x2="520" y2="176" stroke="var(--muted)" stroke-width="2" />
    <polygon points="520,168 532,176 520,184" fill="var(--muted)" />

    <rect x="532" y="110" width="236" height="132" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="650" y="142" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box3Head}</text>
    <text x="650" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Line1}</text>
    <text x="650" y="194" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Line2}</text>
    <text x="650" y="216" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Line3}</text>

    <rect x="20" y="272" width="748" height="72" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="394" y="300" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stripLine1}</text>
    <text x="394" y="324" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stripLine2}</text>

    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
