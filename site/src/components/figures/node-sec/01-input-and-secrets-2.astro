---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Secrets handling: read from process.env at startup, never commit or log secrets, use a secrets manager in production, rotate on exposure",
    headline: "SECRETS: ENV IN, NEVER IN GIT",
    sub: "env at runtime — nothing secret in the repo",
    tagCode: "in code",
    codeRow1: "process.env.DATABASE_URL",
    codeRow2: "read at startup",
    codeRow3: "missing secret: fail fast",
    tagNever: "never",
    neverRow1: "never commit (.gitignore)",
    neverRow2: "never log secrets",
    neverRow3: "least privilege token",
    tagProd: "in production",
    prodRow1: "no .env file in prod",
    prodRow2: "manager injects at runtime",
    prodRow3: "Vault / AWS / Doppler",
    foot1: "a committed secret is a permanent leak",
    foot2: "rotate the credential, not just git rm",
    caption:
      "Read secrets from process.env, keep .env out of git, never log secrets, and use a secrets manager in production. A committed secret lives in git history forever — rotate the credential, don't just delete the file.",
  },
  ru: {
    svgTitle: "Работа с секретами: читай из process.env на старте, никогда не коммить и не логируй секреты, в проде используй менеджер секретов, при утечке ротируй",
    headline: "СЕКРЕТЫ: ENV ВНУТРЬ, НИКОГДА В GIT",
    sub: "env в рантайме — ничего секретного в репозитории",
    tagCode: "в коде",
    codeRow1: "process.env.DATABASE_URL",
    codeRow2: "читай на старте",
    codeRow3: "нет секрета — падай сразу",
    tagNever: "никогда",
    neverRow1: "не коммить (.gitignore)",
    neverRow2: "не логируй секреты",
    neverRow3: "наименьшие привилегии",
    tagProd: "в проде",
    prodRow1: "в проде .env не вози",
    prodRow2: "менеджер вставляет в рантайме",
    prodRow3: "Vault / AWS / Doppler",
    foot1: "закоммиченный секрет — утечка навсегда",
    foot2: "ротируй сам секрет, а не просто git rm",
    caption:
      "Читай секреты из process.env, держи .env вне git, никогда не логируй секреты, а в проде используй менеджер секретов. Закоммиченный секрет навсегда живёт в истории git — ротируй секрет, а не просто удаляй файл.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <defs>
      <marker id="ns2-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--muted)" />
      </marker>
    </defs>
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="140" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagCode}</text>
    <text x="400" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagNever}</text>
    <text x="660" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagProd}</text>

    <rect x="30" y="114" width="220" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="140" y="150" text-anchor="middle" font-size="11" fill="var(--ink)">{t.codeRow1}</text>
    <text x="140" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.codeRow2}</text>
    <text x="140" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.codeRow3}</text>

    <rect x="290" y="114" width="220" height="190" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="150" text-anchor="middle" font-size="11" fill="var(--ink)">{t.neverRow1}</text>
    <text x="400" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.neverRow2}</text>
    <text x="400" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.neverRow3}</text>

    <rect x="550" y="114" width="220" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="660" y="150" text-anchor="middle" font-size="11" fill="var(--ink)">{t.prodRow1}</text>
    <text x="660" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.prodRow2}</text>
    <text x="660" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.prodRow3}</text>

    <line x1="250" y1="209" x2="286" y2="209" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns2-arrow)" />
    <line x1="510" y1="209" x2="546" y2="209" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns2-arrow)" />

    <text x="400" y="348" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="373" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
