---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "TLS minima: version 1.2 or higher with the faster 1-RTT 1.3 preferred, the full certificate chain, and HSTS with preload",
    headline: "TLS 1.2+ WITH A FULL CHAIN",
    sub: "without a private channel the headers do not matter",
    r1name: "minVersion: 'TLSv1.2'",
    r1sub: "floor; 1.3 when both sides support it",
    r1hit: "prefer 1.3: 1-RTT vs 1.2: 2-RTT",
    r2name: "cert: fullchain.pem",
    r2sub: "leaf + intermediates",
    r2hit1: "serve the full chain",
    r2hit2: "or the handshake fails",
    r3name: "HSTS: max-age=31536000",
    r3sub: "includeSubDomains; preload",
    r3hit: "first request already protected",
    foot: "TLS 1.0/1.1 are broken and must be off",
    caption:
      "Terminate TLS 1.2 or higher with the full certificate chain, and ship HSTS with preload so even the first request is protected.",
  },
  ru: {
    svgTitle: "Минимумы TLS: версия 1.2+, лучше 1.3 с быстрым 1-RTT, полная цепочка сертификатов и HSTS с preload",
    headline: "TLS 1.2+ С ПОЛНОЙ ЦЕПОЧКОЙ",
    sub: "без приватного соединения заголовки не важны",
    r1name: "minVersion: 'TLSv1.2'",
    r1sub: "пол; 1.3 — когда обе стороны поддерживают",
    r1hit: "лучше 1.3: 1-RTT, у 1.2: 2-RTT",
    r2name: "cert: fullchain.pem",
    r2sub: "leaf + промежуточные",
    r2hit1: "отдавай полную цепочку",
    r2hit2: "иначе провал рукопожатия",
    r3name: "HSTS: max-age=31536000",
    r3sub: "includeSubDomains; preload",
    r3hit: "самый первый запрос уже защищён",
    foot: "TLS 1.0/1.1 сломаны и должны быть выключены",
    caption:
      "Терминируй TLS 1.2+ с полной цепочкой сертификатов и шли HSTS с preload, чтобы был защищён даже первый запрос.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="ns12-head" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="92" width="350" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="195" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r1name}</text>
    <text x="195" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r1sub}</text>
    <line x1="382" y1="130" x2="418" y2="130" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns12-head)" />
    <rect x="430" y="92" width="350" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="605" y="137" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r1hit}</text>

    <rect x="20" y="184" width="350" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="195" y="216" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r2name}</text>
    <text x="195" y="240" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r2sub}</text>
    <line x1="382" y1="222" x2="418" y2="222" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns12-head)" />
    <rect x="430" y="184" width="350" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="605" y="216" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r2hit1}</text>
    <text x="605" y="240" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r2hit2}</text>

    <rect x="20" y="276" width="350" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="195" y="308" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r3name}</text>
    <text x="195" y="332" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r3sub}</text>
    <line x1="382" y1="314" x2="418" y2="314" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns12-head)" />
    <rect x="430" y="276" width="350" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="605" y="321" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r3hit}</text>

    <text x="400" y="390" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
