---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "ReDoS: one ambiguous regex over a 40-character crafted string costs billions of backtracking steps and freezes the single event loop; the fixes are a linear pattern, a length cap, or RE2",
    headline: "REDOS: BOUND THE REGEX",
    sub: "one ambiguous pattern freezes the single event loop",
    inCode: '"1".repeat(40)',
    inSub: "40 chars",
    reCode: '/^(\\d+,)*\\d+$/',
    reSub: "ambiguous · backtracking",
    loopLine1: "event loop frozen",
    loopLine2: "CPU 100%",
    fixes: "fixes:",
    g1code: '/^\\d+(,\\d+)*$/',
    g1sub: "linear · one parse",
    g2code: "length > 256",
    g2sub: "reject before match",
    g3code: "RE2 · O(n)",
    g3sub: "no backtracking",
    caption:
      "An ambiguous pattern turns one crafted string into billions of steps on the shared thread — rewrite it linear, cap length before matching, or use RE2.",
  },
  ru: {
    svgTitle: "ReDoS: одна неоднозначная регулярка на подобранной строке в 40 символов стоит миллиарды шагов бэктрекинга и замораживает единственный event loop; фиксы — линейный паттерн, ограничение длины или RE2",
    headline: "REDOS: ОГРАНИЧЬ РЕГУЛЯРКУ",
    sub: "один неоднозначный паттерн стопорит единственный event loop",
    inCode: '"1".repeat(40)',
    inSub: "40 символов",
    reCode: '/^(\\d+,)*\\d+$/',
    reSub: "неоднозначный · бэктрекинг",
    loopLine1: "event loop стоит",
    loopLine2: "CPU 100%",
    fixes: "фиксы:",
    g1code: '/^\\d+(,\\d+)*$/',
    g1sub: "линейный · один разбор",
    g2code: "length > 256",
    g2sub: "отказ до матчинга",
    g3code: "RE2 · O(n)",
    g3sub: "без бэктрекинга",
    caption:
      "Неоднозначный паттерн превращает одну подобранную строку в миллиарды шагов на общем потоке — перепиши линейно, ограничь длину до матчинга или используй RE2.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="ns14-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--accent)" /></marker>
      <marker id="ns14-m" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--muted)" /></marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="118" width="180" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="110" y="147" text-anchor="middle" font-size="12" fill="var(--ink)">{t.inCode}</text>
    <text x="110" y="169" text-anchor="middle" font-size="11" fill="var(--ink)">{t.inSub}</text>

    <rect x="250" y="108" width="290" height="90" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="395" y="141" text-anchor="middle" font-size="12" fill="var(--ink)">{t.reCode}</text>
    <text x="395" y="163" text-anchor="middle" font-size="11" fill="var(--ink)">{t.reSub}</text>

    <rect x="590" y="108" width="180" height="90" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="680" y="141" text-anchor="middle" font-size="11" fill="var(--ink)">{t.loopLine1}</text>
    <text x="680" y="163" text-anchor="middle" font-size="11" fill="var(--ink)">{t.loopLine2}</text>

    <line x1="200" y1="156" x2="250" y2="156" stroke="var(--accent)" stroke-width="2" marker-end="url(#ns14-a)" />
    <line x1="540" y1="153" x2="590" y2="153" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 4" marker-end="url(#ns14-m)" />
    <line x1="390" y1="198" x2="390" y2="258" stroke="var(--accent)" stroke-width="2" marker-end="url(#ns14-a)" />

    <text x="20" y="232" font-size="11" fill="var(--muted)">{t.fixes}</text>

    <rect x="20" y="258" width="230" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="135" y="287" text-anchor="middle" font-size="11" fill="var(--ink)">{t.g1code}</text>
    <text x="135" y="309" text-anchor="middle" font-size="11" fill="var(--ink)">{t.g1sub}</text>

    <rect x="280" y="258" width="220" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="390" y="287" text-anchor="middle" font-size="11" fill="var(--ink)">{t.g2code}</text>
    <text x="390" y="309" text-anchor="middle" font-size="11" fill="var(--ink)">{t.g2sub}</text>

    <rect x="530" y="258" width="240" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="650" y="287" text-anchor="middle" font-size="11" fill="var(--ink)">{t.g3code}</text>
    <text x="650" y="309" text-anchor="middle" font-size="11" fill="var(--ink)">{t.g3sub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
