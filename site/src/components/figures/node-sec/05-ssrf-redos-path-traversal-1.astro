---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "SSRF defense pipeline: a user-supplied URL is allow-listed, resolved once, checked against internal ranges, and pinned for the connection with redirects disabled",
    headline: "SSRF: PIN THE RESOLVED IP",
    sub: "resolve once, block internal ranges, no second lookup",
    userLine: "?url=…",
    userSub: "user input",
    guard1: "allow-listed host only",
    guard2: "lookup() — resolve once",
    guard3: "reject 169.254.x · RFC1918",
    guard4: "pin IP · redirect: manual",
    metaLine1: "169.254.169.254",
    metaLine2: "metadata · blocked",
    okLine1: "allow-listed host",
    okLine2: "pinned IP · 200 OK",
    foot1: "string blocklists fail: decimal IP, IPv6-mapped, DNS rebinding",
    foot2: "one resolution feeds check and connect — the window stays shut",
    caption:
      "Keep user URLs on an allow-list: resolve the host once, reject internal ranges, and pin the connection to the validated IP with redirects off.",
  },
  ru: {
    svgTitle: "Защита от SSRF: URL от пользователя проверяется по allow-листу, резолвится один раз, сверяется с внутренними диапазонами, а соединение закрепляется на проверенном IP с отключёнными редиректами",
    headline: "SSRF: ЗАКРЕПИ РАЗРЕШЁННЫЙ IP",
    sub: "один резолв, блок внутренних IP, без второго lookup",
    userLine: "?url=…",
    userSub: "ввод юзера",
    guard1: "только хост из allow-листа",
    guard2: "lookup() — один резолв",
    guard3: "блок 169.254.x · RFC1918",
    guard4: "пин IP · redirect: manual",
    metaLine1: "169.254.169.254",
    metaLine2: "метаданные · стоп",
    okLine1: "хост из allow-листа",
    okLine2: "закреп IP · 200 OK",
    foot1: "блок-лист строк не держит: decimal IP, IPv6-mapped, DNS rebinding",
    foot2: "один резолв на проверку и соединение — окно закрыто",
    caption:
      "Держи URL юзера в allow-листе: разреши хост один раз, отвергни внутренние диапазоны и закрепи соединение на проверенном IP с выключенными редиректами.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="ns13-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--accent)" /></marker>
      <marker id="ns13-m" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--muted)" /></marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="124" width="150" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="95" y="154" text-anchor="middle" font-size="13" fill="var(--ink)">{t.userLine}</text>
    <text x="95" y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.userSub}</text>

    <rect x="210" y="100" width="260" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="340" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.guard1}</text>
    <text x="340" y="155" text-anchor="middle" font-size="11" fill="var(--ink)">{t.guard2}</text>
    <text x="340" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.guard3}</text>
    <text x="340" y="205" text-anchor="middle" font-size="11" fill="var(--ink)">{t.guard4}</text>

    <rect x="570" y="92" width="200" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="670" y="121" text-anchor="middle" font-size="12" fill="var(--ink)">{t.metaLine1}</text>
    <text x="670" y="143" text-anchor="middle" font-size="11" fill="var(--ink)">{t.metaLine2}</text>

    <rect x="570" y="192" width="200" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="670" y="221" text-anchor="middle" font-size="11" fill="var(--ink)">{t.okLine1}</text>
    <text x="670" y="243" text-anchor="middle" font-size="11" fill="var(--ink)">{t.okLine2}</text>

    <line x1="170" y1="162" x2="210" y2="162" stroke="var(--accent)" stroke-width="2" marker-end="url(#ns13-a)" />
    <line x1="470" y1="130" x2="570" y2="130" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 4" marker-end="url(#ns13-m)" />
    <line x1="470" y1="210" x2="570" y2="228" stroke="var(--accent)" stroke-width="2" marker-end="url(#ns13-a)" />
    <text x="520" y="134" text-anchor="middle" font-size="14" fill="var(--muted)">✕</text>
    <text x="520" y="223" text-anchor="middle" font-size="14" fill="var(--accent)">✓</text>

    <text x="400" y="318" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="341" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
