---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Path traversal jail: join normalizes dot-dot upward and escapes the base, so resolve to an absolute path and serve only results that stay under the base directory",
    headline: "TRAVERSAL: JAIL THE PATH",
    sub: "join normalizes .. upward — resolve, then check the prefix",
    inCode: '"../../etc/passwd"',
    inSub: "user input",
    resCode: "resolve(BASE, input)",
    resSub: "absolute path",
    badCode: "/etc/passwd → 400",
    badSub: "outside base · reject",
    goodCode: "uploads/a.pdf → 200",
    goodSub: "under base · send",
    naiveCode: "join(base, input) → /etc/passwd",
    naiveSub: "join normalizes ../ · no jail",
    checkCode: "startsWith(BASE + path.sep)",
    checkSub: "sep blocks uploads-secret sibling",
    caption:
      "Join cleans the string but still climbs — resolve to an absolute path and serve only what stays under the base, or map an opaque id to a real path.",
  },
  ru: {
    svgTitle: "Удержание пути: join нормализует точки вверх и выходит из базы, поэтому делай resolve в абсолютный путь и отдавай только то, что осталось под базовым каталогом",
    headline: "TRAVERSAL: УДЕРЖИ ПУТЬ",
    sub: "join нормализует .. вверх — resolve, затем проверь префикс",
    inCode: '"../../etc/passwd"',
    inSub: "ввод юзера",
    resCode: "resolve(BASE, input)",
    resSub: "абсолютный путь",
    badCode: "/etc/passwd → 400",
    badSub: "вне базы · отказ",
    goodCode: "uploads/a.pdf → 200",
    goodSub: "под базой · отдать",
    naiveCode: "join(base, input) → /etc/passwd",
    naiveSub: "join нормализует ../ · не удержание",
    checkCode: "startsWith(BASE + path.sep)",
    checkSub: "sep отсекает uploads-secret",
    caption:
      "Join чистит строку, но всё равно лезет вверх — делай resolve в абсолютный путь и отдавай только то, что под базой, или сопоставляй непрозрачный id реальному пути.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="ns15-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--accent)" /></marker>
      <marker id="ns15-m" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--muted)" /></marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="118" width="190" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="115" y="147" text-anchor="middle" font-size="11" fill="var(--ink)">{t.inCode}</text>
    <text x="115" y="169" text-anchor="middle" font-size="11" fill="var(--ink)">{t.inSub}</text>

    <rect x="260" y="108" width="280" height="90" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="141" text-anchor="middle" font-size="11" fill="var(--ink)">{t.resCode}</text>
    <text x="400" y="163" text-anchor="middle" font-size="11" fill="var(--ink)">{t.resSub}</text>

    <rect x="590" y="88" width="180" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="680" y="117" text-anchor="middle" font-size="11" fill="var(--ink)">{t.badCode}</text>
    <text x="680" y="139" text-anchor="middle" font-size="11" fill="var(--ink)">{t.badSub}</text>

    <rect x="590" y="180" width="180" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="680" y="209" text-anchor="middle" font-size="11" fill="var(--ink)">{t.goodCode}</text>
    <text x="680" y="231" text-anchor="middle" font-size="11" fill="var(--ink)">{t.goodSub}</text>

    <line x1="210" y1="155" x2="260" y2="155" stroke="var(--accent)" stroke-width="2" marker-end="url(#ns15-a)" />
    <line x1="540" y1="128" x2="590" y2="126" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 4" marker-end="url(#ns15-m)" />
    <line x1="540" y1="172" x2="590" y2="206" stroke="var(--accent)" stroke-width="2" marker-end="url(#ns15-a)" />
    <text x="565" y="130" text-anchor="middle" font-size="14" fill="var(--muted)">✕</text>
    <text x="565" y="194" text-anchor="middle" font-size="14" fill="var(--accent)">✓</text>

    <rect x="20" y="276" width="350" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="195" y="305" text-anchor="middle" font-size="11" fill="var(--ink)">{t.naiveCode}</text>
    <text x="195" y="327" text-anchor="middle" font-size="11" fill="var(--ink)">{t.naiveSub}</text>

    <rect x="400" y="276" width="370" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="585" y="305" text-anchor="middle" font-size="11" fill="var(--ink)">{t.checkCode}</text>
    <text x="585" y="327" text-anchor="middle" font-size="11" fill="var(--ink)">{t.checkSub}</text>

    <line x1="450" y1="198" x2="560" y2="276" stroke="var(--accent)" stroke-width="2" marker-end="url(#ns15-a)" />
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
