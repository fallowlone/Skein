---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three injection sinks and their one defense each: SQL gets parameterized queries, shell gets execFile with an argument array, paths get resolve plus a base-dir check",
    headline: "DATA MUST NEVER BECOME CODE",
    sub: "one channel, one defense — not interchangeable",
    tagInput: "untrusted input",
    inputRow1: "body / query / env",
    sqlLine1: "SQL: input glued into query",
    sqlLine2: "parameterized query, values apart ($1)",
    cmdLine1: "shell: exec(string)",
    cmdLine2: "execFile + argument array, no shell",
    pathLine1: "path: ?file= joined in",
    pathLine2: "path.resolve + base-dir check",
    foot: "shell: true re-opens the hole",
    caption:
      "Never let untrusted data become code. SQL is stopped by parameterized queries, shell commands by execFile with an argument array and no shell, paths by resolving and proving the result stays under the base dir.",
  },
  ru: {
    svgTitle: "Три канала инъекций и единственная защита каждого: SQL — параметризованные запросы, shell — execFile с массивом аргументов, пути — resolve плюс проверка базовой папки",
    headline: "ДАННЫЕ НЕ ДОЛЖНЫ СТАТЬ КОДОМ",
    sub: "один канал — одна защита, не взаимозаменяемы",
    tagInput: "недоверенный ввод",
    inputRow1: "body / query / env",
    sqlLine1: "SQL: ввод склеен в запрос",
    sqlLine2: "параметры отдельно, значения — $1",
    cmdLine1: "shell: exec(строка)",
    cmdLine2: "execFile + arg-массив, без shell",
    pathLine1: "путь: ?file= склеен внутрь",
    pathLine2: "path.resolve + проверка базы",
    foot: "shell: true снова открывает дыру",
    caption:
      "Никогда не давай недоверенным данным стать кодом. SQL останавливают параметризованные запросы, shell-команды — execFile с массивом аргументов без shell, пути — разрешение пути и доказательство, что результат внутри базовой папки.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <defs>
      <marker id="ns3-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--muted)" />
      </marker>
    </defs>
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="120" y="172" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagInput}</text>
    <rect x="30" y="194" width="180" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="120" y="238" text-anchor="middle" font-size="11" fill="var(--ink)">{t.inputRow1}</text>

    <rect x="330" y="106" width="340" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="500" y="132" text-anchor="middle" font-size="11" fill="var(--ink)">{t.sqlLine1}</text>
    <text x="500" y="156" text-anchor="middle" font-size="11" fill="var(--ink)">{t.sqlLine2}</text>

    <rect x="330" y="199" width="340" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="500" y="225" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cmdLine1}</text>
    <text x="500" y="249" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cmdLine2}</text>

    <rect x="330" y="292" width="340" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="500" y="318" text-anchor="middle" font-size="11" fill="var(--ink)">{t.pathLine1}</text>
    <text x="500" y="342" text-anchor="middle" font-size="11" fill="var(--ink)">{t.pathLine2}</text>

    <line x1="210" y1="232" x2="322" y2="139" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns3-arrow)" />
    <line x1="210" y1="232" x2="322" y2="232" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns3-arrow)" />
    <line x1="210" y1="232" x2="322" y2="325" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns3-arrow)" />

    <text x="400" y="396" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
