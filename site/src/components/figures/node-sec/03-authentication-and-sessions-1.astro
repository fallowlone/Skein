---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Server session versus signed JWT: revocation, store lookup, size, and where the credential lives",
    headline: "SESSION vs JWT: OPPOSITE TRADEOFFS",
    sub: "revocable lookup versus unrevocable statelessness",
    sessTitle: "opaque session",
    jwtTitle: "signed JWT",
    s1: "128-bit random id in cookie",
    s2: "state in Redis or DB",
    s3: "store lookup per request",
    s4: "DEL session:id logs out instantly",
    s5: "HttpOnly: XSS cannot read it",
    j1: "claims in header.payload.signature",
    j2: "no lookup, zero shared state",
    j3: "valid until exp — no un-issue",
    j4: "localStorage: XSS can steal it",
    j5: "scales flat, costs revocation",
    foot1: "session trades a lookup for instant revocation and XSS safety",
    foot2: "JWT trades revocability away for stateless scale",
    caption:
      "The session keeps state server-side and revokes with one DEL, at the cost of a per-request lookup; the JWT verifies statelessly and scales flat, but stays valid until exp and is exfiltratable from localStorage.",
  },
  ru: {
    svgTitle: "Серверная сессия против подписанного JWT: отзыв, поиск в хранилище, размер и место хранения учётки",
    headline: "СЕССИЯ vs JWT: ОБРАТНЫЕ КОМПРОМИССЫ",
    sub: "отзываемый поиск против неотзываемого stateless",
    sessTitle: "непрозрачная сессия",
    jwtTitle: "подписанный JWT",
    s1: "128-битный случайный id в куке",
    s2: "состояние в Redis или БД",
    s3: "поиск в хранилище на запрос",
    s4: "DEL session:id — мгновенный логаут",
    s5: "HttpOnly: XSS её не прочитает",
    j1: "клеймы в header.payload.signature",
    j2: "без поиска, ноль общего состояния",
    j3: "валиден до exp — не развыдать",
    j4: "localStorage: XSS его украдёт",
    j5: "масштаб плоский, ценой отзыва",
    foot1: "сессия меняет поиск на мгновенный отзыв и защиту от XSS",
    foot2: "JWT меняет отзываемость на масштаб без состояния",
    caption:
      "Сессия держит состояние на сервере и отзывается одним DEL ценой поиска на каждый запрос; JWT проверяется без состояния и масштабируется плоско, но валиден до exp и выкачивается из localStorage.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="100" width="340" height="210" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="128" text-anchor="middle" font-size="13" fill="var(--ink)">{t.sessTitle}</text>
    <line x1="60" y1="140" x2="340" y2="140" stroke="var(--accent)" stroke-width="1" />
    <circle cx="52" cy="160" r="4" fill="var(--accent)" />
    <text x="72" y="164" font-size="11" fill="var(--ink)">{t.s1}</text>
    <circle cx="52" cy="184" r="4" fill="var(--accent)" />
    <text x="72" y="188" font-size="11" fill="var(--ink)">{t.s2}</text>
    <circle cx="52" cy="208" r="4" fill="var(--accent)" />
    <text x="72" y="212" font-size="11" fill="var(--ink)">{t.s3}</text>
    <circle cx="52" cy="232" r="4" fill="var(--accent)" />
    <text x="72" y="236" font-size="11" fill="var(--ink)">{t.s4}</text>
    <circle cx="52" cy="256" r="4" fill="var(--accent)" />
    <text x="72" y="260" font-size="11" fill="var(--ink)">{t.s5}</text>

    <rect x="430" y="100" width="340" height="210" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="600" y="128" text-anchor="middle" font-size="13" fill="var(--ink)">{t.jwtTitle}</text>
    <line x1="460" y1="140" x2="740" y2="140" stroke="var(--muted)" stroke-width="1" />
    <circle cx="452" cy="160" r="4" fill="var(--muted)" />
    <text x="472" y="164" font-size="11" fill="var(--ink)">{t.j1}</text>
    <circle cx="452" cy="184" r="4" fill="var(--muted)" />
    <text x="472" y="188" font-size="11" fill="var(--ink)">{t.j2}</text>
    <circle cx="452" cy="208" r="4" fill="var(--muted)" />
    <text x="472" y="212" font-size="11" fill="var(--ink)">{t.j3}</text>
    <circle cx="452" cy="232" r="4" fill="var(--muted)" />
    <text x="472" y="236" font-size="11" fill="var(--ink)">{t.j4}</text>
    <circle cx="452" cy="256" r="4" fill="var(--muted)" />
    <text x="472" y="260" font-size="11" fill="var(--ink)">{t.j5}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="374" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
