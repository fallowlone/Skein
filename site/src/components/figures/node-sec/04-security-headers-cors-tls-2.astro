---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "CORS preflight flow: the browser sends an OPTIONS preflight, the server reflects the Origin only for allow-listed origins, otherwise the browser blocks the read",
    headline: "PREFLIGHT FIRST, READ SECOND",
    sub: "the server opts in — the browser enforces",
    step1: "1 — page calls fetch(api, { credentials: 'include' })",
    step2: "2 — browser sends OPTIONS preflight (method + headers)",
    okL1: "Origin in allow-list",
    okL2: "reflect + Vary: Origin + creds",
    noL1: "Origin unknown",
    noL2: "emit nothing — read blocked",
    verdict: "never reflect an arbitrary Origin with credentials",
    caption:
      "A non-simple request triggers an OPTIONS preflight; the server reflects the Origin only for allow-listed origins with Vary: Origin, and emits nothing otherwise — then the browser blocks the read.",
  },
  ru: {
    svgTitle: "Поток preflight CORS: браузер шлёт preflight OPTIONS, сервер отражает Origin только для origin из allow-list, иначе браузер блокирует чтение",
    headline: "СНАЧАЛА PREFLIGHT, ПОТОМ ЗАПРОС",
    sub: "сервер разрешает — браузер контролирует",
    step1: "1 — страница вызывает fetch(api, { credentials: 'include' })",
    step2: "2 — браузер шлёт preflight OPTIONS (метод + заголовки)",
    okL1: "Origin есть в allow-list",
    okL2: "отражаем + Vary: Origin + creds",
    noL1: "Origin нет в allow-list",
    noL2: "не шлём ничего — чтение блокируется",
    verdict: "никогда не отражай произвольный Origin с credentials",
    caption:
      "Непростой запрос запускает preflight OPTIONS; сервер отражает Origin только для origin из allow-list с Vary: Origin, иначе не шлёт ничего — и браузер блокирует чтение.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="ns11-head" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="92" width="720" height="50" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="123" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step1}</text>
    <line x1="400" y1="142" x2="400" y2="158" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns11-head)" />

    <rect x="40" y="162" width="720" height="50" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="193" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step2}</text>
    <line x1="400" y1="212" x2="400" y2="228" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns11-head)" />

    <rect x="40" y="232" width="345" height="84" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="212" y="266" text-anchor="middle" font-size="12" fill="var(--ink)">{t.okL1}</text>
    <text x="212" y="290" text-anchor="middle" font-size="11" fill="var(--ink)">{t.okL2}</text>
    <rect x="415" y="232" width="345" height="84" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="587" y="266" text-anchor="middle" font-size="12" fill="var(--ink)">{t.noL1}</text>
    <text x="587" y="290" text-anchor="middle" font-size="11" fill="var(--ink)">{t.noL2}</text>
    <line x1="400" y1="316" x2="400" y2="332" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns11-head)" />

    <rect x="40" y="336" width="720" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--ink)">{t.verdict}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
