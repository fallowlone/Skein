---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "npm ci installs strictly from the lockfile with integrity checks, while npm install may resolve new versions and mutate the lockfile",
    headline: "NPM CI VS NPM INSTALL",
    sub: "the lockfile is the integrity boundary",
    ciHead: "npm ci",
    ciLine1: "lockfile only",
    ciLine2: "fails on drift",
    ciLine3: "wipes node_modules",
    ciLine4: "verifies sha512 hashes",
    ciLine5: "CI default",
    instHead: "npm install",
    instLine1: "resolves new in-range versions",
    instLine2: "mutates the lockfile",
    instLine3: "may pull a malicious patch",
    instLine4: "local changes only",
    instLine5: "deliberate bumps only",
    foot: "ci installs the pinned tree; install may resolve a fresh in-range patch",
    caption:
      "npm ci installs strictly from the lockfile, fails on drift, wipes node_modules and verifies every sha512 hash — the CI default. npm install may resolve new in-range versions and mutate the lock, so reserve it for deliberate local dependency changes.",
  },
  ru: {
    svgTitle: "npm ci ставит строго из lockfile с проверкой целостности, а npm install может разрезолвить новые версии и мутировать lockfile",
    headline: "NPM CI ПРОТИВ NPM INSTALL",
    sub: "lockfile — граница целостности",
    ciHead: "npm ci",
    ciLine1: "только из lockfile",
    ciLine2: "падает на дрейфе",
    ciLine3: "стирает node_modules",
    ciLine4: "проверяет sha512-хеши",
    ciLine5: "дефолт для CI",
    instHead: "npm install",
    instLine1: "резолвит свежее в диапазоне",
    instLine2: "мутирует lockfile",
    instLine3: "может подтянуть вредоносный патч",
    instLine4: "только локально",
    instLine5: "намеренная смена зависимостей",
    foot: "ci ставит запиненное дерево; install может подтянуть свежий патч",
    caption:
      "npm ci ставит строго из lockfile, падает на дрейфе, стирает node_modules и сверяет каждый sha512-хеш — дефолт для CI. npm install может разрезолвить новые версии в диапазоне и мутировать lock, поэтому оставь его для намеренной смены зависимостей локально.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="100" width="360" height="212" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="132" text-anchor="middle" font-size="14" fill="var(--ink)">npm ci</text>
    <text x="200" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.ciLine1}</text>
    <text x="200" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.ciLine2}</text>
    <text x="200" y="208" text-anchor="middle" font-size="11" fill="var(--ink)">{t.ciLine3}</text>
    <text x="200" y="232" text-anchor="middle" font-size="11" fill="var(--ink)">{t.ciLine4}</text>
    <text x="200" y="282" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ciLine5}</text>

    <rect x="420" y="100" width="360" height="212" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="600" y="132" text-anchor="middle" font-size="14" fill="var(--ink)">npm install</text>
    <text x="600" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.instLine1}</text>
    <text x="600" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.instLine2}</text>
    <text x="600" y="208" text-anchor="middle" font-size="11" fill="var(--ink)">{t.instLine3}</text>
    <text x="600" y="232" text-anchor="middle" font-size="11" fill="var(--ink)">{t.instLine4}</text>
    <text x="600" y="282" text-anchor="middle" font-size="12" fill="var(--ink)">{t.instLine5}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
