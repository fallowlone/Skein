---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Cookie flags: HttpOnly blocks JavaScript reads, Secure restricts to HTTPS, SameSite Lax defends against CSRF",
    headline: "COOKIE FLAGS ARE THE BOUNDARY",
    sub: "each flag closes one specific hole",
    tag1: "XSS",
    tag2: "network",
    tag3: "CSRF",
    r1t: "HttpOnly",
    r1d: "JavaScript cannot read document.cookie — session survives XSS",
    r2t: "Secure",
    r2d: "sent over HTTPS only — never leaks on plaintext",
    r3t: "SameSite=Lax",
    r3d: "cross-site sends blocked — first line vs CSRF; None requires Secure",
    flow: "browser auto-attaches the cookie — CSRF risk, handled separately",
    foot: "__Host- + Path=/ + no Domain pins the cookie to the origin",
    caption:
      "HttpOnly hides the session from JavaScript, Secure keeps it off plaintext HTTP, and SameSite=Lax blocks cross-site sends — with the __Host- prefix pinning the cookie to the exact origin.",
  },
  ru: {
    svgTitle: "Флаги куки: HttpOnly закрывает чтение из JavaScript, Secure ограничивает HTTPS, SameSite Lax защищает от CSRF",
    headline: "ФЛАГИ КУКИ — ЭТО ГРАНИЦА",
    sub: "каждый флаг закрывает конкретную дыру",
    tag1: "XSS",
    tag2: "сеть",
    tag3: "CSRF",
    r1t: "HttpOnly",
    r1d: "JavaScript не читает document.cookie — сессия переживает XSS",
    r2t: "Secure",
    r2d: "отправка только по HTTPS — не утечёт открытым текстом",
    r3t: "SameSite=Lax",
    r3d: "межсайтовая отправка закрыта — первая линия против CSRF; None требует Secure",
    flow: "браузер прикрепляет куку сам — CSRF-риск, закрывается отдельно",
    foot: "__Host- + Path=/ + без Domain привязывает куку к origin",
    caption:
      "HttpOnly прячет сессию от JavaScript, Secure держит её вне открытого HTTP, а SameSite=Lax режет межсайтовую отправку — с префиксом __Host- кука привязана к точному origin.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="ns9-arrow" viewBox="0 0 8 8" refX="8" refY="4" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0,0 L8,4 L0,8 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="32" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="56" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="108" y="122" text-anchor="end" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="130" y="96" width="560" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="160" y="121" font-size="12" fill="var(--ink)">{t.r1t}</text>
    <text x="160" y="143" font-size="11" fill="var(--ink)">{t.r1d}</text>

    <text x="108" y="194" text-anchor="end" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="130" y="168" width="560" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="160" y="193" font-size="12" fill="var(--ink)">{t.r2t}</text>
    <text x="160" y="215" font-size="11" fill="var(--ink)">{t.r2d}</text>

    <text x="108" y="266" text-anchor="end" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="130" y="240" width="560" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="160" y="265" font-size="12" fill="var(--ink)">{t.r3t}</text>
    <text x="160" y="287" font-size="11" fill="var(--ink)">{t.r3d}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.flow}</text>
    <line x1="200" y1="352" x2="600" y2="352" stroke="var(--muted)" stroke-width="2" marker-end="url(#ns9-arrow)" />
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
