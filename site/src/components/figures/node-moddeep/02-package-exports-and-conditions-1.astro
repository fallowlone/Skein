---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Conditional exports order: types, then import, then require, then default — Node walks keys top to bottom and takes the first match",
    headline: "CONDITIONS: FIRST MATCH WINS",
    sub: "Node walks keys top to bottom — order is the contract",
    condTypes: "types → ./dist/index.d.ts",
    whyTypes: "tooling reads before code runs",
    noteTypes: "TS check time",
    condImport: "import → ./dist/index.mjs",
    whyImport: "ESM via import / import()",
    noteImport: "ESM build",
    condRequire: "require → ./dist/index.cjs",
    whyRequire: "CJS via require()",
    noteRequire: "CJS build",
    condDefault: "default → ./dist/index.mjs",
    whyDefault: "catch-all — always last",
    noteDefault: "fallback",
    foot: "default above require shadows it for every consumer",
    caption:
      "A conditions object is walked top to bottom and the first matching key wins: types first so tooling finds declarations, then import and require for the ESM and CJS builds, with default last as the catch-all.",
  },
  ru: {
    svgTitle: "Порядок условных экспортов: сначала types, затем import, затем require, затем default — Node идёт по ключам сверху вниз и берёт первое совпадение",
    headline: "УСЛОВИЯ: ВЫИГРЫВАЕТ ПЕРВОЕ",
    sub: "Node идёт сверху вниз — порядок значим",
    condTypes: "types → ./dist/index.d.ts",
    whyTypes: "инструменты читают до запуска",
    noteTypes: "время проверки",
    condImport: "import → ./dist/index.mjs",
    whyImport: "ESM через import / import()",
    noteImport: "ESM-сборка",
    condRequire: "require → ./dist/index.cjs",
    whyRequire: "CJS через require()",
    noteRequire: "CJS-сборка",
    condDefault: "default → ./dist/index.mjs",
    whyDefault: "заглушка — всегда последняя",
    noteDefault: "запасной вход",
    foot: "default выше require затмит его",
    caption:
      "Объект условий проходится сверху вниз и выигрывает первый совпавший ключ: types первым, чтобы инструменты нашли декларации, затем import и require для ESM- и CJS-сборок, а default последним как заглушка-перехватчик.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="118" text-anchor="end" font-size="11" fill="var(--muted)">1</text>
    <rect x="170" y="86" width="340" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="340" y="108" text-anchor="middle" font-size="12" fill="var(--ink)">{t.condTypes}</text>
    <text x="340" y="130" text-anchor="middle" font-size="11" fill="var(--muted)">{t.whyTypes}</text>
    <text x="545" y="118" font-size="11" fill="var(--muted)">{t.noteTypes}</text>

    <line x1="340" y1="146" x2="340" y2="160" stroke="var(--muted)" stroke-width="2" />
    <polygon points="340,166 334,156 346,156" fill="var(--muted)" />

    <text x="150" y="196" text-anchor="end" font-size="11" fill="var(--muted)">2</text>
    <rect x="170" y="164" width="340" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="340" y="186" text-anchor="middle" font-size="12" fill="var(--ink)">{t.condImport}</text>
    <text x="340" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.whyImport}</text>
    <text x="545" y="196" font-size="11" fill="var(--muted)">{t.noteImport}</text>

    <line x1="340" y1="224" x2="340" y2="238" stroke="var(--muted)" stroke-width="2" />
    <polygon points="340,244 334,234 346,234" fill="var(--muted)" />

    <text x="150" y="274" text-anchor="end" font-size="11" fill="var(--muted)">3</text>
    <rect x="170" y="242" width="340" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="340" y="264" text-anchor="middle" font-size="12" fill="var(--ink)">{t.condRequire}</text>
    <text x="340" y="286" text-anchor="middle" font-size="11" fill="var(--muted)">{t.whyRequire}</text>
    <text x="545" y="274" font-size="11" fill="var(--muted)">{t.noteRequire}</text>

    <line x1="340" y1="302" x2="340" y2="316" stroke="var(--muted)" stroke-width="2" />
    <polygon points="340,322 334,312 346,312" fill="var(--muted)" />

    <text x="150" y="352" text-anchor="end" font-size="11" fill="var(--muted)">4</text>
    <rect x="170" y="320" width="340" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="340" y="342" text-anchor="middle" font-size="12" fill="var(--ink)">{t.condDefault}</text>
    <text x="340" y="364" text-anchor="middle" font-size="11" fill="var(--muted)">{t.whyDefault}</text>
    <text x="545" y="352" font-size="11" fill="var(--muted)">{t.noteDefault}</text>

    <text x="400" y="402" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
