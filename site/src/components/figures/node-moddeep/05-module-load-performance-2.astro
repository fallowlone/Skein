---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Cold-start cost breakdown: resolution I/O with tens of thousands of stat calls, V8 parse plus compile at 20 to 40 percent of startup, and top-level evaluation",
    headline: "WHERE THE COLD-START SECONDS GO",
    sub: "three phases before your first line runs",
    tagResolve: "resolution I/O",
    resolveLine1: "2,000 modules = 10,000s of stat() / open()",
    resolveLine2: "probing, not reading — cold fs pays most",
    tagCompile: "parse + compile",
    compileLine1: "V8 CPU on every boot",
    compileLine2: "often 20–40% of CLI startup",
    tagEval: "evaluation",
    evalLine1: "top-level code runs every start",
    evalLine2: "tables, plugins, clients",
    foot1: "bundling collapses resolution; cache cuts compile; snapshot skips eval",
    foot2: "each fix targets one phase — profile first",
    caption:
      "Cold start lives in three phases: resolution I/O (tens of thousands of stat() probes), V8 parse+compile (often 20–40% of startup), and evaluation of top-level code. Bundling, compile cache, and snapshots each cut a different one.",
  },
  ru: {
    svgTitle: "Разбивка стоимости холодного старта: I/O разрешения с десятками тысяч вызовов stat, парсинг и компиляция V8 в 20–40 процентов старта и eval верхнего уровня",
    headline: "КУДА УХОДЯТ СЕКУНДЫ СТАРТА",
    sub: "три фазы до первой строки твоего кода",
    tagResolve: "I/O разрешения",
    resolveLine1: "2000 модулей = десятки тыс. stat() / open()",
    resolveLine2: "прощупывание, не чтение — платит холодная fs",
    tagCompile: "парсинг + компиляция",
    compileLine1: "CPU V8 на каждой загрузке",
    compileLine2: "часто 20–40% старта CLI",
    tagEval: "eval",
    evalLine1: "код верха бежит на каждом старте",
    evalLine2: "таблицы, плагины, клиенты",
    foot1: "сборка схлопывает разрешение; кэш режет компиляцию; снапшот пропускает eval",
    foot2: "каждый фикс бьёт по своей фазе — сначала профилируй",
    caption:
      "Холодный старт живёт в трёх фазах: I/O разрешения (десятки тысяч проверок stat()), парсинг и компиляция V8 (часто 20–40% старта) и eval кода верхнего уровня. Сборка, кэш компиляции и снапшоты режут каждая свою.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagResolve}</text>
    <rect x="170" y="104" width="560" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="450" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.resolveLine1}</text>
    <text x="450" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resolveLine2}</text>

    <text x="150" y="226" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagCompile}</text>
    <rect x="170" y="194" width="380" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="360" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.compileLine1}</text>
    <text x="360" y="244" text-anchor="middle" font-size="11" fill="var(--muted)">{t.compileLine2}</text>

    <text x="150" y="316" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagEval}</text>
    <rect x="170" y="284" width="280" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="310" y="312" text-anchor="middle" font-size="12" fill="var(--ink)">{t.evalLine1}</text>
    <text x="310" y="334" text-anchor="middle" font-size="11" fill="var(--muted)">{t.evalLine2}</text>

    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="404" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
