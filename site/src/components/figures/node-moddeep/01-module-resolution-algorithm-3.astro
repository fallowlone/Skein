---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "CommonJS versus ESM resolution: probed extensions and index fallback against mandatory extensions and URL resolution",
    headline: "CJS GUESSES — ESM REQUIRES",
    sub: "same specifier, two different algorithms",
    colCjs: "CommonJS require()",
    colEsm: "ESM import",
    r1l: "extension: probed",
    r1r: "extension: mandatory",
    r2l: "index.js fallback: yes",
    r2r: "index.js fallback: no",
    r3l: "resolves to a path",
    r3r: "resolves to a URL",
    r4l: "bare entry: main",
    r4r: "bare entry: exports",
    r5l: 'builtin: require("fs")',
    r5r: 'builtin: "node:fs"',
    foot1: '"./parser" works in CJS, throws ERR_MODULE_NOT_FOUND in ESM',
    foot2: "write the full filename — ./parser.js",
    caption:
      "CJS probes extensions and falls back to index.js while ESM demands the full filename and resolves to a URL — which is why './parser' works under require() but throws ERR_MODULE_NOT_FOUND under import.",
  },
  ru: {
    svgTitle: "Разрешение CommonJS против ESM: пробуемые расширения и откат на index против обязательных расширений и разрешения в URL",
    headline: "CJS УГАДЫВАЕТ — ESM ТРЕБУЕТ",
    sub: "один спецификатор, два разных алгоритма",
    colCjs: "CommonJS require()",
    colEsm: "ESM import",
    r1l: "расширение: пробуется",
    r1r: "расширение: обязательно",
    r2l: "откат на index.js: да",
    r2r: "откат на index.js: нет",
    r3l: "разрешается в путь",
    r3r: "разрешается в URL",
    r4l: "вход пакета: main",
    r4r: "вход пакета: exports",
    r5l: 'встроенный: require("fs")',
    r5r: 'встроенный: "node:fs"',
    foot1: '"./parser" работает в CJS, в ESM бросает ERR_MODULE_NOT_FOUND',
    foot2: "пиши полное имя файла — ./parser.js",
    caption:
      "CJS пробует расширения и откатывается на index.js, а ESM требует полное имя файла и разрешается в URL — поэтому './parser' работает под require(), но бросает ERR_MODULE_NOT_FOUND под import.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="225" y="92" text-anchor="middle" font-family="var(--font-display)" font-size="15" fill="var(--ink)">{t.colCjs}</text>
    <text x="575" y="92" text-anchor="middle" font-family="var(--font-display)" font-size="15" fill="var(--ink)">{t.colEsm}</text>

    <rect x="70" y="104" width="310" height="36" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="225" y="127" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r1l}</text>
    <rect x="420" y="104" width="310" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="575" y="127" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r1r}</text>

    <rect x="70" y="148" width="310" height="36" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="225" y="171" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r2l}</text>
    <rect x="420" y="148" width="310" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="575" y="171" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r2r}</text>

    <rect x="70" y="192" width="310" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="225" y="215" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r3l}</text>
    <rect x="420" y="192" width="310" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="575" y="215" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r3r}</text>

    <rect x="70" y="236" width="310" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="225" y="259" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r4l}</text>
    <rect x="420" y="236" width="310" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="575" y="259" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r4r}</text>

    <rect x="70" y="280" width="310" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="225" y="303" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r5l}</text>
    <rect x="420" y="280" width="310" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="575" y="303" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r5r}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
