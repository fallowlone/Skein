---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Hooks only affect modules loaded after register runs, so registration must come first; handled requests need shortCircuit, transforms need source maps, and config crosses off-thread via data plus initialize",
    headline: "REGISTER FIRST — HOOKS SEE ONLY WHAT LOADS AFTER",
    sub: "three gotchas that bite, straight from the lesson",
    regTitle: "register()",
    regSub: "--import runs first",
    midLabel: "before",
    appTitle: "app imports",
    appSub: "hooked only after",
    tagOrder: "order",
    descOrder: "register before own imports, or the app resolves hookless",
    tagCircuit: "shortCircuit",
    descCircuit: "handled it yourself? return shortCircuit: true",
    tagMaps: "source maps",
    descMaps: "transformed bytes? emit inline source maps",
    tagThread: "off-thread",
    descThread: "config in via data + initialize, never globals",
    caption:
      "Hooks only affect modules loaded after register runs, so registration must happen before the app's own imports — which is what --import guarantees. Mark handled requests with shortCircuit: true, emit inline source maps from any transform, and pass config off-thread via data and initialize instead of shared globals.",
  },
  ru: {
    svgTitle: "Хуки влияют только на модули, загруженные после запуска register, так что регистрация должна идти первой; обработанные запросы требуют shortCircuit, трансформации — source maps, а конфиг идёт вне потока через data плюс initialize",
    headline: "РЕГИСТРИРУЙ ПЕРВЫМ — ХУК ВИДИТ ТОЛЬКО ПОЗДНИЕ",
    sub: "три грабли из урока",
    regTitle: "register()",
    regSub: "--import идёт первым",
    midLabel: "до",
    appTitle: "импорты приложения",
    appSub: "под хуком — только после",
    tagOrder: "порядок",
    descOrder: "register — до своих импортов, иначе резолв без хука",
    tagCircuit: "shortCircuit",
    descCircuit: "обработал сам? верни shortCircuit: true",
    tagMaps: "source maps",
    descMaps: "преобразовал байты? выдай source map",
    tagThread: "вне потока",
    descThread: "конфиг — через data + initialize, не глобалы",
    caption:
      "Хуки влияют только на модули, загруженные после запуска register, поэтому регистрация должна произойти до собственных импортов приложения — что и гарантирует --import. Помечай обработанные запросы через shortCircuit: true, выдавай встроенные source maps из любой трансформации, а конфиг передавай вне потока через data и initialize вместо общих глобалов.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="110" y="100" width="230" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="225" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.regTitle}</text>
    <text x="225" y="148" text-anchor="middle" font-size="11" fill="var(--muted)">{t.regSub}</text>

    <line x1="340" y1="132" x2="456" y2="132" stroke="var(--muted)" stroke-width="2" />
    <polygon points="456,126 466,132 456,138" fill="var(--muted)" />
    <text x="403" y="118" text-anchor="middle" font-size="10" fill="var(--muted)">{t.midLabel}</text>

    <rect x="470" y="100" width="230" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="585" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.appTitle}</text>
    <text x="585" y="148" text-anchor="middle" font-size="11" fill="var(--muted)">{t.appSub}</text>

    <line x1="80" y1="192" x2="720" y2="192" stroke="var(--muted)" stroke-width="1" />

    <text x="230" y="232" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagOrder}</text>
    <text x="250" y="232" text-anchor="start" font-size="12" fill="var(--ink)">{t.descOrder}</text>

    <text x="230" y="287" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagCircuit}</text>
    <text x="250" y="287" text-anchor="start" font-size="12" fill="var(--ink)">{t.descCircuit}</text>

    <text x="230" y="342" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagMaps}</text>
    <text x="250" y="342" text-anchor="start" font-size="12" fill="var(--ink)">{t.descMaps}</text>

    <text x="230" y="392" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagThread}</text>
    <text x="250" y="392" text-anchor="start" font-size="12" fill="var(--ink)">{t.descThread}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
