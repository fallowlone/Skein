---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Dual-package hazard: the import condition resolves to the ESM build and the require condition to the CJS build, so one app loads two divergent instances with separate state",
    headline: "ONE PACKAGE, TWO INSTANCES",
    sub: "import reaches the .mjs build, require reaches the .cjs build",
    loadImport: 'import "mylib"',
    targetImport: "→ dist/index.mjs",
    instImport: "instance A: own registry",
    loadRequire: 'require("mylib")',
    targetRequire: "→ dist/index.cjs",
    instRequire: "instance B: own registry",
    stateA: "registry — A",
    stateB: "r2 — B",
    verdict: "registry !== r2 — two states, the hazard",
    fix: "fix: ship a single instance",
    fix2: "ESM-only, or core + wrapper",
    caption:
      "When both builds carry state, ESM consumers get instance A from the import target while CJS consumers get instance B from the require target: singletons double and instanceof breaks. Ship a single instance instead.",
  },
  ru: {
    svgTitle: "Dual-package hazard: условие import разрешается в ESM-сборку, а условие require — в CJS-сборку, и приложение загружает два расходящихся экземпляра с раздельным состоянием",
    headline: "ОДИН ПАКЕТ, ДВА ЭКЗЕМПЛЯРА",
    sub: "import достигает .mjs-сборки, require — .cjs-сборки",
    loadImport: 'import "mylib"',
    targetImport: "→ dist/index.mjs",
    instImport: "экземпляр A: свой реестр",
    loadRequire: 'require("mylib")',
    targetRequire: "→ dist/index.cjs",
    instRequire: "экземпляр B: свой реестр",
    stateA: "registry — A",
    stateB: "r2 — B",
    verdict: "registry !== r2 — два состояния",
    fix: "выход: один экземпляр",
    fix2: "только ESM или ядро + обёртка",
    caption:
      "Когда обе сборки несут состояние, ESM-потребители получают экземпляр A из цели import, а CJS-потребители — экземпляр B из цели require: синглтоны двоятся, а instanceof ломается. Поставляй один экземпляр.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="96" width="300" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.loadImport}</text>
    <text x="210" y="152" text-anchor="middle" font-size="11" fill="var(--muted)">{t.targetImport}</text>
    <text x="210" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.instImport}</text>

    <rect x="440" y="96" width="300" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.loadRequire}</text>
    <text x="590" y="152" text-anchor="middle" font-size="11" fill="var(--muted)">{t.targetRequire}</text>
    <text x="590" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.instRequire}</text>

    <line x1="210" y1="200" x2="210" y2="222" stroke="var(--muted)" stroke-width="2" />
    <polygon points="210,228 204,218 216,218" fill="var(--muted)" />
    <line x1="590" y1="200" x2="590" y2="222" stroke="var(--muted)" stroke-width="2" />
    <polygon points="590,228 584,218 596,218" fill="var(--muted)" />

    <rect x="60" y="232" width="300" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="210" y="266" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stateA}</text>

    <text x="400" y="272" text-anchor="middle" font-size="24" fill="var(--accent)">≠</text>

    <rect x="440" y="232" width="300" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="590" y="266" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stateB}</text>

    <text x="400" y="326" text-anchor="middle" font-size="12" fill="var(--ink)">{t.verdict}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fix}</text>
    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fix2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
