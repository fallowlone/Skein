---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The node_modules upward walk: require('lodash') from /app/src/api/handler.js climbs the tree until /app/node_modules/lodash is found",
    headline: "BARE NAMES CLIMB THE TREE",
    sub: "require('lodash') from /app/src/api/handler.js",
    p1: "/app/src/api/node_modules/lodash",
    p2: "/app/src/node_modules/lodash",
    p3: "/app/node_modules/lodash",
    p4: "/node_modules/lodash",
    miss: "miss — go up",
    hit: "found here",
    skip: "only if still missing",
    foot1: "installed at the root is visible to nested files",
    foot2: "nearest copy wins — two depths can hold two copies",
    caption:
      "A bare specifier walks node_modules upward from the importing file, and the nearest copy wins — which is why root installs are visible below and why two depths can hold two copies of one library.",
  },
  ru: {
    svgTitle: "Обход node_modules вверх: require('lodash') из /app/src/api/handler.js карабкается по дереву, пока не найдёт /app/node_modules/lodash",
    headline: "ГОЛЫЕ ИМЕНА КАРАБКАЮТСЯ ВВЕРХ",
    sub: "require('lodash') из /app/src/api/handler.js",
    p1: "/app/src/api/node_modules/lodash",
    p2: "/app/src/node_modules/lodash",
    p3: "/app/node_modules/lodash",
    p4: "/node_modules/lodash",
    miss: "промах — выше",
    hit: "найдено здесь",
    skip: "только если не найдено",
    foot1: "установленное в корне видно вложенным файлам",
    foot2: "побеждает ближайшая копия — две глубины, две копии",
    caption:
      "Голый спецификатор идёт по node_modules вверх от импортирующего файла, и побеждает ближайшая копия — поэтому корневые установки видны ниже, а две глубины могут держать две копии одной библиотеки.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="120" y="92" width="440" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="340" y="119" text-anchor="middle" font-size="12" fill="var(--ink)">{t.p1}</text>
    <text x="580" y="119" text-anchor="start" font-size="11" fill="var(--muted)">{t.miss}</text>

    <text x="340" y="158" text-anchor="middle" font-size="14" fill="var(--muted)">▲</text>

    <rect x="120" y="168" width="440" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="340" y="195" text-anchor="middle" font-size="12" fill="var(--ink)">{t.p2}</text>
    <text x="580" y="195" text-anchor="start" font-size="11" fill="var(--muted)">{t.miss}</text>

    <text x="340" y="234" text-anchor="middle" font-size="14" fill="var(--muted)">▲</text>

    <rect x="120" y="244" width="440" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="340" y="271" text-anchor="middle" font-size="12" fill="var(--ink)">{t.p3}</text>
    <text x="580" y="271" text-anchor="start" font-size="11" fill="var(--accent)">{t.hit}</text>

    <text x="340" y="310" text-anchor="middle" font-size="14" fill="var(--muted)">▲</text>

    <rect x="120" y="320" width="440" height="30" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="340" y="340" text-anchor="middle" font-size="11" fill="var(--muted)">{t.p4}</text>
    <text x="580" y="340" text-anchor="start" font-size="11" fill="var(--muted)">{t.skip}</text>

    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="404" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
