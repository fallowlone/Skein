---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "require() of an ES module runs synchronously and returns the namespace object when the graph has no top-level await, but throws ERR_REQUIRE_ASYNC_MODULE when top-level await is present",
    headline: "REQUIRE(ESM): SYNC ONLY",
    sub: "no top-level await anywhere in the graph",
    okTitle: "no TLA — sync",
    okLine1: "require() runs it inline",
    okLine2: "returns namespace object",
    okLine3: "ns.port + ns.default",
    badTitle: "TLA — async",
    badLine1: "throws ERR_REQUIRE_ASYNC_MODULE",
    badLine2: "a sync require cannot wait",
    fixLine1: "fix: await import()",
    fixLine2: "inside an async function",
    foot: "TLA in a library is breaking for require() callers",
    caption:
      "require() of an ES module succeeds only when the graph has no top-level await, returning the namespace object with named exports as members and the default under .default; any top-level await throws ERR_REQUIRE_ASYNC_MODULE, fixed with await import().",
  },
  ru: {
    svgTitle: "require() ES-модуля выполняется синхронно и возвращает объект пространства имён, если в графе нет top-level await, а при его наличии бросает ERR_REQUIRE_ASYNC_MODULE",
    headline: "REQUIRE(ESM): ТОЛЬКО СИНХРОННО",
    sub: "нигде в графе нет top-level await",
    okTitle: "без TLA — синхронно",
    okLine1: "require() выполняет на месте",
    okLine2: "возвращает объект namespace",
    okLine3: "ns.port + ns.default",
    badTitle: "с TLA — асинхронно",
    badLine1: "бросает ERR_REQUIRE_ASYNC_MODULE",
    badLine2: "синхронный require ждать не умеет",
    fixLine1: "решение: await import()",
    fixLine2: "внутри асинхронной функции",
    foot: "TLA в библиотеке ломает require()",
    caption:
      "require() ES-модуля успешен, лишь когда в графе нет top-level await, и возвращает объект пространства имён: имена как члены, default под .default; любой top-level await бросает ERR_REQUIRE_ASYNC_MODULE, решение — await import().",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="104" width="320" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="220" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.okTitle}</text>
    <text x="220" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.okLine1}</text>
    <text x="220" y="186" text-anchor="middle" font-size="12" fill="var(--ink)">{t.okLine2}</text>
    <text x="220" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.okLine3}</text>

    <rect x="420" y="104" width="320" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="580" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.badTitle}</text>
    <text x="580" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.badLine1}</text>
    <text x="580" y="186" text-anchor="middle" font-size="12" fill="var(--ink)">{t.badLine2}</text>
    <text x="580" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixLine1}</text>
    <text x="580" y="234" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fixLine2}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
