---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A specifier walks the resolve chain to a URL, then the load chain to source bytes a hook may transform before V8 evaluates them",
    headline: "RESOLVE PICKS THE FILE, LOAD BUILDS THE BYTES",
    sub: "each hook handles it or passes it down via next…",
    stImport: "import 'x.ts'",
    stImportSub: "specifier",
    stResolve: "resolve",
    stResolveSub: "specifier → URL",
    stLoad: "load",
    stLoadSub: "URL → source",
    stTransform: "transform",
    stTransformSub: "TS → JS + map",
    stV8: "V8",
    stV8Sub: "evaluates",
    e1: "nextResolve",
    e2: "url + format",
    e3: "nextLoad",
    e4: "source + map",
    rowPass: "not yours → return nextLoad(url, context)",
    rowHandle: "yours → return { format, source, shortCircuit: true }",
    foot1: "hooks compose — each handles its own, defers the rest",
    foot2: "drop the source map and every trace points at compiled output",
    caption:
      "Each specifier walks the resolve chain to a URL plus format, then the load chain to source bytes a hook may transform before V8 evaluates them. A hook either handles the request with shortCircuit or defers with nextResolve / nextLoad — and a transform that drops the source map breaks every stack trace.",
  },
  ru: {
    svgTitle: "Спецификатор проходит цепочку resolve до URL, затем цепочку load до байтов исходника, которые хук может преобразовать до того, как их увидит V8",
    headline: "RESOLVE НАХОДИТ ФАЙЛ, LOAD ГОТОВИТ БАЙТЫ",
    sub: "каждый хук обрабатывает или передаёт дальше через next…",
    stImport: "import 'x.ts'",
    stImportSub: "спецификатор",
    stResolve: "resolve",
    stResolveSub: "спецификатор → URL",
    stLoad: "load",
    stLoadSub: "URL → исходник",
    stTransform: "transform",
    stTransformSub: "TS → JS + map",
    stV8: "V8",
    stV8Sub: "выполняет",
    e1: "nextResolve",
    e2: "url + format",
    e3: "nextLoad",
    e4: "source + map",
    rowPass: "не твоё → верни nextLoad(url, context)",
    rowHandle: "твоё → верни { format, source, shortCircuit: true }",
    foot1: "хуки компонуются — каждый берёт своё, остальное дальше",
    foot2: "потеряешь source map — и каждый трейс указывает мимо",
    caption:
      "Каждый спецификатор проходит цепочку resolve до URL плюс format, затем цепочку load до байтов исходника, которые хук может преобразовать до того, как их увидит V8. Хук либо обрабатывает запрос через shortCircuit, либо делегирует через nextResolve / nextLoad — а трансформация без source map ломает каждый трейс.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="24" y="100" width="132" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="90" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stImport}</text>
    <text x="90" y="152" text-anchor="middle" font-size="10" fill="var(--muted)">{t.stImportSub}</text>

    <rect x="178" y="100" width="132" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="244" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stResolve}</text>
    <text x="244" y="152" text-anchor="middle" font-size="10" fill="var(--muted)">{t.stResolveSub}</text>

    <rect x="332" y="100" width="132" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="398" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stLoad}</text>
    <text x="398" y="152" text-anchor="middle" font-size="10" fill="var(--muted)">{t.stLoadSub}</text>

    <rect x="486" y="100" width="132" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="552" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stTransform}</text>
    <text x="552" y="152" text-anchor="middle" font-size="10" fill="var(--muted)">{t.stTransformSub}</text>

    <rect x="640" y="100" width="132" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="706" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stV8}</text>
    <text x="706" y="152" text-anchor="middle" font-size="10" fill="var(--muted)">{t.stV8Sub}</text>

    <line x1="156" y1="138" x2="174" y2="138" stroke="var(--muted)" stroke-width="2" />
    <polygon points="174,132 182,138 174,144" fill="var(--muted)" />
    <line x1="310" y1="138" x2="328" y2="138" stroke="var(--muted)" stroke-width="2" />
    <polygon points="328,132 336,138 328,144" fill="var(--muted)" />
    <line x1="464" y1="138" x2="482" y2="138" stroke="var(--muted)" stroke-width="2" />
    <polygon points="482,132 490,138 482,144" fill="var(--muted)" />
    <line x1="618" y1="138" x2="636" y2="138" stroke="var(--muted)" stroke-width="2" />
    <polygon points="636,132 644,138 636,144" fill="var(--muted)" />

    <text x="167" y="196" text-anchor="middle" font-size="10" fill="var(--muted)">{t.e1}</text>
    <text x="321" y="196" text-anchor="middle" font-size="10" fill="var(--muted)">{t.e2}</text>
    <text x="475" y="196" text-anchor="middle" font-size="10" fill="var(--muted)">{t.e3}</text>
    <text x="629" y="196" text-anchor="middle" font-size="10" fill="var(--muted)">{t.e4}</text>

    <rect x="150" y="228" width="500" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="251" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rowPass}</text>

    <rect x="150" y="276" width="500" height="36" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="299" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rowHandle}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="376" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
