---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four cold-start levers ranked cheapest first: lazy require, bundling, NODE_COMPILE_CACHE, and startup snapshot, each with the phase it targets",
    headline: "COLD START: MATCH THE LEVER TO THE PHASE",
    sub: "cheapest first — the wrong lever buys nothing",
    rank1: "1",
    name1: "lazy require",
    phase1: "skips a rare-path dep",
    fx1: "cost paid only if that path runs",
    rank2: "2",
    name2: "bundle (esbuild, ncc)",
    phase2: "kills resolution I/O",
    fx2: "~3s to under 1s — thousands of stat() become one read",
    rank3: "3",
    name3: "NODE_COMPILE_CACHE",
    phase3: "reuses warm bytecode",
    fx3: "compile slice (20-40% of startup) drops ~10x on warm boot",
    rank4: "4",
    name4: "snapshot (--build-snapshot)",
    phase4: "skips eval",
    fx4: "heaviest hammer: no open handles, version-locked blob",
    foot: "profile first (--cpu-prof, NODE_DEBUG=module), then pick the lever",
    caption:
      "Match the lever to the phase your profile names, escalating from cheapest to heaviest: lazy require → bundle → compile cache → snapshot. Each cuts a different phase, so the wrong lever buys nothing.",
  },
  ru: {
    svgTitle: "Четыре рычага холодного старта от дешёвого к тяжёлому: ленивый require, сборка, NODE_COMPILE_CACHE и снапшот старта — каждый со своей фазой",
    headline: "ХОЛОДНЫЙ СТАРТ: РЫЧАГ ПОД ФАЗУ",
    sub: "от дешёвого к тяжёлому — не тот рычаг не даёт ничего",
    rank1: "1",
    name1: "ленивый require",
    phase1: "пропускает редкий путь",
    fx1: "плата, только если путь взят",
    rank2: "2",
    name2: "сборка (esbuild, ncc)",
    phase2: "убивает I/O разрешения",
    fx2: "~3 с до менее 1 с — тысячи stat() в одно чтение",
    rank3: "3",
    name3: "NODE_COMPILE_CACHE",
    phase3: "переиспользует байткод",
    fx3: "доля компиляции (20–40% старта) падает в ~10 раз",
    rank4: "4",
    name4: "снапшот (--build-snapshot)",
    phase4: "пропускает eval",
    fx4: "тяжёлый молот: без дескрипторов, привязка к версии",
    foot: "сначала профилируй (--cpu-prof, NODE_DEBUG=module), потом бери рычаг",
    caption:
      "Подбирай рычаг к фазе, которую называет профиль, наращивая от дешёвого к тяжёлому: ленивый require → сборка → кэш компиляции → снапшот. Каждый режет свою фазу, поэтому не тот рычаг не даёт ничего.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="80" width="680" height="62" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="100" y="117" text-anchor="middle" font-size="16" fill="var(--accent)">{t.rank1}</text>
    <text x="130" y="107" font-size="12" fill="var(--ink)">{t.name1}</text>
    <text x="130" y="129" font-size="11" fill="var(--muted)">{t.fx1}</text>
    <text x="730" y="117" text-anchor="end" font-size="11" fill="var(--muted)">{t.phase1}</text>

    <rect x="60" y="158" width="680" height="62" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="100" y="195" text-anchor="middle" font-size="16" fill="var(--accent)">{t.rank2}</text>
    <text x="130" y="185" font-size="12" fill="var(--ink)">{t.name2}</text>
    <text x="130" y="207" font-size="11" fill="var(--muted)">{t.fx2}</text>
    <text x="730" y="195" text-anchor="end" font-size="11" fill="var(--muted)">{t.phase2}</text>

    <rect x="60" y="236" width="680" height="62" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="100" y="273" text-anchor="middle" font-size="16" fill="var(--accent)">{t.rank3}</text>
    <text x="130" y="263" font-size="12" fill="var(--ink)">{t.name3}</text>
    <text x="130" y="285" font-size="11" fill="var(--muted)">{t.fx3}</text>
    <text x="730" y="273" text-anchor="end" font-size="11" fill="var(--muted)">{t.phase3}</text>

    <rect x="60" y="314" width="680" height="62" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="100" y="351" text-anchor="middle" font-size="16" fill="var(--accent)">{t.rank4}</text>
    <text x="130" y="341" font-size="12" fill="var(--ink)">{t.name4}</text>
    <text x="130" y="363" font-size="11" fill="var(--muted)">{t.fx4}</text>
    <text x="730" y="351" text-anchor="end" font-size="11" fill="var(--muted)">{t.phase4}</text>

    <text x="400" y="402" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
