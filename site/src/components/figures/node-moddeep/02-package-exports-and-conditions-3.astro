---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "exports seals the package as an outward allow-list while imports defines private hash specifiers that stay inside the package",
    headline: "SEALED OUTWARD, PRIVATE INWARD",
    sub: "exports overrides main — imports never leaves the package",
    colExports: "exports: outward API",
    colImports: "imports: inward aliases",
    exp1: "allow-list, not a hint",
    exp2: "overrides main",
    exp3: '".": ./dist/index.js',
    exp4: '"./package.json" explicit',
    exp5: "unlisted → NOT_EXPORTED",
    imp1: '"#db" — inside only',
    imp2: "never escapes to node_modules",
    imp3: "stable at any file depth",
    imp4: "conditions: node / default",
    imp5: '"#internal/*" pattern',
    foot: "sealed by contract: only published paths are public",
    caption:
      "The exports field seals the package into an allow-list that overrides main, while the imports field defines private hash specifiers that stay inside the package, resolve stably at any depth, and support conditions.",
  },
  ru: {
    svgTitle: "exports запечатывает пакет наружным белым списком, а imports задаёт приватные решётка-спецификаторы, остающиеся внутри пакета",
    headline: "СНАРУЖИ ЗАПЕЧАТАН, ВНУТРИ СВОЁ",
    sub: "exports перекрывает main — imports не покидает пакет",
    colExports: "exports — наружный API",
    colImports: "imports — внутри пакета",
    exp1: "белый список, не подсказка",
    exp2: "перекрывает main",
    exp3: '".": ./dist/index.js',
    exp4: '"./package.json" — явно',
    exp5: "не указан → NOT_EXPORTED",
    imp1: '"#db" — только внутри',
    imp2: "не убегает в node_modules",
    imp3: "стабилен на любой глубине",
    imp4: "условия: node / default",
    imp5: '"#internal/*" — шаблон',
    foot: "запечатан по контракту: публично лишь опубликованное",
    caption:
      "Поле exports запечатывает пакет белым списком, перекрывающим main, а поле imports задаёт приватные решётка-спецификаторы, остающиеся внутри пакета, стабильные на любой глубине и поддерживающие условия.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="104" text-anchor="middle" font-size="14" fill="var(--ink)">{t.colExports}</text>
    <text x="590" y="104" text-anchor="middle" font-size="14" fill="var(--ink)">{t.colImports}</text>

    <rect x="40" y="120" width="340" height="230" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <rect x="420" y="120" width="340" height="230" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />

    <text x="210" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.exp1}</text>
    <text x="590" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.imp1}</text>

    <text x="210" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.exp2}</text>
    <text x="590" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.imp2}</text>

    <text x="210" y="220" text-anchor="middle" font-size="11" fill="var(--ink)">{t.exp3}</text>
    <text x="590" y="220" text-anchor="middle" font-size="11" fill="var(--ink)">{t.imp3}</text>

    <text x="210" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.exp4}</text>
    <text x="590" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.imp4}</text>

    <text x="210" y="288" text-anchor="middle" font-size="11" fill="var(--ink)">{t.exp5}</text>
    <text x="590" y="288" text-anchor="middle" font-size="11" fill="var(--ink)">{t.imp5}</text>

    <text x="210" y="322" text-anchor="middle" font-size="11" fill="var(--muted)">· · ·</text>
    <text x="590" y="322" text-anchor="middle" font-size="11" fill="var(--muted)">· · ·</text>

    <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
