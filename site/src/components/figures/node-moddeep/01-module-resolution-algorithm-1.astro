---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "CommonJS probe order for require('./shapes'): exact file, then .js, .json, .node, then the directory package.json main and index fallbacks, else MODULE_NOT_FOUND",
    headline: "CJS PROBE ORDER: FILE → DIRECTORY → FAIL",
    sub: "require('./shapes') tries each path until one hits",
    s1: "./shapes",
    s2: "./shapes.js",
    s3: "./shapes.json",
    s4: "./shapes.node",
    s5: "./shapes/package.json main",
    s6: "./shapes/index.js · json · node",
    s7: "MODULE_NOT_FOUND",
    tagFile: "as file",
    tagDir: "as directory",
    tagFail: "exhausted",
    foot1: "first path that exists wins — .js shadows .json",
    foot2: "no .ts probing; no index.js means a folder import breaks",
    caption:
      "CJS tries these paths in this exact order and the first that exists wins — which is why a sibling .js shadows .json and why a folder import breaks the moment its index.js is gone.",
  },
  ru: {
    svgTitle: "Порядок проб CommonJS для require('./shapes'): точный файл, затем .js, .json, .node, затем main из package.json директории и откат на index, иначе MODULE_NOT_FOUND",
    headline: "ПОРЯДОК ПРОБ CJS: ФАЙЛ → ПАПКА → ПРОВАЛ",
    sub: "require('./shapes') пробует пути, пока один не сработает",
    s1: "./shapes",
    s2: "./shapes.js",
    s3: "./shapes.json",
    s4: "./shapes.node",
    s5: "./shapes/package.json main",
    s6: "./shapes/index.js · json · node",
    s7: "MODULE_NOT_FOUND",
    tagFile: "как файл",
    tagDir: "как директория",
    tagFail: "исчерпано",
    foot1: "побеждает первый существующий — .js затеняет .json",
    foot2: "нет пробы .ts; без index.js импорт папки ломается",
    caption:
      "CJS пробует эти пути ровно в этом порядке, и побеждает первый существующий — поэтому соседний .js затеняет .json, а импорт папки ломается, как только пропадает её index.js.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="132" y="108" text-anchor="end" font-size="11" fill="var(--muted)">1</text>
    <rect x="150" y="88" width="390" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="345" y="108" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s1}</text>
    <text x="560" y="108" text-anchor="start" font-size="11" fill="var(--muted)">{t.tagFile}</text>

    <text x="132" y="144" text-anchor="end" font-size="11" fill="var(--muted)">2</text>
    <rect x="150" y="124" width="390" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="345" y="144" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s2}</text>
    <text x="560" y="144" text-anchor="start" font-size="11" fill="var(--muted)">{t.tagFile}</text>

    <text x="132" y="180" text-anchor="end" font-size="11" fill="var(--muted)">3</text>
    <rect x="150" y="160" width="390" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="345" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s3}</text>
    <text x="560" y="180" text-anchor="start" font-size="11" fill="var(--muted)">{t.tagFile}</text>

    <text x="132" y="216" text-anchor="end" font-size="11" fill="var(--muted)">4</text>
    <rect x="150" y="196" width="390" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="345" y="216" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s4}</text>
    <text x="560" y="216" text-anchor="start" font-size="11" fill="var(--muted)">{t.tagFile}</text>

    <text x="132" y="252" text-anchor="end" font-size="11" fill="var(--muted)">5</text>
    <rect x="150" y="232" width="390" height="30" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="345" y="252" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s5}</text>
    <text x="560" y="252" text-anchor="start" font-size="11" fill="var(--muted)">{t.tagDir}</text>

    <text x="132" y="288" text-anchor="end" font-size="11" fill="var(--muted)">6</text>
    <rect x="150" y="268" width="390" height="30" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="345" y="288" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s6}</text>
    <text x="560" y="288" text-anchor="start" font-size="11" fill="var(--muted)">{t.tagDir}</text>

    <text x="132" y="324" text-anchor="end" font-size="11" fill="var(--muted)">7</text>
    <rect x="150" y="304" width="390" height="30" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="345" y="324" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s7}</text>
    <text x="560" y="324" text-anchor="start" font-size="11" fill="var(--muted)">{t.tagFail}</text>

    <text x="400" y="366" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="390" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
