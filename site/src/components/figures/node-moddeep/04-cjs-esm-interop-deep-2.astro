---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Import of a CommonJS module makes module.exports the default export while the static cjs-module-lexer guesses named exports and misses dynamically assigned ones",
    headline: "IMPORT(CJS): THE STATIC LEXER",
    sub: "module.exports becomes the default export",
    seenTitle: "lexer sees — static",
    seenLine1: "exports.foo = …",
    seenLine2: "module.exports = { foo }",
    seenLine3: "named import works",
    missTitle: "lexer misses — dynamic",
    missLine1: "module.exports[name] = …",
    missLine2: "Object.assign(exports, …)",
    missLine3: "named import is undefined",
    foot1: "fix: default-import, then destructure",
    foot2: "import pkg from x; const { foo } = pkg",
    caption:
      "ESM import of CommonJS turns module.exports into the default export and relies on the static cjs-module-lexer for named exports: it sees syntactic assignments but misses dynamic ones, so the named import is undefined — default-import then destructure instead.",
  },
  ru: {
    svgTitle: "Import CommonJS-модуля делает module.exports default-экспортом, а статический cjs-module-lexer угадывает именованные экспорты и не видит динамически присвоенные",
    headline: "IMPORT(CJS): СТАТИЧЕСКИЙ ЛЕКСЕР",
    sub: "module.exports становится default-экспортом",
    seenTitle: "лексер видит — статика",
    seenLine1: "exports.foo = …",
    seenLine2: "module.exports = { foo }",
    seenLine3: "именованный импорт работает",
    missTitle: "лексер не видит — динамика",
    missLine1: "module.exports[name] = …",
    missLine2: "Object.assign(exports, …)",
    missLine3: "именованный импорт — undefined",
    foot1: "фикс: default-импорт и деструктуризация",
    foot2: "import pkg from x; const { foo } = pkg",
    caption:
      "Import CommonJS из ESM превращает module.exports в default-экспорт и опирается на статический cjs-module-lexer для именованных экспортов: синтаксические присваивания он видит, а динамические — нет, поэтому именованный импорт даёт undefined; default-импортируй, затем деструктурируй.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="104" width="320" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="220" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.seenTitle}</text>
    <text x="220" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.seenLine1}</text>
    <text x="220" y="186" text-anchor="middle" font-size="12" fill="var(--ink)">{t.seenLine2}</text>
    <text x="220" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.seenLine3}</text>

    <rect x="420" y="104" width="320" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="580" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.missTitle}</text>
    <text x="580" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.missLine1}</text>
    <text x="580" y="186" text-anchor="middle" font-size="12" fill="var(--ink)">{t.missLine2}</text>
    <text x="580" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.missLine3}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
