---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Transpiler interop uses an __esModule shim that native ESM lacks, a dual CJS-plus-ESM package loads as two instances, and ESM replaces missing globals with import.meta.url and createRequire",
    headline: "THREE INTEROP TRAPS",
    sub: "shim, double instance, missing globals",
    box1Title: "__esModule shim",
    box1Line1: "transpiler: shim on",
    box1Line2: "native ESM: no shim",
    box1Line3: "verify under native ESM",
    box2Title: "dual package x2",
    box2Line1: "require + import diverge",
    box2Line2: "instanceof breaks",
    box2Line3: "singleton runs twice",
    box3Title: "no CJS globals",
    box3Line1: "no __dirname / require",
    box3Line2: "use import.meta.url",
    box3Line3: "createRequire(import.meta.url)",
    foot: "TLA serializes boot; if (DEBUG) require has no static import",
    caption:
      "Transpiled ESM hides the shape mismatch behind an __esModule shim that native ESM lacks; a package shipped as both CJS and ESM loads as two divergent instances breaking instanceof and doubling singletons; and ESM has no __dirname or require — use import.meta.url plus createRequire.",
  },
  ru: {
    svgTitle: "Interop транспайлера использует шим __esModule, которого нет в нативном ESM, двойной CJS- и ESM-пакет грузится как два экземпляра, а в ESM нет глобалей — их заменяют import.meta.url и createRequire",
    headline: "ТРИ ЛОВУШКИ INTEROP",
    sub: "шим, двойной экземпляр, нет глобалей",
    box1Title: "шим __esModule",
    box1Line1: "транспайлер: шим есть",
    box1Line2: "нативный ESM: шима нет",
    box1Line3: "проверяй под нативным ESM",
    box2Title: "двойной пакет x2",
    box2Line1: "require и import расходятся",
    box2Line2: "instanceof ломается",
    box2Line3: "синглтон стартует дважды",
    box3Title: "нет CJS-глобалей",
    box3Line1: "нет __dirname / require",
    box3Line2: "используй import.meta.url",
    box3Line3: "createRequire(import.meta.url)",
    foot: "TLA сериализует старт; у if require нет import",
    caption:
      "Транспилированный ESM прячет несовпадение формы за шимом __esModule, которого нет в нативном ESM; пакет, поставленный и как CJS, и как ESM, грузится как два расходящихся экземпляра, ломая instanceof и удваивая синглтоны; а в ESM нет __dirname и require — используй import.meta.url плюс createRequire.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="50" y="104" width="220" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="160" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box1Title}</text>
    <text x="160" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Line1}</text>
    <text x="160" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Line2}</text>
    <text x="160" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Line3}</text>

    <rect x="290" y="104" width="220" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box2Title}</text>
    <text x="400" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Line1}</text>
    <text x="400" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Line2}</text>
    <text x="400" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Line3}</text>

    <rect x="530" y="104" width="220" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="640" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box3Title}</text>
    <text x="640" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Line1}</text>
    <text x="640" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Line2}</text>
    <text x="640" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Line3}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
