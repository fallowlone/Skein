---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A transpile-on-load hook adds about 50 milliseconds per file, so startup tax grows linearly: about 5 seconds at 100 files and 20 at 400, paid on every node start",
    headline: "THE HOOK RUNS PER MODULE — THE TAX STACKS LINEARLY",
    sub: "≈50 ms per file, paid on every node start",
    row100: "100 files",
    row200: "200 files",
    row300: "300 files",
    row400: "400 files",
    foot1: "400 files → 12–20 s extra on every cold start",
    foot2: "build for prod, keep hooks for dev",
    caption:
      "The hook runs per module, so the transpile cost stacks linearly across the dependency tree — 12–20 extra seconds for a 400-file app on every cold start. That per-invocation tax is why you build for prod and keep hooks for dev.",
  },
  ru: {
    svgTitle: "Хук транспиляции-на-load добавляет около 50 миллисекунд на файл, так что налог на старт растёт линейно: около 5 секунд на 100 файлах и 20 на 400, на каждом запуске node",
    headline: "ХУК РАБОТАЕТ НА МОДУЛЬ — НАЛОГ РАСТЁТ ЛИНЕЙНО",
    sub: "≈50 мс на файл, платишь на каждом старте",
    row100: "100 файлов",
    row200: "200 файлов",
    row300: "300 файлов",
    row400: "400 файлов",
    foot1: "400 файлов → 12–20 с на каждый холодный старт",
    foot2: "собирай для прода, хуки оставь для dev",
    caption:
      "Хук выполняется для каждого модуля, поэтому стоимость транспиляции складывается линейно по дереву зависимостей — 12–20 лишних секунд для приложения из 400 файлов на каждый холодный старт. Этот налог на каждый запуск и есть причина собирать для прода, а хуки оставлять для dev.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="195" y="129" text-anchor="end" font-size="11" fill="var(--muted)">{t.row100}</text>
    <rect x="215" y="107" width="135" height="36" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="340" y="130" text-anchor="end" font-size="11" fill="var(--ink)">5s</text>

    <text x="195" y="194" text-anchor="end" font-size="11" fill="var(--muted)">{t.row200}</text>
    <rect x="215" y="172" width="270" height="36" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="475" y="195" text-anchor="end" font-size="11" fill="var(--ink)">10s</text>

    <text x="195" y="259" text-anchor="end" font-size="11" fill="var(--muted)">{t.row300}</text>
    <rect x="215" y="237" width="405" height="36" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="260" text-anchor="end" font-size="11" fill="var(--ink)">15s</text>

    <text x="195" y="324" text-anchor="end" font-size="11" fill="var(--muted)">{t.row400}</text>
    <rect x="215" y="302" width="540" height="36" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="745" y="325" text-anchor="end" font-size="11" fill="var(--ink)">20s</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="396" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
