---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Lazy require guidance: eager loading pays for the whole SDK on every cold start, lazy loading inside the function pays only when the path runs",
    headline: "LAZY REQUIRE: PAY ONLY IF THE PATH RUNS",
    sub: "the cheapest second is the one you never spend",
    eagerTag: "EAGER",
    eagerCode: 'require("aws-sdk") at module scope',
    eagerLine1: "whole SDK loads on every cold start",
    eagerLine2: "3–5s start for a path rarely taken",
    lazyTag: "LAZY",
    lazyCode: 'require("aws-sdk") inside the function',
    lazyLine1: "loads only when the path runs",
    lazyLine2: "cached after first call (module cache)",
    foot1: "war story: lazy require + bundle cut ~3s to under 1s",
    foot2: "rare path → defer; hot path → bundle + cache",
    caption:
      "If a heavy dependency is only needed on a rare path, require() it inside the function that uses it: the cost is paid only when that path runs, and the module cache keeps later calls cheap. The war-story fix paired this with bundling to cut cold start from ~3s to under 1s.",
  },
  ru: {
    svgTitle: "Правило ленивого require: жадная загрузка платит за весь SDK на каждом холодном старте, ленивая внутри функции — только когда путь взят",
    headline: "ЛЕНИВЫЙ REQUIRE: ПЛАТИ, ЕСЛИ ПУТЬ ВЗЯТ",
    sub: "самая дешёвая секунда — та, что не потрачена",
    eagerTag: "ЖАДНО",
    eagerCode: 'require("aws-sdk") на уровне модуля',
    eagerLine1: "весь SDK грузится на каждом старте",
    eagerLine2: "старт 3–5 с ради редкого пути",
    lazyTag: "ЛЕНИВО",
    lazyCode: 'require("aws-sdk") внутри функции',
    lazyLine1: "грузится, только когда путь взят",
    lazyLine2: "кэш модулей после 1-го вызова",
    foot1: "бой: ленивый require + сборка: ~3 с до менее 1 с",
    foot2: "редкий путь — отложи; горячий — собери + кэшируй",
    caption:
      "Если тяжёлая зависимость нужна только на редком пути, делай require() внутри функции, которая её использует: стоимость платится, только когда путь выполняется, а кэш модулей удешевляет повторные вызовы. Боевой фикс спарил это со сборкой и срезал холодный старт с ~3 с до менее 1 с.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="110" text-anchor="middle" font-size="11" fill="var(--muted)">{t.eagerTag}</text>
    <rect x="40" y="124" width="320" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="200" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.eagerCode}</text>
    <text x="200" y="210" text-anchor="middle" font-size="11" fill="var(--ink)">{t.eagerLine1}</text>
    <text x="200" y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{t.eagerLine2}</text>
    <text x="200" y="272" text-anchor="middle" font-size="12" fill="var(--muted)">✕</text>

    <line x1="372" y1="209" x2="416" y2="209" stroke="var(--accent)" stroke-width="2" />
    <polygon points="416,201 430,209 416,217" fill="var(--accent)" />

    <text x="600" y="110" text-anchor="middle" font-size="11" fill="var(--muted)">{t.lazyTag}</text>
    <rect x="440" y="124" width="320" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lazyCode}</text>
    <text x="600" y="210" text-anchor="middle" font-size="11" fill="var(--ink)">{t.lazyLine1}</text>
    <text x="600" y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{t.lazyLine2}</text>
    <text x="600" y="272" text-anchor="middle" font-size="12" fill="var(--accent)">✓</text>

    <text x="400" y="340" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="364" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
