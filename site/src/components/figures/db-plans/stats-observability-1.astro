---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Production observability pair: auto_explain logs plans over 500ms, pg_stat_statements ranks targets by total_exec_time",
    headline: "LOG THE PLANS · RANK THE TARGETS",
    sub: "auto_explain catches why · pg_stat_statements says what first",
    leftTitle: "auto_explain",
    leftLines: ["log_min_duration = 500ms", "log_analyze = true", "log_buffers = true", "sample_rate = 0.01"],
    rightTitle: "pg_stat_statements",
    rightLines: ["ORDER BY total_exec_time", "DESC LIMIT 20", "2ms x 10M calls beats", "500ms x 2 calls"],
    foot: "which queries are slow, and why — no application instrumentation",
    caption:
      "Two extensions answer which queries are slow and why: auto_explain logs full ANALYZE plus BUFFERS plans for anything over 500ms at a 1% sample rate, and pg_stat_statements ranks optimisation targets by total_exec_time — a 2ms query called 10M times beats a 500ms one called twice.",
  },
  ru: {
    svgTitle: "Производственная наблюдаемость: auto_explain логирует планы дольше 500мс, pg_stat_statements ранжирует цели по total_exec_time",
    headline: "ЛОГИРУЙ ПЛАНЫ · РАНЖИРУЙ ЦЕЛИ",
    sub: "auto_explain ловит почему · pg_stat_statements говорит что первым",
    leftTitle: "auto_explain",
    leftLines: ["log_min_duration = 500ms", "log_analyze = true", "log_buffers = true", "sample_rate = 0.01"],
    rightTitle: "pg_stat_statements",
    rightLines: ["ORDER BY total_exec_time", "DESC LIMIT 20", "2мс x 10M вызовов важнее", "500мс x 2 вызова"],
    foot: "какие запросы медленные и почему — без инструментирования приложения",
    caption:
      "Два расширения отвечают, какие запросы медленные и почему: auto_explain логирует полные планы ANALYZE плюс BUFFERS для всего дольше 500мс при выборке 1%, а pg_stat_statements ранжирует цели оптимизации по total_exec_time — запрос 2мс, вызванный 10M раз, важнее запроса 500мс, вызванного дважды.",
  },
};

const t = dict[lang];

const lineY = [176, 214, 252, 290];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="100" width="360" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    {t.leftLines.map((l, i) => (
      <g>
        <rect x="55" y={lineY[i] - 26} width="310" height="32" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="210" y={lineY[i] - 5} text-anchor="middle" font-size="11" fill="var(--ink)">{l}</text>
      </g>
    ))}

    <rect x="410" y="100" width="360" height="230" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    {t.rightLines.map((l, i) => (
      <g>
        <rect x="435" y={lineY[i] - 26} width="310" height="32" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="590" y={lineY[i] - 5} text-anchor="middle" font-size="11" fill="var(--ink)">{l}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
