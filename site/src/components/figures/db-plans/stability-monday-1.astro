---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The Monday slowdown: a Sunday batch of 20M rows shifts distributions, Monday is slow on a 1000x underestimated Nested Loop, Tuesday recovers",
    headline: "THE MONDAY SLOWDOWN",
    sub: "batch shifts data · stats lag · planner guesses wrong",
    d1Title: "SUN · +20M ROWS",
    d1Sub: "batch insert shifts data",
    d2Title: "MON · SLOW",
    d2Sub: "Nested Loop 1000x off",
    d3Title: "TUE · FINE",
    d3Sub: "autovacuum caught up",
    fix: "ANALYZE orders in the post-batch hook — incident gone forever",
    caption:
      "A Sunday batch inserts 20M rows and shifts data distributions; by Monday morning autovacuum has not run ANALYZE yet, so the planner picks a Nested Loop on a 1000x underestimated join. By Tuesday autovacuum catches up and the queries are fast again — until ANALYZE in the post-batch hook ends the cycle permanently.",
  },
  ru: {
    svgTitle: "Понедельничное замедление: воскресный батч 20M строк сдвигает данные, понедельник медленный на Nested Loop с ошибкой 1000x, вторник в норме",
    headline: "ПОНЕДЕЛЬНИЧНОЕ ЗАМЕДЛЕНИЕ",
    sub: "батч сдвигает данные · статистика отстаёт · план неверен",
    d1Title: "ВС · +20M СТРОК",
    d1Sub: "батч сдвигает данные",
    d2Title: "ПН · МЕДЛЕННО",
    d2Sub: "Nested Loop мимо в 1000x",
    d3Title: "ВТ · НОРМА",
    d3Sub: "autovacuum догнал",
    fix: "ANALYZE orders в post-batch хуке — инцидент исчез навсегда",
    caption:
      "Воскресный батч вставляет 20M строк и сдвигает распределения данных; к утру понедельника autovacuum ещё не запустил ANALYZE, поэтому планировщик выбирает Nested Loop с недооценкой соединения в 1000x. Ко вторнику autovacuum догоняет и запросы снова быстрые — пока ANALYZE в post-batch хуке не завершит цикл навсегда.",
  },
};

const t = dict[lang];

const dayX = [40, 290, 540];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbplan-monday-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x={dayX[0]} y="110" width="220" height="150" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={dayX[0] + 110} y="150" text-anchor="middle" font-size="15" fill="var(--ink)">{t.d1Title}</text>
    <text x={dayX[0] + 110} y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.d1Sub}</text>

    <line x1="260" y1="185" x2="290" y2="185" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-monday-arrow)" />

    <rect x={dayX[1]} y="110" width="220" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x={dayX[1] + 110} y="150" text-anchor="middle" font-size="15" fill="var(--accent)">{t.d2Title}</text>
    <text x={dayX[1] + 110} y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.d2Sub}</text>

    <line x1="510" y1="185" x2="540" y2="185" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-monday-arrow)" />

    <rect x={dayX[2]} y="110" width="220" height="150" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={dayX[2] + 110} y="150" text-anchor="middle" font-size="15" fill="var(--ink)">{t.d3Title}</text>
    <text x={dayX[2] + 110} y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.d3Sub}</text>

    <rect x="40" y="290" width="720" height="56" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="324" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fix}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
