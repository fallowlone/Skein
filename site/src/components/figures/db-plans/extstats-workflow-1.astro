---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Teach the planner in four steps: find a 10x gap, name the correlated columns, create statistics and analyze, verify within 2x",
    headline: "TEACH THE PLANNER IN 4 STEPS",
    sub: "find the gap · name the correlation · verify the fix",
    stepTitles: ["1 · 10x GAP", "2 · COLUMNS", "3 · CREATE", "4 · VERIFY"],
    stepA: ["EXPLAIN ANALYZE", "zip + city?", "(dependencies, mcv)", "rows within 2x"],
    stepB: ["rows vs actual", "natural hierarchy", "+ ANALYZE", "on the node"],
    foot: "kilobytes stored · 100-1000x better plans on affected queries",
    caption:
      "Close the loop in four steps: spot a node where rows differ from actual by 10x, trace it to naturally correlated columns, create the statistics object and ANALYZE, then re-run EXPLAIN ANALYZE and confirm rows track actual within 2x. Storage costs kilobytes; affected queries gain 100-1000x better plans.",
  },
  ru: {
    svgTitle: "Обучи планировщик за четыре шага: найди разрыв 10x, назови коррелированные колонки, создай статистику и verify в пределах 2x",
    headline: "ОБУЧИ ПЛАНИРОВЩИК ЗА 4 ШАГА",
    sub: "найди разрыв · назови корреляцию · проверь исправление",
    stepTitles: ["1 · РАЗРЫВ 10x", "2 · КОЛОНКИ", "3 · СОЗДАТЬ", "4 · ПРОВЕРКА"],
    stepA: ["EXPLAIN ANALYZE", "zip + city?", "(dependencies, mcv)", "rows в пределах 2x"],
    stepB: ["rows vs actual", "естественная иерархия", "+ ANALYZE", "на узле"],
    foot: "килобайты хранения · планы лучше в 100-1000x на запросах",
    caption:
      "Замкни цикл за четыре шага: найди узел, где rows отличается от факта в 10x, отследи до естественно коррелированных колонок, создай объект статистики и ANALYZE, затем повторно запусти EXPLAIN ANALYZE и убедись, что rows отслеживает факт в пределах 2x. Хранение — килобайты; затронутые запросы получают планы лучше в 100-1000x.",
  },
};

const t = dict[lang];

const wStepX = [30, 215, 400, 585];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbplan-workflow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.stepTitles.map((s, i) => (
      <g>
        <rect x={wStepX[i]} y="110" width="170" height="180" fill={i === 3 ? "var(--paper)" : "var(--card)"} stroke={i === 3 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 3 ? 2.5 : 1.5} />
        <text x={wStepX[i] + 85} y="145" text-anchor="middle" font-size="13" fill="var(--ink)">{s}</text>
        <text x={wStepX[i] + 85} y="195" text-anchor="middle" font-size="11" fill="var(--muted)">{t.stepA[i]}</text>
        <text x={wStepX[i] + 85} y="230" text-anchor="middle" font-size="12" fill={i === 3 ? "var(--accent)" : "var(--ink)"}>{t.stepB[i]}</text>
      </g>
    ))}

    <line x1="200" y1="200" x2="215" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-workflow-arrow)" />
    <line x1="385" y1="200" x2="400" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-workflow-arrow)" />
    <line x1="570" y1="200" x2="585" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-workflow-arrow)" />

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
