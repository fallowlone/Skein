---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "SSD tuning: random_page_cost from 4.0 to 1.1 and effective_cache_size 24GB as 75 percent of RAM",
    headline: "SSD: REPRICE RANDOM I/O",
    sub: "defaults are calibrated for spinning disks",
    leftTitle: "DEFAULT (HDD-ERA)",
    leftA: "random_page_cost = 4.0",
    leftB: "seq_page_cost = 1.0",
    leftC: "Seq Scan bias",
    rightTitle: "SSD TUNED",
    rightA: "random_page_cost = 1.1",
    rightB: "effective_cache_size = 24GB",
    rightC: "~75% of RAM · a hint, not an alloc",
    foot: "the highest-leverage planner setting on modern hardware",
    caption:
      "Postgres ships random_page_cost at 4.0, a spinning-disk compromise; on NVMe SSD random reads cost only 1.5-2x sequential, so set 1.1 and the planner correctly prefers Index Scan for selective predicates. effective_cache_size at 24GB — about 75% of RAM — tells the planner how much data is likely cached; it allocates nothing.",
  },
  ru: {
    svgTitle: "Настройка SSD: random_page_cost с 4.0 на 1.1 и effective_cache_size 24GB как 75 процентов RAM",
    headline: "SSD: ПЕРЕОЦЕНИ СЛУЧАЙНЫЙ I/O",
    sub: "умолчания откалиброваны под вращающиеся диски",
    leftTitle: "УМОЛЧАНИЕ (ЭПОХА HDD)",
    leftA: "random_page_cost = 4.0",
    leftB: "seq_page_cost = 1.0",
    leftC: "смещение к Seq Scan",
    rightTitle: "НАСТРОЙКА SSD",
    rightA: "random_page_cost = 1.1",
    rightB: "effective_cache_size = 24GB",
    rightC: "~75% RAM · подсказка, не выделение",
    foot: "самая эффективная настройка планировщика на современном железе",
    caption:
      "Postgres поставляется с random_page_cost 4.0 — компромиссом эпохи вращающихся дисков; на NVMe SSD случайные чтения стоят лишь в 1.5-2x последовательных, поэтому ставьте 1.1 — и планировщик корректно предпочтёт Index Scan для селективных предикатов. effective_cache_size 24GB — около 75% RAM — говорит планировщику, сколько данных вероятно кешировано; ничего не выделяет.",
  },
};

const t = dict[lang];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbplan-ssd-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="330" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="205" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    <text x="205" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftA}</text>
    <text x="205" y="218" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftB}</text>
    <text x="205" y="260" text-anchor="middle" font-size="13" fill="var(--muted)">{t.leftC}</text>

    <line x1="370" y1="200" x2="414" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-ssd-arrow)" />

    <rect x="414" y="100" width="346" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="587" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    <text x="587" y="182" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightA}</text>
    <text x="587" y="218" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightB}</text>
    <text x="587" y="260" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightC}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
