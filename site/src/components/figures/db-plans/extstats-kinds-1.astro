---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three kinds of extended statistics: dependencies since PG 10, ndistinct since PG 10, mcv since PG 12",
    headline: "THREE KINDS, THREE SYMPTOMS",
    sub: "match the kind to the estimate failure",
    depTitle: "dependencies",
    depVer: "PG 10 · A implies B",
    depEx: "zip -> city",
    ndiTitle: "ndistinct",
    ndiVer: "PG 10 · GROUP BY count",
    ndiEx: "real combo count",
    mcvTitle: "mcv",
    mcvVer: "PG 12 · frequent tuples",
    mcvEx: "(US, shipped) exact",
    foot: "PG 14+: statistics on expressions — WHERE LOWER(email) = x",
    caption:
      "Pick the kind by the symptom: dependencies when one column implies another like zip into city, ndistinct when GROUP BY overestimates the group count, mcv when a frequent combination like US plus shipped is mis-estimated. PG 14 adds statistics on expressions.",
  },
  ru: {
    svgTitle: "Три вида расширенной статистики: dependencies с PG 10, ndistinct с PG 10, mcv с PG 12",
    headline: "ТРИ ВИДА, ТРИ СИМПТОМА",
    sub: "вид — под ошибку оценки",
    depTitle: "dependencies",
    depVer: "PG 10 · A влечёт B",
    depEx: "zip -> city",
    ndiTitle: "ndistinct",
    ndiVer: "PG 10 · счёт GROUP BY",
    ndiEx: "реальное число комбо",
    mcvTitle: "mcv",
    mcvVer: "PG 12 · частые кортежи",
    mcvEx: "(US, shipped) точно",
    foot: "PG 14+: статистика выражений — WHERE LOWER(email) = x",
    caption:
      "Выбирай вид по симптому: dependencies — когда одна колонка влечёт другую вроде zip в city, ndistinct — когда GROUP BY переоценивает число групп, mcv — когда частая комбинация вроде US плюс shipped мимо оценки. PG 14 добавляет статистику выражений.",
  },
};

const t = dict[lang];

const kindX = [30, 285, 540];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x={kindX[0]} y="110" width="230" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={kindX[0] + 115} y="145" text-anchor="middle" font-size="15" fill="var(--ink)">{t.depTitle}</text>
    <text x={kindX[0] + 115} y="190" text-anchor="middle" font-size="11" fill="var(--muted)">{t.depVer}</text>
    <text x={kindX[0] + 115} y="236" text-anchor="middle" font-size="13" fill="var(--accent)">{t.depEx}</text>

    <rect x={kindX[1]} y="110" width="230" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={kindX[1] + 115} y="145" text-anchor="middle" font-size="15" fill="var(--ink)">{t.ndiTitle}</text>
    <text x={kindX[1] + 115} y="190" text-anchor="middle" font-size="11" fill="var(--muted)">{t.ndiVer}</text>
    <text x={kindX[1] + 115} y="236" text-anchor="middle" font-size="12" fill="var(--accent)">{t.ndiEx}</text>

    <rect x={kindX[2]} y="110" width="230" height="180" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x={kindX[2] + 115} y="145" text-anchor="middle" font-size="15" fill="var(--ink)">{t.mcvTitle}</text>
    <text x={kindX[2] + 115} y="190" text-anchor="middle" font-size="11" fill="var(--muted)">{t.mcvVer}</text>
    <text x={kindX[2] + 115} y="236" text-anchor="middle" font-size="12" fill="var(--accent)">{t.mcvEx}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
