---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Anatomy of one plan line: cost 0.43..14.2, rows 42 estimate versus actual 42, loops 1, Index Cond workspace_id = 42",
    headline: "ONE PLAN LINE, FOUR SIGNALS",
    sub: "cost · rows estimate vs actual · loops · index condition",
    line1: "Index Scan using idx_orders_workspace on orders",
    line2: "(cost = 0.43..14.2 rows = 42 width = 120)",
    line3: "(actual time = 0.08..1.1 rows = 42 loops = 1)",
    line4: "Index Cond: (workspace_id = 42)",
    costTitle: "cost 0.43..14.2",
    costSub: "startup..total · ratios only",
    rowsTitle: "rows 42 = actual 42",
    rowsSub: "estimate vs actual — signal",
    loopsTitle: "loops = 1",
    loopsSub: "inner join side: time / loops",
    foot: "10x gap is suspicious · 1000x gap is 8 minutes, not 50ms",
    caption:
      "One plan line carries four signals: startup..total cost in arbitrary units, rows-estimated versus actual, the loops count, and the Index Cond. Read rows versus actual first — a 10x gap is suspicious and a 1000x gap turns 50ms into 8 minutes.",
  },
  ru: {
    svgTitle: "Анатомия одной строки плана: cost 0.43..14.2, rows 42 оценка против факта 42, loops 1, Index Cond workspace_id = 42",
    headline: "ОДНА СТРОКА ПЛАНА, 4 СИГНАЛА",
    sub: "cost · rows оценка vs факт · loops · условие индекса",
    line1: "Index Scan using idx_orders_workspace on orders",
    line2: "(cost = 0.43..14.2 rows = 42 width = 120)",
    line3: "(actual time = 0.08..1.1 rows = 42 loops = 1)",
    line4: "Index Cond: (workspace_id = 42)",
    costTitle: "cost 0.43..14.2",
    costSub: "старт..итог · не миллисекунды",
    rowsTitle: "rows 42 = actual 42",
    rowsSub: "оценка vs реальность — сигнал",
    loopsTitle: "loops = 1",
    loopsSub: "внутри join: время / loops",
    foot: "разрыв 10x подозрителен · 1000x — это 8 минут, а не 50мс",
    caption:
      "Одна строка плана несёт четыре сигнала: стоимость старт..итог в условных единицах, rows-estimated против actual, счётчик loops и Index Cond. Сначала читай rows против факта — разрыв 10x подозрителен, а 1000x превращает 50мс в 8 минут.",
  },
};

const t = dict[lang];

const codeY = [122, 152, 182, 212];
const boxX = [40, 290, 540];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="88" width="720" height="152" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="64" y={codeY[0]} font-size="12" fill="var(--ink)">{t.line1}</text>
    <text x="64" y={codeY[1]} font-size="12" fill="var(--ink)">{t.line2}</text>
    <text x="64" y={codeY[2]} font-size="12" fill="var(--accent)">{t.line3}</text>
    <text x="64" y={codeY[3]} font-size="12" fill="var(--ink)">{t.line4}</text>

    <g>
      <rect x={boxX[0]} y="262" width="220" height="76" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
      <text x={boxX[0] + 110} y="290" text-anchor="middle" font-size="13" fill="var(--ink)">{t.costTitle}</text>
      <text x={boxX[0] + 110} y="314" text-anchor="middle" font-size="11" fill="var(--muted)">{t.costSub}</text>
    </g>
    <g>
      <rect x={boxX[1]} y="262" width="220" height="76" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
      <text x={boxX[1] + 110} y="290" text-anchor="middle" font-size="13" fill="var(--accent)">{t.rowsTitle}</text>
      <text x={boxX[1] + 110} y="314" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rowsSub}</text>
    </g>
    <g>
      <rect x={boxX[2]} y="262" width="220" height="76" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
      <text x={boxX[2] + 110} y="290" text-anchor="middle" font-size="13" fill="var(--ink)">{t.loopsTitle}</text>
      <text x={boxX[2] + 110} y="314" text-anchor="middle" font-size="11" fill="var(--muted)">{t.loopsSub}</text>
    </g>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
