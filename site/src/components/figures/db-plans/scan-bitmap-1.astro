---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Bitmap Heap Scan in two steps: a Bitmap Index Scan builds a bitmap of TIDs, sorts them by page, then reads the heap in order",
    headline: "BITMAP: COLLECT, SORT, THEN READ",
    sub: "scattered random reads become one sequential pass",
    leftTitle: "1 · BITMAP INDEX SCAN",
    leftSub: "builds a bitmap of TIDs",
    orderBefore: ["3rd", "1st", "2nd"],
    midTitle: "SORT",
    midSub: "by page address",
    rightTitle: "2 · BITMAP HEAP SCAN",
    rightSub: "reads the heap in order",
    orderAfter: ["1st", "2nd", "3rd"],
    foot: "BitmapOr merges indexes for OR predicates · between Index and Seq Scan",
    caption:
      "Bitmap Heap Scan works in two steps: a Bitmap Index Scan builds an in-memory bitmap of matching TIDs, then the heap is read in sorted page order — scattered random reads become a near-sequential pass. BitmapOr extends this across indexes for OR predicates.",
  },
  ru: {
    svgTitle: "Bitmap Heap Scan в два шага: Bitmap Index Scan строит карту TID, сортирует по страницам, затем читает кучу по порядку",
    headline: "БИТМАП: СОБРАТЬ → УПОРЯДОЧИТЬ",
    sub: "разрозненные чтения — в один проход по порядку",
    leftTitle: "1 · BITMAP INDEX SCAN",
    leftSub: "строит карту TID",
    orderBefore: ["3-й", "1-й", "2-й"],
    midTitle: "СОРТ",
    midSub: "по адресу страницы",
    rightTitle: "2 · BITMAP HEAP SCAN",
    rightSub: "читает кучу по порядку",
    orderAfter: ["1-й", "2-й", "3-й"],
    foot: "BitmapOr объединяет индексы для OR · между Index и Seq Scan",
    caption:
      "Bitmap Heap Scan работает в два шага: Bitmap Index Scan строит в памяти карту совпадающих TID, затем куча читается в порядке страниц — разрозненные случайные чтения становятся почти последовательным проходом. BitmapOr расширяет это на несколько индексов для OR-предикатов.",
  },
};

const t = dict[lang];

const chipY = [170, 212, 254];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbplan-bitmap-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="100" width="230" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="145" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <text x="145" y="148" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftSub}</text>
    {t.orderBefore.map((o, i) => (
      <g>
        <rect x="60" y={chipY[i]} width="170" height="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="145" y={chipY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">TID · {o}</text>
      </g>
    ))}

    <line x1="260" y1="210" x2="306" y2="210" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-bitmap-arrow)" />
    <rect x="306" y="168" width="188" height="84" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="200" text-anchor="middle" font-size="15" fill="var(--accent)">{t.midTitle}</text>
    <text x="400" y="224" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midSub}</text>
    <line x1="494" y1="210" x2="540" y2="210" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-bitmap-arrow)" />

    <rect x="540" y="100" width="230" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="655" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    <text x="655" y="148" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightSub}</text>
    {t.orderAfter.map((o, i) => (
      <g>
        <rect x="570" y={chipY[i]} width="170" height="34" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="655" y={chipY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">TID · {o}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
