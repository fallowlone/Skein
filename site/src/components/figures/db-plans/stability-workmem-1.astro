---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Sort spilled 450MB to disk as an external merge because work_mem defaults to 4MB; setting 512MB for the session keeps it in memory",
    headline: "SORT SPILLED 450MB TO DISK",
    sub: "work_mem 4MB default — raise it per session",
    leftTitle: "DEFAULT",
    leftA: "work_mem = 4MB",
    leftB: "external merge",
    leftC: "Disk: 450MB",
    rightTitle: "SESSION FIX",
    rightA: "work_mem = 512MB",
    rightB: "in-memory sort",
    rightC: "no disk spill",
    foot: "never raise globally without a max_connections memory budget",
    caption:
      "Sort Method external merge with Disk 450MB means the sort exceeded the 4MB work_mem default and spilled to disk. SET work_mem = 512MB for the session keeps the sort in memory — but never raise it globally without budgeting max_connections times work_mem.",
  },
  ru: {
    svgTitle: "Сортировка сбросила 450MB на диск как external merge, потому что work_mem по умолчанию 4MB; 512MB на сессию держит её в памяти",
    headline: "СОРТИРОВКА СБРОСИЛА 450MB",
    sub: "work_mem 4MB по умолчанию — поднять на сессию",
    leftTitle: "УМОЛЧАНИЕ",
    leftA: "work_mem = 4MB",
    leftB: "external merge",
    leftC: "Disk: 450MB",
    rightTitle: "ФИКС СЕССИИ",
    rightA: "work_mem = 512MB",
    rightB: "сортировка в памяти",
    rightC: "без сброса на диск",
    foot: "глобально не поднимать без бюджета max_connections на память",
    caption:
      "Sort Method external merge с Disk 450MB означает, что сортировка превысила умолчание work_mem 4MB и сбросилась на диск. SET work_mem = 512MB на сессию держит сортировку в памяти — но глобально не поднимайте без бюджета max_connections, умноженного на work_mem.",
  },
};

const t = dict[lang];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbplan-workmem-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="60" y="100" width="300" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    <text x="210" y="178" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftA}</text>
    <text x="210" y="214" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftB}</text>
    <text x="210" y="258" text-anchor="middle" font-size="18" fill="var(--accent)">{t.leftC}</text>

    <line x1="360" y1="200" x2="404" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-workmem-arrow)" />

    <rect x="404" y="100" width="336" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="572" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    <text x="572" y="178" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightA}</text>
    <text x="572" y="214" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightB}</text>
    <text x="572" y="258" text-anchor="middle" font-size="15" fill="var(--accent)">{t.rightC}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
