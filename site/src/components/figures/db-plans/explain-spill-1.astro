---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Hash Join planned 50000 rows but emitted 42, spilling 64 batches and 2.1GB; setting work_mem to 64MB brings it to 220ms",
    headline: "HASH JOIN: 50000 PLANNED, 42 REAL",
    sub: "one node where estimate and reality diverge",
    estTitle: "ESTIMATE",
    estLine1: "cost = 2400..55000",
    estLine2: "rows = 50000",
    actTitle: "REALITY",
    actLine1: "actual rows = 42",
    actLine2: "Batches: 64",
    actLine3: "Memory: 2.1GB",
    fixTitle: "FIX",
    fixLine1: "work_mem = 64MB",
    fixLine2: "same query: 220ms",
    foot: "Batches 64 means the hash table spilled 64 times — work_mem too small",
    caption:
      "The planner expected 50,000 rows but got 42, and the hash table spilled to disk in 64 batches using 2.1GB. One line — SET work_mem = 64MB — brings the same query to 220ms.",
  },
  ru: {
    svgTitle: "Хеш-соединение планировало 50000 строк, а выдало 42, сбросив 64 партии и 2.1GB; work_mem 64MB возвращает 220мс",
    headline: "ХЕШ: ПЛАН 50000, ФАКТ 42",
    sub: "один узел, где оценка и реальность расходятся",
    estTitle: "ОЦЕНКА",
    estLine1: "cost = 2400..55000",
    estLine2: "rows = 50000",
    actTitle: "РЕАЛЬНОСТЬ",
    actLine1: "actual rows = 42",
    actLine2: "Batches: 64",
    actLine3: "Memory: 2.1GB",
    fixTitle: "ИСПРАВЛЕНИЕ",
    fixLine1: "work_mem = 64MB",
    fixLine2: "запрос: 220мс",
    foot: "Batches 64 — хеш-таблица 64 раза сброшена на диск: work_mem мал",
    caption:
      "Планировщик ждал 50 000 строк, а получил 42, и хеш-таблица сбросилась на диск 64 партиями с 2.1GB. Одна строка — SET work_mem = 64MB — возвращает тот же запрос к 220мс.",
  },
};

const t = dict[lang];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbplan-spill-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="100" width="210" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="135" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.estTitle}</text>
    <text x="135" y="180" text-anchor="middle" font-size="12" fill="var(--muted)">{t.estLine1}</text>
    <text x="135" y="220" text-anchor="middle" font-size="20" fill="var(--muted)">{t.estLine2}</text>

    <line x1="240" y1="195" x2="282" y2="195" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-spill-arrow)" />

    <rect x="282" y="100" width="248" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="406" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.actTitle}</text>
    <text x="406" y="180" text-anchor="middle" font-size="15" fill="var(--accent)">{t.actLine1}</text>
    <text x="406" y="214" text-anchor="middle" font-size="15" fill="var(--accent)">{t.actLine2}</text>
    <text x="406" y="248" text-anchor="middle" font-size="12" fill="var(--muted)">{t.actLine3}</text>

    <line x1="530" y1="195" x2="572" y2="195" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-spill-arrow)" />

    <rect x="572" y="100" width="198" height="190" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
    <text x="671" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.fixTitle}</text>
    <text x="671" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixLine1}</text>
    <text x="671" y="220" text-anchor="middle" font-size="15" fill="var(--accent)">{t.fixLine2}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
