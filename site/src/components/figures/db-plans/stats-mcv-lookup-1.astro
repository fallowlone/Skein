---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Estimating WHERE x = 42 in three lookups: MCV list first, then the histogram bucket, then multiply by reltuples",
    headline: "WHERE x = 42: THREE LOOKUPS",
    sub: "MCV first · histogram second · reltuples last",
    s1Title: "1 · MCV LIST",
    s1a: "is 42 in top-N?",
    s1b: "yes: exact frequency",
    s2Title: "2 · HISTOGRAM",
    s2a: "bucket holding 42",
    s2b: "uniform inside",
    s3Title: "3 · x reltuples",
    s3a: "selectivity x rows",
    s3b: "drives the plan",
    foot: "range x > 100: integrate the histogram · multi-column: independence assumed",
    caption:
      "For WHERE x = 42 the planner asks the MCV list first and takes the exact frequency on a hit; otherwise it finds the histogram bucket and assumes uniform spread inside, then multiplies by reltuples. Range predicates integrate the histogram; multi-column predicates assume independence.",
  },
  ru: {
    svgTitle: "Оценка WHERE x = 42 в три обращения: сначала MCV-список, затем бакет гистограммы, затем умножить на reltuples",
    headline: "WHERE x = 42: ТРИ ОБРАЩЕНИЯ",
    sub: "сначала MCV · затем гистограмма · потом reltuples",
    s1Title: "1 · СПИСОК MCV",
    s1a: "есть ли 42 в top-N?",
    s1b: "да: точная частота",
    s2Title: "2 · ГИСТОГРАММА",
    s2a: "бакет с числом 42",
    s2b: "внутри равномерно",
    s3Title: "3 · x reltuples",
    s3a: "селективность x строки",
    s3b: "определяет план",
    foot: "диапазон x > 100: интегрировать гистограмму · колонок много: независимы",
    caption:
      "Для WHERE x = 42 планировщик сначала спрашивает MCV-список и при попадании берёт точную частоту; иначе находит бакет гистограммы и предполагает равномерность внутри, затем умножает на reltuples. Диапазоны интегрируют гистограмму; многоколоночные предикаты предполагают независимость.",
  },
};

const t = dict[lang];

const stepX = [30, 285, 540];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbplan-mcv-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x={stepX[0]} y="110" width="230" height="180" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x={stepX[0] + 115} y="142" text-anchor="middle" font-size="13" fill="var(--ink)">{t.s1Title}</text>
    <text x={stepX[0] + 115} y="190" text-anchor="middle" font-size="12" fill="var(--muted)">{t.s1a}</text>
    <text x={stepX[0] + 115} y="230" text-anchor="middle" font-size="15" fill="var(--accent)">{t.s1b}</text>

    <line x1="260" y1="200" x2="285" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-mcv-arrow)" />

    <rect x={stepX[1]} y="110" width="230" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={stepX[1] + 115} y="142" text-anchor="middle" font-size="13" fill="var(--ink)">{t.s2Title}</text>
    <text x={stepX[1] + 115} y="190" text-anchor="middle" font-size="12" fill="var(--muted)">{t.s2a}</text>
    <text x={stepX[1] + 115} y="230" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s2b}</text>

    <line x1="515" y1="200" x2="540" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbplan-mcv-arrow)" />

    <rect x={stepX[2]} y="110" width="230" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={stepX[2] + 115} y="142" text-anchor="middle" font-size="13" fill="var(--ink)">{t.s3Title}</text>
    <text x={stepX[2] + 115} y="190" text-anchor="middle" font-size="12" fill="var(--muted)">{t.s3a}</text>
    <text x={stepX[2] + 115} y="230" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s3b}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
