---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "BUFFERS accounting: Seq Scan on orders with actual time 0.1..450 and rows 1000000 shows shared hit 4800 and read 200",
    headline: "BUFFERS: HIT OR READ",
    sub: "per-node cache accounting in EXPLAIN ANALYZE",
    code1: "Seq Scan on orders (actual time = 0.1..450 rows = 1000000 loops = 1)",
    code2: "Buffers: shared hit = 4800 read = 200",
    hitTitle: "hit = 4800",
    hitSub: "in shared_buffers · no disk I/O",
    readTitle: "read = 200",
    readSub: "from OS or disk · cold working set",
    verdict: "many reads = I/O-bound · slow with few reads = CPU-bound",
    caption:
      "EXPLAIN (ANALYZE, BUFFERS) adds per-node cache accounting: shared hit means the page was in shared_buffers with no disk I/O, read means it came from disk. Many reads with few hits is I/O-bound; slow with few reads is CPU-bound — a bad join or a heavy sort.",
  },
  ru: {
    svgTitle: "Учёт BUFFERS: Seq Scan по orders с actual time 0.1..450 и rows 1000000 показывает shared hit 4800 и read 200",
    headline: "BUFFERS: HIT ИЛИ READ",
    sub: "учёт кеша на узел в EXPLAIN ANALYZE",
    code1: "Seq Scan on orders (actual time = 0.1..450 rows = 1000000 loops = 1)",
    code2: "Buffers: shared hit = 4800 read = 200",
    hitTitle: "hit = 4800",
    hitSub: "в shared_buffers · без диска",
    readTitle: "read = 200",
    readSub: "с диска или ОС · холодные данные",
    verdict: "много read = лимит I/O · медленно без read = лимит CPU",
    caption:
      "EXPLAIN (ANALYZE, BUFFERS) добавляет учёт кеша на узел: shared hit — страница была в shared_buffers без дискового I/O, read — пришла с диска. Много read при малых hit — ограничение I/O; медленно при малых read — ограничение CPU: плохое соединение или тяжёлая сортировка.",
  },
};

const t = dict[lang];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="96" width="720" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="64" y="140" font-size="12" fill="var(--ink)">{t.code1}</text>
    <text x="64" y="178" font-size="12" fill="var(--accent)">{t.code2}</text>

    <rect x="40" y="230" width="350" height="80" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="215" y="260" text-anchor="middle" font-size="15" fill="var(--ink)">{t.hitTitle}</text>
    <text x="215" y="286" text-anchor="middle" font-size="11" fill="var(--muted)">{t.hitSub}</text>

    <rect x="410" y="230" width="350" height="80" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="585" y="260" text-anchor="middle" font-size="15" fill="var(--ink)">{t.readTitle}</text>
    <text x="585" y="286" text-anchor="middle" font-size="11" fill="var(--muted)">{t.readSub}</text>

    <rect x="40" y="326" width="720" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--ink)">{t.verdict}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
