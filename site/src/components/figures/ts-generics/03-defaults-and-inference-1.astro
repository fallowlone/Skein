---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "an explicit type argument wins, then inference from the call arguments, and only then the default fallback",
    headline: "EXPLICIT > INFERENCE > DEFAULT",
    sub: "the checker resolves each T in strict order",
    tagExplicit: "1 — explicit",
    explicitSig: "box<number>(...)",
    explicitLine: "caller wrote the arg",
    explicitFoot: "use it ✓",
    tagInfer: "2 — inference",
    inferSig: "box(42)",
    inferLine: "T = number",
    inferFoot: "default ignored",
    tagDefault: "3 — default",
    defaultSig: "emptyArray()",
    defaultLine: "nothing to infer",
    defaultFoot: "T = string ✓",
    foot1: "inference always wins — a default never overrides it",
    foot2: "the default is a fallback for the no-information case only",
    caption:
      "Each type parameter resolves in order: an explicit argument wins, otherwise inference from the call arguments wins, and only with neither does the default apply — box(42) gives number, emptyArray() falls back to string.",
  },
  ru: {
    svgTitle: "явный аргумент типа побеждает, затем вывод из аргументов вызова, и лишь потом запасной дефолт",
    headline: "ЯВНЫЙ > ВЫВОД > ДЕФОЛТ",
    sub: "проверяющий разрешает каждый T в строгом порядке",
    tagExplicit: "1 — явный",
    explicitSig: "box<number>(...)",
    explicitLine: "вызывающий написал аргумент",
    explicitFoot: "использовать его ✓",
    tagInfer: "2 — вывод",
    inferSig: "box(42)",
    inferLine: "T = number",
    inferFoot: "дефолт игнорируется",
    tagDefault: "3 — дефолт",
    defaultSig: "emptyArray()",
    defaultLine: "выводить нечего",
    defaultFoot: "T = string ✓",
    foot1: "вывод всегда побеждает — дефолт никогда его не переопределяет",
    foot2: "дефолт — лишь запасной вариант на случай, когда выводить нечего",
    caption:
      "Каждый параметр типа разрешается по порядку: побеждает явный аргумент, иначе — вывод из аргументов вызова, и лишь при отсутствии обоих применяется дефолт: box(42) даёт number, а emptyArray() откатывается к string.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsGenericsDefaults-1" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagExplicit}</text>
    <rect x="40" y="126" width="220" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="150" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.explicitSig}</text>
    <text x="150" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.explicitLine}</text>
    <text x="150" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.explicitFoot}</text>

    <line x1="264" y1="221" x2="286" y2="221" stroke="var(--muted)" stroke-width="2" />
    <polygon points="286,214 296,221 286,228" fill="var(--muted)" />

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagInfer}</text>
    <rect x="290" y="126" width="220" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.inferSig}</text>
    <text x="400" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.inferLine}</text>
    <text x="400" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.inferFoot}</text>

    <line x1="514" y1="221" x2="536" y2="221" stroke="var(--muted)" stroke-width="2" />
    <polygon points="536,214 546,221 536,228" fill="var(--muted)" />

    <text x="650" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagDefault}</text>
    <rect x="540" y="126" width="220" height="190" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="650" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.defaultSig}</text>
    <text x="650" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.defaultLine}</text>
    <text x="650" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.defaultFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
