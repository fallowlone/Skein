---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle:
      "Variance directions from Dog extends Animal: covariant producers keep the direction, contravariant consumers reverse it, and mutable containers that read and write must be invariant",
    headline: "VARIANCE IS THE DIRECTION SUBTYPING FLOWS",
    sub: "Dog extends Animal — how F<Dog> relates to F<Animal>",
    box1Title: "covariant",
    box1Line1: "F<Dog> → F<Animal>",
    box1Line2: "same direction",
    box1Foot: "producer (read)",
    box2Title: "contravariant",
    box2Line1: "(a: Animal) => void",
    box2Line2: "fills the (d: Dog) slot",
    box2Foot: "consumer (write)",
    box3Title: "invariant",
    box3Line1: "neither direction",
    box3Line2: "exact match only",
    box3Foot: "mutable Box",
    foot1: "Dog extends Animal is the base relation",
    foot2: "a mutable Box reads and writes T, so it must be invariant",
    caption:
      "Given Dog extends Animal, a producer keeps the subtyping direction, a consumer reverses it, and a mutable container that both reads and writes stays sound only as invariant.",
  },
  ru: {
    svgTitle:
      "Направления вариантности от Dog extends Animal: ковариантные производители сохраняют направление, контравариантные потребители разворачивают, а изменяемые контейнеры, которые читают и пишут, должны быть инвариантными",
    headline: "ВАРИАНТНОСТЬ — НАПРАВЛЕНИЕ ПОДТИПИЗАЦИИ",
    sub: "Dog extends Animal — как F<Dog> относится к F<Animal>",
    box1Title: "ковариантно",
    box1Line1: "F<Dog> → F<Animal>",
    box1Line2: "в ту же сторону",
    box1Foot: "производитель (чтение)",
    box2Title: "контравариантно",
    box2Line1: "(a: Animal) => void",
    box2Line2: "подменяет слот (d: Dog)",
    box2Foot: "потребитель (запись)",
    foot1: "Dog extends Animal — базовое отношение",
    foot2: "изменяемый Box и читает, и пишет T — должен быть инвариантным",
    box3Title: "инвариантно",
    box3Line1: "ни в одну сторону",
    box3Line2: "только точные совпадения",
    box3Foot: "изменяемый Box",
    caption:
      "От Dog extends Animal: производитель сохраняет направление подтипизации, потребитель его разворачивает, а изменяемый контейнер, делающий и то и другое, для соундности должен быть инвариантным.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsGenericsVariance-1">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="20" y="92" width="200" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="120" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box1Title}</text>
      <text x="120" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line1}</text>
      <text x="120" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line2}</text>
      <text x="120" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Foot}</text>

      <rect x="300" y="92" width="200" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box2Title}</text>
      <text x="400" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line1}</text>
      <text x="400" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line2}</text>
      <text x="400" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Foot}</text>

      <rect x="580" y="92" width="200" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="680" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box3Title}</text>
      <text x="680" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box3Line1}</text>
      <text x="680" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box3Line2}</text>
      <text x="680" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Foot}</text>

      <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
      <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
