---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Result T E is a discriminated union: checking r.ok narrows to the value branch or the error branch, and never in the unused slot fits any expected type",
    headline: "RESULT: TWO SLOTS, ONE READING",
    sub: "the discriminant ok narrows the union to one branch",
    unionLine1: "type Result<T, E> =",
    unionLine2: "{ ok: true; value: T }",
    unionLine3: "{ ok: false; error: E }",
    arrowLeft: "if (r.ok)",
    arrowRight: "else",
    branchL1: "{ ok: true; value: T }",
    branchL2: "read r.value",
    branchR1: "{ ok: false; error: E }",
    branchR2: "read r.error",
    strip: "never fits any E — ok(x) fits Result<T, string>",
    foot: "narrow by ok, read exactly one payload — no exceptions",
    caption:
      "Result<T, E> models success-or-failure without exceptions as a discriminated union: ok builds Result<T, never> and err builds Result<never, E> so the unused side, typed never, fits any expected type; checking r.ok narrows the union and exposes exactly one branch payload, value or error.",
  },
  ru: {
    svgTitle: "Result T E — размеченное объединение: проверка r.ok сужает до ветви значения или ветви ошибки, а never в неиспользуемом слоте подходит под любой ожидаемый тип",
    headline: "RESULT: ДВА СЛОТА — ОДНО ЧТЕНИЕ",
    sub: "дискриминант ok сужает объединение до одной ветви",
    unionLine1: "type Result<T, E> =",
    unionLine2: "{ ok: true; value: T }",
    unionLine3: "{ ok: false; error: E }",
    arrowLeft: "if (r.ok)",
    arrowRight: "else",
    branchL1: "{ ok: true; value: T }",
    branchL2: "читаем r.value",
    branchR1: "{ ok: false; error: E }",
    branchR2: "читаем r.error",
    strip: "never подходит под любой E — ok(x) подходит под Result<T, string>",
    foot: "сужай по ok и читай нагрузку ровно одной ветви — без исключений",
    caption:
      "Result<T, E> моделирует успех-или-неудачу без исключений как размеченное объединение: ok строит Result<T, never>, а err — Result<never, E>, поэтому неиспользуемая сторона, типизированная never, подходит под любой ожидаемый тип; проверка r.ok сужает объединение и открывает нагрузку ровно одной ветви — value или error.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsGenericsClasses-3">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="200" y="76" width="400" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="104" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unionLine1}</text>
      <text x="400" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unionLine2}</text>
      <text x="400" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unionLine3}</text>

      <line x1="330" y1="176" x2="210" y2="224" stroke="var(--muted)" stroke-width="2" />
      <polygon points="203,224 214,219 213,229" fill="var(--muted)" />
      <line x1="470" y1="176" x2="590" y2="224" stroke="var(--muted)" stroke-width="2" />
      <polygon points="597,224 586,219 587,229" fill="var(--muted)" />
      <text x="268" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrowLeft}</text>
      <text x="532" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrowRight}</text>

      <rect x="60" y="224" width="300" height="84" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="210" y="256" text-anchor="middle" font-size="12" fill="var(--ink)">{t.branchL1}</text>
      <text x="210" y="282" text-anchor="middle" font-size="12" fill="var(--ink)">{t.branchL2}</text>

      <rect x="440" y="224" width="300" height="84" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="590" y="256" text-anchor="middle" font-size="12" fill="var(--ink)">{t.branchR1}</text>
      <text x="590" y="282" text-anchor="middle" font-size="12" fill="var(--ink)">{t.branchR2}</text>

      <rect x="130" y="326" width="540" height="34" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="348" text-anchor="middle" font-size="12" fill="var(--ink)">{t.strip}</text>

      <text x="400" y="398" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
