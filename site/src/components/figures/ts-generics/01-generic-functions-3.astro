---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "prop(user, 'name'): T is solved from obj, K is solved from key, and the return type T[K] reports exactly string",
    headline: "TWO PARAMETERS, EACH SOLVED APART",
    sub: "prop<T, K extends keyof T>(obj: T, key: K): T[K]",
    tagLeft: "T solved from obj",
    leftLine1: "obj = user",
    leftLine2: "T = { id: number;",
    leftLine3: "name: string }",
    tagMid: "K solved from key",
    midLine1: 'key = "name"',
    midLine2: 'K = "name"',
    midLine3: "a literal type",
    tagRight: "return type T[K]",
    rightLine1: "both solved at once",
    rightLine2: "T[K] gives string",
    rightLine3: 'also id gives number',
    barTag: "same call, other key",
    barLine: 'prop(user, "id") gives number — T[K] stays exact',
    foot1: "two parameters, each appearing twice — the K extends keyof T machinery is the next lesson",
    caption:
      "The checker solves T from user and K from 'name' independently, then substitutes both into the return type T[K] to report exactly string — and number again for prop(user, 'id').",
  },
  ru: {
    svgTitle: "prop(user, 'name'): T решается из obj, K решается из key, а возвращаемый тип T[K] сообщает ровно string",
    headline: "ДВА ПАРАМЕТРА — КАЖДЫЙ РЕШАЕТСЯ ОТДЕЛЬНО",
    sub: "prop<T, K extends keyof T>(obj: T, key: K): T[K]",
    tagLeft: "T решается из obj",
    leftLine1: "obj = user",
    leftLine2: "T = { id: number;",
    leftLine3: "name: string }",
    tagMid: "K решается из key",
    midLine1: 'key = "name"',
    midLine2: 'K = "name"',
    midLine3: "литеральный тип",
    tagRight: "возвращаемый тип T[K]",
    rightLine1: "оба подставлены сразу",
    rightLine2: "T[K] даёт string",
    rightLine3: "а id даёт number",
    barTag: "тот же вызов, другой ключ",
    barLine: 'prop(user, "id") даёт number — T[K] остаётся точным',
    foot1: "два параметра, каждый встречается дважды, — механика K extends keyof T это следующий урок",
    caption:
      "Проверяющий решает T из user и K из 'name' независимо, затем подставляет оба в возвращаемый тип T[K] и сообщает ровно string — и снова number для prop(user, 'id').",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="35" y="118" width="230" height="132" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="150" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine1}</text>
    <text x="150" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine2}</text>
    <text x="150" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine3}</text>

    <text x="400" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagMid}</text>
    <rect x="285" y="118" width="230" height="132" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.midLine1}</text>
    <text x="400" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.midLine2}</text>
    <text x="400" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.midLine3}</text>

    <text x="650" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="535" y="118" width="230" height="132" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="650" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine1}</text>
    <text x="650" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine2}</text>
    <text x="650" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine3}</text>

    <text x="400" y="288" text-anchor="middle" font-size="11" fill="var(--muted)">{t.barTag}</text>
    <rect x="180" y="304" width="440" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="339" text-anchor="middle" font-size="12" fill="var(--ink)">{t.barLine}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
