---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Inference for wrap([1,2,3]): the checker unifies value T against number[], solves T = number[], and returns { value: number[] }",
    headline: "INFERENCE: ARGUMENTS SOLVE T",
    sub: "wrap<T>(value: T): { value: T } called as wrap([1, 2, 3])",
    tag1: "1 · call args",
    box1line1: "wrap([1, 2, 3])",
    box1line2: "arg type: number[]",
    tag2: "2 · unify",
    box2line1: "value: T",
    box2line2: "vs number[]",
    tag3: "3 · solve T",
    box3line1: "T = number[]",
    box3line2: "from the argument",
    tag4: "4 · return type",
    box4line1: "{ value: T }",
    box4line2: "{ value: number[] }",
    foot1: "information flows IN from the argument to T, then OUT through the return type",
    foot2: "nothing to infer from — unconstrained T falls to unknown, pass it by hand",
    caption:
      "The checker reads the call arguments, unifies each against the parameter that mentions T, solves T = number[], then substitutes T back through the return type.",
  },
  ru: {
    svgTitle: "Вывод для wrap([1,2,3]): проверяющий унифицирует value T с number[], решает T = number[] и возвращает { value: number[] }",
    headline: "ВЫВОД: АРГУМЕНТЫ РЕШАЮТ T",
    sub: "wrap<T>(value: T): { value: T } вызван как wrap([1, 2, 3])",
    tag1: "1 · аргументы вызова",
    box1line1: "wrap([1, 2, 3])",
    box1line2: "аргумент: number[]",
    tag2: "2 · унификация",
    box2line1: "value: T",
    box2line2: "vs number[]",
    tag3: "3 · решить T",
    box3line1: "T = number[]",
    box3line2: "из аргумента",
    tag4: "4 · тип возврата",
    box4line1: "{ value: T }",
    box4line2: "{ value: number[] }",
    foot1: "вывод течёт из позиции аргумента в T, а затем обратно через позицию возврата",
    foot2: "выводить не из чего — T падает в unknown, задайте явно",
    caption:
      "Проверяющий читает аргументы вызова, унифицирует каждый с параметром, упоминающим T, решает T = number[], и подставляет T обратно через возвращаемый тип.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="114" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="32" y="120" width="165" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="114" y="175" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line1}</text>
    <text x="114" y="205" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line2}</text>

    <line x1="197" y1="185" x2="216" y2="185" stroke="var(--accent)" stroke-width="2" />
    <polygon points="216,179 228,185 216,191" fill="var(--accent)" />

    <text x="304" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="222" y="120" width="165" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="304" y="175" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line1}</text>
    <text x="304" y="205" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line2}</text>

    <line x1="387" y1="185" x2="406" y2="185" stroke="var(--accent)" stroke-width="2" />
    <polygon points="406,179 418,185 406,191" fill="var(--accent)" />

    <text x="494" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="412" y="120" width="165" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="494" y="175" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line1}</text>
    <text x="494" y="205" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line2}</text>

    <line x1="577" y1="185" x2="596" y2="185" stroke="var(--accent)" stroke-width="2" />
    <polygon points="596,179 608,185 596,191" fill="var(--accent)" />

    <text x="684" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag4}</text>
    <rect x="602" y="120" width="165" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="684" y="175" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box4line1}</text>
    <text x="684" y="205" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box4line2}</text>

    <text x="400" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
