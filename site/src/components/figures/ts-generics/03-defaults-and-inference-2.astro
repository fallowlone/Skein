---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "defaults fill trailing type parameters so one explicit argument is legal, but a leading parameter can never be skipped",
    headline: "DEFAULTS FILL THE TAIL",
    sub: "leading explicit args are all-or-nothing — defaults let you stop early",
    tagBoth: "both inferred",
    bothSig: 'make("x", 9)',
    bothLine: "A = string, B = number",
    bothFoot: "no explicit args ✓",
    tagOne: "A explicit, B inferred",
    oneSig: 'make<string>("x", 9)',
    oneLine: "A = string, B = number",
    oneFoot: "B = A: one arg is legal ✓",
    foot1: "cannot skip A to specify B — leading args are all-or-nothing",
    foot2: "a defaulted parameter can still be refined by inference",
    caption:
      "Defaults fill trailing parameters: make<string> is legal because B has a default of A with B still inferred to number, while skipping a leading parameter to specify a later one is never allowed.",
  },
  ru: {
    svgTitle: "дефолты заполняют хвостовые параметры типа, поэтому один явный аргумент допустим, но ведущий параметр пропустить нельзя",
    headline: "ДЕФОЛТЫ ЗАПОЛНЯЮТ ХВОСТ",
    sub: "ведущие явные аргументы — всё-или-ничего, дефолты позволяют остановиться раньше",
    tagBoth: "оба выведены",
    bothSig: 'make("x", 9)',
    bothLine: "A = string, B = number",
    bothFoot: "без явных аргументов ✓",
    tagOne: "A явный, B выведен",
    oneSig: 'make<string>("x", 9)',
    oneLine: "A = string, B = number",
    oneFoot: "B = A: один аргумент допустим ✓",
    foot1: "нельзя пропустить ведущий, чтобы задать более поздний",
    foot2: "вывод всё ещё может уточнить параметр с дефолтом",
    caption:
      "Дефолты заполняют хвостовые параметры: make<string> допустим, потому что у B есть дефолт = A, а B всё ещё выведен в number; пропустить ведущий параметр, чтобы задать более поздний, нельзя.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsGenericsDefaults-2" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagBoth}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bothSig}</text>
    <text x="205" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bothLine}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bothFoot}</text>

    <text x="595" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagOne}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.oneSig}</text>
    <text x="595" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.oneLine}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.oneFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
