---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Static members cannot reference class type parameters: static empty reading T fails, while static of with its own U resolved at the static call succeeds",
    headline: "STATICS CANNOT SEE T",
    sub: "one shared class object exists before every instance",
    badTitle: "static reads class T",
    badLine1: "static empty(): Box<T>",
    badLine2: "Static members cannot",
    badLine3: "reference class type parameters.",
    midLabel: "fix: own U",
    goodTitle: "static with own U",
    goodLine1: "static of<U>(value: U)",
    goodLine2: ": Box<U>",
    goodLine3: 'Box.of("hi"): Box<string>',
    strip: "one Box constructor, shared by every T",
    foot: "give the static its own type parameter, solved at its call",
    caption:
      'Static members live on the single shared class object that predates every instance, so static empty(): Box<T> fails with Static members cannot reference class type parameters; the fix is static of<U>(value: U): Box<U>, whose own U is solved at the static call — Box.of("hi") gives Box<string>.',
  },
  ru: {
    svgTitle: "Статические члены не могут ссылаться на параметры типа класса: static empty, читающий T, не компилируется, а static of со своим U, решаемым в точке вызова, работает",
    headline: "СТАТИКА НЕ ВИДИТ T",
    sub: "единственный общий объект класса существует до любого экземпляра",
    badTitle: "статика читает T класса",
    badLine1: "static empty(): Box<T>",
    badLine2: "Static members cannot",
    badLine3: "reference class type parameters.",
    midLabel: "свой U",
    goodTitle: "статика со своим U",
    goodLine1: "static of<U>(value: U)",
    goodLine2: ": Box<U>",
    goodLine3: 'Box.of("hi"): Box<string>',
    strip: "одна функция-конструктор Box — общая для всех T",
    foot: "дайте статике собственный параметр типа, решаемый в её вызове",
    caption:
      'Статические члены живут на единственном общем объекте класса, предшествующем каждому экземпляру, поэтому static empty(): Box<T> не компилируется: Static members cannot reference class type parameters; фикс — static of<U>(value: U): Box<U>, чей собственный U решается в точке статического вызова: Box.of("hi") даёт Box<string>.',
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsGenericsClasses-2">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="40" y="96" width="320" height="180" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="200" y="126" text-anchor="middle" font-size="12" fill="var(--muted)">{t.badTitle}</text>
      <text x="200" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.badLine1}</text>
      <text x="200" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.badLine2}</text>
      <text x="200" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.badLine3}</text>

      <line x1="368" y1="186" x2="424" y2="186" stroke="var(--muted)" stroke-width="2" />
      <polygon points="414,180 414,192 424,186" fill="var(--muted)" />
      <text x="396" y="168" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midLabel}</text>

      <rect x="440" y="96" width="320" height="180" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="600" y="126" text-anchor="middle" font-size="12" fill="var(--muted)">{t.goodTitle}</text>
      <text x="600" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodLine1}</text>
      <text x="600" y="182" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodLine2}</text>
      <text x="600" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodLine3}</text>

      <rect x="150" y="336" width="500" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="361" text-anchor="middle" font-size="12" fill="var(--ink)">{t.strip}</text>

      <text x="400" y="404" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
