---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "plain T array lets both arguments feed inference so a typo widens T to string, while NoInfer lets initial alone decide T and the typo is rejected",
    headline: "PLAIN T[] VS NOINFER<T>[]",
    sub: "one argument decides T — the rest are only checked against it",
    tagPlain: "allowed: T[]",
    plainSig: "initial: T, allowed: T[]",
    plainLine: "typo widens T to string ✗",
    plainFoot: "typo compiles — guard lost",
    tagNoInfer: "allowed: NoInfer<T>[]",
    noinferSig: "initial: T, allowed: NoInfer<T>[]",
    noinferLine: 'T pinned to "seatle" ✓',
    noinferFoot: "typo is rejected",
    foot1: "plain T[] lets every argument feed T, so a typo silently widens it",
    foot2: "NoInfer<T>[] removes allowed as an inference source",
    caption:
      "Plain T[] lets every argument feed T, so a typo in initial silently widens T to string and the list guard evaporates; NoInfer<T>[] makes initial alone pin T to the literal, so the mismatched elements are rejected.",
  },
  ru: {
    svgTitle: "обычный T[] позволяет обоим аргументам питать вывод, поэтому опечатка расширяет T до string, а NoInfer оставляет решение за одним initial, и опечатка отвергается",
    headline: "PLAIN T[] VS NOINFER<T>[]",
    sub: "один аргумент задаёт T, остальные лишь проверяются против него",
    tagPlain: "allowed: T[]",
    plainSig: "initial: T, allowed: T[]",
    plainLine: "опечатка расширяет T до string ✗",
    plainFoot: "опечатка компилируется — защита испаряется",
    tagNoInfer: "allowed: NoInfer<T>[]",
    noinferSig: "initial: T, allowed: NoInfer<T>[]",
    noinferLine: 'T пиннится к "seatle" ✓',
    noinferFoot: "опечатка отвергается",
    foot1: "обычный T[] позволяет каждому аргументу питать T, поэтому опечатка тихо расширяет его",
    foot2: "NoInfer<T>[] убирает allowed как источник вывода",
    caption:
      "Обычный T[] позволяет каждому аргументу питать T, поэтому опечатка в initial тихо расширяет T до string и защита по списку испаряется; NoInfer<T>[] делает так, что один лишь initial пиннит T к литералу, и несовпадающие элементы отвергаются.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsGenericsDefaults-3" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagPlain}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.plainSig}</text>
    <text x="205" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.plainLine}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.plainFoot}</text>

    <text x="595" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagNoInfer}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.noinferSig}</text>
    <text x="595" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.noinferLine}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.noinferFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
