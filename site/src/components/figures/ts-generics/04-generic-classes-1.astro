---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Each construction binds T per instance: new Box(42) gives Box<number> while Box.of(hi) gives Box<string>, and every method shares that one T",
    headline: "ONE T PER INSTANCE",
    sub: "the constructor call binds the class type parameter",
    classLine1: "class Box<T> {",
    classLine2: "value: T",
    classLine3: "map<U>(fn): Box<U>",
    classLine4: "}",
    arrowLeft: "new Box(42)",
    arrowRight: 'Box.of("hi")',
    inst1a: "b: Box<number>",
    inst1b: "value = 42",
    inst1c: "every method sees number",
    inst2a: "Box<string>",
    inst2b: 'value = "hi"',
    inst2c: "every method sees string",
    strip: "map<U> adds its own U — independent of T",
    foot: "one class, one T per instance — methods share it",
    caption:
      'A class type parameter is bound per instance at construction: new Box(42) types b as Box<number> so every method shares number, while Box.of("hi") gives Box<string>; a method such as map<U> adds its own independent U.',
  },
  ru: {
    svgTitle: "Каждое конструирование привязывает T по-экземплярно: new Box(42) даёт Box<number>, а Box.of(hi) — Box<string>, и все методы делят один T",
    headline: "ОДИН T НА ЭКЗЕМПЛЯР",
    sub: "вызов конструктора привязывает параметр типа класса",
    classLine1: "class Box<T> {",
    classLine2: "value: T",
    classLine3: "map<U>(fn): Box<U>",
    classLine4: "}",
    arrowLeft: "new Box(42)",
    arrowRight: 'Box.of("hi")',
    inst1a: "b: Box<number>",
    inst1b: "value = 42",
    inst1c: "все методы видят number",
    inst2a: "Box<string>",
    inst2b: 'value = "hi"',
    inst2c: "все методы видят string",
    strip: "map<U> добавляет свой U — независимый от T",
    foot: "один класс — один T на экземпляр, методы его делят",
    caption:
      'Параметр типа класса привязывается по-экземплярно при конструировании: new Box(42) типизирует b как Box<number>, и все методы делят number, а Box.of("hi") даёт Box<string>; метод вроде map<U> добавляет собственный независимый U.',
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsGenericsClasses-1">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="270" y="76" width="260" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="102" text-anchor="middle" font-size="12" fill="var(--ink)">{t.classLine1}</text>
      <text x="400" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.classLine2}</text>
      <text x="400" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.classLine3}</text>
      <text x="400" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.classLine4}</text>

      <line x1="330" y1="186" x2="210" y2="232" stroke="var(--muted)" stroke-width="2" />
      <polygon points="203,232 214,227 213,237" fill="var(--muted)" />
      <line x1="470" y1="186" x2="590" y2="232" stroke="var(--muted)" stroke-width="2" />
      <polygon points="597,232 586,227 587,237" fill="var(--muted)" />
      <text x="268" y="212" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrowLeft}</text>
      <text x="532" y="212" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrowRight}</text>

      <rect x="60" y="232" width="300" height="104" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="210" y="260" text-anchor="middle" font-size="12" fill="var(--ink)">{t.inst1a}</text>
      <text x="210" y="284" text-anchor="middle" font-size="12" fill="var(--ink)">{t.inst1b}</text>
      <text x="210" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.inst1c}</text>

      <rect x="440" y="232" width="300" height="104" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="590" y="260" text-anchor="middle" font-size="12" fill="var(--ink)">{t.inst2a}</text>
      <text x="590" y="284" text-anchor="middle" font-size="12" fill="var(--ink)">{t.inst2b}</text>
      <text x="590" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.inst2c}</text>

      <rect x="170" y="348" width="460" height="34" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="370" text-anchor="middle" font-size="12" fill="var(--ink)">{t.strip}</text>

      <text x="400" y="404" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
