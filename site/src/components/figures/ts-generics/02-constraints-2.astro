---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "K extends keyof T restricts the key to T's own keys and returns the exact property type T[K]",
    headline: "KEY MUST BE ONE OF T'S OWN KEYS",
    sub: 'getProperty(user, "name") — user holds id, name, admin',
    sigA: "getProperty<T, K extends keyof T>",
    sigB: "(obj: T, key: K): T[K]",
    step1head: "T from obj",
    step1sub: "{ id; name; admin }",
    step2head: "keyof T",
    step2sub: '"id" | "name" | "admin"',
    step3head: 'T[K] = T["name"]',
    step3sub: "string",
    okTag: '"name" — assignable',
    okRes: 'K = "name", returns string',
    errTag: '"email" — not a key',
    errRes: "rejected at the call site",
    caption:
      "The checker infers T from obj, computes keyof T as the union of keys, checks the key, then resolves T[K] to the exact property type — a missing key is rejected with the legal set.",
  },
  ru: {
    svgTitle: "K extends keyof T ограничивает ключ собственными ключами T и возвращает точный тип свойства T[K]",
    headline: "КЛЮЧ — ОДИН ИЗ СОБСТВЕННЫХ КЛЮЧЕЙ",
    sub: 'getProperty(user, "name") — у user есть id, name, admin',
    sigA: "getProperty<T, K extends keyof T>",
    sigB: "(obj: T, key: K): T[K]",
    step1head: "T из obj",
    step1sub: "{ id; name; admin }",
    step2head: "keyof T",
    step2sub: '"id" | "name" | "admin"',
    step3head: 'T[K] = T["name"]',
    step3sub: "string",
    okTag: '"name" — присваиваем',
    okRes: 'K = "name", возврат string',
    errTag: '"email" — не ключ',
    errRes: "отвергается в точке вызова",
    caption:
      "Проверяющий выводит T из obj, вычисляет keyof T как объединение ключей, проверяет ключ и разрешает T[K] в точный тип свойства — несуществующий ключ отвергается с допустимым набором.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsGenericsConstraints-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="96" text-anchor="middle" font-size="13" fill="var(--ink)">{t.sigA}</text>
    <text x="400" y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.sigB}</text>

    <rect x="40" y="156" width="220" height="84" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="150" y="190" text-anchor="middle" font-size="13" fill="var(--ink)">{t.step1head}</text>
    <text x="150" y="214" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step1sub}</text>

    <line x1="260" y1="198" x2="284" y2="198" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsGenericsConstraints-2)" />

    <rect x="290" y="156" width="220" height="84" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="190" text-anchor="middle" font-size="13" fill="var(--ink)">{t.step2head}</text>
    <text x="400" y="214" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step2sub}</text>

    <line x1="510" y1="198" x2="534" y2="198" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsGenericsConstraints-2)" />

    <rect x="540" y="156" width="220" height="84" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="650" y="190" text-anchor="middle" font-size="13" fill="var(--ink)">{t.step3head}</text>
    <text x="650" y="214" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step3sub}</text>

    <rect x="90" y="300" width="290" height="72" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="235" y="330" text-anchor="middle" font-size="13" fill="var(--accent)">{t.okTag}</text>
    <text x="235" y="352" text-anchor="middle" font-size="11" fill="var(--muted)">{t.okRes}</text>

    <rect x="420" y="300" width="290" height="72" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="565" y="330" text-anchor="middle" font-size="13" fill="var(--accent)">{t.errTag}</text>
    <text x="565" y="352" text-anchor="middle" font-size="11" fill="var(--muted)">{t.errRes}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
