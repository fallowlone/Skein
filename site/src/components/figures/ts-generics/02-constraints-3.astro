<!-- TsGenericsConstraints-3 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Returning the constraint erases the caller's type; returning T keeps it",
    headline: "RETURN T, NOT THE CONSTRAINT",
    sub: 'identityBad vs identityGood over { id: "u1", role: "admin" }',
    bugTag: "BUG: returns the constraint",
    bugSig: "identityBad<T extends { id: string }>",
    bugRet: "return: { id: string }",
    bugRes: "r1: { id: string }",
    bugVerdict: "lost `role` — generic is decorative",
    fixTag: "FIX: return T",
    fixSig: "identityGood<T extends { id: string }>",
    fixRet: "return: T",
    fixRes: 'r2: { id; role: "admin" }',
    fixVerdict: "full type kept",
    moral: "check the return type first: C where you expected T means the info is gone",
    caption:
      "Both versions compile, but returning the constraint widens the result to { id: string } and discards role; returning T preserves everything the caller passed.",
  },
  ru: {
    svgTitle: "Возврат ограничения стирает тип вызывающего; возврат T сохраняет его",
    headline: "ЛОВУШКА ТОЧНОСТИ: ВЕРНУТЬ C ВМЕСТО T",
    sub: 'identityBad vs identityGood над { id: "u1", role: "admin" }',
    bugTag: "БАГ: возвращает ограничение",
    bugSig: "identityBad<T extends { id: string }>",
    bugRet: "возврат: { id: string }",
    bugRes: "r1: { id: string }",
    bugVerdict: "потерян `role` — дженерик декоративный",
    fixTag: "ФИКС: вернуть T",
    fixSig: "identityGood<T extends { id: string }>",
    fixRet: "возврат: T",
    fixRes: 'r2: { id; role: "admin" }',
    fixVerdict: "полный тип сохранён",
    moral: "сначала смотри на тип возврата: C вместо T — типовая информация потеряна",
    caption:
      "Обе версии компилируются, но возврат ограничения сужает результат до { id: string } и отбрасывает role; возврат T сохраняет всё, что передал вызывающий.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsGenericsConstraints-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="340" height="220" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="210" y="132" text-anchor="middle" font-size="13" fill="var(--accent)">{t.bugTag}</text>
    <text x="210" y="164" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bugSig}</text>
    <text x="210" y="194" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bugRet}</text>
    <text x="210" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bugRes}</text>
    <line x1="210" y1="238" x2="210" y2="256" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsGenericsConstraints-3)" />
    <text x="210" y="282" text-anchor="middle" font-size="12" fill="var(--muted)">{t.bugVerdict}</text>

    <rect x="420" y="100" width="340" height="220" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="132" text-anchor="middle" font-size="13" fill="var(--accent)">{t.fixTag}</text>
    <text x="590" y="164" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixSig}</text>
    <text x="590" y="194" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixRet}</text>
    <text x="590" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixRes}</text>
    <line x1="590" y1="238" x2="590" y2="256" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsGenericsConstraints-3)" />
    <text x="590" y="282" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fixVerdict}</text>

    <text x="400" y="364" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
