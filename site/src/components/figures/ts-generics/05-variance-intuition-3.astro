---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle:
      "Same on(handler: (e: Event) => void) slot in two forms: the method shorthand is bivariant and accepts a narrow MouseEvent handler with no error, so e.button is undefined at runtime; the property function is contravariant and rejects it at compile time",
    headline: "METHOD PARAMS STAY BIVARIANT — THE GOTCHA",
    sub: "one slot on(handler: (e: Event) => void), two declaration forms",
    box1Title: "method form — bivariant",
    box1Line1: "on(handler: (e: Event) => void)",
    box1Line2: "narrow (e: MouseEvent) handler accepted",
    box1Foot: "no error — unsound",
    box2Title: "property form — contravariant",
    box2Line1: "on: (handler: (e: Event) => void)",
    box2Line2: "narrow (e: MouseEvent) rejected",
    box2Foot: "error at compile time",
    foot1: "a plain Event arrives — e.button is undefined at runtime",
    foot2: "prefer the property form when the parameter must be checked",
    caption:
      "The only difference is method shorthand versus a property holding a function: the method form silently accepts the too-narrow callback, the property form rejects it.",
  },
  ru: {
    svgTitle:
      "Один слот on(handler: (e: Event) => void) в двух формах: сокращение метода бивариантно и принимает узкий обработчик MouseEvent без ошибки, поэтому e.button — undefined в рантайме; свойство-функция контравариантно и отклоняет его на этапе компиляции",
    headline: "ПАРАМЕТРЫ МЕТОДОВ БИВАРИАНТНЫ — ЛОВУШКА",
    sub: "один слот on(handler: (e: Event) => void), две формы объявления",
    box1Title: "форма метода — бивариантна",
    box1Line1: "on(handler: (e: Event) => void)",
    box1Line2: "узкий (e: MouseEvent) принят без ошибки",
    box1Foot: "нет ошибки — несоундно",
    box2Title: "свойство-функция — контравариантна",
    box2Line1: "on: (handler: (e: Event) => void)",
    box2Line2: "узкий (e: MouseEvent) отклонён",
    box2Foot: "ошибка на этапе компиляции",
    foot1: "приходит обычный Event — e.button оказывается undefined",
    foot2: "берите форму свойства, когда параметр обязан реально проверяться",
    caption:
      "Отличается только форма объявления, но вариантность переворачивается: метод-сокращение молча принимает слишком узкий колбэк, форма свойства-функции его ловит.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsGenericsVariance-3">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="40" y="92" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="205" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box1Title}</text>
      <text x="205" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line1}</text>
      <text x="205" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line2}</text>
      <text x="205" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Foot}</text>

      <rect x="430" y="92" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="595" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box2Title}</text>
      <text x="595" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line1}</text>
      <text x="595" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line2}</text>
      <text x="595" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Foot}</text>

      <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
      <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
