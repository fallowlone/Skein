<!-- TsGenericsFunctions-2 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The appears-at-least-twice rule: identity<T>(x: T): T relates two positions, while logAndDrop<T>(x: T): void and parse<T>(text: string): T use T once and are any in costume",
    headline: "USED TWICE: A RELATIONSHIP · USED ONCE: A COSTUME",
    sub: "count the occurrences of T before reaching for <T>",
    tagGood: "real generic · T × 2",
    goodLine1: "identity<T>(x: T): T",
    goodLine2: "input and output share T",
    goodLine3: "same type in, same out · OK",
    tagSmell: "smell · T × 1",
    smellLine1: "logAndDrop<T>(x: T): void",
    smellLine2: "T never comes back out",
    smellLine3: "= (x: unknown): void",
    tagWorse: "worse · T × 1",
    worseLine1: "parse<T>(text: string): T",
    worseLine2: "the caller invents T",
    worseLine3: "unchecked assertion · LIE",
    foot1: "a type parameter earns its keep by relating two positions",
    foot2: "a single-use T is any in costume — or an assertion in disguise",
    caption:
      "identity<T>(x: T): T ties the input type to the output type, so it is a real generic; logAndDrop uses T once and matches unknown, while return-only parse lets the caller invent T — an unchecked assertion the runtime never verifies.",
  },
  ru: {
    svgTitle: "Правило «встречается хотя бы дважды»: identity<T>(x: T): T связывает две позиции, а logAndDrop<T>(x: T): void и parse<T>(text: string): T используют T раз и являются any в костюме",
    headline: "ДВАЖДЫ — СВЯЗЬ · РАЗ — КОСТЮМ",
    sub: "посчитайте вхождения T, прежде чем писать <T>",
    tagGood: "настоящий дженерик · T × 2",
    goodLine1: "identity<T>(x: T): T",
    goodLine2: "вход и выход делят T",
    goodLine3: "тот же тип внутри и снаружи · OK",
    tagSmell: "запах · T × 1",
    smellLine1: "logAndDrop<T>(x: T): void",
    smellLine2: "T не возвращается наружу",
    smellLine3: "= (x: unknown): void",
    tagWorse: "хуже · T × 1",
    worseLine1: "parse<T>(text: string): T",
    worseLine2: "вызывающий выдумывает T",
    worseLine3: "непроверяемое утверждение · ЛОЖЬ",
    foot1: "параметр типа оправдывает себя, связывая две позиции",
    foot2: "однократный T — это any в костюме или замаскированное утверждение",
    caption:
      "identity<T>(x: T): T связывает тип входа с типом выхода, поэтому это настоящий дженерик; logAndDrop использует T раз и неотличим от unknown, а parse с T только в возврате позволяет вызывающему выдумать T — непроверяемое утверждение, которое рантайм никогда не проверяет.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagGood}</text>
    <rect x="35" y="118" width="230" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="150" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodLine1}</text>
    <text x="150" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodLine2}</text>
    <text x="150" y="232" text-anchor="middle" font-size={lang === "ru" ? 11 : 12} fill="var(--ink)">{t.goodLine3}</text>

    <text x="400" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagSmell}</text>
    <rect x="285" y="118" width="230" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.smellLine1}</text>
    <text x="400" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.smellLine2}</text>
    <text x="400" y="232" text-anchor="middle" font-size="12" fill="var(--ink)">{t.smellLine3}</text>

    <text x="650" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagWorse}</text>
    <rect x="535" y="118" width="230" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="650" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.worseLine1}</text>
    <text x="650" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.worseLine2}</text>
    <text x="650" y="232" text-anchor="middle" font-size={lang === "ru" ? 11 : 12} fill="var(--ink)">{t.worseLine3}</text>

    <text x="400" y="318" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="346" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
