---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle:
      "Unsound array covariance: dogs typed Dog[] is assigned to animals typed Animal[], a plain Animal is pushed through the alias, and dogs[1].bark() fails at runtime with no compile error",
    headline: "ARRAYS ARE UNSOUNDLY COVARIANT",
    sub: "Dog[] assigned to Animal[] — writes go through the alias",
    box1Title: "dogs: Dog[]",
    box1Line1: '[{ name: "Rex",',
    box1Line2: "bark: () => {} }]",
    box1Foot: "still a Dog[] elsewhere",
    arrow1: "assign",
    box2Title: "animals: Animal[]",
    box2Line1: "alias of the same array",
    box2Line2: "push({ name:",
    box2Line3: '"Whiskers" })',
    box2Foot: "a non-Dog enters Dog[]",
    arrow2: "read back",
    box3Title: "dogs[1]",
    box3Line1: ".bark()",
    box3Foot: "bark is not a function",
    foot1: "no compile error fired — the type system did not stop us",
    foot2: "a sound system would make the position invariant",
    caption:
      "TypeScript treats Array<Dog> as assignable to Array<Animal> even though arrays are mutable — a deliberate unsoundness, because read-heavy usage dominates; at runtime, bark is not a function.",
  },
  ru: {
    svgTitle:
      "Несоундная ковариантность массивов: dogs типа Dog[] присвоен animals типа Animal[], через алиас добавлен обычный Animal, и dogs[1].bark() падает в рантайме без ошибки компиляции",
    headline: "МАССИВЫ НЕСОУНДНО КОВАРИАНТНЫ",
    sub: "Dog[] присвоен Animal[] — запись идёт через алиас",
    box1Title: "dogs: Dog[]",
    box1Line1: '[{ name: "Rex",',
    box1Line2: "bark: () => {} }]",
    box1Foot: "это всё ещё Dog[]",
    arrow1: "присвоить",
    box2Title: "animals: Animal[]",
    box2Line1: "алиас того же массива",
    box2Line2: "push({ name:",
    box2Line3: '"Whiskers" })',
    box2Foot: "кладём не-Dog в Dog[]",
    arrow2: "читаем",
    box3Title: "dogs[1]",
    box3Line1: ".bark()",
    box3Foot: "bark is not a function",
    foot1: "ни одна ошибка компиляции не сработала",
    foot2: "соундная система сделала бы позицию инвариантной",
    caption:
      "TypeScript считает Array<Dog> присваиваемым Array<Animal>, хотя массивы изменяемы, — намеренная несоундность, потому что преобладает чтение из массивов; в рантайме — bark is not a function.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsGenericsVariance-2">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="40" y="92" width="180" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="130" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box1Title}</text>
      <text x="130" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line1}</text>
      <text x="130" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line2}</text>
      <text x="130" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Foot}</text>

      <text x="265" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow1}</text>
      <line x1="240" y1="186" x2="284" y2="186" stroke="var(--accent)" stroke-width="2" />
      <polygon points="284,180 284,192 296,186" fill="var(--accent)" />

      <rect x="310" y="92" width="180" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box2Title}</text>
      <text x="400" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line1}</text>
      <text x="400" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line2}</text>
      <text x="400" y="208" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line3}</text>
      <text x="400" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Foot}</text>

      <text x="535" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow2}</text>
      <line x1="510" y1="186" x2="554" y2="186" stroke="var(--accent)" stroke-width="2" />
      <polygon points="554,180 554,192 566,186" fill="var(--accent)" />

      <rect x="580" y="92" width="180" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="670" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box3Title}</text>
      <text x="670" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box3Line1}</text>
      <text x="670" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Foot}</text>

      <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
      <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
