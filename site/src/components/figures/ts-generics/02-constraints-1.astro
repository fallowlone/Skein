<!-- TsGenericsConstraints-1 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "T extends C is a two-way contract: it restricts which caller arguments pass and unlocks C's members inside the body",
    headline: "A CONSTRAINT IS A TWO-WAY CONTRACT",
    sub: "longest<T extends { length: number }>(a: T, b: T): T",
    callerHead: "caller arg",
    callerSub: "must be ⊆ C",
    contractHead: "T extends C",
    contractSub: "the contract",
    bodyHead: "body",
    bodySub: "may use C members",
    restrict: "restrict",
    unlock: "unlock",
    bodyNote: "a.length — OK",
    siteLabel: "at the call site:",
    case1arg: '"alpha"',
    case1verdict: "string — accepted",
    case2arg: "[1, 2]",
    case2verdict: "array — accepted",
    case3arg: "10",
    case3verdict: "number — rejected",
    moral: "callers give up freedom; the body gains capability",
    caption:
      "T extends { length: number } filters callers — string and arrays pass, number is rejected — and unlocks a.length inside the body: callers give up freedom, the body gains capability.",
  },
  ru: {
    svgTitle: "T extends C — двусторонний контракт: он ограничивает, какие аргументы вызывающих проходят, и открывает члены C внутри тела",
    headline: "ОГРАНИЧЕНИЕ — ДВУСТОРОННИЙ КОНТРАКТ",
    sub: "longest<T extends { length: number }>(a: T, b: T): T",
    callerHead: "аргумент",
    callerSub: "должен быть ⊆ C",
    contractHead: "T extends C",
    contractSub: "контракт",
    bodyHead: "тело",
    bodySub: "члены C доступны",
    restrict: "ограничить",
    unlock: "открыть",
    bodyNote: "a.length — OK",
    siteLabel: "в точке вызова:",
    case1arg: '"alpha"',
    case1verdict: "string — проходит",
    case2arg: "[1, 2]",
    case2verdict: "массив — проходит",
    case3arg: "10",
    case3verdict: "number — отвергается",
    moral: "вызывающие отдают свободу; тело получает возможности",
    caption:
      "T extends { length: number } фильтрует вызывающих — string и массивы проходят, number отвергается — и открывает a.length внутри тела: вызывающие отдают свободу, тело получает возможности.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsGenericsConstraints-1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="104" width="180" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="130" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.callerHead}</text>
    <text x="130" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.callerSub}</text>

    <line x1="220" y1="137" x2="289" y2="137" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsGenericsConstraints-1)" />
    <text x="255" y="124" text-anchor="middle" font-size="11" fill="var(--accent)">{t.restrict}</text>

    <rect x="295" y="104" width="210" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.contractHead}</text>
    <text x="400" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.contractSub}</text>

    <line x1="511" y1="137" x2="574" y2="137" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsGenericsConstraints-1)" />
    <text x="542" y="124" text-anchor="middle" font-size="11" fill="var(--accent)">{t.unlock}</text>

    <rect x="580" y="104" width="180" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="670" y="132" text-anchor="middle" font-size="13" fill="var(--ink)">{t.bodyHead}</text>
    <text x="670" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bodySub}</text>

    <text x="670" y="200" text-anchor="middle" font-size="12" fill="var(--accent)">{t.bodyNote}</text>

    <text x="400" y="240" text-anchor="middle" font-size="12" fill="var(--muted)">{t.siteLabel}</text>

    <rect x="40" y="262" width="220" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="150" y="290" text-anchor="middle" font-size="13" fill="var(--ink)">{t.case1arg}</text>
    <text x="150" y="312" text-anchor="middle" font-size="11" fill="var(--muted)">{t.case1verdict}</text>

    <rect x="290" y="262" width="220" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="400" y="290" text-anchor="middle" font-size="13" fill="var(--ink)">{t.case2arg}</text>
    <text x="400" y="312" text-anchor="middle" font-size="11" fill="var(--muted)">{t.case2verdict}</text>

    <rect x="540" y="262" width="220" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="650" y="290" text-anchor="middle" font-size="13" fill="var(--ink)">{t.case3arg}</text>
    <text x="650" y="312" text-anchor="middle" font-size="11" fill="var(--muted)">{t.case3verdict}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
