<!-- CapstoneTypedFeature-2 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "CreateResult models outcomes as a discriminated union on tag; narrowing scopes fields and a never guard makes a missing case fail the build",
    headline: "OUTCOMES AS A UNION, HANDLED TO NEVER",
    sub: "narrowing on tag tells the compiler which fields exist",
    tagLeft: "the union",
    left1: "CreateResult =",
    left2: 'tag: "created"',
    left3: 'tag: "invalid"',
    left4: 'tag: "thread_missing"',
    left5: "narrow on tag",
    tagMid: "narrowing",
    box1a: 'case "created"',
    box1b: "r.comment in scope",
    box2a: 'case "invalid"',
    box2b: "r.issues in scope",
    box3a: 'case "thread_missing"',
    box3b: "r.threadId in scope",
    box4a: "default: never",
    box4b: "forgot a case — error",
    tagRight: "exhaustiveness",
    right1: "add a variant,",
    right2: "forget a case,",
    right3: "r is not never —",
    right4: "build breaks",
    right5: "at the gap",
    foot: "never in default turns a forgotten case into a compile error",
    caption:
      "CreateResult models outcomes as a discriminated union on tag; narrowing tells the compiler which fields exist, and the never guard in default makes a missing case fail the build.",
  },
  ru: {
    svgTitle: "CreateResult моделирует исходы дискриминированным объединением по tag; сужение очерчивает поля, а страж never роняет сборку на пропущенном случае",
    headline: "ИСХОДЫ — ОБЪЕДИНЕНИЕ, РАЗБОР ДО КОНЦА",
    sub: "сужение по tag говорит, какие поля есть",
    tagLeft: "объединение",
    left1: "CreateResult =",
    left2: 'tag: "created"',
    left3: 'tag: "invalid"',
    left4: 'tag: "thread_missing"',
    left5: "сужай по tag",
    tagMid: "сужение",
    box1a: 'case "created"',
    box1b: "r.comment в области видимости",
    box2a: 'case "invalid"',
    box2b: "r.issues в области видимости",
    box3a: 'case "thread_missing"',
    box3b: "r.threadId в области видимости",
    box4a: "default: never",
    box4b: "забыл case — ошибка",
    tagRight: "исчерпываемость",
    right1: "новый вариант,",
    right2: "забыл case —",
    right3: "r уже не never,",
    right4: "сборка падает",
    right5: "ровно на дыре",
    foot: "never в default делает забытый case ошибкой сборки",
    caption:
      "CreateResult моделирует исходы дискриминированным объединением по tag; сужение сообщает компилятору, какие поля есть, а страж never в default роняет сборку на пропущенном случае.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="137" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="210" height="264" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="137" y="170" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="137" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="137" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left3}</text>
    <text x="137" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left4}</text>
    <text x="137" y="274" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left5}</text>

    <text x="400" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagMid}</text>
    <rect x="270" y="116" width="260" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="139" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1a}</text>
    <text x="400" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box1b}</text>
    <rect x="270" y="180" width="260" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="203" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2a}</text>
    <text x="400" y="224" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box2b}</text>
    <rect x="270" y="244" width="260" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="267" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3a}</text>
    <text x="400" y="288" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box3b}</text>
    <rect x="270" y="308" width="260" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="331" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box4a}</text>
    <text x="400" y="352" text-anchor="middle" font-size="11" fill="var(--accent)">{t.box4b}</text>

    <text x="663" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="558" y="116" width="210" height="264" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="663" y="170" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="663" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="663" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right3}</text>
    <text x="663" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right4}</text>
    <text x="663" y="274" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right5}</text>

    <text x="400" y="406" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
