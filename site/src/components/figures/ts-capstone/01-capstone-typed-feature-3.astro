---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "the driver yields unknown, parse earns Comment[] at the boundary while as only asserts it, then typeof appRouter carries the contract to the client",
    headline: "PARSE AT THE BOUNDARY, INFER THE CLIENT",
    sub: "a static type on unknown is a promise the runtime never made",
    tagLeft: "the boundary",
    left1: "driver gives",
    left2: "unknown[]",
    left3: "as Comment[] — lie",
    left4: "zero runtime checks",
    left5: "parse — earned",
    tagMid: "parse, don't cast",
    row1: "as Comment[] — compiles",
    row2: "createdAt still string",
    row3: ".getTime crashes later",
    row4: "parse(rows) — validates",
    row5: "coerces createdAt",
    row6: "throws ZodError early",
    row7: "typeof appRouter",
    row8: "client infers Comment[]",
    tagRight: "the client",
    right1: "server exports",
    right2: "typeof appRouter",
    right3: "client infers",
    right4: "Comment[] — zero",
    right5: "re-declaration",
    foot: "rename body to text and the component stops compiling",
    caption:
      "The driver yields unknown; parse earns Comment[] at the boundary while as only asserts it — then typeof appRouter carries the contract to the client with zero re-declaration.",
  },
  ru: {
    svgTitle: "драйвер отдаёт unknown, parse зарабатывает Comment[] на границе, а as лишь заявляет его, затем typeof appRouter доносит контракт до клиента",
    headline: "РАЗБОР НА ГРАНИЦЕ, ВЫВОД У КЛИЕНТА",
    sub: "тип на unknown — обещание, которого рантайм не давал",
    tagLeft: "граница",
    left1: "драйвер отдаёт",
    left2: "unknown[]",
    left3: "as Comment[] — ложь",
    left4: "ноль проверок",
    left5: "parse — заработан",
    tagMid: "разбирай, не приводи",
    row1: "as — соберётся, упадёт",
    row2: "createdAt всё ещё строка",
    row3: ".getTime упадёт позже",
    row4: "parse(rows) — проверка",
    row5: "приводит createdAt",
    row6: "бросает ZodError рано",
    row7: "typeof appRouter",
    row8: "клиент выводит Comment[]",
    tagRight: "клиент",
    right1: "сервер отдаёт",
    right2: "typeof appRouter",
    right3: "клиент выводит",
    right4: "Comment[] — ноль",
    right5: "переобъявлений",
    foot: "переименуй body в text — компонент не соберётся",
    caption:
      "Драйвер отдаёт unknown; parse зарабатывает Comment[] на границе, а as лишь заявляет его — затем typeof appRouter доносит контракт до клиента без переобъявления.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="137" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="210" height="264" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="137" y="170" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="137" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="137" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left3}</text>
    <text x="137" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left4}</text>
    <text x="137" y="274" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left5}</text>

    <text x="400" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagMid}</text>
    <rect x="270" y="116" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="133" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row1}</text>
    <rect x="270" y="150" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="167" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row2}</text>
    <rect x="270" y="184" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="201" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row3}</text>
    <rect x="270" y="218" width="260" height="26" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="235" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row4}</text>
    <rect x="270" y="252" width="260" height="26" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="269" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row5}</text>
    <rect x="270" y="286" width="260" height="26" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="303" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row6}</text>
    <rect x="270" y="320" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="337" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row7}</text>
    <rect x="270" y="354" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="371" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row8}</text>

    <text x="663" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="558" y="116" width="210" height="264" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="663" y="170" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="663" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="663" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right3}</text>
    <text x="663" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right4}</text>
    <text x="663" y="274" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right5}</text>

    <text x="400" y="406" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
