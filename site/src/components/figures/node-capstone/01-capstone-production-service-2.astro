---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Production layers interlock, not checkboxes: graceful shutdown needs the readiness probe so the load balancer learns draining, the error boundary needs an unblocked loop so the boundary runs, schema validation needs a size-capped body parser",
    headline: "LAYERS INTERLOCK, NOT CHECKBOXES",
    sub: "each layer needs another layer to work",
    left1: "graceful shutdown",
    need1: "needs",
    right1a: "readiness probe",
    right1b: "LB learns draining",
    left2: "error boundary",
    need2: "needs",
    right2a: "unblocked loop",
    right2b: "boundary runs",
    left3: "schema validation",
    need3: "needs",
    right3a: "size-capped body parser",
    right3b: "4 MB body rejected early",
    caption:
      "Layers interlock: shutdown needs the readiness probe, the boundary needs a free loop, validation needs a capped body.",
  },
  ru: {
    svgTitle: "Production-слои сцеплены, а не галочки: graceful shutdown нужна readiness-проба, чтобы балансировщик узнал о сливе, границе ошибок нужен свободный loop, чтобы граница выполнилась, валидации по схеме нужен парсер с лимитом размера",
    headline: "СЛОИ СЦЕПЛЕНЫ, А НЕ ГАЛОЧКИ",
    sub: "каждому слою нужен другой слой",
    left1: "graceful shutdown",
    need1: "нужен",
    right1a: "readiness-проба",
    right1b: "LB узнаёт о сливе",
    left2: "граница ошибок",
    need2: "нужен",
    right2a: "свободный loop",
    right2b: "граница выполнится",
    left3: "валидация по схеме",
    need3: "нужен",
    right3a: "парсер с лимитом",
    right3b: "тело 4 МБ режем рано",
    caption:
      "Слои сцеплены: shutdown нужна readiness-проба, границе — свободный loop, валидации — парсер с лимитом.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="100" width="250" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="155" y="135" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <line x1="280" y1="130" x2="348" y2="130" stroke="var(--muted)" stroke-width="2" />
    <rect x="352" y="112" width="96" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="135" text-anchor="middle" font-size="11" fill="var(--ink)">{t.need1}</text>
    <line x1="452" y1="130" x2="506" y2="130" stroke="var(--muted)" stroke-width="2" />
    <polygon points="506,123 520,130 506,137" fill="var(--muted)" />
    <rect x="520" y="100" width="250" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="645" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1a}</text>
    <text x="645" y="146" text-anchor="middle" font-size="11" fill="var(--muted)">{t.right1b}</text>

    <rect x="30" y="200" width="250" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="155" y="235" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <line x1="280" y1="230" x2="348" y2="230" stroke="var(--muted)" stroke-width="2" />
    <rect x="352" y="212" width="96" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="235" text-anchor="middle" font-size="11" fill="var(--ink)">{t.need2}</text>
    <line x1="452" y1="230" x2="506" y2="230" stroke="var(--muted)" stroke-width="2" />
    <polygon points="506,223 520,230 506,237" fill="var(--muted)" />
    <rect x="520" y="200" width="250" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="645" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2a}</text>
    <text x="645" y="246" text-anchor="middle" font-size="11" fill="var(--muted)">{t.right2b}</text>

    <rect x="30" y="300" width="250" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="155" y="335" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left3}</text>
    <line x1="280" y1="330" x2="348" y2="330" stroke="var(--muted)" stroke-width="2" />
    <rect x="352" y="312" width="96" height="36" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="335" text-anchor="middle" font-size="11" fill="var(--ink)">{t.need3}</text>
    <line x1="452" y1="330" x2="506" y2="330" stroke="var(--muted)" stroke-width="2" />
    <polygon points="506,323 520,330 506,337" fill="var(--muted)" />
    <rect x="520" y="300" width="250" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="645" y="324" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right3a}</text>
    <text x="645" y="346" text-anchor="middle" font-size="11" fill="var(--muted)">{t.right3b}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
