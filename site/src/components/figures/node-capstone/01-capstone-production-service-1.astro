---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Each skipped production layer paired with its named incident: no error boundary leaks stacks, a blocked loop pushes p99 from 40 ms to 9 s, no graceful shutdown drops in-flight requests, unvalidated input means SQL injection, config baked into the image blocks promotion and leaks secrets",
    headline: "SKIP A LAYER, BOOK AN INCIDENT",
    sub: "each missing row has a name",
    layer1: "no error boundary",
    layer2: "blocked event loop",
    layer3: "no graceful shutdown",
    layer4: "unvalidated input",
    layer5: "config baked into image",
    incident1: "leaked stack traces",
    incident2: "p99 40 ms → 9 s",
    incident3: "dropped in-flight requests",
    incident4: "SQL injection",
    incident5: "blocked promotion + leaked secrets",
    caption:
      "Skip a row and you don't get a smaller service — you book a specific outage with a name.",
  },
  ru: {
    svgTitle: "Каждый пропущенный production-слой и его именованный инцидент: нет границы ошибок — текут стеки, заблокированный loop гонит p99 с 40 мс до 9 с, нет graceful shutdown — теряются запросы в полёте, невалидированный вход — SQL-инъекция, конфиг в образе блокирует перенос и утекает секретами",
    headline: "ПРОПУСТИЛ СЛОЙ — ЗАБРОНИРОВАЛ АВАРИЮ",
    sub: "у каждой пропущенной строки есть имя",
    layer1: "нет границы ошибок",
    layer2: "заблокированный loop",
    layer3: "нет graceful shutdown",
    layer4: "невалидированный вход",
    layer5: "конфиг зашит в образ",
    incident1: "утечка стеков",
    incident2: "p99 40 мс → 9 с",
    incident3: "потеря запросов в полёте",
    incident4: "SQL-инъекция",
    incident5: "стоп переноса + утечка секретов",
    caption:
      "Пропусти строку — и получишь не сервис поменьше, а конкретную аварию с именем.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="84" width="300" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="180" y="111" text-anchor="middle" font-size="12" fill="var(--ink)">{t.layer1}</text>
    <line x1="330" y1="106" x2="412" y2="106" stroke="var(--muted)" stroke-width="2" />
    <polygon points="412,99 426,106 412,113" fill="var(--muted)" />
    <rect x="430" y="84" width="340" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="111" text-anchor="middle" font-size="11" fill="var(--ink)">{t.incident1}</text>

    <rect x="30" y="144" width="300" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="180" y="171" text-anchor="middle" font-size="12" fill="var(--ink)">{t.layer2}</text>
    <line x1="330" y1="166" x2="412" y2="166" stroke="var(--muted)" stroke-width="2" />
    <polygon points="412,159 426,166 412,173" fill="var(--muted)" />
    <rect x="430" y="144" width="340" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="171" text-anchor="middle" font-size="11" fill="var(--ink)">{t.incident2}</text>

    <rect x="30" y="204" width="300" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="180" y="231" text-anchor="middle" font-size="12" fill="var(--ink)">{t.layer3}</text>
    <line x1="330" y1="226" x2="412" y2="226" stroke="var(--muted)" stroke-width="2" />
    <polygon points="412,219 426,226 412,233" fill="var(--muted)" />
    <rect x="430" y="204" width="340" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="231" text-anchor="middle" font-size="11" fill="var(--ink)">{t.incident3}</text>

    <rect x="30" y="264" width="300" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="180" y="291" text-anchor="middle" font-size="12" fill="var(--ink)">{t.layer4}</text>
    <line x1="330" y1="286" x2="412" y2="286" stroke="var(--muted)" stroke-width="2" />
    <polygon points="412,279 426,286 412,293" fill="var(--muted)" />
    <rect x="430" y="264" width="340" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="291" text-anchor="middle" font-size="11" fill="var(--ink)">{t.incident4}</text>

    <rect x="30" y="324" width="300" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="180" y="351" text-anchor="middle" font-size="12" fill="var(--ink)">{t.layer5}</text>
    <line x1="330" y1="346" x2="412" y2="346" stroke="var(--muted)" stroke-width="2" />
    <polygon points="412,339 426,346 412,353" fill="var(--muted)" />
    <rect x="430" y="324" width="340" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="351" text-anchor="middle" font-size="11" fill="var(--ink)">{t.incident5}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
