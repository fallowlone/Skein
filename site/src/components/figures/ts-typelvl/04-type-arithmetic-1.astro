---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "BuildTuple encodes 3 and 4 as tuples of unknown; Add spreads both into one 7-tuple and reads length 7",
    headline: "N IS A TUPLE OF LENGTH N",
    sub: "BuildTuple pushes unknown until length equals N",
    leftTitle: "BuildTuple<3>",
    leftRow1: "[u, u, u]",
    leftRow2: "length = 3",
    rightTitle: "BuildTuple<4>",
    rightRow1: "[u, u, u, u]",
    rightRow2: "length = 4",
    mid: "[...BuildTuple<3>, ...BuildTuple<4>]",
    outTitle: "Add<3, 4>",
    outRow1: "[u, u, u, u, u, u, u]",
    outRow2: '["length"] & number = 7',
    foot: "concatenation IS addition",
    caption:
      "BuildTuple<3> and BuildTuple<4> materialize tuples of unknown of length 3 and 4; spreading both into one 7-tuple and reading [\"length\"] narrowed by & number gives the literal type 7 — concatenation is addition.",
  },
  ru: {
    svgTitle: "BuildTuple кодирует 3 и 4 как кортежи из unknown; Add спредит оба в один кортеж из 7 и читает длину 7",
    headline: "ЧИСЛО — ЭТО ДЛИНА КОРТЕЖА",
    sub: "BuildTuple растит unknown, пока длина не совпадёт с N",
    leftTitle: "BuildTuple<3>",
    leftRow1: "[u, u, u]",
    leftRow2: "длина 3",
    rightTitle: "BuildTuple<4>",
    rightRow1: "[u, u, u, u]",
    rightRow2: "длина 4",
    mid: "[...BuildTuple<3>, ...BuildTuple<4>]",
    outTitle: "Add<3, 4>",
    outRow1: "[u, u, u, u, u, u, u]",
    outRow2: '["length"] & number = 7',
    foot: "конкатенация — это + на уровне типов",
    caption:
      "BuildTuple<3> и BuildTuple<4> материализуют кортежи из unknown длины 3 и 4; спред обоих в один кортеж из 7 и чтение [\"length\"], суженного через & number, даёт литеральный тип 7 — конкатенация есть сложение.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsTypelvlArith-1">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="40" y="80" width="330" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="205" y="108" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
      <text x="205" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftRow1}</text>
      <text x="205" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftRow2}</text>

      <rect x="430" y="80" width="330" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="595" y="108" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
      <text x="595" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightRow1}</text>
      <text x="595" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightRow2}</text>

      <line x1="205" y1="180" x2="205" y2="214" stroke="var(--muted)" stroke-width="2" />
      <polygon points="205,222 200,211 210,211" fill="var(--muted)" />
      <line x1="595" y1="180" x2="595" y2="214" stroke="var(--muted)" stroke-width="2" />
      <polygon points="595,222 590,211 600,211" fill="var(--muted)" />

      <text x="400" y="212" text-anchor="middle" font-size="11" fill="var(--muted)">{t.mid}</text>

      <rect x="150" y="240" width="500" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="268" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outTitle}</text>
      <text x="400" y="294" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outRow1}</text>
      <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outRow2}</text>

      <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
