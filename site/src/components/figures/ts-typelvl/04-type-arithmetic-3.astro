---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "GreaterThan races tuple lengths via prefix matching; ParseInt coerces a numeric string with infer N extends number; arithmetic is capped near the 1000 recursion limit",
    headline: "COMPARE, PARSE, AND THE CEILING",
    sub: "race the lengths, coerce numeric strings, respect the limit",
    srcTitle: "GreaterThan<5, 3>",
    srcRow1: "does the 3-tuple have a 5-prefix?",
    srcRow2: "no -> true",
    midTop: "prefix race",
    midBottom: "match + coerce",
    outTitle: 'ParseInt<"42">',
    outRow1: "`${infer N extends number}`",
    outRow2: "N = 42: number, not string",
    step1: "GreaterThan<4, 4> = false: equal lengths, prefix holds",
    step2: "ParseInt needs infer N extends number (TS 4.8+)",
    step3: "ceiling ~1000: Add<400, 400> lags on every reference",
    foot: "correct for small fixed sizes, not a calculator",
    caption:
      "GreaterThan<5, 3> is true because the 3-tuple has no 5-prefix, while equal lengths give false; ParseInt<\"42\"> captures and coerces via infer N extends number to the numeric literal 42; every number is a real tuple, so arithmetic stays bounded near ~1000 and slow.",
  },
  ru: {
    svgTitle: "GreaterThan гоняет длины кортежей через матч префикса; ParseInt приводит числовую строку через infer N extends number; арифметика упирается в лимит рекурсии ~1000",
    headline: "ГОНКА ДЛИН, ПАРСИНГ И ПОТОЛОК",
    sub: "гонка длин, приведение строк, лимит",
    srcTitle: "GreaterThan<5, 3>",
    srcRow1: "у 3-кортежа есть префикс из 5?",
    srcRow2: "нет -> true",
    midTop: "гонка длин",
    midBottom: "захват и приведение",
    outTitle: 'ParseInt<"42">',
    outRow1: "`${infer N extends number}`",
    outRow2: "N = 42: число, а не строка",
    step1: "GreaterThan<4, 4> = false: длины равны, префикс совпал",
    step2: "ParseInt нужен infer N extends number (TS 4.8+)",
    step3: "потолок ~1000: Add<400, 400> тормозит на каждой ссылке",
    foot: "корректно для малых фиксированных размеров, а не калькулятор",
    caption:
      "GreaterThan<5, 3> — это true, потому что у 3-кортежа нет префикса из 5, а равные длины дают false; ParseInt<\"42\"> захватывает и приводит через infer N extends number к числовому литералу 42; каждое число — реальный кортеж, поэтому арифметика ограничена около ~1000 и медленна.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsTypelvlArith-3">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="60" y="80" width="260" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="190" y="110" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcTitle}</text>
      <text x="190" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcRow1}</text>
      <text x="190" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcRow2}</text>

      <text x="400" y="112" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midTop}</text>
      <line x1="330" y1="140" x2="462" y2="140" stroke="var(--muted)" stroke-width="2" />
      <polygon points="470,140 459,135 459,145" fill="var(--muted)" />
      <text x="400" y="166" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midBottom}</text>

      <rect x="480" y="80" width="260" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="610" y="110" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outTitle}</text>
      <text x="610" y="136" text-anchor="middle" font-size="11" fill="var(--ink)">{t.outRow1}</text>
      <text x="610" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outRow2}</text>

      <line x1="190" y1="200" x2="190" y2="240" stroke="var(--muted)" stroke-width="2" />
      <polygon points="190,248 185,237 195,237" fill="var(--muted)" />
      <line x1="610" y1="200" x2="610" y2="240" stroke="var(--muted)" stroke-width="2" />
      <polygon points="610,248 605,237 615,237" fill="var(--muted)" />

      <rect x="150" y="248" width="500" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="276" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step1}</text>
      <text x="400" y="302" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step2}</text>
      <text x="400" y="328" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step3}</text>

      <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
