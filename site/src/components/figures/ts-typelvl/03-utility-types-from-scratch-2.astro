---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "ReturnType, Parameters and the recursive Awaited extracting types with infer",
    headline: "INFER FAMILY: PULL OUT THE INTERESTING PART",
    sub: "ReturnType · Parameters · Awaited — infer inside a conditional",
    tagReturn: "1 — return type",
    boxReturnTitle: "ReturnType<F>",
    boxReturnLine1: "(...args: any) => infer R",
    boxReturnLine2: "? R : any",
    boxReturnFoot: "infer in conditional",
    tagArgs: "2 — arg tuple",
    boxArgsTitle: "Parameters<F>",
    boxArgsLine1: "(...args: infer P) => any",
    boxArgsLine2: "? P : never",
    boxArgsFoot: "infer the arg tuple",
    tagUnwrap: "3 — recursion",
    boxUnwrapTitle: "MyAwaited<T>",
    boxUnwrapLine1: "Promise<Promise<string>>",
    boxUnwrapLine2: "=> string — both layers",
    boxUnwrapFoot: "recursion unwraps both layers",
    foot1: "each matches a callable shape and infers one piece — only Awaited calls itself",
    foot2: "Awaited<Promise<Promise<string>>> = string",
    caption:
      "ReturnType, Parameters and InstanceType infer one piece of a callable shape; Awaited is the recursive one — it unwraps nested promises down to the final value.",
  },
  ru: {
    svgTitle: "ReturnType, Parameters и рекурсивный Awaited извлекают типы через infer",
    headline: "СЕМЕЙСТВО УСЛОВНЫХ: ВЫВЕСТИ ИНТЕРЕСНУЮ ЧАСТЬ",
    sub: "ReturnType · Parameters · Awaited — infer в условии",
    tagReturn: "1 — тип возврата",
    boxReturnTitle: "ReturnType<F>",
    boxReturnLine1: "(...args: any) => infer R",
    boxReturnLine2: "? R : any",
    boxReturnFoot: "infer в условии",
    tagArgs: "2 — кортеж аргументов",
    boxArgsTitle: "Parameters<F>",
    boxArgsLine1: "(...args: infer P) => any",
    boxArgsLine2: "? P : never",
    boxArgsFoot: "infer кортежа аргументов",
    tagUnwrap: "3 — рекурсия",
    boxUnwrapTitle: "MyAwaited<T>",
    boxUnwrapLine1: "Promise<Promise<string>>",
    boxUnwrapLine2: "=> string — оба слоя",
    boxUnwrapFoot: "рекурсия — оба слоя сразу",
    foot1: "первые три матчатся один раз — Awaited вызывает себя, пока значение остаётся промисом",
    foot2: "Awaited<Promise<Promise<string>>> = string",
    caption:
      "ReturnType, Parameters и InstanceType через infer вытаскивают кусок из структурной формы; Awaited — рекурсивный: он вызывает себя, пока значение остаётся промисом.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsTypelvlUtil-2" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="145" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagReturn}</text>
    <rect x="40" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="145" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxReturnTitle}</text>
    <text x="145" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxReturnLine1}</text>
    <text x="145" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxReturnLine2}</text>
    <text x="145" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxReturnFoot}</text>

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagArgs}</text>
    <rect x="295" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxArgsTitle}</text>
    <text x="400" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxArgsLine1}</text>
    <text x="400" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxArgsLine2}</text>
    <text x="400" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxArgsFoot}</text>

    <text x="655" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagUnwrap}</text>
    <rect x="550" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="655" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxUnwrapTitle}</text>
    <text x="655" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxUnwrapLine1}</text>
    <text x="655" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxUnwrapLine2}</text>
    <text x="655" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxUnwrapFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
