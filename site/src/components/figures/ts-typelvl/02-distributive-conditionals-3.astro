---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "never is the empty union: Wrap over never runs zero times and yields never, wrapping opts out so IsNever is true, Exclude filters via never",
    headline: "NEVER IS ZERO MEMBERS",
    sub: "Wrap<T> = T extends unknown ? T[] : never",
    callHead: "call",
    callSub: "Wrap<never>",
    emptyHead: "distribution",
    emptySub: "0 members — body never runs",
    neverHead: "result",
    neverSub: "never, not never[]",
    arrowSplit: "distribute",
    arrowNothing: "nothing",
    barLine: "IsNever<never> = true · [T] extends [never]",
    note: "wrapped: the empty union is assignable to [never]",
    moral: "Exclude maps the unwanted to never — and never vanishes: X | never = X",
    caption:
      "Wrap<never> is never because distribution over the empty union runs the body zero times; wrapping in [T] opts out so IsNever<never> is true, and Exclude filters unions by mapping unwanted members to never, which disappears on recombination.",
  },
  ru: {
    svgTitle: "never — пустое объединение: Wrap над never выполняется ноль раз и даёт never, обёртка отключает это, и IsNever — true, а Exclude фильтрует через never",
    headline: "NEVER — ЭТО НУЛЬ ЧЛЕНОВ",
    sub: "Wrap<T> = T extends unknown ? T[] : never",
    callHead: "вызов",
    callSub: "Wrap<never>",
    emptyHead: "дистрибуция",
    emptySub: "0 членов — тело не выполняется",
    neverHead: "результат",
    neverSub: "never, а не never[]",
    arrowSplit: "распредели",
    arrowNothing: "ничего",
    barLine: "IsNever<never> = true · [T] extends [never]",
    note: "обёрнуто: пустое объединение присваивается [never]",
    moral: "Exclude отображает ненужных в never — а never исчезает: X | never = X",
    caption:
      "Wrap<never> — это never, потому что дистрибуция над пустым объединением выполняет тело ноль раз; обёртка в [T] это отключает, поэтому IsNever<never> — true, а Exclude фильтрует объединения, отображая ненужные члены в never, который исчезает при пересборке.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsTypelvlDistrib-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="100" width="170" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="105" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.callHead}</text>
    <text x="105" y="152" text-anchor="middle" font-size="12" fill="var(--muted)">{t.callSub}</text>

    <line x1="190" y1="138" x2="270" y2="138" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsTypelvlDistrib-3)" />
    <text x="230" y="124" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowSplit}</text>

    <rect x="280" y="100" width="240" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.emptyHead}</text>
    <text x="400" y="152" text-anchor="middle" font-size="12" fill="var(--muted)">{t.emptySub}</text>

    <line x1="520" y1="138" x2="580" y2="138" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsTypelvlDistrib-3)" />
    <text x="550" y="124" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowNothing}</text>

    <rect x="590" y="100" width="190" height="76" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="685" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.neverHead}</text>
    <text x="685" y="152" text-anchor="middle" font-size="12" fill="var(--accent)">{t.neverSub}</text>

    <rect x="30" y="215" width="740" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="250" text-anchor="middle" font-size="15" fill="var(--accent)">{t.barLine}</text>

    <text x="400" y="305" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>

    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
