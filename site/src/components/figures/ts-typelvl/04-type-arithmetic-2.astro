---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Subtract strips 3 elements off the front of the 5-tuple via infer Rest, leaving length 2; underflow to never",
    headline: "SUBTRACT: INFER OFF THE FRONT",
    sub: "strip B elements off the front, read the Rest length",
    srcTitle: "BuildTuple<5>",
    srcRow1: "[u, u, u, u, u]",
    srcRow2: "length = 5",
    midTop: "strip 3 off the front",
    midBottom: "infer Rest",
    outTitle: "Subtract<5, 3>",
    outRow1: "Rest = [u, u]",
    outRow2: 'Rest["length"] = 2',
    step1: "A >= B: prefix matches, Rest length is A - B",
    step2: "Subtract<3, 5>: no 5-prefix in a 3-tuple -> never",
    step3: "negatives are unrepresentable — never is the signal",
    foot: "infer off the front IS subtraction",
    caption:
      "Subtract<5, 3> matches the prefix [...BuildTuple<3>, ...infer Rest] against the 5-tuple, leaving Rest = [u, u] with length 2; Subtract<3, 5> has no 5-prefix to match, so underflow falls through to never.",
  },
  ru: {
    svgTitle: "Subtract срезает 3 элемента с начала 5-кортежа через infer Rest, остаётся длина 2; недобор — в never",
    headline: "ВЫЧИТАНИЕ: INFER С НАЧАЛА",
    sub: "срезать B элементов с начала, считать длину Rest",
    srcTitle: "BuildTuple<5>",
    srcRow1: "[u, u, u, u, u]",
    srcRow2: "длина 5",
    midTop: "срезать 3 с начала",
    midBottom: "infer Rest",
    outTitle: "Subtract<5, 3>",
    outRow1: "Rest = [u, u]",
    outRow2: 'Rest["length"] = 2',
    step1: "A >= B: префикс совпал, длина Rest — это A - B",
    step2: "Subtract<3, 5>: в 3-кортеже нет префикса из 5 -> never",
    step3: "отрицательные непредставимы — never это сигнал",
    foot: "вычитание — это infer с начала",
    caption:
      "Subtract<5, 3> матчит префикс [...BuildTuple<3>, ...infer Rest] против 5-кортежа, остаётся Rest = [u, u] длины 2; у Subtract<3, 5> нет префикса из 5, поэтому недобор проваливается в never.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsTypelvlArith-2">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="60" y="80" width="260" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="190" y="110" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcTitle}</text>
      <text x="190" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcRow1}</text>
      <text x="190" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcRow2}</text>

      <text x="400" y="112" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midTop}</text>
      <line x1="330" y1="140" x2="462" y2="140" stroke="var(--muted)" stroke-width="2" />
      <polygon points="470,140 459,135 459,145" fill="var(--muted)" />
      <text x="400" y="166" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midBottom}</text>

      <rect x="480" y="80" width="260" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="610" y="110" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outTitle}</text>
      <text x="610" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outRow1}</text>
      <text x="610" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outRow2}</text>

      <line x1="190" y1="200" x2="190" y2="240" stroke="var(--muted)" stroke-width="2" />
      <polygon points="190,248 185,237 195,237" fill="var(--muted)" />
      <line x1="610" y1="200" x2="610" y2="240" stroke="var(--muted)" stroke-width="2" />
      <polygon points="610,248 605,237 615,237" fill="var(--muted)" />

      <rect x="150" y="248" width="500" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="276" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step1}</text>
      <text x="400" y="302" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step2}</text>
      <text x="400" y="328" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step3}</text>

      <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
