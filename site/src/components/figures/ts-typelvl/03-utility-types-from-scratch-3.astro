---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "stdlib Omit collapses on a union to an empty object while DistributiveOmit maps per variant",
    headline: "THE OMIT TRAP: SHARED KEYS ONLY",
    sub: 'Omit<T, K> = Pick<T, Exclude<keyof T, K>> — non-distributive by design',
    tagDef: "1 — definition",
    boxDefTitle: "Omit<T, K>",
    boxDefLine1: "Pick<T, Exclude<",
    boxDefLine2: "keyof T, K>>",
    boxDefFoot: "operates on T as a whole",
    tagCollapse: "2 — keyof collapses",
    boxCollapseTitle: "keyof (Circle | Square)",
    boxCollapseLine1: '= "kind"',
    boxCollapseLine2: "shared key only",
    boxCollapseFoot: "union keys are the shared ones",
    tagFix: "3 — one-line fix",
    boxFixTitle: "DistributiveOmit",
    boxFixLine1: "T extends unknown",
    boxFixLine2: "? Omit<T, K> : never",
    boxFixFoot: "Omit runs once per variant",
    foot1: 'keyof Shape is only "kind" — removing it leaves nothing: Omit<Shape, "kind"> = {}',
    foot2: "Good = { radius: number } | { side: number } — distribution is the opt-in",
    caption:
      "stdlib Omit acts on the union as a whole, so keyof keeps only shared keys and Omit<Shape, \"kind\"> collapses to {}; the naked-conditional wrapper distributes Omit per variant — the one-line fix.",
  },
  ru: {
    svgTitle: "стандартный Omit схлопывается на объединении в пустой объект, а DistributiveOmit отображает по вариантам",
    headline: "ЛОВУШКА OMIT: ЛИШЬ ОБЩИЕ КЛЮЧИ",
    sub: "Omit<T, K> = Pick<T, Exclude<keyof T, K>> — по дизайну не-дистрибутивен",
    tagDef: "1 — определение",
    boxDefTitle: "Omit<T, K>",
    boxDefLine1: "Pick<T, Exclude<",
    boxDefLine2: "keyof T, K>>",
    boxDefFoot: "работает с T как с целым",
    tagCollapse: "2 — keyof схлопывается",
    boxCollapseTitle: "keyof (Circle | Square)",
    boxCollapseLine1: '= "kind"',
    boxCollapseLine2: "лишь общий ключ",
    boxCollapseFoot: "ключи объединения — общие",
    tagFix: "3 — фикс в одну строку",
    boxFixTitle: "DistributiveOmit",
    boxFixLine1: "T extends unknown",
    boxFixLine2: "? Omit<T, K> : never",
    boxFixFoot: "Omit выполняется раз на вариант",
    foot1: 'keyof Shape — это только "kind"; убрав его, не остаётся ничего: Omit<Shape, "kind"> = {}',
    foot2: "Good = { radius: number } | { side: number } — DistributiveOmit — это явный opt-in",
    caption:
      "Стандартный Omit работает с объединением как с целым, поэтому keyof держит лишь общие ключи и Omit<Shape, \"kind\"> схлопывается в {}; обёртка в условие с голым параметром распределяет Omit по вариантам — фикс в одну строку.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsTypelvlUtil-3" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="145" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagDef}</text>
    <rect x="40" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="145" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxDefTitle}</text>
    <text x="145" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxDefLine1}</text>
    <text x="145" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxDefLine2}</text>
    <text x="145" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxDefFoot}</text>

    <line x1="254" y1="221" x2="281" y2="221" stroke="var(--muted)" stroke-width="2" />
    <polygon points="281,214 291,221 281,228" fill="var(--muted)" />

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagCollapse}</text>
    <rect x="295" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxCollapseTitle}</text>
    <text x="400" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxCollapseLine1}</text>
    <text x="400" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxCollapseLine2}</text>
    <text x="400" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxCollapseFoot}</text>

    <line x1="509" y1="221" x2="536" y2="221" stroke="var(--muted)" stroke-width="2" />
    <polygon points="536,214 546,221 536,228" fill="var(--muted)" />

    <text x="655" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagFix}</text>
    <rect x="550" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="655" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxFixTitle}</text>
    <text x="655" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxFixLine1}</text>
    <text x="655" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxFixLine2}</text>
    <text x="655" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxFixFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--ink)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
