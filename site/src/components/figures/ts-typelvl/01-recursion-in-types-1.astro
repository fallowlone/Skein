<!-- TsTypelvlRecursion-1 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Anatomy of a recursive type: base case returns [] without recursing, recursive case peels [infer Head, ...infer Tail] and self-calls on the smaller Tail",
    headline: "TWO ARMS: BASE CASE + RECURSIVE CASE",
    sub: "peel [Head, ...Tail] — recurse on the smaller Tail — stop at []",
    tag1: "1 · base case, no self-call",
    box1line1: "[] fails extends",
    box1line2: "falls to else arm",
    box1line3: "returns [] — stops",
    tag2: "2 · peel — infer Head, ...Tail",
    box2line1: "[infer Head, ...infer Tail]",
    box2line2: "matches non-empty tuple",
    box2line3: "Head=1 Tail=[2,3]",
    tag3: "3 · recurse on smaller Tail",
    box3line1: "[...Reverse<Tail>, Head]",
    box3line2: "self-call on smaller input",
    box3line3: "shrinks by one per step",
    foot1: "Reverse, Join and Includes share this skeleton — only the accumulation differs",
    foot2: "a missing base case is an infinite type — check the base first, then the call position",
    caption:
      "Every recursive type is a base case that returns without recursing plus a recursive case that peels [infer Head, ...infer Tail] and self-calls on the smaller Tail.",
  },
  ru: {
    svgTitle: "Анатомия рекурсивного типа: базовый случай возвращает [] без рекурсии, рекурсивный случай отрезает [infer Head, ...infer Tail] и вызывает себя на меньшем Tail",
    headline: "ДВЕ ВЕТКИ: БАЗА + РЕКУРСИЯ",
    sub: "отрежь [Head, ...Tail] — рекурсируй на меньшем Tail — встань на []",
    tag1: "1 · базовый случай, без самовызова",
    box1line1: "[] не проходит extends",
    box1line2: "проваливается в else",
    box1line3: "возвращает [] — стоп",
    tag2: "2 · срез — infer Head, ...Tail",
    box2line1: "[infer Head, ...infer Tail]",
    box2line2: "матчит непустой кортеж",
    box2line3: "Head=1 Tail=[2,3]",
    tag3: "3 · рекурсия на меньшем Tail",
    box3line1: "[...Reverse<Tail>, Head]",
    box3line2: "самовызов на меньшем входе",
    box3line3: "минус один элемент за шаг",
    foot1: "Reverse, Join и Includes делят этот скелет — различается лишь накопление",
    foot2: "пропавшая база — бесконечный тип: сначала проверьте базу, затем позицию вызова",
    caption:
      "Любой рекурсивный тип — это базовый случай, возвращающий без рекурсии, плюс рекурсивный случай, отрезающий [infer Head, ...infer Tail] и вызывающий себя на меньшем Tail.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="142" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="32" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="142" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line1}</text>
    <text x="142" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line2}</text>
    <text x="142" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box1line3}</text>

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="290" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line1}</text>
    <text x="400" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line2}</text>
    <text x="400" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box2line3}</text>

    <text x="658" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="548" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="658" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line1}</text>
    <text x="658" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line2}</text>
    <text x="658" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box3line3}</text>

    <text x="400" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
