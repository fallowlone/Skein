---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "How ToArray distributes: string | number splits into per-member checks and recombines into string[] | number[]",
    headline: "ONE CHECK BECOMES TWO",
    sub: "ToArray<T> = T extends unknown ? T[] : never",
    inputHead: "input union",
    inputSub: "string | number",
    m1Head: "member 1: string",
    m1Sub: "yields string[]",
    m2Head: "member 2: number",
    m2Sub: "yields number[]",
    resultHead: "recombine",
    resultSub: "string[] | number[]",
    arrow1: "member 1",
    arrow2: "member 2",
    arrow3: "string[]",
    arrow4: "number[]",
    note: "the check runs once per member, then results are unioned",
    resultLine: "ToArray<string | number> = string[] | number[]",
    moral: "not (string | number)[] — distribution split the union first",
    caption:
      "ToArray distributes over string | number: each member is checked separately and the results are unioned into string[] | number[], not (string | number)[].",
  },
  ru: {
    svgTitle: "Как распределяется ToArray: string | number разбивается на проверки по членам и пересобирается в string[] | number[]",
    headline: "ОДНА ПРОВЕРКА СТАНОВИТСЯ ДВУМЯ",
    sub: "ToArray<T> = T extends unknown ? T[] : never",
    inputHead: "вход-объединение",
    inputSub: "string | number",
    m1Head: "член 1: string",
    m1Sub: "даёт string[]",
    m2Head: "член 2: number",
    m2Sub: "даёт number[]",
    resultHead: "пересборка",
    resultSub: "string[] | number[]",
    arrow1: "член 1",
    arrow2: "член 2",
    arrow3: "string[]",
    arrow4: "number[]",
    note: "проверка выполняется раз на каждый член, затем результаты объединяются",
    resultLine: "ToArray<string | number> = string[] | number[]",
    moral: "не (string | number)[] — дистрибуция сначала разбила объединение",
    caption:
      "ToArray распределяется над string | number: каждый член проверяется отдельно, а результаты объединяются в string[] | number[], а не в (string | number)[].",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsTypelvlDistrib-1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="110" width="160" height="84" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="110" y="140" text-anchor="middle" font-size="13" fill="var(--ink)">{t.inputHead}</text>
    <text x="110" y="162" text-anchor="middle" font-size="12" fill="var(--muted)">{t.inputSub}</text>

    <line x1="190" y1="152" x2="255" y2="125" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsTypelvlDistrib-1)" />
    <text x="212" y="126" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrow1}</text>

    <line x1="190" y1="152" x2="255" y2="205" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsTypelvlDistrib-1)" />
    <text x="212" y="196" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrow2}</text>

    <rect x="260" y="90" width="240" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="380" y="117" text-anchor="middle" font-size="13" fill="var(--ink)">{t.m1Head}</text>
    <text x="380" y="139" text-anchor="middle" font-size="12" fill="var(--muted)">{t.m1Sub}</text>

    <rect x="260" y="180" width="240" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="380" y="207" text-anchor="middle" font-size="13" fill="var(--ink)">{t.m2Head}</text>
    <text x="380" y="229" text-anchor="middle" font-size="12" fill="var(--muted)">{t.m2Sub}</text>

    <line x1="500" y1="125" x2="565" y2="140" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsTypelvlDistrib-1)" />
    <text x="532" y="112" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrow3}</text>

    <line x1="500" y1="215" x2="565" y2="200" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsTypelvlDistrib-1)" />
    <text x="532" y="188" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrow4}</text>

    <rect x="570" y="90" width="200" height="160" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="670" y="160" text-anchor="middle" font-size="13" fill="var(--ink)">{t.resultHead}</text>
    <text x="670" y="185" text-anchor="middle" font-size="12" fill="var(--accent)">{t.resultSub}</text>

    <text x="400" y="285" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>

    <rect x="30" y="300" width="740" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="335" text-anchor="middle" font-size="15" fill="var(--accent)">{t.resultLine}</text>

    <text x="400" y="385" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
