<!-- TsTypelvlRecursion-3 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Depth wall: a non-tail call wraps the self-call in a tuple and walls out around 50 levels, while a TypeScript 4.5 tail call makes the whole branch the self-call and lifts the limit to about 1000",
    headline: "TAIL POSITION MOVES THE WALL",
    sub: "a wrapped call walls at ~50 — a tail call reaches ~1000",
    tag1: "1 · wrapped call — not tail",
    box1line1: "[unknown, ...BuildBad<N, ...>]",
    box1line2: "not tail — frame per level",
    box1line3: "wall ~50 — excessively deep",
    tag2: "2 · tail call — TS 4.5",
    box2line1: "Build<N, [unknown, ...Acc]>",
    box2line2: "tail — whole branch IS the call",
    box2line3: "limit ~1000 — Build<999> ok",
    foot1: "TypeScript 4.5 reuses the frame when nothing wraps the call",
    foot2: "thread an accumulator and return the call directly as the branch result",
    caption:
      "The only structural difference is whether the self-call is wrapped or IS the whole branch — and that one position decides whether the depth wall sits at ~50 or ~1000.",
  },
  ru: {
    svgTitle: "Стена глубины: не-хвостовой вызов оборачивает самовызов в кортеж и упирается около 50 уровней, а хвостовой вызов из TypeScript 4.5 делает самовызовом всю ветку и поднимает лимит примерно до 1000",
    headline: "ХВОСТОВАЯ ПОЗИЦИЯ ДВИГАЕТ СТЕНУ",
    sub: "обёрнутый вызов упирается в ~50 — хвостовой дотягивает до ~1000",
    tag1: "1 · обёрнутый вызов — не хвост",
    box1line1: "[unknown, ...BuildBad<N, ...>]",
    box1line2: "не хвост — кадр на уровень",
    box1line3: "стена ~50 — слишком глубоко",
    tag2: "2 · хвостовой вызов — TS 4.5",
    box2line1: "Build<N, [unknown, ...Acc]>",
    box2line2: "хвост — вся ветка есть рекурсия",
    box2line3: "лимит ~1000 — Build<999> ok",
    foot1: "TypeScript 4.5 переиспользует кадр, когда вызов ничем не обёрнут",
    foot2: "протащите аккумулятор и верните вызов напрямую как результат ветки",
    caption:
      "Единственная структурная разница — обёрнут ли самовызов или он И ЕСТЬ вся ветка — и эта одна позиция решает, стоит ли стена глубины на ~50 или ~1000.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="216" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="46" y="120" width="340" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="216" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line1}</text>
    <text x="216" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line2}</text>
    <text x="216" y="218" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1line3}</text>

    <text x="584" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="414" y="120" width="340" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="584" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line1}</text>
    <text x="584" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line2}</text>
    <text x="584" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box2line3}</text>

    <text x="400" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
