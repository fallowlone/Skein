<!-- TsTypelvlRecursion-2 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Reverse<[1,2,3]> unrolls one element per step: peel Head 1, 2, 3 until Reverse<[]> hits the base case, then spreads collapse to [3, 2, 1]",
    headline: "REVERSE UNROLLS ONE ELEMENT PER STEP",
    sub: "each step splits [Head, ...Tail] until the empty tuple stops the descent",
    tag1: "1 · peel 1",
    box1line1: "Reverse<[1,2,3]>",
    box1line2: "H=1 T=[2,3]",
    box1line3: "[...Reverse<[2,3]>, 1]",
    tag2: "2 · peel 2",
    box2line1: "Reverse<[2,3]>",
    box2line2: "H=2 T=[3]",
    box2line3: "[...Reverse<[3]>, 2, 1]",
    tag3: "3 · peel 3",
    box3line1: "Reverse<[3]>",
    box3line2: "H=3 T=[]",
    box3line3: "[...Reverse<[]>, 3, 2, 1]",
    foot1: "Reverse<[]> hits the base case and returns []",
    foot2: "spreads collapse to the final type [3, 2, 1]",
    caption:
      "The descent shrinks the tuple by one element per step; the empty tuple stops the descent and the spreads collapse to [3, 2, 1].",
  },
  ru: {
    svgTitle: "Reverse<[1,2,3]> разворачивается по элементу за шаг: снять 1, 2, 3, пока Reverse<[]> не попадёт в базовый случай, затем спреды схлопываются в [3, 2, 1]",
    headline: "REVERSE РАЗВОРАЧИВАЕТСЯ ПО ЭЛЕМЕНТУ ЗА ШАГ",
    sub: "каждый шаг отделяет [Head, ...Tail], пока пустой кортеж не остановит спуск",
    tag1: "1 · снять 1",
    box1line1: "Reverse<[1,2,3]>",
    box1line2: "H=1 T=[2,3]",
    box1line3: "[...Reverse<[2,3]>, 1]",
    tag2: "2 · снять 2",
    box2line1: "Reverse<[2,3]>",
    box2line2: "H=2 T=[3]",
    box2line3: "[...Reverse<[3]>, 2, 1]",
    tag3: "3 · снять 3",
    box3line1: "Reverse<[3]>",
    box3line2: "H=3 T=[]",
    box3line3: "[...Reverse<[]>, 3, 2, 1]",
    foot1: "Reverse<[]> попадает в базовый случай и возвращает []",
    foot2: "спреды схлопываются в итоговый тип [3, 2, 1]",
    caption:
      "Спуск укорачивает кортеж на один элемент за шаг; пустой кортеж останавливает спуск, а спреды схлопываются в [3, 2, 1].",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="142" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="32" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="142" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line1}</text>
    <text x="142" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line2}</text>
    <text x="142" y="218" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line3}</text>

    <line x1="258" x2="278" y1="185" y2="185" stroke="var(--muted)" stroke-width="2" />
    <polygon points="278,179 278,191 288,185" fill="var(--muted)" />

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="290" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line1}</text>
    <text x="400" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line2}</text>
    <text x="400" y="218" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line3}</text>

    <line x1="516" x2="536" y1="185" y2="185" stroke="var(--muted)" stroke-width="2" />
    <polygon points="536,179 536,191 546,185" fill="var(--muted)" />

    <text x="658" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="548" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="658" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line1}</text>
    <text x="658" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line2}</text>
    <text x="658" y="218" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line3}</text>

    <text x="400" y="308" text-anchor="middle" font-size="12" fill="var(--accent)">{t.foot1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--accent)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
