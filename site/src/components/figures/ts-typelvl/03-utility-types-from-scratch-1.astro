---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "mapped-type utilities Partial, Required, Readonly, Pick and Record built from one key loop with a modifier",
    headline: "MAPPED FAMILY: ONE LOOP, FIVE UTILITIES",
    sub: "{ [P in keyof T] ...: T[P] } — the modifier syntax is the whole story",
    tagAdd: "1 — add ?",
    boxAddTitle: "Partial<T>",
    boxAddLine: "[P in keyof T]?: T[P]",
    boxAddFoot: "add ? to every key",
    tagStrip: "2 — strip with -?",
    boxStripTitle: "Required<T>",
    boxStripLine: "[P in keyof T]-?: T[P]",
    boxStripFoot: "strip optionality with -?",
    tagChoose: "3 — choose keys",
    boxChooseTitle: "Pick<T,K> · Record<K,V>",
    boxChooseLine1: "[P in K]: T[P]",
    boxChooseLine2: "[P in K]: V",
    boxChooseFoot: "subset — or keys to one value",
    foot1: "? and readonly add a modifier — -? and -readonly strip one",
    foot2: "keyof any is string | number | symbol — the legal key space for Record",
    caption:
      "Partial adds ? to every key, Required strips optionality with -?, Readonly adds readonly; Pick maps a chosen key subset and Record maps every key to one value type.",
  },
  ru: {
    svgTitle: "mapped-утилиты Partial, Required, Readonly, Pick и Record из одного цикла по ключам с модификатором",
    headline: "СЕМЕЙСТВО MAPPED-ТИПОВ: ОДИН ЦИКЛ — ПЯТЬ УТИЛИТ",
    sub: "{ [P in keyof T] ...: T[P] } — синтаксис модификаторов — это вся суть",
    tagAdd: "1 — добавить ?",
    boxAddTitle: "Partial<T>",
    boxAddLine: "[P in keyof T]?: T[P]",
    boxAddFoot: "добавить ? к каждому ключу",
    tagStrip: "2 — снять через -?",
    boxStripTitle: "Required<T>",
    boxStripLine: "[P in keyof T]-?: T[P]",
    boxStripFoot: "-? убирает опциональность",
    tagChoose: "3 — выбрать ключи",
    boxChooseTitle: "Pick<T,K> · Record<K,V>",
    boxChooseLine1: "[P in K]: T[P]",
    boxChooseLine2: "[P in K]: V",
    boxChooseFoot: "подмножество — или всё в одно",
    foot1: "? и readonly добавляют модификатор — -? и -readonly снимают его",
    foot2: "keyof any — это string | number | symbol, легальное пространство ключей для Record",
    caption:
      "Partial добавляет ? к каждому ключу, Required снимает опциональность через -?, Readonly добавляет readonly; Pick отображает выбранное подмножество ключей, а Record — каждый ключ в один тип значения.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsTypelvlUtil-1" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="145" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagAdd}</text>
    <rect x="40" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="145" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxAddTitle}</text>
    <text x="145" y="208" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxAddLine}</text>
    <text x="145" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxAddFoot}</text>

    <line x1="254" y1="221" x2="281" y2="221" stroke="var(--muted)" stroke-width="2" />
    <polygon points="281,214 291,221 281,228" fill="var(--muted)" />

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagStrip}</text>
    <rect x="295" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxStripTitle}</text>
    <text x="400" y="208" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxStripLine}</text>
    <text x="400" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxStripFoot}</text>

    <line x1="509" y1="221" x2="536" y2="221" stroke="var(--muted)" stroke-width="2" />
    <polygon points="536,214 546,221 536,228" fill="var(--muted)" />

    <text x="655" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagChoose}</text>
    <rect x="550" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="655" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxChooseTitle}</text>
    <text x="655" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxChooseLine1}</text>
    <text x="655" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxChooseLine2}</text>
    <text x="655" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxChooseFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
