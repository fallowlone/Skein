<!-- TsTypelvlDistrib-2 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Naked versus wrapped: IsStringNaked over string | number collapses to boolean, wrapped IsString answers false about the whole",
    headline: "SAME INPUT, OPPOSITE ANSWERS",
    sub: "naked T distributes · wrapped [T] checks the whole",
    colL: "naked: T extends string",
    boxL: "IsStringNaked<string | number>",
    arrowL: "distribute",
    resLHead: "boolean",
    resLSub: "true | false — string→true, number→false",
    noteL: "per-member answer, unioned",
    colR: "wrapped: [T] extends [string]",
    boxR: "IsString<string | number>",
    arrowR: "atomic check",
    resRHead: "false",
    resRSub: "union not assignable to string",
    noteR: "one answer about the whole",
    moral: "a whole-type predicate must wrap — or it collapses to boolean",
    caption:
      "IsStringNaked<string | number> distributes into true | false, which is boolean, while wrapped IsString<string | number> checks the union as one whole and answers false.",
  },
  ru: {
    svgTitle: "Голый против обёрнутого: IsStringNaked над string | number схлопывается в boolean, обёрнутый IsString отвечает false про целое",
    headline: "ОДИНАКОВЫЙ ВХОД — ПРОТИВОПОЛОЖНЫЕ ОТВЕТЫ",
    sub: "голый T распределяется · обёрнутый [T] проверяет целиком",
    colL: "голый: T extends string",
    boxL: "IsStringNaked<string | number>",
    arrowL: "распредели",
    resLHead: "boolean",
    resLSub: "true | false — string→true, number→false",
    noteL: "ответ по членам, объединённый",
    colR: "обёрнутый: [T] extends [string]",
    boxR: "IsString<string | number>",
    arrowR: "проверка целиком",
    resRHead: "false",
    resRSub: "объединение не присваивается string",
    noteR: "один ответ про тип целиком",
    moral: "предикат про тип целиком обязан обернуть параметр — иначе схлопнется в boolean",
    caption:
      "IsStringNaked<string | number> распределяется в true | false, то есть boolean, а обёрнутый IsString<string | number> проверяет объединение как единое целое и отвечает false.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsTypelvlDistrib-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.colL}</text>
    <rect x="25" y="115" width="350" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.boxL}</text>

    <line x1="200" y1="190" x2="200" y2="218" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsTypelvlDistrib-2)" />
    <text x="214" y="209" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrowL}</text>

    <rect x="25" y="228" width="350" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="200" y="253" text-anchor="middle" font-size="13" fill="var(--ink)">{t.resLHead}</text>
    <text x="200" y="275" text-anchor="middle" font-size="12" fill="var(--accent)">{t.resLSub}</text>

    <text x="200" y="318" text-anchor="middle" font-size="12" fill="var(--muted)">{t.noteL}</text>

    <text x="600" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.colR}</text>
    <rect x="425" y="115" width="350" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.boxR}</text>

    <line x1="600" y1="190" x2="600" y2="218" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsTypelvlDistrib-2)" />
    <text x="614" y="209" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrowR}</text>

    <rect x="425" y="228" width="350" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="600" y="253" text-anchor="middle" font-size="13" fill="var(--ink)">{t.resRHead}</text>
    <text x="600" y="275" text-anchor="middle" font-size="12" fill="var(--accent)">{t.resRSub}</text>

    <text x="600" y="318" text-anchor="middle" font-size="12" fill="var(--muted)">{t.noteR}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
