<!-- TsRealZod-3 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "schemas compose: discriminatedUnion branches on status, transform splits input from output, refine attaches cross-field rules to a path",
    headline: "COMPOSE, TRANSFORM, REFINE",
    sub: "nest and branch — input can differ from output",
    tagLeft: "branch on status",
    left1: "discriminatedUnion",
    left2: "ok -> data: User",
    left3: "error -> code, message",
    left4: "reads discriminant first",
    tagMid: "reshape",
    mid1: "in: string (z.input)",
    mid2: "out: Date (z.output)",
    mid3: "z.infer === output",
    mid4: "transform(s) => Date",
    tagRight: "business rule",
    right1: "pw === confirm",
    right2: "path: [confirm]",
    right3: "form field error",
    right4: ".refine(...)",
    foot: "union reads discriminant first — faster, clearer errors",
    caption:
      "Compose with discriminatedUnion on status, reshape with transform (z.infer equals output), enforce cross-field rules with refine on a path.",
  },
  ru: {
    svgTitle: "схемы компонуются: discriminatedUnion ветвится по status, transform разделяет вход и выход, refine вешает межполевые правила на path",
    headline: "КОМПОЗИЦИЯ, ТРАНСФОРМ, УТОЧНЕНИЕ",
    sub: "вход может отличаться от выхода",
    tagLeft: "ветвление по status",
    left1: "discriminatedUnion",
    left2: "ok -> data: User",
    left3: "error -> code, message",
    left4: "сначала дискриминант",
    tagMid: "переформирование",
    mid1: "вход: string (z.input)",
    mid2: "выход: Date (z.output)",
    mid3: "z.infer === output",
    mid4: "transform(s) => Date",
    tagRight: "бизнес-правило",
    right1: "pw === confirm",
    right2: "path: [confirm]",
    right3: "ошибка поля формы",
    right4: ".refine(...)",
    foot: "сначала дискриминант — быстрее и яснее",
    caption:
      "Компонуйте через discriminatedUnion по status, переформировывайте transform (z.infer равен output), навязывайте межполевые правила через refine на path.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="147" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="230" height="238" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="147" y="172" text-anchor="middle" font-size="11" fill="var(--ink)">{t.left1}</text>
    <text x="147" y="202" text-anchor="middle" font-size="11" fill="var(--ink)">{t.left2}</text>
    <text x="147" y="232" text-anchor="middle" font-size="11" fill="var(--ink)">{t.left3}</text>
    <text x="147" y="262" text-anchor="middle" font-size="11" fill="var(--muted)">{t.left4}</text>

    <text x="397" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagMid}</text>
    <rect x="282" y="116" width="230" height="238" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="397" y="172" text-anchor="middle" font-size="11" fill="var(--ink)">{t.mid1}</text>
    <text x="397" y="202" text-anchor="middle" font-size="11" fill="var(--ink)">{t.mid2}</text>
    <text x="397" y="232" text-anchor="middle" font-size="11" fill="var(--accent)">{t.mid3}</text>
    <text x="397" y="262" text-anchor="middle" font-size="11" fill="var(--muted)">{t.mid4}</text>

    <text x="650" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="532" y="116" width="236" height="238" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="650" y="172" text-anchor="middle" font-size="11" fill="var(--ink)">{t.right1}</text>
    <text x="650" y="202" text-anchor="middle" font-size="11" fill="var(--ink)">{t.right2}</text>
    <text x="650" y="232" text-anchor="middle" font-size="11" fill="var(--ink)">{t.right3}</text>
    <text x="650" y="262" text-anchor="middle" font-size="11" fill="var(--muted)">{t.right4}</text>

    <text x="400" y="406" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
