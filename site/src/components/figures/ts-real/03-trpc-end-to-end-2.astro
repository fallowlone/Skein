---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "No codegen tradeoff: tRPC shares the server type with zero generated files, while OpenAPI and GraphQL generate a language-agnostic client file",
    headline: "NO CODEGEN: THE TYPE IS THE CONTRACT",
    sub: "tRPC shares a TS type; codegen ships a wire contract file",
    tagLeft: "tRPC — no codegen",
    tagRight: "OpenAPI / GraphQL codegen",
    l1: "import type { AppRouter }",
    l2: "shared TS build / monorepo",
    l3: "TypeScript both ends",
    l4: "zero generated files",
    l5: "live per-keystroke inference",
    r1: "client.ts from spec / schema",
    r2: "language-agnostic file",
    r3: "Swift / Kotlin clients OK",
    r4: "third-party consumers OK",
    r5: "cost: a build step",
    vs: "vs",
    foot: "a type crosses only a compile boundary — never network or language",
    foot2: "no wire format in tRPC; that is when codegen pays off",
    caption:
      "tRPC buys live inference by sharing the server type with zero files; codegen buys a language-agnostic wire contract — a generated file any client can read — at the cost of a build step.",
  },
  ru: {
    svgTitle: "Размен без кодогена: tRPC разделяет тип сервера без сгенерированных файлов, а OpenAPI и GraphQL генерируют языконезависимый файл клиента",
    headline: "БЕЗ КОДОГЕНА: КОНТРАКТ — ЭТО ТИП",
    sub: "tRPC делит TS-тип; кодоген поставляет файл контракта",
    tagLeft: "tRPC — без кодогена",
    tagRight: "кодоген OpenAPI / GraphQL",
    l1: "import type { AppRouter }",
    l2: "общая TS-сборка / монорепо",
    l3: "TypeScript с двух сторон",
    l4: "ноль сгенерированных файлов",
    l5: "живой вывод на каждое нажатие",
    r1: "client.ts из спеки / схемы",
    r2: "языконезависимый файл",
    r3: "Swift / Kotlin — можно",
    r4: "сторонние клиенты — можно",
    r5: "цена: шаг сборки",
    vs: "vs",
    foot: "тип пересекает лишь границу компиляции — не сеть и не язык",
    foot2: "у tRPC нет формата провода — тут кодоген окупается",
    caption:
      "tRPC покупает живой вывод, разделяя тип сервера без файлов; кодоген покупает языконезависимый контракт провода — сгенерированный файл, читаемый любым клиентом, — ценой шага сборки.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <text x="600" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>

    <rect x="20" y="116" width="360" height="220" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.l1}</text>
    <text x="200" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.l2}</text>
    <text x="200" y="208" text-anchor="middle" font-size="12" fill="var(--ink)">{t.l3}</text>
    <text x="200" y="236" text-anchor="middle" font-size="12" fill="var(--ink)">{t.l4}</text>
    <text x="200" y="264" text-anchor="middle" font-size="12" fill="var(--accent)">{t.l5}</text>
    <text x="200" y="308" text-anchor="middle" font-size="11" fill="var(--muted)">AppRouter</text>

    <text x="400" y="232" text-anchor="middle" font-size="14" fill="var(--muted)">{t.vs}</text>

    <rect x="420" y="116" width="360" height="220" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r1}</text>
    <text x="600" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r2}</text>
    <text x="600" y="208" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r3}</text>
    <text x="600" y="236" text-anchor="middle" font-size="12" fill="var(--ink)">{t.r4}</text>
    <text x="600" y="264" text-anchor="middle" font-size="12" fill="var(--accent)">{t.r5}</text>
    <text x="600" y="308" text-anchor="middle" font-size="11" fill="var(--muted)">client.ts</text>

    <text x="400" y="366" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
