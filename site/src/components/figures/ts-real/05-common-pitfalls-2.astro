<!-- TsRealPitfalls-2 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "array covariance unsoundness: Dog[] widens to Animal[], push smuggles in a Cat, and bark crashes — readonly arrays restore soundness",
    headline: "COVARIANCE + PUSH = A CAT IN YOUR DOGS",
    sub: "Dog[] is assignable to Animal[] — unsound under mutation",
    tag1: "start",
    box1a: "const dogs: Dog[]",
    box1b: "= [new Dog()]",
    tag2: "widen",
    box2a: "animals: Animal[]",
    box2b: "= dogs — allowed",
    tag3: "mutate",
    box3a: "push(new Cat())",
    box3b: "compiles — ok",
    tag4: "crash",
    box4a: "dogs[1].bark()",
    box4b: "runtime crash",
    fix1: "fix: take readonly Animal[] when you only read",
    fix2: "no push — a caller can't smuggle a Cat into Dog[]",
    foot: "every line compiled — yet dogs now holds a Cat",
    caption:
      "Array covariance lets Dog[] widen to Animal[], so push(new Cat()) compiles and corrupts dogs — accept readonly T[] in read-only APIs.",
  },
  ru: {
    svgTitle: "несостоятельность ковариантности массивов: Dog[] расширяется до Animal[], push протаскивает Cat, и bark падает — readonly-массивы возвращают состоятельность",
    headline: "КОВАРИАНТНОСТЬ ЛОМАЕТСЯ ПРИ PUSH",
    sub: "Dog[] присваивается Animal[] — несостоятельно при мутации",
    tag1: "старт",
    box1a: "const dogs: Dog[]",
    box1b: "= [new Dog()]",
    tag2: "расширение",
    box2a: "animals: Animal[]",
    box2b: "= dogs — разрешено",
    tag3: "мутация",
    box3a: "push(new Cat())",
    box3b: "компилируется",
    tag4: "падение",
    box4a: "dogs[1].bark()",
    box4b: "падение в рантайме",
    fix1: "фикс: принимайте readonly Animal[], когда читаете",
    fix2: "нет push — Cat не попадёт в чужой Dog[]",
    foot: "каждая строка скомпилировалась — а в dogs теперь Cat",
    caption:
      "Ковариантность расширяет Dog[] до Animal[], так что push(new Cat()) компилируется и портит dogs — принимайте readonly T[] в read-only-API.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="100" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <text x="300" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <text x="500" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <text x="700" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag4}</text>

    <rect x="20" y="138" width="160" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="100" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1a}</text>
    <text x="100" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1b}</text>

    <rect x="220" y="138" width="160" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="300" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2a}</text>
    <text x="300" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2b}</text>

    <rect x="420" y="138" width="160" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="500" y="180" text-anchor="middle" font-size="11" fill="var(--accent)">{t.box3a}</text>
    <text x="500" y="206" text-anchor="middle" font-size="11" fill="var(--accent)">{t.box3b}</text>

    <rect x="620" y="138" width="160" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="700" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box4a}</text>
    <text x="700" y="206" text-anchor="middle" font-size="11" fill="var(--accent)">{t.box4b}</text>

    <line x1="180" y1="193" x2="212" y2="193" stroke="var(--muted)" stroke-width="2" />
    <polygon points="212,187 222,193 212,199" fill="var(--muted)" />
    <line x1="380" y1="193" x2="412" y2="193" stroke="var(--muted)" stroke-width="2" />
    <polygon points="412,187 422,193 412,199" fill="var(--muted)" />
    <line x1="580" y1="193" x2="612" y2="193" stroke="var(--muted)" stroke-width="2" />
    <polygon points="612,187 622,193 612,199" fill="var(--muted)" />

    <rect x="20" y="280" width="760" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="306" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fix1}</text>
    <text x="400" y="331" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fix2}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
