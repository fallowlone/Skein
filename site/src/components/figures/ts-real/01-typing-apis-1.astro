---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "the network boundary: a cast trusts the bytes blindly, only validation earns the type",
    headline: "THE NETWORK BOUNDARY: CAST TRUSTS, CHECKS PROVE",
    sub: "res.json() is any — as User checks nothing, validation earns the type",
    tagLeft: "typed call",
    left1: "GET /api/user/42",
    left2: "client: expects User",
    left3: "checker proves code",
    left4: "left of boundary",
    tagMid: "the wire",
    mid1: "200 JSON bytes",
    mid2: "untrusted bytes",
    mid3: "honest any",
    mid4: "checker never saw",
    tagRight: "the fork",
    cast1: "as User: no check",
    cast2: "fast, free",
    cast3: "unsound — a lie",
    cast4: "null sails through",
    valid1: "validate to User",
    valid2: "inspects bytes",
    valid3: "checked proof",
    valid4: "error branch kept",
    foot: "a cast pretends the line is not there — only validation earns the type",
    caption:
      "The network boundary ends compile-time guarantees: res.json() is any, a cast trusts the bytes blindly, and only validation earns the User type.",
  },
  ru: {
    svgTitle: "сетевая граница: каст слепо доверяет байтам, только проверка даёт тип",
    headline: "СЕТЕВАЯ ГРАНИЦА: КАСТ ДОВЕРЯЕТ, ПРОВЕРКА ДОКАЗЫВАЕТ",
    sub: "res.json() — это any: as User не проверяет, валидация даёт тип",
    tagLeft: "вызов",
    left1: "GET /api/user/42",
    left2: "клиент: ждёт User",
    left3: "проверка кода",
    left4: "слева от границы",
    tagMid: "провод",
    mid1: "200 JSON bytes",
    mid2: "байты без доверия",
    mid3: "честный any",
    mid4: "проверщик не видел",
    tagRight: "развилка",
    cast1: "as User: без проверки",
    cast2: "быстро, бесплатно",
    cast3: "ложь, не проверка",
    cast4: "null проходит",
    valid1: "валидация в User",
    valid2: "осмотр байтов",
    valid3: "тип доказан",
    valid4: "ошибка обработана",
    foot: "каст делает вид, что линии нет, — только проверка даёт тип",
    caption:
      "Сетевая граница кончает гарантии компиляции: res.json() — это any, каст слепо доверяет байтам, и только проверка даёт тип User.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="137" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="210" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="137" y="166" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="137" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="137" y="218" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left3}</text>
    <text x="137" y="244" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left4}</text>

    <text x="370" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagMid}</text>
    <rect x="270" y="116" width="200" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="370" y="166" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mid1}</text>
    <text x="370" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mid2}</text>
    <text x="370" y="218" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mid3}</text>
    <text x="370" y="244" text-anchor="middle" font-size="12" fill="var(--accent)">{t.mid4}</text>

    <text x="633" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="498" y="116" width="270" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="633" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cast1}</text>
    <text x="633" y="176" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cast2}</text>
    <text x="633" y="202" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cast3}</text>
    <text x="633" y="228" text-anchor="middle" font-size="12" fill="var(--accent)">{t.cast4}</text>

    <rect x="498" y="258" width="270" height="122" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="633" y="290" text-anchor="middle" font-size="12" fill="var(--ink)">{t.valid1}</text>
    <text x="633" y="314" text-anchor="middle" font-size="12" fill="var(--ink)">{t.valid2}</text>
    <text x="633" y="338" text-anchor="middle" font-size="12" fill="var(--ink)">{t.valid3}</text>
    <text x="633" y="362" text-anchor="middle" font-size="12" fill="var(--accent)">{t.valid4}</text>

    <line x1="242" y1="216" x2="266" y2="216" stroke="var(--muted)" stroke-width="2" />
    <polygon points="266,216 256,210 256,222" fill="var(--muted)" />
    <line x1="470" y1="181" x2="494" y2="181" stroke="var(--muted)" stroke-width="2" />
    <polygon points="494,181 484,175 484,187" fill="var(--muted)" />
    <line x1="470" y1="319" x2="494" y2="319" stroke="var(--accent)" stroke-width="2" />
    <polygon points="494,319 484,313 484,325" fill="var(--accent)" />

    <text x="400" y="406" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
