---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "builders accumulate types along the chain: each select returns a new Query with a wider Cols union, so build reports exactly the selected columns",
    headline: "EACH CHAIN LINK RETURNS A WIDER TYPE",
    sub: "select returns Query<Cols | C> — the type grows along the chain",
    tag1: "start",
    box1a: "new Query()",
    box1b: "Cols = never",
    tag2: "first link",
    box2a: '.select("id")',
    box2b: 'Cols = "id"',
    tag3: "second link",
    box3a: '.select("name")',
    box3b: 'Cols += "name"',
    tag4: "report",
    box4a: ".build()",
    box4b: '^? ("id" | "name")[]',
    foot1: "each .select widens the accumulated Cols union",
    foot2: "how zod, query builders, and the tRPC router grow their type",
    caption:
      "Builders accumulate types by returning a new generic instance per chained call, so build() reports exactly the columns selected.",
  },
  ru: {
    svgTitle: "builder накапливает типы вдоль цепочки: каждый select возвращает новый Query с более широким объединением Cols, и build сообщает ровно выбранные колонки",
    headline: "КАЖДОЕ ЗВЕНО ВОЗВРАЩАЕТ БОЛЕЕ ШИРОКИЙ ТИП",
    sub: "select возвращает Query<Cols | C> — тип растёт вдоль цепочки",
    tag1: "старт",
    box1a: "new Query()",
    box1b: "Cols = never",
    tag2: "первое звено",
    box2a: '.select("id")',
    box2b: 'Cols = "id"',
    tag3: "второе звено",
    box3a: '.select("name")',
    box3b: 'Cols += "name"',
    tag4: "итог",
    box4a: ".build()",
    box4b: '^? ("id" | "name")[]',
    foot1: "каждый .select расширяет накопленное объединение Cols",
    foot2: "так zod, query builder и роутер tRPC растят свой тип",
    caption:
      "Builder накапливает типы, возвращая новый generic-экземпляр на каждый звено-вызов, так что build() сообщает ровно выбранные колонки.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="105" y="110" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="30" y="130" width="150" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="105" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1a}</text>
    <text x="105" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1b}</text>

    <line x1="188" y1="215" x2="212" y2="215" stroke="var(--accent)" stroke-width="2" />
    <polygon points="212,207 226,215 212,223" fill="var(--accent)" />

    <text x="300" y="110" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="225" y="130" width="150" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="300" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2a}</text>
    <text x="300" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2b}</text>

    <line x1="383" y1="215" x2="407" y2="215" stroke="var(--accent)" stroke-width="2" />
    <polygon points="407,207 421,215 407,223" fill="var(--accent)" />

    <text x="495" y="110" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="420" y="130" width="150" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="495" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3a}</text>
    <text x="495" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3b}</text>

    <line x1="578" y1="215" x2="602" y2="215" stroke="var(--accent)" stroke-width="2" />
    <polygon points="602,207 616,215 602,223" fill="var(--accent)" />

    <text x="690" y="110" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag4}</text>
    <rect x="615" y="130" width="150" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="690" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box4a}</text>
    <text x="690" y="222" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box4b}</text>

    <text x="400" y="340" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
