<!-- TsRealLibraryGenerics-1 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "library generics goal: the caller writes values and the compiler writes types — get infers T and K with no type arguments while getBad forces them",
    headline: "WRITE VALUES, GET TYPES — NO TYPE ARGS",
    sub: "inference sites bind T and K; return T[K] precise, never the constraint",
    tagLeft: "bad — restate types",
    left1: "getBad<T, K>(obj, key)",
    left2: 'caller writes <{a:number}, "a">',
    left3: "ugh — desync risk",
    gapTop: "inference sites",
    gapBottom: "obj: T, key: K",
    tagRight: "good — infer both",
    right1: "get<T, K>(obj, key)",
    right2: 'get({a:1, b:"x"}, "b")',
    right3: "^? string — inferred",
    foot1: "return the inferred T[K], never the constraint",
    foot2: "every <T> the caller writes is a missing inference site",
    caption:
      "A well-designed generic API infers every type parameter from the caller's values; a bad one forces type arguments to be restated.",
  },
  ru: {
    svgTitle: "цель generic-API: вызывающий пишет значения, компилятор пишет типы — get выводит T и K без аргументов типа, а getBad заставляет их писать",
    headline: "ПИШИ ЗНАЧЕНИЯ — ПОЛУЧАЙ ТИПЫ БЕЗ АРГУМЕНТОВ",
    sub: "места вывода связывают T и K; вернуть точный T[K], а не ограничение",
    tagLeft: "плохо — повтор типов",
    left1: "getBad<T, K>(obj, key)",
    left2: 'вызов пишет <{a:number}, "a">',
    left3: "фу — риск рассинхрона",
    gapTop: "места вывода",
    gapBottom: "obj: T, key: K",
    tagRight: "хорошо — вывод обоих",
    right1: "get<T, K>(obj, key)",
    right2: 'get({a:1, b:"x"}, "b")',
    right3: "^? string — выведен",
    foot1: "возвращайте выведенный T[K], никогда ограничение",
    foot2: "каждый <T> от вызывающего — пропущенное место вывода",
    caption:
      "Хороший generic-API выводит каждый параметр типа из значений вызывающего; плохой заставляет повторять аргументы типа.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="182" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="300" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="182" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="182" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="182" y="219" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left3}</text>

    <text x="400" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapTop}</text>
    <line x1="352" y1="216" x2="436" y2="216" stroke="var(--accent)" stroke-width="2" />
    <polygon points="436,206 458,216 436,226" fill="var(--accent)" />
    <text x="400" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapBottom}</text>

    <text x="618" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="468" y="116" width="300" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="618" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="618" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="618" y="219" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right3}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
