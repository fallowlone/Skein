---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "NoInfer blocks an unwanted inference site: without it pick widens C to a union and accepts the bug, with NoInfer choices alone pins C and the typo errors",
    headline: "NOINFER TURNS SILENT WIDENING INTO AN ERROR",
    sub: "TS 5.4: NoInfer<C> removes a site — fallback is checked, not widening",
    tagLeft: "without NoInfer",
    left1: "pick<C>(choices: C[], fallback: C)",
    left2: 'pick(["a", "b"], "c")',
    left3: 'C widens — bug "c" accepted',
    gapTop: "two sites widen",
    gapBottom: "one site pins",
    tagRight: "with NoInfer<C>",
    right1: "pickSafe: fallback: NoInfer<C>",
    right2: 'pickSafe(["a", "b"], "c")',
    right3: 'Error: "c" not assignable',
    foot1: "choices alone pins C; fallback is checked against it",
    foot2: "use NoInfer where a param must conform, not drive inference",
    caption:
      "NoInfer<C> removes an inference site so choices alone fixes C and the mismatched fallback becomes a real error instead of a silent widening.",
  },
  ru: {
    svgTitle: "NoInfer блокирует лишнее место вывода: без него pick расширяет C до объединения и принимает баг, с NoInfer один choices фиксирует C, а опечатка — ошибка",
    headline: "NOINFER ПРЕВРАЩАЕТ ТИХОЕ РАСШИРЕНИЕ В ОШИБКУ",
    sub: "TS 5.4: NoInfer<C> убирает место — fallback проверяется, а не расширяет",
    tagLeft: "без NoInfer",
    left1: "pick<C>(choices: C[], fallback: C)",
    left2: 'pick(["a", "b"], "c")',
    left3: "C расширен — баг принят",
    gapTop: "два места расширяют",
    gapBottom: "одно место фиксирует",
    tagRight: "с NoInfer<C>",
    right1: "pickSafe: fallback: NoInfer<C>",
    right2: 'pickSafe(["a", "b"], "c")',
    right3: "ошибка: «c» не подходит",
    foot1: "один choices фиксирует C; fallback проверяется против него",
    foot2: "NoInfer — где параметр обязан совпасть, а не выводить",
    caption:
      "NoInfer<C> убирает место вывода: один choices фиксирует C, а несовпавший fallback становится ошибкой вместо тихого расширения.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="182" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="300" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="182" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="182" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="182" y="219" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left3}</text>

    <text x="400" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapTop}</text>
    <line x1="352" y1="216" x2="436" y2="216" stroke="var(--accent)" stroke-width="2" />
    <polygon points="436,206 458,216 436,226" fill="var(--accent)" />
    <text x="400" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapBottom}</text>

    <text x="618" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="468" y="116" width="300" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="618" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="618" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="618" y="219" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right3}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
