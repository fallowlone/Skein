<!-- TypingApis-3 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "four rungs from bare cast to runtime proof: drift closes before trust closes, only zod proves",
    headline: "EACH RUNG LESS OF A LIE — ONLY THE TOP RUNG PROVES",
    sub: "from bare cast to runtime proof: drift closes before trust closes",
    tagTech: "technique",
    tagGap: "gap it closes",
    step4: "4",
    tech4: "zod .parse inspects bytes",
    gap4: "trust gap: closed — proof",
    step3: "3",
    tech3: "OpenAPI codegen ties type to spec",
    gap3: "drift gap: closed",
    step2: "2",
    tech2: "union / Result: honest control flow",
    gap2: "payload still cast",
    step1: "1",
    tech1: "bare as User cast",
    gap1: "checks nothing",
    foot: "codegen narrows drift, validation closes trust — the promise becomes a proof",
    caption:
      "Each rung makes the fetch annotation less of a lie — but only the runtime check at the top turns the promise into a proof.",
  },
  ru: {
    svgTitle: "четыре ступени от голого каста к проверке: сначала закрываем расхождение, доказывает только zod",
    headline: "КАЖДАЯ СТУПЕНЬ МЕНЬШЕ ЛЖЁТ — ДОКАЗЫВАЕТ ВЕРХНЯЯ",
    sub: "от голого каста к проверке: сначала закрываем расхождение",
    tagTech: "приём",
    tagGap: "что закрывает",
    step4: "4",
    tech4: "zod .parse смотрит байты",
    gap4: "доверие: закрыто",
    step3: "3",
    tech3: "кодогенерация OpenAPI",
    gap3: "расхождение: закрыто",
    step2: "2",
    tech2: "объединение / Result",
    gap2: "нагрузка всё ещё каст",
    step1: "1",
    tech1: "голый каст as User",
    gap1: "не проверяет ничего",
    foot: "кодогенерация сужает расхождение, проверка закрывает доверие",
    caption:
      "Каждая ступень делает аннотацию fetch меньшей ложью — но только рантайм-проверка наверху превращает обещание в доказательство.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="220" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagTech}</text>
    <text x="600" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagGap}</text>

    <rect x="40" y="104" width="720" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="64" y="136" text-anchor="middle" font-size="12" fill="var(--accent)">{t.step4}</text>
    <text x="88" y="136" font-size="12" fill="var(--ink)">{t.tech4}</text>
    <text x="736" y="136" text-anchor="end" font-size="11" fill="var(--accent)">{t.gap4}</text>

    <rect x="40" y="168" width="720" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="64" y="200" text-anchor="middle" font-size="12" fill="var(--muted)">{t.step3}</text>
    <text x="88" y="200" font-size="12" fill="var(--ink)">{t.tech3}</text>
    <text x="736" y="200" text-anchor="end" font-size="11" fill="var(--muted)">{t.gap3}</text>

    <rect x="40" y="232" width="720" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="64" y="264" text-anchor="middle" font-size="12" fill="var(--muted)">{t.step2}</text>
    <text x="88" y="264" font-size="12" fill="var(--ink)">{t.tech2}</text>
    <text x="736" y="264" text-anchor="end" font-size="11" fill="var(--muted)">{t.gap2}</text>

    <rect x="40" y="296" width="720" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="64" y="328" text-anchor="middle" font-size="12" fill="var(--muted)">{t.step1}</text>
    <text x="88" y="328" font-size="12" fill="var(--ink)">{t.tech1}</text>
    <text x="736" y="328" text-anchor="end" font-size="11" fill="var(--muted)">{t.gap1}</text>

    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
