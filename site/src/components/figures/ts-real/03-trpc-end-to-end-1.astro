---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "tRPC inference path: typeof appRouter lifts the server router value into the AppRouter type, which createTRPCClient turns into the typed client",
    headline: "TYPEOF LIFTS THE ROUTER VALUE INTO A TYPE",
    sub: "client API type is inferred from the router type — no files",
    tagServer: "server",
    tagLift: "the lift",
    tagType: "the type",
    tagClient: "the client",
    s1a: "appRouter",
    s1b: "router value",
    s1c: "zod + resolver",
    s2a: "typeof appRouter",
    s2b: "value to type",
    s2c: "type operator",
    s3a: "AppRouter",
    s3b: "whole router",
    s3c: "type",
    s4a: "createTRPCClient",
    s4b: "<AppRouter>",
    s4c: "client interface",
    midLeft: "input from z.infer schema",
    midRight: "output from resolver return",
    foot: "no file generated: tsc recomputes on every keystroke",
    foot2: "renaming getUser breaks the client immediately",
    caption:
      "typeof appRouter lifts the server router value into the AppRouter type; createTRPCClient turns it into the client interface, inferring each input from z.infer and each output from the resolver.",
  },
  ru: {
    svgTitle: "Путь вывода tRPC: typeof appRouter поднимает значение роутера сервера в тип AppRouter, из которого createTRPCClient строит типизированный клиент",
    headline: "TYPEOF ПОДНИМАЕТ РОУТЕР В ТИП",
    sub: "тип API клиента — вывод из типа роутера, без файлов",
    tagServer: "сервер",
    tagLift: "подъём",
    tagType: "тип",
    tagClient: "клиент",
    s1a: "appRouter",
    s1b: "значение",
    s1c: "zod + резолвер",
    s2a: "typeof appRouter",
    s2b: "значение в тип",
    s2c: "оператор типа",
    s3a: "AppRouter",
    s3b: "весь тип",
    s3c: "роутера",
    s4a: "createTRPCClient",
    s4b: "<AppRouter>",
    s4c: "интерфейс клиента",
    midLeft: "вход из z.infer схемы",
    midRight: "выход из возврата резолвера",
    foot: "файл не генерируется: пересчёт tsc на каждое нажатие",
    foot2: "переименование getUser ломает клиент сразу",
    caption:
      "typeof appRouter поднимает значение роутера сервера в тип AppRouter; createTRPCClient превращает его в интерфейс клиента, выводя каждый вход из z.infer, а выход — из резолвера.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="102" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagServer}</text>
    <text x="280" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLift}</text>
    <text x="445" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagType}</text>
    <text x="662" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagClient}</text>

    <rect x="20" y="116" width="165" height="120" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="102" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s1a}</text>
    <text x="102" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s1b}</text>
    <text x="102" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.s1c}</text>

    <line x1="188" y1="176" x2="205" y2="176" stroke="var(--muted)" stroke-width="2" />
    <polygon points="205,170 213,176 205,182" fill="var(--muted)" />

    <rect x="215" y="116" width="130" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="280" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s2a}</text>
    <text x="280" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s2b}</text>
    <text x="280" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.s2c}</text>

    <line x1="348" y1="176" x2="365" y2="176" stroke="var(--muted)" stroke-width="2" />
    <polygon points="365,170 373,176 365,182" fill="var(--muted)" />

    <rect x="375" y="116" width="140" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="445" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s3a}</text>
    <text x="445" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s3b}</text>
    <text x="445" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.s3c}</text>

    <line x1="518" y1="176" x2="535" y2="176" stroke="var(--muted)" stroke-width="2" />
    <polygon points="535,170 543,176 535,182" fill="var(--muted)" />

    <rect x="545" y="116" width="235" height="120" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="662" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s4a}</text>
    <text x="662" y="178" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s4b}</text>
    <text x="662" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.s4c}</text>

    <rect x="20" y="260" width="760" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="250" y="287" text-anchor="middle" font-size="12" fill="var(--ink)">{t.midLeft}</text>
    <text x="560" y="287" text-anchor="middle" font-size="12" fill="var(--ink)">{t.midRight}</text>
    <text x="405" y="310" text-anchor="middle" font-size="11" fill="var(--accent)">trpc.getUserById.query(input): Promise&lt;output&gt;</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--accent)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
