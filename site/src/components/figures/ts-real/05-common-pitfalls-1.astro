<!-- TsRealPitfalls-1 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "branding defeats structural ID collision: plain string aliases collide, intersecting with a phantom __brand makes a mix-up a compile error",
    headline: "SAME SHAPE, WRONG ID — BRAND TO DISCRIMINATE",
    sub: "type UserId = string and type OrderId = string are the same type",
    tagLeft: "no brand — collides",
    left1: "type UserId = string",
    left2: "type OrderId = string",
    left3: "getUser(order) compiles",
    left4: "same shape — no error",
    mid: "brand it",
    tagRight: "branded — discriminated",
    right1: 'string & { __brand: "UserId" }',
    right2: "getUser(order) — Error",
    right3: "getUser(user) — ok",
    right4: "runtime: still string",
    fix1: 'fix: type UserId = string & { readonly __brand: "UserId" }',
    fix2: "phantom property — type only, never at runtime",
    foot: "both are string at runtime — the brand lives in the type only",
    caption:
      "Structural typing treats UserId and OrderId as the same type — branding with & { __brand } makes a mixed-up ID a compile error.",
  },
  ru: {
    svgTitle: "брендинг побеждает структурное столкновение ID: plain-алиасы string сталкиваются, а пересечение с фантомным __brand делает подмену ошибкой компиляции",
    headline: "ОДНА ФОРМА — НЕ ТОТ ID",
    sub: "UserId и OrderId — оба string: один и тот же тип",
    tagLeft: "без бренда — коллизия",
    left1: "type UserId = string",
    left2: "type OrderId = string",
    left3: "getUser(order) — компилируется",
    left4: "одна форма — нет ошибки",
    mid: "бренд",
    tagRight: "с брендом — различаются",
    right1: 'string & { __brand: "UserId" }',
    right2: "getUser(order) — ошибка",
    right3: "getUser(user) — ok",
    right4: "в рантайме — просто string",
    fix1: 'fix: type UserId = string & { readonly __brand: "UserId" }',
    fix2: "фантомное свойство — только в типе",
    foot: "оба — string в рантайме, бренд живёт только в типе",
    caption:
      "Структурная типизация считает UserId и OrderId одним типом — бренд через & { __brand } делает подмену ID ошибкой компиляции.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="190" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="40" y="116" width="300" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="190" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="190" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="190" y="212" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left3}</text>
    <text x="190" y="240" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left4}</text>

    <text x="400" y="168" text-anchor="middle" font-size="11" fill="var(--muted)">{t.mid}</text>
    <line x1="348" y1="192" x2="436" y2="192" stroke="var(--muted)" stroke-width="2" />
    <polygon points="436,184 452,192 436,200" fill="var(--muted)" />

    <text x="610" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="460" y="116" width="300" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="610" y="180" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right2}</text>
    <text x="610" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right3}</text>
    <text x="610" y="240" text-anchor="middle" font-size="12" fill="var(--muted)">{t.right4}</text>

    <rect x="40" y="292" width="720" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="318" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fix1}</text>
    <text x="400" y="343" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fix2}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
