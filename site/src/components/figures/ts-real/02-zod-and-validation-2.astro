<!-- TsRealZod-2 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: ".parse returns the value or throws ZodError at fail-loud boundaries; .safeParse returns a success union you narrow on result.success",
    headline: "PARSE THROWS — SAFEPARSE RETURNS A UNION",
    sub: "same runtime check, opposite failure behavior",
    tagLeft: "fail loud",
    left1: ".parse(json)",
    left2: "value: User",
    left3: "or throws ZodError",
    left4: "server DB read",
    tagRight: "expected outcome",
    right1: ".safeParse(json)",
    right2: "narrow: result.success",
    right3: "data | error",
    right4: "form input, webhook",
    foot: ".parse for bugs — .safeParse where bad input renders",
    caption:
      "Same check, opposite failures: .parse throws so a bug fails loud; .safeParse hands back a result you narrow and render.",
  },
  ru: {
    svgTitle: ".parse возвращает значение или бросает ZodError на границах громкого падения; .safeParse возвращает объединение, сужаемое по result.success",
    headline: "PARSE БРОСАЕТ — SAFEPARSE ОТДАЁТ ОБЪЕДИНЕНИЕ",
    sub: "та же проверка, разный отказ",
    tagLeft: "громкое падение",
    left1: ".parse(json)",
    left2: "значение: User",
    left3: "или бросает ZodError",
    left4: "чтение из БД",
    tagRight: "ожидаемый исход",
    right1: ".safeParse(json)",
    right2: "сузить: result.success",
    right3: "data | error",
    right4: "форма, webhook",
    foot: "parse — для багов, safeParse — для ввода",
    caption:
      "Та же проверка, разный отказ: .parse бросает, чтобы баг упал громко; .safeParse отдаёт результат, который сужают и рендерят.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="202" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="340" height="238" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="202" y="172" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="202" y="202" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="202" y="232" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left3}</text>
    <text x="202" y="262" text-anchor="middle" font-size="11" fill="var(--muted)">{t.left4}</text>
    <line x1="62" y1="296" x2="342" y2="296" stroke="var(--muted)" stroke-width="1" />
    <text x="202" y="322" text-anchor="middle" font-size="11" fill="var(--muted)">success: true; data</text>

    <text x="598" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="428" y="116" width="340" height="238" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="598" y="172" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="598" y="202" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="598" y="232" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right3}</text>
    <text x="598" y="262" text-anchor="middle" font-size="11" fill="var(--muted)">{t.right4}</text>
    <line x1="458" y1="296" x2="738" y2="296" stroke="var(--muted)" stroke-width="1" />
    <text x="598" y="322" text-anchor="middle" font-size="11" fill="var(--muted)">success: false; error</text>

    <text x="400" y="406" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
