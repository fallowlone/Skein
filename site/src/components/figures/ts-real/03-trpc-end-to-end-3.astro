<!-- TrpcEndToEnd-3 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The price of no codegen: a giant router slows tsc and the editor, mitigated by splitting and annotating, plus the import-type footgun",
    headline: "THE PRICE: INFERENCE TIME — PLUS ONE FOOTGUN",
    sub: "a giant router slows tsc; a value import leaks the server",
    tagCost: "the cost",
    tagFix: "mitigations",
    c1: "whole router type",
    c2: "re-inferred each keystroke",
    c3: "hovers spin, tsc crawls",
    c4: "500 procedures = crawl",
    m1: "split into sub-routers",
    m2: "annotate resolver returns",
    m3: "keep schemas modest",
    m4: "codegen when it stops scaling",
    goodCode: "import type { AppRouter }",
    goodNote: "safe: type only",
    badCode: "import { appRouter }",
    badNote: "leak: DB, secrets to browser",
    foot: "verbatimModuleSyntax turns a stray value import into an error",
    caption:
      "No codegen is paid in inference time — split routers, annotate returns, keep schemas modest, switch to codegen at scale — and in discipline: import the router as a type, never a value.",
  },
  ru: {
    svgTitle: "Цена без кодогена: гигантский роутер тормозит tsc и редактор — лечится разбиением и аннотациями — плюс самострел импорта значением",
    headline: "ЦЕНА: ВРЕМЯ ВЫВОДА — ПЛЮС ОДИН САМОСТРЕЛ",
    sub: "гигантский роутер тормозит tsc; импорт значения течёт в бандл",
    tagCost: "цена",
    tagFix: "смягчения",
    c1: "весь тип роутера",
    c2: "перевывод на каждое нажатие",
    c3: "подсказки крутятся, tsc ползёт",
    c4: "500 процедур — всё ползёт",
    m1: "бить на саброутеры",
    m2: "аннотировать возвраты",
    m3: "скромные схемы",
    m4: "кодоген, когда вывод встал",
    goodCode: "import type { AppRouter }",
    goodNote: "безопасно: только тип",
    badCode: "import { appRouter }",
    badNote: "течёт: БД и секреты в браузер",
    foot: "verbatimModuleSyntax делает импорт значением ошибкой",
    caption:
      "За без кодогена платят временем вывода — бейте на саброутеры, аннотируйте возвраты, держите схемы скромными, на масштабе уходите в кодоген — и дисциплиной: роутер импортируем как тип, никогда значением.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagCost}</text>
    <text x="595" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagFix}</text>

    <rect x="20" y="116" width="370" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="205" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.c1}</text>
    <text x="205" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.c2}</text>
    <text x="205" y="208" text-anchor="middle" font-size="12" fill="var(--ink)">{t.c3}</text>
    <text x="205" y="236" text-anchor="middle" font-size="12" fill="var(--accent)">{t.c4}</text>

    <rect x="410" y="116" width="370" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="595" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.m1}</text>
    <text x="595" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.m2}</text>
    <text x="595" y="208" text-anchor="middle" font-size="12" fill="var(--ink)">{t.m3}</text>
    <text x="595" y="236" text-anchor="middle" font-size="12" fill="var(--accent)">{t.m4}</text>

    <rect x="20" y="286" width="370" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="314" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodCode}</text>
    <text x="205" y="338" text-anchor="middle" font-size="11" fill="var(--accent)">{t.goodNote}</text>

    <rect x="410" y="286" width="370" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="595" y="314" text-anchor="middle" font-size="12" fill="var(--ink)">{t.badCode}</text>
    <text x="595" y="338" text-anchor="middle" font-size="11" fill="var(--muted)">{t.badNote}</text>

    <text x="400" y="388" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
