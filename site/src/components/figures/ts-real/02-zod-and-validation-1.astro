<!-- TsRealZod-1 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "one zod schema feeds two outputs: z.infer derives the static type at compile time and .parse validates bytes at runtime",
    headline: "ONE SCHEMA, TWO OUTPUTS — TYPE AND GUARD",
    sub: "one definition feeds z.infer (compile time) and .parse (runtime)",
    tagLeft: "schema, written once",
    left1: "const User = z.object({",
    left2: "id: z.number(), ... })",
    left3: "runtime value + types",
    tagTop: "compile time",
    top1: "z.infer<typeof User>",
    top2: "static type",
    top3: "for your code",
    tagBottom: "runtime",
    bottom1: "User.parse(json)",
    bottom2: "validated value",
    bottom3: "narrowed to User",
    midTop: "derive",
    midBottom: "run",
    foot: "one origin — type and guard cannot drift",
    caption:
      "The compile-time arrow (z.infer) and the runtime arrow (.parse) leave the same schema node — the type and the guard cannot drift.",
  },
  ru: {
    svgTitle: "одна zod-схема даёт два выхода: z.infer выводит статический тип на этапе компиляции, а .parse проверяет байты в рантайме",
    headline: "ОДНА СХЕМА — ДВА ВЫХОДА: ТИП И СТРАЖ",
    sub: "одно определение питает z.infer и .parse",
    tagLeft: "схема, написана раз",
    left1: "const User = z.object({",
    left2: "id: z.number(), ... })",
    left3: "рантайм-значение + типы",
    tagTop: "компиляция",
    top1: "z.infer<typeof User>",
    top2: "статический тип",
    top3: "для вашего кода",
    tagBottom: "рантайм",
    bottom1: "User.parse(json)",
    bottom2: "проверенное значение",
    bottom3: "сужено до User",
    midTop: "вывести",
    midBottom: "запуск",
    foot: "один исток — тип и страж не разъедутся",
    caption:
      "Стрелка компиляции (z.infer) и стрелка рантайма (.parse) выходят из одного узла-схемы — тип и страж не разъедутся.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="137" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="210" height="264" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="137" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.left1}</text>
    <text x="137" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.left2}</text>
    <text x="137" y="252" text-anchor="middle" font-size="11" fill="var(--accent)">{t.left3}</text>

    <text x="663" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagTop}</text>
    <rect x="558" y="116" width="210" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="663" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.top1}</text>
    <text x="663" y="178" text-anchor="middle" font-size="12" fill="var(--ink)">{t.top2}</text>
    <text x="663" y="202" text-anchor="middle" font-size="11" fill="var(--muted)">{t.top3}</text>

    <text x="663" y="250" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagBottom}</text>
    <rect x="558" y="270" width="210" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="663" y="306" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bottom1}</text>
    <text x="663" y="332" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bottom2}</text>
    <text x="663" y="356" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bottom3}</text>

    <line x1="242" y1="171" x2="540" y2="171" stroke="var(--muted)" stroke-width="2" />
    <polygon points="540,164 558,171 540,178" fill="var(--muted)" />
    <text x="400" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midTop}</text>

    <line x1="242" y1="325" x2="540" y2="325" stroke="var(--muted)" stroke-width="2" />
    <polygon points="540,318 558,325 540,332" fill="var(--muted)" />
    <text x="400" y="312" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midBottom}</text>

    <text x="400" y="406" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
