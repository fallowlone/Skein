<!-- TsRealPitfalls-3 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "mutation invalidates narrowing: a check narrows box.v to string, a call in between may reset it, and the use compiles but can throw — copy to a const local",
    headline: "NARROWING EXPIRES WHEN VALUES MUTATE",
    sub: "the compiler keeps string across sideEffect() — but box.v may be null",
    tag1: "check",
    box1a: "if (box.v !== null)",
    box1b: "narrowed to string",
    tag2: "gap",
    box2a: "sideEffect()",
    box2b: "may set box.v = null",
    tag3: "use",
    box3a: "box.v.toUpperCase()",
    box3b: "compiles — may throw",
    fix1: "fix: const v = box.v right after the check",
    fix2: "a const local can't be mutated out from under you",
    foot: "narrowing holds only while the value can't change",
    caption:
      "The compiler keeps the narrowed string across sideEffect(), which may reset box.v to null — copy to a const local right after the check.",
  },
  ru: {
    svgTitle: "мутация ломает сужение: проверка сужает box.v до string, промежуточный вызов может его сбросить, а использование компилируется, но падает — копируйте в const-локальную",
    headline: "СУЖЕНИЕ ЛОМАЕТ МУТАЦИЯ",
    sub: "компилятор хранит string сквозь вызов — но box.v может стать null",
    tag1: "проверка",
    box1a: "if (box.v !== null)",
    box1b: "сужено до string",
    tag2: "разрыв",
    box2a: "sideEffect()",
    box2b: "мог сделать null",
    tag3: "использование",
    box3a: "box.v.toUpperCase()",
    box3b: "упадёт в рантайме",
    fix1: "фикс: const v = box.v сразу после проверки",
    fix2: "const-локальную не вымутировать из-под сужения",
    foot: "сужение валидно, лишь пока значение неизменно",
    caption:
      "Компилятор хранит суженный string сквозь sideEffect(), который может сбросить box.v в null — копируйте в const-локальную сразу после проверки.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <text x="400" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <text x="650" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>

    <rect x="50" y="138" width="200" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="150" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1a}</text>
    <text x="150" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1b}</text>

    <rect x="300" y="138" width="200" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2a}</text>
    <text x="400" y="206" text-anchor="middle" font-size="11" fill="var(--accent)">{t.box2b}</text>

    <rect x="550" y="138" width="200" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="650" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3a}</text>
    <text x="650" y="206" text-anchor="middle" font-size="11" fill="var(--accent)">{t.box3b}</text>

    <line x1="250" y1="193" x2="290" y2="193" stroke="var(--muted)" stroke-width="2" />
    <polygon points="290,187 300,193 290,199" fill="var(--muted)" />
    <line x1="500" y1="193" x2="540" y2="193" stroke="var(--muted)" stroke-width="2" />
    <polygon points="540,187 550,193 540,199" fill="var(--muted)" />

    <rect x="50" y="280" width="700" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="306" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fix1}</text>
    <text x="400" y="331" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fix2}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
