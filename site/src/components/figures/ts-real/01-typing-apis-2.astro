---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "model the response as a discriminated union: the ok discriminant forces callers to narrow before touching data",
    headline: "MODEL BOTH ARMS: THE DISCRIMINANT FORCES THE CHECK",
    sub: "ApiResult<T> = ApiOk<T> | ApiErr — r.data only after r.ok",
    tagTop: "the honest contract",
    union: "ApiResult<User>",
    tagOk: "ok arm — data",
    ok1: "ok: true; data: T",
    ok2: "narrowed: data here",
    ok3: "access allowed",
    gate: "r.ok?",
    armTrue: "true",
    armFalse: "false",
    tagErr: "err arm — error",
    err1: "ok: false; error",
    err2: "code + message",
    err3: "data refused here",
    foot1: "the compiler refuses r.data on the error branch — prove r.ok first",
    foot2: "Result<T, E> generalises this: errors become tracked values",
    caption:
      "ApiResult models success and failure as one union: the ok discriminant forces callers to narrow before touching data.",
  },
  ru: {
    svgTitle: "моделируйте ответ размеченным объединением: дискриминант ok заставляет сузить тип перед доступом к data",
    headline: "МОДЕЛИРУЙ ОБЕ ВЕТКИ: ДИСКРИМИНАНТ ТРЕБУЕТ ПРОВЕРКИ",
    sub: "ApiResult<T> = ApiOk<T> | ApiErr — r.data только после r.ok",
    tagTop: "честный контракт",
    union: "ApiResult<User>",
    tagOk: "ветка ok — data",
    ok1: "ok: true; data: T",
    ok2: "сужено: data здесь",
    ok3: "доступ разрешён",
    gate: "r.ok?",
    armTrue: "true",
    armFalse: "false",
    tagErr: "ветка err — error",
    err1: "ok: false; error",
    err2: "code + message",
    err3: "data здесь нет",
    foot1: "компилятор не даёт r.data в ветке ошибки — докажи r.ok",
    foot2: "Result<T, E> обобщает: ошибки — отслеживаемые значения",
    caption:
      "ApiResult моделирует успех и отказ одним объединением: дискриминант ok заставляет сузить тип перед доступом к data.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="86" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagTop}</text>
    <rect x="250" y="96" width="300" height="36" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="119" text-anchor="middle" font-size="12" fill="var(--ink)">{t.union}</text>

    <text x="150" y="152" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagOk}</text>
    <rect x="40" y="164" width="220" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="150" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ok1}</text>
    <text x="150" y="240" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ok2}</text>
    <text x="150" y="268" text-anchor="middle" font-size="12" fill="var(--accent)">{t.ok3}</text>

    <text x="650" y="152" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagErr}</text>
    <rect x="540" y="164" width="220" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="650" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.err1}</text>
    <text x="650" y="240" text-anchor="middle" font-size="12" fill="var(--ink)">{t.err2}</text>
    <text x="650" y="268" text-anchor="middle" font-size="12" fill="var(--accent)">{t.err3}</text>

    <polygon points="400,189 450,239 400,289 350,239" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="245" text-anchor="middle" font-size="13" fill="var(--ink)">{t.gate}</text>

    <line x1="400" y1="132" x2="400" y2="185" stroke="var(--muted)" stroke-width="2" />
    <polygon points="400,189 394,179 406,179" fill="var(--muted)" />
    <line x1="346" y1="239" x2="264" y2="239" stroke="var(--accent)" stroke-width="2" />
    <polygon points="260,239 270,233 270,245" fill="var(--accent)" />
    <line x1="454" y1="239" x2="536" y2="239" stroke="var(--muted)" stroke-width="2" />
    <polygon points="540,239 530,233 530,245" fill="var(--muted)" />
    <text x="303" y="228" text-anchor="middle" font-size="11" fill="var(--accent)">{t.armTrue}</text>
    <text x="497" y="228" text-anchor="middle" font-size="11" fill="var(--muted)">{t.armFalse}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
