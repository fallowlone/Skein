---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Write skew: T1 and T2 both read 2 on-call doctors, each switches off a different one, zero remain",
    headline: "WRITE SKEW: BOTH READ 2, ZERO REMAIN",
    sub: "each updates a different row, the invariant still breaks",
    t1: "T1 · alice",
    t1Steps: ["reads on_call = 2", "sets alice = false"],
    t2: "T2 · bob",
    t2Steps: ["reads on_call = 2", "sets bob = false"],
    invTitle: "INVARIANT",
    invRule: "at least 1 on_call",
    invResult: "0 on_call · broken",
    fix: "SERIALIZABLE aborts one · 40001 · retry",
    commitOk: "COMMIT ok",
    verdict: "REPEATABLE READ allows it · SERIALIZABLE stops it",
    caption:
      "Under Repeatable Read both transactions read 2, each updates a different row, and both commit — the invariant breaks with no row conflict. Only Serializable tracks the read-write cycle and aborts one with 40001.",
  },
  ru: {
    svgTitle: "Write skew: T1 и T2 читают 2 дежурных врача, каждая отключает своего, не остаётся никого",
    headline: "WRITE SKEW: ОБЕ ЧИТАЮТ 2, ОСТАЛОСЬ 0",
    sub: "каждая меняет свою строку, инвариант всё равно сломан",
    t1: "T1 · alice",
    t1Steps: ["читает on_call = 2", "ставит alice = false"],
    t2: "T2 · bob",
    t2Steps: ["читает on_call = 2", "ставит bob = false"],
    invTitle: "ИНВАРИАНТ",
    invRule: "хотя бы 1 on_call",
    invResult: "0 on_call · сломан",
    fix: "SERIALIZABLE откатывает одну · 40001 · retry",
    commitOk: "COMMIT ok",
    verdict: "REPEATABLE READ разрешает · SERIALIZABLE ловит",
    caption:
      "Под Repeatable Read обе транзакции читают 2, каждая меняет свою строку, и обе коммитят — инвариант сломан без конфликта по строкам. Только Serializable отслеживает цикл read-write и откатывает одну с 40001.",
  },
};

const t = dict[lang];

const stepY = [156, 198];
const stepH = 34;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-ws-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="100" width="220" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="140" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.t1}</text>
    {t.t1Steps.map((r, i) => (
      <g>
        <rect x="50" y={stepY[i]} width="180" height={stepH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="140" y={stepY[i] + 23} text-anchor="middle" font-size="11" fill="var(--ink)">{r}</text>
      </g>
    ))}
    <text x="140" y="272" text-anchor="middle" font-size="11" fill="var(--accent)">{t.commitOk}</text>

    <line x1="250" y1="173" x2="288" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-ws-arrow)" />
    <line x1="550" y1="173" x2="512" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-ws-arrow)" />

    <rect x="296" y="100" width="208" height="220" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.invTitle}</text>
    <rect x="312" y="142" width="176" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="168" text-anchor="middle" font-size="11" fill="var(--ink)">{t.invRule}</text>
    <text x="400" y="190" text-anchor="middle" font-size="11" fill="var(--muted)">2 on_call</text>
    <rect x="312" y="216" width="176" height="60" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="244" text-anchor="middle" font-size="11" fill="var(--accent)">{t.invResult}</text>

    <rect x="550" y="100" width="220" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="660" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.t2}</text>
    {t.t2Steps.map((r, i) => (
      <g>
        <rect x="570" y={stepY[i]} width="180" height={stepH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="660" y={stepY[i] + 23} text-anchor="middle" font-size="11" fill="var(--ink)">{r}</text>
      </g>
    ))}
    <text x="660" y="272" text-anchor="middle" font-size="11" fill="var(--accent)">{t.commitOk}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--accent)">{t.fix}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.verdict}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
