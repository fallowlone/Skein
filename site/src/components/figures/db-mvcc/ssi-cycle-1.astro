---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "SSI detects the cycle: T1 and T2 read one set and write into each other's set, one aborts with 40001",
    headline: "SSI ABORTS THE CYCLE WITH 40001",
    sub: "reads are predicate locks, writes add rw-deps",
    t1: "T1 reads S, writes alice",
    t2: "T2 reads S, writes bob",
    dep: "rw-dep",
    abort: "one aborts · 40001 · retry all",
    rates: "false positives 0.1–1% ok · over 5% tune",
    cycle: "cycle = non-serializable schedule",
    foot: "conservative: never allows a bad schedule",
    caption:
      "Each transaction reads a set and writes into the set the other one read — two rw-antidependencies close a cycle, so SSI aborts the second committer with 40001 and the app retries. A 0.1–1% abort rate is normal; over 5% means lock coarsening or a genuine conflict.",
  },
  ru: {
    svgTitle: "SSI находит цикл: T1 и T2 читают один набор и пишут в набор друг друга, одна откатывается с 40001",
    headline: "SSI ОТКАТЫВАЕТ ЦИКЛ С 40001",
    sub: "чтения — предикатные блокировки, записи дают rw-dep",
    t1: "T1 читает S, пишет alice",
    t2: "T2 читает S, пишет bob",
    dep: "rw-dep",
    abort: "одна откатывается · 40001 · retry",
    rates: "false positive 0.1–1% норма · выше 5% тюнить",
    cycle: "цикл = non-serializable расписание",
    foot: "консервативно: плохое расписание не проходит",
    caption:
      "Каждая транзакция читает набор и пишет в набор, прочитанный другой, — две rw-антизависимости замыкают цикл, поэтому SSI откатывает второго коммитера с 40001, а приложение повторяет. Доля 0.1–1% нормальна; выше 5% — грубение блокировок или реальный конфликт.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-ssi-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="60" y="110" width="280" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="200" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.t1}</text>
    <rect x="460" y="110" width="280" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="600" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.t2}</text>

    <line x1="240" y1="170" x2="520" y2="214" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-ssi-arrow)" />
    <line x1="560" y1="170" x2="280" y2="214" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-ssi-arrow)" />
    <text x="300" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.dep}</text>
    <text x="500" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.dep}</text>

    <rect x="220" y="222" width="360" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="250" text-anchor="middle" font-size="12" fill="var(--accent)">{t.cycle}</text>

    <rect x="150" y="286" width="500" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="312" text-anchor="middle" font-size="13" fill="var(--accent)">{t.abort}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rates}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
