---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Readers never wait for writers: Sven reads a frozen snapshot while Otto writes fresh row versions",
    headline: "READERS NEVER WAIT FOR WRITERS",
    sub: "one snapshot for the reader, fresh versions for the writer",
    readerTitle: "READER · Sven report",
    readerRows: ["snapshot frozen at start", "reads v1", "never waits"],
    writerTitle: "WRITER · Otto checkout",
    writerRows: ["writes fresh versions", "creates v2", "never waits"],
    midNote: "same rows, different versions · no locks",
    foot: "readers see old versions, writers create new ones",
    caption:
      "MVCC hands the report a snapshot frozen at its start while checkout writes fresh row versions the report cannot see — readers see old versions, writers create new ones, and neither waits.",
  },
  ru: {
    svgTitle: "Читатели не ждут писателей: Sven читает замороженный snapshot, пока Otto пишет свежие версии строк",
    headline: "ЧИТАТЕЛИ НЕ ЖДУТ ПИСАТЕЛЕЙ",
    sub: "читателю — snapshot, писателю — свежие версии",
    readerTitle: "ЧИТАТЕЛЬ · отчёт Sven",
    readerRows: ["snapshot заморожен на старте", "читает v1", "никого не ждёт"],
    writerTitle: "ПИСАТЕЛЬ · заказы Otto",
    writerRows: ["пишет свежие версии", "создаёт v2", "никого не ждёт"],
    midNote: "одни строки, разные версии · без блокировок",
    foot: "читатели видят старые версии, писатели создают новые",
    caption:
      "MVCC выдаёт отчёту snapshot, замороженный на его старте, пока оформление пишет свежие версии строк, невидимые отчёту, — читатели видят старые версии, писатели создают новые, и никто никого не ждёт.",
  },
};

const t = dict[lang];

const chipY = [156, 198, 240];
const chipH = 34;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-rw-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="320" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="200" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.readerTitle}</text>
    {t.readerRows.map((r, i) => (
      <g>
        <rect x="60" y={chipY[i]} width="280" height={chipH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="200" y={chipY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <line x1="360" y1="190" x2="428" y2="190" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-rw-arrow)" />
    <line x1="440" y1="230" x2="372" y2="230" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-rw-arrow)" />

    <rect x="440" y="100" width="320" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="600" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.writerTitle}</text>
    {t.writerRows.map((r, i) => (
      <g>
        <rect x="460" y={chipY[i]} width="280" height={chipH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="600" y={chipY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.midNote}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
