---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "HOT update on a five-index table: no indexed column changed and room on the page means zero index writes",
    headline: "HOT: FIVE INDEX WRITES BECOME ZERO",
    sub: "no indexed column changed, new tuple fits the page",
    pageTitle: "HEAP PAGE",
    oldLab: "old · HEAP_HOT_UPDATED",
    newLab: "new · HEAP_ONLY_TUPLE",
    reserve: "free space · fillfactor = 85",
    idxTitle: "INDEXES · 5",
    barHot: "HOT update · 0 writes",
    barFull: "chain broken · 5 writes",
    wal: "WAL savings 30–70%",
    foot: "fillfactor reserves room so the chain survives",
    chainNote: "index points at the original tuple, the chain walks the rest",
    caption:
      "On a five-index table HOT turns five index writes into zero — the index keeps pointing at the original tuple while the heap chain carries the lookup. Break the chain or touch an indexed column and every UPDATE pays all five writes again.",
  },
  ru: {
    svgTitle: "HOT-обновление таблицы с пятью индексами: индексированные колонки не тронуты и место на странице есть — ноль записей в индексы",
    headline: "HOT: ПЯТЬ ЗАПИСЕЙ СТАНОВЯТСЯ НУЛЁМ",
    sub: "индексированные колонки не тронуты, новый tuple влез на страницу",
    pageTitle: "HEAP-СТРАНИЦА",
    oldLab: "старый · HEAP_HOT_UPDATED",
    newLab: "новый · HEAP_ONLY_TUPLE",
    reserve: "свободное место · fillfactor = 85",
    idxTitle: "ИНДЕКСЫ · 5",
    barHot: "HOT-обновление · 0 записей",
    barFull: "цепочка порвана · 5 записей",
    wal: "экономия WAL 30–70%",
    foot: "fillfactor держит место, чтобы цепочка жила",
    chainNote: "индекс смотрит на исходный tuple, дальше ведёт цепочка",
    caption:
      "На таблице с пятью индексами HOT превращает пять записей в индексы в ноль — индекс продолжает указывать на исходный tuple, а heap-цепочка доводит поиск. Порви цепочку или тронь индексированную колонку — и каждый UPDATE снова платит все пять записей.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-hot-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="340" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.pageTitle}</text>
    <rect x="60" y="142" width="300" height="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="210" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.oldLab}</text>
    <line x1="210" y1="182" x2="210" y2="202" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-hot-arrow)" />
    <text x="228" y="197" font-size="11" fill="var(--muted)">t_ctid</text>
    <rect x="60" y="204" width="300" height="40" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="230" text-anchor="middle" font-size="12" fill="var(--ink)">{t.newLab}</text>
    <rect x="60" y="256" width="300" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="5 4" />
    <text x="210" y="283" text-anchor="middle" font-size="11" fill="var(--muted)">{t.reserve}</text>

    <rect x="420" y="100" width="340" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.idxTitle}</text>
    <text x="440" y="164" font-size="12" fill="var(--ink)">{t.barHot}</text>
    <rect x="440" y="174" width="24" height="22" fill="var(--accent)" />
    <text x="440" y="222" font-size="12" fill="var(--ink)">{t.barFull}</text>
    <rect x="440" y="232" width="300" height="22" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <rect x="450" y="274" width="280" height="34" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="297" text-anchor="middle" font-size="13" fill="var(--accent)">{t.wal}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.chainNote}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
