---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Autovacuum fires past 50 plus 20 percent of live tuples, with 3 workers waking every 60 seconds",
    headline: "AUTOVACUUM RUNS PAST 50 + 20%",
    sub: "dead tuples over threshold dispatches a worker",
    fBase: "base: 50 tuples",
    fScale: "+ 20% of live tuples",
    fGo: "dispatch a worker",
    wCount: "3 workers",
    wWake: "wakes every 60 s",
    lockLine: "lock: SHARE UPDATE EXCLUSIVE",
    lockNote: "reads and writes continue",
    nap: "naptime 60 s",
    ddlNote: "blocks DDL only",
    formula: "threshold + scale_factor × n_live_tup",
    foot: "per-table overrides tighten 20% down to 5% or 2%",
    caption:
      "Autovacuum wakes every 60 seconds and dispatches one of 3 workers once dead tuples pass 50 plus 20% of live tuples. The worker locks SHARE UPDATE EXCLUSIVE, so reads and writes continue — high-write tables override the 20% down to 5% or 2%.",
  },
  ru: {
    svgTitle: "Autovacuum срабатывает после 50 плюс 20 процентов живых tuple, 3 воркера просыпаются каждые 60 секунд",
    headline: "AUTOVACUUM СТАРТУЕТ ПОСЛЕ 50 + 20%",
    sub: "мёртвых tuple больше порога — воркер пошёл",
    fBase: "база: 50 tuple",
    fScale: "+ 20% живых tuple",
    fGo: "послать воркера",
    wCount: "3 воркера",
    wWake: "побудка каждые 60 с",
    lockLine: "блокировка: SHARE UPDATE EXCLUSIVE",
    lockNote: "чтения и записи продолжаются",
    nap: "naptime 60 с",
    ddlNote: "блокирует только DDL",
    formula: "threshold + scale_factor × n_live_tup",
    foot: "per-table override жмёт 20% до 5% или 2%",
    caption:
      "Autovacuum просыпается каждые 60 секунд и посылает одного из 3 воркеров, когда мёртвые tuple переходят 50 плюс 20% живых. Воркер берёт SHARE UPDATE EXCLUSIVE, поэтому чтения и записи продолжаются, — а нагруженные таблицы переопределяют 20% до 5% или 2%.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-at-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="60" y="110" width="210" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="165" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fBase}</text>
    <text x="280" y="146" text-anchor="middle" font-size="16" fill="var(--muted)">+</text>
    <rect x="290" y="110" width="240" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="410" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fScale}</text>
    <text x="540" y="146" text-anchor="middle" font-size="16" fill="var(--muted)">=</text>
    <rect x="550" y="110" width="190" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="645" y="146" text-anchor="middle" font-size="12" fill="var(--accent)">{t.fGo}</text>

    <rect x="60" y="200" width="340" height="100" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="230" y="230" text-anchor="middle" font-size="13" fill="var(--ink)">{t.wCount}</text>
    <text x="230" y="256" text-anchor="middle" font-size="12" fill="var(--muted)">{t.wWake}</text>
    <text x="230" y="280" text-anchor="middle" font-size="11" fill="var(--muted)">{t.nap}</text>

    <rect x="420" y="200" width="320" height="100" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="580" y="230" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lockLine}</text>
    <text x="580" y="256" text-anchor="middle" font-size="12" fill="var(--accent)">{t.lockNote}</text>
    <text x="580" y="280" text-anchor="middle" font-size="11" fill="var(--muted)">{t.ddlNote}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
