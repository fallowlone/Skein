---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "XID age ladder: freeze at 200 million, alert at 1 billion, page at 1.5 billion, refuse near 2 billion",
    headline: "32-BIT XIDS: FREEZE OR SHUTDOWN",
    sub: "one finite counter, four rungs, no negotiation",
    rungs: ["freeze · 200M", "alert · 1B", "page · 1.5B", "refuse · near 2B"],
    frozenTitle: "FROZEN TUPLE",
    frozenBody: "t_xmin = FrozenTransactionId",
    frozenNote: "always visible, never wraps",
    multiTitle: "MULTIXACT SPACE",
    multiBody: "shared FOR KEY SHARE locks",
    multiNote: "own 32 bits, own wraparound",
    query: "age(datfrozenxid), age(datminmxid)",
    foot: "freeze runs even with autovacuum = off",
    caption:
      "Vacuum freezes tuples past 200 million transactions so old xmin values never look new. Alert at 1 billion, page at 1.5 billion — near 2 billion Postgres refuses commands. Shared row locks run a separate MultiXact clock with the same limit.",
  },
  ru: {
    svgTitle: "Лестница возраста XID: заморозка на 200 миллионах, алерт на 1 миллиарде, пейджер на 1.5, отказ около 2 миллиардов",
    headline: "32-БИТНЫЕ XID: ЗАМОРОЗЬ ИЛИ ВСТАНЬ",
    sub: "один конечный счётчик, четыре ступени, без торгов",
    rungs: ["заморозка · 200M", "алерт · 1B", "пейджер · 1.5B", "отказ · около 2B"],
    frozenTitle: "ЗАМОРОЖЕННЫЙ TUPLE",
    frozenBody: "t_xmin = FrozenTransactionId",
    frozenNote: "всегда видим, не переполняется",
    multiTitle: "ПРОСТРАНСТВО MULTIXACT",
    multiBody: "shared-блокировки FOR KEY SHARE",
    multiNote: "свои 32 бита, свой wraparound",
    query: "age(datfrozenxid), age(datminmxid)",
    foot: "заморозка работает даже при autovacuum = off",
    caption:
      "Vacuum замораживает tuple старше 200 миллионов транзакций, чтобы старые xmin никогда не выглядели новыми. Алерт на 1 миллиарде, пейджер на 1.5 — около 2 миллиардов Postgres отказывает в командах. Shared-блокировки строк идут на отдельных часах MultiXact с тем же лимитом.",
  },
};

const t = dict[lang];

const rungY = [130, 178, 226, 274];
const rungH = 40;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-xf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <line x1="200" y1="100" x2="200" y2="330" stroke="var(--ink)" stroke-width="2" />
    {t.rungs.map((r, i) => (
      <g>
        <rect x="60" y={rungY[i]} width="280" height={rungH} fill={i === 3 ? "var(--paper)" : "var(--card)"} stroke={i === 3 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 3 ? 2.5 : 1.5} />
        <text x="200" y={rungY[i] + 27} text-anchor="middle" font-size="12" fill={i === 3 ? "var(--accent)" : "var(--ink)"}>{r}</text>
      </g>
    ))}

    <rect x="400" y="100" width="340" height="104" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="570" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.frozenTitle}</text>
    <text x="570" y="152" text-anchor="middle" font-size="11" fill="var(--muted)">{t.frozenBody}</text>
    <text x="570" y="178" text-anchor="middle" font-size="12" fill="var(--accent)">{t.frozenNote}</text>

    <rect x="400" y="220" width="340" height="104" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="570" y="246" text-anchor="middle" font-size="12" fill="var(--ink)">{t.multiTitle}</text>
    <text x="570" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.multiBody}</text>
    <text x="570" y="298" text-anchor="middle" font-size="11" fill="var(--muted)">{t.multiNote}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.query}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
