---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Visibility path: hint bits short-circuit CLOG, misses read 2 bits per xid, then write the bit back",
    headline: "CLOG: HINT BITS FIRST, LOG SECOND",
    sub: "common cases never touch the commit log",
    steps: ["check hint bits", "read CLOG", "write bit back", "apply rule"],
    note1: "2 bits per xid",
    note2: "32768 per 8 KB page",
    foot: "first scan pays CLOG, second scan reads bits",
    hint: "HEAP_XMIN_COMMITTED set: skip CLOG",
    caption:
      "HeapTupleSatisfiesMVCC checks the infomask hint bits first and skips CLOG when they are set. On a miss it reads 2 bits per xid from pg_xact and writes the hint back — so the SELECT right after a big INSERT pays once, and the next one is fast.",
  },
  ru: {
    svgTitle: "Путь видимости: hint-биты закорачивают CLOG, промахи читают 2 бита на xid и записывают бит обратно",
    headline: "CLOG: СНАЧАЛА HINT-БИТЫ, ПОТОМ ЛОГ",
    sub: "частые случаи не трогают commit log",
    steps: ["проверить hint-биты", "прочитать CLOG", "записать бит", "применить правило"],
    note1: "2 бита на xid",
    note2: "32768 на страницу 8 КБ",
    foot: "первый скан платит CLOG, второй читает биты",
    hint: "HEAP_XMIN_COMMITTED выставлен: пропустить CLOG",
    caption:
      "HeapTupleSatisfiesMVCC сначала проверяет hint-биты infomask и пропускает CLOG, если они выставлены. На промахе читает 2 бита на xid из pg_xact и записывает hint обратно — поэтому SELECT сразу после большого INSERT платит один раз, а следующий уже быстрый.",
  },
};

const t = dict[lang];

const stepX = [40, 230, 420, 610];
const stepW = [170, 170, 170, 170];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-ch-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.steps.map((s, i) => (
      <g>
        <rect x={stepX[i]} y="120" width={stepW[i]} height="80" fill={i === 1 ? "var(--paper)" : "var(--card)"} stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 1 ? 2.5 : 1.5} />
        <text x={stepX[i] + 14} y="146" font-size="11" fill="var(--muted)">{1 + i}</text>
        <text x={stepX[i] + stepW[i] / 2} y="172" text-anchor="middle" font-size="12" fill="var(--ink)">{s}</text>
      </g>
    ))}

    <line x1="210" y1="160" x2="230" y2="160" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-ch-arrow)" />
    <line x1="400" y1="160" x2="420" y2="160" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-ch-arrow)" />
    <line x1="590" y1="160" x2="610" y2="160" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-ch-arrow)" />

    <rect x="230" y="230" width="340" height="72" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="258" text-anchor="middle" font-size="12" fill="var(--ink)">{t.note1}</text>
    <text x="400" y="282" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note2}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.hint}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
