---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Lost update: two tabs read v1, B saves v2 first, A saves over it and B's edit disappears",
    headline: "LOST UPDATE: LAST SAVE WINS",
    sub: "two tabs read one row, the second save erases the first",
    tabA: "TAB A · slow typer",
    aSteps: ["reads v1", "types on", "saves last"],
    rowTitle: "ROW · profile",
    rowSteps: ["v1 read twice", "v2 by B saved", "v2 lost"],
    tabB: "TAB B · quick edit",
    bSteps: ["reads v1", "edits 1 field", "saves first"],
    fix: "fix: SELECT FOR UPDATE or a stricter level",
    foot: "both snapshots valid, writes not serialized",
    caption:
      "MVCC gives both tabs a valid snapshot but does not serialize their writes — B saves, then A saves over B, and B's edit silently disappears. Prevent it with SELECT FOR UPDATE or a stricter isolation level.",
  },
  ru: {
    svgTitle: "Потерянное обновление: две вкладки читают v1, B сохраняет первой, A перезаписывает и правка B исчезает",
    headline: "LOST UPDATE: ПОБЕЖДАЕТ ПОСЛЕДНИЙ",
    sub: "две вкладки читают строку, второе сохранение стирает первое",
    tabA: "ВКЛАДКА A · медленная",
    aSteps: ["читает v1", "печатает", "сохраняет последней"],
    rowTitle: "СТРОКА · профиль",
    rowSteps: ["v1 прочитан дважды", "v2 от B сохранён", "v2 потерян"],
    tabB: "ВКЛАДКА B · быстрая",
    bSteps: ["читает v1", "меняет 1 поле", "сохраняет первой"],
    fix: "лечение: SELECT FOR UPDATE или строже уровень",
    foot: "оба snapshot валидны, записи не сериализованы",
    caption:
      "MVCC даёт обеим вкладкам валидный snapshot, но не сериализует их записи, — B сохраняет, затем A сохраняет поверх, и правка B молча исчезает. Защита: SELECT FOR UPDATE или строже уровень изоляции.",
  },
};

const t = dict[lang];

const stepY = [150, 192, 234];
const stepH = 34;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-lu-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="100" width="220" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="140" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.tabA}</text>
    {t.aSteps.map((r, i) => (
      <g>
        <rect x="50" y={stepY[i]} width="180" height={stepH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="140" y={stepY[i] + 23} text-anchor="middle" font-size="11" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <rect x="270" y="100" width="260" height="220" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rowTitle}</text>
    {t.rowSteps.map((r, i) => (
      <g>
        <rect x="290" y={stepY[i]} width="220" height={stepH} fill="var(--paper)" stroke={i === 2 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 2 ? 2.5 : 1.5} />
        <text x="400" y={stepY[i] + 23} text-anchor="middle" font-size="11" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <rect x="550" y="100" width="220" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="660" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.tabB}</text>
    {t.bSteps.map((r, i) => (
      <g>
        <rect x="570" y={stepY[i]} width="180" height={stepH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="660" y={stepY[i] + 23} text-anchor="middle" font-size="11" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <line x1="250" y1="167" x2="270" y2="167" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-lu-arrow)" />
    <line x1="550" y1="209" x2="530" y2="209" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-lu-arrow)" />
    <line x1="250" y1="251" x2="270" y2="251" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-lu-arrow)" />

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--accent)">{t.fix}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
