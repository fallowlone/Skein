---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Runaway bloat: a 6-hour SELECT pins xmin, vacuum removes 0, 287 million stay, orders grows 80 to 180 GB",
    headline: "287M TUPLES STUCK, 0 REMOVED",
    sub: "one overnight job turns 80 GB into 180 GB",
    stages: ["6 h SELECT", "pins oldest xmin", "0 removed", "287M stuck"],
    growth: "orders: 80 GB goes to 180 GB",
    xmin: "oldest xmin: 28391456",
    fix: "kill txn or drop slot, next cycle reclaims",
    foot: "prevention: idle timeout 5–15 min, slot alerts",
    log: "30 min vacuum, 0 removed, log says cannot remove",
    caption:
      "A 6-hour query pins the global oldest xmin, so a 30-minute vacuum removes 0 tuples and 287 million stay not-removable — orders grows from 80 GB to 180 GB by morning. Kill the holder or drop the orphan slot and the next cycle reclaims everything.",
  },
  ru: {
    svgTitle: "Неконтролируемый bloat: 6-часовой SELECT пинит xmin, vacuum убирает 0, 287 миллионов остаются, orders растёт с 80 до 180 ГБ",
    headline: "287M TUPLE ЗАСТРЯЛИ, УБРАНО 0",
    sub: "одно ночное задание превращает 80 ГБ в 180 ГБ",
    stages: ["SELECT 6 ч", "пинит oldest xmin", "убрано 0", "287M застряли"],
    growth: "orders: 80 ГБ становятся 180 ГБ",
    xmin: "oldest xmin: 28391456",
    fix: "убить txn или drop slot, следующий цикл уберёт",
    foot: "профилактика: idle timeout 5–15 мин, алерты slot",
    log: "30 мин vacuum, убрано 0, в логе cannot remove",
    caption:
      "6-часовой запрос закрепляет глобальный oldest xmin, поэтому 30-минутный vacuum убирает 0 tuple и 287 миллионов остаются неудаляемыми — orders вырастает с 80 ГБ до 180 ГБ к утру. Убей держателя или удали orphan slot, и следующий цикл уберёт всё.",
  },
};

const t = dict[lang];

const stageX = [40, 230, 420, 610];
const stageW = [170, 170, 170, 150];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-bf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.stages.map((s, i) => (
      <g>
        <rect x={stageX[i]} y="110" width={stageW[i]} height="60" fill={i === 3 ? "var(--paper)" : "var(--card)"} stroke={i === 3 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 3 ? 2.5 : 1.5} />
        <text x={stageX[i] + stageW[i] / 2} y="146" text-anchor="middle" font-size="11" fill={i === 3 ? "var(--accent)" : "var(--ink)"}>{s}</text>
      </g>
    ))}

    <line x1="210" y1="140" x2="230" y2="140" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-bf-arrow)" />
    <line x1="400" y1="140" x2="420" y2="140" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-bf-arrow)" />
    <line x1="590" y1="140" x2="610" y2="140" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-bf-arrow)" />

    <rect x="60" y="200" width="680" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="224" text-anchor="middle" font-size="13" fill="var(--ink)">{t.growth}</text>
    <text x="400" y="246" text-anchor="middle" font-size="11" fill="var(--muted)">{t.xmin}</text>

    <rect x="60" y="272" width="680" height="40" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="298" text-anchor="middle" font-size="12" fill="var(--accent)">{t.fix}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.log}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
