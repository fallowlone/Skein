---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Vacuum trigger ratios: global default 20 percent, per-table override 5 percent, aggressive OLTP 2 percent",
    headline: "TUNE VACUUM: 20% IS TOO LAX",
    sub: "scale_factor sets the dead-tuple ratio that fires a worker",
    bars: ["default · 20%", "per-table · 5%", "OLTP · 2%"],
    facts: "cost_delay = 0 on NVMe · workers 3 to 6",
    foot: "plus an explicit VACUUM (PARALLEL 4) overnight",
    caption:
      "The global 20% dead-tuple trigger is too lax for high-write tables: per-table overrides of 5% or 2% vacuum sooner and keep bloat bounded. On NVMe set cost_delay to 0 and grow the pool from 3 to 6 workers.",
  },
  ru: {
    svgTitle: "Пороги запуска vacuum: глобальный дефолт 20 процентов, per-table override 5 процентов, агрессивный OLTP 2 процента",
    headline: "ТЮНИНГ VACUUM: 20% — СЛИШКОМ МЯГКО",
    sub: "scale_factor задаёт долю мёртвых tuple для запуска",
    bars: ["дефолт · 20%", "per-table · 5%", "OLTP · 2%"],
    facts: "cost_delay = 0 на NVMe · воркеры с 3 до 6",
    foot: "плюс явный VACUUM (PARALLEL 4) ночью",
    caption:
      "Глобальные 20% мёртвых tuple слишком мягки для нагруженных таблиц: per-table override 5% или 2% убирают раньше и держат bloat в узде. На NVMe ставь cost_delay в 0 и расти пул с 3 до 6 воркеров.",
  },
};

const t = dict[lang];

const barY = [130, 182, 234];
const barH = 36;
const barW = [560, 140, 56];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-vt-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.bars.map((b, i) => (
      <g>
        <text x="200" y={barY[i] + 25} text-anchor="end" font-size="12" fill="var(--ink)">{b}</text>
        <rect x="220" y={barY[i]} width={barW[i]} height={barH} fill={i === 0 ? "var(--paper)" : "var(--card)"} stroke={i === 0 ? "var(--ink)" : "var(--accent)"} stroke-width={i === 0 ? 1.5 : 2} />
      </g>
    ))}
    <text x="228" y="155" font-size="11" fill="var(--muted)">20%</text>
    <text x="228" y="207" font-size="11" fill="var(--muted)">5%</text>
    <text x="228" y="259" font-size="11" fill="var(--muted)">2%</text>

    <rect x="60" y="292" width="680" height="40" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="318" text-anchor="middle" font-size="12" fill="var(--accent)">{t.facts}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">autovacuum_vacuum_scale_factor</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
