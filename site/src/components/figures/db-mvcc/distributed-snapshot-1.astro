---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "No global snapshot across shards: the coordinator opens a transaction, each worker builds its own snapshot",
    headline: "NO GLOBAL SNAPSHOT ACROSS SHARDS",
    sub: "each worker builds its own local snapshot",
    coord: "coordinator opens txn",
    workers: ["shard A · own snapshot", "shard B · own snapshot", "shard C · own snapshot"],
    hlc: "HLC tags order visibility",
    proto: "default: read committed + 2PC",
    coloc: "need serializable? co-locate rows",
    scope: "local SSI only · no distributed serializable",
    caption:
      "Citus shards are real Postgres tables with their own MVCC, but there is no shared-memory snapshot across workers — the coordinator opens one transaction per worker and each builds a local snapshot. Cross-shard order comes from hybrid logical clocks; distributed writes default to read committed with two-phase commit.",
  },
  ru: {
    svgTitle: "Нет глобального snapshot между шардами: координатор открывает транзакцию, каждый воркер строит свой snapshot",
    headline: "НЕТ ГЛОБАЛЬНОГО SNAPSHOT МЕЖДУ ШАРДАМИ",
    sub: "каждый воркер строит свой локальный snapshot",
    coord: "координатор открывает txn",
    workers: ["шард A · свой snapshot", "шард B · свой snapshot", "шард C · свой snapshot"],
    hlc: "HLC-метки упорядочивают видимость",
    proto: "дефолт: read committed + 2PC",
    coloc: "нужен serializable? co-locate строк",
    scope: "SSI только локально · распределённого serializable нет",
    caption:
      "Шарды Citus — настоящие таблицы Postgres с собственным MVCC, но общего shared-memory snapshot между воркерами нет — координатор открывает по транзакции на воркер, и каждый строит локальный snapshot. Порядок между шардами дают hybrid logical clocks; распределённые записи по умолчанию — read committed с двухфазным коммитом.",
  },
};

const t = dict[lang];

const wX = [60, 290, 520];
const wW = [220, 220, 200];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-ds-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="250" y="96" width="300" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.coord}</text>

    <line x1="330" y1="148" x2="170" y2="190" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-ds-arrow)" />
    <line x1="400" y1="148" x2="400" y2="190" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-ds-arrow)" />
    <line x1="470" y1="148" x2="620" y2="190" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-ds-arrow)" />

    {t.workers.map((w, i) => (
      <g>
        <rect x={wX[i]} y="196" width={wW[i]} height="64" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={wX[i] + wW[i] / 2} y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{w}</text>
      </g>
    ))}

    <rect x="60" y="284" width="340" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="230" y="310" text-anchor="middle" font-size="11" fill="var(--ink)">{t.hlc}</text>
    <rect x="420" y="284" width="320" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="580" y="310" text-anchor="middle" font-size="11" fill="var(--ink)">{t.proto}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--accent)">{t.coloc}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.scope}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
