---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Every tuple carries a 23-byte header: t_xmin 4, t_xmax 4, t_ctid 6, t_infomask 2, rest 7",
    headline: "EVERY ROW PAYS 23 BYTES FIRST",
    sub: "the header rides ahead of your columns on every tuple",
    segNames: ["t_xmin", "t_xmax", "t_ctid", "t_infomask", "rest"],
    total: "23 B total",
    cols: "user columns",
    foot: "every UPDATE writes a new tuple and pays the header again",
    caption:
      "Every tuple carries its 23-byte header ahead of the user columns — xmin, xmax, ctid and the flag bits that visibility math reads — so every UPDATE that writes a new tuple pays the header tax again.",
  },
  ru: {
    svgTitle: "Каждый tuple несёт 23-байтный заголовок: t_xmin 4, t_xmax 4, t_ctid 6, t_infomask 2, остальное 7",
    headline: "КАЖДАЯ СТРОКА СНАЧАЛА ПЛАТИТ 23 БАЙТА",
    sub: "заголовок едет перед твоими колонками в каждом tuple",
    segNames: ["t_xmin", "t_xmax", "t_ctid", "t_infomask", "rest"],
    total: "итого 23 Б",
    cols: "колонки пользователя",
    foot: "каждый UPDATE пишет новый tuple и снова платит за заголовок",
    caption:
      "Каждый tuple несёт 23-байтный заголовок перед пользовательскими колонками — xmin, xmax, ctid и биты флагов, которые читает правило видимости, — поэтому каждый UPDATE с новым tuple снова платит налог за заголовок.",
  },
};

const t = dict[lang];

const segX = [50, 172, 294, 476, 537];
const segW = [122, 122, 182, 61, 213];
const segBytes = ["4 B", "4 B", "6 B", "2 B", "7 B"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-th-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="50" y="120" font-size="11" fill="var(--muted)">0</text>
    <text x="750" y="120" text-anchor="end" font-size="11" fill="var(--muted)">23 B</text>

    {t.segNames.map((s, i) => (
      <g>
        <text x={segX[i] + segW[i] / 2} y="120" text-anchor="middle" font-size="11" fill="var(--ink)">{s}</text>
        <rect x={segX[i]} y="130" width={segW[i]} height="64" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x={segX[i] + segW[i] / 2} y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{segBytes[i]}</text>
      </g>
    ))}

    <rect x="50" y="214" width="700" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="236" text-anchor="middle" font-size="15" fill="var(--accent)">{t.total}</text>
    <text x="400" y="258" text-anchor="middle" font-size="11" fill="var(--muted)">t_xmin · t_xmax · t_ctid · t_infomask</text>

    <line x1="400" y1="266" x2="400" y2="296" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-th-arrow)" />
    <rect x="150" y="300" width="500" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="328" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cols}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
