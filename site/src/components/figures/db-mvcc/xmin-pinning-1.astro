---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A pinned oldest xmin stops every vacuum: long transaction or orphan slot pins it, dead tuples stay",
    headline: "A PINNED XMIN STOPS EVERY VACUUM",
    sub: "only tuples older than the global oldest xmin can go",
    src1: "long transaction",
    src2: "orphan replication slot",
    mid: "oldest xmin pinned",
    res: "dead tuples stay",
    fix: "fix: terminate txn or drop slot",
    prev: "prevention: idle timeout 5–15 min",
    diag: "diagnose: backend_xmin, smallest first",
    gate: "t_xmax older than oldest xmin?",
    grow: "file keeps growing",
    caption:
      "A long transaction or an orphan replication slot pins the global oldest xmin, so autovacuum keeps running but removes nothing. Diagnose via backend_xmin, terminate the holder or drop the slot, and the next cycle reclaims everything.",
  },
  ru: {
    svgTitle: "Закреплённый oldest xmin останавливает уборку: долгая транзакция или orphan slot пинит его, мёртвые tuple остаются",
    headline: "ЗАКРЕПЛЁННЫЙ XMIN ОСТАНАВЛИВАЕТ VACUUM",
    sub: "убирать можно только tuple старше глобального oldest xmin",
    src1: "долгая транзакция",
    src2: "orphan replication slot",
    mid: "oldest xmin закреплён",
    res: "мёртвые tuple остаются",
    fix: "лечение: убить txn или drop slot",
    prev: "профилактика: idle timeout 5–15 мин",
    diag: "диагноз: backend_xmin, сначала самый старый",
    gate: "t_xmax старше oldest xmin?",
    grow: "файл продолжает расти",
    caption:
      "Долгая транзакция или orphan replication slot закрепляет глобальный oldest xmin, и autovacuum крутится вхолостую. Диагноз через backend_xmin, завершить держателя или удалить slot — и следующий цикл убирает всё.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-xp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="130" width="200" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="140" y="166" text-anchor="middle" font-size="11" fill="var(--ink)">{t.src1}</text>
    <rect x="40" y="210" width="200" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="140" y="246" text-anchor="middle" font-size="11" fill="var(--ink)">{t.src2}</text>

    <line x1="240" y1="160" x2="280" y2="180" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-xp-arrow)" />
    <line x1="240" y1="240" x2="280" y2="220" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-xp-arrow)" />

    <rect x="288" y="140" width="224" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="196" text-anchor="middle" font-size="12" fill="var(--accent)">{t.mid}</text>
    <text x="400" y="222" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gate}</text>

    <line x1="512" y1="200" x2="552" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-xp-arrow)" />

    <rect x="560" y="140" width="200" height="120" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="660" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.res}</text>
    <text x="660" y="222" text-anchor="middle" font-size="11" fill="var(--muted)">{t.grow}</text>

    <rect x="60" y="292" width="680" height="40" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="318" text-anchor="middle" font-size="12" fill="var(--accent)">{t.fix}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.diag}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.prev}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
