---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Snapshot rule on row id 42: v1 balance 100 stays visible, v2 balance 0 is invisible while A is in xip",
    headline: "SNAPSHOT: THREE NUMBERS DECIDE",
    sub: "xmin, xmax, xip — checked against every tuple",
    snapTitle: "SNAPSHOT OF B",
    snapRows: ["xmin: oldest running", "xmax: next id", "xip: A in progress"],
    rowTitle: "ROW id = 42",
    v1: "v1 · balance = 100 · visible",
    why1: "xmax = A in xip, deletion not seen",
    v2: "v2 · balance = 0 · invisible",
    why2: "xmin = A in xip, creation not seen",
    foot: "READ COMMITTED: a fresh snapshot per statement",
    rule: "t_xmin committed and not in xip · t_xmax 0, rolled back, or in xip",
    caption:
      "B reads balance 100 from v1 because A sits in B's in-progress list: the deletion of v1 is not yet visible and the creation of v2 is not yet visible. Under Read Committed the next statement takes a fresh snapshot and sees 0.",
  },
  ru: {
    svgTitle: "Правило snapshot на строке id 42: v1 balance 100 видим, v2 balance 0 невидим пока A в xip",
    headline: "SNAPSHOT: РЕШАЮТ ТРИ ЧИСЛА",
    sub: "xmin, xmax, xip — проверяются на каждом tuple",
    snapTitle: "SNAPSHOT ТРАНЗАКЦИИ B",
    snapRows: ["xmin: старейшая активная", "xmax: следующий id", "xip: A в процессе"],
    rowTitle: "СТРОКА id = 42",
    v1: "v1 · balance = 100 · видим",
    why1: "xmax = A в xip, удаление не видно",
    v2: "v2 · balance = 0 · невидим",
    why2: "xmin = A в xip, создание не видно",
    foot: "READ COMMITTED: свежий snapshot на statement",
    rule: "t_xmin закоммичен и не в xip · t_xmax 0, откатан или в xip",
    caption:
      "B читает balance 100 из v1, потому что A в списке in-progress snapshot B: удаление v1 ещё не видно и создание v2 ещё не видно. Под Read Committed следующий statement берёт свежий snapshot и видит 0.",
  },
};

const t = dict[lang];

const snapY = [150, 192, 234];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-sr-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="260" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="170" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.snapTitle}</text>
    {t.snapRows.map((r, i) => (
      <g>
        <rect x="60" y={snapY[i]} width="220" height="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="170" y={snapY[i] + 23} text-anchor="middle" font-size="11" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <line x1="300" y1="210" x2="348" y2="210" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmvcc-sr-arrow)" />

    <rect x="356" y="100" width="404" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="558" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rowTitle}</text>
    <rect x="376" y="142" width="364" height="72" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="558" y="168" text-anchor="middle" font-size="13" fill="var(--ink)">{t.v1}</text>
    <text x="558" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.why1}</text>
    <rect x="376" y="228" width="364" height="72" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="558" y="254" text-anchor="middle" font-size="13" fill="var(--muted)">{t.v2}</text>
    <text x="558" y="278" text-anchor="middle" font-size="11" fill="var(--muted)">{t.why2}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rule}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
