---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three deployment levers: pg_repack online rewrite, pgbouncer SET LOCAL, idle timeout 5 to 15 minutes",
    headline: "THREE LEVERS AGAINST BLOAT",
    sub: "rewrite online, scope settings, kill idle txns",
    l1t: "pg_repack online",
    l1d: "shadow copy, brief swap",
    l1c: "costs transient 2x disk",
    l2t: "pgbouncer: SET LOCAL",
    l2d: "plain SET leaks clients",
    l2c: "LOCAL ends with txn",
    l3t: "idle timeout 5–15 min",
    l3d: "kills forgotten txns",
    l3c: "safety net, not a fix",
    foot: "run pg_repack nightly on the top bloated tables",
    diskU: "disk",
    minU: "min",
    notSet: "not SET",
    leverNote: "each lever closes a different pin source",
    caption:
      "pg_repack rewrites bloated tables online with only a brief swap lock at the cost of transient 2x disk. In pgbouncer transaction mode use SET LOCAL — plain SET leaks across pooled clients. And idle_in_transaction_session_timeout of 5–15 minutes kills forgotten open transactions before they pin xmin.",
  },
  ru: {
    svgTitle: "Три deployment-рычага: pg_repack онлайн-переписывание, pgbouncer SET LOCAL, idle timeout 5–15 минут",
    headline: "ТРИ РЫЧАГА ПРОТИВ BLOAT",
    sub: "переписывай онлайн, скоупи настройки, убивай idle",
    l1t: "pg_repack онлайн",
    l1d: "теневая копия, короткий swap",
    l1c: "цена: временно 2x disk",
    l2t: "pgbouncer: SET LOCAL",
    l2d: "обычный SET утекает",
    l2c: "LOCAL кончается с txn",
    l3t: "idle timeout 5–15 мин",
    l3d: "убивает забытые txn",
    l3c: "страховка, а не лечение",
    foot: "гоняй pg_repack ночью по топу раздутых таблиц",
    diskU: "disk",
    minU: "мин",
    notSet: "не SET",
    leverNote: "каждый рычаг закрывает свой источник пина",
    caption:
      "pg_repack переписывает раздутые таблицы онлайн с короткой блокировкой только на swap ценой временного 2x disk. В pgbouncer transaction mode используй SET LOCAL — обычный SET утекает между pooled-клиентами. А idle_in_transaction_session_timeout 5–15 минут убивает забытые открытые транзакции до того, как они закрепят xmin.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmvcc-dl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="110" width="234" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="157" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.l1t}</text>
    <text x="157" y="170" text-anchor="middle" font-size="11" fill="var(--muted)">{t.l1d}</text>
    <text x="157" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.l1c}</text>
    <text x="157" y="244" text-anchor="middle" font-size="20" fill="var(--accent)">2x</text>
    <text x="157" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.diskU}</text>

    <rect x="283" y="110" width="234" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.l2t}</text>
    <text x="400" y="170" text-anchor="middle" font-size="11" fill="var(--muted)">{t.l2d}</text>
    <text x="400" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.l2c}</text>
    <text x="400" y="244" text-anchor="middle" font-size="15" fill="var(--accent)">SET LOCAL</text>
    <text x="400" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.notSet}</text>

    <rect x="526" y="110" width="234" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="643" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.l3t}</text>
    <text x="643" y="170" text-anchor="middle" font-size="11" fill="var(--muted)">{t.l3d}</text>
    <text x="643" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.l3c}</text>
    <text x="643" y="244" text-anchor="middle" font-size="20" fill="var(--accent)">5–15</text>
    <text x="643" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.minU}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leverNote}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
