---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The trace is the call stack frozen at the throw: divide, getAge, loadUser, main, one line per frame, top first",
    headline: "THE TRACE IS THE STACK, FROZEN",
    sub: "one frame → one line, printed top frame first",
    line1: "line 1",
    line2: "line 2",
    line3: "line 3",
    line4: "line 4",
    box1: "divide · app.ts:2",
    box2: "getAge · app.ts:7",
    box3: "loadUser · app.ts:11",
    box4: "main · app.ts:15",
    tagTop: "← throw site",
    tagMid1: "← caller of divide",
    tagMid2: "← caller of getAge",
    tagBottom: "← program entry",
    foot1: "one frame → one trace line, in the same order",
    foot2: "read downward: throw site → callers → entry",
    caption:
      "The stack trace is the call stack frozen at the throw: divide, getAge, loadUser, main — one line per frame, top frame first. The top line is the throw site, the bottom line is the program entry.",
  },
  ru: {
    svgTitle: "Трассировка — это стек вызовов, замороженный при выбросе: divide, getAge, loadUser, main, по одной строке на кадр, верхним вперёд",
    headline: "ТРАССИРОВКА — ЗАМОРОЖЕННЫЙ СТЕК",
    sub: "один кадр → одна строка, верхним кадром вперёд",
    line1: "строка 1",
    line2: "строка 2",
    line3: "строка 3",
    line4: "строка 4",
    box1: "divide · app.ts:2",
    box2: "getAge · app.ts:7",
    box3: "loadUser · app.ts:11",
    box4: "main · app.ts:15",
    tagTop: "← место выброса",
    tagMid1: "← вызвала divide",
    tagMid2: "← вызвала getAge",
    tagBottom: "← точка входа",
    foot1: "один кадр → одна строка трассировки, в том же порядке",
    foot2: "читай вниз: выброс → вызывающие → вход",
    caption:
      "Трассировка стека — это стек вызовов, замороженный при выбросе: divide, getAge, loadUser, main — по одной строке на кадр, верхним кадром вперёд. Верхняя строка — место выброса, нижняя — точка входа программы.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="178" y="121" text-anchor="end" font-size="11" fill="var(--muted)">{t.line1}</text>
    <rect x="190" y="92" width="320" height="46" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="350" y="121" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box1}</text>
    <text x="522" y="121" text-anchor="start" font-size="11" fill="var(--accent)">{t.tagTop}</text>

    <text x="178" y="175" text-anchor="end" font-size="11" fill="var(--muted)">{t.line2}</text>
    <rect x="190" y="146" width="320" height="46" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="350" y="175" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box2}</text>
    <text x="522" y="175" text-anchor="start" font-size="11" fill="var(--muted)">{t.tagMid1}</text>

    <text x="178" y="229" text-anchor="end" font-size="11" fill="var(--muted)">{t.line3}</text>
    <rect x="190" y="200" width="320" height="46" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="350" y="229" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box3}</text>
    <text x="522" y="229" text-anchor="start" font-size="11" fill="var(--muted)">{t.tagMid2}</text>

    <text x="178" y="283" text-anchor="end" font-size="11" fill="var(--muted)">{t.line4}</text>
    <rect x="190" y="254" width="320" height="46" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="350" y="283" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box4}</text>
    <text x="522" y="283" text-anchor="start" font-size="11" fill="var(--muted)">{t.tagBottom}</text>

    <text x="400" y="338" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
