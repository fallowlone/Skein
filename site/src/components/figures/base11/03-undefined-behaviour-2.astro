---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Reading index 3 of a 3-element array prices = [10, 20, 30]: valid indices are 0, 1, 2, and cell 3 holds leftover garbage 48291.",
    headline: "INDEX 3 OF A 3-ELEMENT ARRAY",
    sub: "valid indices 0, 1, 2 — index 3 is past the end",
    cells: [
      { idx: "index 0", val: "10" },
      { idx: "index 1", val: "20" },
      { idx: "index 2", val: "30" },
      { idx: "index 3 · past end", val: "48291" },
    ],
    garbage: "garbage",
    bracket: "array: 3 cells",
    outcome: "no check — reads 48291 as a price",
    foot1: "no exception · no trace · program continues",
    foot2: "silent: shipped, corrupting data weeks later",
    caption:
      "prices = [10, 20, 30] has valid indices 0, 1, 2. With no bounds check the machine reads cell [3] anyway and gets leftover garbage 48291 — no exception, no trace, silent corruption.",
  },
  ru: {
    svgTitle: "Чтение индекса 3 у массива из 3 элементов prices = [10, 20, 30]: допустимые индексы — 0, 1, 2, а ячейка 3 хранит остаточный мусор 48291.",
    headline: "ИНДЕКС 3 ПРИ ДЛИНЕ 3",
    sub: "допустимы 0, 1, 2 — индекс 3 за концом",
    cells: [
      { idx: "индекс 0", val: "10" },
      { idx: "индекс 1", val: "20" },
      { idx: "индекс 2", val: "30" },
      { idx: "индекс 3 · за концом", val: "48291" },
    ],
    garbage: "мусор",
    bracket: "массив: 3 ячейки",
    outcome: "без проверки — читает 48291 как цену",
    foot1: "ни исключения, ни трассировки — идёт дальше",
    foot2: "молча: отгружено, портит данные неделями",
    caption:
      "У prices = [10, 20, 30] допустимые индексы — 0, 1, 2. Без проверки границ машина всё равно читает ячейку [3] и получает остаточный мусор 48291 — никакого исключения, никакой трассировки, молчаливая порча.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b11-3-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.cells.map((c, i) => (
      <g>
        <text x={205 + i * 130} y="110" text-anchor="middle" font-size="10" fill="var(--muted)">{c.idx}</text>
        <rect
          x={140 + i * 130}
          y="120"
          width="130"
          height="70"
          fill="var(--card)"
          stroke={i < 3 ? "var(--accent)" : "var(--muted)"}
          stroke-width="2"
          stroke-dasharray={i < 3 ? undefined : "7 5"}
        />
        <text x={205 + i * 130} y={i < 3 ? "162" : "152"} text-anchor="middle" font-size="16" fill="var(--ink)">{c.val}</text>
      </g>
    ))}
    <text x="610" y="178" text-anchor="middle" font-size="11" fill="var(--muted)">{t.garbage}</text>

    <line x1="140" y1="210" x2="530" y2="210" stroke="var(--muted)" stroke-width="1.6" />
    <line x1="140" y1="204" x2="140" y2="210" stroke="var(--muted)" stroke-width="1.6" />
    <line x1="530" y1="204" x2="530" y2="210" stroke="var(--muted)" stroke-width="1.6" />
    <text x="335" y="230" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bracket}</text>

    <line x1="610" y1="190" x2="610" y2="236" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-3-2)" />
    <rect x="430" y="236" width="270" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="565" y="261" text-anchor="middle" font-size="11" fill="var(--ink)">{t.outcome}</text>

    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
