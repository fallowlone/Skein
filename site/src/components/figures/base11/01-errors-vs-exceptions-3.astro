---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Unwinding pops parseNumber and loadConfig until main catches and resumes",
    headline: "UNWIND TO THE HANDLER",
    sub: "pop frame by frame until a catch is found",
    unwindLabel: "unwind",
    frame1Title: "parseNumber: throw",
    frame1Body: "no handler — pop",
    frame2Title: "loadConfig",
    frame2Body: "no handler — pop",
    frame3Title: "main: catch found",
    frame3Body: "handler runs · resume",
    outTitle: "HANDLER FOUND — RESUME",
    outL1: "normal flow resumes",
    outL2: "no crash",
    foot1: "2 frames popped · 1 handler found",
    foot2: "the handler decides: crash vs continue",
    caption:
      "The runtime unwinds the stack frame by frame: parseNumber and loadConfig have no handler and are popped; main catches, the handler runs, and normal flow resumes. No handler anywhere means a crash.",
  },
  ru: {
    svgTitle: "Размотка снимает parseNumber и loadConfig, пока main не перехватит",
    headline: "РАЗМОТКА ДО ОБРАБОТЧИКА",
    sub: "кадр за кадром до первого catch",
    unwindLabel: "размотка",
    frame1Title: "parseNumber: throw",
    frame1Body: "без обработчика: снять",
    frame2Title: "loadConfig",
    frame2Body: "без обработчика: снять",
    frame3Title: "main: catch найден",
    frame3Body: "обработчик: продолжить",
    outTitle: "ОБРАБОТЧИК НАЙДЕН",
    outL1: "поток возобновляется",
    outL2: "завершения нет",
    foot1: "2 кадра снято · 1 обработчик найден",
    foot2: "обработчик решает: продолжение или завершение",
    caption:
      "Рантайм разматывает стек кадр за кадром: у parseNumber и loadConfig обработчика нет, и они снимаются; main перехватывает, обработчик выполняется, и поток возобновляется. Нет обработчика нигде — аварийное завершение.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b11-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="108" y="205" text-anchor="end" font-size="11" fill="var(--muted)">{t.unwindLabel}</text>
    <line x1="120" y1="110" x2="120" y2="295" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-3)" />

    <rect x="150" y="100" width="240" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="270" y="123" text-anchor="middle" font-size="13" fill="var(--ink)">{t.frame1Title}</text>
    <text x="270" y="144" text-anchor="middle" font-size="11" fill="var(--muted)">{t.frame1Body}</text>

    <rect x="150" y="172" width="240" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="270" y="195" text-anchor="middle" font-size="13" fill="var(--ink)">{t.frame2Title}</text>
    <text x="270" y="216" text-anchor="middle" font-size="11" fill="var(--muted)">{t.frame2Body}</text>

    <rect x="150" y="244" width="240" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="270" y="267" text-anchor="middle" font-size="13" fill="var(--ink)">{t.frame3Title}</text>
    <text x="270" y="288" text-anchor="middle" font-size="11" fill="var(--ink)">{t.frame3Body}</text>

    <line x1="390" y1="272" x2="450" y2="240" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-3)" />

    <rect x="450" y="150" width="280" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="185" text-anchor="middle" font-size="13" fill="var(--ink)">{t.outTitle}</text>
    <text x="590" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.outL1}</text>
    <text x="590" y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{t.outL2}</text>

    <text x="400" y="335" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
