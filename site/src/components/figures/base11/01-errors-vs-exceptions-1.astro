---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Error is the condition, exception is the mechanism: fact versus process",
    headline: "CONDITION ≠ MECHANISM",
    sub: "error is the fact · exception is the response",
    tagLeft: "fact",
    tagRight: "process",
    leftTitle: "ERROR — the condition",
    leftL1: "file missing · divisor zero",
    leftL2: "fact about the state",
    leftL3: "no defined next step",
    leftL4: "nothing happens yet",
    rightTitle: "EXCEPTION — the response",
    rightL1: "runtime takes over",
    rightL2: "stop flow · find handler",
    rightL3: "throw starts it",
    rightL4: "one possible response",
    foot1: "same condition, different response",
    foot2: "the error never forces the mechanism",
    caption:
      "An error is the condition — a missing file or a zero divisor, a fact about the state; an exception is the runtime response — stop the flow and search for a handler. The error never forces the mechanism.",
  },
  ru: {
    svgTitle: "Ошибка — условие, исключение — механизм: факт против процесса",
    headline: "УСЛОВИЕ ≠ МЕХАНИЗМ",
    sub: "ошибка — факт · исключение — ответ",
    tagLeft: "факт",
    tagRight: "процесс",
    leftTitle: "ОШИБКА — условие",
    leftL1: "файл отсутствует",
    leftL2: "делитель равен нулю",
    leftL3: "факт о состоянии",
    leftL4: "ещё не действие",
    rightTitle: "ИСКЛЮЧЕНИЕ — ответ",
    rightL1: "рантайм берёт управление",
    rightL2: "остановить поток",
    rightL3: "найти обработчик",
    rightL4: "один из ответов",
    foot1: "меняются независимо",
    foot2: "ошибка не вынуждает механизм",
    caption:
      "Ошибка — это условие: отсутствующий файл или нулевой делитель, факт о состоянии; исключение — ответ рантайма: остановить поток и искать обработчик. Ошибка не вынуждает механизм.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="215" y="90" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <text x="585" y="90" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>

    <rect x="60" y="100" width="310" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="215" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    <text x="215" y="156" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftL1}</text>
    <text x="215" y="180" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftL2}</text>
    <text x="215" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftL3}</text>
    <text x="215" y="228" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftL4}</text>

    <text x="400" y="196" text-anchor="middle" font-size="30" fill="var(--accent)">≠</text>

    <rect x="430" y="100" width="310" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="585" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    <text x="585" y="156" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightL1}</text>
    <text x="585" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightL2}</text>
    <text x="585" y="204" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightL3}</text>
    <text x="585" y="228" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightL4}</text>

    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
