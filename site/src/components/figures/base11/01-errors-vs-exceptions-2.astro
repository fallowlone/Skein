---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Throw stops normal flow: the next line does not run",
    headline: "THROW STOPS THE FLOW",
    sub: "the next line does not run",
    box1Title: "instruction N",
    box1Body: "runs normally",
    arrow1: "throw",
    box2Title: "throw raised",
    box2Body: "flow stops at once",
    arrow2: "skipped",
    box3Title: "next line",
    box3Body: "does NOT run",
    foot1: "control passes to the exception mechanism",
    foot2: "no ordinary instruction runs until a handler is found",
    caption:
      "Raising an exception stops normal control flow at once: the next line of the function does not run, and control passes to the exception mechanism until a handler is found.",
  },
  ru: {
    svgTitle: "Выброс останавливает нормальный поток: следующая строка не выполняется",
    headline: "ВЫБРОС ОСТАНАВЛИВАЕТ ПОТОК",
    sub: "следующая строка не выполняется",
    box1Title: "инструкция N",
    box1Body: "выполняется",
    arrow1: "throw",
    box2Title: "возбуждение",
    box2Body: "поток остановлен",
    arrow2: "пропуск",
    box3Title: "следующая строка",
    box3Body: "НЕ выполняется",
    foot1: "управление — у механизма исключений",
    foot2: "ни одна инструкция не выполняется",
    caption:
      "Возбуждение исключения сразу останавливает нормальный поток управления: следующая строка функции не выполняется, а управление переходит к механизму исключений, пока не найдётся обработчик.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b11-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="140" width="200" height="90" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="140" y="175" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box1Title}</text>
    <text x="140" y="200" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box1Body}</text>

    <text x="270" y="172" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow1}</text>
    <line x1="240" y1="185" x2="300" y2="185" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-2)" />

    <rect x="300" y="140" width="200" height="90" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="175" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box2Title}</text>
    <text x="400" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Body}</text>

    <text x="530" y="172" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow2}</text>
    <line x1="500" y1="185" x2="560" y2="185" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-2)" />

    <rect x="560" y="140" width="200" height="90" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="660" y="175" text-anchor="middle" font-size="13" fill="var(--muted)">{t.box3Title}</text>
    <text x="660" y="200" text-anchor="middle" font-size="11" fill="var(--accent)">{t.box3Body}</text>

    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
