---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Integer overflow: 255 + 1 is 256, which needs a 9th bit; the 8-bit store keeps only the low bits and the stored value becomes 0.",
    headline: "255 + 1 NEEDS A 9TH BIT",
    sub: "8 bits hold 0 through 255 — the high bit is lost",
    row1: "255 =",
    plus: "+ 1",
    row2: "256 =",
    lost: "9th bit: lost",
    stored: "stored value: 0",
    foot1: "true result 256 needs 9 bits — there is no 9th bit",
    foot2: "in UB languages the standard guarantees nothing",
    caption:
      "Adding 1 to 255 gives the true result 256, which needs a 9th bit. With only 8 bits the high bit is lost and the stored value becomes 0 — in languages where signed overflow is undefined behaviour, the standard guarantees nothing.",
  },
  ru: {
    svgTitle: "Переполнение целого: 255 + 1 — это 256, которому нужен 9-й бит; 8-битное хранилище сохраняет только младшие биты, и сохранённое значение становится 0.",
    headline: "255 + 1: НУЖЕН 9-Й БИТ",
    sub: "8 битов хранят 0–255 — старший бит теряется",
    row1: "255 =",
    plus: "+ 1",
    row2: "256 =",
    lost: "9-й бит: потерян",
    stored: "сохранено: 0",
    foot1: "истинному результату 256 нужно 9 битов — 9-го бита нет",
    foot2: "в UB-языках стандарт не гарантирует ничего",
    caption:
      "Прибавление 1 к 255 даёт истинный результат 256, которому нужен 9-й бит. При всего 8 битах старший бит теряется, и сохранённое значение становится 0 — в языках, где переполнение знакового числа является неопределённым поведением, стандарт не гарантирует ничего.",
  },
};

const t = dict[lang];

const BITS = [0, 1, 2, 3, 4, 5, 6, 7];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b11-3-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="218" y="135" text-anchor="end" font-size="13" fill="var(--ink)">{t.row1}</text>
    {BITS.map((i) => (
      <g>
        <rect x={230 + i * 40} y="110" width="40" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={250 + i * 40} y="136" text-anchor="middle" font-size="14" fill="var(--ink)">1</text>
      </g>
    ))}
    <text x="562" y="135" font-size="13" fill="var(--ink)">{t.plus}</text>

    <text x="250" y="190" text-anchor="middle" font-size="11" fill="var(--muted)">{t.lost}</text>
    <line x1="400" y1="150" x2="400" y2="196" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-3-3)" />

    <text x="218" y="225" text-anchor="end" font-size="13" fill="var(--ink)">{t.row2}</text>
    <rect x="230" y="200" width="40" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="250" y="226" text-anchor="middle" font-size="14" fill="var(--muted)">1</text>
    {BITS.map((i) => (
      <g>
        <rect x={280 + i * 40} y="200" width="40" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={300 + i * 40} y="226" text-anchor="middle" font-size="14" fill="var(--ink)">0</text>
      </g>
    ))}

    <line x1="400" y1="240" x2="400" y2="266" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-3-3)" />
    <rect x="250" y="270" width="300" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="295" text-anchor="middle" font-size="13" fill="var(--ink)">{t.stored}</text>

    <text x="400" y="335" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
