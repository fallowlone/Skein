---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Determinism: the same instruction on the same state always gives the same result, so a bug repeats every run and sits still waiting to be found",
    headline: "SAME STATE, SAME RESULT — EVERY TIME",
    sub: "determinism: no luck in it",
    topBox: "same instruction + same state",
    run1a: "run 1: same input",
    run1b: "same wrong result",
    run2a: "run 2: same input",
    run2b: "same wrong result",
    foot1: "the bug is not random — it repeats every run",
    foot2: "it sits still, waiting to be found",
    caption:
      "Determinism: the same instruction on the same state always gives the same result, so a bug is not random — it repeats every run and sits still, waiting to be found.",
  },
  ru: {
    svgTitle: "Детерминизм: та же инструкция при том же состоянии всегда даёт тот же результат, поэтому баг повторяется каждый запуск и сидит неподвижно, ожидая, чтобы его нашли",
    headline: "ОДНО СОСТОЯНИЕ — ОДИН РЕЗУЛЬТАТ",
    sub: "детерминизм: в нём нет везения",
    topBox: "та же инструкция + то же состояние",
    run1a: "запуск 1: тот же вход",
    run1b: "тот же неверный результат",
    run2a: "запуск 2: тот же вход",
    run2b: "тот же неверный результат",
    foot1: "баг не случаен — он повторяется каждый запуск",
    foot2: "он сидит неподвижно, ожидая, чтобы его нашли",
    caption:
      "Детерминизм: та же инструкция при том же состоянии всегда даёт тот же результат, поэтому баг не случаен — он повторяется каждый запуск и сидит неподвижно, ожидая, чтобы его нашли.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b11-04-1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="230" y="95" width="340" height="46" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="123" text-anchor="middle" font-size="13" fill="var(--ink)">{t.topBox}</text>

    <line x1="240" y1="141" x2="240" y2="185" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-04-1)" />
    <line x1="560" y1="141" x2="560" y2="185" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-04-1)" />

    <rect x="90" y="185" width="300" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="240" y="213" text-anchor="middle" font-size="11" fill="var(--ink)">{t.run1a}</text>
    <text x="240" y="235" text-anchor="middle" font-size="11" fill="var(--ink)">{t.run1b}</text>

    <text x="400" y="227" text-anchor="middle" font-size="16" fill="var(--accent)">=</text>

    <rect x="410" y="185" width="300" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="560" y="213" text-anchor="middle" font-size="11" fill="var(--ink)">{t.run2a}</text>
    <text x="560" y="235" text-anchor="middle" font-size="11" fill="var(--ink)">{t.run2b}</text>

    <text x="400" y="300" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="328" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
