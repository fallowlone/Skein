---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A hypothesis is a specific testable claim: not 'something is wrong with the loop' but 'the loop stops one early so prices[3] is never added' — if it cannot be wrong, it cannot help",
    headline: "A HYPOTHESIS MUST BE TESTABLE",
    sub: "a specific claim about which step diverged",
    tagVague: "not a hypothesis",
    vague1: "“something is wrong",
    vague2: "with the loop”",
    vague3: "predicts nothing",
    tagSharp: "hypothesis",
    sharp1: "the loop stops one early,",
    sharp2: "prices[3] never added",
    sharp3: "predicts: runs 3x, not 4x",
    check1: "if it cannot be wrong,",
    check2: "it cannot help you",
    foot1: "a good hypothesis names a step, predicts an observation",
    foot2: "confirmed or refuted by looking",
    caption:
      "A hypothesis is a specific, testable claim about which step diverged: not “something is wrong with the loop” but “the loop stops one early so prices[3] is never added” — if it cannot be wrong, it cannot help you.",
  },
  ru: {
    svgTitle: "Гипотеза — это конкретное проверяемое утверждение: не «что-то не так с циклом», а «цикл останавливается рано, поэтому prices[3] не прибавляется» — если она не может быть неправильной, она не может помочь",
    headline: "ГИПОТЕЗА ДОЛЖНА БЫТЬ ПРОВЕРЯЕМОЙ",
    sub: "конкретное утверждение: какой шаг отклонился",
    tagVague: "не гипотеза",
    vague1: "«что-то не так с циклом»",
    vague2: "слишком расплывчата",
    vague3: "ничего не предсказывает",
    tagSharp: "гипотеза",
    sharp1: "цикл останавливается рано,",
    sharp2: "prices[3] не прибавляется",
    sharp3: "предсказание: 3 раза, не 4",
    check1: "если не может быть неправильной —",
    check2: "не может тебе помочь",
    foot1: "хорошая гипотеза: шаг + предсказание",
    foot2: "подтверди или опровергни, посмотрев",
    caption:
      "Гипотеза — это конкретное проверяемое утверждение о том, какой шаг отклонился: не «что-то не так с циклом», а «цикл останавливается рано, поэтому prices[3] не прибавляется» — если она не может быть неправильной, она не может помочь.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b11-04-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="220" y="88" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagVague}</text>
    <rect x="60" y="100" width="320" height="116" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="220" y="132" text-anchor="middle" font-size="12" fill="var(--muted)">{t.vague1}</text>
    <text x="220" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.vague2}</text>
    <text x="220" y="184" text-anchor="middle" font-size="11" fill="var(--muted)">{t.vague3}</text>

    <text x="580" y="88" text-anchor="middle" font-size="11" fill="var(--accent)">{t.tagSharp}</text>
    <rect x="420" y="100" width="320" height="116" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="580" y="132" text-anchor="middle" font-size="11" fill="var(--ink)">{t.sharp1}</text>
    <text x="580" y="156" text-anchor="middle" font-size="11" fill="var(--ink)">{t.sharp2}</text>
    <text x="580" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.sharp3}</text>

    <line x1="560" y1="216" x2="560" y2="252" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-04-2)" />

    <rect x="230" y="252" width="340" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="274" text-anchor="middle" font-size="11" fill="var(--ink)">{t.check1}</text>
    <text x="400" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.check2}</text>

    <text x="400" y="342" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="366" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
