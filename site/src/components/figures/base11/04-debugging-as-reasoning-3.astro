---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Test a hypothesis with three moves — narrow the range, read the trace, check state — and only then fix the known bug",
    headline: "THREE MOVES, THEN FIX THE KNOWN BUG",
    sub: "test the hypothesis — change no line until proven",
    move1a: "narrow the range",
    move1b: "check the midpoint",
    move1c: "discard cleared half",
    move2a: "read the trace",
    move2b: "top line:",
    move2c: "throw site",
    move3a: "check state",
    move3b: "inspect the value",
    move3c: "line 20: i = ?",
    fixBox: "only then: fix the known bug",
    foot1: "no line changes until reasoning",
    foot2: "pins the exact guilty step",
    caption:
      "Test a hypothesis with three moves — narrow the range, read the trace, check state — and only then fix the known bug: no line changes until reasoning pins the exact guilty step.",
  },
  ru: {
    svgTitle: "Проверь гипотезу тремя приёмами — сузь диапазон, прочитай трассировку, проверь состояние — и только затем чини известный баг",
    headline: "ТРИ ПРИЁМА — ПОТОМ ЧИНИ ИЗВЕСТНЫЙ БАГ",
    sub: "проверь гипотезу — не меняй строк до доказательства",
    move1a: "сузить диапазон",
    move1b: "проверь середину",
    move1c: "отбрось половину",
    move2a: "прочитать трассировку",
    move2b: "верхняя строка:",
    move2c: "место выброса",
    move3a: "проверить состояние",
    move3b: "осмотри значение",
    move3c: "строка 20: i = ?",
    fixBox: "только затем: чини известный баг",
    foot1: "ни одна строка не меняется,",
    foot2: "пока виновный шаг не найден",
    caption:
      "Проверь гипотезу тремя приёмами — сузь диапазон, прочитай трассировку, проверь состояние — и только затем чини известный баг: ни одна строка не меняется, пока виновный шаг не найден.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b11-04-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="110" width="220" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="150" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.move1a}</text>
    <text x="150" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.move1b}</text>
    <text x="150" y="186" text-anchor="middle" font-size="11" fill="var(--muted)">{t.move1c}</text>

    <line x1="260" y1="160" x2="290" y2="160" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-04-3)" />

    <rect x="290" y="110" width="220" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.move2a}</text>
    <text x="400" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.move2b}</text>
    <text x="400" y="186" text-anchor="middle" font-size="11" fill="var(--muted)">{t.move2c}</text>

    <line x1="510" y1="160" x2="540" y2="160" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-04-3)" />

    <rect x="540" y="110" width="220" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="650" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.move3a}</text>
    <text x="650" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.move3b}</text>
    <text x="650" y="186" text-anchor="middle" font-size="11" fill="var(--muted)">{t.move3c}</text>

    <line x1="400" y1="210" x2="400" y2="250" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-04-3)" />

    <rect x="230" y="250" width="340" height="48" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="279" text-anchor="middle" font-size="13" fill="var(--ink)">{t.fixBox}</text>

    <text x="400" y="335" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="359" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
