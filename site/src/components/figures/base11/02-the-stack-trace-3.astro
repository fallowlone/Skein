---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The snapshot is taken at the throw while four frames are live; unwinding then pops every frame and the crash finds an empty stack",
    headline: "SNAPSHOT AT THE THROW, NOT THE CRASH",
    sub: "unwinding destroys the stack — capture it first",
    colLeft: "at throw: 4 frames live",
    box1: "divide · app.ts:2",
    box2: "getAge · app.ts:7",
    box3: "loadUser · app.ts:11",
    box4: "main · app.ts:15",
    midTop: "unwinding pops every frame",
    midBottom: "no handler: 4 popped",
    colRight: "at crash: stack empty",
    emptyLine1: "empty — nothing to read",
    emptyLine2: "trace already captured",
    foot1: "snapshot taken at the throw, while frames exist",
    foot2: "printed after the unwind, when the stack is empty",
    caption:
      "The trace is captured at the throw, while all four frames are still live — because unwinding then pops every frame, and by the crash the stack is empty with nothing left to describe.",
  },
  ru: {
    svgTitle: "Снимок снимается при выбросе, пока живут четыре кадра; разматывание затем снимает каждый кадр, и при аварии стек пуст",
    headline: "СНИМОК ПРИ ВЫБРОСЕ, А НЕ ПРИ АВАРИИ",
    sub: "разматывание разрушает стек — сними его раньше",
    colLeft: "при выбросе: 4 кадра",
    box1: "divide · app.ts:2",
    box2: "getAge · app.ts:7",
    box3: "loadUser · app.ts:11",
    box4: "main · app.ts:15",
    midTop: "разматывание снимает кадры",
    midBottom: "обработчика нет: снято 4",
    colRight: "при аварии: стек пуст",
    emptyLine1: "пусто — описывать нечего",
    emptyLine2: "трассировка уже снята",
    foot1: "снимок снят при выбросе, пока кадры на месте",
    foot2: "напечатан после размотки, когда стек пуст",
    caption:
      "Трассировка фиксируется при выбросе, пока все четыре кадра ещё на месте, — потому что разматывание затем снимает каждый кадр, и к аварии стек пуст: описывать нечего.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b11-2-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="160" y="100" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colLeft}</text>
    <rect x="60" y="116" width="200" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="160" y="143" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1}</text>
    <rect x="60" y="166" width="200" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="160" y="193" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2}</text>
    <rect x="60" y="216" width="200" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="160" y="243" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3}</text>
    <rect x="60" y="266" width="200" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="160" y="293" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box4}</text>

    <text x="400" y="190" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midTop}</text>
    <line x1="280" y1="213" x2="516" y2="213" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-2-3)" />
    <text x="400" y="238" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midBottom}</text>

    <text x="640" y="100" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colRight}</text>
    <rect x="540" y="116" width="200" height="194" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="7 5" />
    <text x="640" y="205" text-anchor="middle" font-size="12" fill="var(--muted)">{t.emptyLine1}</text>
    <text x="640" y="229" text-anchor="middle" font-size="12" fill="var(--muted)">{t.emptyLine2}</text>

    <text x="400" y="348" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
