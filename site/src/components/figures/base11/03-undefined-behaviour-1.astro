---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Defined error is loud: the check fails and an exception is raised. Undefined behaviour is silent: no check, no error, garbage travels on.",
    headline: "DEFINED IS LOUD, UB IS SILENT",
    sub: "same bug, two fates",
    bug: "bug: index 3 of len 3",
    leftTitle: "defined error",
    leftL1: "check 3 < 3 fails",
    leftL2: "raise · trace printed",
    rightTitle: "undefined behaviour",
    rightL1: "no check — reads [3]",
    rightL2: "gets 48291 · silent",
    foot1: "loud: exception, trace — found on the first run",
    foot2: "silent: garbage travels on as if correct",
    caption:
      "The same out-of-range index is a defined error when a check fails and raises, and undefined behaviour when nothing checks: no error, and the garbage value 48291 travels on as if correct.",
  },
  ru: {
    svgTitle: "Определённая ошибка громкая: проверка не проходит и возбуждается исключение. Неопределённое поведение молчаливо: ни проверки, ни ошибки, мусор идёт дальше.",
    headline: "ОПРЕДЕЛЁННОЕ — ГРОМКО, UB — МОЛЧА",
    sub: "тот же баг · две судьбы",
    bug: "баг: индекс 3 из длины 3",
    leftTitle: "определённая ошибка",
    leftL1: "проверка 3 < 3 не проходит",
    leftL2: "возбуждение · трассировка",
    rightTitle: "неопределённое поведение",
    rightL1: "без проверки — читает [3]",
    rightL2: "получает 48291 · молча",
    foot1: "громко: исключение, трассировка — находят сразу",
    foot2: "молча: мусор идёт дальше как правильный",
    caption:
      "Тот же индекс вне диапазона — определённая ошибка, когда проверка не проходит и возбуждает, и неопределённое поведение, когда ничто не проверяет: никакой ошибки, и мусорное значение 48291 идёт дальше как правильное.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b11-3-1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="240" y="80" width="320" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="106" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bug}</text>

    <line x1="320" y1="120" x2="210" y2="170" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-3-1)" />
    <line x1="480" y1="120" x2="590" y2="170" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-3-1)" />

    <rect x="60" y="170" width="300" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="198" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    <text x="210" y="224" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftL1}</text>
    <text x="210" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftL2}</text>

    <rect x="440" y="170" width="300" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="590" y="198" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    <text x="590" y="224" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightL1}</text>
    <text x="590" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightL2}</text>

    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
