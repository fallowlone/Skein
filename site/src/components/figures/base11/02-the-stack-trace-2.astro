---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Read the trace top-down: the top line answers what threw, the lines below answer through what chain of calls",
    headline: "READ TOP-DOWN: TWO ANSWERS",
    sub: "the top line threw · the lines below led there",
    panelTitle: "the trace, top first",
    readTag: "read",
    msgLine: "Error: divide by zero",
    trace1: "at divide (app.ts:2)",
    trace2: "at getAge (app.ts:7)",
    trace3: "at loadUser (app.ts:11)",
    trace4: "at main (app.ts:15)",
    q1: "what threw?",
    a1: "→ top line: divide, app.ts:2",
    q2: "what chain?",
    a2: "→ lines below, down to main",
    foot1: "read top-down: first line threw, last line entered",
    foot2: "the throw site is line 1 — never start at main",
    caption:
      "Read the trace top-down: the top line answers what threw (divide at app.ts:2), and each line below answers through what chain of calls the program got there, down to main.",
  },
  ru: {
    svgTitle: "Читай трассировку сверху вниз: верхняя строка отвечает, что выбросило, строки ниже — через какую цепочку вызовов",
    headline: "ЧИТАЙ СВЕРХУ ВНИЗ: ДВА ОТВЕТА",
    sub: "верхняя строка выбросила · строки ниже привели туда",
    panelTitle: "трассировка, верхним вперёд",
    readTag: "читай",
    msgLine: "Error: divide by zero",
    trace1: "at divide (app.ts:2)",
    trace2: "at getAge (app.ts:7)",
    trace3: "at loadUser (app.ts:11)",
    trace4: "at main (app.ts:15)",
    q1: "что выбросило?",
    a1: "→ верхняя: divide, app.ts:2",
    q2: "какая цепочка?",
    a2: "→ строки ниже, вниз до main",
    foot1: "читай сверху вниз: первая выбросила, последняя вошла",
    foot2: "место выброса — строка 1, не начинай с main",
    caption:
      "Читай трассировку сверху вниз: верхняя строка отвечает, что выбросило (divide в app.ts:2), а каждая строка ниже — через какую цепочку вызовов программа туда дошла, вниз до main.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b11-2-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
      <marker id="arr-b11-2-2m" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--muted)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="90" width="330" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="215" y="114" text-anchor="middle" font-size="12" fill="var(--muted)">{t.panelTitle}</text>
    <text x="80" y="144" text-anchor="start" font-size="12" fill="var(--accent)">{t.msgLine}</text>
    <text x="80" y="176" text-anchor="start" font-size="12" fill="var(--ink)">{t.trace1}</text>
    <text x="80" y="208" text-anchor="start" font-size="12" fill="var(--ink)">{t.trace2}</text>
    <text x="80" y="240" text-anchor="start" font-size="12" fill="var(--ink)">{t.trace3}</text>
    <text x="80" y="272" text-anchor="start" font-size="12" fill="var(--ink)">{t.trace4}</text>
    <text x="370" y="132" text-anchor="middle" font-size="10" fill="var(--muted)">{t.readTag}</text>
    <line x1="370" y1="140" x2="370" y2="270" stroke="var(--muted)" stroke-width="1.6" marker-end="url(#arr-b11-2-2m)" />

    <line x1="390" y1="140" x2="446" y2="140" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-2-2)" />
    <rect x="450" y="96" width="290" height="88" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.q1}</text>
    <text x="595" y="152" text-anchor="middle" font-size="11" fill="var(--muted)">{t.a1}</text>

    <line x1="390" y1="248" x2="446" y2="248" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b11-2-2)" />
    <rect x="450" y="204" width="290" height="88" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="595" y="234" text-anchor="middle" font-size="12" fill="var(--ink)">{t.q2}</text>
    <text x="595" y="260" text-anchor="middle" font-size="11" fill="var(--muted)">{t.a2}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="354" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
