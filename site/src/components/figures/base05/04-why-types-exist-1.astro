---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One type mismatch leads to three outcomes",
    headline: "ONE MISMATCH → THREE OUTCOMES",
    sub: "wrong rule on stored bits · how far the value travels",
    origin: ["stored bits", "read with the wrong rule"],
    outcomes: [
      { title: "silent wrong output", detail: "garbage numbers · e.g. price as string → NaN" },
      { title: "crash", detail: "runtime halts with an error" },
      { title: "security vulnerability", detail: "C, C++: buffer overflow" },
    ],
    foot1: "all three share one origin: wrong type on stored bits",
    foot2: "the outcome depends on how far the misread value travels",
    caption:
      "Reading stored bits with the wrong type rule has one origin but three possible outcomes: silent wrong output such as NaN, a crash when the runtime halts with an error, or a security vulnerability such as a buffer overflow in C and C++. The outcome depends on how far the misread value travels before something detects the mismatch.",
  },
  ru: {
    svgTitle: "Одно несоответствие типов ведёт к трём исходам",
    headline: "ОДНО НЕСООТВЕТСТВИЕ → ТРИ ИСХОДА",
    sub: "неправильное правило для сохранённых битов · как далеко уйдёт значение",
    origin: ["сохранённые биты", "прочитаны по неверному правилу"],
    outcomes: [
      { title: "молчаливо неверный вывод", detail: "мусорные числа · напр. цена-строка → NaN" },
      { title: "аварийное завершение", detail: "среда выполнения останавливается с ошибкой" },
      { title: "уязвимость безопасности", detail: "C, C++: переполнение буфера" },
    ],
    foot1: "у всех трёх одно происхождение: неверный тип для сохранённых битов",
    foot2: "исход зависит от того, как далеко уйдёт неверно прочитанное значение",
    caption:
      "Чтение сохранённых битов по неверному правилу типа имеет одно происхождение, но три возможных исхода: молчаливо неверный вывод вроде NaN, аварийное завершение, когда среда выполнения останавливается с ошибкой, или уязвимость безопасности вроде переполнения буфера в C и C++. Исход зависит от того, как далеко неверно прочитанное значение уйдёт, прежде чем что-то обнаружит несоответствие.",
  },
};

const t = dict[lang];

const orgX = 30;
const orgY = 170;
const orgW = 220;
const orgH = 90;
const orgMidY = orgY + orgH / 2;
const cardX = 380;
const cardW = 390;
const cardH = 70;
const cardY = [100, 180, 260];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x={orgX} y={orgY} width={orgW} height={orgH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={orgX + orgW / 2} y={orgY + 38} text-anchor="middle" font-size="13" fill="var(--ink)">{t.origin[0]}</text>
    <text x={orgX + orgW / 2} y={orgY + 60} text-anchor="middle" font-size="13" fill="var(--accent)">{t.origin[1]}</text>

    {t.outcomes.map((o, i) => (
      <g>
        <line x1={orgX + orgW} y1={orgMidY} x2={cardX - 8} y2={cardY[i] + cardH / 2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${cardX - 10},${cardY[i] + cardH / 2 - 7} ${cardX - 10},${cardY[i] + cardH / 2 + 7} ${cardX},${cardY[i] + cardH / 2}`} fill="var(--accent)" />
        <rect x={cardX} y={cardY[i]} width={cardW} height={cardH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cardX + 16} y={cardY[i] + 28} font-size="13" fill="var(--ink)">{o.title}</text>
        <text x={cardX + 16} y={cardY[i] + 50} font-size="12" fill="var(--muted)">{o.detail}</text>
      </g>
    ))}

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="394" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
