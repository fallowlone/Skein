---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "typeof maps each primitive value to its type-name string",
    headline: "TYPEOF NAMES THE RULE",
    sub: "value in · type-name string out",
    colVal: "value",
    colRes: "typeof result",
    rows: [
      { val: "42", res: "\"number\"" },
      { val: "\"hello\"", res: "\"string\"" },
      { val: "true", res: "\"boolean\"" },
      { val: "null", res: "\"object\"" },
      { val: "undefined", res: "\"undefined\"" },
    ],
    quirk: "← quirk!",
    foot1: "typeof returns a string naming the interpretation rule",
    foot2: "test null with x === null — not typeof",
    caption:
      "typeof 42 gives \"number\", typeof \"hello\" gives \"string\", typeof true gives \"boolean\", typeof null gives \"object\" (historical quirk: an old bug frozen by backwards compatibility), typeof undefined gives \"undefined\".",
  },
  ru: {
    svgTitle: "typeof сопоставляет каждое примитивное значение строке с именем типа",
    headline: "TYPEOF НАЗЫВАЕТ ПРАВИЛО",
    sub: "значение на входе · строка с именем типа на выходе",
    colVal: "значение",
    colRes: "результат typeof",
    rows: [
      { val: "42", res: "\"number\"" },
      { val: "\"hello\"", res: "\"string\"" },
      { val: "true", res: "\"boolean\"" },
      { val: "null", res: "\"object\"" },
      { val: "undefined", res: "\"undefined\"" },
    ],
    quirk: "← особенность!",
    foot1: "typeof возвращает строку с именем правила интерпретации",
    foot2: "проверяй null через x === null — а не typeof",
    caption:
      "typeof 42 даёт \"number\", typeof \"hello\" даёт \"string\", typeof true даёт \"boolean\", typeof null даёт \"object\" (историческая особенность: старая ошибка, замороженная обратной совместимостью), typeof undefined даёт \"undefined\".",
  },
};

const t = dict[lang];

const rowY = (i: number) => 100 + i * 48;
const rowH = 36;
const valX = 110;
const valW = 170;
const resX = 430;
const resW = 260;
const cy = (i: number) => rowY(i) + rowH / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={valX + valW / 2} y="90" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colVal}</text>
    <text x={resX + resW / 2} y="90" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colRes}</text>

    {t.rows.map((r, i) => (
      <g>
        <rect x={valX} y={rowY(i)} width={valW} height={rowH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={valX + valW / 2} y={cy(i) + 5} text-anchor="middle" font-size="14" fill="var(--ink)">{r.val}</text>
        <line x1={valX + valW + 2} y1={cy(i)} x2={resX - 12} y2={cy(i)} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${resX - 12},${cy(i) - 6} ${resX - 12},${cy(i) + 6} ${resX},${cy(i)}`} fill="var(--accent)" />
        <rect x={resX} y={rowY(i)} width={resW} height={rowH} fill="var(--card)" stroke={i === 3 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 3 ? 3 : 2} />
        <text x={resX + resW / 2} y={cy(i) + 5} text-anchor="middle" font-size="14" fill="var(--ink)">{r.res}</text>
      </g>
    ))}
    <text x={resX + resW + 8} y={cy(3) + 4} font-size="11" font-weight="600" fill="var(--accent)">{t.quirk}</text>

    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
