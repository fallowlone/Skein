---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: 'Tracing price stored as the string 9.99 through five outcomes',
    headline: 'TRACE: price = "9.99"',
    sub: "one wrong type · silent, refused, or thrown",
    status: ["silent", "silent", "silent", "refused", "thrown"],
    results: ["= 9.89 · silent", "= 10.7892 · silent", '= "9.99 USD" · concat', "refused · compile time", "TypeError · run time"],
    foot1: "same origin: the wrong type on one value",
    foot2: "detected early, late, or never",
    caption:
      "Tracing one mistake — price stored as the string \"9.99\" instead of a number: JS silently coerces minus to 9.89 and times to 10.7892, plus concatenates to \"9.99 USD\", TypeScript refuses the assignment at compile time, and calling a method on null throws a TypeError at run time. One origin, detected early, late, or never.",
  },
  ru: {
    svgTitle: "Разбор: price, сохранённая как строка 9.99, через пять исходов",
    headline: 'РАЗБОР: price = "9.99"',
    sub: "один неверный тип · молча, отказ или бросок",
    status: ["молча", "молча", "молча", "отказ", "бросок"],
    results: ["= 9.89 · молча", "= 10.7892 · молча", '= "9.99 USD" · конкатенация', "отказ · компиляция", "TypeError · выполнение"],
    foot1: "одно происхождение: неверный тип у одного значения",
    foot2: "обнаружено рано, поздно или никогда",
    caption:
      "Разбираем одну ошибку — price, сохранённая как строка «9.99» вместо числа: JS молча приводит минус к 9.89 и умножение к 10.7892, плюс конкатенирует в «9.99 USD», TypeScript отклоняет присваивание во время компиляции, а вызов метода на null бросает TypeError во время выполнения. Одно происхождение — обнаружено рано, поздно или никогда.",
  },
};

const t = dict[lang];

const ops = ['"9.99" - 0.1', '"9.99" * 1.08', 'price + " USD"', 'price: number = "9.99"', "null.toString()"];
const boxX = 60;
const boxW = 680;
const boxH = 38;
const topY = 92;
const rowStep = 50;
const rowY = (i: number) => topY + i * rowStep;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.status.map((s, i) => (
      <g>
        <rect x={boxX} y={rowY(i)} width={boxW} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <rect x={boxX + 10} y={rowY(i) + 7} width="88" height="24" fill="none" stroke="var(--ink)" stroke-width="1.5" />
        <text x={boxX + 54} y={rowY(i) + 23} text-anchor="middle" font-size="11" fill="var(--ink)">{s}</text>
        <text x={boxX + 110} y={rowY(i) + 24} font-size="13" fill="var(--ink)">{ops[i]}</text>
        <text x={boxX + boxW - 12} y={rowY(i) + 24} text-anchor="end" font-size="12" fill="var(--muted)">{t.results[i]}</text>
      </g>
    ))}

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="394" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
