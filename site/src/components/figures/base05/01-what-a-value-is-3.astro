---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A complete read needs address, size, and an interpretation rule",
    headline: "ONE COMPLETE READ · THREE FACTS",
    sub: "a 4-byte value starting at address 100 spans 100–103",
    bracket: "4 bytes · addresses 100–103",
    cellBytes: ["byte 1", "byte 2", "byte 3", "byte 4"],
    facts: [
      { k: "where", v: "address 100" },
      { k: "how far", v: "4 bytes" },
      { k: "what it means", v: "interpretation rule" },
    ],
    foot: "all three define one complete read — the hardware only gives step 1",
    caption:
      "A 4-byte value starting at address 100 occupies four consecutive addresses: 100, 101, 102, 103. To use it, a program must know where it lives (address 100), how far it spans (4 bytes), and how to interpret the bits. Memory hardware only retrieves cells by address; size and interpretation are the program’s job — exactly what a type provides.",
  },
  ru: {
    svgTitle: "Полному чтению нужны адрес, размер и правило интерпретации",
    headline: "ОДНО ПОЛНОЕ ЧТЕНИЕ · ТРИ ФАКТА",
    sub: "4-байтовое значение с адреса 100 занимает 100–103",
    bracket: "4 байта · адреса 100–103",
    cellBytes: ["байт 1", "байт 2", "байт 3", "байт 4"],
    facts: [
      { k: "где", v: "адрес 100" },
      { k: "докуда", v: "4 байта" },
      { k: "что значит", v: "правило интерпретации" },
    ],
    foot: "все три — одно полное чтение; аппаратура даёт только шаг 1",
    caption:
      "Четырёхбайтовое значение с начального адреса 100 занимает четыре последовательных адреса: 100, 101, 102, 103. Чтобы его использовать, программа обязана знать, где оно лежит (адрес 100), докуда простирается (4 байта) и как интерпретировать биты. Аппаратура памяти лишь возвращает ячейки по адресу; размер и интерпретация — дело программы, и именно это предоставляет тип.",
  },
};

const t = dict[lang];

const cells = ["99", "100", "101", "102", "103", "104"];
const nums = ["1", "2", "3"];

const cellX = (i: number) => 135 + i * 90;
const cellCX = (i: number) => cellX(i) + 40;
const factX = (i: number) => 50 + i * 240;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {cells.map((a, i) => (
      <g>
        <text x={cellCX(i)} y="120" text-anchor="middle" font-size="12" fill="var(--muted)">{a}</text>
        <rect
          x={cellX(i)}
          y="130"
          width="80"
          height="64"
          fill="var(--card)"
          stroke={i === 0 || i === 5 ? "var(--muted)" : "var(--accent)"}
          stroke-width={i === 0 || i === 5 ? 1.5 : 3}
          stroke-dasharray={i === 0 || i === 5 ? "6 4" : undefined}
        />
        <text x={cellCX(i)} y="168" text-anchor="middle" font-size={i === 0 || i === 5 ? 20 : 11} fill={i === 0 || i === 5 ? "var(--muted)" : "var(--ink)"}>
          {i === 0 || i === 5 ? "···" : t.cellBytes[i - 1]}
        </text>
      </g>
    ))}

    <line x1="225" y1="208" x2="575" y2="208" stroke="var(--ink)" stroke-width="2" />
    <line x1="225" y1="202" x2="225" y2="214" stroke="var(--ink)" stroke-width="2" />
    <line x1="575" y1="202" x2="575" y2="214" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="238" text-anchor="middle" font-size="13" fill="var(--ink)">{t.bracket}</text>

    {t.facts.map((f, i) => (
      <g>
        <rect x={factX(i)} y="268" width="220" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <rect x={factX(i) + 12} y="285" width="20" height="20" fill="var(--accent)" />
        <text x={factX(i) + 22} y="299" text-anchor="middle" font-size="12" fill="var(--card)">{nums[i]}</text>
        <text x={factX(i) + 44} y="294" font-size="12" fill="var(--muted)">{f.k}</text>
        <text x={factX(i) + 44} y="315" font-size="12" fill="var(--ink)">{f.v}</text>
      </g>
    ))}

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
