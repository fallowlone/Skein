---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The same bits read as 65 or as A",
    headline: "SAME BITS · TWO MEANINGS",
    sub: "01000001 carries no label — the reading decides",
    stripLabel: "one 8-bit pattern",
    leftBig: "65",
    leftSmall: "unsigned integer · 64 + 1",
    rightBig: '"A"',
    rightSmall: 'ASCII · code 65 is "A"',
    foot: "the pattern is the same; the meaning is in the reading",
    caption:
      "The 8-bit pattern 01000001 has no inherent meaning: read as an unsigned integer it is 65 (64 + 1); read as ASCII it is the character “A” (code 65). The bits are identical — only the program’s interpretation differs.",
  },
  ru: {
    svgTitle: "Одни и те же биты читаются как 65 или как А",
    headline: "ОДНИ БИТЫ · ДВА СМЫСЛА",
    sub: "01000001 не несёт ярлыка — решает способ чтения",
    stripLabel: "один 8-битный паттерн",
    leftBig: "65",
    leftSmall: "беззнаковое целое · 64 + 1",
    rightBig: "«A»",
    rightSmall: "ASCII · код 65 — это «A»",
    foot: "паттерн одинаков; смысл — в способе чтения",
    caption:
      "8-битный паттерн 01000001 не имеет врождённого смысла: прочитанный как беззнаковое целое, он равен 65 (64 + 1); прочитанный как ASCII, он равен символу «A» (код 65). Биты одинаковы — различается только интерпретация программы.",
  },
};

const t = dict[lang];

const bits = [0, 1, 0, 0, 0, 0, 0, 1];
const forks = [
  { x1: 330, x2: 250 },
  { x1: 470, x2: 550 },
];
const cards = [
  { x: 90, big: t.leftBig, small: t.leftSmall },
  { x: 440, big: t.rightBig, small: t.rightSmall },
];

const bitX = (i: number) => 148 + i * 64;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="104" text-anchor="middle" font-size="12" fill="var(--muted)">{t.stripLabel}</text>
    {bits.map((b, i) => (
      <g>
        <rect x={bitX(i)} y="120" width="56" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={bitX(i) + 28} y="156" text-anchor="middle" font-size="24" fill="var(--ink)">{b}</text>
      </g>
    ))}

    {forks.map((f) => (
      <g>
        <line x1={f.x1} y1="172" x2={f.x2} y2="230" stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${f.x2 - 7},222 ${f.x2 + 7},222 ${f.x2},230`} fill="var(--accent)" />
      </g>
    ))}

    {cards.map((c) => (
      <g>
        <rect x={c.x} y="230" width="270" height="90" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={c.x + 135} y="274" text-anchor="middle" font-family="var(--font-display)" font-size="30" fill="var(--ink)">{c.big}</text>
        <text x={c.x + 135} y="302" text-anchor="middle" font-size="12" fill="var(--muted)">{c.small}</text>
      </g>
    ))}

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
