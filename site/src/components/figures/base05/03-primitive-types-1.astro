---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Five everyday primitive types with their storage stories",
    headline: "FIVE EVERYDAY PRIMITIVES",
    sub: "five boxes · one value each · indivisible",
    cards: [
      { name: "number", val: "42", l1: "64-bit double", l2: "8 bytes", l3: "even 42 is a double" },
      { name: "string", val: "\"hi\"", l1: "UTF-16 units", l2: "+ a length", l3: "not one byte" },
      { name: "boolean", val: "true", l1: "exactly 2 values", l2: "true / false", l3: "1-bit concept" },
      { name: "null", val: "null", l1: "deliberate", l2: "absence × 1", l3: "you wrote it" },
      { name: "undefined", val: "undefined", l1: "unset absence", l2: "never assigned", l3: "absence × 1" },
    ],
    tag: "one value",
    foot1: "each box holds one indivisible value — you cannot split a primitive",
    foot2: "spec total is seven: symbol (ES2015) + bigint (ES2020) — specialised, later",
    caption:
      "number (42: a 64-bit double, 8 bytes), string (UTF-16 units plus a length), boolean (true: one of two states), null (deliberate absence), undefined (unset absence). Each holds a single indivisible value; the full spec adds symbol and bigint for specialised use.",
  },
  ru: {
    svgTitle: "Пять повседневных примитивных типов и их истории хранения",
    headline: "ПЯТЬ ПОВСЕДНЕВНЫХ ПРИМИТИВОВ",
    sub: "пять коробок · одно значение в каждой · неделимые",
    cards: [
      { name: "number", val: "42", l1: "64-битный double", l2: "8 байт", l3: "42 — тоже double" },
      { name: "string", val: "\"hi\"", l1: "единицы UTF-16", l2: "+ длина", l3: "не один байт" },
      { name: "boolean", val: "true", l1: "ровно 2 значения", l2: "true / false", l3: "концепция 1 бита" },
      { name: "null", val: "null", l1: "намеренное", l2: "отсутствие × 1", l3: "пишет программист" },
      { name: "undefined", val: "undefined", l1: "незаданное", l2: "отсутствие × 1", l3: "не присваивалась" },
    ],
    tag: "одно значение",
    foot1: "в каждой коробке одно неделимое значение — примитив нельзя разбить",
    foot2: "всего в спецификации семь: symbol (ES2015) + bigint (ES2020) — позже",
    caption:
      "number (42: 64-битный double, 8 байт), string (единицы UTF-16 плюс длина), boolean (true: одно из двух состояний), null (намеренное отсутствие), undefined (незаданное отсутствие). Каждый хранит одно неделимое значение; полная спецификация добавляет symbol и bigint для специальных задач.",
  },
};

const t = dict[lang];

const boxW = 140;
const boxY = 85;
const boxH = 250;
const boxX = (i: number) => 24 + i * 152;
const midX = (i: number) => boxX(i) + boxW / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.cards.map((c, i) => (
      <g>
        <rect x={boxX(i)} y={boxY} width={boxW} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={midX(i)} y={boxY + 32} text-anchor="middle" font-size="15" font-weight="600" fill="var(--accent)">{c.name}</text>
        <line x1={boxX(i) + 14} y1={boxY + 46} x2={boxX(i) + boxW - 14} y2={boxY + 46} stroke="var(--muted)" stroke-width="1" />
        <text x={midX(i)} y={boxY + 82} text-anchor="middle" font-size="20" font-weight="600" fill="var(--ink)">{c.val}</text>
        <text x={midX(i)} y={boxY + 122} text-anchor="middle" font-size="11" fill="var(--muted)">{c.l1}</text>
        <text x={midX(i)} y={boxY + 142} text-anchor="middle" font-size="11" fill="var(--muted)">{c.l2}</text>
        <text x={midX(i)} y={boxY + 162} text-anchor="middle" font-size="11" fill="var(--muted)">{c.l3}</text>
        <line x1={boxX(i) + 14} y1={boxY + 182} x2={boxX(i) + boxW - 14} y2={boxY + 182} stroke="var(--muted)" stroke-width="1" />
        <text x={midX(i)} y={boxY + 210} text-anchor="middle" font-size="11" fill="var(--ink)">{t.tag}</text>
      </g>
    ))}

    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
