---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One byte 01000001 read as integer 65, character A, and red intensity 65 of 255",
    headline: "ONE BYTE, THREE READINGS",
    sub: "01000001 at address 20 · the bits never move",
    addr: "addr 20",
    cards: [
      { rule: "u8 · place-value", value: "65" },
      { rule: "char · ASCII table", value: "'A'" },
      { rule: "RGB red · 3-byte colour", value: "65 / 255" },
    ],
    foot: "three types · three values · one bit pattern",
    caption:
      "The byte 01000001 at address 20 read under three type rules: as an unsigned 8-bit integer it is 65, as an ASCII character it is 'A', and as the red channel of a 3-byte RGB colour it is a red intensity of 65 out of 255. The physical bits are unchanged — only the reading rule switches.",
  },
  ru: {
    svgTitle: "Один байт 01000001: целое 65, символ A и красный 65 из 255",
    headline: "ОДИН БАЙТ, ТРИ ПРОЧТЕНИЯ",
    sub: "01000001 по адресу 20 · биты не двигаются",
    addr: "адрес 20",
    cards: [
      { rule: "u8 · позиционная запись", value: "65" },
      { rule: "char · таблица ASCII", value: "'A'" },
      { rule: "красный RGB · 3-байтный цвет", value: "65 из 255" },
    ],
    foot: "три типа · три значения · один паттерн битов",
    caption:
      "Байт 01000001 по адресу 20 при трёх правилах типа: как беззнаковое 8-битное целое это 65, как символ ASCII это 'A', а как красный канал 3-байтного цвета RGB это интенсивность красного 65 из 255. Физические биты не изменились — меняется только правило чтения.",
  },
};

const t = dict[lang];

const bits = ["0", "1", "0", "0", "0", "0", "0", "1"];
const cellW = 44;
const cellGap = 6;
const rowW = bits.length * cellW + (bits.length - 1) * cellGap;
const rowX = (800 - rowW) / 2;
const rowY = 90;
const cellH = 44;
const rowBottom = rowY + cellH;
const busY = 176;
const cardY = 208;
const cardH = 120;
const cardW = 220;
const cardXs = [30, 290, 550];
const cardMid = (i: number) => cardXs[i] + cardW / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="80" text-anchor="middle" font-size="12" fill="var(--muted)">{t.addr}</text>
    {bits.map((b, i) => (
      <g>
        <rect x={rowX + i * (cellW + cellGap)} y={rowY} width={cellW} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={rowX + i * (cellW + cellGap) + cellW / 2} y={rowY + 30} text-anchor="middle" font-size="20" fill="var(--ink)">{b}</text>
      </g>
    ))}

    <line x1="400" y1={rowBottom} x2="400" y2={busY} stroke="var(--accent)" stroke-width="2" />
    <line x1={cardMid(0)} y1={busY} x2={cardMid(2)} y2={busY} stroke="var(--accent)" stroke-width="2" />
    {t.cards.map((c, i) => (
      <g>
        <line x1={cardMid(i)} y1={busY} x2={cardMid(i)} y2={cardY - 9} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${cardMid(i) - 7},${cardY - 9} ${cardMid(i) + 7},${cardY - 9} ${cardMid(i)},${cardY}`} fill="var(--accent)" />
        <rect x={cardXs[i]} y={cardY} width={cardW} height={cardH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cardMid(i)} y={cardY + 30} text-anchor="middle" font-size="12" fill="var(--muted)">{c.rule}</text>
        <text x={cardMid(i)} y={cardY + 78} text-anchor="middle" font-size="28" fill="var(--ink)">{c.value}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
