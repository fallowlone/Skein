---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Static typing guards at compile time, dynamic typing at run time",
    headline: "WHEN THE GUARD FIRES",
    sub: "same mismatch · static blocks early, dynamic throws late",
    nodes: ["write code", "compile", "run"],
    nodeSubs: ["annotations (TS)", "static guard", "dynamic guard"],
    staticTitle: "TS: build refused",
    staticDetail: "before a single line runs",
    dynamicTitle: "JS: TypeError thrown",
    dynamicDetail: "only if the bad line runs",
    coerce: 'coercion: no guard — "9.99" - 0.1 = 9.89, silent',
    foot: "the same mismatch — the difference is when the guard fires",
    caption:
      "Static and dynamic typing catch the same mismatch at different moments: TypeScript refuses the build at compile time, before a single line runs, while JavaScript throws a TypeError at run time, only if the bad line actually executes. Coercion such as \"9.99\" - 0.1 = 9.89 passes silently with no guard at all.",
  },
  ru: {
    svgTitle: "Статическая типизация защищает при компиляции, динамическая — при выполнении",
    headline: "КОГДА СРАБАТЫВАЕТ ЗАЩИТА",
    sub: "то же несоответствие · статика блокирует рано, динамика бросает поздно",
    nodes: ["написание кода", "компиляция", "выполнение"],
    nodeSubs: ["аннотации (TS)", "статическая защита", "динамическая защита"],
    staticTitle: "TS: сборка отклонена",
    staticDetail: "до выполнения хоть одной строки",
    dynamicTitle: "JS: брошен TypeError",
    dynamicDetail: "только если строка выполнится",
    coerce: 'приведение: защиты нет — "9.99" - 0.1 = 9.89, молча',
    foot: "то же несоответствие — разница в том, когда срабатывает защита",
    caption:
      "Статическая и динамическая типизация перехватывают то же несоответствие в разные моменты: TypeScript отклоняет сборку во время компиляции, до выполнения хоть одной строки, а JavaScript бросает TypeError во время выполнения — только если плохая строка реально выполняется. Приведение вроде «9.99» − 0.1 = 9.89 проходит молча, вообще без защиты.",
  },
};

const t = dict[lang];

const nodeW = 160;
const nodeH = 54;
const nodeY = 110;
const nodeX = [90, 320, 550];
const nodeMidY = nodeY + nodeH / 2;
const links = [0, 1];
const guardY = 215;
const guardW = 220;
const guardH = 64;
const guardX = [290, 520];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.nodes.map((n, i) => (
      <g>
        <rect x={nodeX[i]} y={nodeY} width={nodeW} height={nodeH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={nodeX[i] + nodeW / 2} y={nodeY + 23} text-anchor="middle" font-size="13" fill="var(--ink)">{n}</text>
        <text x={nodeX[i] + nodeW / 2} y={nodeY + 42} text-anchor="middle" font-size="11" fill="var(--muted)">{t.nodeSubs[i]}</text>
      </g>
    ))}
    {links.map((i) => (
      <g>
        <line x1={nodeX[i] + nodeW} y1={nodeMidY} x2={nodeX[i + 1] - 8} y2={nodeMidY} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${nodeX[i + 1] - 10},${nodeMidY - 7} ${nodeX[i + 1] - 10},${nodeMidY + 7} ${nodeX[i + 1]},${nodeMidY}`} fill="var(--accent)" />
      </g>
    ))}

    <g>
      <line x1="400" y1={nodeY + nodeH} x2="400" y2={guardY - 8} stroke="var(--accent)" stroke-width="2" />
      <polygon points={`390,${guardY - 8} 410,${guardY - 8} 400,${guardY}`} fill="var(--accent)" />
      <rect x={guardX[0]} y={guardY} width={guardW} height={guardH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x={guardX[0] + guardW / 2} y={guardY + 26} text-anchor="middle" font-size="13" fill="var(--ink)">{t.staticTitle}</text>
      <text x={guardX[0] + guardW / 2} y={guardY + 47} text-anchor="middle" font-size="11" fill="var(--muted)">{t.staticDetail}</text>
    </g>
    <g>
      <line x1="630" y1={nodeY + nodeH} x2="630" y2={guardY - 8} stroke="var(--accent)" stroke-width="2" />
      <polygon points={`620,${guardY - 8} 640,${guardY - 8} 630,${guardY}`} fill="var(--accent)" />
      <rect x={guardX[1]} y={guardY} width={guardW} height={guardH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x={guardX[1] + guardW / 2} y={guardY + 26} text-anchor="middle" font-size="13" fill="var(--ink)">{t.dynamicTitle}</text>
      <text x={guardX[1] + guardW / 2} y={guardY + 47} text-anchor="middle" font-size="11" fill="var(--muted)">{t.dynamicDetail}</text>
    </g>

    <rect x="150" y="302" width="500" height="44" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 4" />
    <text x="400" y="329" text-anchor="middle" font-size="12" fill="var(--muted)">{t.coerce}</text>

    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
