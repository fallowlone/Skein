---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A type rule has size and interpretation; address plus type yields the value",
    headline: "TYPE = SIZE + INTERPRETATION",
    sub: "bits at an address · plus the rule · gives the value",
    bitsTitle: "bits",
    bitsAddr: "addr 20",
    bitsVal: "01000001",
    ruleTitle: "type rule",
    ruleRows: ["size · 1 byte", "interpretation · u8"],
    valueTitle: "value",
    valueVal: "65",
    foot: "knowing the address is not enough — knowing the type is equally necessary",
    foot2: "without both components, you cannot read a value correctly",
    caption:
      "A type is a rule with two components: size (how many bytes the value occupies) and interpretation (what the bit pattern means). The bits 01000001 at address 20 plus the rule u8 decode to the integer 65. Without both components the value cannot be read correctly.",
  },
  ru: {
    svgTitle: "Правило типа: размер и интерпретация; адрес плюс тип дают значение",
    headline: "ТИП = РАЗМЕР + ИНТЕРПРЕТАЦИЯ",
    sub: "биты по адресу · плюс правило · дают значение",
    bitsTitle: "биты",
    bitsAddr: "адрес 20",
    bitsVal: "01000001",
    ruleTitle: "правило типа",
    ruleRows: ["размер · 1 байт", "интерпретация · u8"],
    valueTitle: "значение",
    valueVal: "65",
    foot: "знать адрес недостаточно — знать тип не менее необходимо",
    foot2: "без обоих компонентов правильно прочитать значение невозможно",
    caption:
      "Тип — это правило из двух компонентов: размер (сколько байт занимает значение) и интерпретация (что означает паттерн битов). Биты 01000001 по адресу 20 плюс правило u8 декодируются в целое число 65. Без обоих компонентов правильно прочитать значение невозможно.",
  },
};

const t = dict[lang];

const boxY = 130;
const boxH = 150;
const bitsX = 36;
const bitsW = 190;
const ruleX = 266;
const ruleW = 268;
const valueX = 574;
const valueW = 190;
const midY = boxY + boxH / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x={bitsX} y={boxY} width={bitsW} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={bitsX + bitsW / 2} y={boxY + 32} text-anchor="middle" font-size="13" fill="var(--muted)">{t.bitsTitle}</text>
    <text x={bitsX + bitsW / 2} y={boxY + 66} text-anchor="middle" font-size="14" fill="var(--ink)">{t.bitsAddr}</text>
    <text x={bitsX + bitsW / 2} y={boxY + 104} text-anchor="middle" font-size="18" fill="var(--ink)">{t.bitsVal}</text>

    <rect x={ruleX} y={boxY} width={ruleW} height={boxH} fill="var(--card)" stroke="var(--accent)" stroke-width="3" />
    <text x={ruleX + ruleW / 2} y={boxY + 32} text-anchor="middle" font-size="13" fill="var(--muted)">{t.ruleTitle}</text>
    {t.ruleRows.map((r, i) => (
      <g>
        <rect x={ruleX + 18} y={boxY + 48 + i * 48} width={ruleW - 36} height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={ruleX + ruleW / 2} y={boxY + 72 + i * 48} text-anchor="middle" font-size="13" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <rect x={valueX} y={boxY} width={valueW} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={valueX + valueW / 2} y={boxY + 32} text-anchor="middle" font-size="13" fill="var(--muted)">{t.valueTitle}</text>
    <text x={valueX + valueW / 2} y={boxY + 100} text-anchor="middle" font-size="34" fill="var(--ink)">{t.valueVal}</text>

    <line x1={bitsX + bitsW} y1={midY} x2={ruleX - 9} y2={midY} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${ruleX - 9},${midY - 7} ${ruleX - 9},${midY + 7} ${ruleX},${midY}`} fill="var(--accent)" />
    <line x1={ruleX + ruleW} y1={midY} x2={valueX - 9} y2={midY} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${valueX - 9},${midY - 7} ${valueX - 9},${midY + 7} ${valueX},${midY}`} fill="var(--accent)" />

    <text x="400" y="340" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
    <text x="400" y="368" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
