---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Cell 20 holds the 8-bit pattern 01000001",
    headline: "A VALUE IS BITS IN CELLS",
    sub: "cell 20 holds 01000001 · eight switches",
    addrTag: "address 20",
    ghostL: "cell 19",
    ghostR: "cell 21",
    equation: "64 + 1",
    foot1: "eight switches · raw and passive",
    foot2: "no label on the bits — the program knows",
    caption:
      "Memory cell 20 holds the 8-bit pattern 01000001: eight switches, two of them on (64 + 1). The pattern itself is the value — raw and passive, with no label. Neighbouring cells 19 and 21 are unrelated. Meaning arrives only when a program reads the bits with an interpretation rule.",
  },
  ru: {
    svgTitle: "Ячейка 20 хранит 8-битный паттерн 01000001",
    headline: "ЗНАЧЕНИЕ — ЭТО БИТЫ В ЯЧЕЙКАХ",
    sub: "ячейка 20 хранит 01000001 · восемь переключателей",
    addrTag: "адрес 20",
    ghostL: "ячейка 19",
    ghostR: "ячейка 21",
    equation: "64 + 1",
    foot1: "восемь переключателей · сырые и пассивные",
    foot2: "на битах нет ярлыка — знает программа",
    caption:
      "Ячейка памяти 20 хранит 8-битный паттерн 01000001: восемь переключателей, два из них включены (64 + 1). Сам паттерн и есть значение — сырое и пассивное, без ярлыка. Соседние ячейки 19 и 21 не связаны с ним. Смысл появляется, только когда программа читает биты с правилом интерпретации.",
  },
};

const t = dict[lang];

const bits = [0, 1, 0, 0, 0, 0, 0, 1];
const places = ["128", "64", "32", "16", "8", "4", "2", "1"];
const ghosts = [
  { x: 30, label: t.ghostL },
  { x: 710, label: t.ghostR },
];

const bitX = (i: number) => 116 + i * 72;
const bitCX = (i: number) => bitX(i) + 32;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="106" y="86" width="116" height="24" fill="var(--ink)" />
    <text x="164" y="103" text-anchor="middle" font-size="12" fill="var(--card)">{t.addrTag}</text>
    <rect x="106" y="110" width="588" height="84" fill="none" stroke="var(--ink)" stroke-width="2" />

    {ghosts.map((g) => (
      <g>
        <rect x={g.x} y="120" width="60" height="64" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 4" />
        <text x={g.x + 30} y="162" text-anchor="middle" font-size="20" fill="var(--muted)">?</text>
        <text x={g.x + 30} y="210" text-anchor="middle" font-size="11" fill="var(--muted)">{g.label}</text>
      </g>
    ))}

    {bits.map((b, i) => (
      <g>
        <rect x={bitX(i)} y="120" width="64" height="64" fill={b === 1 ? "var(--accent)" : "var(--card)"} stroke={b === 1 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={bitCX(i)} y="164" text-anchor="middle" font-size="28" fill={b === 1 ? "var(--card)" : "var(--ink)"}>{b}</text>
        <text x={bitCX(i)} y="216" text-anchor="middle" font-size="11" fill={b === 1 ? "var(--accent)" : "var(--muted)"}>{places[i]}</text>
      </g>
    ))}

    <text x="400" y="276" text-anchor="middle" font-size="20" fill="var(--ink)">{t.equation}</text>
    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
