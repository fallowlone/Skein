---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "null versus undefined: deliberate absence against unset absence",
    headline: "ABSENCE × 2",
    sub: "null is not undefined · two distinct absence states",
    panels: [
      {
        name: "null",
        meaning: "deliberate absence",
        code: "const slot = null;",
        test: "slot === null → true",
        count: "exactly one null value",
        badge: "programmer writes it",
      },
      {
        name: "undefined",
        meaning: "unset absence",
        code: "let future;",
        test: "future === undefined → true",
        count: "exactly one undefined value",
        badge: "never assigned",
      },
    ],
    foot1: "null ≠ undefined — treat them as two distinct states",
    foot2: "in strict TypeScript the compiler tracks them separately",
    caption:
      "null is deliberate absence — the programmer writes null to say a slot intentionally holds nothing; undefined is unset absence — a declared variable never given a value. Each has exactly one value; test with === and never confuse them.",
  },
  ru: {
    svgTitle: "null против undefined: намеренное отсутствие против незаданного",
    headline: "ОТСУТСТВИЕ × 2",
    sub: "null — это не undefined · два разных состояния отсутствия",
    panels: [
      {
        name: "null",
        meaning: "намеренное отсутствие",
        code: "const slot = null;",
        test: "slot === null → true",
        count: "ровно одно значение null",
        badge: "пишет программист",
      },
      {
        name: "undefined",
        meaning: "незаданное отсутствие",
        code: "let future;  // не присвоена",
        test: "future === undefined → true",
        count: "ровно одно значение undefined",
        badge: "не присваивалась",
      },
    ],
    foot1: "null ≠ undefined — рассматривай их как два разных состояния",
    foot2: "в строгом TypeScript компилятор отслеживает их отдельно",
    caption:
      "null — намеренное отсутствие: программист пишет null, говоря, что слот намеренно ничего не содержит; undefined — незаданное отсутствие: объявленная переменная, не получившая значения. Каждого — ровно одно значение; проверяй через === и не путай их.",
  },
};

const t = dict[lang];

const panY = 92;
const panH = 236;
const panW = 355;
const panX = [30, 415];
const midX = (i: number) => panX[i] + panW / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.panels.map((p, i) => (
      <g>
        <rect x={panX[i]} y={panY} width={panW} height={panH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={midX(i)} y={panY + 40} text-anchor="middle" font-size="22" font-weight="600" fill="var(--ink)">{p.name}</text>
        <text x={midX(i)} y={panY + 66} text-anchor="middle" font-size="14" fill="var(--accent)">{p.meaning}</text>
        <line x1={panX[i] + 20} y1={panY + 84} x2={panX[i] + panW - 20} y2={panY + 84} stroke="var(--muted)" stroke-width="1" />
        <text x={midX(i)} y={panY + 114} text-anchor="middle" font-size="12" fill="var(--ink)">{p.code}</text>
        <text x={midX(i)} y={panY + 142} text-anchor="middle" font-size="12" fill="var(--ink)">{p.test}</text>
        <text x={midX(i)} y={panY + 170} text-anchor="middle" font-size="12" fill="var(--muted)">{p.count}</text>
        <rect x={midX(i) - 110} y={panY + 188} width="220" height="28" fill="var(--card)" stroke="var(--accent)" stroke-width="1" />
        <text x={midX(i)} y={panY + 207} text-anchor="middle" font-size="12" fill="var(--accent)">{p.badge}</text>
      </g>
    ))}
    <text x="400" y="216" text-anchor="middle" font-size="26" font-weight="600" fill="var(--accent)">≠</text>

    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
