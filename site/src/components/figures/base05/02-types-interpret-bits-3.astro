---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Memory cells carry no type label; the program tracks the type",
    headline: "TYPES LIVE IN THE PROGRAM, NOT THE BITS",
    sub: "the cell holds bits only · the rule lives elsewhere",
    cellBits: "addr 20 · 01000001",
    cellNote: "no type label here",
    trackers: [
      { who: "TypeScript strict", how: "compiler table" },
      { who: "dynamic language", how: "runtime tag" },
      { who: "C", how: "programmer's head" },
    ],
    foot: "read-only lens — applying a type never rewrites bits",
    caption:
      "The memory cell at address 20 holds only the bit pattern 01000001 — it carries no type label. The type is tracked separately by the program: in a statically typed language the compiler records it in a table, in a dynamically typed language the runtime attaches a tag, and in C the programmer bears full responsibility. Applying a type decodes the bits without changing them.",
  },
  ru: {
    svgTitle: "Ячейки памяти не несут метки типа; тип отслеживает программа",
    headline: "ТИПЫ ЖИВУТ В ПРОГРАММЕ, А НЕ В БИТАХ",
    sub: "ячейка хранит только биты · правило живёт в программе",
    cellBits: "адрес 20 · 01000001",
    cellNote: "здесь нет метки типа",
    trackers: [
      { who: "TypeScript strict", how: "таблица компилятора" },
      { who: "динамический язык", how: "метка среды выполнения" },
      { who: "C", how: "голова программиста" },
    ],
    foot: "линза только для чтения — применение типа не переписывает биты",
    caption:
      "Ячейка памяти по адресу 20 хранит только паттерн битов 01000001 — метки типа в ней нет. Тип отдельно отслеживает программа: в статически типизированном языке компилятор записывает его в таблицу, в динамически типизированном языке среда выполнения прикрепляет метку, а в C программист несёт полную ответственность. Применение типа декодирует биты, не меняя их.",
  },
};

const t = dict[lang];

const cellX = 230;
const cellW = 340;
const cellY = 84;
const cellH = 66;
const cellBottom = cellY + cellH;
const busY = 184;
const boxY = 216;
const boxH = 110;
const boxW = 220;
const boxXs = [30, 290, 550];
const boxMid = (i: number) => boxXs[i] + boxW / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x={cellX} y={cellY} width={cellW} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y={cellY + 27} text-anchor="middle" font-size="16" fill="var(--ink)">{t.cellBits}</text>
    <text x="400" y={cellY + 50} text-anchor="middle" font-size="12" fill="var(--muted)">{t.cellNote}</text>

    <line x1="400" y1={cellBottom} x2="400" y2={busY} stroke="var(--accent)" stroke-width="2" />
    <line x1={boxMid(0)} y1={busY} x2={boxMid(2)} y2={busY} stroke="var(--accent)" stroke-width="2" />
    {t.trackers.map((tr, i) => (
      <g>
        <line x1={boxMid(i)} y1={busY} x2={boxMid(i)} y2={boxY - 9} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${boxMid(i) - 7},${boxY - 9} ${boxMid(i) + 7},${boxY - 9} ${boxMid(i)},${boxY}`} fill="var(--accent)" />
        <rect x={boxXs[i]} y={boxY} width={boxW} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={boxMid(i)} y={boxY + 34} text-anchor="middle" font-size="13" fill="var(--ink)">{tr.who}</text>
        <text x={boxMid(i)} y={boxY + 62} text-anchor="middle" font-size="12" fill="var(--muted)">{tr.how}</text>
      </g>
    ))}

    <text x="400" y="382" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
