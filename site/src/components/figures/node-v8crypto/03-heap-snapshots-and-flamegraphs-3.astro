---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Leak versus churn: a leak grows monotonically and never returns to baseline, churn sawtooths as GC reclaims; GC pauses lengthen as the live set grows",
    headline: "MONOTONIC IS A LEAK, SAWTOOTH IS CHURN",
    sub: "growth that never returns to baseline is the leak signature",
    churnH: "CHURN — HEALTHY",
    churnL1: "sawtooth: GC reclaims, drops back",
    churnL2: "delta returns to ~0",
    churnL3: "pauses short and stable",
    leakH: "LEAK — MONOTONIC",
    leakL1: "monotonic: never back to baseline",
    leakL2: "# New grows; # Deleted ~ 0",
    leakL3: "pauses lengthen, live set grows",
    foot: "sort survivors by retained size, follow the retaining path",
    caption:
      "A leak grows monotonically and never returns to baseline; churn climbs, GC reclaims it, and the line drops back — a sawtooth. The three-snapshot delta returns to zero for churn and grows by a fixed amount each round for a leak, while GC pauses lengthen as the live set grows.",
  },
  ru: {
    svgTitle: "Leak против churn: leak растёт монотонно и не возвращается к базлайну, churn пилит, пока GC отбирает; паузы GC удлиняются по мере роста live set",
    headline: "LEAK РАСТЁТ МОНОТОННО, CHURN ПИЛИТ",
    sub: "рост без возврата к базлайну — подпись leak",
    churnH: "CHURN — НОРМА",
    churnL1: "лезет, GC отбирает, падает назад",
    churnL2: "дельта возвращается к ~0",
    churnL3: "паузы короткие, стабильные",
    leakH: "LEAK — МОНОТОННО",
    leakL1: "монотонно, без возврата к базлайну",
    leakL2: "растёт каждый раунд, #Deleted ~ 0",
    leakL3: "паузы удлиняются, live set растёт",
    foot: "сортируй по retained size, иди по retaining path",
    caption:
      "Leak растёт монотонно и не возвращается к базлайну; churn лезет вверх, GC отбирает, и линия падает назад — sawtooth. Дельта трёх снапшотов за раунд возвращается к нулю для churn и растёт на фиксированную величину каждый раунд для leak, а паузы GC удлиняются по мере роста live set.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="92" width="340" height="138" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="210" y="116" text-anchor="middle" font-size="13" fill="var(--ink)">{t.churnH}</text>
    <polyline points="60,205 92,168 124,205 156,168 188,205 220,168 252,205 284,168 316,205 348,205" fill="var(--card)" stroke="var(--muted)" stroke-width="2.5" />
    <text x="210" y="260" text-anchor="middle" font-size="12" fill="var(--ink)">{t.churnL1}</text>
    <text x="210" y="286" text-anchor="middle" font-size="12" fill="var(--ink)">{t.churnL2}</text>
    <text x="210" y="312" text-anchor="middle" font-size="12" fill="var(--ink)">{t.churnL3}</text>

    <rect x="420" y="92" width="340" height="138" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="116" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leakH}</text>
    <line x1="450" y1="112" x2="730" y2="112" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 4" />
    <text x="730" y="104" text-anchor="end" font-size="10" fill="var(--muted)">512MB</text>
    <polyline points="450,205 510,187 570,169 630,151 690,133 730,121" fill="var(--card)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="444" y="210" text-anchor="end" font-size="10" fill="var(--muted)">180MB</text>
    <text x="590" y="260" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leakL1}</text>
    <text x="590" y="286" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leakL2}</text>
    <text x="590" y="312" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leakL3}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
