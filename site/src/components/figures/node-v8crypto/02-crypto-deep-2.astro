---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Pick the primitive by job: plain hash for integrity only, HMAC for keyed integrity with a shared secret, asymmetric sign and verify when verifiers must not be able to forge",
    headline: "PICK THE PRIMITIVE BY JOB",
    sub: "who can verify decides the tool",
    col1Title: "createHash",
    col1Line1: "integrity only",
    col1Line2: "anyone can recompute",
    col1Line3: "checksums, cache keys",
    col2Title: "createHmac",
    col2Line1: "keyed integrity",
    col2Line2: "shared secret",
    col2Line3: "cookies, webhooks",
    col3Title: "sign / verify",
    col3Line1: "untrusted verifiers",
    col3Line2: "private signs, public checks",
    col3Line3: "releases, JWT, licences",
    foot1: "HMAC shares signing power; signatures split it",
    foot2: "a bare hash proves nothing about origin",
    caption:
      "A plain hash proves the bytes did not change; HMAC proves a key holder produced them; an asymmetric signature lets anyone verify what only the private key could produce.",
  },
  ru: {
    svgTitle: "Выбирай примитив по задаче: обычный хэш — только для целостности, HMAC — для целостности с общим секретным ключом, асимметричные sign и verify — когда проверяющие не должны мочь подделывать",
    headline: "ВЫБИРАЙ ПРИМИТИВ ПО ЗАДАЧЕ",
    sub: "кто проверяет — решает инструмент",
    col1Title: "createHash",
    col1Line1: "только целостность",
    col1Line2: "пересчитает кто угодно",
    col1Line3: "контрольные суммы, кэш",
    col2Title: "createHmac",
    col2Line1: "целостность с ключом",
    col2Line2: "общий секрет",
    col2Line3: "cookie, webhook'ы",
    col3Title: "sign / verify",
    col3Line1: "недоверенные стороны",
    col3Line2: "приватный подписывает",
    col3Line3: "публичный проверяет",
    foot1: "HMAC делит силу подписи, подпись — разделяет",
    foot2: "релизы, JWT, лицензии — sign/verify",
    caption:
      "Обычный хэш доказывает, что байты не менялись; HMAC доказывает, что их произвёл владелец ключа; асимметричная подпись позволяет любому проверить то, что мог произвести только приватный ключ.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="110" width="220" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="150" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.col1Title}</text>
    <text x="150" y="166" text-anchor="middle" font-size="11" fill="var(--ink)">{t.col1Line1}</text>
    <text x="150" y="190" text-anchor="middle" font-size="11" fill="var(--ink)">{t.col1Line2}</text>
    <text x="150" y="214" text-anchor="middle" font-size="11" fill="var(--ink)">{t.col1Line3}</text>

    <rect x="290" y="110" width="220" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.col2Title}</text>
    <text x="400" y="166" text-anchor="middle" font-size="11" fill="var(--ink)">{t.col2Line1}</text>
    <text x="400" y="190" text-anchor="middle" font-size="11" fill="var(--ink)">{t.col2Line2}</text>
    <text x="400" y="214" text-anchor="middle" font-size="11" fill="var(--ink)">{t.col2Line3}</text>

    <rect x="540" y="110" width="220" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="650" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.col3Title}</text>
    <text x="650" y="166" text-anchor="middle" font-size="11" fill="var(--ink)">{t.col3Line1}</text>
    <text x="650" y="190" text-anchor="middle" font-size="11" fill="var(--ink)">{t.col3Line2}</text>
    <text x="650" y="214" text-anchor="middle" font-size="11" fill="var(--ink)">{t.col3Line3}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
