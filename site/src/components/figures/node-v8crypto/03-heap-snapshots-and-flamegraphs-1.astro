---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Heap snapshots and flame graphs are two lenses: a snapshot shows what memory is retained and by whom, a flame graph shows where CPU time goes",
    headline: "TWO LENSES, TWO QUESTIONS",
    sub: "match the tool to the question",
    leftHead: "HEAP SNAPSHOT",
    leftQ: "a memory question",
    leftLine1: "reachable object graph",
    leftLine2: "sort survivors: retained size",
    leftLine3: "3-snapshot diff names the leak",
    leftLine4: "retaining path -> anchor",
    rightHead: "FLAME GRAPH",
    rightQ: "a CPU question",
    rightLine1: "sampled call stacks",
    rightLine2: "width = share of CPU",
    rightLine3: "bare top = high self time",
    rightLine4: "plateaus = optimize",
    foot1: "a snapshot is blind to a hot loop",
    foot2: "a flame graph is blind to a leak",
    caption:
      "Two lenses, two questions: a snapshot finds what memory is retained and by whom; a flame graph finds where CPU time goes. Match the tool to the question — a snapshot is blind to a hot loop, a flame graph is blind to a leak.",
  },
  ru: {
    svgTitle: "Heap snapshot и flame graph — две линзы: снапшот показывает, что удерживается и кем, flame graph — куда уходит время CPU",
    headline: "ДВЕ ЛИНЗЫ, ДВА ВОПРОСА",
    sub: "подбирай инструмент под вопрос",
    leftHead: "HEAP-СНАПШОТ",
    leftQ: "вопрос памяти",
    leftLine1: "граф достижимых объектов",
    leftLine2: "сортируй по retained size",
    leftLine3: "diff трёх снапшотов — leak",
    leftLine4: "retaining path -> якорь",
    rightHead: "FLAME GRAPH",
    rightQ: "вопрос CPU",
    rightLine1: "сэмплированные стеки",
    rightLine2: "ширина — доля CPU",
    rightLine3: "голая вершина — self time",
    rightLine4: "плато — цели оптимизации",
    foot1: "снапшот слеп к горячему циклу",
    foot2: "flame graph слеп к утечке",
    caption:
      "Две оптики, два вопроса: снапшот находит, какая память удерживается и кем; flame graph находит, куда уходит время CPU. Подбирай инструмент под вопрос — снапшот слеп к горячему циклу, flame graph слеп к утечке.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="92" width="340" height="218" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="120" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftHead}</text>
    <text x="210" y="142" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftQ}</text>
    <text x="210" y="174" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine1}</text>
    <text x="210" y="202" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine2}</text>
    <text x="210" y="230" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine3}</text>
    <text x="210" y="258" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine4}</text>

    <rect x="420" y="92" width="340" height="218" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="590" y="120" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightHead}</text>
    <text x="590" y="142" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightQ}</text>
    <text x="590" y="174" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine1}</text>
    <text x="590" y="202" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine2}</text>
    <text x="590" y="230" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine3}</text>
    <text x="590" y="258" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine4}</text>

    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="376" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
