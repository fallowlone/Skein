---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Inline cache states at one property-access site: monomorphic with one shape is the fast path, polymorphic with two to four shapes is slower, megamorphic past four shapes falls off a cliff to a generic hash lookup",
    headline: "ONE SITE, THREE IC STATES",
    sub: "IC state predicts how fast the read runs",
    tagMono: "1 shape",
    monoName: "MONOMORPHIC",
    monoOut: "fast path",
    monoHow: "one compare-and-read, TurboFan inlines it",
    tagPoly: "2-4 shapes",
    polyName: "POLYMORPHIC",
    polyOut: "slower",
    polyHow: "small linear shape list, still optimisable",
    tagMega: "> 4 shapes",
    megaName: "MEGAMORPHIC",
    megaOut: "the cliff",
    megaHow: "generic hash-lookup stub, blocks optimisation",
    foot: "feed each hot call site objects of one shape",
    caption:
      "One access site degrades with shape variety: monomorphic (one shape) is the fast path, polymorphic (2-4 shapes) is slower but optimisable, megamorphic (past ~4 shapes) falls back to a generic hash lookup and blocks optimisation.",
  },
  ru: {
    svgTitle: "Состояния inline cache на одном месте доступа: monomorphic с одной формой — быстрый путь, polymorphic с двумя-четырьмя формами — медленнее, megamorphic за четырьмя формами — обрыв к обобщённому хэш-поиску",
    headline: "ОДНО МЕСТО, ТРИ СОСТОЯНИЯ IC",
    sub: "состояние IC решает скорость чтения",
    tagMono: "1 форма",
    monoName: "MONOMORPHIC",
    monoOut: "быстрый путь",
    monoHow: "одно сравнение-и-чтение",
    tagPoly: "2–4 формы",
    polyName: "POLYMORPHIC",
    polyOut: "медленнее",
    polyHow: "малый список форм, оптимизируемо",
    tagMega: "> 4 форм",
    megaName: "MEGAMORPHIC",
    megaOut: "обрыв",
    megaHow: "хэш-поиск-стаб, блок оптимизации",
    foot: "корми горячее место одной формой",
    caption:
      "Одно место доступа деградирует с ростом форм: monomorphic (одна форма) — быстрый путь, polymorphic (2–4 формы) — медленнее, но оптимизируемо, megamorphic (за ~4 формами) — откат к обобщённому хэш-поиску и блок оптимизации.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagMono}</text>
    <rect x="170" y="104" width="460" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="220" y="132" font-size="12" fill="var(--ink)">{t.monoName}</text>
    <text x="590" y="132" text-anchor="end" font-size="11" fill="var(--accent)">{t.monoOut}</text>
    <text x="220" y="154" font-size="11" fill="var(--ink)">{t.monoHow}</text>

    <text x="150" y="216" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagPoly}</text>
    <rect x="170" y="184" width="460" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="220" y="212" font-size="12" fill="var(--ink)">{t.polyName}</text>
    <text x="590" y="212" text-anchor="end" font-size="11" fill="var(--muted)">{t.polyOut}</text>
    <text x="220" y="234" font-size="11" fill="var(--ink)">{t.polyHow}</text>

    <text x="150" y="296" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagMega}</text>
    <rect x="170" y="264" width="460" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="220" y="292" font-size="12" fill="var(--ink)">{t.megaName}</text>
    <text x="590" y="292" text-anchor="end" font-size="11" fill="var(--muted)">{t.megaOut}</text>
    <text x="220" y="314" font-size="11" fill="var(--ink)">{t.megaHow}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
