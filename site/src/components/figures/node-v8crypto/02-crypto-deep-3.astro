---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Two silent footguns: Math.random is predictable and must never generate secrets — use randomBytes; triple-equals early-exits and leaks timing — use timingSafeEqual on equal-length Buffers",
    headline: "SECRETS AND COMPARISONS",
    sub: "predictable bytes and leaky checks are the silent bugs",
    rowSecrets: "RANDOMNESS",
    wrongSecretsTitle: "Math.random() — wrong",
    wrongSecretsLine1: "predictable, not a CSPRNG",
    wrongSecretsLine2: "never tokens, salts, IDs",
    rightSecretsTitle: "randomBytes — right",
    rightSecretsLine1: "CSPRNG for raw bytes",
    rightSecretsLine2: "randomUUID() for IDs",
    rowCompare: "COMPARISON",
    wrongCompareTitle: "=== — wrong",
    wrongCompareLine1: "early exit leaks timing",
    wrongCompareLine2: "byte-by-byte recovery",
    rightCompareTitle: "timingSafeEqual — right",
    rightCompareLine1: "constant-time compare",
    rightCompareLine2: "equal-length Buffers only",
    foot: "hash both sides first, or length-check — it throws otherwise",
    caption:
      "Generate every secret, salt, and ID with randomBytes or randomUUID, never Math.random; compare secrets with timingSafeEqual on equal-length Buffers, never triple-equals.",
  },
  ru: {
    svgTitle: "Два тихих footgun'а: Math.random предсказуем и никогда не должен генерировать секреты — используй randomBytes; тройное равно выходит рано и утекает тайминг — используй timingSafeEqual на Buffer равной длины",
    headline: "СЕКРЕТЫ И СРАВНЕНИЯ",
    sub: "предсказуемые байты и утекающий тайминг — тихие баги",
    rowSecrets: "СЛУЧАЙНОСТЬ",
    wrongSecretsTitle: "Math.random() — неверно",
    wrongSecretsLine1: "предсказуем, не CSPRNG",
    wrongSecretsLine2: "не для токенов и salt",
    rightSecretsTitle: "randomBytes — верно",
    rightSecretsLine1: "CSPRNG для сырых байтов",
    rightSecretsLine2: "randomUUID() для ID",
    rowCompare: "СРАВНЕНИЕ",
    wrongCompareTitle: "=== — неверно",
    wrongCompareLine1: "ранний выход: утекает тайминг",
    wrongCompareLine2: "восстановление по байту",
    rightCompareTitle: "timingSafeEqual — верно",
    rightCompareLine1: "сравнение за константное время",
    rightCompareLine2: "Buffer равной длины",
    foot: "приведи к равной длине хэшем — иначе исключение",
    caption:
      "Генерируй каждый секрет, salt и ID через randomBytes или randomUUID, никогда Math.random; сравнивай секреты через timingSafeEqual на Buffer равной длины, никогда тройным равно.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="40" y="95" font-size="11" fill="var(--muted)">{t.rowSecrets}</text>
    <rect x="40" y="115" width="350" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="215" y="145" text-anchor="middle" font-size="12" fill="var(--ink)">{t.wrongSecretsTitle}</text>
    <text x="215" y="169" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wrongSecretsLine1}</text>
    <text x="215" y="193" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wrongSecretsLine2}</text>

    <rect x="410" y="115" width="350" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="585" y="145" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightSecretsTitle}</text>
    <text x="585" y="169" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightSecretsLine1}</text>
    <text x="585" y="193" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightSecretsLine2}</text>

    <text x="40" y="235" font-size="11" fill="var(--muted)">{t.rowCompare}</text>
    <rect x="40" y="255" width="350" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="215" y="285" text-anchor="middle" font-size="12" fill="var(--ink)">{t.wrongCompareTitle}</text>
    <text x="215" y="309" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wrongCompareLine1}</text>
    <text x="215" y="333" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wrongCompareLine2}</text>

    <rect x="410" y="255" width="350" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="585" y="285" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightCompareTitle}</text>
    <text x="585" y="309" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightCompareLine1}</text>
    <text x="585" y="333" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightCompareLine2}</text>

    <text x="400" y="390" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
