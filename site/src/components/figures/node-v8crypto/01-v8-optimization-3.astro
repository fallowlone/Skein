---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three shape-breakers that force dictionary mode and deopts, each with its fix: same-order construction, undefined instead of delete, one shape before the hot path",
    headline: "THREE BREAKERS, THREE FIXES",
    sub: "stable shapes stay on TurboFan",
    badHead: "BREAKS THE SHAPE",
    goodHead: "KEEPS THE SHAPE",
    bad1: "add props out of order",
    good1: "same props, same order",
    bad2: "delete obj.temp",
    good2: "obj.temp = undefined",
    bad3: "five payload shapes in",
    good3: "normalise to one shape",
    foot: "no recovery from dictionary mode — fix it",
    caption:
      "Three shape-breakers push hot objects off the fast path with no automatic recovery: out-of-order properties, delete, and mixed payload shapes. The fixes are same-order construction, = undefined or a rebuilt object, and one normalised shape before the hot path.",
  },
  ru: {
    svgTitle: "Три разрушителя формы, гонящие в dictionary mode и деопты, и их правки: конструирование в том же порядке, undefined вместо delete, одна форма до горячего пути",
    headline: "ТРИ РАЗРУШИТЕЛЯ, ТРИ ПРАВКИ",
    sub: "стабильные формы держат TurboFan",
    badHead: "ЛОМАЕТ ФОРМУ",
    goodHead: "ДЕРЖИТ ФОРМУ",
    bad1: "свойства не по порядку",
    good1: "те же свойства, тот же порядок",
    bad2: "delete obj.temp",
    good2: "obj.temp = undefined",
    bad3: "пять форм payload внутрь",
    good3: "нормализуй к одной форме",
    foot: "возврата из dictionary mode нет",
    caption:
      "Три разрушителя сдвигают горячие объекты с быстрого пути без автовосстановления: свойства не по порядку, delete и смешанные формы payload. Правки — конструирование в том же порядке, = undefined или пересборка объекта и одна нормализованная форма до горячего пути.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="290" y="100" text-anchor="middle" font-size="12" fill="var(--muted)">{t.badHead}</text>
    <text x="620" y="100" text-anchor="middle" font-size="12" fill="var(--accent)">{t.goodHead}</text>

    <rect x="170" y="116" width="240" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="290" y="149" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bad1}</text>
    <rect x="500" y="116" width="240" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="620" y="149" text-anchor="middle" font-size="11" fill="var(--ink)">{t.good1}</text>

    <rect x="170" y="196" width="240" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="290" y="229" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bad2}</text>
    <rect x="500" y="196" width="240" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="620" y="229" text-anchor="middle" font-size="11" fill="var(--ink)">{t.good2}</text>

    <rect x="170" y="276" width="240" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="290" y="309" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bad3}</text>
    <rect x="500" y="276" width="240" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="620" y="309" text-anchor="middle" font-size="11" fill="var(--ink)">{t.good3}</text>

    <text x="400" y="376" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
