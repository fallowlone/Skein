---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Hidden class transitions: adding x then y lands on shared class C2, but adding y then x takes a divergent path to a second class C2-prime",
    headline: "SAME FIELDS, DIFFERENT ORDER — DIFFERENT CLASS",
    sub: "construction order is load-bearing",
    leftTag: "same order",
    leftStep1: "p.x = a   C0 -> C1",
    leftStep2: "p.y = b   C1 -> C2",
    leftRes: "p1, p2 share C2: one type",
    rightTag: "other order",
    rightStep1: "q.y = 2   C0 -> C1'",
    rightStep2: "q.x = 1   C1' -> C2'",
    rightRes: "C2' != C2: second class",
    foot: "offset read needs one shared C2 — divergent paths lose it",
    caption:
      "Two objects with identical fields but different construction order land on different hidden classes: x-then-y shares C2, y-then-x diverges to C2-prime.",
  },
  ru: {
    svgTitle: "Переходы hidden class: добавление x затем y ведёт в общий класс C2, а добавление y затем x — расходящимся путём во второй класс C2-штрих",
    headline: "ТЕ ЖЕ ПОЛЯ, ДРУГОЙ ПОРЯДОК — ДРУГОЙ КЛАСС",
    sub: "порядок конструирования несущий",
    leftTag: "тот же порядок",
    leftStep1: "p.x = a   C0 -> C1",
    leftStep2: "p.y = b   C1 -> C2",
    leftRes: "p1, p2 делят C2: один тип",
    rightTag: "другой порядок",
    rightStep1: "q.y = 2   C0 -> C1'",
    rightStep2: "q.x = 1   C1' -> C2'",
    rightRes: "C2' != C2: второй класс",
    foot: "чтение по смещению ждёт один C2",
    caption:
      "Два объекта с одинаковыми полями, но разным порядком конструирования, попадают в разные hidden class: x-затем-y делит C2, y-затем-x расходится в C2-штрих.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.leftTag}</text>
    <rect x="170" y="104" width="240" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="290" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftStep1}</text>
    <text x="290" y="158" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftStep2}</text>
    <text x="290" y="186" text-anchor="middle" font-size="11" fill="var(--accent)">{t.leftRes}</text>

    <text x="150" y="276" text-anchor="end" font-size="11" fill="var(--muted)">{t.rightTag}</text>
    <rect x="170" y="244" width="240" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="290" y="274" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightStep1}</text>
    <text x="290" y="298" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightStep2}</text>
    <text x="290" y="326" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightRes}</text>

    <text x="610" y="150" text-anchor="middle" font-size="13" fill="var(--accent)">C0 → C1 → C2</text>
    <text x="610" y="174" text-anchor="middle" font-size="11" fill="var(--muted)">x then y</text>
    <text x="610" y="290" text-anchor="middle" font-size="13" fill="var(--ink)">C0 → C1' → C2'</text>
    <text x="610" y="314" text-anchor="middle" font-size="11" fill="var(--muted)">y then x</text>

    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
