---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three-snapshot technique: baseline, exercise the suspected path, snapshot, exercise again, snapshot, then diff snapshot 3 against snapshot 1 to name the leak",
    headline: "THREE SNAPSHOTS NAME THE LEAK",
    sub: "baseline, exercise, diff — survivors are suspects",
    n1h: "SNAPSHOT 1",
    n1s: "baseline",
    n2h: "EXERCISE",
    n2s: "N requests",
    n3h: "SNAPSHOT 2",
    n3s: "after work",
    n4h: "EXERCISE",
    n4s: "N requests",
    n5h: "SNAPSHOT 3",
    n5s: "after work",
    diffH: "DIFF 3 vs 1",
    diffS: "survivors = the leak",
    churnLine: "churn: delta returns to ~0",
    leakLine: "leak: # New grows, # Deleted ~ 0",
    foot: "linear repeatable growth — not raw size — is the signature",
    caption:
      "Take a baseline, exercise the suspected path, snapshot, exercise again, snapshot. In the Comparison view between snapshots 1 and 3, objects allocated after snapshot 1 and still alive at snapshot 3 are the leak — work-scoped allocations that should have been freed but were not.",
  },
  ru: {
    svgTitle: "Техника трёх снапшотов: базлайн, прогон подозреваемого пути, снапшот, прогон снова, снапшот, затем diff снапшота 3 против снапшота 1 называет leak",
    headline: "ТРИ СНАПШОТА НАЗЫВАЮТ LEAK",
    sub: "базлайн, прогон, diff — выжившие под подозрением",
    n1h: "СНАПШОТ 1",
    n1s: "базлайн",
    n2h: "ПРОГОН",
    n2s: "N запросов",
    n3h: "СНАПШОТ 2",
    n3s: "после работы",
    n4h: "ПРОГОН",
    n4s: "N запросов",
    n5h: "СНАПШОТ 3",
    n5s: "после работы",
    diffH: "DIFF 3 vs 1",
    diffS: "выжившие = leak",
    churnLine: "churn: дельта возвращается к ~0",
    leakLine: "leak: # New растёт, # Deleted ~ 0",
    foot: "подпись — линейный рост, а не размер",
    caption:
      "Сними базлайн, прогони подозреваемый путь, снапшот, прогони ещё раз, снапшот. В виде Comparison между снапшотами 1 и 3 объекты, выделенные после снапшота 1 и всё ещё живые на снапшоте 3, — это leak: work-scoped аллокации, которые должны были освободиться, но не освободились.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="42" y="92" width="124" height="108" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="104" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.n1h}</text>
    <text x="104" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.n1s}</text>

    <rect x="190" y="92" width="124" height="108" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="252" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.n2h}</text>
    <text x="252" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.n2s}</text>

    <rect x="338" y="92" width="124" height="108" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.n3h}</text>
    <text x="400" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.n3s}</text>

    <rect x="486" y="92" width="124" height="108" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="548" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.n4h}</text>
    <text x="548" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.n4s}</text>

    <rect x="634" y="92" width="124" height="108" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="696" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.n5h}</text>
    <text x="696" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.n5s}</text>

    <line x1="170" y1="146" x2="182" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="182,141 182,151 190,146" fill="var(--muted)" />
    <line x1="318" y1="146" x2="330" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="330,141 330,151 338,146" fill="var(--muted)" />
    <line x1="466" y1="146" x2="478" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="478,141 478,151 486,146" fill="var(--muted)" />
    <line x1="614" y1="146" x2="626" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="626,141 626,151 634,146" fill="var(--muted)" />

    <line x1="696" y1="200" x2="696" y2="224" stroke="var(--muted)" stroke-width="2" />
    <line x1="696" y1="224" x2="400" y2="224" stroke="var(--muted)" stroke-width="2" />
    <line x1="400" y1="224" x2="400" y2="244" stroke="var(--muted)" stroke-width="2" />
    <polygon points="393,244 407,244 400,252" fill="var(--muted)" />

    <rect x="200" y="252" width="400" height="108" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="284" text-anchor="middle" font-size="13" fill="var(--ink)">{t.diffH}</text>
    <text x="400" y="308" text-anchor="middle" font-size="11" fill="var(--muted)">{t.diffS}</text>
    <text x="400" y="332" text-anchor="middle" font-size="12" fill="var(--muted)">{t.churnLine}</text>
    <text x="400" y="354" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leakLine}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
