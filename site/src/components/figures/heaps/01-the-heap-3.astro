---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Min-heap tree and its flat array [1, 3, 2, 5, 4] with index arithmetic",
    headline: "SAME NODES, FLAT ARRAY",
    formula: "children of i at 2i+1, 2i+2 · parent at ⌊(i−1)/2⌋",
    cost: "no pointers — index math only",
    treeLabel: "tree",
    arrayLabel: "array [1, 3, 2, 5, 4]",
    note: "root lives at index 0 · 0 → children 1, 2 · 1 → children 3, 4",
    caption:
      "Takeaway: the complete shape gives the breadth-first array layout and the order gives the root guarantee — together a heap needs no pointers, only index math.",
  },
  ru: {
    svgTitle: "Дерево мин-кучи и его плоский массив [1, 3, 2, 5, 4] с арифметикой индексов",
    headline: "ТЕ ЖЕ УЗЛЫ — ПЛОСКИЙ МАССИВ",
    formula: "дети i в 2i+1, 2i+2 · родитель в ⌊(i−1)/2⌋",
    cost: "без указателей — только арифметика",
    treeLabel: "дерево",
    arrayLabel: "массив [1, 3, 2, 5, 4]",
    note: "корень — индекс 0 · 0 → дети 1, 2 · 1 → дети 3, 4",
    caption:
      "Вывод: полная форма даёт раскладку массива в ширину, а порядок — гарантию корня: куче не нужны указатели, хватает арифметики индексов.",
  },
};

const t = dict[lang];

// Same five nodes as the lesson's min-heap, tagged with breadth-first indices.
const nodes = [
  { v: "1", i: "i=0", x: 180, y: 138, r: 23 },
  { v: "3", i: "i=1", x: 105, y: 213, r: 22 },
  { v: "2", i: "i=2", x: 258, y: 213, r: 22 },
  { v: "5", i: "i=3", x: 68, y: 293, r: 21 },
  { v: "4", i: "i=4", x: 150, y: 293, r: 21 },
];
const edges: Array<[number, number]> = [
  [0, 1],
  [0, 2],
  [1, 3],
  [1, 4],
];

// The flat array: index row above, values [1, 3, 2, 5, 4].
const cells = [
  { idx: "0", v: "1", y: 132 },
  { idx: "1", v: "3", y: 184 },
  { idx: "2", v: "2", y: 236 },
  { idx: "3", v: "5", y: 288 },
  { idx: "4", v: "4", y: 340 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="30" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="54" text-anchor="middle" font-size="13" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="76" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>

    <text x="180" y="100" text-anchor="middle" font-size="13" fill="var(--muted)">{t.treeLabel}</text>
    <text x="565" y="100" text-anchor="middle" font-size="13" fill="var(--muted)">{t.arrayLabel}</text>

    {edges.map(([a, b]) => (
      <line
        x1={nodes[a].x}
        y1={nodes[a].y}
        x2={nodes[b].x}
        y2={nodes[b].y}
        stroke="var(--ink)"
        stroke-width="2"
      />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r={n.r} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="15" fill="var(--ink)">{n.v}</text>
        <text x={n.x} y={n.y + n.r + 13} text-anchor="middle" font-size="11" fill="var(--accent)">{n.i}</text>
      </g>
    ))}

    {cells.map((c) => (
      <g>
        <rect x="430" y={c.y - 22} width="270" height="44" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="452" y={c.y + 5} font-size="14" fill="var(--accent)">{c.idx}</text>
        <text x="590" y={c.y + 6} text-anchor="middle" font-size="17" fill="var(--ink)">{c.v}</text>
      </g>
    ))}

    <text x="400" y="398" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
