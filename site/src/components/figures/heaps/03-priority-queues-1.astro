---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Chaotic arrival compile p5, deploy p2, test p3, doc p7; min-heap keeps p2 on top; exit order deploy, test, compile, doc",
    headline: "ARRIVE ANY ORDER, LEAVE BY PRIORITY",
    formula: "arrival: compile p5 · deploy p2 · test p3 · doc p7",
    cost: "min-heap keeps p2 on top · peek = deploy · extractMin × 4",
    arrivalLabel: "arrival order (chaos)",
    exitLabel: "exit order (priority)",
    exitNote: "deploy p2 → test p3 → compile p5 → doc p7",
    bottom: "arrival order never decides exit order",
    caption: "Arrival order never decides exit order: compile p5, deploy p2, test p3, doc p7 arrive in chaos, the min-heap keeps p2 on top, and extractMin serves deploy, test, compile, doc — the contract holds in O(log n).",
  },
  ru: {
    svgTitle: "Хаотичный приход compile p5, deploy p2, test p3, doc p7; мин-куча держит p2 наверху; порядок выхода deploy, test, compile, doc",
    headline: "ПРИХОД В ЛЮБОМ ПОРЯДКЕ, ВЫХОД ПО ПРИОРИТЕТУ",
    formula: "приход: compile p5 · deploy p2 · test p3 · doc p7",
    cost: "мин-куча держит p2 наверху · peek = deploy · extractMin × 4",
    arrivalLabel: "порядок прихода (хаос)",
    exitLabel: "порядок выхода (приоритет)",
    exitNote: "deploy p2 → test p3 → compile p5 → doc p7",
    bottom: "порядок прихода никогда не решает порядок выхода",
    caption: "Порядок прихода никогда не решает порядок выхода: compile p5, deploy p2, test p3, doc p7 приходят хаотично, мин-куча держит p2 наверху, а extractMin обслуживает deploy, test, compile, doc — контракт держится за O(log n).",
  },
};

const t = dict[lang];

// Arrival order (chaos) from the poster sub + CodeRunner inserts.
const arrival = [
  { name: "compile", p: "p5" },
  { name: "deploy", p: "p2" },
  { name: "test", p: "p3" },
  { name: "doc", p: "p7" },
];

// Exit order (priority) from the CodeRunner expected output.
const exitOrder = [
  { name: "deploy", p: "p2" },
  { name: "test", p: "p3" },
  { name: "compile", p: "p5" },
  { name: "doc", p: "p7" },
];

const colX = [110, 303, 496, 689];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="82" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>

    <text x="400" y="112" text-anchor="middle" font-size="12" fill="var(--muted)">{t.arrivalLabel}</text>
    {arrival.map((a, i) => (
      <g>
        <rect x={colX[i] - 80} y="122" width="160" height="56" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={colX[i]} y="146" text-anchor="middle" font-size="16" fill="var(--ink)">{a.name}</text>
        <text x={colX[i]} y="168" text-anchor="middle" font-size="13" fill="var(--muted)">{a.p}</text>
      </g>
    ))}

    <g>
      <path d="M 400 190 L 400 214" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <polygon points="394,214 406,214 400,226" fill="var(--accent)" />
    </g>

    <text x="400" y="250" text-anchor="middle" font-size="12" fill="var(--muted)">{t.exitLabel}</text>
    {exitOrder.map((a, i) => (
      <g>
        <rect x={colX[i] - 80} y="260" width="160" height="56" rx="10" fill="var(--card)" stroke={i === 0 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={colX[i]} y="284" text-anchor="middle" font-size="16" fill="var(--ink)">{a.name}</text>
        <text x={colX[i]} y="306" text-anchor="middle" font-size="13" fill="var(--muted)">{a.p}</text>
        {i < 3 && (
          <g>
            <path d={`M ${colX[i] + 80} 288 L ${colX[i + 1] - 80} 288`} fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <polygon points={`${colX[i + 1] - 80},282 ${colX[i + 1] - 80},294 ${colX[i + 1] - 68},288`} fill="var(--ink)" />
          </g>
        )}
      </g>
    ))}

    <text x="400" y="352" text-anchor="middle" font-size="15" fill="var(--accent)">{t.exitNote}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bottom}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
