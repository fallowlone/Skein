---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Complete tree with 7 nodes versus a non-complete tree with a gap",
    headline: "COMPLETE: NO GAPS, LEFT TO RIGHT",
    sub: "every level full except the last · last filled left to right",
    leftTitle: "complete ✓",
    leftNote: "levels 0–2 all full",
    rightTitle: "not complete ✗",
    rightNote: "node 2 misses its right child",
    note: "no gaps → breadth-first numbering works",
    caption:
      "Shape rule: every level full except the last, last filled left to right. The right tree fails — node 3 has a right child (5) while node 2 still misses one — and that gap breaks the array layout.",
  },
  ru: {
    svgTitle: "Полное дерево с 7 узлами и неполное дерево с пропуском",
    headline: "ПОЛНОЕ: БЕЗ ПРОПУСКОВ, СЛЕВА НАПРАВО",
    sub: "каждый уровень полон кроме последнего · последний заполнен слева направо",
    leftTitle: "полное ✓",
    leftNote: "уровни 0–2 заполнены",
    rightTitle: "неполное ✗",
    rightNote: "у узла 2 нет правого ребёнка",
    note: "без пропусков → нумерация в ширину работает",
    caption:
      "Правило формы: каждый уровень полон кроме последнего, последний заполнен слева направо. Правое дерево не подходит — у узла 3 есть правый ребёнок (5), а у узла 2 его нет — и этот пропуск ломает раскладку в массиве.",
  },
};

const t = dict[lang];

// Left: complete tree with 7 nodes (levels 0-2 full).
const leftNodes = [
  { v: "1", x: 225, y: 132 },
  { v: "2", x: 140, y: 212 },
  { v: "3", x: 310, y: 212 },
  { v: "4", x: 95, y: 292 },
  { v: "5", x: 185, y: 292 },
  { v: "6", x: 265, y: 292 },
  { v: "7", x: 355, y: 292 },
];
const leftEdges: Array<[number, number]> = [
  [0, 1],
  [0, 2],
  [1, 3],
  [1, 4],
  [2, 5],
  [2, 6],
];
const levelY = [132, 212, 292];

// Right: NOT complete — node 2 has only a left child (4), node 3 only a right child (5).
const rightNodes = [
  { v: "1", x: 590, y: 132 },
  { v: "2", x: 505, y: 212 },
  { v: "3", x: 675, y: 212 },
  { v: "4", x: 450, y: 292 },
  { v: "5", x: 720, y: 292 },
];
const rightEdges: Array<[number, number]> = [
  [0, 1],
  [0, 2],
  [1, 3],
  [2, 4],
];
// Dashed empty slots: right child of 2 and left child of 3.
const gaps = [
  { x: 555, y: 292, from: 1 },
  { x: 628, y: 292, from: 2 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="215" y="96" text-anchor="middle" font-size="14" fill="var(--ink)">{t.leftTitle}</text>
    <text x="590" y="96" text-anchor="middle" font-size="14" fill="var(--ink)">{t.rightTitle}</text>

    {leftEdges.map(([a, b]) => (
      <line
        x1={leftNodes[a].x}
        y1={leftNodes[a].y}
        x2={leftNodes[b].x}
        y2={leftNodes[b].y}
        stroke="var(--ink)"
        stroke-width="2"
      />
    ))}
    {levelY.map((y, lvl) => (
      <text x="56" y={y + 4} text-anchor="middle" font-size="12" fill="var(--muted)">{lvl}</text>
    ))}
    {leftNodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="20" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="14" fill="var(--ink)">{n.v}</text>
      </g>
    ))}
    <text x="215" y="340" text-anchor="middle" font-size="13" fill="var(--muted)">{t.leftNote}</text>

    {rightEdges.map(([a, b]) => (
      <line
        x1={rightNodes[a].x}
        y1={rightNodes[a].y}
        x2={rightNodes[b].x}
        y2={rightNodes[b].y}
        stroke="var(--ink)"
        stroke-width="2"
      />
    ))}
    {gaps.map((g) => (
      <g>
        <line
          x1={rightNodes[g.from].x}
          y1={rightNodes[g.from].y}
          x2={g.x}
          y2={g.y}
          stroke="var(--muted)"
          stroke-width="2"
          stroke-dasharray="5 4"
        />
        <circle cx={g.x} cy={g.y} r="20" fill="none" stroke="var(--muted)" stroke-width="2" stroke-dasharray="5 4" />
        <text x={g.x} y={g.y + 5} text-anchor="middle" font-size="14" fill="var(--muted)">✗</text>
      </g>
    ))}
    {rightNodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="20" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="14" fill="var(--ink)">{n.v}</text>
      </g>
    ))}
    <text x="590" y="340" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rightNote}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
