---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Cost comparison: size-k heap versus sorting everything",
    headline: "ONE COMPARE PER ELEMENT BEATS SORTING",
    sub: "example: n = 1,000,000 · k = 10",
    heapTitle: "size-k min-heap",
    heapTime: "time O(n log k)",
    heapSpace: "space O(k)",
    sortTitle: "sort everything",
    sortTime: "time O(n log n)",
    sortSpace: "space O(n)",
    heapBar: "heap",
    sortBar: "sort",
    heapOps: "≈ 3.3M ops",
    sortOps: "≈ 20M ops",
    band: "k ≪ n → heap wins · keep only k candidates",
    caption:
      "One compare per element beats sorting everything: O(n log k) time and O(k) space versus O(n log n). At n = 1,000,000 and k = 10 the heap needs ≈3.3M operations against ≈20M for sorting — when k ≪ n, keep only k candidates and let the root guard them.",
  },
  ru: {
    svgTitle: "Сравнение цены: куча размера k против сортировки всего",
    headline: "ОДНО СРАВНЕНИЕ НА ЭЛЕМЕНТ БЬЁТ СОРТИРОВКУ",
    sub: "пример: n = 1,000,000 · k = 10",
    heapTitle: "мин-куча размера k",
    heapTime: "время O(n log k)",
    heapSpace: "память O(k)",
    sortTitle: "сортировка всего",
    sortTime: "время O(n log n)",
    sortSpace: "память O(n)",
    heapBar: "куча",
    sortBar: "сортировка",
    heapOps: "≈ 3.3 млн оп.",
    sortOps: "≈ 20 млн оп.",
    band: "k ≪ n → куча выигрывает · держи только k кандидатов",
    caption:
      "Одно сравнение на элемент бьёт сортировку всего: O(n log k) времени и O(k) памяти против O(n log n). При n = 1,000,000 и k = 10 куче нужно ≈3.3 миллиона операций против ≈20 миллионов у сортировки — когда k ≪ n, держи только k кандидатов и поставь корень стражем.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <text
      x="40"
      y="46"
      font-family="var(--font-display)"
      font-size="22"
      fill="var(--ink)">{t.headline}</text
    >
    <text
      x="40"
      y="74"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.sub}</text
    >
    <!-- heap panel -->
    <rect
      x="40"
      y="100"
      width="350"
      height="150"
      rx="10"
      fill="var(--card)"
      stroke="var(--accent)"
      stroke-width="2"></rect>
    <text
      x="215"
      y="132"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--ink)">{t.heapTitle}</text
    >
    <text
      x="215"
      y="162"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="16"
      fill="var(--ink)">{t.heapTime}</text
    >
    <text
      x="215"
      y="192"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="16"
      fill="var(--ink)">{t.heapSpace}</text
    >
    <text
      x="215"
      y="224"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--accent)">{t.heapOps}</text
    >
    <!-- sort panel -->
    <rect
      x="410"
      y="100"
      width="350"
      height="150"
      rx="10"
      fill="none"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="585"
      y="132"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--ink)">{t.sortTitle}</text
    >
    <text
      x="585"
      y="162"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="16"
      fill="var(--ink)">{t.sortTime}</text
    >
    <text
      x="585"
      y="192"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="16"
      fill="var(--muted)">{t.sortSpace}</text
    >
    <text
      x="585"
      y="224"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--muted)">{t.sortOps}</text
    >
    <!-- bars: 20px per million ops -->
    <text
      x="200"
      y="298"
      text-anchor="end"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--ink)">{t.heapBar}</text
    >
    <rect x="220" y="278" width="66" height="26" rx="6" fill="var(--accent)"></rect>
    <text
      x="298"
      y="298"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--ink)">{t.heapOps}</text
    >
    <text
      x="200"
      y="338"
      text-anchor="end"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--ink)">{t.sortBar}</text
    >
    <rect
      x="220"
      y="318"
      width="400"
      height="26"
      rx="6"
      fill="var(--card)"
      stroke="var(--muted)"
      stroke-width="2"></rect>
    <text
      x="632"
      y="338"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.sortOps}</text
    >
    <text
      x="400"
      y="388"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--accent)">{t.band}</text
    >
  </svg>
  <figcaption class="text-center">{t.caption}</figcaption>
</figure>
