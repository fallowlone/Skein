---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Min-heap gate: newcomer 8 admitted, newcomer 2 discarded",
    headline: "THE ROOT IS THE GATE",
    sub: "min-heap k = 3 holds [5, 6, 7] · peek = 5",
    gate: "GATE = 5",
    rootNote: "root = k-th largest so far",
    firstTitle: "① newcomer 8",
    firstVerdict: "8 > 5 → admit",
    firstAction: "pop 5 · push 8 → [6, 8, 7]",
    secondTitle: "② newcomer 2",
    secondVerdict: "2 < 6 → discard",
    secondNote: "never in top k",
    band: "the heap never holds more than k",
    caption:
      "The root is the admission gate: newcomer 8 beats root 5, so pop 5 and push 8 (heap becomes [6, 8, 7]); newcomer 2 loses to gate 6 and is discarded. The heap never holds more than k.",
  },
  ru: {
    svgTitle: "Ворота мин-кучи: новичок 8 допущен, новичок 2 отброшен",
    headline: "КОРЕНЬ — ЭТО ВОРОТА",
    sub: "мин-куча k = 3 держит [5, 6, 7] · peek = 5",
    gate: "ВОРОТА = 5",
    rootNote: "корень = k-й наибольший пока",
    firstTitle: "① новичок 8",
    firstVerdict: "8 > 5 → допустить",
    firstAction: "вытолкни 5 · втолкни 8 → [6, 8, 7]",
    secondTitle: "② новичок 2",
    secondVerdict: "2 < 6 → отбросить",
    secondNote: "в топ-k не входит",
    band: "куча никогда не держит больше k",
    caption:
      "Корень — ворота допуска: новичок 8 бьёт корень 5 — вытолкни 5 и втолкни 8 (куча становится [6, 8, 7]); новичок 2 проигрывает воротам 6 и отбрасывается. Куча никогда не держит больше k.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <defs>
      <marker
        id="tk1-arr"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text
      x="40"
      y="46"
      font-family="var(--font-display)"
      font-size="25"
      fill="var(--ink)">{t.headline}</text
    >
    <text
      x="40"
      y="74"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--muted)">{t.sub}</text
    >
    <!-- gate pill above root -->
    <rect
      x="160"
      y="106"
      width="200"
      height="32"
      rx="16"
      fill="var(--card)"
      stroke="var(--accent)"
      stroke-width="2"></rect>
    <text
      x="260"
      y="128"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--accent)">{t.gate}</text
    >
    <!-- edges first, circles over them -->
    <line x1="260" y1="195" x2="160" y2="315" stroke="var(--muted)" stroke-width="2"></line>
    <line x1="260" y1="195" x2="360" y2="315" stroke="var(--muted)" stroke-width="2"></line>
    <circle cx="260" cy="195" r="32" fill="var(--card)" stroke="var(--accent)" stroke-width="3"></circle>
    <text
      x="260"
      y="202"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="18"
      fill="var(--ink)">5</text
    >
    <circle cx="160" cy="315" r="28" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <text
      x="160"
      y="322"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="18"
      fill="var(--ink)">6</text
    >
    <circle cx="360" cy="315" r="28" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <text
      x="360"
      y="322"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="18"
      fill="var(--ink)">7</text
    >
    <text
      x="260"
      y="368"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="12"
      fill="var(--muted)">{t.rootNote}</text
    >
    <!-- admit arrow: card 1 into the heap -->
    <line
      x1="462"
      y1="176"
      x2="314"
      y2="190"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-linecap="round"
      marker-end="url(#tk1-arr)"></line>
    <!-- turned-away stub: card 2 blocked -->
    <line
      x1="462"
      y1="305"
      x2="424"
      y2="305"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-linecap="round"
      marker-end="url(#tk1-arr)"></line>
    <text
      x="404"
      y="311"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="16"
      fill="var(--muted)">✕</text
    >
    <!-- card 1: 8 admitted -->
    <rect
      x="470"
      y="118"
      width="290"
      height="116"
      rx="10"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="615"
      y="146"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--ink)">{t.firstTitle}</text
    >
    <text
      x="615"
      y="172"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--ink)">{t.firstVerdict}</text
    >
    <text
      x="615"
      y="200"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="12"
      fill="var(--muted)">{t.firstAction}</text
    >
    <!-- card 2: 2 discarded -->
    <rect
      x="470"
      y="248"
      width="290"
      height="114"
      rx="10"
      fill="none"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-dasharray="6 4"></rect>
    <text
      x="615"
      y="276"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--ink)">{t.secondTitle}</text
    >
    <text
      x="615"
      y="302"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--ink)">{t.secondVerdict}</text
    >
    <text
      x="615"
      y="328"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="12"
      fill="var(--muted)">{t.secondNote}</text
    >
    <text
      x="400"
      y="398"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--accent)">{t.band}</text
    >
  </svg>
  <figcaption class="text-center">{t.caption}</figcaption>
</figure>
