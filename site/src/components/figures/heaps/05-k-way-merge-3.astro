---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Naive scan costs O(nk); the size-k heap costs O(n log k)",
    headline: "NO SCANS: O(nk) TO O(n log k)",
    subline: "n = 1,000,000 elements · k = 100 lists",
    naive: "naive",
    naiveStep: "scan k heads per step",
    naiveCost: "1,000,000 × 100 = 100M",
    heap: "size-k heap",
    heapStep: "pop + push: O(log k) per element",
    heapCost: "1,000,000 × 6.6 ≈ 6.6M",
    faster: "~15× faster · O(k) space",
    caption:
      "Scanning k heads per step costs O(nk) — 100M operations for n = 1,000,000, k = 100. The heap finds the min without scans and refills in O(log k): ~6.6M operations, ~15× faster, O(k) space.",
  },
  ru: {
    svgTitle: "Наивный скан стоит O(nk); куча размера k — O(n log k)",
    headline: "БЕЗ СКАНОВ: ОТ O(nk) К O(n log k)",
    subline: "n = 1,000,000 элементов · k = 100 списков",
    naive: "наивный",
    naiveStep: "скан k голов на шаг",
    naiveCost: "1,000,000 × 100 = 100 млн",
    heap: "куча размера k",
    heapStep: "вытолкни + втолкни: O(log k) на элемент",
    heapCost: "1,000,000 × 6.6 ≈ 6.6 млн",
    faster: "~15 раз быстрее · O(k) памяти",
    caption:
      "Скан k голов на шаг стоит O(nk) — 100 миллионов операций при n = 1,000,000, k = 100. Куча находит минимум без сканов и пополняется за O(log k): ~6.6 миллиона операций, ~15 раз быстрее, O(k) памяти.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <text
      x="40"
      y="46"
      font-family="var(--font-display)"
      font-size="25"
      fill="var(--ink)">{t.headline}</text
    >
    <text
      x="40"
      y="74"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--muted)">{t.subline}</text
    >
    <!-- naive panel -->
    <rect
      x="40"
      y="110"
      width="350"
      height="220"
      rx="12"
      fill="var(--card)"
      stroke="var(--muted)"
      stroke-width="1.5"></rect>
    <text
      x="64"
      y="150"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--muted)">{t.naive}</text
    >
    <text
      x="64"
      y="178"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--ink)">{t.naiveStep}</text
    >
    <text
      x="64"
      y="228"
      font-family="var(--font-mono)"
      font-size="30"
      fill="var(--ink)">O(nk)</text
    >
    <text
      x="64"
      y="262"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--muted)">{t.naiveCost}</text
    >
    <!-- bar: naive full width -->
    <rect
      x="64"
      y="282"
      width="300"
      height="22"
      rx="6"
      fill="transparent"
      stroke="var(--muted)"
      stroke-width="1.5"></rect>
    <rect x="66" y="284" width="296" height="18" rx="5" fill="var(--muted)"></rect>
    <!-- heap panel -->
    <rect
      x="410"
      y="110"
      width="350"
      height="220"
      rx="12"
      fill="var(--card)"
      stroke="var(--accent)"
      stroke-width="2"></rect>
    <text
      x="434"
      y="150"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--accent)">{t.heap}</text
    >
    <text
      x="434"
      y="178"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--ink)">{t.heapStep}</text
    >
    <text
      x="434"
      y="228"
      font-family="var(--font-mono)"
      font-size="30"
      fill="var(--ink)">O(n log k)</text
    >
    <text
      x="434"
      y="262"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--muted)">{t.heapCost}</text
    >
    <!-- bar: heap ~1/15 width -->
    <rect
      x="434"
      y="282"
      width="300"
      height="22"
      rx="6"
      fill="transparent"
      stroke="var(--muted)"
      stroke-width="1.5"></rect>
    <rect x="436" y="284" width="20" height="18" rx="5" fill="var(--accent)"></rect>
    <!-- bottom band -->
    <text
      x="400"
      y="372"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--accent)">{t.faster}</text
    >
  </svg>
  <figcaption class="text-center">{t.caption}</figcaption>
</figure>
