---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Min-heap with values 1, 3, 2, 5, 4: every parent less than or equal to its children",
    headline: "PARENT WINS: ROOT IS THE MINIMUM",
    sub: "min-heap [1, 3, 2, 5, 4] · every parent ≤ its children",
    badge: "root = min · O(1) peek",
    note: "no searching — the extreme sits at index 0",
    caption:
      "Order rule: in a min-heap every parent ≤ its children, so the minimum is always the root. Peeking at index 0 is O(1) with zero searching.",
  },
  ru: {
    svgTitle: "Мин-куча со значениями 1, 3, 2, 5, 4: каждый родитель не больше детей",
    headline: "РОДИТЕЛЬ ПОБЕЖДАЕТ: В КОРНЕ МИНИМУМ",
    sub: "мин-куча [1, 3, 2, 5, 4] · каждый родитель ≤ детей",
    badge: "корень = минимум · O(1) peek",
    note: "без поиска — экстремум в индексе 0",
    caption:
      "Правило порядка: в мин-куче каждый родитель ≤ детей, поэтому минимум всегда в корне. Взгляд на индекс 0 — это O(1) без всякого поиска.",
  },
};

const t = dict[lang];

// The lesson's example min-heap: 1 at root, 3 and 2 on level one, 5 and 4 as leaves.
const nodes = [
  { v: "1", x: 400, y: 150, r: 26, root: true },
  { v: "3", x: 250, y: 250, r: 24, root: false },
  { v: "2", x: 550, y: 250, r: 24, root: false },
  { v: "5", x: 175, y: 345, r: 24, root: false },
  { v: "4", x: 325, y: 345, r: 24, root: false },
];

const checks = [
  { a: 0, b: 1, label: "1 ≤ 3 ✓" },
  { a: 0, b: 2, label: "1 ≤ 2 ✓" },
  { a: 1, b: 3, label: "3 ≤ 5 ✓" },
  { a: 1, b: 4, label: "3 ≤ 4 ✓" },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>
    <text x="400" y="82" text-anchor="middle" font-size="13" fill="var(--accent)">{t.badge}</text>

    {checks.map((c) => (
      <line
        x1={nodes[c.a].x}
        y1={nodes[c.a].y}
        x2={nodes[c.b].x}
        y2={nodes[c.b].y}
        stroke="var(--ink)"
        stroke-width="2"
      />
    ))}

    {nodes.map((n) => (
      <g>
        <circle
          cx={n.x}
          cy={n.y}
          r={n.r}
          fill="var(--card)"
          stroke={n.root ? "var(--accent)" : "var(--ink)"}
          stroke-width={n.root ? 3 : 2}
        />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.v}</text>
      </g>
    ))}

    {checks.map((c) => {
      const cx = (nodes[c.a].x + nodes[c.b].x) / 2;
      const cy = (nodes[c.a].y + nodes[c.b].y) / 2;
      return (
        <g>
          <rect x={cx - 38} y={cy - 12} width="76" height="24" rx="12" fill="var(--card)" stroke="var(--muted)" stroke-width="1" />
          <text x={cx} y={cy + 4} text-anchor="middle" font-size="12" fill="var(--ink)">{c.label}</text>
        </g>
      );
    })}

    <text x="400" y="400" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
