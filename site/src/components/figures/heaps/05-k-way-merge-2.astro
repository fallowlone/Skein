---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Pop the root 1 of L0 to the output, refill the heap with 4 from L0",
    headline: "POP MIN, REFILL SAME LIST",
    subline: "heap = 1, 1, 2 · root is head 1 of L0",
    pop: "pop min",
    emit: "output",
    refill: "push L0 next (4)",
    after: "after: out = [1] · heap min is (1, L1)",
    cap: "heap never exceeds k",
    caption:
      "Pop head 1 of L0 to the output, push L0's next (4). Output is [1], the new heap min is (1, L1). Pop it, refill it, repeat until every list is drained.",
  },
  ru: {
    svgTitle: "Вытолкни корень 1 из L0 в выход, пополни кучу значением 4 из L0",
    headline: "ВЫТОЛКНИ МИН, ПОПОЛНИ ТОТ ЖЕ СПИСОК",
    subline: "куча = 1, 1, 2 · корень — голова 1 из L0",
    pop: "вытолкни мин",
    emit: "выход",
    refill: "втолкни следующее из L0 (4)",
    after: "после: out = [1] · мин кучи — (1, L1)",
    cap: "куча никогда не больше k",
    caption:
      "Вытолкни голову 1 из L0 в выход, втолкни следующее из L0 (4). Выход — [1], новый мин кучи — (1, L1). Вытолкни, пополни, повторяй, пока каждый список не исчерпан.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <defs>
      <marker
        id="kwm2-arr"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)"></path>
      </marker>
    </defs>
    <text
      x="40"
      y="46"
      font-family="var(--font-display)"
      font-size="25"
      fill="var(--ink)">{t.headline}</text
    >
    <text
      x="40"
      y="74"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--muted)">{t.subline}</text
    >
    <!-- heap before -->
    <line
      x1="170"
      y1="172"
      x2="110"
      y2="244"
      stroke="var(--muted)"
      stroke-width="1.5"></line>
    <line
      x1="170"
      y1="172"
      x2="230"
      y2="244"
      stroke="var(--muted)"
      stroke-width="1.5"></line>
    <circle
      cx="170"
      cy="158"
      r="32"
      fill="var(--card)"
      stroke="var(--accent)"
      stroke-width="2.5"></circle>
    <text
      x="170"
      y="156"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="19"
      fill="var(--accent)">1</text
    >
    <text
      x="170"
      y="174"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="11"
      fill="var(--accent)">L0</text
    >
    <circle
      cx="102"
      cy="260"
      r="32"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="1.5"></circle>
    <text
      x="102"
      y="258"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="19"
      fill="var(--ink)">1</text
    >
    <text
      x="102"
      y="276"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="11"
      fill="var(--muted)">L1</text
    >
    <circle
      cx="238"
      cy="260"
      r="32"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="1.5"></circle>
    <text
      x="238"
      y="258"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="19"
      fill="var(--ink)">2</text
    >
    <text
      x="238"
      y="276"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="11"
      fill="var(--muted)">L2</text
    >
    <!-- pop arrow to output -->
    <text
      x="330"
      y="140"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--accent)">{t.pop}</text
    >
    <line
      x1="212"
      y1="152"
      x2="440"
      y2="152"
      stroke="var(--accent)"
      stroke-width="2"
      stroke-linecap="round"
      marker-end="url(#kwm2-arr)"></line>
    <!-- output row -->
    <text
      x="470"
      y="112"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.emit}</text
    >
    <rect
      x="470"
      y="130"
      width="56"
      height="44"
      rx="8"
      fill="var(--card)"
      stroke="var(--accent)"
      stroke-width="2.5"></rect>
    <text
      x="498"
      y="159"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="19"
      fill="var(--accent)">1</text
    >
    <rect
      x="534"
      y="130"
      width="56"
      height="44"
      rx="8"
      fill="transparent"
      stroke="var(--muted)"
      stroke-width="1.2"
      stroke-dasharray="5 4"></rect>
    <text
      x="562"
      y="159"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="19"
      fill="var(--muted)">…</text
    >
    <!-- refill: L0 next 4 into heap -->
    <text
      x="470"
      y="230"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">L0</text
    >
    <rect
      x="510"
      y="204"
      width="56"
      height="44"
      rx="8"
      fill="var(--card)"
      stroke="var(--muted)"
      stroke-width="1.2"></rect>
    <text
      x="538"
      y="233"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="19"
      fill="var(--muted)">4</text
    >
    <text
      x="660"
      y="233"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--accent)">{t.refill}</text
    >
    <path
      d="M 510 248 C 430 300 340 300 272 288"
      fill="none"
      stroke="var(--accent)"
      stroke-width="2"
      stroke-dasharray="6 4"
      stroke-linecap="round"
      marker-end="url(#kwm2-arr)"></path>
    <!-- bottom bands -->
    <text
      x="400"
      y="344"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--ink)">{t.after}</text
    >
    <text
      x="400"
      y="372"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.cap}</text
    >
  </svg>
  <figcaption class="text-center">{t.caption}</figcaption>
</figure>
