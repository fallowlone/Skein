---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Pop from min-heap 1, 3, 2, 5, 4: save root 1, move 4 to root, swap with smaller child 2, result 2, 3, 4, 5",
    headline: "POP: LAST TO ROOT, SIFT DOWN",
    cost: "save root 1 · smaller child 2 · O(log n)",
    rowA: "min-heap [1, 3, 2, 5, 4] — pop removes the root",
    mid1: "↓ save 1 · move 4 to root · size − 1",
    mid2: "↓ 4 > 2 · swap with the smaller child",
    valid: "2 ≤ (3, 4) · 3 ≤ (5) ✓ · returned: 1",
    hint: "sift-down compares with children · children 5, 6 do not exist — stop",
    caption:
      "Pop is the mirror of push: save root 1, move the last element 4 to the root, then sift down swapping with the smaller child 2 until children run out. Push appends last and bubbles up toward the root; pop starts at the root and sinks toward the leaves — both fix one pair per swap in O(log n).",
  },
  ru: {
    svgTitle: "Pop из мин-кучи 1, 3, 2, 5, 4: сохранить корень 1, перенести 4 в корень, обмен с меньшим ребёнком 2, результат 2, 3, 4, 5",
    headline: "POP: ПОСЛЕДНИЙ В КОРЕНЬ, ВНИЗ",
    cost: "сохранить корень 1 · меньший ребёнок 2 · O(log n)",
    rowA: "мин-куча [1, 3, 2, 5, 4] — pop удаляет корень",
    mid1: "↓ сохранить 1 · перенести 4 в корень · размер − 1",
    mid2: "↓ 4 > 2 · обмен с меньшим ребёнком",
    valid: "2 ≤ (3, 4) · 3 ≤ (5) ✓ · возвращено: 1",
    hint: "просеивание вниз сравнивает с детьми · детей 5, 6 нет — стоп",
    caption:
      "Pop — зеркало push: сохрани корень 1, перенеси последний элемент 4 в корень, затем просеивай вниз, меняясь с меньшим ребёнком 2, пока дети не кончатся. Push дописывает в конец и всплывает к корню; pop стартует в корне и тонет к листьям — оба чинят одну пару за обмен за O(log n).",
  },
};

const t = dict[lang];

const rowA = ["1", "3", "2", "5", "4"];
const rowB = ["4", "3", "2", "5"];
const rowC = ["2", "3", "4", "5"];
const markA = [true, false, false, false, false];
const markB = [true, false, false, false];
const markC = [true, false, true, false];

const cellW = 64;
const gap = 10;
const startX5 = (800 - (5 * cellW + 4 * gap)) / 2;
const startX4 = (800 - (4 * cellW + 3 * gap)) / 2;
const x5 = (i: number) => startX5 + i * (cellW + gap);
const x4 = (i: number) => startX4 + i * (cellW + gap);
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <text x="400" y="36" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="62" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>
    <text x="400" y="94" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rowA}</text>

    {rowA.map((v, i) => (
      <g>
        <rect x={x5(i)} y="102" width={cellW} height="46" rx="8" fill="var(--card)" stroke={markA[i] ? "var(--accent)" : "var(--ink)"} stroke-width={markA[i] ? 3 : 2} />
        <text x={x5(i) + cellW / 2} y="132" text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="400" y="176" text-anchor="middle" font-size="13" fill="var(--ink)">{t.mid1}</text>

    {rowB.map((v, i) => (
      <g>
        <rect x={x4(i)} y="186" width={cellW} height="46" rx="8" fill="var(--card)" stroke={markB[i] ? "var(--accent)" : "var(--ink)"} stroke-width={markB[i] ? 3 : 2} />
        <text x={x4(i) + cellW / 2} y="216" text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="400" y="258" text-anchor="middle" font-size="13" fill="var(--ink)">{t.mid2}</text>

    {rowC.map((v, i) => (
      <g>
        <rect x={x4(i)} y="268" width={cellW} height="46" rx="8" fill="var(--card)" stroke={markC[i] ? "var(--accent)" : "var(--ink)"} stroke-width={markC[i] ? 3 : 2} />
        <text x={x4(i) + cellW / 2} y="298" text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="400" y="348" text-anchor="middle" font-size="13" fill="var(--accent)">{t.valid}</text>
    <text x="400" y="380" text-anchor="middle" font-size="13" fill="var(--muted)">{t.hint}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
