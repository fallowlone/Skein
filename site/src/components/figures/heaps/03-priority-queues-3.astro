---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Min-heap serving 2, 3, 5, 7 smallest-first and max-heap serving 7, 5, 3, 2 largest-first; negate priorities to flip",
    headline: "MIN vs MAX: SYMMETRIC",
    formula: "same four jobs · priorities 2, 3, 5, 7 · flipped order",
    minTitle: "min-heap: smallest first",
    minServe: "serves 2 → 3 → 5 → 7",
    minOp: "extractMin",
    maxTitle: "max-heap: largest first",
    maxServe: "serves 7 → 5 → 3 → 2",
    maxOp: "extractMax",
    tip: "only a min-heap handy? negate priorities → max order",
    caption: "Min-heap serves the smallest first, max-heap the largest first — the logic is symmetric. With only a min-heap library, negate the priorities and carry on.",
  },
  ru: {
    svgTitle: "Мин-куча обслуживает 2, 3, 5, 7 начиная с наименьшего, макс-куча 7, 5, 3, 2 начиная с наибольшего; инвертируй приоритеты для переворота",
    headline: "МИН vs МАКС: СИММЕТРИЯ",
    formula: "те же четыре задачи · приоритеты 2, 3, 5, 7 · перевёрнутый порядок",
    minTitle: "мин-куча: сначала наименьшее",
    minServe: "выдача: 2 → 3 → 5 → 7",
    minOp: "extractMin",
    maxTitle: "макс-куча: сначала наибольшее",
    maxServe: "выдача: 7 → 5 → 3 → 2",
    maxOp: "extractMax",
    tip: "под рукой только мин-куча? инвертируй приоритеты → порядок макс",
    caption: "Мин-куча отдаёт наименьшее первой, макс-куча — наибольшее: логика симметрична. Если библиотека только с мин-кучей, инвертируй приоритеты и работай дальше.",
  },
};

const t = dict[lang];

// Complete-tree layout shared by both panels: root, left, right, left-left.
const nodes = [
  { dx: 0, dy: 0 },
  { dx: -70, dy: 70 },
  { dx: 70, dy: 70 },
  { dx: -105, dy: 140 },
];
const edges = [[0, 1], [0, 2], [1, 3]];
const minVals = ["2", "3", "5", "7"];
const maxVals = ["7", "5", "3", "2"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>

    <rect x="40" y="82" width="330" height="252" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="205" y="110" text-anchor="middle" font-size="15" fill="var(--ink)">{t.minTitle}</text>
    <text x="205" y="132" text-anchor="middle" font-size="12" fill="var(--muted)">{t.minOp}</text>
    {edges.map(([a, b]) => (
      <line
        x1={205 + nodes[a].dx} y1={160 + nodes[a].dy}
        x2={205 + nodes[b].dx} y2={160 + nodes[b].dy}
        stroke="var(--ink)" stroke-width="2"
      />
    ))}
    {nodes.map((n, i) => (
      <g>
        <circle cx={205 + n.dx} cy={160 + n.dy} r="24" fill="var(--card)" stroke={i === 0 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={205 + n.dx} y={160 + n.dy + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{minVals[i]}</text>
      </g>
    ))}
    <text x="205" y="326" text-anchor="middle" font-size="13" fill="var(--accent)">{t.minServe}</text>

    <rect x="430" y="82" width="330" height="252" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="595" y="110" text-anchor="middle" font-size="15" fill="var(--ink)">{t.maxTitle}</text>
    <text x="595" y="132" text-anchor="middle" font-size="12" fill="var(--muted)">{t.maxOp}</text>
    {edges.map(([a, b]) => (
      <line
        x1={595 + nodes[a].dx} y1={160 + nodes[a].dy}
        x2={595 + nodes[b].dx} y2={160 + nodes[b].dy}
        stroke="var(--ink)" stroke-width="2"
      />
    ))}
    {nodes.map((n, i) => (
      <g>
        <circle cx={595 + n.dx} cy={160 + n.dy} r="24" fill="var(--card)" stroke={i === 0 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={595 + n.dx} y={160 + n.dy + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{maxVals[i]}</text>
      </g>
    ))}
    <text x="595" y="326" text-anchor="middle" font-size="13" fill="var(--accent)">{t.maxServe}</text>

    <rect x="120" y="350" width="560" height="44" rx="10" fill="none" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="378" text-anchor="middle" font-size="14" fill="var(--ink)">{t.tip}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
