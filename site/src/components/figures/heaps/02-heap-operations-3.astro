---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Build-heap on 5, 3, 8, 1, 4: last non-leaf floor(5/2)-1 = 1, sift down index 1 then 0, result 1, 3, 8, 5, 4 in O(n)",
    headline: "BUILD-HEAP: SIFT EVERY NON-LEAF DOWN",
    cost: "n = 5 · last non-leaf ⌊5/2⌋ − 1 = 1 · O(n), not O(n log n)",
    rowA: "start [5, 3, 8, 1, 4] — sift down from the last non-leaf to the root",
    mid1: "↓ sift-down idx 1: 3 > 1 · swap",
    mid2: "↓ sift-down idx 0: 5 > 1, then 5 > 3 · swaps",
    valid: "1 ≤ (3, 8) · 3 ≤ (5, 4) ✓",
    hint: "leaves cost O(1) · short subtrees below → O(n) total",
    caption:
      "Build-heap turns [5, 3, 8, 1, 4] into [1, 3, 8, 5, 4]: sift down every non-leaf from the last one (index ⌊5/2⌋ − 1 = 1) back to the root. One swap fixes one pair and the path is at most the tree height, so pushing n times would cost O(n log n) — but most nodes are leaves at O(1) with short subtrees below, and the total converges to O(n).",
  },
  ru: {
    svgTitle: "Построение кучи из 5, 3, 8, 1, 4: последний не-лист ⌊5/2⌋−1 = 1, просеять вниз индекс 1 затем 0, результат 1, 3, 8, 5, 4 за O(n)",
    headline: "ПОСТРОЕНИЕ КУЧИ: ПРОСЕЯТЬ КАЖДЫЙ НЕ-ЛИСТ",
    cost: "n = 5 · последний не-лист ⌊5/2⌋ − 1 = 1 · O(n), не O(n log n)",
    rowA: "старт [5, 3, 8, 1, 4] — просеять вниз от последнего не-листа к корню",
    mid1: "↓ просеять вниз idx 1: 3 > 1 · обмен",
    mid2: "↓ просеять вниз idx 0: 5 > 1, затем 5 > 3 · обмены",
    valid: "1 ≤ (3, 8) · 3 ≤ (5, 4) ✓",
    hint: "листья стоят O(1) · короткие поддеревья внизу → всего O(n)",
    caption:
      "Построение кучи превращает [5, 3, 8, 1, 4] в [1, 3, 8, 5, 4]: просей вниз каждый не-листовый узел от последнего (индекс ⌊5/2⌋ − 1 = 1) обратно к корню. Один обмен чинит одну пару, а путь не длиннее высоты дерева, поэтому n вставок стоили бы O(n log n), — но большинство узлов листья за O(1) с короткими поддеревьями внизу, и сумма сходится к O(n).",
  },
};

const t = dict[lang];

const rowA = ["5", "3", "8", "1", "4"];
const rowB = ["5", "1", "8", "3", "4"];
const rowC = ["1", "3", "8", "5", "4"];
const markA = [false, true, false, false, false];
const markB = [true, false, false, true, false];
const markC = [true, false, false, true, false];

const cellW = 64;
const gap = 10;
const startX = (800 - (5 * cellW + 4 * gap)) / 2;
const cellX = (i: number) => startX + i * (cellW + gap);
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <text x="400" y="36" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="62" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>
    <text x="400" y="94" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rowA}</text>

    {rowA.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="102" width={cellW} height="46" rx="8" fill="var(--card)" stroke={markA[i] ? "var(--accent)" : "var(--ink)"} stroke-width={markA[i] ? 3 : 2} />
        <text x={cellX(i) + cellW / 2} y="132" text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="400" y="176" text-anchor="middle" font-size="13" fill="var(--ink)">{t.mid1}</text>

    {rowB.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="186" width={cellW} height="46" rx="8" fill="var(--card)" stroke={markB[i] ? "var(--accent)" : "var(--ink)"} stroke-width={markB[i] ? 3 : 2} />
        <text x={cellX(i) + cellW / 2} y="216" text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="400" y="258" text-anchor="middle" font-size="13" fill="var(--ink)">{t.mid2}</text>

    {rowC.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="268" width={cellW} height="46" rx="8" fill="var(--card)" stroke={markC[i] ? "var(--accent)" : "var(--ink)"} stroke-width={markC[i] ? 3 : 2} />
        <text x={cellX(i) + cellW / 2} y="298" text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="400" y="348" text-anchor="middle" font-size="13" fill="var(--accent)">{t.valid}</text>
    <text x="400" y="380" text-anchor="middle" font-size="13" fill="var(--muted)">{t.hint}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
