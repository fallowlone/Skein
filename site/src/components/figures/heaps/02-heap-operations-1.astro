---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Push 0 into min-heap 1, 3, 2, 5, 4: append last, swap with 2, swap with 1, two swaps total",
    headline: "PUSH 0: APPEND LAST, BUBBLE UP",
    cost: "min-heap [1, 3, 2, 5, 4] · two swaps · O(log n)",
    rowA: "① append 0 at index 5 — property breaks in one place",
    swap1: "↓ 0 < 2 · swap idx 5↔2",
    swap2: "↓ 0 < 1 · swap idx 2↔0",
    valid: "0 ≤ (3, 1) · 3 ≤ (5, 4) · 1 ≤ (2) ✓",
    hint: "one violated pair per swap · never a full re-sort",
    caption:
      "Push 0 into the min-heap [1, 3, 2, 5, 4]: append 0 last, swap with parent 2, swap with root 1. Only one parent-child pair breaks at a time, so two local swaps along one root-to-leaf path restore the heap — never an O(n log n) re-sort.",
  },
  ru: {
    svgTitle: "Push 0 в мин-кучу 1, 3, 2, 5, 4: дописать в конец, обмен с 2, обмен с 1, всего два обмена",
    headline: "PUSH 0: ДОПИСАТЬ В КОНЕЦ, ВСПЛЫТЬ",
    cost: "мин-куча [1, 3, 2, 5, 4] · два обмена · O(log n)",
    rowA: "① 0 дописан в конец, индекс 5 — свойство сломано в одном месте",
    swap1: "↓ 0 < 2 · обмен idx 5↔2",
    swap2: "↓ 0 < 1 · обмен idx 2↔0",
    valid: "0 ≤ (3, 1) · 3 ≤ (5, 4) · 1 ≤ (2) ✓",
    hint: "один обмен чинит одну пару · никакой полной пересортировки",
    caption:
      "Push 0 в мин-кучу [1, 3, 2, 5, 4]: допиши 0 в конец, обменяй с родителем 2, обменяй с корнем 1. За раз ломается одна пара родитель-ребёнок, поэтому два локальных обмена вдоль одного пути корень-лист чинят кучу — никакой пересортировки за O(n log n).",
  },
};

const t = dict[lang];

const rowA = ["1", "3", "2", "5", "4", "0"];
const rowB = ["1", "3", "0", "5", "4", "2"];
const rowC = ["0", "3", "1", "5", "4", "2"];
const markA = [false, false, false, false, false, true];
const markB = [false, false, true, false, false, false];
const markC = [true, false, false, false, false, false];

const cellW = 64;
const gap = 10;
const startX = (800 - (6 * cellW + 5 * gap)) / 2;
const cellX = (i: number) => startX + i * (cellW + gap);
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <text x="400" y="36" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="62" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>
    <text x="400" y="94" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rowA}</text>

    {rowA.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="102" width={cellW} height="46" rx="8" fill="var(--card)" stroke={markA[i] ? "var(--accent)" : "var(--ink)"} stroke-width={markA[i] ? 3 : 2} />
        <text x={cellX(i) + cellW / 2} y="132" text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="400" y="176" text-anchor="middle" font-size="13" fill="var(--ink)">{t.swap1}</text>

    {rowB.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="186" width={cellW} height="46" rx="8" fill="var(--card)" stroke={markB[i] ? "var(--accent)" : "var(--ink)"} stroke-width={markB[i] ? 3 : 2} />
        <text x={cellX(i) + cellW / 2} y="216" text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="400" y="258" text-anchor="middle" font-size="13" fill="var(--ink)">{t.swap2}</text>

    {rowC.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="268" width={cellW} height="46" rx="8" fill="var(--card)" stroke={markC[i] ? "var(--accent)" : "var(--ink)"} stroke-width={markC[i] ? 3 : 2} />
        <text x={cellX(i) + cellW / 2} y="298" text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="400" y="348" text-anchor="middle" font-size="13" fill="var(--accent)">{t.valid}</text>
    <text x="400" y="380" text-anchor="middle" font-size="13" fill="var(--muted)">{t.hint}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
