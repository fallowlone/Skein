---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Priority queue contract of insert, extractMin, peek kept by a swappable binary heap plug-in",
    headline: "THE CONTRACT, NOT THE CODE",
    formula: "priority queue = ADT contract · binary heap = one plug-in",
    cost: "binary heap: insert O(log n) · extract O(log n) · peek O(1)",
    contractTitle: "contract: what",
    contractRow1: "insert — add element",
    contractRow2: "extractMin — serve best",
    contractRow3: "peek — look, keep",
    implTitle: "plug-ins: how",
    heapRow: "binary heap ✓ standard",
    sortedRow: "sorted array: insert O(n)",
    unsortedRow: "unsorted array: extract O(n)",
    listRow: "linked list: all O(n)",
    swap: "swap the plug-in — client code never changes",
    caption: "The priority queue is the contract — insert, extractMin, peek. The binary heap is one plug-in that keeps it with O(log n) insert and extract plus O(1) peek, beating O(n) alternatives. Swap the implementation and client code never changes.",
  },
  ru: {
    svgTitle: "Контракт очереди с приоритетом из insert, extractMin, peek выполняет сменная бинарная куча",
    headline: "КОНТРАКТ, А НЕ КОД",
    formula: "очередь с приоритетом = контракт АТД · бинарная куча = один модуль",
    cost: "бинарная куча: insert O(log n) · extract O(log n) · peek O(1)",
    contractTitle: "контракт: что",
    contractRow1: "insert — добавить элемент",
    contractRow2: "extractMin — отдать лучший",
    contractRow3: "peek — глянуть, оставить",
    implTitle: "модули: как",
    heapRow: "бинарная куча ✓ стандарт",
    sortedRow: "сортир. массив: вставка O(n)",
    unsortedRow: "несортир. массив: extract O(n)",
    listRow: "связный список: всё O(n)",
    swap: "замени модуль — код клиента не изменится",
    caption: "Очередь с приоритетом — это контракт: insert, extractMin, peek. Бинарная куча — один сменный модуль под ним с O(log n) на insert и extract и O(1) на peek, что бьёт альтернативы O(n). Замени реализацию — код клиента не изменится.",
  },
};

const t = dict[lang];

const contractRows = [t.contractRow1, t.contractRow2, t.contractRow3];
const implRows = [t.heapRow, t.sortedRow, t.unsortedRow, t.listRow];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="82" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>

    <rect x="40" y="110" width="330" height="196" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="205" y="142" text-anchor="middle" font-size="15" fill="var(--ink)">{t.contractTitle}</text>
    {contractRows.map((row, i) => (
      <text x="205" y={180 + i * 40} text-anchor="middle" font-size="14" fill="var(--ink)">{row}</text>
    ))}

    <g>
      <path d="M 370 208 L 426 208" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <polygon points="426,202 426,214 438,208" fill="var(--accent)" />
      <path d="M 426 232 L 370 232" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <polygon points="370,226 370,238 358,232" fill="var(--muted)" />
    </g>

    <rect x="430" y="110" width="330" height="196" rx="10" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="142" text-anchor="middle" font-size="15" fill="var(--ink)">{t.implTitle}</text>
    {implRows.map((row, i) => (
      <text x="595" y={174 + i * 32} text-anchor="middle" font-size="13" fill={i === 0 ? "var(--accent)" : "var(--muted)"}>{row}</text>
    ))}

    <rect x="120" y="326" width="560" height="44" rx="10" fill="none" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="354" text-anchor="middle" font-size="14" fill="var(--ink)">{t.swap}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
