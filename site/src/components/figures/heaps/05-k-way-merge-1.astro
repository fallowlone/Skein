---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three sorted lists feed one head each into a size-3 min-heap",
    headline: "ONE HEAD PER LIST",
    subline: "k = 3 sorted lists · size-3 min-heap",
    lists: "sorted lists",
    heap: "min-heap",
    rootMin: "root = global min",
    heads: "heads highlighted: one per list enters the heap",
    caption:
      "Lists [1,4,5], [1,3,4], [2,6] feed heads 1, 1, 2 into the heap. The heap holds the smallest unseen element of each list, so the root — head 1 of L0 — is the global minimum by construction.",
  },
  ru: {
    svgTitle: "Три отсортированных списка отдают по одной голове в мин-кучу размера 3",
    headline: "ОДНА ГОЛОВА НА СПИСОК",
    subline: "k = 3 отсортированных списка · мин-куча размера 3",
    lists: "списки",
    heap: "мин-куча",
    rootMin: "корень = мин",
    heads: "головы выделены: по одной от списка входит в кучу",
    caption:
      "Списки [1,4,5], [1,3,4], [2,6] отдают головы 1, 1, 2 в кучу. Куча держит наименьший невиденный элемент каждого списка, поэтому корень — голова 1 из L0 — глобальный минимум по построению.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <defs>
      <marker
        id="kwm1-arr"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text
      x="40"
      y="46"
      font-family="var(--font-display)"
      font-size="25"
      fill="var(--ink)">{t.headline}</text
    >
    <text
