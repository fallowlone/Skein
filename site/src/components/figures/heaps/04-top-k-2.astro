---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const heaps = ["[3]", "[2, 3]", "[2, 3]", "[3, 5]", "[5, 6]", "[5, 6]"];

const dict = {
  en: {
    svgTitle: "Trace of k equals 2 on array 3 2 1 5 6 4",
    headline: "TRACE: 2 LARGEST IN [3, 2, 1, 5, 6, 4]",
    sub: "min-heap of size k = 2 · push each · size > k → pop min",
    steps: [
      "push 3",
      "push 2",
      "push 1 → pop 1",
      "push 5 → pop 2",
      "push 6 → pop 3",
      "push 4 → pop 4",
    ],
    sizes: [
      "size 1 < k",
      "size 2 = k",
      "size 3 > k",
      "size 3 > k",
      "size 3 > k",
      "size 3 > k",
    ],
    band: "final [5, 6] · root 5 = k-th largest = peek()",
    caption:
      "Tracing k = 2 on [3, 2, 1, 5, 6, 4]: push each element, pop the min whenever size exceeds k. Final heap [5, 6]; root 5 is the k-th largest — one peek(), no second phase. A min-heap keeps the eviction victim at the root, so an over-full heap evicts in one pop.",
  },
  ru: {
    svgTitle: "Трассировка k равно 2 на массиве 3 2 1 5 6 4",
    headline: "ТРАССИРОВКА: 2 НАИБОЛЬШИХ В [3, 2, 1, 5, 6, 4]",
    sub: "мин-куча размера k = 2 · добавь каждое · размер > k → вытолкни минимум",
    steps: [
      "добавь 3",
      "добавь 2",
      "добавь 1 → вытолкни 1",
      "добавь 5 → вытолкни 2",
      "добавь 6 → вытолкни 3",
      "добавь 4 → вытолкни 4",
    ],
    sizes: [
      "размер 1 < k",
      "размер 2 = k",
      "размер 3 > k",
      "размер 3 > k",
      "размер 3 > k",
      "размер 3 > k",
    ],
    band: "финал [5, 6] · корень 5 = k-й наибольший = peek()",
    caption:
      "Трассировка k = 2 на [3, 2, 1, 5, 6, 4]: добавь каждый элемент, вытолкни минимум, когда размер превышает k. Финальная куча [5, 6]; корень 5 — k-й наибольший: один peek(), без второй фазы. Мин-куча держит жертву выселения в корне, поэтому переполненная куча выселяет одним pop.",
  },
};

const t = dict[lang];

const cells = [
  { x: 40, y: 100 },
  { x: 280, y: 100 },
  { x: 520, y: 100 },
  { x: 40, y: 230 },
  { x: 280, y: 230 },
  { x: 520, y: 230 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <text
      x="40"
      y="46"
      font-family="var(--font-display)"
      font-size="22"
      fill="var(--ink)">{t.headline}</text
    >
    <text
      x="40"
      y="74"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.sub}</text
    >
    {
      cells.map((c, i) => (
        <g>
          <rect
            x={c.x}
            y={c.y}
            width="240"
            height="118"
            rx="10"
            fill={i === 5 ? "var(--card)" : "none"}
            stroke={i === 5 ? "var(--accent)" : "var(--ink)"}
            stroke-width={i === 5 ? 3 : 2}
          />
          <text
            x={c.x + 120}
            y={c.y + 30}
            text-anchor="middle"
            font-family="var(--font-mono)"
            font-size="13"
            fill="var(--ink)"
          >
            {t.steps[i]}
          </text>
          <text
            x={c.x + 120}
            y={c.y + 64}
            text-anchor="middle"
            font-family="var(--font-mono)"
            font-size="20"
            fill="var(--ink)"
          >
            {heaps[i]}
          </text>
          <text
            x={c.x + 120}
            y={c.y + 92}
            text-anchor="middle"
            font-family="var(--font-mono)"
            font-size="12"
            fill="var(--muted)"
          >
            {t.sizes[i]}
          </text>
        </g>
      ))
    }
    <text
      x="400"
      y="388"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--accent)">{t.band}</text
    >
  </svg>
  <figcaption class="text-center">{t.caption}</figcaption>
</figure>
