---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Transport head-of-line blocking: one lost TCP segment stalls every multiplexed stream until the retransmit arrives; Server Push is dead, use 103 Early Hints",
    headline: "ONE LOST SEGMENT STALLS EVERY STREAM",
    sub: "transport HoL: TCP delivers bytes strictly in order",
    connTitle: "one TCP connection: 40 streams, DATA frames by stream ID",
    connSub: "Http2Session owns the socket, streams are cheap",
    cleanLine: "clean link: every stream flows",
    lossLine: "1 lost segment: ALL streams wait for the retransmit",
    kernelLine: "byte N+1 waits for byte N — per-stream recovery needs QUIC",
    pushLine: "Push dead (Chrome 106, 2022): use 103 Early Hints",
    settingsLine: "SETTINGS + WINDOW_UPDATE: per-stream and per-connection",
    caption:
      "Multiplexing fixes HTTP-layer head-of-line blocking but not transport-layer: one lost segment holds back every later byte for all streams until the retransmit arrives. Server Push is dead — Chrome removed it in 2022 — and 103 Early Hints is the replacement.",
  },
  ru: {
    svgTitle: "Транспортный head-of-line blocking: один потерянный TCP-сегмент стопорит все мультиплексированные потоки до ретрансмита; Server Push мёртв, используйте 103 Early Hints",
    headline: "ОДИН СЕГМЕНТ СТОПОРИТ ВСЕ ПОТОКИ",
    sub: "транспортный HoL: TCP отдаёт байты строго по порядку",
    connTitle: "одно TCP-соединение: 40 потоков, кадры DATA по ID",
    connSub: "Http2Session владеет сокетом, потоки дешёвые",
    cleanLine: "чистый канал: каждый поток течёт",
    lossLine: "1 потерянный сегмент: ВСЕ потоки ждут ретрансмит",
    kernelLine: "байт N+1 ждёт байт N — восстановление на поток даёт QUIC",
    pushLine: "Push мёртв (Chrome 106, 2022): шлите 103 Early Hints",
    settingsLine: "SETTINGS + WINDOW_UPDATE: на поток и на соединение",
    caption:
      "Мультиплексирование чинит HTTP-уровневый head-of-line blocking, но не транспортный: один потерянный сегмент удерживает каждый последующий байт для всех потоков, пока не придёт ретрансмит. Server Push мёртв — Chrome удалил его в 2022 году, — а замена ему 103 Early Hints.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="92" width="680" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="122" text-anchor="middle" font-size="12" fill="var(--ink)">{t.connTitle}</text>
    <text x="400" y="146" text-anchor="middle" font-size="11" fill="var(--ink)">{t.connSub}</text>

    <rect x="60" y="192" width="680" height="48" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="221" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cleanLine}</text>

    <rect x="60" y="252" width="680" height="48" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="281" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lossLine}</text>

    <text x="400" y="330" text-anchor="middle" font-size="11" fill="var(--muted)">{t.kernelLine}</text>
    <text x="400" y="356" text-anchor="middle" font-size="11" fill="var(--muted)">{t.pushLine}</text>
    <text x="400" y="382" text-anchor="middle" font-size="11" fill="var(--muted)">{t.settingsLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
