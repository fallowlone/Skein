---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "ALPN negotiates h2 inside the TLS handshake: client offers h2 and http/1.1, server selects h2, zero extra round trips",
    headline: "ALPN: AGREE BEFORE ONE HTTP BYTE",
    sub: "TLS extension, negotiated inside the handshake",
    clientBox: "Client",
    serverBox: "Server",
    msg1: "ClientHello + ALPN: [h2, http/1.1]",
    msg2: "ServerHello + ALPN: h2",
    msg3: "Finished (now speaking h2)",
    msg4: "SETTINGS frame",
    nodeLine: 'ALPNProtocols: ["h2", "http/1.1"]',
    readLine: "alpnProtocol: h2 — 0 extra round trips",
    caption:
      "The client offers an ordered protocol list in the ClientHello, the server echoes its choice in the ServerHello, and the handshake ends with both sides already speaking h2 — no Upgrade request, no extra round trips.",
  },
  ru: {
    svgTitle: "ALPN согласует h2 внутри TLS-рукопожатия: клиент предлагает h2 и http/1.1, сервер выбирает h2, ноль лишних round-trip",
    headline: "ALPN: ДОГОВОРИТЬСЯ ДО ПЕРВОГО БАЙТА",
    sub: "расширение TLS внутри рукопожатия",
    clientBox: "Клиент",
    serverBox: "Сервер",
    msg1: "ClientHello + ALPN: [h2, http/1.1]",
    msg2: "ServerHello + ALPN: h2",
    msg3: "Finished (говорим h2)",
    msg4: "кадр SETTINGS",
    nodeLine: 'ALPNProtocols: ["h2", "http/1.1"]',
    readLine: "alpnProtocol: h2 — 0 лишних round-trip",
    caption:
      "Клиент предлагает упорядоченный список протоколов в ClientHello, сервер отражает выбор в ServerHello, и рукопожатие завершается тем, что обе стороны уже говорят на h2 — без запроса Upgrade и лишних round-trip.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="92" width="180" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="150" y="119" text-anchor="middle" font-size="12" fill="var(--ink)">{t.clientBox}</text>
    <rect x="560" y="92" width="180" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="650" y="119" text-anchor="middle" font-size="12" fill="var(--ink)">{t.serverBox}</text>

    <line x1="150" y1="136" x2="150" y2="300" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <line x1="650" y1="136" x2="650" y2="300" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />

    <line x1="170" y1="168" x2="630" y2="168" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="158" text-anchor="middle" font-size="11" fill="var(--ink)">{t.msg1}</text>
    <line x1="630" y1="208" x2="170" y2="208" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.msg2}</text>
    <line x1="170" y1="248" x2="630" y2="248" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="238" text-anchor="middle" font-size="11" fill="var(--ink)">{t.msg3}</text>
    <line x1="630" y1="288" x2="170" y2="288" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="278" text-anchor="middle" font-size="11" fill="var(--ink)">{t.msg4}</text>

    <rect x="170" y="318" width="460" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="346" text-anchor="middle" font-size="12" fill="var(--ink)">{t.nodeLine}</text>
    <text x="400" y="370" text-anchor="middle" font-size="11" fill="var(--ink)">{t.readLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
