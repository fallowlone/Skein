---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Trust is a chain from leaf through intermediate to a trusted root: serve fullchain.pem, not the leaf alone, and verification checks signatures, expiry and the SAN hostname",
    headline: "TRUST IS A CHAIN TO A KNOWN ROOT",
    sub: "clients trust roots only — send the middle",
    leaf: "leaf (your server)",
    inter: "intermediate CA",
    root: "root (client trust)",
    good: "fullchain.pem: leaf + intermediates — verifies",
    bad: "cert.pem: leaf only — UNABLE_TO_VERIFY_LEAF_SIGNATURE",
    checks: "checks: signatures, notAfter expiry, SAN hostname, CertificateVerify",
    never: "never fix with rejectUnauthorized: false",
    caption:
      "Verification walks the chain leaf to intermediate to a trusted root, so serve fullchain.pem rather than the leaf alone; the client checks signatures, expiry, and that the hostname is in the SAN, and cert errors are fixed at the cause — never by disabling verification.",
  },
  ru: {
    svgTitle: "Доверие — это цепочка от листа через промежуточный до доверенного корня: отдавайте fullchain.pem, а не один лист; проверка смотрит подписи, срок и имя хоста в SAN",
    headline: "ДОВЕРИЕ — ЦЕПОЧКА ДО ИЗВЕСТНОГО КОРНЯ",
    sub: "клиент доверяет только корням — отдайте промежуточные",
    leaf: "лист (ваш сервер)",
    inter: "промежуточный CA",
    root: "корень (в доверии клиента)",
    good: "fullchain.pem: лист + промежуточные — проверка ок",
    bad: "cert.pem: только лист — UNABLE_TO_VERIFY_LEAF_SIGNATURE",
    checks: "проверки: подписи, срок notAfter, имя хоста в SAN, CertificateVerify",
    never: "не чинить через rejectUnauthorized: false",
    caption:
      "Проверка идёт по цепочке лист — промежуточный — доверенный корень, поэтому отдавайте fullchain.pem, а не один лист; клиент проверяет подписи, срок и наличие имени хоста в SAN, а ошибки чинят по причине — никогда отключением проверки.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="96" width="180" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="150" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leaf}</text>
    <line x1="240" y1="126" x2="292" y2="126" stroke="var(--accent)" stroke-width="2" />
    <polygon points="292,126 278,120 278,132" fill="var(--accent)" />

    <rect x="310" y="96" width="180" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.inter}</text>
    <line x1="490" y1="126" x2="542" y2="126" stroke="var(--accent)" stroke-width="2" />
    <polygon points="542,126 528,120 528,132" fill="var(--accent)" />

    <rect x="560" y="96" width="180" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="650" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.root}</text>

    <rect x="60" y="190" width="680" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.good}</text>

    <rect x="60" y="260" width="680" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bad}</text>

    <text x="400" y="348" text-anchor="middle" font-size="11" fill="var(--muted)">{t.checks}</text>
    <text x="400" y="374" text-anchor="middle" font-size="12" fill="var(--ink)">{t.never}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
