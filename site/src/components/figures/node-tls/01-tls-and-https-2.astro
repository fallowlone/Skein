---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "TLS session resumption compared: session IDs store state in server memory and need shared storage in a cluster, while session tickets hand the encrypted secret to the client so any node can resume",
    headline: "SESSION RESUMPTION: TWO MECHANISMS",
    sub: "same goal — skip the asymmetric handshake",
    leftHead: "SESSION ID",
    leftState: "state in server memory",
    leftFlow: "client presents ID, server looks it up",
    leftScale: "needs shared cache in a cluster",
    rightHead: "SESSION TICKET (RFC 5077)",
    rightState: "encrypted blob held by the client",
    rightFlow: "client replays ticket, any node decrypts",
    rightScale: "stateless, scales horizontally",
    caption:
      "Same goal — skip the asymmetric handshake for repeat clients — but session IDs keep state in server memory and need shared storage to scale across a cluster, while session tickets hand the encrypted secret to the client so any node can decrypt and resume.",
  },
  ru: {
    svgTitle: "Сравнение возобновления TLS: session ID хранят состояние в памяти сервера и требуют общего хранилища в кластере, а session ticket отдают зашифрованный секрет клиенту, и возобновить может любой узел",
    headline: "ВОЗОБНОВЛЕНИЕ СЕССИИ: ДВА МЕХАНИЗМА",
    sub: "цель одна — пропустить асимметричный handshake",
    leftHead: "SESSION ID",
    leftState: "состояние в памяти сервера",
    leftFlow: "клиент предъявляет ID, сервер ищет его",
    leftScale: "в кластере нужен общий кеш",
    rightHead: "SESSION TICKET (RFC 5077)",
    rightState: "шифрованный блоб хранит клиент",
    rightFlow: "клиент шлёт тикет, любой узел расшифрует",
    rightScale: "без состояния на сервере, масштабируется",
    caption:
      "Цель одна — пропустить асимметричный handshake для повторных клиентов, — но session ID держат состояние в памяти сервера и требуют общего хранилища для масштабирования на кластер, а session ticket отдают зашифрованный секрет клиенту, поэтому любой узел может расшифровать и возобновить.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="96" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftHead}</text>
    <rect x="45" y="110" width="320" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="141" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftState}</text>
    <text x="205" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftFlow}</text>
    <line x1="120" y1="216" x2="290" y2="216" stroke="var(--accent)" stroke-width="2" />
    <polygon points="290,216 276,210 276,222" fill="var(--accent)" />
    <rect x="45" y="232" width="320" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="205" y="263" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftScale}</text>

    <text x="595" y="96" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightHead}</text>
    <rect x="435" y="110" width="320" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="141" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightState}</text>
    <text x="595" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightFlow}</text>
    <line x1="510" y1="216" x2="680" y2="216" stroke="var(--accent)" stroke-width="2" />
    <polygon points="680,216 666,210 666,222" fill="var(--accent)" />
    <rect x="435" y="232" width="320" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="263" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightScale}</text>

    <line x1="45" y1="316" x2="755" y2="316" stroke="var(--muted)" stroke-width="1" />
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
