---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Fresh connection pays TCP plus TLS handshake on every request, keep-alive pool pays it once and reuses the connection",
    headline: "PAY THE HANDSHAKE ONCE, NOT PER REQUEST",
    sub: "30 ms link: TCP 1 round-trip + TLS 1-2 round-trips",
    leftTitle: "fresh connection: every request",
    tcpBar: "TCP handshake: 1 round-trip",
    tlsBar: "TLS handshake: 1-2 round-trips",
    leftCost: "setup 60-90 ms EVERY request",
    leftFoot: "10 req/s = 10 handshakes/s",
    rightTitle: "keep-alive pool: reuse",
    onceBar: "TCP+TLS handshake: once",
    reuse1: "request 2: reuse ~ 0 ms setup",
    reuse2: "request 3: reuse ~ 0 ms setup",
    rightFoot: "handshake cost drops to near zero",
    caption:
      "A new connection pays a TCP handshake plus a TLS handshake on every request — 60-90 ms of setup on a 30 ms link — while a keep-alive pool pays it once and reuses the live connection.",
  },
  ru: {
    svgTitle: "Новое соединение платит TCP- и TLS-хендшейк на каждый запрос, а keep-alive пул платит один раз и переиспользует соединение",
    headline: "ПЛАТИ ЗА ХЕНДШЕЙК ОДИН РАЗ",
    sub: "канал 30 мс: TCP 1 round-trip + TLS 1-2",
    leftTitle: "новое соединение: каждый запрос",
    tcpBar: "TCP-хендшейк: 1 round-trip",
    tlsBar: "TLS-хендшейк: 1-2 round-trip",
    leftCost: "подготовка 60-90 мс КАЖДЫЙ раз",
    leftFoot: "10 запр/с = 10 хендшейков/с",
    rightTitle: "keep-alive пул: переиспользование",
    onceBar: "TCP+TLS-хендшейк: один раз",
    reuse1: "запрос 2: переиспользование ~ 0 мс",
    reuse2: "запрос 3: переиспользование ~ 0 мс",
    rightFoot: "цена хендшейка почти ноль",
    caption:
      "Новое соединение платит TCP-хендшейк плюс TLS-хендшейк на каждый запрос — 60-90 мс подготовки на канале 30 мс, — а keep-alive пул платит один раз и переиспользует живое соединение.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="330" height="220" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="205" y="116" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <rect x="60" y="132" width="290" height="34" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="205" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.tcpBar}</text>
    <rect x="60" y="178" width="290" height="34" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="205" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.tlsBar}</text>
    <text x="205" y="244" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftCost}</text>
    <text x="205" y="282" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftFoot}</text>

    <rect x="430" y="90" width="330" height="220" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="116" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    <rect x="450" y="132" width="290" height="34" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.onceBar}</text>
    <text x="595" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.reuse1}</text>
    <text x="595" y="244" text-anchor="middle" font-size="11" fill="var(--ink)">{t.reuse2}</text>
    <text x="595" y="282" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightFoot}</text>

    <text x="60" y="352" font-size="11" fill="var(--muted)">TCP 1 + TLS 1-2 round-trips</text>
    <text x="740" y="352" text-anchor="end" font-size="11" fill="var(--muted)">p99 40 ms - 900 ms</text>
    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--muted)">keep-alive: handshake once, requests reuse</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
