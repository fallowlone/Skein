---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "TLS 1.3 handshake in one round trip: ClientHello with key share and SNI, server replies with its share, full-chain certificate, CertificateVerify and Finished, then encrypted application data",
    headline: "TLS 1.3 HANDSHAKE: ONE ROUND TRIP",
    sub: "client sends its key share up front",
    client: "Client",
    server: "Server",
    m1: "ClientHello + key_share + SNI",
    m2: "ServerHello + key_share",
    m3: "Certificate (full chain)",
    m4: "CertificateVerify + Finished",
    m5: "verify chain, Finished",
    m6: "GET / (encrypted)",
    foot: "TLS 1.2 needed two round trips; 1.3 needs one",
    caption:
      "TLS 1.3 completes the handshake in one round trip: the client sends its key share in ClientHello, the server answers with its share, the full-chain certificate, CertificateVerify and Finished, then application data flows encrypted.",
  },
  ru: {
    svgTitle: "Handshake TLS 1.3 за один раунд: ClientHello с долей ключа и SNI, сервер отвечает своей долей, сертификатом полной цепочки, CertificateVerify и Finished, затем идут зашифрованные данные приложения",
    headline: "HANDSHAKE TLS 1.3: ОДИН РАУНД",
    sub: "клиент шлёт долю ключа заранее",
    client: "Клиент",
    server: "Сервер",
    m1: "ClientHello + key_share + SNI",
    m2: "ServerHello + key_share",
    m3: "Certificate (полная цепочка)",
    m4: "CertificateVerify + Finished",
    m5: "проверка цепочки, Finished",
    m6: "GET / (шифр.)",
    foot: "TLS 1.2 требовал двух раундов; 1.3 — одного",
    caption:
      "Handshake TLS 1.3 укладывается в один раунд: клиент шлёт долю ключа уже в ClientHello, сервер отвечает своей долей, сертификатом полной цепочки, CertificateVerify и Finished, затем данные приложения идут шифрованными.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="92" text-anchor="middle" font-size="12" fill="var(--ink)">{t.client}</text>
    <text x="600" y="92" text-anchor="middle" font-size="12" fill="var(--ink)">{t.server}</text>
    <line x1="200" y1="102" x2="200" y2="352" stroke="var(--muted)" stroke-width="1" stroke-dasharray="5 5" />
    <line x1="600" y1="102" x2="600" y2="352" stroke="var(--muted)" stroke-width="1" stroke-dasharray="5 5" />

    <text x="400" y="122" text-anchor="middle" font-size="11" fill="var(--muted)">{t.m1}</text>
    <line x1="230" y1="132" x2="570" y2="132" stroke="var(--accent)" stroke-width="2" />
    <polygon points="570,132 556,126 556,138" fill="var(--accent)" />

    <text x="400" y="162" text-anchor="middle" font-size="11" fill="var(--muted)">{t.m2}</text>
    <line x1="570" y1="172" x2="230" y2="172" stroke="var(--accent)" stroke-width="2" />
    <polygon points="230,172 244,166 244,178" fill="var(--accent)" />

    <text x="400" y="202" text-anchor="middle" font-size="11" fill="var(--muted)">{t.m3}</text>
    <line x1="570" y1="212" x2="230" y2="212" stroke="var(--accent)" stroke-width="2" />
    <polygon points="230,212 244,206 244,218" fill="var(--accent)" />

    <text x="400" y="242" text-anchor="middle" font-size="11" fill="var(--muted)">{t.m4}</text>
    <line x1="570" y1="252" x2="230" y2="252" stroke="var(--accent)" stroke-width="2" />
    <polygon points="230,252 244,246 244,258" fill="var(--accent)" />

    <text x="400" y="282" text-anchor="middle" font-size="11" fill="var(--muted)">{t.m5}</text>
    <line x1="230" y1="292" x2="570" y2="292" stroke="var(--accent)" stroke-width="2" />
    <polygon points="570,292 556,286 556,298" fill="var(--accent)" />

    <text x="400" y="322" text-anchor="middle" font-size="11" fill="var(--muted)">{t.m6}</text>
    <line x1="230" y1="332" x2="570" y2="332" stroke="var(--accent)" stroke-width="2" />
    <polygon points="570,332 556,326 556,338" fill="var(--accent)" />

    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
