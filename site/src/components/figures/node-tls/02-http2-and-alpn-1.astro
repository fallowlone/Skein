---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "HTTP/1.1 spreads requests over up to six TCP connections, one request at a time each; HTTP/2 interleaves many streams over one TCP connection",
    headline: "SIX CONNECTIONS VS ONE CONNECTION",
    sub: "one request at a time vs many interleaved streams",
    leftTitle: "HTTP/1.1: up to 6 TCP per origin",
    connLabel: "1 request at a time",
    leftFoot: "6 failure domains: 1 loss freezes 1 conn",
    rightTitle: "HTTP/2: one TCP, many streams",
    streamA: "stream 1 DATA",
    streamB: "stream 7 DATA",
    streamC: "stream 12 DATA",
    rightFoot: "1 failure domain: 1 loss stalls all streams",
    footAll: "better on a clean link, worse on a lossy one",
    caption:
      "HTTP/1.1 spreads requests across up to six TCP connections with one request at a time each — six independent failure domains. HTTP/2 interleaves many streams over one TCP connection — one shared failure domain.",
  },
  ru: {
    svgTitle: "HTTP/1.1 раскладывает запросы по шести TCP-соединениям, по одному запросу за раз; HTTP/2 чередует множество потоков по одному TCP-соединению",
    headline: "ШЕСТЬ СОЕДИНЕНИЙ ПРОТИВ ОДНОГО",
    sub: "один запрос за раз против многих потоков",
    leftTitle: "HTTP/1.1: до 6 TCP на origin",
    connLabel: "1 запрос за раз",
    leftFoot: "6 доменов отказа: потеря морозит 1 соед.",
    rightTitle: "HTTP/2: один TCP, много потоков",
    streamA: "поток 1 DATA",
    streamB: "поток 7 DATA",
    streamC: "поток 12 DATA",
    rightFoot: "1 домен отказа: потеря стопорит все потоки",
    footAll: "на чистом канале лучше, на нестабильном хуже",
    caption:
      "HTTP/1.1 раскладывает запросы по шести TCP-соединениям, по одному запросу за раз, — шесть независимых доменов отказа. HTTP/2 чередует множество потоков по одному TCP-соединению — один общий домен отказа.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="330" height="220" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="205" y="116" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <rect x="60" y="130" width="290" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <rect x="60" y="162" width="290" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <rect x="60" y="194" width="290" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="205" y="238" text-anchor="middle" font-size="11" fill="var(--ink)">{t.connLabel}</text>
    <text x="205" y="282" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftFoot}</text>

    <rect x="430" y="90" width="330" height="220" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="116" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    <rect x="450" y="130" width="290" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="150" text-anchor="middle" font-size="11" fill="var(--ink)">{t.streamA}</text>
    <rect x="450" y="166" width="290" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.streamB}</text>
    <rect x="450" y="202" width="290" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="222" text-anchor="middle" font-size="11" fill="var(--ink)">{t.streamC}</text>
    <text x="595" y="282" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightFoot}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.footAll}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
