---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Bound every request with connect, headers and body timeouts, retry only idempotent calls, and always drain the body",
    headline: "BOUND IT, RETRY LITTLE, DRAIN ALWAYS",
    sub: "300 s defaults are generous: use single-digit seconds",
    connRow: "connect.timeout 10 s - dead host",
    headRow: "headersTimeout 300 s - no response",
    bodyRow: "bodyTimeout 300 s - stalled body",
    tunedRow: "tuned: 2 s / 5 s / 10 s per dispatcher",
    retryOk: "GET: idempotent, retry safe",
    retryNo: "POST /charge: never blind-retry",
    retryHow: "cap attempts, backoff + jitter",
    drainRule: "consume or body.dump() every path",
    drainCost: "undrained body pins socket - EMFILE",
    stormNote: "retry storm: sync retries bury service",
    hangNote: "hang holds a pooled connection out",
    caption:
      "Bound every request with connect, headers, and body timeouts, retry only idempotent calls with capped backoff plus jitter, and always consume or dump the body or the socket leaks to EMFILE.",
  },
  ru: {
    svgTitle: "Ограничивай каждый запрос таймаутами connect, headers и body, повторяй только идемпотентные вызовы и всегда вычитывай тело",
    headline: "ОГРАНИЧЬ, ПОВТОРЯЙ МАЛО, ВЫЧИТЫВАЙ",
    sub: "300 с по умолчанию щедры: нужны секунды",
    connRow: "connect.timeout 10 с — мёртвый хост",
    headRow: "headersTimeout 300 с — нет ответа",
    bodyRow: "bodyTimeout 300 с — зависшее тело",
    tunedRow: "настройка: 2 с / 5 с / 10 с на диспетчер",
    retryOk: "GET: идемпотентен, повтор безопасен",
    retryNo: "POST /charge: вслепую не повторять",
    retryHow: "лимит попыток, backoff + джиттер",
    drainRule: "вычитай или body.dump() на каждом пути",
    drainCost: "невычитанное тело держит сокет — EMFILE",
    stormNote: "retry-шторм: синхронные повторы хоронят сервис",
    hangNote: "висящий запрос держит соединение пула вне оборота",
    caption:
      "Ограничивай каждый запрос таймаутами connect, headers и body, повторяй только идемпотентные вызовы с лимитом и backoff плюс джиттером и всегда вычитывай или сбрасывай тело, иначе сокет утечёт до EMFILE.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="350" height="220" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="215" y="128" text-anchor="middle" font-size="11" fill="var(--ink)">{t.connRow}</text>
    <text x="215" y="168" text-anchor="middle" font-size="11" fill="var(--ink)">{t.headRow}</text>
    <text x="215" y="208" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bodyRow}</text>
    <text x="215" y="258" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tunedRow}</text>

    <rect x="430" y="90" width="330" height="220" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="128" text-anchor="middle" font-size="11" fill="var(--ink)">{t.retryOk}</text>
    <text x="595" y="168" text-anchor="middle" font-size="11" fill="var(--ink)">{t.retryNo}</text>
    <text x="595" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.retryHow}</text>
    <text x="595" y="258" text-anchor="middle" font-size="11" fill="var(--ink)">{t.drainRule}</text>
    <text x="595" y="288" text-anchor="middle" font-size="11" fill="var(--muted)">{t.drainCost}</text>

    <text x="60" y="352" font-size="11" fill="var(--muted)">{t.stormNote}</text>
    <text x="740" y="352" text-anchor="end" font-size="11" fill="var(--muted)">res.resume()</text>
    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--muted)">{t.hangNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
