---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "undici Agent manages one Pool per origin, Pool manages connections to one origin, Client is a single connection",
    headline: "ONE AGENT, ONE POOL PER ORIGIN",
    sub: "fetch runs on undici: tune the dispatcher",
    agentTitle: "Agent",
    agentLine1: "one Pool per origin",
    agentLine2: "dispatcher: pool",
    poolTitle: "Pool",
    poolLine1: "many conns, one origin",
    poolLine2: "connections: 64",
    clientTitle: "Client",
    clientLine1: "single connection",
    clientLine2: "one origin",
    knob1: "connections caps conns per origin",
    knob2: "pipelining: 1 — leave unless measured",
    knob3: "legacy: http.Agent keepAlive + maxSockets",
    foot: "size to downstream capacity, not infinity",
    caption:
      "Agent holds one Pool per origin, Pool holds many connections to a single origin, and Client is one connection; cap with connections, keep pipelining at 1, and size to the downstream.",
  },
  ru: {
    svgTitle: "Agent undici держит по Pool на origin, Pool держит соединения к одному origin, Client — одно соединение",
    headline: "ОДИН AGENT, ПО POOL НА ORIGIN",
    sub: "fetch работает на undici: настрой диспетчер",
    agentTitle: "Agent",
    agentLine1: "по Pool на origin",
    agentLine2: "dispatcher: pool",
    poolTitle: "Pool",
    poolLine1: "много соед., один origin",
    poolLine2: "connections: 64",
    clientTitle: "Client",
    clientLine1: "одно соединение",
    clientLine2: "один origin",
    knob1: "connections лимитирует пул на origin",
    knob2: "pipelining: 1 — не трогай без замеров",
    knob3: "легаси: http.Agent keepAlive + maxSockets",
    foot: "размеряй под downstream, а не в бесконечность",
    caption:
      "Agent держит по Pool на origin, Pool — много соединений к одному origin, а Client — одно соединение; ограничивай через connections, держи pipelining равным 1 и размеряй под downstream.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="104" width="220" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="150" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.agentTitle}</text>
    <text x="150" y="158" text-anchor="middle" font-size="11" fill="var(--ink)">{t.agentLine1}</text>
    <text x="150" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.agentLine2}</text>

    <text x="270" y="162" text-anchor="middle" font-size="14" fill="var(--muted)">-</text>

    <rect x="290" y="104" width="220" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.poolTitle}</text>
    <text x="400" y="158" text-anchor="middle" font-size="11" fill="var(--ink)">{t.poolLine1}</text>
    <text x="400" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.poolLine2}</text>

    <text x="520" y="162" text-anchor="middle" font-size="14" fill="var(--muted)">-</text>

    <rect x="540" y="104" width="220" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="650" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.clientTitle}</text>
    <text x="650" y="158" text-anchor="middle" font-size="11" fill="var(--ink)">{t.clientLine1}</text>
    <text x="650" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.clientLine2}</text>

    <text x="60" y="262" font-size="11" fill="var(--ink)">{t.knob1}</text>
    <text x="60" y="296" font-size="11" fill="var(--ink)">{t.knob2}</text>
    <text x="60" y="330" font-size="11" fill="var(--ink)">{t.knob3}</text>

    <text x="60" y="372" font-size="12" fill="var(--muted)">fetch: dispatcher option</text>
    <text x="740" y="372" text-anchor="end" font-size="11" fill="var(--muted)">maxSockets: 64</text>
    <text x="400" y="400" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
