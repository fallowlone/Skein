---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Full-text search choice: ILIKE with a leading wildcard scans 50M rows in 12 s; keyword questions need GIN tsvector, fuzzy ones pg_trgm, meaning ones pgvector HNSW",
    headline: "ILIKE CANNOT SCALE: 12 s ON 50M ROWS",
    sub: "leading wildcard defeats B-tree — always O(n)",
    queryLine: "WHERE title ILIKE '%invoice%'",
    optTitles: ["GIN tsvector", "pg_trgm GIN", "pgvector HNSW"],
    optOps: ["@@ to_tsquery", "% · ILIKE '%x%'", "<=> embedding"],
    optSubs: ["contains the word?", "looks like the input?", "means the same thing?"],
    foot: "the question picks the type — keyword, fuzzy, or semantic",
    caption:
      "A leading-wildcard ILIKE scans all 50M rows in 12 s no matter the index: keyword questions need GIN tsvector, fuzzy ones pg_trgm, meaning ones pgvector HNSW.",
  },
  ru: {
    svgTitle: "Выбор полнотекстового поиска: ILIKE с leading-wildcard сканирует 50M строк за 12 с; вопросы по словам требуют GIN tsvector, нечёткие — pg_trgm, по смыслу — pgvector HNSW",
    headline: "ILIKE НЕ МАСШТАБИРУЕТСЯ: 12 с НА 50M СТРОК",
    sub: "leading-wildcard отключает B-tree — всегда O(n)",
    queryLine: "WHERE title ILIKE '%invoice%'",
    optTitles: ["GIN tsvector", "pg_trgm GIN", "pgvector HNSW"],
    optOps: ["@@ to_tsquery", "% · ILIKE '%x%'", "<=> embedding"],
    optSubs: ["содержит слово?", "похожа на ввод?", "означает то же самое?"],
    foot: "тип выбирает вопрос — keyword, fuzzy или semantic",
    caption:
      "ILIKE с leading-wildcard сканирует все 50M строк за 12 с при любом индексе: вопросы по словам требуют GIN tsvector, нечёткие — pg_trgm, по смыслу — pgvector HNSW.",
  },
};

const t = dict[lang];

const cardX = [60, 290, 520];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="100" width="680" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="132" text-anchor="middle" font-size="13" fill="var(--accent)">{t.queryLine}</text>

    {t.optTitles.map((o, i) => (
      <g>
        <rect x={cardX[i]} y="170" width="220" height="130" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cardX[i] + 110} y="198" text-anchor="middle" font-size="13" fill="var(--ink)">{o}</text>
        <text x={cardX[i] + 110} y="226" text-anchor="middle" font-size="12" fill="var(--accent)">{t.optOps[i]}</text>
        <text x={cardX[i] + 110} y="254" text-anchor="middle" font-size="11" fill="var(--muted)">{t.optSubs[i]}</text>
      </g>
    ))}

    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
