---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Index cost: 5-50 microseconds of write overhead per index per write, and disk size of bytes per key times rows times 1.3 — about 1 GB for an 8-byte BIGINT key on 100M rows",
    headline: "EVERY INDEX TAXES EVERY WRITE",
    sub: "5–50 µs per write · 10–30% of table size",
    writeTitle: "WRITE TAX",
    writeBig: "5–50 µs",
    writeL1: "per index, per write",
    writeL2: "10 indexes × 10,000 inserts/s",
    writeL3: "extra 0.5–5 ms every second",
    storeTitle: "STORAGE TAX",
    storeBig: "~1 GB",
    storeL1: "BIGINT key · 8 bytes",
    storeL2: "100M rows × 1.3",
    storeL3: "each index beyond the first",
    foot: "writes must maintain every index · storage multiplies per index",
    caption:
      "One index costs 5–50 µs on every write and ~10–30% of table size on disk: 10 indexes at 10,000 inserts/s add 0.5–5 ms per second, and a BIGINT index on 100M rows is ~1 GB.",
  },
  ru: {
    svgTitle: "Цена индекса: 5–50 микросекунд overhead на запись на каждый индекс и размер bytes per key на строки на 1.3 — около 1 GB для 8-байтного BIGINT-ключа на 100M строк",
    headline: "КАЖДЫЙ ИНДЕКС ОБЛАГАЕТ КАЖДУЮ ЗАПИСЬ",
    sub: "5–50 мкс на запись · 10–30% размера таблицы",
    writeTitle: "НАЛОГ НА ЗАПИСЬ",
    writeBig: "5–50 мкс",
    writeL1: "на индекс, на запись",
    writeL2: "10 индексов × 10 000 inserts/s",
    writeL3: "плюс 0,5–5 мс в секунду",
    storeTitle: "НАЛОГ НА ДИСК",
    storeBig: "~1 GB",
    storeL1: "BIGINT-ключ · 8 байт",
    storeL2: "100M строк × 1,3",
    storeL3: "каждый следующий индекс",
    foot: "запись обновляет каждый индекс · место растёт с каждым",
    caption:
      "Один индекс стоит 5–50 мкс на каждой записи и ~10–30% размера таблицы на диске: 10 индексов при 10 000 inserts/s добавляют 0,5–5 мс в секунду, а BIGINT-индекс на 100M строк — это ~1 GB.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="110" width="320" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="220" y="138" text-anchor="middle" font-size="13" fill="var(--ink)">{t.writeTitle}</text>
    <text x="220" y="172" text-anchor="middle" font-size="20" fill="var(--accent)">{t.writeBig}</text>
    <text x="220" y="198" text-anchor="middle" font-size="11" fill="var(--muted)">{t.writeL1}</text>
    <text x="220" y="218" text-anchor="middle" font-size="11" fill="var(--muted)">{t.writeL2}</text>
    <text x="220" y="242" text-anchor="middle" font-size="12" fill="var(--ink)">{t.writeL3}</text>

    <rect x="420" y="110" width="320" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="580" y="138" text-anchor="middle" font-size="13" fill="var(--ink)">{t.storeTitle}</text>
    <text x="580" y="172" text-anchor="middle" font-size="20" fill="var(--accent)">{t.storeBig}</text>
    <text x="580" y="198" text-anchor="middle" font-size="11" fill="var(--muted)">{t.storeL1}</text>
    <text x="580" y="218" text-anchor="middle" font-size="11" fill="var(--muted)">{t.storeL2}</text>
    <text x="580" y="242" text-anchor="middle" font-size="12" fill="var(--ink)">{t.storeL3}</text>

    <rect x="60" y="300" width="680" height="50" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
