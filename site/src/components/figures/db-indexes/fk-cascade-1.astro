---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Missing FK index: deleting one post with ON DELETE CASCADE scans 200M unindexed comments for 7 minutes holding locks; one concurrent index build fixes it",
    headline: "UNINDEXED FK TURNS DELETE INTO A SCAN",
    sub: "ON DELETE CASCADE without an index on comments(post_id)",
    parentBox: "posts · id = 42",
    childBox: "comments(post_id) · no index",
    childSub: "200M rows to scan",
    resultBig: "Seq Scan · 7 min",
    resultSub: "locks held throughout",
    fixLine: "fix: CREATE INDEX CONCURRENTLY ON comments(post_id)",
    ruleLine: "index every FK column",
    caption:
      "Deleting one post cascades into an unindexed comments(post_id): Postgres scans 200M rows for 7 minutes holding locks — one concurrent index build prevents the incident.",
  },
  ru: {
    svgTitle: "Отсутствующий FK-индекс: удаление одного поста с ON DELETE CASCADE сканирует 200M непроиндексированных комментариев 7 минут удерживая блокировки; чинит одна concurrent-постройка индекса",
    headline: "FK БЕЗ ИНДЕКСА ПРЕВРАЩАЕТ DELETE В SCAN",
    sub: "ON DELETE CASCADE без индекса на comments(post_id)",
    parentBox: "posts · id = 42",
    childBox: "comments(post_id) · без индекса",
    childSub: "200M строк для скана",
    resultBig: "Seq Scan · 7 мин",
    resultSub: "блокировки всё время",
    fixLine: "фикс: CREATE INDEX CONCURRENTLY ON comments(post_id)",
    ruleLine: "индексируй каждый FK-столбец",
    caption:
      "Удаление одного поста каскадируется в непроиндексированный comments(post_id): Postgres сканирует 200M строк 7 минут удерживая блокировки — одна concurrent-постройка индекса предотвращает инцидент.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbidx-cascade-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="120" width="180" height="70" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="120" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.parentBox}</text>
    <text x="245" y="146" text-anchor="middle" font-size="11" fill="var(--muted)">CASCADE</text>
    <line x1="210" y1="155" x2="272" y2="155" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbidx-cascade-arrow)" />

    <rect x="280" y="120" width="250" height="70" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="405" y="147" text-anchor="middle" font-size="12" fill="var(--ink)">{t.childBox}</text>
    <text x="405" y="169" text-anchor="middle" font-size="11" fill="var(--muted)">{t.childSub}</text>
    <line x1="530" y1="155" x2="592" y2="155" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbidx-cascade-arrow)" />

    <rect x="600" y="120" width="170" height="70" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="685" y="148" text-anchor="middle" font-size="13" fill="var(--accent)">{t.resultBig}</text>
    <text x="685" y="170" text-anchor="middle" font-size="10" fill="var(--muted)">{t.resultSub}</text>

    <rect x="30" y="220" width="740" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="254" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixLine}</text>

    <text x="400" y="316" text-anchor="middle" font-size="12" fill="var(--muted)">{t.ruleLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
