---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Autovacuum tuning for index-only-scan tables: the 20 percent dead-tuple default fires too late, so hot tables use vacuum_scale_factor 0.05 and analyze_scale_factor 0.02 and watch n_dead_tup",
    headline: "20% IS TOO LATE FOR HOT TABLES",
    sub: "tune autovacuum where index-only scans matter",
    barLabel: "dead tuples before autovacuum fires",
    defTag: "default 20%",
    tunedTag: "tuned 5%",
    set1: "vacuum_scale_factor = 0.05",
    set2: "analyze_scale_factor = 0.02",
    monLine: "watch n_dead_tup in pg_stat_user_tables",
    foot: "one open transaction blocks VM updates for hours",
    caption:
      "The 20% default lets dead tuples pile up faster than VACUUM restores VM bits: 5% vacuum and 2% analyze thresholds plus n_dead_tup monitoring keep index-only scans at Heap Fetches: 0.",
  },
  ru: {
    svgTitle: "Настройка autovacuum для таблиц с index-only scan: дефолтные 20 процентов мёртвых tuple срабатывают поздно, поэтому горячие таблицы используют vacuum_scale_factor 0.05 и analyze_scale_factor 0.02 и следят за n_dead_tup",
    headline: "20% — СЛИШКОМ ПОЗДНО ДЛЯ ГОРЯЧИХ ТАБЛИЦ",
    sub: "настрой autovacuum там, где важен index-only scan",
    barLabel: "мёртвых tuple до срабатывания autovacuum",
    defTag: "дефолт 20%",
    tunedTag: "настроено 5%",
    set1: "vacuum_scale_factor = 0.05",
    set2: "analyze_scale_factor = 0.02",
    monLine: "следи за n_dead_tup в pg_stat_user_tables",
    foot: "одна открытая транзакция блокирует VM на часы",
    caption:
      "Дефолтные 20% копят мёртвые tuple быстрее, чем VACUUM восстанавливает VM-биты: пороги 5% на vacuum и 2% на analyze плюс мониторинг n_dead_tup держат index-only scan на Heap Fetches: 0.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="112" text-anchor="middle" font-size="11" fill="var(--muted)">{t.barLabel}</text>
    <text x="60" y="157" font-size="12" fill="var(--ink)">{t.defTag}</text>
    <rect x="230" y="132" width="136" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="298" y="158" text-anchor="middle" font-size="13" fill="var(--muted)">20%</text>
    <text x="60" y="217" font-size="12" fill="var(--ink)">{t.tunedTag}</text>
    <rect x="230" y="192" width="34" height="40" fill="var(--paper)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="247" y="218" text-anchor="middle" font-size="13" fill="var(--ink)">5%</text>

    <rect x="60" y="252" width="330" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="225" y="284" text-anchor="middle" font-size="12" fill="var(--ink)">{t.set1}</text>
    <rect x="410" y="252" width="330" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="575" y="284" text-anchor="middle" font-size="12" fill="var(--ink)">{t.set2}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--ink)">{t.monLine}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
