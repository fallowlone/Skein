---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Implicit type coercion: WHERE user_id colon colon text equals 42 casts the BIGINT column and forces a sequential scan; comparing the raw column to 42 uses the index",
    headline: "A CAST ON THE COLUMN KILLS THE INDEX",
    sub: "orders.user_id is BIGINT · index on user_id exists",
    badQuery: "WHERE user_id::text = '42' → Seq Scan",
    badSub: "cast wraps the column · every row evaluated",
    goodQuery: "WHERE user_id = 42 → Index Scan",
    goodSub: "typed value · B-tree walk",
    noteLine: "bare '42' is unknown-type · coerces to BIGINT · still indexed",
    caption:
      "Casting the column forces Postgres to evaluate every row, so the BIGINT B-tree cannot be walked — compare the raw column to a typed value instead.",
  },
  ru: {
    svgTitle: "Неявное приведение типов: WHERE user_id colon colon text равно 42 приводит BIGINT-столбец и вынуждает sequential scan; сравнение сырого столбца с 42 использует индекс",
    headline: "CAST НА СТОЛБЦЕ УБИВАЕТ ИНДЕКС",
    sub: "orders.user_id — BIGINT · индекс на user_id существует",
    badQuery: "WHERE user_id::text = '42' → Seq Scan",
    badSub: "cast оборачивает столбец · каждая строка вычисляется",
    goodQuery: "WHERE user_id = 42 → Index Scan",
    goodSub: "типизированное значение · проход по B-tree",
    noteLine: "голый '42' — unknown-тип · приводится к BIGINT · индекс работает",
    caption:
      "Приведение столбца заставляет Postgres вычислять каждую строку, поэтому по BIGINT B-tree нельзя пройти — вместо этого сравнивай сырой столбец с типизированным значением.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="120" width="680" height="64" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="147" text-anchor="middle" font-size="13" fill="var(--accent)">{t.badQuery}</text>
    <text x="400" y="168" text-anchor="middle" font-size="11" fill="var(--muted)">{t.badSub}</text>

    <rect x="60" y="200" width="680" height="64" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="227" text-anchor="middle" font-size="13" fill="var(--ink)">{t.goodQuery}</text>
    <text x="400" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.goodSub}</text>

    <rect x="60" y="280" width="680" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="311" text-anchor="middle" font-size="12" fill="var(--muted)">{t.noteLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
