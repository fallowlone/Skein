---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Covering index leaf: key columns workspace_id and created_at DESC set the sort order, INCLUDE columns id and total_cents ride along in the leaf — the query is answered by an index-only scan 10-100x faster",
    headline: "COVER THE PROJECTION, SKIP THE HEAP",
    sub: "INCLUDE lives in the leaf, not in the sort key",
    keyTitle: "key · sort order",
    keyCols: "workspace_id, created_at DESC",
    incTitle: "INCLUDE · payload",
    incCols: "id, total_cents",
    leafTag: "leaf entry",
    resultTitle: "Index Only Scan",
    resultSub: "50 rows · no heap fetch",
    speedTag: "10–100x on hot reads",
    heapTag: "heap (not visited)",
    foot: "projection in the leaf + current VM = no heap fetch",
    caption:
      "With (workspace_id, created_at DESC) INCLUDE (id, total_cents), the dashboard query is answered from 50 leaf entries alone — an index-only scan 10–100x faster than fetching the heap.",
  },
  ru: {
    svgTitle: "Лист covering-индекса: ключевые столбцы workspace_id и created_at DESC задают порядок, INCLUDE-столбцы id и total_cents едут в листе — запрос отвечает index-only scan в 10–100 раз быстрее",
    headline: "ПОКРОЙ PROJECTION — ПРОПУСТИ HEAP",
    sub: "INCLUDE живёт в листе, а не в sort key",
    keyTitle: "ключ · порядок сортировки",
    keyCols: "workspace_id, created_at DESC",
    incTitle: "INCLUDE · нагрузка",
    incCols: "id, total_cents",
    leafTag: "запись листа",
    resultTitle: "Index Only Scan",
    resultSub: "50 строк · без heap fetch",
    speedTag: "10–100x на hot reads",
    heapTag: "heap (не посещён)",
    foot: "projection в листе + свежая VM = без heap fetch",
    caption:
      "С (workspace_id, created_at DESC) INCLUDE (id, total_cents) запрос дашборда отвечает из 50 leaf-записей — index-only scan в 10–100 раз быстрее fetch из heap.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbidx-cover-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="110" width="440" height="120" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="150" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.keyTitle}</text>
    <text x="150" y="162" text-anchor="middle" font-size="11" fill="var(--muted)">{t.keyCols}</text>
    <line x1="260" y1="118" x2="260" y2="190" stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="4 3" />
    <text x="370" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.incTitle}</text>
    <text x="370" y="162" text-anchor="middle" font-size="11" fill="var(--muted)">{t.incCols}</text>
    <text x="260" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leafTag}</text>

    <line x1="480" y1="170" x2="512" y2="170" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbidx-cover-arrow)" />

    <rect x="520" y="110" width="240" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="640" y="150" text-anchor="middle" font-size="15" fill="var(--ink)">{t.resultTitle}</text>
    <text x="640" y="174" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resultSub}</text>
    <text x="640" y="200" text-anchor="middle" font-size="13" fill="var(--accent)">{t.speedTag}</text>

    <line x1="150" y1="230" x2="150" y2="278" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="5 4" />
    <rect x="40" y="278" width="300" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 4" />
    <text x="190" y="312" text-anchor="middle" font-size="12" fill="var(--muted)">{t.heapTag}</text>

    <text x="560" y="312" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
