---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Dashboard composite on (workspace_id, status, created_at): filtering by the leading workspace_id seeks, filtering by status alone falls back to an 8 s sequential scan",
    headline: "LEAD WITH THE ALWAYS-PRESENT COLUMN",
    key1: "workspace_id · leading",
    key2: "status · 2nd",
    key3: "created_at · 3rd",
    q1: "WHERE workspace_id = $1 → Index Scan · fast",
    q2: "WHERE status = ? → Seq Scan · 8 s",
    noEntry: "no leading column — no entry",
    foot: "filter by the leader, or the tree cannot narrow",
    caption:
      "The dashboard index leads with workspace_id because every query filters by it: workspace_id queries seek, while a status-only query has no entry point and falls back to an 8 s sequential scan.",
  },
  ru: {
    svgTitle: "Dashboard composite на (workspace_id, status, created_at): фильтр по ведущему workspace_id даёт seek, фильтр только по status падает в sequential scan на 8 с",
    headline: "ВЕДУЩИЙ СТОЛБЕЦ — ВСЕГДА В ФИЛЬТРЕ",
    key1: "workspace_id · ведущий",
    key2: "status · 2-й",
    key3: "created_at · 3-й",
    q1: "WHERE workspace_id = $1 → Index Scan · быстро",
    q2: "WHERE status = ? → Seq Scan · 8 с",
    noEntry: "нет leading-столбца — нет входа",
    foot: "фильтруй по лидеру — иначе дереву не сузиться",
    caption:
      "Dashboard-индекс начинается с workspace_id, потому что он есть в фильтре каждого запроса: запросы по workspace_id делают seek, а запрос только по status не имеет точки входа и падает в sequential scan на 8 с.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">index (workspace_id, status, created_at)</text>

    <defs>
      <marker id="dbidx-dashboard-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="60" y="110" width="260" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="190" y="138" text-anchor="middle" font-size="12" fill="var(--ink)">{t.key1}</text>
    <rect x="330" y="110" width="200" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="430" y="138" text-anchor="middle" font-size="12" fill="var(--ink)">{t.key2}</text>
    <rect x="540" y="110" width="180" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="630" y="138" text-anchor="middle" font-size="12" fill="var(--ink)">{t.key3}</text>

    <line x1="190" y1="154" x2="190" y2="192" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbidx-dashboard-arrow)" />
    <rect x="60" y="196" width="680" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="228" text-anchor="middle" font-size="13" fill="var(--ink)">{t.q1}</text>

    <text x="630" y="180" text-anchor="middle" font-size="11" fill="var(--muted)">{t.noEntry}</text>
    <rect x="60" y="264" width="680" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="296" text-anchor="middle" font-size="13" fill="var(--muted)">{t.q2}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
