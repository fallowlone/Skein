---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Partial index on a 100M-row table: the full B-tree over every row is 2 GB, the partial index over the hot 20 percent is 400 MB — 5 times smaller",
    headline: "INDEX ONLY THE HOT SUBSET",
    sub: "WHERE status IN ('open','in_progress')",
    fullTitle: "full B-tree · all 100M rows",
    fullSize: "2 GB",
    partTitle: "partial · hot ~20%",
    partSize: "400 MB · 5x smaller",
    foot: "cold rows pay nothing — no storage, no write tax",
    caption:
      "Indexing only the hot ~20% cuts the index from 2 GB to 400 MB — 5x less to store and 5x cheaper to maintain on every write.",
  },
  ru: {
    svgTitle: "Partial-индекс на таблице 100M строк: полный B-tree по всем строкам — 2 GB, partial-индекс по горячим 20 процентам — 400 MB, в 5 раз меньше",
    headline: "ИНДЕКСИРУЙ ТОЛЬКО ГОРЯЧЕЕ ПОДМНОЖЕСТВО",
    sub: "WHERE status IN ('open','in_progress')",
    fullTitle: "полный B-tree · все 100M строк",
    fullSize: "2 GB",
    partTitle: "partial · горячие ~20%",
    partSize: "400 MB · в 5 раз меньше",
    foot: "холодные строки не платят — ни места, ни налога на запись",
    caption:
      "Индексация только ~20% горячего подмножества уменьшает индекс с 2 GB до 400 MB — в 5 раз меньше на диске и в 5 раз дешевле при каждой записи.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="60" y="140" font-size="12" fill="var(--ink)">{t.fullTitle}</text>
    <rect x="60" y="150" width="680" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="179" text-anchor="middle" font-size="16" fill="var(--muted)">{t.fullSize}</text>

    <text x="60" y="230" font-size="12" fill="var(--ink)">{t.partTitle}</text>
    <rect x="60" y="240" width="136" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="128" y="269" text-anchor="middle" font-size="16" fill="var(--ink)">20%</text>
    <text x="212" y="269" font-size="15" fill="var(--accent)">{t.partSize}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
