---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Ticketing index budget on 100M tasks: 80 percent done and cold, 15 percent open, 5 percent in progress — partial indexes cover the hot 20 percent inside a 20 percent of table size budget",
    headline: "PARTIAL COVERS THE HOT 20%",
    sub: "100M tasks · index budget under 20% of table size",
    doneSeg: "done · 80% · cold",
    openSeg: "open · 15%",
    progSeg: "in_progress · 5%",
    coverShort: "hot 20% only",
    clauseLine: "WHERE status IN ('open','in_progress')",
    foot: "two partial composites index 20M rows each — not 100M",
    caption:
      "With 80% of 100M tasks cold and done, partial indexes on the hot open and in_progress 20% do the same dashboard work at a fifth of the size — inside the 20% table-size budget.",
  },
  ru: {
    svgTitle: "Бюджет индексов тикет-системы на 100M задач: 80 процентов done холодные, 15 процентов open, 5 процентов in progress — partial-индексы покрывают горячие 20 процентов в бюджете 20 процентов размера таблицы",
    headline: "PARTIAL ПОКРЫВАЕТ ГОРЯЧИЕ 20%",
    sub: "100M задач · бюджет индекса до 20% таблицы",
    doneSeg: "done · 80% · холодные",
    openSeg: "open · 15%",
    progSeg: "in_progress · 5%",
    coverShort: "только горячие 20%",
    clauseLine: "WHERE status IN ('open','in_progress')",
    foot: "два partial composite индексируют по 20M строк — не 100M",
    caption:
      "При 80% холодных done из 100M задач partial-индексы по горячим open и in_progress 20% делают ту же работу дашборда за пятую часть размера — внутри бюджета 20% размера таблицы.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="672" y="128" text-anchor="middle" font-size="11" fill="var(--accent)">{t.coverShort}</text>
    <rect x="60" y="140" width="544" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="332" y="171" text-anchor="middle" font-size="12" fill="var(--muted)">{t.doneSeg}</text>
    <rect x="604" y="140" width="102" height="52" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="655" y="171" text-anchor="middle" font-size="11" fill="var(--ink)">{t.openSeg}</text>
    <rect x="706" y="140" width="34" height="52" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="723" y="214" text-anchor="middle" font-size="11" fill="var(--muted)">{t.progSeg}</text>

    <text x="400" y="278" text-anchor="middle" font-size="12" fill="var(--ink)">{t.clauseLine}</text>
    <text x="400" y="312" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
