---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Composite B-tree on (a, b, c) is sorted by a first, then b, then c: leading-prefix queries seek, queries on b or c alone do not",
    headline: "SORTED BY a, THEN b, THEN c",
    sub: "one ordered sequence — enter from the leading column",
    panelTitle: "index (a, b, c)",
    layers: ["a · entry point", "b · needs a first", "c · needs a, b first"],
    queries: ["WHERE a = ? · Yes", "WHERE a = ? AND b = ? · Yes", "WHERE b = ? · No", "WHERE b = ? AND c = ? · No"],
    skipNote: "PG18+: skip scan at extra cost",
    foot: "skip the leader, lose the seek",
    caption:
      "A composite (a, b, c) is sorted by a first, then b, then c: queries on a leading prefix seek, queries on b or c alone do not — except a costly PG18+ skip scan.",
  },
  ru: {
    svgTitle: "Composite B-tree на (a, b, c) отсортирован сначала по a, затем по b, затем по c: запросы по leading-префиксу делают seek, запросы только по b или c — нет",
    headline: "СОРТИРОВКА: СНАЧАЛА a, ПОТОМ b, ПОТОМ c",
    sub: "одна упорядоченная последовательность — вход с leading-столбца",
    panelTitle: "index (a, b, c)",
    layers: ["a · точка входа", "b · сначала нужен a", "c · сначала нужны a, b"],
    queries: ["WHERE a = ? · Да", "WHERE a = ? AND b = ? · Да", "WHERE b = ? · Нет", "WHERE b = ? AND c = ? · Нет"],
    skipNote: "PG18+: skip scan с extra cost",
    foot: "без лидера нет seek",
    caption:
      "Composite (a, b, c) отсортирован сначала по a, затем по b, затем по c: запросы по leading-префиксу делают seek, запросы только по b или c — нет, кроме дорогого skip scan в PG18+.",
  },
};

const t = dict[lang];

const layerY = [146, 198, 250];
const chipY = [120, 172, 224, 276];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="110" width="300" height="210" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="190" y="134" text-anchor="middle" font-size="12" fill="var(--muted)">{t.panelTitle}</text>
    {t.layers.map((l, i) => (
      <g>
        <rect x="60" y={layerY[i]} width="260" height="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="190" y={layerY[i] + 27} text-anchor="middle" font-size="12" fill="var(--ink)">{l}</text>
      </g>
    ))}

    {t.queries.map((q, i) => (
      <g>
        <rect x="370" y={chipY[i]} width="370" height="42" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="555" y={chipY[i] + 27} text-anchor="middle" font-size="12" fill="var(--ink)">{q}</text>
      </g>
    ))}
    <text x="555" y="344" text-anchor="middle" font-size="11" fill="var(--muted)">{t.skipNote}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
