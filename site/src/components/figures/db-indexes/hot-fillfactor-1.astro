---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "HOT updates: when no indexed column changes and the new tuple fits on the same page, the row chains in the heap and zero indexes are updated; fillfactor 70 percent leaves that room",
    headline: "HOT SKIPS THE INDEX UPDATES",
    sub: "no indexed column changed + room on the page",
    fullTitle: "fillfactor 100% · page full",
    fullUsed: "used 100%",
    fullLine: "UPDATE touches N indexes",
    hotTitle: "fillfactor 70% · room left",
    hotUsed: "used 70%",
    hotLine: "UPDATE is HOT · 0 index writes",
    foot: "defaults: 100% tables / 90% B-tree · tune 70–80% for update-heavy tables",
    caption:
      "When no indexed column changes and the new tuple fits on the same page, HOT chains the row in the heap and updates zero indexes — which is why update-heavy tables run fillfactor 70–80% instead of 100%.",
  },
  ru: {
    svgTitle: "HOT-обновления: когда indexed-столбцы не менялись и новый tuple помещается на ту же страницу, строка связывается в heap и ноль индексов обновляется; fillfactor 70 процентов оставляет место",
    headline: "HOT ПРОПУСКАЕТ ОБНОВЛЕНИЯ ИНДЕКСОВ",
    sub: "indexed-столбцы не менялись + место на странице",
    fullTitle: "fillfactor 100% · страница полна",
    fullUsed: "занято 100%",
    fullLine: "UPDATE трогает N индексов",
    hotTitle: "fillfactor 70% · место есть",
    hotUsed: "занято 70%",
    hotLine: "UPDATE — HOT · 0 записей в индекс",
    foot: "дефолты: 100% таблицы / 90% B-tree · 70–80% для update-heavy",
    caption:
      "Когда ни один indexed-столбец не изменился и новый tuple помещается на ту же страницу, HOT связывает строку в heap и обновляет ноль индексов — поэтому update-heavy таблицы держат fillfactor 70–80% вместо 100%.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="110" width="350" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="215" y="138" text-anchor="middle" font-size="13" fill="var(--ink)">{t.fullTitle}</text>
    <rect x="80" y="152" width="270" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <rect x="80" y="152" width="270" height="56" fill="var(--muted)" opacity="0.45" />
    <text x="215" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.fullUsed}</text>
    <text x="215" y="244" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fullLine}</text>

    <rect x="410" y="110" width="350" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="585" y="138" text-anchor="middle" font-size="13" fill="var(--ink)">{t.hotTitle}</text>
    <rect x="450" y="152" width="270" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <rect x="450" y="152" width="189" height="56" fill="var(--muted)" opacity="0.45" />
    <text x="585" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.hotUsed}</text>
    <text x="585" y="244" text-anchor="middle" font-size="12" fill="var(--accent)">{t.hotLine}</text>

    <rect x="40" y="300" width="720" height="50" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
