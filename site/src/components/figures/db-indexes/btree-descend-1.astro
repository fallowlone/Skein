---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "B-tree descend for WHERE user_id = 42: root to leaf in O(log n), then TID heap fetch; 10M rows go from a 2 s sequential scan to 3 ms",
    headline: "B-TREE DESCEND: ROOT TO ROW",
    sub: "WHERE user_id = 42 walks the tree in O(log n)",
    rootTitle: "root",
    rootSub: "sorted keys",
    leafTitle: "leaf",
    leafKey: "user_id = 42",
    leafTid: "TID to heap",
    heapTitle: "heap",
    heapSub: "matching rows only",
    walkTag: "O(log n) walk",
    seqTitle: "Seq Scan",
    seqLine: "10M rows · ~2 s",
    idxTitle: "Index + heap fetch",
    idxLine: "~3 ms · 600x faster",
    foot: "sorted copy of column values + TID pointers",
    caption:
      "The B-tree walk finds user_id = 42 in O(log n) steps and follows the TID to fetch only matching rows: 10M rows drop from a ~2 s sequential scan to ~3 ms.",
  },
  ru: {
    svgTitle: "Спуск по B-tree для WHERE user_id = 42: от корня к листу за O(log n), затем heap fetch по TID; 10M строк: с 2 с sequential scan до 3 мс",
    headline: "СПУСК ПО B-TREE: ОТ КОРНЯ К СТРОКЕ",
    sub: "WHERE user_id = 42 идёт по дереву за O(log n)",
    rootTitle: "корень",
    rootSub: "сорт. ключи",
    leafTitle: "лист",
    leafKey: "user_id = 42",
    leafTid: "TID в heap",
    heapTitle: "heap",
    heapSub: "только подходящие строки",
    walkTag: "за O(log n)",
    seqTitle: "Seq Scan",
    seqLine: "10M строк · ~2 с",
    idxTitle: "Индекс + heap fetch",
    idxLine: "~3 мс · в 600 раз быстрее",
    foot: "сорт. копия значений + указатели TID",
    caption:
      "Проход по B-tree находит user_id = 42 за O(log n) шагов и следует по TID, доставая только подходящие строки: 10M строк сокращаются с ~2 с sequential scan до ~3 мс.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbidx-descend-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="60" y="110" width="170" height="100" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="145" y="136" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rootTitle}</text>
    <text x="145" y="162" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rootSub}</text>

    <line x1="230" y1="160" x2="327" y2="160" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbidx-descend-arrow)" />
    <text x="278" y="150" text-anchor="middle" font-size="11" fill="var(--muted)">{t.walkTag}</text>

    <rect x="335" y="110" width="170" height="100" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="420" y="136" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leafTitle}</text>
    <text x="420" y="162" text-anchor="middle" font-size="12" fill="var(--accent)">{t.leafKey}</text>
    <text x="420" y="186" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leafTid}</text>

    <line x1="505" y1="160" x2="562" y2="160" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbidx-descend-arrow)" />
    <text x="533" y="150" text-anchor="middle" font-size="11" fill="var(--muted)">TID</text>

    <rect x="570" y="110" width="170" height="100" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="655" y="136" text-anchor="middle" font-size="13" fill="var(--ink)">{t.heapTitle}</text>
    <text x="655" y="162" text-anchor="middle" font-size="11" fill="var(--muted)">{t.heapSub}</text>

    <rect x="60" y="250" width="680" height="90" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="230" y="276" text-anchor="middle" font-size="13" fill="var(--ink)">{t.seqTitle}</text>
    <text x="230" y="302" text-anchor="middle" font-size="15" fill="var(--muted)">{t.seqLine}</text>
    <line x1="400" y1="258" x2="400" y2="332" stroke="var(--ink)" stroke-width="1.5" />
    <text x="570" y="276" text-anchor="middle" font-size="13" fill="var(--ink)">{t.idxTitle}</text>
    <text x="570" y="302" text-anchor="middle" font-size="15" fill="var(--accent)">{t.idxLine}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
