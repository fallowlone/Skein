---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "GIN inverted index: one JSONB payload fans out into a posting list of TIDs per key; a containment query reads one list instead of every row",
    headline: "GIN: MANY VALUES PER ROW",
    sub: "one JSONB row fans out into posting lists",
    docTitle: "payload (one row)",
    docKeys: ["event_type = login", "tags = premium", "body = lexemes"],
    listNames: ["event_type", "tags", "body"],
    queryLine: "WHERE payload @> (event_type = login)",
    foot: "2–5x the column size · 50–200 µs per write on hot JSONB",
    caption:
      "GIN stores every key of a JSONB document with a posting list of TIDs: a containment query reads one list instead of every row — at 2–5x the size and up to 50–200 µs of write overhead per hot row.",
  },
  ru: {
    svgTitle: "GIN inverted index: один JSONB payload раскрывается в posting-лист TID на каждый ключ; containment-запрос читает один лист вместо всех строк",
    headline: "GIN: МНОГО ЗНАЧЕНИЙ НА СТРОКУ",
    sub: "одна JSONB-строка раскрывается в posting-листы",
    docTitle: "payload (одна строка)",
    docKeys: ["event_type = login", "tags = premium", "body = лексемы"],
    listNames: ["event_type", "tags", "body"],
    queryLine: "WHERE payload @> (event_type = login)",
    foot: "2–5x размера столбца · 50–200 мкс на запись hot JSONB",
    caption:
      "GIN хранит каждый ключ JSONB-документа с posting-листом TID: containment-запрос читает один лист вместо всех строк — ценой 2–5x размера и до 50–200 мкс write-overhead на горячую строку.",
  },
};

const t = dict[lang];

const docY = [160, 205, 250];
const listX = [310, 440, 570];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbidx-gin-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="120" width="220" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="140" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.docTitle}</text>
    {t.docKeys.map((k, i) => (
      <g>
        <rect x="48" y={docY[i]} width="184" height="36" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="140" y={docY[i] + 24} text-anchor="middle" font-size="11" fill="var(--ink)">{k}</text>
      </g>
    ))}

    {t.listNames.map((n, i) => (
      <g>
        <line x1="250" y1={docY[i] + 18} x2="302" y2={docY[i] + 18} stroke="var(--accent)" stroke-width="2" marker-end="url(#dbidx-gin-arrow)" />
        <text x={listX[i] + 60} y="140" text-anchor="middle" font-size="11" fill="var(--muted)">{n}</text>
        <rect x={listX[i]} y="150" width="120" height="150" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <rect x={listX[i] + 17} y="168" width="86" height="32" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x={listX[i] + 60} y="189" text-anchor="middle" font-size="11" fill="var(--ink)">TIDs</text>
        <text x={listX[i] + 60} y="240" text-anchor="middle" font-size="14" fill="var(--muted)">···</text>
      </g>
    ))}

    <rect x="30" y="322" width="660" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="360" y="350" text-anchor="middle" font-size="12" fill="var(--ink)">{t.queryLine}</text>

    <text x="400" y="398" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
