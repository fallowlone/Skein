---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Visibility Map decides the heap fetch: with a current VM, 1,000 dense rows answer from about 10 leaf reads with Heap Fetches 0; with a stale VM the same query does about 1,000 heap fetches",
    headline: "VM BIT DECIDES THE HEAP FETCH",
    sub: "same index, same 1,000 rows — only the VM state changes",
    okTitle: "VM current",
    okBig: "Heap Fetches: 0",
    okLine: "~10 index-leaf reads",
    okRows: "1,000 rows → ~10 reads",
    badTitle: "VM stale",
    badBig: "Heap Fetches: 1,000",
    badLine: "~1,000 heap-page reads",
    badRows: "1,000 rows → ~1,000 reads",
    foot: "VACUUM sets the bit · any write clears it",
    caption:
      "A current Visibility Map answers 1,000 dense rows from ~10 leaf reads with zero heap fetches; a stale VM forces ~1,000 heap fetches and erases the index-only-scan advantage.",
  },
  ru: {
    svgTitle: "Visibility Map решает чтение heap: со свежей VM 1 000 плотных строк отвечают из ~10 чтений листьев с Heap Fetches 0; с устаревшей VM тот же запрос делает ~1 000 heap fetches",
    headline: "БИТ VM РЕШАЕТ ЧТЕНИЕ HEAP",
    sub: "тот же индекс, те же 1 000 строк — меняется только VM",
    okTitle: "VM свежая",
    okBig: "Heap Fetches: 0",
    okLine: "~10 чтений index-листьев",
    okRows: "1 000 строк → ~10 чтений",
    badTitle: "VM устарела",
    badBig: "Heap Fetches: 1 000",
    badLine: "~1 000 чтений heap-страниц",
    badRows: "1 000 строк → ~1 000 чтений",
    foot: "VACUUM устанавливает бит · любая запись сбрасывает",
    caption:
      "Свежая Visibility Map отвечает на 1 000 плотных строк из ~10 чтений листьев с нулевым heap fetches; устаревшая VM вынуждает ~1 000 heap fetches и стирает преимущество index-only scan.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="110" width="350" height="180" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="215" y="138" text-anchor="middle" font-size="13" fill="var(--ink)">{t.okTitle}</text>
    <text x="215" y="182" text-anchor="middle" font-size="20" fill="var(--accent)">{t.okBig}</text>
    <text x="215" y="212" text-anchor="middle" font-size="12" fill="var(--muted)">{t.okLine}</text>
    <text x="215" y="252" text-anchor="middle" font-size="11" fill="var(--muted)">{t.okRows}</text>

    <rect x="410" y="110" width="350" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="585" y="138" text-anchor="middle" font-size="13" fill="var(--ink)">{t.badTitle}</text>
    <text x="585" y="182" text-anchor="middle" font-size="20" fill="var(--ink)">{t.badBig}</text>
    <text x="585" y="212" text-anchor="middle" font-size="12" fill="var(--muted)">{t.badLine}</text>
    <text x="585" y="252" text-anchor="middle" font-size="11" fill="var(--muted)">{t.badRows}</text>

    <rect x="40" y="305" width="720" height="50" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="335" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
