---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "0/1 knapsack DP table for three items and capacity 5, deciding dp[2][5]",
    headline: "KNAPSACK TABLE: SKIP OR TAKE PER CELL",
    sub: "items (2,3), (3,4), (4,5) · W = 5 · rows i = 0..3, columns w = 0..5",
    panelTitle: "dp[2][5] decides:",
    panelSkip: "skip dp[1][5] = 3",
    panelTake: "take dp[1][2]+4 = 7",
    panelMax: "max = 7 → take",
    answer: "answer dp[3][5] = 7 · items 1 + 2 · weight 5 · value 7",
    note: "both parents live one row up — item i used at most once",
    caption:
      "The 2D table for items (2,3), (3,4), (4,5) with W = 5: row 0 is all zeros, and each cell keeps max(skip straight above, take up-left by the weight). At dp[2][5] take wins (3 + 4 = 7 over skip 3); the answer dp[3][5] = 7 takes items 1 and 2.",
  },
  ru: {
    svgTitle: "DP-таблица рюкзака 0/1 для трёх предметов и ёмкости 5, решение dp[2][5]",
    headline: "ТАБЛИЦА РЮКЗАКА: ПРОПУСТИТЬ ИЛИ ВЗЯТЬ",
    sub: "предметы (2,3), (3,4), (4,5) · W = 5 · строки i = 0..3, столбцы w = 0..5",
    panelTitle: "dp[2][5] решает:",
    panelSkip: "пропустить dp[1][5] = 3",
    panelTake: "взять dp[1][2]+4 = 7",
    panelMax: "max = 7 → взять",
    answer: "ответ dp[3][5] = 7 · предметы 1 + 2 · вес 5 · ценность 7",
    note: "оба родителя строкой выше — предмет i использован максимум раз",
    caption:
      "2D-таблица для предметов (2,3), (3,4), (4,5) при W = 5: строка 0 — все нули, каждая клетка держит max(пропустить прямо сверху, взять сверху-слева на вес). В dp[2][5] взять побеждает (3 + 4 = 7 против пропустить 3); ответ dp[3][5] = 7 берёт предметы 1 и 2.",
  },
};

const t = dict[lang];

const table = [
  ["0", "0", "0", "0", "0", "0"],
  ["0", "0", "3", "3", "3", "3"],
  ["0", "0", "3", "4", "4", "7"],
  ["0", "0", "3", "4", "5", "7"],
];
const rowLabels = ["i=0", "i=1 · (2,3)", "i=2 · (3,4)", "i=3 · (4,5)"];

const x0 = 150;
const cw = 64;
const step = 70;
const ch = 44;
const rowY = [112, 160, 214, 262];
const cellX = (c: number) => x0 + c * step;
const cellCX = (c: number) => x0 + c * step + cw / 2;

interface Cell {
  x: number;
  y: number;
  v: string;
  fill: string;
  tfill: string;
  stroke: string;
  sw: number;
}

const cells: Cell[] = table.flatMap((row, r) =>
  row.map((v, c) => {
    const isTarget = r === 2 && c === 5;
    const isParent = (r === 1 && c === 5) || (r === 1 && c === 2);
    return {
      x: cellX(c),
      y: rowY[r],
      v,
      fill: isTarget ? "var(--accent)" : "var(--card)",
      tfill: isTarget ? "var(--card)" : "var(--ink)",
      stroke: isTarget || isParent ? "var(--accent)" : "var(--ink)",
      sw: isParent ? 3 : 2,
    };
  })
);

const colHeaders = [0, 1, 2, 3, 4, 5].map((w) => ({ x: cellCX(w), label: `w=${w}` }));
const rowLabelPos = rowLabels.map((label, r) => ({ label, y: rowY[r] + 27 }));

const skipX = cellCX(5);
const skipY1 = rowY[1] + ch - 2;
const skipY2 = rowY[2] - 7;
const skipHead = `${skipX - 7},${skipY2} ${skipX + 7},${skipY2} ${skipX},${skipY2 + 8}`;

const takeX0 = cellCX(2);
const takeTop = rowY[2];
const takeLeft = cellX(5);
const takePath = `M${takeX0} ${takeTop - 10} L${takeX0} ${takeTop - 5} L${takeLeft - 7} ${takeTop - 5} L${takeLeft - 1} ${takeTop - 1}`;
const takeHead = `${takeLeft - 8},${takeTop - 6} ${takeLeft - 7},${takeTop + 2} ${takeLeft + 1},${takeTop - 1}`;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {colHeaders.map((h) => (
      <text x={h.x} y="100" text-anchor="middle" font-size="12" fill="var(--muted)">{h.label}</text>
    ))}

    {rowLabelPos.map((r) => (
      <text x="136" y={r.y} text-anchor="end" font-size="12" fill="var(--ink)">{r.label}</text>
    ))}

    {cells.map((cell) => (
      <g>
        <rect x={cell.x} y={cell.y} width={cw} height={ch} fill={cell.fill} stroke={cell.stroke} stroke-width={cell.sw} />
        <text x={cell.x + cw / 2} y={cell.y + 27} text-anchor="middle" font-size="15" fill={cell.tfill}>{cell.v}</text>
      </g>
    ))}

    <line x1={skipX} y1={skipY1} x2={skipX} y2={skipY2} stroke="var(--accent)" stroke-width="2" />
    <polygon points={skipHead} fill="var(--accent)" />
    <path d={takePath} fill="none" stroke="var(--accent)" stroke-width="2" />
    <polygon points={takeHead} fill="var(--accent)" />

    <rect x="584" y="120" width="200" height="140" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="594" y="146" font-size="13" fill="var(--ink)">{t.panelTitle}</text>
    <text x="594" y="176" font-size="12" fill="var(--ink)">{t.panelSkip}</text>
    <text x="594" y="201" font-size="12" fill="var(--ink)">{t.panelTake}</text>
    <line x1="594" y1="216" x2="774" y2="216" stroke="var(--muted)" stroke-width="1" />
    <text x="594" y="242" font-size="13" fill="var(--accent)">{t.panelMax}</text>

    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--ink)">{t.answer}</text>
    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
