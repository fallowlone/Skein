---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One tabulation step: dp[5] equals dp[4] plus dp[3] equals 3 plus 2 equals 5",
    headline: "ONE STEP: ADD THE TWO LEFT NEIGHBOURS",
    sub: "transition dp[i] = dp[i-1] + dp[i-2] · both inputs already filled",
    plus: "+",
    equation: "dp[5] = dp[4] + dp[3] = 3 + 2 = 5",
    readNote: "dp[4] and dp[3] were filled by earlier iterations",
    writeNote: "write dp[5] = 5, advance i to 6",
    caption:
      "One tabulated step at i = 5: dp[5] = dp[4] + dp[3] = 3 + 2 = 5. Both inputs were filled by earlier loop iterations, so the cell is written once and never recomputed.",
  },
  ru: {
    svgTitle: "Один шаг табуляции: dp[5] равно dp[4] плюс dp[3] равно 3 плюс 2 равно 5",
    headline: "ОДИН ШАГ: СЛОЖИ ДВУХ ЛЕВЫХ СОСЕДЕЙ",
    sub: "переход dp[i] = dp[i-1] + dp[i-2] · оба входа уже заполнены",
    plus: "+",
    equation: "dp[5] = dp[4] + dp[3] = 3 + 2 = 5",
    readNote: "dp[4] и dp[3] заполнены ранними итерациями",
    writeNote: "запиши dp[5] = 5, сдвинь i к 6",
    caption:
      "Один табулированный шаг при i = 5: dp[5] = dp[4] + dp[3] = 3 + 2 = 5. Оба входа заполнены ранними итерациями цикла, так что ячейка записывается раз и никогда не пересчитывается.",
  },
};

const t = dict[lang];

const inputs = [
  { label: "dp[3]", value: "2", x: 90 },
  { label: "dp[4]", value: "3", x: 270 },
];
const boxY = 150;
const boxW = 130;
const boxH = 84;
const midY = boxY + boxH / 2;
const resultX = 500;
const resultW = 170;
const arrowX1 = 420;
const arrowX2 = resultX;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {inputs.map((b) => (
      <g>
        <text x={b.x + boxW / 2} y="132" text-anchor="middle" font-size="12" fill="var(--muted)">{b.label}</text>
        <rect x={b.x} y={boxY} width={boxW} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={b.x + boxW / 2} y={midY + 10} text-anchor="middle" font-size="28" fill="var(--ink)">{b.value}</text>
      </g>
    ))}

    <text x="245" y={midY + 8} text-anchor="middle" font-size="26" fill="var(--muted)">{t.plus}</text>

    <line x1={arrowX1} y1={midY} x2={arrowX2 - 10} y2={midY} stroke="var(--accent)" stroke-width="3" />
    <polygon points={`${arrowX2 - 10},${midY - 7} ${arrowX2 - 10},${midY + 7} ${arrowX2},${midY}`} fill="var(--accent)" />

    <text x={resultX + resultW / 2} y="132" text-anchor="middle" font-size="12" fill="var(--muted)">dp[5]</text>
    <rect x={resultX} y={boxY} width={resultW} height={boxH} fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x={resultX + resultW / 2} y={midY + 10} text-anchor="middle" font-size="28" fill="var(--card)">5</text>

    <text x="400" y="292" text-anchor="middle" font-size="18" fill="var(--ink)">{t.equation}</text>
    <text x="400" y="326" text-anchor="middle" font-size="13" fill="var(--muted)">{t.readNote}</text>
    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--muted)">{t.writeNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
