---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Fibonacci dp table filling left to right from dp[0]=0, dp[1]=1 to dp[7]=13",
    headline: "SEED THE BASES, LOOP LEFT TO RIGHT",
    sub: "dp[0] = 0 · dp[1] = 1 · dp[i] = dp[i-1] + dp[i-2]",
    baseTag: "base",
    answerTag: "answer",
    orderLabel: "iteration order: i = 2 → 7",
    answer: "answer: dp[7] = 13",
    note: "every cell reads two already-filled cells — no recursion, no stack",
    caption:
      "Tabulated fib(7): seed dp[0] = 0 and dp[1] = 1, then loop i = 2..7 left to right with dp[i] = dp[i-1] + dp[i-2], giving [0, 1, 1, 2, 3, 5, 8, 13] and dp[7] = 13.",
  },
  ru: {
    svgTitle: "Таблица dp Фибоначчи заполняется слева направо от dp[0]=0, dp[1]=1 до dp[7]=13",
    headline: "ЗАСЕЙ БАЗЫ, ЦИКЛ СЛЕВА НАПРАВО",
    sub: "dp[0] = 0 · dp[1] = 1 · dp[i] = dp[i-1] + dp[i-2]",
    baseTag: "база",
    answerTag: "ответ",
    orderLabel: "порядок обхода: i = 2 → 7",
    answer: "ответ: dp[7] = 13",
    note: "каждая ячейка читает две уже заполненные — без рекурсии, без стека",
    caption:
      "Табулированный fib(7): засей dp[0] = 0 и dp[1] = 1, затем цикл i = 2..7 слева направо с dp[i] = dp[i-1] + dp[i-2], получая [0, 1, 1, 2, 3, 5, 8, 13] и dp[7] = 13.",
  },
};

const t = dict[lang];

const values = ["0", "1", "1", "2", "3", "5", "8", "13"];
const labels = ["0", "1", "2", "3", "4", "5", "6", "7"];

const x0 = 102;
const cw = 64;
const ch = 56;
const cellY = 140;
const step = 76;
const cellX = (i: number) => x0 + i * step;
const cellFill = (i: number) => (i <= 1 ? "var(--accent)" : i === 7 ? "var(--ink)" : "var(--card)");
const cellText = (i: number) => (i <= 1 || i === 7 ? "var(--card)" : "var(--ink)");
const arrowY = 236;
const arrowX1 = x0 + 32;
const arrowX2 = x0 + 7 * step + 32;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {values.map((v, i) => (
      <g>
        <text x={cellX(i) + cw / 2} y="122" text-anchor="middle" font-size="12" fill="var(--muted)">dp[{labels[i]}]</text>
        <rect x={cellX(i)} y={cellY} width={cw} height={ch} fill={cellFill(i)} stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y={cellY + 37} text-anchor="middle" font-size="16" fill={cellText(i)}>{v}</text>
      </g>
    ))}

    <text x={cellX(0) + cw} y={cellY + ch + 22} text-anchor="middle" font-size="12" fill="var(--accent)">{t.baseTag}</text>
    <text x={cellX(7) + cw / 2} y={cellY + ch + 22} text-anchor="middle" font-size="12" fill="var(--ink)">{t.answerTag}</text>

    <line x1={arrowX1} y1={arrowY} x2={arrowX2 - 10} y2={arrowY} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${arrowX2 - 10},${arrowY - 6} ${arrowX2 - 10},${arrowY + 6} ${arrowX2},${arrowY}`} fill="var(--accent)" />
    <text x="400" y={arrowY + 28} text-anchor="middle" font-size="13" fill="var(--ink)">{t.orderLabel}</text>

    <text x="400" y="318" text-anchor="middle" font-size="16" fill="var(--ink)">{t.answer}</text>
    <text x="400" y="360" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
