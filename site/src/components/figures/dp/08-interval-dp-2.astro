---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Matrix chain split at k=3: trying every split and keeping 26000",
    headline: "GUESS THE LAST MULTIPLICATION, TRY EVERY k",
    sub: "dp[i][j] = min over k of dp[i][k] + dp[k+1][j] + p[i-1]·p[k]·p[j]",
    candLabel: "candidates for dp[1][4] with p = [40, 20, 30, 10, 30]:",
    winner: "min",
    note: "(A1 A2 A3) first, then × A4 — the split point is the whole game",
    caption:
      "Matrix chain A1·A2·A3·A4 with p = [40, 20, 30, 10, 30]: the last multiplication splits the chain at some k, so dp[1][4] tries k = 1 (36000), k = 2 (69000) and k = 3 (14000 + 0 + 12000 = 26000) and keeps the minimum 26000.",
  },
  ru: {
    svgTitle: "Цепочка матриц с разбиением в k=3: пробуем каждое разбиение и держим 26000",
    headline: "УГАДАЙ ПОСЛЕДНЕЕ УМНОЖЕНИЕ, ПРОБУЙ КАЖДОЕ k",
    sub: "dp[i][j] = min по k из dp[i][k] + dp[k+1][j] + p[i-1]·p[k]·p[j]",
    candLabel: "кандидаты для dp[1][4] при p = [40, 20, 30, 10, 30]:",
    winner: "мин",
    note: "сначала (A1 A2 A3), потом × A4 — точка разбиения это вся игра",
    caption:
      "Цепочка матриц A1·A2·A3·A4 с p = [40, 20, 30, 10, 30]: последнее умножение разбивает цепочку в некотором k, так dp[1][4] пробует k = 1 (36000), k = 2 (69000) и k = 3 (14000 + 0 + 12000 = 26000) и держит минимум 26000.",
  },
};

const t = dict[lang];

const mats = [
  { name: "A1", dims: "40x20" },
  { name: "A2", dims: "20x30" },
  { name: "A3", dims: "30x10" },
  { name: "A4", dims: "10x30" },
];
const mx0 = 168;
const mw = 104;
const mh = 52;
const my = 120;
const mstep = 120;
const matX = (i: number) => mx0 + i * mstep;
const splitX = mx0 + 3 * mstep - 8;

const rows = [
  { label: "k = 1: 0 + 12000 + 24000 = 36000", win: false },
  { label: "k = 2: 24000 + 9000 + 36000 = 69000", win: false },
  { label: `k = 3: 14000 + 0 + 12000 = 26000 · ${t.winner}`, win: true },
];
const rx = 150;
const rw = 500;
const rh = 38;
const ry = (i: number) => 212 + i * 44;
const rowFill = (win: boolean) => (win ? "var(--accent)" : "var(--card)");
const rowText = (win: boolean) => (win ? "var(--card)" : "var(--ink)");
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="62" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={splitX} y="112" text-anchor="middle" font-size="12" fill="var(--accent)">k = 3</text>
    {mats.map((m, i) => (
      <g>
        <rect x={matX(i)} y={my} width={mw} height={mh} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={matX(i) + mw / 2} y={my + 22} text-anchor="middle" font-size="14" fill="var(--ink)">{m.name}</text>
        <text x={matX(i) + mw / 2} y={my + 41} text-anchor="middle" font-size="12" fill="var(--muted)">{m.dims}</text>
      </g>
    ))}
    <line x1={splitX} y1={my} x2={splitX} y2={my + mh} stroke="var(--accent)" stroke-width="3" />

    <text x={rx} y="202" font-size="13" fill="var(--ink)">{t.candLabel}</text>
    {rows.map((r, i) => (
      <g>
        <rect x={rx} y={ry(i)} width={rw} height={rh} fill={rowFill(r.win)} stroke="var(--ink)" stroke-width="2" />
        <text x={rx + 16} y={ry(i) + 25} font-size="13" fill={rowText(r.win)}>{r.label}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
