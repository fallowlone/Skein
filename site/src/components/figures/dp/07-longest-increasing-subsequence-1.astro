---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "LIS of [10, 9, 2, 5, 3, 7, 101, 18]: scattered picks of length 4",
    headline: "LIS: SCATTERED, ORDER KEPT, LENGTH 4",
    sub: "subsequence = delete freely, never reorder · strictly increasing",
    rowNums: "nums",
    rowOne: "one LIS",
    rowAnother: "another LIS",
    pickLabel: "pick, keep order",
    note: "scattered picks, order kept — LIS length 4",
    caption:
      "nums = [10, 9, 2, 5, 3, 7, 101, 18] with one LIS 2, 5, 7, 101 and another 2, 3, 7, 18, both length 4: a subsequence keeps order but need not be adjacent.",
  },
  ru: {
    svgTitle: "LIS массива [10, 9, 2, 5, 3, 7, 101, 18]: разбросанный выбор длины 4",
    headline: "LIS: РАЗБРОСАНА, ПОРЯДОК СОХРАНЁН, ДЛИНА 4",
    sub: "подпоследовательность = удаляй свободно, не переупорядочивай · строго возрастает",
    rowNums: "массив",
    rowOne: "одна LIS",
    rowAnother: "другая LIS",
    pickLabel: "выбери, сохрани порядок",
    note: "выбор разбросан, порядок сохранён — длина LIS 4",
    caption:
      "nums = [10, 9, 2, 5, 3, 7, 101, 18] с одной LIS 2, 5, 7, 101 и другой 2, 3, 7, 18, обе длины 4: подпоследовательность сохраняет порядок, но не обязана быть подряд.",
  },
};

const t = dict[lang];

const nums = ["10", "9", "2", "5", "3", "7", "101", "18"];
const hi = [2, 3, 5, 6];
const lisA = ["2", "5", "7", "101"];
const lisB = ["2", "3", "7", "18"];
const links = [0, 1, 2];

const x0 = 270;
const cw = 52;
const ch = 48;
const step = 64;
const cellX = (i: number) => x0 + i * step;

const lx0 = 270;
const lcw = 56;
const lstep = 80;
const lisX = (i: number) => lx0 + i * lstep;
const linkX1 = (i: number) => lx0 + i * lstep + lcw + 3;
const linkX2 = (i: number) => lx0 + (i + 1) * lstep - 10;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="252" y="145" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowNums}</text>
    {nums.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="116" width={cw} height={ch} fill={hi.includes(i) ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="145" text-anchor="middle" font-size="15" fill={hi.includes(i) ? "var(--card)" : "var(--ink)"}>{v}</text>
      </g>
    ))}

    <line x1="400" y1="170" x2="400" y2="194" stroke="var(--accent)" stroke-width="2" />
    <polygon points="393,194 407,194 400,204" fill="var(--accent)" />
    <text x="412" y="190" font-size="12" fill="var(--ink)">{t.pickLabel}</text>

    <text x="252" y="235" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowOne}</text>
    {lisA.map((v, i) => (
      <g>
        <rect x={lisX(i)} y="206" width={lcw} height={ch} fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
        <text x={lisX(i) + lcw / 2} y="235" text-anchor="middle" font-size="15" fill="var(--card)">{v}</text>
      </g>
    ))}
    {links.map((i) => (
      <g>
        <line x1={linkX1(i)} y1="230" x2={linkX2(i)} y2="230" stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${linkX2(i)},225 ${linkX2(i)},235 ${linkX2(i) + 8},230`} fill="var(--accent)" />
      </g>
    ))}

    <text x="252" y="325" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowAnother}</text>
    {lisB.map((v, i) => (
      <g>
        <rect x={lisX(i)} y="296" width={lcw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={lisX(i) + lcw / 2} y="325" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {links.map((i) => (
      <g>
        <line x1={linkX1(i)} y1="320" x2={linkX2(i)} y2="320" stroke="var(--ink)" stroke-width="2" />
        <polygon points={`${linkX2(i)},315 ${linkX2(i)},325 ${linkX2(i) + 8},320`} fill="var(--ink)" />
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
