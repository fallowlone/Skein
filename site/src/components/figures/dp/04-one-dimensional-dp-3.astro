---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Decode Ways on 226 giving dp 1, 1, 2, 3 and 3 decodings; 06 and 100 give 0",
    headline: "DECODE WAYS: COUNT WITH ZEROS IN MIND",
    sub: "state: dp[i] = ways to decode the first i chars · A=1 .. Z=26",
    rowS: "s",
    rowDp: "dp[i]",
    legSingle: "+ dp[2]: one digit 6 (1..9)",
    legPair: "+ dp[1]: pair 26 (10..26)",
    equation: "dp[3] = dp[2] + dp[1] = 2 + 1 = 3",
    decodings: "BBF · BZ · VF = 3 ways",
    answerTag: "← answer",
    zeroTitle: "zeros kill the count",
    case06: '"06": leading zero',
    case06Res: "dp[1] = 0 → answer 0",
    case100: '"100": trailing zero',
    case100Res: 'partner "00" invalid → 0',
    note: 'only "10" and "20" ever consume a \'0\'',
    caption:
      '"226" decodes 3 ways (BBF, BZ, VF): dp = [1, 1, 2, 3] with dp[3] = dp[2] + dp[1] = 2 + 1 = 3 — the single digit 6 adds dp[2], the pair 26 adds dp[1]. But "06" gives 0 (leading zero) and "100" gives 0 (final zero, invalid partner "00").',
  },
  ru: {
    svgTitle: "Способы декодирования на 226 дают dp 1, 1, 2, 3 и 3 декодирования; 06 и 100 дают 0",
    headline: "СПОСОБЫ ДЕКОДИРОВАНИЯ: СЧИТАЙ С НУЛЯМИ",
    sub: "состояние: dp[i] = способы декодировать первые i символов · A=1 .. Z=26",
    rowS: "s",
    rowDp: "dp[i]",
    legSingle: "+ dp[2]: одна цифра 6 (1..9)",
    legPair: "+ dp[1]: пара 26 (10..26)",
    equation: "dp[3] = dp[2] + dp[1] = 2 + 1 = 3",
    decodings: "BBF · BZ · VF = 3 способа",
    answerTag: "← ответ",
    zeroTitle: "нули убивают счёт",
    case06: '"06": ведущий ноль',
    case06Res: "dp[1] = 0 → ответ 0",
    case100: '"100": хвостовой ноль',
    case100Res: 'пара "00" не подходит → 0',
    note: 'только "10" и "20" потребляют \'0\'',
    caption:
      '"226" декодируется 3 способами (BBF, BZ, VF): dp = [1, 1, 2, 3], где dp[3] = dp[2] + dp[1] = 2 + 1 = 3 — одиночная цифра 6 прибавляет dp[2], пара 26 прибавляет dp[1]. Но "06" даёт 0 (ведущий ноль), а "100" даёт 0 (финальный ноль, невалидная пара "00").',
  },
};

const t = dict[lang];

const sChars = ["2", "2", "6"];
const dpIdx = ["0", "1", "2", "3"];
const dpVals = ["1", "1", "2", "3"];
const dpFill = ["var(--card)", "var(--card)", "var(--card)", "var(--accent)"];
const dpText = ["var(--ink)", "var(--ink)", "var(--ink)", "var(--card)"];
const zero06 = ["0", "6"];
const zero100 = ["1", "0", "0"];

const x0 = 60;
const cw = 64;
const step = 80;
const cellY = 118;
const ch = 44;
const cellX = (i: number) => x0 + i * step;
const cellC = (i: number) => x0 + i * step + cw / 2;
const sX = (i: number) => x0 + (i + 1) * step + cw / 2;

const zx = 440;
const zw = 44;
const zstep = 54;
const zcellX = (i: number) => zx + i * zstep;
const zcellC = (i: number) => zx + i * zstep + zw / 2;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="32" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="56" text-anchor="middle" font-size="12.5" fill="var(--muted)">{t.sub}</text>

    <text x="48" y="94" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowS}</text>
    {sChars.map((v, i) => (
      <text x={sX(i)} y="94" text-anchor="middle" font-size="13" fill="var(--ink)">{v}</text>
    ))}

    <text x="48" y="147" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowDp}</text>
    {dpIdx.map((v, i) => (
      <text x={cellC(i)} y="110" text-anchor="middle" font-size="11" fill="var(--muted)">{v}</text>
    ))}
    {dpVals.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={cellY} width={cw} height={ch} rx="5" fill={dpFill[i]} stroke="var(--ink)" stroke-width="2" />
        <text x={cellC(i)} y="146" text-anchor="middle" font-size="15" fill={dpText[i]}>{v}</text>
      </g>
    ))}
    <text x="376" y="145" font-size="12" fill="var(--accent)">{t.answerTag}</text>

    <path d="M252 162 C252 186, 332 186, 332 162" fill="none" stroke="var(--muted)" stroke-width="1.6" marker-end="url(#dp04f3-m)" />
    <path d="M172 162 C172 216, 332 216, 332 162" fill="none" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#dp04f3-a)" />
    <text x="60" y="246" font-size="12" fill="var(--muted)">{t.legSingle}</text>
    <text x="60" y="266" font-size="12" fill="var(--accent)">{t.legPair}</text>
    <text x="60" y="300" font-size="13" fill="var(--ink)">{t.equation}</text>
    <text x="60" y="330" font-size="13" fill="var(--ink)">{t.decodings}</text>

    <text x="440" y="94" font-size="13" fill="var(--ink)">{t.zeroTitle}</text>
    <text x="440" y="122" font-size="12" fill="var(--muted)">{t.case06}</text>
    {zero06.map((v, i) => (
      <g>
        <rect x={zcellX(i)} y="132" width={zw} height="40" rx="5" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={zcellC(i)} y="158" text-anchor="middle" font-size="14" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="556" y="157" font-size="12" fill="var(--ink)">{t.case06Res}</text>

    <text x="440" y="208" font-size="12" fill="var(--muted)">{t.case100}</text>
    {zero100.map((v, i) => (
      <g>
        <rect x={zcellX(i)} y="218" width={zw} height="40" rx="5" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={zcellC(i)} y="244" text-anchor="middle" font-size="14" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="606" y="243" font-size="12" fill="var(--ink)">{t.case100Res}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12.5" fill="var(--muted)">{t.note}</text>

    <defs>
      <marker id="dp04f3-m" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--muted)" />
      </marker>
      <marker id="dp04f3-a" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--accent)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
