---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Tails trace for [10, 9, 2, 5, 3, 7, 101, 18] ending at length 4",
    headline: "TAILS: APPEND OR REPLACE, LENGTH 4",
    sub: "tails[k] = smallest tail of a length-(k+1) run · lower bound on x",
    append: "append",
    r0: "replace tails[0]",
    r1: "replace tails[1]",
    r3: "replace tails[3]",
    xEq: "x =",
    tailsEq: "tails =",
    final: "tails = [2, 3, 7, 18] · length 4 = LIS length",
    note: "length is the answer — contents are not a guaranteed subsequence",
    caption:
      "Tails trace for [10, 9, 2, 5, 3, 7, 101, 18]: append when x beats every tail, else replace the first tail ≥ x; final tails = [2, 3, 7, 18], length 4.",
  },
  ru: {
    svgTitle: "Трассировка хвостов для [10, 9, 2, 5, 3, 7, 101, 18] с итогом длины 4",
    headline: "ХВОСТЫ: ДОБАВЬ ИЛИ ЗАМЕНИ, ДЛИНА 4",
    sub: "tails[k] = наименьший хвост цепочки длины (k+1) · нижняя граница для x",
    append: "добавить",
    r0: "заменить tails[0]",
    r1: "заменить tails[1]",
    r3: "заменить tails[3]",
    xEq: "x =",
    tailsEq: "tails =",
    final: "tails = [2, 3, 7, 18] · длина 4 = длина LIS",
    note: "ответ — длина, содержимое не обязано быть подпоследовательностью",
    caption:
      "Трассировка хвостов для [10, 9, 2, 5, 3, 7, 101, 18]: добавь в конец когда x бьёт каждый хвост, иначе замени первый хвост ≥ x; итог tails = [2, 3, 7, 18], длина 4.",
  },
};

const t = dict[lang];

const rows = [
  { x: "10", op: dict[lang].append, tails: "[10]" },
  { x: "9", op: dict[lang].r0, tails: "[9]" },
  { x: "2", op: dict[lang].r0, tails: "[2]" },
  { x: "5", op: dict[lang].append, tails: "[2, 5]" },
  { x: "3", op: dict[lang].r1, tails: "[2, 3]" },
  { x: "7", op: dict[lang].append, tails: "[2, 3, 7]" },
  { x: "101", op: dict[lang].append, tails: "[2, 3, 7, 101]" },
  { x: "18", op: dict[lang].r3, tails: "[2, 3, 7, 18]" },
];

const rowY = (i: number) => 108 + i * 30;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {rows.map((r, i) => (
      <g>
        <text x="170" y={rowY(i)} font-size="15" fill="var(--ink)">{`${t.xEq} ${r.x}`}</text>
        <text x="280" y={rowY(i)} font-size="15" fill="var(--muted)">{r.op}</text>
        <text x="500" y={rowY(i)} font-size="15" fill="var(--ink)">{`${t.tailsEq} ${r.tails}`}</text>
      </g>
    ))}

    <text x="400" y="356" text-anchor="middle" font-size="15" fill="var(--accent)">{t.final}</text>
    <text x="400" y="390" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
