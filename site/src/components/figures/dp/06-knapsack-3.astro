---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Downward loop takes item once for 0/1, upward loop reuses it for unbounded",
    headline: "LOOP DIRECTION DECIDES: 0/1 OR UNBOUNDED",
    sub: "one item (2,3) · W = 6 · downward takes it once, upward takes it 3×",
    panelLeft: "DOWNWARD → 0/1",
    panelRight: "UPWARD → unbounded",
    codeLeft: "for (w = W; w >= wt; w--)",
    codeRight: "for (w = wt; w <= W; w++)",
    commentLeft: "// downward = 0/1",
    commentRight: "// upward = unbounded",
    resultLeft: "dp[6] = 3 · take once",
    resultRight: "dp[6] = 9 · take 3×",
    note1: "same item (2,3), same W = 6 — only the loop direction flips",
    note2: "upward reads dp[w - wt] after it already holds item i: reuse",
    caption:
      "One item (2,3) with W = 6: the downward loop returns 3 (take it once — correct 0/1), while the upward loop returns 9 (take it three times — silently unbounded). Sweeping up reads dp[w - wt] after it already absorbed the current item, so the item stacks on itself.",
  },
  ru: {
    svgTitle: "Цикл вниз берёт предмет раз для 0/1, цикл вверх переиспользует его: безграничный",
    headline: "НАПРАВЛЕНИЕ ЦИКЛА РЕШАЕТ: 0/1 ИЛИ БЕЗГРАНИЧНЫЙ",
    sub: "один предмет (2,3) · W = 6 · вниз берёт его раз, вверх — 3 раза",
    panelLeft: "ВНИЗ → 0/1",
    panelRight: "ВВЕРХ → безграничный",
    codeLeft: "for (w = W; w >= wt; w--)",
    codeRight: "for (w = wt; w <= W; w++)",
    commentLeft: "// вниз = 0/1",
    commentRight: "// вверх = безграничный",
    resultLeft: "dp[6] = 3 · взять раз",
    resultRight: "dp[6] = 9 · взять 3×",
    note1: "тот же предмет (2,3), тот же W = 6 — меняется лишь направление цикла",
    note2: "вверх читает dp[w - wt] когда он уже держит предмет i: переиспользование",
    caption:
      "Один предмет (2,3) при W = 6: цикл вниз возвращает 3 (взять раз — корректный 0/1), а цикл вверх возвращает 9 (взять три раза — молча безграничный). Проход вверх читает dp[w - wt] после того как он уже поглотил текущий предмет, так что предмет накладывается на самого себя.",
  },
};

const t = dict[lang];

const leftVals = ["0", "0", "3", "3", "3", "3", "3"];
const rightVals = ["0", "0", "3", "3", "6", "6", "9"];

const lx0 = 30;
const rx0 = 426;
const cw = 44;
const step = 50;
const ch = 48;
const cellY = 146;
const lX = (c: number) => lx0 + c * step;
const rX = (c: number) => rx0 + c * step;
const lCX = (c: number) => lx0 + c * step + cw / 2;
const rCX = (c: number) => rx0 + c * step + cw / 2;

interface Cell {
  x: number;
  v: string;
  fill: string;
  tfill: string;
  stroke: string;
  sw: number;
}

const leftCells: Cell[] = leftVals.map((v, c) => ({
  x: lX(c),
  v,
  fill: "var(--card)",
  tfill: "var(--ink)",
  stroke: c === 6 ? "var(--accent)" : "var(--ink)",
  sw: c === 6 ? 3 : 2,
}));

const rightCells: Cell[] = rightVals.map((v, c) => {
  const reused = c === 4 || c === 5 || c === 6;
  return {
    x: rX(c),
    v,
    fill: reused ? "var(--accent)" : "var(--card)",
    tfill: reused ? "var(--card)" : "var(--ink)",
    stroke: reused ? "var(--accent)" : "var(--ink)",
    sw: 2,
  };
});

const idx = [0, 1, 2, 3, 4, 5, 6];
const leftIdx = idx.map((w) => ({ x: lCX(w), label: `${w}` }));
const rightIdx = idx.map((w) => ({ x: rCX(w), label: `${w}` }));

const arrowY = 216;
const cellBottom = cellY + ch;
const leftElbowX = lCX(6);
const leftTipX = 140;
const leftArrowPath = `M${leftElbowX} ${cellBottom} L${leftElbowX} ${arrowY} L${leftTipX + 9} ${arrowY}`;
const leftArrowHead = `${leftTipX + 9},${arrowY - 6} ${leftTipX + 9},${arrowY + 6} ${leftTipX},${arrowY}`;
const rightElbowX = rCX(2);
const rightTipX = 758;
const rightArrowPath = `M${rightElbowX} ${cellBottom} L${rightElbowX} ${arrowY} L${rightTipX - 9} ${arrowY}`;
const rightArrowHead = `${rightTipX - 9},${arrowY - 6} ${rightTipX - 9},${arrowY + 6} ${rightTipX},${arrowY}`;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="202" y="106" text-anchor="middle" font-size="14" fill="var(--ink)">{t.panelLeft}</text>
    <text x="598" y="106" text-anchor="middle" font-size="14" fill="var(--ink)">{t.panelRight}</text>

    {leftIdx.map((h) => (
      <text x={h.x} y="134" text-anchor="middle" font-size="11" fill="var(--muted)">{h.label}</text>
    ))}
    {rightIdx.map((h) => (
      <text x={h.x} y="134" text-anchor="middle" font-size="11" fill="var(--muted)">{h.label}</text>
    ))}

    {leftCells.map((cell) => (
      <g>
        <rect x={cell.x} y={cellY} width={cw} height={ch} fill={cell.fill} stroke={cell.stroke} stroke-width={cell.sw} />
        <text x={cell.x + cw / 2} y={cellY + 29} text-anchor="middle" font-size="15" fill={cell.tfill}>{cell.v}</text>
      </g>
    ))}
    {rightCells.map((cell) => (
      <g>
        <rect x={cell.x} y={cellY} width={cw} height={ch} fill={cell.fill} stroke={cell.stroke} stroke-width={cell.sw} />
        <text x={cell.x + cw / 2} y={cellY + 29} text-anchor="middle" font-size="15" fill={cell.tfill}>{cell.v}</text>
      </g>
    ))}

    <text x="246" y="210" text-anchor="middle" font-size="11" fill="var(--muted)">6 → 2</text>
    <path d={leftArrowPath} fill="none" stroke="var(--accent)" stroke-width="2" />
    <polygon points={leftArrowHead} fill="var(--accent)" />
    <text x="653" y="210" text-anchor="middle" font-size="11" fill="var(--muted)">2 → 6</text>
    <path d={rightArrowPath} fill="none" stroke="var(--accent)" stroke-width="2" />
    <polygon points={rightArrowHead} fill="var(--accent)" />

    <text x="202" y="248" text-anchor="middle" font-size="11" fill="var(--ink)">{t.codeLeft}</text>
    <text x="598" y="248" text-anchor="middle" font-size="11" fill="var(--ink)">{t.codeRight}</text>
    <text x="202" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.commentLeft}</text>
    <text x="598" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.commentRight}</text>

    <rect x="102" y="292" width="200" height="40" fill="var(--accent)" stroke="var(--accent)" stroke-width="2" />
    <text x="202" y="317" text-anchor="middle" font-size="14" fill="var(--card)">{t.resultLeft}</text>
    <rect x="498" y="292" width="200" height="40" fill="var(--ink)" stroke="var(--ink)" stroke-width="2" />
    <text x="598" y="317" text-anchor="middle" font-size="14" fill="var(--card)">{t.resultRight}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--ink)">{t.note1}</text>
    <text x="400" y="388" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
