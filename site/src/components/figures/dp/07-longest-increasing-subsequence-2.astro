---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "O(n squared) DP table: dp row with max(dp) equal to 4",
    headline: "DP ENDS AT i: 1 + BEST SMALLER PAST",
    sub: "dp[i] = 1 + max(dp[j]) over j<i, nums[j]<nums[i] · answer max(dp)",
    rowNums: "nums",
    rowDp: "dp",
    rowChain: "chain",
    note: "answer = max(dp) = 4 · LIS ends at 101 (index 6)",
    caption:
      "dp = [1, 1, 1, 2, 2, 3, 4, 4] from dp[i] = 1 + max(dp[j]): the chain 2 → 5 → 7 → 101 builds dp 1, 2, 3, 4 and the answer is max(dp) = 4.",
  },
  ru: {
    svgTitle: "Таблица ДП за O(n squared): строка dp с max(dp) равным 4",
    headline: "ДП С КОНЦОМ В i: 1 + ЛУЧШЕЕ ПРОШЛОЕ",
    sub: "dp[i] = 1 + max(dp[j]) по j<i, nums[j]<nums[i] · ответ max(dp)",
    rowNums: "массив",
    rowDp: "dp",
    rowChain: "цепочка",
    note: "ответ = max(dp) = 4 · LIS кончается на 101 (индекс 6)",
    caption:
      "dp = [1, 1, 1, 2, 2, 3, 4, 4] из dp[i] = 1 + max(dp[j]): цепочка 2 → 5 → 7 → 101 строит dp 1, 2, 3, 4, а ответ это max(dp) = 4.",
  },
};

const t = dict[lang];

const nums = ["10", "9", "2", "5", "3", "7", "101", "18"];
const dp = ["1", "1", "1", "2", "2", "3", "4", "4"];
const dpHi = [6, 7];
const chain = [
  { v: "2", d: "dp 1" },
  { v: "5", d: "dp 2" },
  { v: "7", d: "dp 3" },
  { v: "101", d: "dp 4" },
];
const links = [0, 1, 2];

const x0 = 270;
const cw = 52;
const ch = 48;
const step = 64;
const cellX = (i: number) => x0 + i * step;

const cx0 = 184;
const ccw = 90;
const cstep = 114;
const chainX = (i: number) => cx0 + i * cstep;
const linkX1 = (i: number) => cx0 + i * cstep + ccw + 3;
const linkX2 = (i: number) => cx0 + (i + 1) * cstep - 10;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="252" y="145" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowNums}</text>
    {nums.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="116" width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="145" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="252" y="235" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowDp}</text>
    {dp.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="206" width={cw} height={ch} fill={dpHi.includes(i) ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="235" text-anchor="middle" font-size="15" fill={dpHi.includes(i) ? "var(--card)" : "var(--ink)"}>{v}</text>
      </g>
    ))}

    <text x="166" y="325" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowChain}</text>
    {chain.map((c, i) => (
      <g>
        <rect x={chainX(i)} y="296" width={ccw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={chainX(i) + ccw / 2} y="325" text-anchor="middle" font-size="14" fill="var(--ink)">{`${c.v} · ${c.d}`}</text>
      </g>
    ))}
    {links.map((i) => (
      <g>
        <line x1={linkX1(i)} y1="320" x2={linkX2(i)} y2="320" stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${linkX2(i)},315 ${linkX2(i)},325 ${linkX2(i) + 8},320`} fill="var(--accent)" />
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
