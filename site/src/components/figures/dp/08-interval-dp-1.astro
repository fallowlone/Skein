---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Interval DP table filled diagonal by diagonal from length 1 to the answer dp[1][4]",
    headline: "FILL BY LENGTH: DIAGONAL AFTER DIAGONAL",
    sub: "dp[i][j] reads only shorter slices — length 1 first, full interval last",
    legend: "len 1 → len 2 → len 3 → len 4 · number = diagonal = length − 1",
    note: "only i ≤ j is used · each cell reads earlier diagonals · dp[1][4] is the answer",
    caption:
      "Length-first fill of a 4×4 interval table: only the upper triangle (i ≤ j) is used, the main diagonal holds length-1 slices, and each longer diagonal fills after all shorter ones, ending at dp[1][4] in the top-right corner.",
  },
  ru: {
    svgTitle: "Таблица интервальной ДП заполняется диагональ за диагональю от длины 1 до ответа dp[1][4]",
    headline: "ЗАПОЛНЕНИЕ ПО ДЛИНЕ: ДИАГОНАЛЬ ЗА ДИАГОНАЛЬЮ",
    sub: "dp[i][j] читает только более короткие срезы — длина 1 сначала, полный интервал последним",
    legend: "длина 1 → длина 2 → длина 3 → длина 4 · число = диагональ = длина − 1",
    note: "используется только i ≤ j · каждая клетка читает более ранние диагонали · dp[1][4] — ответ",
    caption:
      "Заполнение таблицы интервалов 4×4 длина-сначала: используется только верхний треугольник (i ≤ j), главная диагональ держит срезы длины 1, и каждая более длинная диагональ заполняется после всех более коротких, заканчивая на dp[1][4] в правом верхнем углу.",
  },
};

const t = dict[lang];

const x0 = 208;
const y0 = 100;
const cw = 96;
const ch = 56;

interface Cell {
  i: number;
  j: number;
  x: number;
  y: number;
  v: string;
  fill: string;
  tfill: string;
}

const cells: Cell[] = [];
for (let i = 1; i <= 4; i++) {
  for (let j = i; j <= 4; j++) {
    const win = i === 1 && j === 4;
    cells.push({
      i,
      j,
      x: x0 + (j - 1) * cw,
      y: y0 + (i - 1) * ch,
      v: String(j - i),
      fill: win ? "var(--accent)" : "var(--card)",
      tfill: win ? "var(--card)" : "var(--ink)",
    });
  }
}

const colHeads = ["j = 1", "j = 2", "j = 3", "j = 4"];
const rowHeads = ["i = 1", "i = 2", "i = 3", "i = 4"];
const colX = (c: number) => x0 + c * cw + cw / 2;
const rowY = (r: number) => y0 + r * ch + ch / 2 + 5;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {colHeads.map((h, c) => (
      <text x={colX(c)} y="92" text-anchor="middle" font-size="12" fill="var(--muted)">{h}</text>
    ))}
    {rowHeads.map((h, r) => (
      <text x="200" y={rowY(r)} text-anchor="end" font-size="12" fill="var(--muted)">{h}</text>
    ))}

    {cells.map((cell) => (
      <g>
        <rect x={cell.x} y={cell.y} width={cw} height={ch} fill={cell.fill} stroke="var(--ink)" stroke-width="2" />
        <text x={cell.x + cw / 2} y={cell.y + ch / 2 + 6} text-anchor="middle" font-size="16" fill={cell.tfill}>{cell.v}</text>
      </g>
    ))}

    <text x="400" y="356" text-anchor="middle" font-size="13" fill="var(--ink)">{t.legend}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
