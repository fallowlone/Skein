---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "House Robber skip-versus-rob transition computing dp[2] = 11, answer dp[4] = 12",
    headline: "SKIP IT OR ROB IT — KEEP THE MAX",
    sub: "state: dp[i] = best loot over houses 0..i · never rob adjacent",
    recurrence: "dp[i] = max(dp[i-1], dp[i-2] + nums[i])",
    rowNums: "nums[i]",
    rowDp: "dp[i]",
    skipLabel: "skip = dp[1] = 7",
    robLabel: "rob = dp[0] + nums[2] = 2 + 9 = 11",
    formula: "dp[2] = max(7, 11) = 11",
    answerTag: "← answer",
    note: "answer dp[4] = 12: rob houses 0, 2, 4 (2 + 9 + 1)",
    caption:
      "House Robber on nums = [2, 7, 9, 3, 1] fills dp = [2, 7, 11, 11, 12]. Cell dp[2] = max(skip dp[1] = 7, rob dp[0] + nums[2] = 2 + 9 = 11) = 11; the last cell dp[4] = 12 — rob houses 0, 2, 4 for 2 + 9 + 1 — is the answer.",
  },
  ru: {
    svgTitle: "Грабитель домов: переход пропустить-против-ограбить вычисляет dp[2] = 11, ответ dp[4] = 12",
    headline: "ПРОПУСТИТЬ ИЛИ ОГРАБИТЬ — ДЕРЖИ MAX",
    sub: "состояние: dp[i] = лучшая добыча по домам 0..i · соседние грабить нельзя",
    recurrence: "dp[i] = max(dp[i-1], dp[i-2] + nums[i])",
    rowNums: "nums[i]",
    rowDp: "dp[i]",
    skipLabel: "пропустить = dp[1] = 7",
    robLabel: "ограбить = dp[0] + nums[2] = 2 + 9 = 11",
    formula: "dp[2] = max(7, 11) = 11",
    answerTag: "← ответ",
    note: "ответ dp[4] = 12: ограбить дома 0, 2, 4 (2 + 9 + 1)",
    caption:
      "Грабитель домов на nums = [2, 7, 9, 3, 1] заполняет dp = [2, 7, 11, 11, 12]. Ячейка dp[2] = max(пропустить dp[1] = 7, ограбить dp[0] + nums[2] = 2 + 9 = 11) = 11; последняя ячейка dp[4] = 12 — ограбить дома 0, 2, 4 ради 2 + 9 + 1 — это ответ.",
  },
};

const t = dict[lang];

const idx = ["0", "1", "2", "3", "4"];
const nums = ["2", "7", "9", "3", "1"];
const dp = ["2", "7", "11", "11", "12"];
const dpFill = ["var(--card)", "var(--card)", "var(--card)", "var(--card)", "var(--accent)"];
const dpText = ["var(--ink)", "var(--ink)", "var(--ink)", "var(--ink)", "var(--card)"];
const dpStroke = ["var(--ink)", "var(--ink)", "var(--accent)", "var(--ink)", "var(--accent)"];

const x0 = 210;
const cw = 64;
const step = 76;
const cellY = 146;
const ch = 46;
const cellX = (i: number) => x0 + i * step;
const cellC = (i: number) => x0 + i * step + cw / 2;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="32" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="56" text-anchor="middle" font-size="12.5" fill="var(--muted)">{t.sub}</text>
    <text x="400" y="82" text-anchor="middle" font-size="14" fill="var(--ink)">{t.recurrence}</text>

    <text x="196" y="118" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowNums}</text>
    {nums.map((v, i) => (
      <text x={cellC(i)} y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{v}</text>
    ))}

    <text x="196" y="174" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowDp}</text>
    {idx.map((v, i) => (
      <text x={cellC(i)} y="138" text-anchor="middle" font-size="11" fill="var(--muted)">{v}</text>
    ))}
    {dp.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={cellY} width={cw} height={ch} rx="5" fill={dpFill[i]} stroke={dpStroke[i]} stroke-width="2" />
        <text x={cellC(i)} y="175" text-anchor="middle" font-size="15" fill={dpText[i]}>{v}</text>
      </g>
    ))}
    <text x="592" y="174" font-size="12" fill="var(--accent)">{t.answerTag}</text>

    <path d="M318 192 C318 220, 394 220, 394 192" fill="none" stroke="var(--muted)" stroke-width="1.6" marker-end="url(#dp04f1-m)" />
    <path d="M242 192 C242 282, 394 282, 394 192" fill="none" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#dp04f1-a)" />
    <text x="496" y="228" text-anchor="middle" font-size="12" fill="var(--muted)">{t.skipLabel}</text>
    <text x="318" y="298" text-anchor="middle" font-size="12" fill="var(--accent)">{t.robLabel}</text>

    <text x="400" y="340" text-anchor="middle" font-size="14" fill="var(--ink)">{t.formula}</text>
    <text x="400" y="380" text-anchor="middle" font-size="12.5" fill="var(--muted)">{t.note}</text>

    <defs>
      <marker id="dp04f1-m" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--muted)" />
      </marker>
      <marker id="dp04f1-a" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--accent)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
