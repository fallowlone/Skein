---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "LCS table for AB over AC reading three neighbours into dp[2][2] = 1",
    headline: "LCS READS THREE NEIGHBOURS",
    sub: 'A = "AB" down rows · B = "AC" across columns',
    colHeads: ["''", "A", "C"],
    rowHeads: ["''", "A", "B"],
    match: "match: dp[i][j] = dp[i-1][j-1] + 1",
    mismatch: "else: max(dp[i-1][j], dp[i][j-1])",
    f11: "dp[1][1] = dp[0][0]+1 = 1 (A==A)",
    f22: "dp[2][2] = max(1, 1) = 1 (B!=C)",
    answer: 'answer: dp[2][2] = 1, LCS is "A"',
    reads: "arrows: above · left · diagonal",
    note: "base row and column are 0: LCS with an empty prefix is empty",
    caption:
      'LCS of A = "AB" (rows) and B = "AC" (columns): the base border is all 0, the match dp[1][1] = dp[0][0] + 1 = 1 extends the diagonal, the mismatch dp[2][2] = max(1, 1) = 1 reads above and left, and the answer dp[2][2] = 1 ("A") sits in the bottom-right cell.',
  },
  ru: {
    svgTitle: "Таблица LCS для AB на AC читает трёх соседей в dp[2][2] = 1",
    headline: "LCS ЧИТАЕТ ТРЁХ СОСЕДЕЙ",
    sub: 'A = "AB" вниз по строкам · B = "AC" по столбцам',
    colHeads: ["''", "A", "C"],
    rowHeads: ["''", "A", "B"],
    match: "совпадение: dp[i][j] = dp[i-1][j-1] + 1",
    mismatch: "иначе: max(dp[i-1][j], dp[i][j-1])",
    f11: "dp[1][1] = dp[0][0]+1 = 1 (A==A)",
    f22: "dp[2][2] = max(1, 1) = 1 (B!=C)",
    answer: 'ответ: dp[2][2] = 1, LCS — "A"',
    reads: "стрелки: сверху · слева · диагональ",
    note: "базовые строка и столбец — 0: LCS с пустым префиксом пуста",
    caption:
      'LCS строк A = "AB" (строки) и B = "AC" (столбцы): базовая граница — все 0, совпадение dp[1][1] = dp[0][0] + 1 = 1 расширяет диагональ, несовпадение dp[2][2] = max(1, 1) = 1 читает сверху и слева, а ответ dp[2][2] = 1 ("A") сидит в правой нижней клетке.',
  },
};

const t = dict[lang];

const rows = [
  ["0", "0", "0"],
  ["0", "1", "1"],
  ["0", "1", "1"],
];
const cells = rows.flatMap((row, r) => row.map((v, c) => ({ r, c, v })));

const x0 = 225;
const y0 = 126;
const size = 60;
const step = 88;
const cellX = (c: number) => x0 + c * step;
const cellY = (r: number) => y0 + r * step;
const isAnswer = (r: number, c: number) => r === 2 && c === 2;
const isNeighbour = (r: number, c: number) =>
  (r === 1 && c === 2) || (r === 2 && c === 1) || (r === 1 && c === 1);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.colHeads.map((lab, c) => (
      <text x={cellX(c) + size / 2} y="114" text-anchor="middle" font-size="13" fill="var(--muted)">{lab}</text>
    ))}
    {t.rowHeads.map((lab, r) => (
      <text x={x0 - 13} y={cellY(r) + 38} text-anchor="end" font-size="13" fill="var(--muted)">{lab}</text>
    ))}
    {cells.map((cell) => (
      <g>
        <rect x={cellX(cell.c)} y={cellY(cell.r)} width={size} height={size} fill={isAnswer(cell.r, cell.c) ? "var(--accent)" : "var(--card)"} stroke={isAnswer(cell.r, cell.c) || isNeighbour(cell.r, cell.c) ? "var(--accent)" : "var(--ink)"} stroke-width={isAnswer(cell.r, cell.c) || isNeighbour(cell.r, cell.c) ? 3 : 2} />
        <text x={cellX(cell.c) + size / 2} y={cellY(cell.r) + 39} text-anchor="middle" font-size="16" fill={isAnswer(cell.r, cell.c) ? "var(--card)" : "var(--ink)"}>{cell.v}</text>
      </g>
    ))}

    <line x1="431" y1="276" x2="431" y2="293" stroke="var(--accent)" stroke-width="2" />
    <polygon points="425,294 437,294 431,302" fill="var(--accent)" />
    <line x1="375" y1="332" x2="392" y2="332" stroke="var(--accent)" stroke-width="2" />
    <polygon points="393,326 393,338 401,332" fill="var(--accent)" />
    <line x1="376" y1="277" x2="390" y2="291" stroke="var(--accent)" stroke-width="2" />
    <polygon points="399,300 395,290 389,296" fill="var(--accent)" />

    <text x="490" y="150" font-size="13" fill="var(--ink)">{t.match}</text>
    <text x="490" y="180" font-size="13" fill="var(--ink)">{t.mismatch}</text>
    <text x="490" y="210" font-size="13" fill="var(--muted)">{t.f11}</text>
    <text x="490" y="240" font-size="13" fill="var(--muted)">{t.f22}</text>
    <text x="490" y="270" font-size="13" fill="var(--ink)">{t.answer}</text>
    <text x="490" y="300" font-size="13" fill="var(--muted)">{t.reads}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
