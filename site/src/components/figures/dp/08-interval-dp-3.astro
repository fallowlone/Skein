---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Solved matrix chain table: dp values 24000, 6000, 9000, 14000, 12000, answer 26000",
    headline: "THE SOLVED CHAIN: dp[1][4] = 26000",
    sub: "dimensions p = [40, 20, 30, 10, 30] · single matrix costs 0",
    complexity: "O(n²) states × O(n) splits = O(n³) time · O(n²) space",
    note: "length-2 diagonal first (one split each), then length 3, then the whole chain",
    caption:
      "Solved matrix chain for p = [40, 20, 30, 10, 30]: length-2 cells are 24000, 6000, 9000, length-3 cells are 14000 and 12000, and the full chain dp[1][4] = 26000. Cost: O(n²) states times O(n) splits = O(n³) time, O(n²) space.",
  },
  ru: {
    svgTitle: "Решённая таблица цепочки матриц: значения 24000, 6000, 9000, 14000, 12000, ответ 26000",
    headline: "РЕШЁННАЯ ЦЕПОЧКА: dp[1][4] = 26000",
    sub: "размерности p = [40, 20, 30, 10, 30] · одиночная матрица стоит 0",
    complexity: "O(n²) состояний × O(n) разбиений = O(n³) время · O(n²) память",
    note: "сначала диагональ длины 2 (по одному разбиению), потом длина 3, потом вся цепочка",
    caption:
      "Решённая цепочка матриц для p = [40, 20, 30, 10, 30]: клетки длины 2 это 24000, 6000, 9000, клетки длины 3 это 14000 и 12000, а вся цепочка dp[1][4] = 26000. Цена: O(n²) состояний умножить на O(n) разбиений = O(n³) время, O(n²) память.",
  },
};

const t = dict[lang];

const mats = ["A1 · 40x20", "A2 · 20x30", "A3 · 30x10", "A4 · 10x30"];
const mx0 = 182;
const mw = 100;
const mstep = 112;
const matX = (i: number) => mx0 + i * mstep;

interface Cell {
  x: number;
  y: number;
  v: string;
  fill: string;
  tfill: string;
}

const x0 = 200;
const y0 = 158;
const cw = 100;
const ch = 44;
const grid: (string | null)[][] = [
  ["0", "24000", "14000", "26000"],
  [null, "0", "6000", "12000"],
  [null, null, "0", "9000"],
  [null, null, null, "0"],
];

const cells: Cell[] = [];
for (let i = 0; i < 4; i++) {
  for (let j = 0; j < 4; j++) {
    const v = grid[i][j];
    if (v !== null) {
      const win = i === 0 && j === 3;
      cells.push({
        x: x0 + j * cw,
        y: y0 + i * ch,
        v,
        fill: win ? "var(--accent)" : "var(--card)",
        tfill: win ? "var(--card)" : "var(--ink)",
      });
    }
  }
}

const colHeads = ["j = 1", "j = 2", "j = 3", "j = 4"];
const rowHeads = ["i = 1", "i = 2", "i = 3", "i = 4"];
const colX = (c: number) => x0 + c * cw + cw / 2;
const rowY = (r: number) => y0 + r * ch + ch / 2 + 5;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {mats.map((m, i) => (
      <g>
        <rect x={matX(i)} y="76" width={mw} height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={matX(i) + mw / 2} y="99" text-anchor="middle" font-size="12" fill="var(--ink)">{m}</text>
      </g>
    ))}

    {colHeads.map((h, c) => (
      <text x={colX(c)} y="150" text-anchor="middle" font-size="12" fill="var(--muted)">{h}</text>
    ))}
    {rowHeads.map((h, r) => (
      <text x="192" y={rowY(r)} text-anchor="end" font-size="12" fill="var(--muted)">{h}</text>
    ))}

    {cells.map((cell) => (
      <g>
        <rect x={cell.x} y={cell.y} width={cw} height={ch} fill={cell.fill} stroke="var(--ink)" stroke-width="2" />
        <text x={cell.x + cw / 2} y={cell.y + ch / 2 + 5} text-anchor="middle" font-size="13" fill={cell.tfill}>{cell.v}</text>
      </g>
    ))}

    <text x="400" y="362" text-anchor="middle" font-size="13" fill="var(--ink)">{t.complexity}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
