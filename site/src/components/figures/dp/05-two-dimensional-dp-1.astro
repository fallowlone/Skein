---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Unique paths on a 3 by 3 grid filled to 6 at the bottom-right",
    headline: "UNIQUE PATHS: ADD FROM ABOVE AND LEFT",
    sub: "dp[i][j] = dp[i-1][j] + dp[i][j-1] · 3 × 3 grid",
    rowLabels: ["r0", "r1", "r2"],
    colLabels: ["c0", "c1", "c2"],
    rec: "dp[i][j] = dp[i-1][j] + dp[i][j-1]",
    base: "base: first row and column are 1",
    sum1: "dp[1][1] = 1 + 1 = 2",
    sum2: "dp[2][2] = 3 + 3 = 6",
    ans: "answer: 6 paths to bottom-right",
    reads: "arrows: the two reads into dp[1][1]",
    note: "base row and column are 1 — one straight-line way to each edge cell",
    caption:
      "Unique paths on a 3 × 3 grid: the base row and column are 1, each interior cell adds the cell above and the cell left (dp[1][1] = 1 + 1 = 2), and the answer dp[2][2] = 3 + 3 = 6 paths sits in the bottom-right cell.",
  },
  ru: {
    svgTitle: "Уникальные пути в сетке 3 на 3 с ответом 6 в правом нижнем углу",
    headline: "УНИКАЛЬНЫЕ ПУТИ: СУММА СВЕРХУ И СЛЕВА",
    sub: "dp[i][j] = dp[i-1][j] + dp[i][j-1] · сетка 3 × 3",
    rowLabels: ["r0", "r1", "r2"],
    colLabels: ["c0", "c1", "c2"],
    rec: "dp[i][j] = dp[i-1][j] + dp[i][j-1]",
    base: "база: первая строка и столбец — 1",
    sum1: "dp[1][1] = 1 + 1 = 2",
    sum2: "dp[2][2] = 3 + 3 = 6",
    ans: "ответ: 6 путей в правый нижний угол",
    reads: "стрелки: два чтения в dp[1][1]",
    note: "базовые строка и столбец — 1: один прямой путь до каждой краевой клетки",
    caption:
      "Уникальные пути в сетке 3 × 3: базовые строка и столбец — 1, каждая внутренняя клетка складывает клетку сверху и слева (dp[1][1] = 1 + 1 = 2), а ответ dp[2][2] = 3 + 3 = 6 путей сидит в правой нижней клетке.",
  },
};

const t = dict[lang];

const rows = [
  ["1", "1", "1"],
  ["1", "2", "3"],
  ["1", "3", "6"],
];
const cells = rows.flatMap((row, r) => row.map((v, c) => ({ r, c, v })));

const x0 = 180;
const y0 = 126;
const size = 60;
const step = 76;
const cellX = (c: number) => x0 + c * step;
const cellY = (r: number) => y0 + r * step;
const isAnswer = (r: number, c: number) => r === 2 && c === 2;
const isBase = (r: number, c: number) => r === 0 || c === 0;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.colLabels.map((lab, c) => (
      <text x={cellX(c) + size / 2} y="114" text-anchor="middle" font-size="12" fill="var(--muted)">{lab}</text>
    ))}
    {t.rowLabels.map((lab, r) => (
      <text x={x0 - 15} y={cellY(r) + 38} text-anchor="end" font-size="12" fill="var(--muted)">{lab}</text>
    ))}
    {cells.map((cell) => (
      <g>
        <rect x={cellX(cell.c)} y={cellY(cell.r)} width={size} height={size} fill={isAnswer(cell.r, cell.c) ? "var(--accent)" : "var(--card)"} stroke={isAnswer(cell.r, cell.c) || isBase(cell.r, cell.c) ? "var(--accent)" : "var(--ink)"} stroke-width={isAnswer(cell.r, cell.c) || isBase(cell.r, cell.c) ? 3 : 2} />
        <text x={cellX(cell.c) + size / 2} y={cellY(cell.r) + 39} text-anchor="middle" font-size="16" fill={isAnswer(cell.r, cell.c) ? "var(--card)" : "var(--ink)"}>{cell.v}</text>
      </g>
    ))}

    <line x1="286" y1="186" x2="286" y2="193" stroke="var(--accent)" stroke-width="2" />
    <polygon points="280,194 292,194 286,202" fill="var(--accent)" />
    <line x1="241" y1="232" x2="248" y2="232" stroke="var(--accent)" stroke-width="2" />
    <polygon points="248,226 248,238 256,232" fill="var(--accent)" />

    <text x="430" y="150" font-size="13" fill="var(--ink)">{t.rec}</text>
    <text x="430" y="180" font-size="13" fill="var(--muted)">{t.base}</text>
    <text x="430" y="210" font-size="13" fill="var(--ink)">{t.sum1}</text>
    <text x="430" y="240" font-size="13" fill="var(--ink)">{t.sum2}</text>
    <text x="430" y="270" font-size="13" fill="var(--ink)">{t.ans}</text>
    <text x="430" y="300" font-size="13" fill="var(--muted)">{t.reads}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
