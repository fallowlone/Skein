---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Naive recursion tree of fib(4): 9 calls, 5 distinct answers",
    headline: "NAIVE RECURSION REPEATS ITSELF",
    sub: "fib(4): 9 calls, only 5 distinct questions",
    formula: "fib(n) = fib(n-1) + fib(n-2) · fib(0) = 0, fib(1) = 1",
    legendFirst: "first solve",
    legendDup: "recomputed duplicate",
    counts: "fib(2) ×2 · fib(1) ×3 · fib(0) ×2",
    caption:
      "Naive fib(4) makes 9 calls but asks only 5 distinct questions: fib(2) is solved twice, fib(1) three times, fib(0) twice. The tree doubles every level while the distinct answers stay flat at n+1.",
  },
  ru: {
    svgTitle: "Дерево наивной рекурсии fib(4): 9 вызовов, 5 различных ответов",
    headline: "НАИВНАЯ РЕКУРСИЯ ПОВТОРЯЕТ СЕБЯ",
    sub: "fib(4): 9 вызовов, лишь 5 различных вопросов",
    formula: "fib(n) = fib(n-1) + fib(n-2) · fib(0) = 0, fib(1) = 1",
    legendFirst: "первое решение",
    legendDup: "пересчитанный дубликат",
    counts: "fib(2) ×2 · fib(1) ×3 · fib(0) ×2",
    caption:
      "Наивный fib(4) делает 9 вызовов, но задаёт лишь 5 различных вопросов: fib(2) решается дважды, fib(1) трижды, fib(0) дважды. Дерево удваивается на каждом уровне, а число различных ответов остаётся плоским — n+1.",
  },
};

const t = dict[lang];

const nw = 64;
const nh = 30;

const nodes = [
  { x: 400, y: 112, label: "fib(4)", dup: false },
  { x: 250, y: 182, label: "fib(3)", dup: false },
  { x: 550, y: 182, label: "fib(2)", dup: true },
  { x: 170, y: 252, label: "fib(2)", dup: false },
  { x: 330, y: 252, label: "fib(1)", dup: true },
  { x: 500, y: 252, label: "fib(1)", dup: true },
  { x: 610, y: 252, label: "fib(0)", dup: false },
  { x: 130, y: 322, label: "fib(1)", dup: false },
  { x: 215, y: 322, label: "fib(0)", dup: true },
];

const edges = [
  { x1: 400, y1: 127, x2: 250, y2: 167 },
  { x1: 400, y1: 127, x2: 550, y2: 167 },
  { x1: 250, y1: 197, x2: 170, y2: 237 },
  { x1: 250, y1: 197, x2: 330, y2: 237 },
  { x1: 550, y1: 197, x2: 500, y2: 237 },
  { x1: 550, y1: 197, x2: 610, y2: 237 },
  { x1: 170, y1: 267, x2: 130, y2: 307 },
  { x1: 170, y1: 267, x2: 215, y2: 307 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="30" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="54" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>
    <text x="400" y="76" text-anchor="middle" font-size="12" fill="var(--muted)">{t.formula}</text>

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
    ))}

    {nodes.map((n) => (
      <g>
        <rect x={n.x - nw / 2} y={n.y - nh / 2} width={nw} height={nh} fill={n.dup ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="13" fill={n.dup ? "var(--card)" : "var(--ink)"}>{n.label}</text>
      </g>
    ))}

    <rect x="150" y="362" width="14" height="14" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="172" y="374" font-size="12" fill="var(--ink)">{t.legendFirst}</text>
    <rect x="400" y="362" width="14" height="14" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="422" y="374" font-size="12" fill="var(--ink)">{t.legendDup}</text>

    <text x="400" y="402" text-anchor="middle" font-size="13" fill="var(--ink)">{t.counts}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
