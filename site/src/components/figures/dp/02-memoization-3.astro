---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "fib(30) costs 2,692,537 naive calls versus 59 memoized calls; complexity table naive, memoization, tabulation",
    headline: "fib(30): 2.7 MILLION CALLS → 59",
    sub: "same answer 832040 · states × work per state",
    naiveTitle: "NAIVE RECURSION",
    naiveBig: "2,692,537",
    naiveSub: "calls · ~2^n",
    memoTitle: "MEMOIZED (TOP-DOWN)",
    memoBig: "59",
    memoSub: "calls · ~2n",
    formula: "time = (distinct states) × (work per state)",
    colMethod: "method",
    colTime: "time",
    colCache: "cache",
    colStack: "stack",
    rowNaive: "naive recursion",
    rowMemo: "memoization · this lesson",
    rowTab: "tabulation · next lesson",
    none: "none",
    note: "memoization pays O(n) twice: the cache plus the recursion stack",
    caption:
      "Memoized fib(30) returns the same 832040 as naive recursion but makes 59 calls (~2n) instead of 2,692,537 (~2^n). Time is distinct states × work per state; space is the O(n) cache plus the O(n) recursion stack that tabulation avoids.",
  },
  ru: {
    svgTitle: "fib(30) стоит 2 692 537 наивных вызовов против 59 мемоизированных; таблица сложности: наивный, мемоизация, табуляция",
    headline: "fib(30): 2,7 МЛН ВЫЗОВОВ → 59",
    sub: "тот же ответ 832040 · состояния × работа на состояние",
    naiveTitle: "НАИВНАЯ РЕКУРСИЯ",
    naiveBig: "2 692 537",
    naiveSub: "вызовов · ~2^n",
    memoTitle: "МЕМОИЗАЦИЯ (СВЕРХУ ВНИЗ)",
    memoBig: "59",
    memoSub: "вызовов · ~2n",
    formula: "время = (отдельные состояния) × (работа на состояние)",
    colMethod: "метод",
    colTime: "время",
    colCache: "кэш",
    colStack: "стек",
    rowNaive: "наивная рекурсия",
    rowMemo: "мемоизация · этот урок",
    rowTab: "табуляция · след. урок",
    none: "нет",
    note: "мемоизация платит O(n) дважды: кэш плюс стек рекурсии",
    caption:
      "Мемоизированный fib(30) возвращает те же 832040 что наивная рекурсия, но делает 59 вызовов (~2n) вместо 2 692 537 (~2^n). Время это отдельные состояния × работа на состояние; память это кэш O(n) плюс стек рекурсии O(n) которого табуляция избегает.",
  },
};

const t = dict[lang];

const rows = [
  { y: 264, label: t.rowNaive, time: "O(2^n)", cache: t.none, stack: "O(n)", hot: false },
  { y: 300, label: t.rowMemo, time: "O(n)", cache: "O(n)", stack: "O(n)", hot: true },
  { y: 336, label: t.rowTab, time: "O(n)", cache: "O(n)→O(1)", stack: "O(1)", hot: false },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="84" width="320" height="104" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="220" y="110" text-anchor="middle" font-size="12" fill="var(--muted)">{t.naiveTitle}</text>
    <text x="220" y="150" text-anchor="middle" font-family="var(--font-display)" font-size="34" fill="var(--ink)">{t.naiveBig}</text>
    <text x="220" y="174" text-anchor="middle" font-size="13" fill="var(--muted)">{t.naiveSub}</text>

    <rect x="420" y="84" width="320" height="104" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="580" y="110" text-anchor="middle" font-size="12" fill="var(--card)">{t.memoTitle}</text>
    <text x="580" y="150" text-anchor="middle" font-family="var(--font-display)" font-size="34" fill="var(--card)">{t.memoBig}</text>
    <text x="580" y="174" text-anchor="middle" font-size="13" fill="var(--card)">{t.memoSub}</text>

    <text x="400" y="224" text-anchor="middle" font-size="14" fill="var(--ink)">{t.formula}</text>

    <text x="80" y="256" font-size="11" fill="var(--muted)">{t.colMethod}</text>
    <text x="380" y="256" text-anchor="middle" font-size="11" fill="var(--muted)">{t.colTime}</text>
    <text x="530" y="256" text-anchor="middle" font-size="11" fill="var(--muted)">{t.colCache}</text>
    <text x="670" y="256" text-anchor="middle" font-size="11" fill="var(--muted)">{t.colStack}</text>

    {rows.map((r) => (
      <g>
        <rect x="60" y={r.y} width="680" height="30" fill={r.hot ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width={r.hot ? 2 : 1.5} />
        <text x="80" y={r.y + 21} font-size="13" fill={r.hot ? "var(--card)" : "var(--ink)"}>{r.label}</text>
        <text x="380" y={r.y + 21} text-anchor="middle" font-size="13" fill={r.hot ? "var(--card)" : "var(--ink)"}>{r.time}</text>
        <text x="530" y={r.y + 21} text-anchor="middle" font-size="13" fill={r.hot ? "var(--card)" : "var(--ink)"}>{r.cache}</text>
        <text x="670" y={r.y + 21} text-anchor="middle" font-size="13" fill={r.hot ? "var(--card)" : "var(--ink)"}>{r.stack}</text>
      </g>
    ))}

    <text x="400" y="394" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
