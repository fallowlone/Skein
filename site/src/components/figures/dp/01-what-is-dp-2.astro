---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Naive Fibonacci call counts versus linear DP answers",
    headline: "EXPONENTIAL WORK, LINEAR ANSWERS",
    sub: "the answer grows smoothly — the call count explodes",
    hN: "n",
    hFib: "fib(n)",
    hCalls: "naive calls",
    hDP: "DP answers (n+1)",
    cNaive: "naive: O(2^n) time · O(n) stack",
    cDP: "DP: O(n) time · O(n) answers",
    note: "fib(30) = 832040 needs 2,692,537 calls — DP computes 31 answers once each",
    caption:
      "Naive fib(30) is only 832040 yet takes 2,692,537 calls; adding 10 to n multiplies the calls more than 100-fold. DP computes each of the n+1 distinct answers exactly once, turning O(2^n) time into O(n).",
  },
  ru: {
    svgTitle: "Число вызовов наивного Фибоначчи против линейных ответов ДП",
    headline: "ЭКСПОНЕНЦИАЛЬНАЯ РАБОТА, ЛИНЕЙНЫЕ ОТВЕТЫ",
    sub: "ответ растёт плавно — число вызовов взрывается",
    hN: "n",
    hFib: "fib(n)",
    hCalls: "вызовы наивного",
    hDP: "ответы ДП (n+1)",
    cNaive: "наивный: O(2^n) время · O(n) стек",
    cDP: "ДП: O(n) время · O(n) ответов",
    note: "fib(30) = 832040 требует 2 692 537 вызовов — ДП вычисляет 31 ответ по разу",
    caption:
      "Наивный fib(30) это всего 832040, но требует 2 692 537 вызовов; добавление 10 к n умножает вызовы более чем в 100 раз. ДП вычисляет каждый из n+1 различных ответов ровно один раз, превращая время O(2^n) в O(n).",
  },
};

const t = dict[lang];

const rows = [
  { y: 152, n: "5", fib: "5", calls: "15", dp: "6", hot: false },
  { y: 197, n: "10", fib: "55", calls: "177", dp: "11", hot: false },
  { y: 242, n: "20", fib: "6765", calls: "21891", dp: "21", hot: false },
  { y: 287, n: "30", fib: "832040", calls: "2692537", dp: "31", hot: true },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="130" y="108" text-anchor="middle" font-size="13" fill="var(--muted)">{t.hN}</text>
    <text x="270" y="108" text-anchor="middle" font-size="13" fill="var(--muted)">{t.hFib}</text>
    <text x="470" y="108" text-anchor="middle" font-size="13" fill="var(--muted)">{t.hCalls}</text>
    <text x="660" y="108" text-anchor="middle" font-size="13" fill="var(--muted)">{t.hDP}</text>
    <line x1="60" y1="120" x2="740" y2="120" stroke="var(--ink)" stroke-width="2" />

    {rows.map((r) => (
      <g>
        <text x="130" y={r.y} text-anchor="middle" font-size="15" fill="var(--ink)">{r.n}</text>
        <text x="270" y={r.y} text-anchor="middle" font-size="15" fill="var(--ink)">{r.fib}</text>
        <text x="470" y={r.y} text-anchor="middle" font-size="15" fill={r.hot ? "var(--accent)" : "var(--ink)"}>{r.calls}</text>
        <text x="660" y={r.y} text-anchor="middle" font-size="15" fill="var(--ink)">{r.dp}</text>
      </g>
    ))}

    <line x1="60" y1="306" x2="740" y2="306" stroke="var(--ink)" stroke-width="2" />

    <text x="250" y="338" text-anchor="middle" font-size="13" fill="var(--ink)">{t.cNaive}</text>
    <text x="560" y="338" text-anchor="middle" font-size="13" fill="var(--ink)">{t.cDP}</text>

    <text x="400" y="378" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
