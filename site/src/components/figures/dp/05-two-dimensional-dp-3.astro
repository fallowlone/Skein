---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Edit distance base row and column with three operations, kitten to sitting is 3",
    headline: "EDIT DISTANCE: THREE OPERATIONS",
    sub: "match: no new edit · mismatch: 1 + cheapest of three",
    match: "match: dp[i][j] = dp[i-1][j-1]",
    mismatch: "mismatch: 1 + min(delete, insert, replace)",
    ops1: "delete dp[i-1][j] · insert dp[i][j-1]",
    ops2: "replace dp[i-1][j-1]",
    example: "kitten → sitting = 3 edits",
    edits: "replace k→s · replace e→i · insert g",
    base: "base: dp[i][0] = i · dp[0][j] = j",
    note: "base dp[i][0] = i deletions · dp[0][j] = j insertions",
    caption:
      "Edit distance: a match costs dp[i-1][j-1] with no new edit, a mismatch costs 1 + min(delete dp[i-1][j], insert dp[i][j-1], replace dp[i-1][j-1]); the base row and column count dp[i][0] = i and dp[0][j] = j; kitten → sitting = 3 (replace k→s, replace e→i, insert g).",
  },
  ru: {
    svgTitle: "Базовые строка и столбец расстояния редактирования, kitten в sitting за 3",
    headline: "РАССТОЯНИЕ РЕДАКТИРОВАНИЯ: ТРИ ОПЕРАЦИИ",
    sub: "совпадение: без новой правки · иначе: 1 + дешёвая из трёх",
    match: "совпадение: dp[i][j] = dp[i-1][j-1]",
    mismatch: "иначе: 1 + min(удаление, вставка, замена)",
    ops1: "удаление dp[i-1][j] · вставка dp[i][j-1]",
    ops2: "замена dp[i-1][j-1]",
    example: "kitten → sitting = 3 правки",
    edits: "замена k→s · замена e→i · вставка g",
    base: "база: dp[i][0] = i · dp[0][j] = j",
    note: "база dp[i][0] = i удалений · dp[0][j] = j вставок",
    caption:
      "Расстояние редактирования: совпадение стоит dp[i-1][j-1] без новой правки, несовпадение стоит 1 + min(удаление dp[i-1][j], вставка dp[i][j-1], замена dp[i-1][j-1]); базовые строка и столбец считают dp[i][0] = i и dp[0][j] = j; kitten → sitting = 3 (замена k→s, замена e→i, вставка g).",
  },
};

const t = dict[lang];

const idx = ["0", "1", "2", "3"];
const cells = idx.flatMap((_, r) => idx.map((__, c) => ({ r, c })));

const x0 = 170;
const y0 = 126;
const size = 52;
const step = 62;
const cellX = (c: number) => x0 + c * step;
const cellY = (r: number) => y0 + r * step;
const isBase = (r: number, c: number) => r === 0 || c === 0;
const cellValue = (r: number, c: number) => (r === 0 ? idx[c] : c === 0 ? idx[r] : "·");
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {idx.map((lab, c) => (
      <text x={cellX(c) + size / 2} y="114" text-anchor="middle" font-size="12" fill="var(--muted)">{lab}</text>
    ))}
    {idx.map((lab, r) => (
      <text x={x0 - 12} y={cellY(r) + 34} text-anchor="end" font-size="12" fill="var(--muted)">{lab}</text>
    ))}
    {cells.map((cell) => (
      <g>
        <rect x={cellX(cell.c)} y={cellY(cell.r)} width={size} height={size} fill="var(--card)" stroke={isBase(cell.r, cell.c) ? "var(--accent)" : "var(--muted)"} stroke-width={isBase(cell.r, cell.c) ? 3 : 1} />
        <text x={cellX(cell.c) + size / 2} y={cellY(cell.r) + 35} text-anchor="middle" font-size="16" fill={isBase(cell.r, cell.c) ? "var(--ink)" : "var(--muted)"}>{cellValue(cell.r, cell.c)}</text>
      </g>
    ))}

    <text x="440" y="140" font-size="12" fill="var(--ink)">{t.match}</text>
    <text x="440" y="166" font-size="12" fill="var(--ink)">{t.mismatch}</text>
    <text x="440" y="192" font-size="12" fill="var(--muted)">{t.ops1}</text>
    <text x="440" y="218" font-size="12" fill="var(--muted)">{t.ops2}</text>
    <text x="440" y="250" font-size="13" fill="var(--ink)">{t.example}</text>
    <text x="440" y="276" font-size="12" fill="var(--muted)">{t.edits}</text>
    <text x="440" y="308" font-size="12" fill="var(--ink)">{t.base}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
