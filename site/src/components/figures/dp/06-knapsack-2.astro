---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "1D rolling knapsack array sweeping capacity downward for three items",
    headline: "1D ROLLING ARRAY: SWEEP CAPACITY DOWNWARD",
    sub: "same items (2,3), (3,4), (4,5) · W = 5 · each item sweeps w from 5 down to its weight",
    rowLabels: ["start", "item (2,3)", "item (3,4)", "item (4,5)"],
    legendUpdated: "updated",
    legendKept: "kept",
    code: "for (w = W; w >= wt; w--)  // DOWNWARD",
    answer: "answer dp[5] = 7 · items (2,3) + (3,4) · weight 5 · value 7",
    caption:
      "The 1D rolling array on items (2,3), (3,4), (4,5) with W = 5: it starts all zeros, then each item sweeps capacity downward (5 down to its weight) so every cell it reads still holds the pre-item value. Item (3,4) lifts dp[5] to 7; item (4,5) cannot beat it, and dp[5] = 7 is the answer.",
  },
  ru: {
    svgTitle: "Одномерный скользящий массив рюкзака: проход по ёмкости вниз для трёх предметов",
    headline: "ОДНОМЕРНЫЙ МАССИВ: ПРОХОД ПО ЁМКОСТИ ВНИЗ",
    sub: "те же предметы (2,3), (3,4), (4,5) · W = 5 · каждый предмет идёт по w от 5 вниз до своего веса",
    rowLabels: ["старт", "предмет (2,3)", "предмет (3,4)", "предмет (4,5)"],
    legendUpdated: "обновлено",
    legendKept: "сохранено",
    code: "for (w = W; w >= wt; w--)  // DOWNWARD",
    answer: "ответ dp[5] = 7 · предметы (2,3) + (3,4) · вес 5 · ценность 7",
    caption:
      "Одномерный скользящий массив на предметах (2,3), (3,4), (4,5) при W = 5: старт из всех нулей, затем каждый предмет проходит ёмкость вниз (от 5 до своего веса), так что каждая читаемая ячейка ещё держит значение до предмета. Предмет (3,4) поднимает dp[5] до 7; предмет (4,5) побить его не может, и dp[5] = 7 — ответ.",
  },
};

const t = dict[lang];

const rows = [
  ["0", "0", "0", "0", "0", "0"],
  ["0", "0", "3", "3", "3", "3"],
  ["0", "0", "3", "4", "4", "7"],
  ["0", "0", "3", "4", "5", "7"],
];
const updated = [
  [false, false, false, false, false, false],
  [false, false, true, true, true, true],
  [false, false, false, true, true, true],
  [false, false, false, false, true, false],
];

const x0 = 252;
const cw = 52;
const step = 60;
const ch = 42;
const rowY = [112, 166, 220, 274];
const cellX = (c: number) => x0 + c * step;
const cellCX = (c: number) => x0 + c * step + cw / 2;

interface Cell {
  x: number;
  y: number;
  v: string;
  fill: string;
  tfill: string;
  stroke: string;
  sw: number;
}

const cells: Cell[] = rows.flatMap((row, r) =>
  row.map((v, c) => {
    const isUpdated = updated[r][c];
    const isAnswer = r === 3 && c === 5;
    return {
      x: cellX(c),
      y: rowY[r],
      v,
      fill: isUpdated ? "var(--accent)" : "var(--card)",
      tfill: isUpdated ? "var(--card)" : "var(--ink)",
      stroke: isUpdated || isAnswer ? "var(--accent)" : "var(--ink)",
      sw: isAnswer ? 3 : 2,
    };
  })
);

const colHeaders = [0, 1, 2, 3, 4, 5].map((w) => ({ x: cellCX(w), label: `${w}` }));
const rowLabelPos = t.rowLabels.map((label, r) => ({ label, y: rowY[r] + 26 }));

interface Sweep {
  y: number;
  x1: number;
  x2: number;
  head: string;
  range: string;
}

const sweeps: Sweep[] = [
  { wt: 2, y: 160, range: "5→2" },
  { wt: 3, y: 214, range: "5→3" },
  { wt: 4, y: 268, range: "5→4" },
].map((s) => {
  const tip = cellX(s.wt) + 8;
  return {
    y: s.y,
    x1: 600,
    x2: tip + 9,
    head: `${tip + 9},${s.y - 6} ${tip + 9},${s.y + 6} ${tip},${s.y}`,
    range: s.range,
  };
});
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {colHeaders.map((h) => (
      <text x={h.x} y="104" text-anchor="middle" font-size="12" fill="var(--muted)">{h.label}</text>
    ))}

    {rowLabelPos.map((r) => (
      <text x="238" y={r.y} text-anchor="end" font-size="12" fill="var(--ink)">{r.label}</text>
    ))}

    {cells.map((cell) => (
      <g>
        <rect x={cell.x} y={cell.y} width={cw} height={ch} fill={cell.fill} stroke={cell.stroke} stroke-width={cell.sw} />
        <text x={cell.x + cw / 2} y={cell.y + 26} text-anchor="middle" font-size="15" fill={cell.tfill}>{cell.v}</text>
      </g>
    ))}

    {sweeps.map((s) => (
      <g>
        <line x1={s.x1} y1={s.y} x2={s.x2} y2={s.y} stroke="var(--accent)" stroke-width="2" />
        <polygon points={s.head} fill="var(--accent)" />
        <text x="612" y={s.y + 4} font-size="11" fill="var(--muted)">{s.range}</text>
      </g>
    ))}

    <rect x="620" y="110" width="14" height="14" fill="var(--accent)" stroke="var(--ink)" stroke-width="1" />
    <text x="640" y="122" font-size="11" fill="var(--ink)">{t.legendUpdated}</text>
    <rect x="620" y="132" width="14" height="14" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="640" y="144" font-size="11" fill="var(--ink)">{t.legendKept}</text>

    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--ink)">{t.code}</text>
    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.answer}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
