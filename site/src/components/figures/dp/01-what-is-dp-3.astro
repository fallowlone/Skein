---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The two DP properties and how DP differs from divide-and-conquer and greedy",
    headline: "WHEN DP APPLIES — AND WHAT IT IS NOT",
    sub: "both properties required · if either is missing, DP is the wrong tool",
    p1Title: "1 · OVERLAPPING SUBPROBLEMS",
    p1: ["naive recursion re-solves", "the same subproblem", "caching fixes this"],
    p2Title: "2 · OPTIMAL SUBSTRUCTURE",
    p2: ["best whole answer built", "from best subproblem", "answers"],
    c1Title: "DIVIDE-AND-CONQUER",
    c1: ["merge sort", "binary search", "disjoint: nothing", "to cache"],
    c2Title: "DYNAMIC PROGRAMMING",
    c2: ["subproblems overlap", "all combinations,", "keeps the best", "caching wins"],
    c3Title: "GREEDY",
    c3: ["one local choice", "never reconsiders", "fast, only safe", "sometimes"],
    rule: "if caching answers saves work → DP · all unique → divide-and-conquer",
    caption:
      "DP needs overlapping subproblems (naive recursion re-solves the same subproblem, so caching helps) and optimal substructure (the best whole is built from best parts). Divide-and-conquer splits into disjoint pieces with nothing to cache; greedy commits to one local choice without exploring combinations.",
  },
  ru: {
    svgTitle: "Два свойства ДП и чем ДП отличается от «разделяй и властвуй» и жадного",
    headline: "КОГДА ДП ПРИМЕНИМО — И ЧЕМ ОНО НЕ ЯВЛЯЕТСЯ",
    sub: "нужны оба свойства · если нет любого, ДП неверный инструмент",
    p1Title: "1 · ПЕРЕКРЫВАЮЩИЕСЯ ПОДЗАДАЧИ",
    p1: ["наивная рекурсия перерешает", "ту же подзадачу", "кэширование это чинит"],
    p2Title: "2 · ОПТИМАЛЬНАЯ ПОДСТРУКТУРА",
    p2: ["лучшее целое строится", "из лучших ответов", "подзадач"],
    c1Title: "РАЗДЕЛЯЙ И ВЛАСТВУЙ",
    c1: ["сортировка слиянием", "бинарный поиск", "непересекающиеся:", "нечего кэшировать"],
    c2Title: "ДИНАМИЧЕСКОЕ ПРОГР.",
    c2: ["подзадачи перекрываются", "все комбинации,", "хранит лучший", "кэширование решает"],
    c3Title: "ЖАДНЫЙ",
    c3: ["один локальный выбор", "не пересматривает", "быстрый, безопасен", "лишь иногда"],
    rule: "кэширование экономит работу → ДП · все уникальны → разделяй и властвуй",
    caption:
      "ДП нужны перекрывающиеся подзадачи (наивная рекурсия перерешает ту же подзадачу, так кэширование помогает) и оптимальная подструктура (лучшее целое строится из лучших частей). «Разделяй и властвуй» разбивает на непересекающиеся куски — нечего кэшировать; жадный фиксирует один локальный выбор без исследования комбинаций.",
  },
};

const t = dict[lang];

const p1Lines = t.p1.map((s, i) => ({ s, y: 128 + i * 19 }));
const p2Lines = t.p2.map((s, i) => ({ s, y: 128 + i * 19 }));
const c1Lines = t.c1.map((s, i) => ({ s, y: 256 + i * 19 }));
const c2Lines = t.c2.map((s, i) => ({ s, y: 256 + i * 19 }));
const c3Lines = t.c3.map((s, i) => ({ s, y: 256 + i * 19 }));
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="30" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="54" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="70" width="350" height="112" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="205" y="96" text-anchor="middle" font-size="13" fill="var(--ink)">{t.p1Title}</text>
    {p1Lines.map((l) => (
      <text x="205" y={l.y} text-anchor="middle" font-size="12" fill="var(--muted)">{l.s}</text>
    ))}

    <rect x="420" y="70" width="350" height="112" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="595" y="96" text-anchor="middle" font-size="13" fill="var(--ink)">{t.p2Title}</text>
    {p2Lines.map((l) => (
      <text x="595" y={l.y} text-anchor="middle" font-size="12" fill="var(--muted)">{l.s}</text>
    ))}

    <rect x="30" y="200" width="226" height="142" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="143" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.c1Title}</text>
    {c1Lines.map((l) => (
      <text x="143" y={l.y} text-anchor="middle" font-size="12" fill="var(--muted)">{l.s}</text>
    ))}

    <rect x="272" y="200" width="256" height="142" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="228" text-anchor="middle" font-size="12" fill="var(--card)">{t.c2Title}</text>
    {c2Lines.map((l) => (
      <text x="400" y={l.y} text-anchor="middle" font-size="12" fill="var(--card)">{l.s}</text>
    ))}

    <rect x="544" y="200" width="226" height="142" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="657" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.c3Title}</text>
    {c3Lines.map((l) => (
      <text x="657" y={l.y} text-anchor="middle" font-size="12" fill="var(--muted)">{l.s}</text>
    ))}

    <text x="400" y="378" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rule}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
