---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Rolling window replaces the O(n) table with two variables for O(1) space",
    headline: "ROLLING WINDOW: KEEP TWO, DROP THE TABLE",
    sub: "transition reaches back only two cells · same O(n) time",
    tableTag: "full table · O(n) space",
    windowTag: "rolling window · O(1) space",
    currLabel: "curr = prev1 + prev2",
    slideLabel: "slide forward",
    memoRow: "memoization",
    tabRow: "tabulation",
    memoTime: "time O(n)",
    memoSpace: "space O(n)",
    memoStack: "stack O(n)",
    timeCol: "time O(n)",
    spaceCol: "space O(1)",
    stackCol: "stack none",
    proof: "fib(10) = 55 · fib(30) = 832040 — same answers",
    caption:
      "Space optimization: dp[i] needs only dp[i-1] and dp[i-2], so prev2 = 0 and prev1 = 1 slide forward as curr = prev1 + prev2, dropping space from O(n) to O(1). Rolling fib(10) = 55 and fib(30) = 832040 match the table version; time stays O(n) with no stack.",
  },
  ru: {
    svgTitle: "Скользящее окно заменяет таблицу O(n) двумя переменными для O(1) памяти",
    headline: "СКОЛЬЗЯЩЕЕ ОКНО: ДЕРЖИ ДВА, ВЫБРОСЬ ТАБЛИЦУ",
    sub: "переход дотягивается лишь на две ячейки · то же O(n) время",
    tableTag: "полная таблица · O(n) память",
    windowTag: "скользящее окно · O(1) память",
    currLabel: "curr = prev1 + prev2",
    slideLabel: "сдвинь вперёд",
    memoRow: "мемоизация",
    tabRow: "табуляция",
    memoTime: "время O(n)",
    memoSpace: "память O(n)",
    memoStack: "стек O(n)",
    timeCol: "время O(n)",
    spaceCol: "память O(1)",
    stackCol: "стек нет",
    proof: "fib(10) = 55 · fib(30) = 832040 — те же ответы",
    caption:
      "Оптимизация памяти: dp[i] нужны лишь dp[i-1] и dp[i-2], так что prev2 = 0 и prev1 = 1 скользят вперёд как curr = prev1 + prev2, роняя память с O(n) до O(1). Скользящие fib(10) = 55 и fib(30) = 832040 совпадают с версией с таблицей; время остаётся O(n) без стека.",
  },
};

const t = dict[lang];

const table = ["0", "1", "1", "2", "3", "5", "8", "13"];
const windowVars = [
  { name: "prev2", value: "0" },
  { name: "prev1", value: "1" },
  { name: "curr", value: "1" },
];

const tx0 = 36;
const tcw = 42;
const tch = 40;
const tstep = 50;
const tableY = 118;
const tableX = (i: number) => tx0 + i * tstep;

const wx0 = 480;
const www = 88;
const wh = 56;
const wstep = 100;
const windowY = 110;
const windowX = (i: number) => wx0 + i * wstep;
const windowFill = (i: number) => (i === 2 ? "var(--accent)" : "var(--card)");
const windowText = (i: number) => (i === 2 ? "var(--card)" : "var(--ink)");
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="23" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="36" y="86" font-size="12" fill="var(--muted)">{t.tableTag}</text>
    {table.map((v, i) => (
      <g>
        <rect x={tableX(i)} y={tableY} width={tcw} height={tch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={tableX(i) + tcw / 2} y={tableY + 27} text-anchor="middle" font-size="14" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="480" y="86" font-size="12" fill="var(--muted)">{t.windowTag}</text>
    {windowVars.map((b, i) => (
      <g>
        <text x={windowX(i) + www / 2} y={windowY - 6} text-anchor="middle" font-size="11" fill="var(--muted)">{b.name}</text>
        <rect x={windowX(i)} y={windowY} width={www} height={wh} fill={windowFill(i)} stroke="var(--ink)" stroke-width="2" />
        <text x={windowX(i) + www / 2} y={windowY + 37} text-anchor="middle" font-size="16" fill={windowText(i)}>{b.value}</text>
      </g>
    ))}
    <text x="614" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.currLabel}</text>
    <line x1="500" y1="214" x2="716" y2="214" stroke="var(--accent)" stroke-width="2" />
    <polygon points="716,207 716,221 730,214" fill="var(--accent)" />
    <text x="614" y="236" text-anchor="middle" font-size="12" fill="var(--muted)">{t.slideLabel}</text>

    <line x1="36" y1="262" x2="764" y2="262" stroke="var(--muted)" stroke-width="1" />
    <text x="36" y="292" font-size="14" fill="var(--muted)">{t.memoRow}</text>
    <text x="220" y="292" font-size="14" fill="var(--muted)">{t.memoTime}</text>
    <text x="400" y="292" font-size="14" fill="var(--muted)">{t.memoSpace}</text>
    <text x="580" y="292" font-size="14" fill="var(--muted)">{t.memoStack}</text>
    <text x="36" y="326" font-size="14" fill="var(--ink)">{t.tabRow}</text>
    <text x="220" y="326" font-size="14" fill="var(--ink)">{t.timeCol}</text>
    <text x="400" y="326" font-size="14" fill="var(--ink)">{t.spaceCol}</text>
    <text x="580" y="326" font-size="14" fill="var(--ink)">{t.stackCol}</text>

    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--ink)">{t.proof}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
