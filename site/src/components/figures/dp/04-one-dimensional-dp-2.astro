---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Climbing stairs Fibonacci row dp 1, 1, 2, 3, 5, 8 with answer dp[5] = 8",
    headline: "CLIMBING STAIRS IS FIBONACCI",
    sub: "state: dp[i] = ways to reach step i · last move from i-1 or i-2",
    recurrence: "dp[i] = dp[i-1] + dp[i-2]",
    rowSteps: "step i",
    rowWays: "ways",
    legNear: "i-1",
    legFar: "i-2",
    eqA: "dp[2] = 1 + 1 = 2 · dp[3] = 2 + 1 = 3",
    eqB: "dp[4] = 3 + 2 = 5 · climb(5) = dp[5] = 8",
    answerTag: "← answer",
    caption:
      "Climbing 5 stairs with 1-or-2 strides fills dp[0..5] = [1, 1, 2, 3, 5, 8]: each cell sums its two left neighbours (dp[2] = 1 + 1 = 2, dp[4] = 3 + 2 = 5). The last cell dp[5] = 8 is the answer.",
  },
  ru: {
    svgTitle: "Подъём по лестнице: ряд Фибоначчи dp 1, 1, 2, 3, 5, 8 с ответом dp[5] = 8",
    headline: "ПОДЪЁМ ПО ЛЕСТНИЦЕ — ЭТО ФИБОНАЧЧИ",
    sub: "состояние: dp[i] = способы достичь ступени i · последний ход с i-1 или i-2",
    recurrence: "dp[i] = dp[i-1] + dp[i-2]",
    rowSteps: "шаг i",
    rowWays: "способы",
    legNear: "i-1",
    legFar: "i-2",
    eqA: "dp[2] = 1 + 1 = 2 · dp[3] = 2 + 1 = 3",
    eqB: "dp[4] = 3 + 2 = 5 · climb(5) = dp[5] = 8",
    answerTag: "← ответ",
    caption:
      "Подъём на 5 ступеней шагами по 1 или 2 заполняет dp[0..5] = [1, 1, 2, 3, 5, 8]: каждая ячейка суммирует двух левых соседей (dp[2] = 1 + 1 = 2, dp[4] = 3 + 2 = 5). Последняя ячейка dp[5] = 8 — это ответ.",
  },
};

const t = dict[lang];

const steps = ["0", "1", "2", "3", "4", "5"];
const ways = ["1", "1", "2", "3", "5", "8"];
const waysFill = ["var(--card)", "var(--card)", "var(--card)", "var(--card)", "var(--card)", "var(--accent)"];
const waysText = ["var(--ink)", "var(--ink)", "var(--ink)", "var(--ink)", "var(--ink)", "var(--card)"];

const x0 = 178;
const cw = 64;
const step = 76;
const cellY = 146;
const ch = 46;
const cellX = (i: number) => x0 + i * step;
const cellC = (i: number) => x0 + i * step + cw / 2;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="32" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="56" text-anchor="middle" font-size="12.5" fill="var(--muted)">{t.sub}</text>
    <text x="400" y="82" text-anchor="middle" font-size="14" fill="var(--ink)">{t.recurrence}</text>

    <text x="164" y="118" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowSteps}</text>
    {steps.map((v, i) => (
      <text x={cellC(i)} y="118" text-anchor="middle" font-size="13" fill="var(--muted)">{v}</text>
    ))}

    <text x="164" y="174" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowWays}</text>
    {ways.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={cellY} width={cw} height={ch} rx="5" fill={waysFill[i]} stroke="var(--ink)" stroke-width="2" />
        <text x={cellC(i)} y="175" text-anchor="middle" font-size="15" fill={waysText[i]}>{v}</text>
      </g>
    ))}
    <text x="668" y="174" font-size="12" fill="var(--accent)">{t.answerTag}</text>

    <path d="M438 192 C438 220, 514 220, 514 192" fill="none" stroke="var(--muted)" stroke-width="1.6" marker-end="url(#dp04f2-m)" />
    <path d="M362 192 C362 282, 514 282, 514 192" fill="none" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#dp04f2-a)" />
    <text x="476" y="236" text-anchor="middle" font-size="12" fill="var(--muted)">{t.legNear}</text>
    <text x="438" y="298" text-anchor="middle" font-size="12" fill="var(--accent)">{t.legFar}</text>

    <text x="400" y="340" text-anchor="middle" font-size="13.5" fill="var(--ink)">{t.eqA}</text>
    <text x="400" y="380" text-anchor="middle" font-size="13.5" fill="var(--muted)">{t.eqB}</text>

    <defs>
      <marker id="dp04f2-m" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--muted)" />
      </marker>
      <marker id="dp04f2-a" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--accent)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
