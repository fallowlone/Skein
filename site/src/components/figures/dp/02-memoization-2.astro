---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Memoized fib(5) trace: stores memo[2] through memo[5], hits on repeated fib(2) and fib(3)",
    headline: "fib(5) TOP-DOWN: STORE ONCE, HIT AFTER",
    sub: "cache starts empty · each of fib(2)..fib(5) computed once",
    colCall: "call",
    colCompute: "compute",
    colCache: "cache",
    rows: [
      { call: "fib(2)", expr: "1 + 0 = 1", badge: "STORE memo[2]=1", dark: "accent" },
      { call: "fib(3)", expr: "1 + 1 = 2", badge: "STORE memo[3]=2", dark: "accent" },
      { call: "fib(2)", expr: "cached → 1", badge: "HIT memo[2]=1", dark: "ink" },
      { call: "fib(4)", expr: "2 + 1 = 3", badge: "STORE memo[4]=3", dark: "accent" },
      { call: "fib(3)", expr: "cached → 2", badge: "HIT memo[3]=2", dark: "ink" },
      { call: "fib(5)", expr: "3 + 2 = 5", badge: "STORE memo[5]=5", dark: "accent" },
    ],
    note: "repeats become cache hits — that is the top-down payoff",
    caption:
      "Tracing memoized fib(5): the descent stores memo[2]=1, memo[3]=2, then hits cached fib(2) to store memo[4]=3, then hits cached fib(3) to store memo[5]=5. Each subproblem fib(2)..fib(5) is computed once; the repeats return instantly from the cache.",
  },
  ru: {
    svgTitle: "Трассировка мемоизированного fib(5): сохраняет memo[2]..memo[5], попадания на повторах fib(2) и fib(3)",
    headline: "fib(5) СВЕРХУ ВНИЗ: СОХРАНИ РАЗ, ДАЛЬШЕ ПОПАДАНИЯ",
    sub: "кэш начинается пустым · каждый из fib(2)..fib(5) вычислен раз",
    colCall: "вызов",
    colCompute: "вычисление",
    colCache: "кэш",
    rows: [
      { call: "fib(2)", expr: "1 + 0 = 1", badge: "СОХР. memo[2]=1", dark: "accent" },
      { call: "fib(3)", expr: "1 + 1 = 2", badge: "СОХР. memo[3]=2", dark: "accent" },
      { call: "fib(2)", expr: "в кэше → 1", badge: "ПОПАД. memo[2]=1", dark: "ink" },
      { call: "fib(4)", expr: "2 + 1 = 3", badge: "СОХР. memo[4]=3", dark: "accent" },
      { call: "fib(3)", expr: "в кэше → 2", badge: "ПОПАД. memo[3]=2", dark: "ink" },
      { call: "fib(5)", expr: "3 + 2 = 5", badge: "СОХР. memo[5]=5", dark: "accent" },
    ],
    note: "повторы становятся попаданиями в кэш — это выигрыш нисходящего DP",
    caption:
      "Трассировка мемоизированного fib(5): спуск сохраняет memo[2]=1, memo[3]=2, потом попадает в кэшированный fib(2) чтобы сохранить memo[4]=3, потом попадает в кэшированный fib(3) чтобы сохранить memo[5]=5. Каждая подзадача fib(2)..fib(5) вычислена раз; повторы возвращаются из кэша мгновенно.",
  },
};

const t = dict[lang];

const rowY = (i: number) => 100 + i * 46;
const rows = t.rows.map((r, i) => ({ ...r, y: rowY(i) }));
const badgeFill = (dark: string) => (dark === "ink" ? "var(--ink)" : "var(--accent)");
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="84" y="92" font-size="11" fill="var(--muted)">{t.colCall}</text>
    <text x="230" y="92" font-size="11" fill="var(--muted)">{t.colCompute}</text>
    <text x="650" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.colCache}</text>

    {rows.map((r) => (
      <g>
        <rect x="60" y={r.y} width="680" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="84" y={r.y + 26} font-size="14" fill="var(--ink)">{r.call}</text>
        <text x="230" y={r.y + 26} font-size="14" fill="var(--ink)">{r.expr}</text>
        <rect x="556" y={r.y + 7} width="168" height="26" fill={badgeFill(r.dark)} />
        <text x="640" y={r.y + 25} text-anchor="middle" font-size="11" fill="var(--card)">{r.badge}</text>
      </g>
    ))}

    <text x="400" y="398" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
