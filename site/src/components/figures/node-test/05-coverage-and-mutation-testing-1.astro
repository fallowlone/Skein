---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One module measured two ways: 100% line coverage, but a 60% mutation score — 40% of injected bugs survive because no test asserts that behavior",
    headline: "100% LINE COVERAGE, 60% MUTATION SCORE",
    sub: "the 40-point gap is behavior tests run but never check",
    rowLine: "line coverage",
    rowMutation: "mutation score",
    pctLine: "100%",
    pctMutation: "60%",
    killed: "killed — a test failed",
    survived: "survived — gap found",
    foot1: "one-character mutant >= → > survives: boundary 18 never probed",
    foot2: "coverage saw the line run; no assertion checked the result",
    caption:
      "The same module scores 100% line coverage but only 60% mutation score: 40% of injected bugs survive because no test asserts that behavior. Coverage measures execution, not verification.",
  },
  ru: {
    svgTitle: "Один модуль в двух метриках: 100% покрытия строк, но mutation score лишь 60% — 40% внедрённых багов выживают, потому что ни один тест не проверяет это поведение",
    headline: "100% ПОКРЫТИЯ СТРОК, 60% MUTATION SCORE",
    sub: "зазор в 40 пунктов — поведение, которое гоняют, но не проверяют",
    rowLine: "покрытие строк",
    rowMutation: "mutation score",
    pctLine: "100%",
    pctMutation: "60%",
    killed: "убит — тест упал",
    survived: "выжил — зазор",
    foot1: "мутант в один символ >= → > выжил: граница в 18 не проверена",
    foot2: "покрытие видело, что строка отработала; результат никто не проверил",
    caption:
      "Один модуль даёт 100% покрытия строк, но лишь 60% mutation score: 40% внедрённых багов выживают, потому что ни один тест не ассертит это поведение. Покрытие меряет выполнение, а не проверку.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="238" y="144" text-anchor="end" font-size="12" fill="var(--muted)">{t.rowLine}</text>
    <rect x="260" y="116" width="440" height="44" fill="var(--accent)" />
    <text x="725" y="144" text-anchor="start" font-size="12" fill="var(--ink)">{t.pctLine}</text>

    <text x="238" y="234" text-anchor="end" font-size="12" fill="var(--muted)">{t.rowMutation}</text>
    <rect x="260" y="206" width="440" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <rect x="260" y="206" width="264" height="44" fill="var(--accent)" />
    <line x1="524" y1="206" x2="524" y2="250" stroke="var(--ink)" stroke-width="2" />
    <text x="725" y="234" text-anchor="start" font-size="12" fill="var(--ink)">{t.pctMutation}</text>

    <text x="392" y="280" text-anchor="middle" font-size="11" fill="var(--ink)">{t.killed}</text>
    <text x="612" y="280" text-anchor="middle" font-size="11" fill="var(--ink)">{t.survived}</text>

    <text x="400" y="332" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="358" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
