---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three Stryker mutants of return age >= 18: the >= to > mutant survives because the only test checks 21, never the boundary at 18",
    headline: "ONE LINE, THREE MUTANTS",
    sub: "a surviving mutant proves no test checks that behavior",
    tagOriginal: "original",
    tagMutants: "mutants",
    tagVerdict: "verdict",
    original: "return age >= 18",
    m1: "return age > 18",
    m2: "return age <= 18",
    m3: "return true",
    v1: "survived — gap",
    v2: "killed — test failed",
    v3: "survived — gap",
    foot1: "the only test checks 21 — the boundary at 18 is never probed",
    foot2: "mutation score = killed ÷ total non-equivalent mutants",
    caption:
      "Stryker injects one small fault at a time into return age >= 18. The >= to > mutant survives because the only test checks 21, never the boundary at 18 — proof no assertion constrains that behavior. Mutation score is killed divided by total non-equivalent mutants.",
  },
  ru: {
    svgTitle: "Три мутанта Stryker для return age >= 18: мутант >= в > выживает, потому что единственный тест проверяет 21, а не границу в 18",
    headline: "ОДНА СТРОКА, ТРИ МУТАНТА",
    sub: "выживший мутант доказывает: поведение никто не проверяет",
    tagOriginal: "исходник",
    tagMutants: "мутанты",
    tagVerdict: "вердикт",
    original: "return age >= 18",
    m1: "return age > 18",
    m2: "return age <= 18",
    m3: "return true",
    v1: "выжил — зазор",
    v2: "убит — тест упал",
    v3: "выжил — зазор",
    foot1: "единственный тест проверяет 21 — граница в 18 ни разу не проверена",
    foot2: "mutation score = убитые ÷ всего неэквивалентных мутантов",
    caption:
      "Stryker по одному внедряет мелкие дефекты в return age >= 18. Мутант >= в > выживает, потому что единственный тест проверяет 21, а не границу в 18, — доказательство, что ни один ассерт не ограничивает это поведение. Mutation score — это убитые, делённые на всех неэквивалентных мутантов.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="125" y="124" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagOriginal}</text>
    <text x="380" y="76" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagMutants}</text>
    <text x="665" y="76" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagVerdict}</text>

    <rect x="30" y="150" width="190" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="125" y="185" text-anchor="middle" font-size="13" fill="var(--ink)">{t.original}</text>

    <rect x="260" y="100" width="240" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="380" y="131" text-anchor="middle" font-size="12" fill="var(--ink)">{t.m1}</text>
    <rect x="260" y="174" width="240" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="380" y="205" text-anchor="middle" font-size="12" fill="var(--ink)">{t.m2}</text>
    <rect x="260" y="248" width="240" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="380" y="279" text-anchor="middle" font-size="12" fill="var(--ink)">{t.m3}</text>

    <rect x="570" y="100" width="190" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="665" y="131" text-anchor="middle" font-size="11" fill="var(--ink)">{t.v1}</text>
    <rect x="570" y="174" width="190" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="665" y="205" text-anchor="middle" font-size="11" fill="var(--ink)">{t.v2}</text>
    <rect x="570" y="248" width="190" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="665" y="279" text-anchor="middle" font-size="11" fill="var(--ink)">{t.v3}</text>

    <line x1="222" y1="180" x2="258" y2="132" stroke="var(--muted)" stroke-width="2" />
    <line x1="222" y1="180" x2="258" y2="200" stroke="var(--muted)" stroke-width="2" />
    <line x1="222" y1="180" x2="258" y2="268" stroke="var(--muted)" stroke-width="2" />
    <line x1="502" y1="126" x2="568" y2="126" stroke="var(--muted)" stroke-width="2" />
    <line x1="502" y1="200" x2="568" y2="200" stroke="var(--muted)" stroke-width="2" />
    <line x1="502" y1="274" x2="568" y2="274" stroke="var(--muted)" stroke-width="2" />

    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="370" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
