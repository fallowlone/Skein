---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "supertest flow: the test calls request(app), supertest boots the app on an ephemeral port, the app runs router to middleware to handler over real HTTP, and the test asserts on status, headers and body",
    headline: "SUPERTEST: NO PORT TO MANAGE",
    sub: "pass the app — never app.listen()",
    box1Head: "test",
    box1Sub: "request(app)",
    box2Head: "supertest",
    box2Sub: "ephemeral port",
    box3Head: "app — no listen()",
    box3Sub1: "router → middleware",
    box3Sub2: "→ handler",
    box4Head: "real HTTP",
    box4Sub: "201 + JSON body",
    backLabel: "201 + JSON body",
    never: "never call app.listen() — no EADDRINUSE, no port 3000",
    teardown: "after the request the listener comes down",
    caption:
      "supertest boots your app on an ephemeral port and tears the listener down — you assert on the real status, headers, and body without ever picking a port.",
  },
  ru: {
    svgTitle: "Поток supertest: тест вызывает request(app), supertest поднимает приложение на эфемерном порту, приложение прогоняет роутер, middleware и хендлер по настоящему HTTP, а тест проверяет статус, заголовки и тело",
    headline: "SUPERTEST БЕЗ УПРАВЛЕНИЯ ПОРТОМ",
    sub: "передавай app — НЕ вызывай app.listen()",
    box1Head: "тест",
    box1Sub: "request(app)",
    box2Head: "supertest",
    box2Sub: "эфемерный порт",
    box3Head: "app — без listen()",
    box3Sub1: "роутер → middleware",
    box3Sub2: "→ хендлер",
    box4Head: "настоящий HTTP",
    box4Sub: "201 + JSON тело",
    backLabel: "201 + JSON тело",
    never: "НЕ вызывай app.listen() — ни порта, ни EADDRINUSE",
    teardown: "после запроса слушатель сносится",
    caption:
      "supertest поднимает приложение на эфемерном порту и сносит слушатель — ты проверяешь настоящие статус, заголовки и тело, никогда не выбирая порт.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nt5-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6 Z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="40" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="66" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="35" y="120" width="160" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="115" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1Head}</text>
    <text x="115" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Sub}</text>

    <rect x="225" y="120" width="160" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="305" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2Head}</text>
    <text x="305" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Sub}</text>

    <rect x="415" y="120" width="160" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="495" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3Head}</text>
    <text x="495" y="174" text-anchor="middle" font-size="10" fill="var(--ink)">{t.box3Sub1}</text>
    <text x="495" y="198" text-anchor="middle" font-size="10" fill="var(--ink)">{t.box3Sub2}</text>

    <rect x="605" y="120" width="160" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="685" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box4Head}</text>
    <text x="685" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box4Sub}</text>

    <line x1="195" y1="170" x2="221" y2="170" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt5-arrow)"></line>
    <line x1="385" y1="170" x2="411" y2="170" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt5-arrow)"></line>
    <line x1="575" y1="170" x2="601" y2="170" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt5-arrow)"></line>

    <path d="M 685 220 V 266 H 115 V 224" stroke="var(--muted)" stroke-width="2" fill="none" marker-end="url(#nt5-arrow)"></path>
    <text x="400" y="244" text-anchor="middle" font-size="11" fill="var(--muted)">{t.backLabel}</text>

    <text x="400" y="322" text-anchor="middle" font-size="11" fill="var(--muted)">{t.never}</text>
    <text x="400" y="348" text-anchor="middle" font-size="11" fill="var(--muted)">{t.teardown}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
