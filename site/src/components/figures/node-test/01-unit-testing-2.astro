---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Fake timers payoff: the same 5-second backoff test under a real wall clock waits the full 5000 ms and fails about one run in twenty, while mock.timers.tick(5000) runs in microseconds and is 100 percent deterministic",
    headline: "FAKE TIMERS REMOVE TIME",
    sub: "the same 5-second backoff test",
    leftTitle: "WALL CLOCK",
    leftCode: "setTimeout(backoff, 5000)",
    leftLine1: "waits the full 5000 ms",
    leftLine2: "fails about one run in twenty",
    leftLine3: "muted with skip",
    rightTitle: "FAKE CLOCK",
    rightCode: "mock.timers.tick(5000)",
    rightLine1: "runs in microseconds",
    rightLine2: "100% deterministic",
    rightLine3: "a four-line fix",
    foot1: "faking the clock does not speed up real time — it removes it",
    foot2: "no real time, therefore no race",
    caption:
      "Faking the clock does not speed up real time — it removes it. The same 5-second backoff test goes from waiting the full 5000 ms and failing about one run in twenty to running in microseconds, 100% deterministic, via mock.timers.tick(5000).",
  },
  ru: {
    svgTitle: "Выигрыш поддельных таймеров: тот же тест пятисекундного бэкоффа на настенных часах ждёт все 5000 мс и падает примерно один прогон из двадцати, а mock.timers.tick(5000) бежит за микросекунды и на 100 процентов детерминирован",
    headline: "ПОДДЕЛЬНЫЕ ТАЙМЕРЫ УБИРАЮТ ВРЕМЯ",
    sub: "тот же тест пятисекундного бэкоффа",
    leftTitle: "НАСТЕННЫЕ ЧАСЫ",
    leftCode: "setTimeout(backoff, 5000)",
    leftLine1: "ждёт все 5000 мс",
    leftLine2: "падает: один прогон из двадцати",
    leftLine3: "пометка skip",
    rightTitle: "ПОДДЕЛЬНЫЕ ЧАСЫ",
    rightCode: "mock.timers.tick(5000)",
    rightLine1: "бежит за микросекунды",
    rightLine2: "на 100% детерминирован",
    rightLine3: "фикс — четыре строки",
    foot1: "подделка часов не ускоряет реальное время — она его убирает",
    foot2: "реального времени нет — значит, нет гонки",
    caption:
      "Подделка часов не ускоряет реальное время — она его убирает. Тот же тест пятисекундного бэкоффа вместо ожидания всех 5000 мс и падения один прогон из двадцати бежит за микросекунды, на 100% детерминирован, через mock.timers.tick(5000).",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nt2-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="40" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="64" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="118" width="360" height="172" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="200" y="148" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <text x="200" y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftCode}</text>
    <text x="200" y="202" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine1}</text>
    <text x="200" y="228" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine2}</text>
    <text x="200" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine3}</text>

    <line x1="382" y1="204" x2="416" y2="204" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt2-arrow)"></line>

    <rect x="420" y="118" width="360" height="172" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="148" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    <text x="600" y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightCode}</text>
    <text x="600" y="202" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine1}</text>
    <text x="600" y="228" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine2}</text>
    <text x="600" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine3}</text>

    <text x="400" y="332" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
