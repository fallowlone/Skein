---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Test pyramid: wide base of fast unit tests, middle tier of integration tests, narrow apex of slow flaky end-to-end tests",
    headline: "THE TEST PYRAMID",
    sub: "integration is the middle tier",
    e2eLine1: "E2E — fewest · real browser + network",
    e2eLine2: "slow and flaky",
    intLine1: "integration — full request path + real DB",
    intLine2: "fewer than units · more than E2E",
    unitLine1: "units — most · one function, stubbed",
    unitLine2: "fast and focused",
    foot1: "invert it and you get the ice-cream cone",
    foot2: "contract bugs leak to production",
    caption:
      "Integration tests are the middle tier — fewer than units, more than slow E2E. Inverting this into an ice-cream cone is the classic failure that lets contract bugs leak to prod.",
  },
  ru: {
    svgTitle: "Пирамида тестов: широкое основание быстрых юнит-тестов, средний ярус интеграционных тестов, узкая вершина медленных флейковых end-to-end тестов",
    headline: "ПИРАМИДА ТЕСТОВ",
    sub: "интеграционные — средний ярус",
    e2eLine1: "E2E — меньше всего · браузер + сеть",
    e2eLine2: "медленные и флейки",
    intLine1: "интеграционные — путь запроса + реальная БД",
    intLine2: "меньше, чем юнитов · больше, чем E2E",
    unitLine1: "юниты — больше всего · одна функция",
    unitLine2: "быстрые и точные",
    foot1: "переверни — получишь «рожок мороженого»",
    foot2: "контрактные баги утекают в прод",
    caption:
      "Интеграционные тесты — средний ярус: их меньше, чем юнитов, и больше, чем медленных E2E. Перевернуть это в «рожок мороженого» — классический провал, из-за которого контрактные баги утекают в прод.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="40" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="64" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="240" y="100" width="320" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.e2eLine1}</text>
    <text x="400" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.e2eLine2}</text>

    <rect x="170" y="196" width="460" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="226" text-anchor="middle" font-size="12" fill="var(--ink)">{t.intLine1}</text>
    <text x="400" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.intLine2}</text>

    <rect x="90" y="292" width="620" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="322" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unitLine1}</text>
    <text x="400" y="346" text-anchor="middle" font-size="11" fill="var(--ink)">{t.unitLine2}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="410" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
