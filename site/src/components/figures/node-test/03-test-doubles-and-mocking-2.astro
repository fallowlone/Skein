---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Mock at the boundary, not the logic: injected seam versus module seam, what to mock and what never to mock",
    headline: "MOCK THE BOUNDARY, NOT THE LOGIC",
    sub: "module mocks for network, clock, fs — never for pure logic",
    diTitle: "injected seam · DI",
    diCode: "charge(order, { gateway, clock })",
    cutTitle: "checkout()",
    cutSub: "code under test",
    modTitle: "module seam · vi.mock",
    modCode: "node:fs/promises · readFile",
    mockTitle: "MOCK THIS",
    mockLine1: "network",
    mockLine2: "clock: setTimeout, Date",
    mockLine3: "fs: readFile · loadConfig",
    noMockTitle: "NEVER MOCK",
    noMockLine1: "pure logic",
    noMockLine2: "code under test",
    noMockLine3: "checkout()",
    foot: "fake timers: 30 s backoff (1 s, 2 s, 4 s, 8 s, 15 s cap) runs in under 5 ms",
    caption:
      "Mock at the boundary, never the logic: inject a stub or fake through DI, reach for vi.mock or mock.module only for network, clock, or fs — and collapse slow waits with fake timers.",
  },
  ru: {
    svgTitle: "Мокай границу, а не логику: внедрённый шов против шва модуля — что мокать, а что никогда",
    headline: "МОКАЙ ГРАНИЦУ, А НЕ ЛОГИКУ",
    sub: "моки модулей для сети, часов, fs — никогда для чистой логики",
    diTitle: "внедрённый шов · DI",
    diCode: "charge(order, { gateway, clock })",
    cutTitle: "checkout()",
    cutSub: "тестируемый код",
    modTitle: "шов модуля · vi.mock",
    modCode: "node:fs/promises · readFile",
    mockTitle: "МОКАЙ ЭТО",
    mockLine1: "сеть",
    mockLine2: "часы: setTimeout, Date",
    mockLine3: "fs: readFile · loadConfig",
    noMockTitle: "НЕ МОКАЙ",
    noMockLine1: "чистая логика",
    noMockLine2: "тестируемый код",
    noMockLine3: "checkout()",
    foot: "фейковые таймеры: бэкофф 30 с (1 с, 2 с, 4 с, 8 с, потолок 15 с) — меньше чем за 5 мс",
    caption:
      "Мокай границу, а не логику: внедряй stub или fake через DI, тянись к vi.mock или mock.module лишь для сети, часов или fs — а долгие ожидания дави фейковыми таймерами.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <defs>
      <marker id="nt8-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--muted)" />
      </marker>
    </defs>
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="100" width="250" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="145" y="124" text-anchor="middle" font-size="11" fill="var(--ink)">{t.diTitle}</text>
    <text x="145" y="148" text-anchor="middle" font-size="10" fill="var(--ink)">{t.diCode}</text>

    <rect x="310" y="100" width="180" height="64" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cutTitle}</text>
    <text x="400" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cutSub}</text>

    <rect x="530" y="100" width="250" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="655" y="124" text-anchor="middle" font-size="11" fill="var(--ink)">{t.modTitle}</text>
    <text x="655" y="148" text-anchor="middle" font-size="10" fill="var(--ink)">{t.modCode}</text>

    <line x1="270" y1="132" x2="306" y2="132" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt8-a)" />
    <line x1="494" y1="132" x2="526" y2="132" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt8-a)" />

    <line x1="355" y1="164" x2="207" y2="206" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt8-a)" />
    <line x1="445" y1="164" x2="593" y2="206" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt8-a)" />

    <rect x="40" y="210" width="330" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mockTitle}</text>
    <text x="205" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.mockLine1}</text>
    <text x="205" y="288" text-anchor="middle" font-size="11" fill="var(--ink)">{t.mockLine2}</text>
    <text x="205" y="312" text-anchor="middle" font-size="11" fill="var(--ink)">{t.mockLine3}</text>

    <rect x="430" y="210" width="330" height="120" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="595" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{t.noMockTitle}</text>
    <text x="595" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.noMockLine1}</text>
    <text x="595" y="288" text-anchor="middle" font-size="11" fill="var(--ink)">{t.noMockLine2}</text>
    <text x="595" y="312" text-anchor="middle" font-size="11" fill="var(--ink)">{t.noMockLine3}</text>

    <text x="400" y="372" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
