---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Over-mocking cost: asserting the mock was called stays green at 4900 dollars, asserting the outcome in cents catches the bug",
    headline: "GREEN SUITE, BROKEN PROD",
    sub: "over-mocking asserts the call, never the outcome",
    badTitle: "OVER-MOCK",
    badLine1: "stripe.charges.create",
    badLine2: '{ status: "succeeded" }',
    badLine3: "expect(create).toHaveBeenCalled()",
    badLine4: "green even at $4900",
    goodTitle: "FAKE + OUTCOME",
    goodLine1: "makeFakeGateway()",
    goodLine2: "receipt.chargedCents",
    goodLine3: "toBe(4900)",
    goodLine4: "catches dollars-vs-cents",
    foot1: "600 tests · 0.8 s · green — double-charged customers",
    foot2: "~400 mock-call asserts · zero real I/O — schema change missed in prod",
    caption:
      "Over-mocking asserts the call instead of the outcome: the mock returns success for $4900 as happily as for $49.00. Assert chargedCents against a behavior-honouring fake and the dollars-vs-cents bug turns the suite red.",
  },
  ru: {
    svgTitle: "Цена овермокинга: проверка вызова мока остаётся зелёной при 4900 долларах, а проверка итога в центах ловит баг",
    headline: "ЗЕЛЁНЫЙ СЬЮТ, СЛОМАННЫЙ ПРОД",
    sub: "овермокинг проверяет вызов, а не итог",
    badTitle: "ОВЕРМОКИНГ",
    badLine1: "stripe.charges.create",
    badLine2: '{ status: "succeeded" }',
    badLine3: "expect(create).toHaveBeenCalled()",
    badLine4: "зелёный даже при $4900",
    goodTitle: "FAKE + ИТОГ",
    goodLine1: "makeFakeGateway()",
    goodLine2: "receipt.chargedCents",
    goodLine3: "toBe(4900)",
    goodLine4: "ловит доллары-вместо-центов",
    foot1: "600 тестов · 0.8 с · зелень — двойные списания",
    foot2: "~400 проверок вызовов моков · ноль реального I/O — пропущено изменение схемы",
    caption:
      "Овермокинг проверяет вызов вместо итога: мок возвращает успех для $4900 так же радостно, как для $49.00. Проверяй chargedCents против fake, соблюдающего поведение, — и баг «доллары вместо центов» сделает сьют красным.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="100" width="340" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="200" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.badTitle}</text>
    <text x="200" y="156" text-anchor="middle" font-size="10" fill="var(--ink)">{t.badLine1}</text>
    <text x="200" y="180" text-anchor="middle" font-size="10" fill="var(--ink)">{t.badLine2}</text>
    <text x="200" y="204" text-anchor="middle" font-size="10" fill="var(--ink)">{t.badLine3}</text>
    <text x="200" y="232" text-anchor="middle" font-size="11" fill="var(--ink)">{t.badLine4}</text>

    <rect x="430" y="100" width="340" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodTitle}</text>
    <text x="600" y="156" text-anchor="middle" font-size="10" fill="var(--ink)">{t.goodLine1}</text>
    <text x="600" y="180" text-anchor="middle" font-size="10" fill="var(--ink)">{t.goodLine2}</text>
    <text x="600" y="204" text-anchor="middle" font-size="10" fill="var(--ink)">{t.goodLine3}</text>
    <text x="600" y="232" text-anchor="middle" font-size="11" fill="var(--ink)">{t.goodLine4}</text>

    <text x="400" y="322" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="350" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
