---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Quarantine-and-fix workflow: retries mask the flake, detection is mechanical, quarantine it, fix the root cause",
    headline: "RETRY HIDES THE BUG",
    sub: "quarantine the flake · fix the root cause",
    s1t: "Retry masks the flake",
    s1d: "80% → ~99.8% · 0.2⁴ ≈ 0.16% · 1 in ~625",
    s2t: "Detect mechanically",
    s2d: "--sequence.shuffle · --detectOpenHandles",
    s3t: "Quarantine and fix the cause",
    s3d: "skip off the critical path · fix the root cause",
    foot: "treat the flake as the bug report it is",
    caption:
      "Retries turn a 1-in-5 race green — all four attempts fail together only about 0.16% of the time, one run in ~625 — hiding the un-awaited write or leaked timer behind it. Randomize order, watch open handles, quarantine off the critical path, and fix the root cause.",
  },
  ru: {
    svgTitle: "Путь карантина и фикса: ретраи маскируют флак, детект механичен, помести в карантин, чини корневую причину",
    headline: "РЕТРАЙ ПРЯЧЕТ БАГ",
    sub: "карантинь флак · чини корневую причину",
    s1t: "Ретрай маскирует флак",
    s1d: "80% → ~99.8% · 0.2⁴ ≈ 0.16% · 1 из ~625",
    s2t: "Детект механически",
    s2d: "--sequence.shuffle · --detectOpenHandles",
    s3t: "Карантин и фикс причины",
    s3d: "skip вне критического пути · чини корень",
    foot: "относись к флаку как к багрепорту",
    caption:
      "Ретраи зелёнят гонку 1 к 5 — все четыре попытки падают вместе лишь примерно в 0.16% случаев, один прогон из ~625 — пряча неотожданную запись или протёкший таймер за ней. Рандомизируй порядок, следи за открытыми дескрипторами, карантинь вне критического пути и чини корневую причину.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nt12-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="170" y="92" width="460" height="74" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="121" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s1t}</text>
    <text x="400" y="144" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s1d}</text>

    <line x1="400" y1="166" x2="400" y2="180" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt12-arrow)" />

    <rect x="170" y="184" width="460" height="74" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="213" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s2t}</text>
    <text x="400" y="236" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s2d}</text>

    <line x1="400" y1="258" x2="400" y2="272" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt12-arrow)" />

    <rect x="170" y="276" width="460" height="74" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="305" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s3t}</text>
    <text x="400" y="328" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s3d}</text>

    <text x="400" y="386" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
