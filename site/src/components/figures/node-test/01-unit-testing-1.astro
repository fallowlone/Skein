---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Anatomy of one unit test: arrange builds a Cart and adds an item, act calls cart.total(), assert checks the outcome with assert.strictEqual and 20",
    headline: "ARRANGE — ACT — ASSERT",
    sub: "anatomy of one unit test",
    testName: 'test("totals line items")',
    aTitle: "1 · ARRANGE",
    aCode1: "cart = new Cart()",
    aCode2: "cart.add({ price: 10, qty: 2 })",
    aNote: "fresh state per test",
    bTitle: "2 · ACT",
    bCode: "cart.total()",
    bNote: "the one action",
    cTitle: "3 · ASSERT",
    cCode: "assert.strictEqual(cart.total(), 20)",
    cNote1: "behavior, not internals",
    cNote2: "one outcome per test",
    foot1: "one logical assertion per test",
    foot2: "a failure points straight at its cause",
    caption:
      "One unit test has three parts: arrange builds a fresh Cart and adds { price: 10, qty: 2 }, act calls cart.total(), and assert checks the observable outcome with assert.strictEqual(..., 20) — one logical assertion per test.",
  },
  ru: {
    svgTitle: "Анатомия одного юнит-теста: arrange собирает Cart и добавляет позицию, act вызывает cart.total(), assert проверяет исход через assert.strictEqual со значением 20",
    headline: "ARRANGE — ACT — ASSERT",
    sub: "анатомия одного юнит-теста",
    testName: 'test("totals line items")',
    aTitle: "1 · ARRANGE",
    aCode1: "cart = new Cart()",
    aCode2: "cart.add({ price: 10, qty: 2 })",
    aNote: "свежее состояние на каждый тест",
    bTitle: "2 · ACT",
    bCode: "cart.total()",
    bNote: "одно действие",
    cTitle: "3 · ASSERT",
    cCode: "assert.strictEqual(cart.total(), 20)",
    cNote1: "поведение, а не внутренности",
    cNote2: "один исход на тест",
    foot1: "один логический ассерт на тест",
    foot2: "сбой точно указывает на причину",
    caption:
      "Один юнит-тест состоит из трёх частей: arrange собирает свежую Cart и добавляет { price: 10, qty: 2 }, act вызывает cart.total(), а assert проверяет наблюдаемый исход через assert.strictEqual(..., 20) — один логический ассерт на тест.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nt1-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="40" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="64" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="94" text-anchor="middle" font-size="11" fill="var(--muted)">{t.testName}</text>

    <rect x="20" y="120" width="230" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="135" y="148" text-anchor="middle" font-size="12" fill="var(--ink)">{t.aTitle}</text>
    <text x="135" y="174" text-anchor="middle" font-size="11" fill="var(--ink)">{t.aCode1}</text>
    <text x="135" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.aCode2}</text>
    <text x="135" y="224" text-anchor="middle" font-size="11" fill="var(--ink)">{t.aNote}</text>

    <line x1="252" y1="185" x2="286" y2="185" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt1-arrow)"></line>

    <rect x="290" y="120" width="170" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="375" y="148" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bTitle}</text>
    <text x="375" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bCode}</text>
    <text x="375" y="208" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bNote}</text>

    <line x1="462" y1="185" x2="496" y2="185" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt1-arrow)"></line>

    <rect x="500" y="120" width="280" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="640" y="148" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cTitle}</text>
    <text x="640" y="174" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cCode}</text>
    <text x="640" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cNote1}</text>
    <text x="640" y="224" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cNote2}</text>

    <text x="400" y="300" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="324" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
