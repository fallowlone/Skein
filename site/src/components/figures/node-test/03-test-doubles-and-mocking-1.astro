---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The five test doubles grouped by verification style: stub and fake assert outcome, spy and mock assert interaction",
    headline: "DUMMY · STUB · SPY · MOCK · FAKE",
    sub: "five doubles, two verification styles",
    dummyName: "dummy",
    dummyLine1: "placeholder",
    dummyLine2: "null, {}",
    dummyTag: "never used — no asserts",
    stubName: "stub",
    stubLine1: "canned values",
    stubLine2: "steers a path",
    spyName: "spy",
    spyLine1: "stub that",
    spyLine2: "records calls",
    mockName: "mock",
    mockLine1: "carries",
    mockLine2: "expectations",
    fakeName: "fake",
    fakeLine1: "in-memory Map",
    fakeLine2: "not production",
    stateTitle: "STATE — assert outcome",
    stateMembers: "stub · fake",
    stateVerdict: "survive refactors",
    behaviorTitle: "BEHAVIOR — assert interaction",
    behaviorMembers: "spy · mock",
    behaviorVerdict: "brittle — pinned to implementation",
    foot: "stubs and fakes assert outcome — spies and mocks assert interaction",
    caption:
      "The five doubles split by verification style: stubs and fakes assert on outcome and survive refactors; spies and mocks assert on interaction and pin the test to the current implementation.",
  },
  ru: {
    svgTitle: "Пять тест-дублёров по стилю верификации: stub и fake проверяют итог, spy и mock проверяют взаимодействие",
    headline: "DUMMY · STUB · SPY · MOCK · FAKE",
    sub: "пять дублёров, два стиля верификации",
    dummyName: "dummy",
    dummyLine1: "заглушка",
    dummyLine2: "null, {}",
    dummyTag: "не используешь — без проверок",
    stubName: "stub",
    stubLine1: "заготовленные",
    stubLine2: "значения",
    spyName: "spy",
    spyLine1: "записывает",
    spyLine2: "вызовы",
    mockName: "mock",
    mockLine1: "несёт ожидания",
    mockLine2: "валит себя сам",
    fakeName: "fake",
    fakeLine1: "in-memory на Map",
    fakeLine2: "вместо Postgres",
    stateTitle: "СОСТОЯНИЕ — проверяй итог",
    stateMembers: "stub · fake",
    stateVerdict: "переживают рефакторинг",
    behaviorTitle: "ПОВЕДЕНИЕ — проверяй взаимодействие",
    behaviorMembers: "spy · mock",
    behaviorVerdict: "хрупки — прибиты к реализации",
    foot: "stub и fake проверяют итог — spy и mock проверяют взаимодействие",
    caption:
      "Пять дублёров делятся по стилю верификации: stub и fake проверяют итог и переживают рефакторинг; spy и mock проверяют взаимодействие и прибивают тест к текущей реализации.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="45" y="96" width="110" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="100" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.dummyName}</text>
    <text x="100" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.dummyLine1}</text>
    <text x="100" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.dummyLine2}</text>

    <rect x="165" y="96" width="130" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="230" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stubName}</text>
    <text x="230" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stubLine1}</text>
    <text x="230" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stubLine2}</text>

    <rect x="305" y="96" width="130" height="100" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="370" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.spyName}</text>
    <text x="370" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.spyLine1}</text>
    <text x="370" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.spyLine2}</text>

    <rect x="445" y="96" width="145" height="100" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="517" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mockName}</text>
    <text x="517" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.mockLine1}</text>
    <text x="517" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.mockLine2}</text>

    <rect x="600" y="96" width="155" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="677" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fakeName}</text>
    <text x="677" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.fakeLine1}</text>
    <text x="677" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.fakeLine2}</text>

    <text x="100" y="228" text-anchor="middle" font-size="10" fill="var(--muted)">{t.dummyTag}</text>

    <rect x="30" y="250" width="340" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="278" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stateTitle}</text>
    <text x="200" y="302" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stateMembers}</text>
    <text x="200" y="328" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stateVerdict}</text>

    <rect x="430" y="250" width="340" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="600" y="278" text-anchor="middle" font-size="12" fill="var(--ink)">{t.behaviorTitle}</text>
    <text x="600" y="302" text-anchor="middle" font-size="11" fill="var(--ink)">{t.behaviorMembers}</text>
    <text x="600" y="328" text-anchor="middle" font-size="11" fill="var(--ink)">{t.behaviorVerdict}</text>

    <text x="400" y="392" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
