---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four faces of a flake: wall-clock time, randomness, shared mutable state, and order dependence",
    headline: "FOUR FACES OF A FLAKE",
    sub: "two roots: shared state, uncontrolled inputs",
    b1t: "Time",
    b1a: "Date.now() · TZ · locale",
    b1b: "setTimeout(50) loses on loaded CI",
    b2t: "Randomness",
    b2a: "Math.random()",
    b2b: "crypto.randomUUID()",
    b3t: "Shared state",
    b3a: "module-level singleton",
    b3b: "idCounter.next() leaks",
    b4t: "Order dependence",
    b4a: "B passes only after A",
    b4b: ".only · --testNamePattern",
    foot: "pin the clock · seed randomness · TZ=UTC · await, don't sleep",
    caption:
      "Flakiness has exactly two roots: shared mutable state and uncontrolled non-determinism — time, randomness, timezone and locale, wall-time sleeps — plus the order-dependence they breed. Remove every input the test does not own.",
  },
  ru: {
    svgTitle: "Четыре лица флака: стенные часы, рандом, общее изменяемое состояние и зависимость от порядка",
    headline: "ЧЕТЫРЕ ЛИЦА ФЛАКА",
    sub: "два корня: общее состояние, неуправляемые входы",
    b1t: "Время",
    b1a: "Date.now() · TZ · локаль",
    b1b: "setTimeout(50) проигрывает в CI",
    b2t: "Рандом",
    b2a: "Math.random()",
    b2b: "crypto.randomUUID()",
    b3t: "Общее состояние",
    b3a: "синглтон уровня модуля",
    b3b: "idCounter.next() протекает",
    b4t: "Зависимость от порядка",
    b4a: "B проходит лишь после A",
    b4b: ".only · --testNamePattern",
    foot: "зафиксируй часы · посей рандом · TZ=UTC · жди, а не спи",
    caption:
      "У флака ровно два корня: общее изменяемое состояние и неуправляемый недетерминизм — время, рандом, таймзона и локаль, сон на стенных часах — плюс порождаемая ими зависимость от порядка. Убери каждый вход, которым тест не владеет.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="92" width="340" height="112" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.b1t}</text>
    <text x="210" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b1a}</text>
    <text x="210" y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b1b}</text>

    <rect x="420" y="92" width="340" height="112" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="590" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.b2t}</text>
    <text x="590" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b2a}</text>
    <text x="590" y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b2b}</text>

    <rect x="40" y="224" width="340" height="112" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="210" y="256" text-anchor="middle" font-size="12" fill="var(--ink)">{t.b3t}</text>
    <text x="210" y="284" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b3a}</text>
    <text x="210" y="308" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b3b}</text>

    <rect x="420" y="224" width="340" height="112" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="590" y="256" text-anchor="middle" font-size="12" fill="var(--ink)">{t.b4t}</text>
    <text x="590" y="284" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b4a}</text>
    <text x="590" y="308" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b4b}</text>

    <text x="400" y="376" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
