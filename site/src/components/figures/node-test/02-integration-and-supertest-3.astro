---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Test database strategies: transaction rollback is fastest on a real engine, Testcontainers runs the real Postgres per suite, in-memory SQLite is fast but the wrong engine",
    headline: "TEST THE ENGINE YOU DEPLOY",
    sub: "the engine decides if green is true",
    cardAHead: "transaction + rollback",
    cardALine1: "fastest · zero reset cost",
    cardALine2: "real engine · isolated",
    cardALine3: "fails on commit logic",
    cardBHead: "testcontainers",
    cardBLine1: "real Postgres in Docker",
    cardBLine2: "highest fidelity",
    cardBLine3: "slow startup (~secs)",
    cardCHead: "in-memory SQLite",
    cardCLine1: "very fast · wrong engine",
    cardCLine2: "no JSONB · no RETURNING",
    cardCLine3: "false confidence",
    foot1: "truncate sits between: slower, but commit logic stays testable",
    foot2: "default to a real engine; rollback when speed dominates",
    caption:
      "Prefer a real engine via Testcontainers for fidelity; rollback is fastest when suite speed dominates; in-memory SQLite is a different engine whose green build hides Postgres SQL bugs.",
  },
  ru: {
    svgTitle: "Стратегии тестовой базы: rollback транзакции самый быстрый на реальном движке, Testcontainers гоняет настоящий Postgres на набор, in-memory SQLite быстра, но это не тот движок",
    headline: "ТЕСТИРУЙ ДВИЖОК, ЧТО ДЕПЛОИШЬ",
    sub: "движок решает, честен ли зелёный",
    cardAHead: "транзакция + rollback",
    cardALine1: "самая быстрая · сброса нет",
    cardALine2: "реальный движок · изоляция",
    cardALine3: "коммиты не тестирует",
    cardBHead: "testcontainers",
    cardBLine1: "реальный Postgres в Docker",
    cardBLine2: "наивысшая достоверность",
    cardBLine3: "медленный старт (~сек)",
    cardCHead: "in-memory SQLite",
    cardCLine1: "быстрая, но не тот движок",
    cardCLine2: "нет JSONB · нет RETURNING",
    cardCLine3: "ложная уверенность",
    foot1: "truncate — между: медленнее, но коммиты тестируются",
    foot2: "по умолчанию — реальный движок; rollback — когда правит скорость",
    caption:
      "Предпочитай реальный движок через Testcontainers ради достоверности; rollback самый быстрый, когда правит скорость; in-memory SQLite — другой движок, чей зелёный набор прячет SQL-баги Postgres.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="40" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="64" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="35" y="132" width="230" height="160" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="150" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cardAHead}</text>
    <text x="150" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cardALine1}</text>
    <text x="150" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cardALine2}</text>
    <text x="150" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cardALine3}</text>

    <rect x="285" y="132" width="230" height="160" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cardBHead}</text>
    <text x="400" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cardBLine1}</text>
    <text x="400" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cardBLine2}</text>
    <text x="400" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cardBLine3}</text>

    <rect x="535" y="132" width="230" height="160" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="650" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cardCHead}</text>
    <text x="650" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cardCLine1}</text>
    <text x="650" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cardCLine2}</text>
    <text x="650" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cardCLine3}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
