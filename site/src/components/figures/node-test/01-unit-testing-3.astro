---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "What makes a test fast and hermetic: mock at the boundary with mock.fn, reset to fresh state in beforeEach with a new UserStore, and leave your own logic real by never stubbing checkout",
    headline: "FAST AND HERMETIC",
    sub: "mock the boundary, isolate the test",
    lane1Title: "1 · MOCK AT THE BOUNDARY",
    lane1Detail: "network, filesystem, clock — mock.fn()",
    lane2Title: "2 · FRESH STATE PER TEST",
    lane2Detail: "beforeEach(() => { store = new UserStore(); })",
    lane3Title: "3 · LEAVE YOUR OWN LOGIC REAL",
    lane3Detail: "stub the gateway call — never checkout()",
    mark: "✓",
    foot: "test behavior, not implementation",
    caption:
      "A fast, hermetic test mocks at the boundary (network, filesystem, clock via mock.fn), resets to fresh state in beforeEach with a new UserStore, and leaves its own logic real — stub the gateway call, never the checkout() under test.",
  },
  ru: {
    svgTitle: "Что делает тест быстрым и герметичным: мокай границу через mock.fn, сбрасывай свежее состояние в beforeEach через новый UserStore и оставляй собственную логику настоящей — не заглушай checkout",
    headline: "БЫСТРО И ГЕРМЕТИЧНО",
    sub: "мокай границу, изолируй тест",
    lane1Title: "1 · МОКАЙ ГРАНИЦУ",
    lane1Detail: "сеть, файлы, часы — mock.fn()",
    lane2Title: "2 · СВЕЖЕЕ СОСТОЯНИЕ НА КАЖДЫЙ ТЕСТ",
    lane2Detail: "beforeEach(() => { store = new UserStore(); })",
    lane3Title: "3 · СВОЮ ЛОГИКУ ОСТАВЬ НАСТОЯЩЕЙ",
    lane3Detail: "заглуши шлюз — не заглушай checkout()",
    mark: "✓",
    foot: "тестируй поведение, а не реализацию",
    caption:
      "Быстрый и герметичный тест мокает границу (сеть, файлы, часы через mock.fn), сбрасывает свежее состояние в beforeEach через новый UserStore и оставляет собственную логику настоящей — заглуши вызов шлюза, но никогда не checkout() под тестом.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="40" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="64" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="104" width="680" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="130" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lane1Title}</text>
    <text x="400" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.lane1Detail}</text>
    <text x="716" y="142" text-anchor="middle" font-size="14" fill="var(--ink)">{t.mark}</text>

    <rect x="60" y="182" width="680" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="208" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lane2Title}</text>
    <text x="400" y="230" text-anchor="middle" font-size="11" fill="var(--ink)">{t.lane2Detail}</text>
    <text x="716" y="220" text-anchor="middle" font-size="14" fill="var(--ink)">{t.mark}</text>

    <rect x="60" y="260" width="680" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="286" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lane3Title}</text>
    <text x="400" y="308" text-anchor="middle" font-size="11" fill="var(--ink)">{t.lane3Detail}</text>
    <text x="716" y="298" text-anchor="middle" font-size="14" fill="var(--ink)">{t.mark}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
