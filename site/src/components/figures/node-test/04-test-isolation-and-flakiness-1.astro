---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Isolation cost ladder: transaction rollback at 1 to 3 milliseconds, schema per worker at tens of milliseconds, ephemeral container at seconds",
    headline: "CHEAPEST RUNG THAT STILL TESTS IT",
    sub: "each rung buys fidelity for time",
    step1name: "Transaction per test · ROLLBACK",
    step1cost: "1–3 ms · cannot test a real COMMIT",
    step2name: "Schema / DB per worker · TRUNCATE",
    step2cost: "tens of ms · tests real commits",
    step3name: "Ephemeral container · testcontainers",
    step3cost: "seconds · exact engine version",
    axis: "cheaper → pricier",
    foot: "rollback by default; step up only for commit paths",
    caption:
      "Each rung up the ladder pays roughly an order of magnitude more time and buys more fidelity: rollback cannot test a real COMMIT, truncate can, containers pin the exact engine. Take the cheapest rung that still exercises what you assert.",
  },
  ru: {
    svgTitle: "Лестница цены изоляции: откат транзакции за 1–3 миллисекунды, схема на воркер за десятки миллисекунд, эфемерный контейнер за секунды",
    headline: "САМАЯ ДЕШЁВАЯ СТУПЕНЬ, ЧТО ПРОВЕРЯЕТ",
    sub: "каждая ступень покупает верность за время",
    step1name: "Транзакция на тест · ROLLBACK",
    step1cost: "1–3 мс · настоящий COMMIT не тестится",
    step2name: "Схема или база на воркер · TRUNCATE",
    step2cost: "десятки мс · настоящие коммиты тестит",
    step3name: "Эфемерный контейнер · testcontainers",
    step3cost: "секунды · точная версия движка",
    axis: "дешевле → дороже",
    foot: "откат по дефолту; выше — лишь ради пути коммита",
    caption:
      "Каждая ступень вверх платит примерно на порядок больше времени и покупает больше верности: откат не тестит настоящий COMMIT, truncate тестит, контейнеры фиксируют точный движок. Бери самую дешёвую ступень, что всё ещё проверяет утверждаемое.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nt10-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <line x1="80" y1="330" x2="80" y2="104" stroke="var(--muted)" stroke-width="2" marker-end="url(#nt10-arrow)" />
    <text x="80" y="362" text-anchor="middle" font-size="11" fill="var(--muted)">{t.axis}</text>

    <text x="148" y="133" text-anchor="end" font-size="11" fill="var(--muted)">1</text>
    <rect x="170" y="92" width="460" height="74" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="121" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step1name}</text>
    <text x="400" y="144" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step1cost}</text>

    <text x="148" y="225" text-anchor="end" font-size="11" fill="var(--muted)">2</text>
    <rect x="170" y="184" width="460" height="74" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="213" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step2name}</text>
    <text x="400" y="236" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step2cost}</text>

    <text x="148" y="317" text-anchor="end" font-size="11" fill="var(--muted)">3</text>
    <rect x="170" y="276" width="460" height="74" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="305" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step3name}</text>
    <text x="400" y="328" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step3cost}</text>

    <text x="400" y="386" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
