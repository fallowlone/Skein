---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Senior split: a cheap per-PR coverage gate catches wholly untested files, while nightly Stryker on billing, auth and pricing verifies tests assert anything",
    headline: "COVERAGE AS FLOOR, MUTATION AS BAR",
    sub: "each catches what the other is blind to",
    tagLeft: "floor: coverage",
    leftTitle: "per-PR coverage gate",
    left1: "catches files at 0%",
    left2: "new file lights up",
    left3: "cheap, always on",
    tagRight: "bar: mutation",
    rightTitle: "nightly Stryker",
    right1: "billing, auth, pricing",
    right2: "minutes-to-hours",
    right3: "changed code only",
    foot1: "no 100% mandate: the 90 → 100% climb is the least valuable work",
    foot2: "chase mutation score on critical code, not 100%",
    caption:
      "Run a cheap coverage gate on every PR to catch wholly untested files, and nightly Stryker on critical modules — billing, auth, pricing — to verify tests actually assert. Skip the 100% mandate: the climb from 90 to 100% is the least valuable work in the codebase.",
  },
  ru: {
    svgTitle: "Сеньорский раздел: дешёвый гейт покрытия на каждый PR ловит полностью непротестированные файлы, а ночной Stryker по биллингу, авторизации и ценам проверяет, что тесты хоть что-то ассертят",
    headline: "ПОКРЫТИЕ КАК ПОЛ, МУТАЦИИ КАК ПЛАНКА",
    sub: "каждое ловит то, к чему слепо другое",
    tagLeft: "пол: покрытие",
    leftTitle: "гейт покрытия на PR",
    left1: "ловит файлы с 0%",
    left2: "новый файл вспыхивает",
    left3: "дёшево, всегда включён",
    tagRight: "планка: мутации",
    rightTitle: "ночной Stryker",
    right1: "биллинг, авторизация, цены",
    right2: "минуты-часы",
    right3: "только изменённый код",
    foot1: "без мандата 100%: подъём 90 → 100% — наименее ценная работа",
    foot2: "гонись за mutation score на критичном коде, а не за 100%",
    caption:
      "Гоняй дешёвый гейт покрытия на каждый PR, чтобы ловить полностью непротестированные файлы, и ночной Stryker на критичных модулях — биллинг, авторизация, цены, — чтобы проверить, что тесты реально ассертят. Откажись от мандата 100%: подъём с 90 до 100% — наименее ценная работа в кодовой базе.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="84" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <text x="600" y="84" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>

    <rect x="30" y="110" width="340" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="200" y="144" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <text x="200" y="174" text-anchor="middle" font-size="11" fill="var(--ink)">{t.left1}</text>
    <text x="200" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.left2}</text>
    <text x="200" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.left3}</text>

    <text x="400" y="192" text-anchor="middle" font-size="20" fill="var(--muted)">+</text>

    <rect x="430" y="110" width="340" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="144" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    <text x="600" y="174" text-anchor="middle" font-size="11" fill="var(--ink)">{t.right1}</text>
    <text x="600" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.right2}</text>
    <text x="600" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.right3}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="346" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
