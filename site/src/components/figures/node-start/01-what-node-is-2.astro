---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Each line of the lesson server.js maps to the piece that serves it: readFile to libuv, createServer to the V8 callback, process.pid to process",
    headline: "SERVER.JS: EACH LINE HAS AN OWNER",
    sub: "the sample from the lesson, mapped to the part that serves it",
    code1: 'readFile("./index.html")',
    codeSub1: "loads index.html",
    arrow1: "disk read",
    pieceSub1: "async I/O + pool",
    code2: "createServer((req, res) => ...)",
    codeSub2: "answers with html",
    arrow2: "runs callback",
    pieceSub2: "your JS callback",
    code3: "process.pid",
    codeSub3: "prints the pid",
    arrow3: "this program",
    pieceSub3: "stdlib module",
    foot: "one sample, three owners: I/O is offloaded, JS runs callbacks",
    caption:
      "The lesson server.js, line by line: readFile is served by libuv, createServer by your V8 callback, process.pid by the process module.",
  },
  ru: {
    svgTitle: "Каждая строка server.js из урока ведёт к своей части: readFile — в libuv, createServer — в колбэк V8, process.pid — в process",
    headline: "SERVER.JS: У КАЖДОЙ СТРОКИ СВОЯ ЧАСТЬ",
    sub: "пример из урока и часть, что его обслуживает",
    code1: 'readFile("./index.html")',
    codeSub1: "грузит index.html",
    arrow1: "чтение диска",
    pieceSub1: "async I/O и пул",
    code2: "createServer((req, res) => ...)",
    codeSub2: "отвечает html",
    arrow2: "запуск колбэка",
    pieceSub2: "твой JS-колбэк",
    code3: "process.pid",
    codeSub3: "печатает pid",
    arrow3: "эта программа",
    pieceSub3: "модуль stdlib",
    foot: "один пример, три владельца: I/O разгружается, JS — колбэки",
    caption:
      "server.js из урока построчно: readFile обслуживает libuv, createServer — твой колбэк V8, process.pid — модуль process.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="300" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="190" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.code1}</text>
    <text x="190" y="148" text-anchor="middle" font-size="11" fill="var(--muted)">{t.codeSub1}</text>
    <line x1="345" y1="132" x2="455" y2="132" stroke="var(--muted)" stroke-width="2" />
    <polygon points="455,132 443,126 443,138" fill="var(--muted)" />
    <text x="400" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow1}</text>
    <rect x="460" y="100" width="300" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="126" text-anchor="middle" font-size="14" fill="var(--ink)">libuv</text>
    <text x="610" y="148" text-anchor="middle" font-size="11" fill="var(--muted)">{t.pieceSub1}</text>

    <rect x="40" y="190" width="300" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="190" y="216" text-anchor="middle" font-size="12" fill="var(--ink)">{t.code2}</text>
    <text x="190" y="238" text-anchor="middle" font-size="11" fill="var(--muted)">{t.codeSub2}</text>
    <line x1="345" y1="222" x2="455" y2="222" stroke="var(--muted)" stroke-width="2" />
    <polygon points="455,222 443,216 443,228" fill="var(--muted)" />
    <text x="400" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow2}</text>
    <rect x="460" y="190" width="300" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="216" text-anchor="middle" font-size="14" fill="var(--ink)">V8</text>
    <text x="610" y="238" text-anchor="middle" font-size="11" fill="var(--muted)">{t.pieceSub2}</text>

    <rect x="40" y="280" width="300" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="190" y="306" text-anchor="middle" font-size="12" fill="var(--ink)">{t.code3}</text>
    <text x="190" y="328" text-anchor="middle" font-size="11" fill="var(--muted)">{t.codeSub3}</text>
    <line x1="345" y1="312" x2="455" y2="312" stroke="var(--muted)" stroke-width="2" />
    <polygon points="455,312 443,306 443,318" fill="var(--muted)" />
    <text x="400" y="298" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow3}</text>
    <rect x="460" y="280" width="300" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="306" text-anchor="middle" font-size="14" fill="var(--ink)">process</text>
    <text x="610" y="328" text-anchor="middle" font-size="11" fill="var(--muted)">{t.pieceSub3}</text>

    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
