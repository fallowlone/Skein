---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Node.js is three bolted-together parts: V8 runs the code, libuv handles the waiting, and the standard library is the interface",
    headline: "NODE.JS: THREE PARTS, ONE PROGRAM",
    sub: "V8 runs the code — libuv handles the waiting — stdlib is the interface",
    roleV8: "runs code",
    v8Line1: "JS to machine code",
    v8Line2: "same engine as Chrome",
    v8Line3: "no files, no sockets",
    part1: "part 1 of 3",
    roleLibuv: "handles waiting",
    libuvLine1: "event loop, one thread",
    libuvLine2: "async I/O: disk, net",
    libuvLine3: "pool: 4 threads",
    part2: "part 2 of 3",
    roleStdlib: "interface",
    stdlibLine1: "fs — files",
    stdlibLine2: "http/net — sockets",
    stdlibLine3: "process/crypto/stream",
    part3: "part 3 of 3",
    foot: "three pieces bolted into one program",
    caption:
      "Node.js is not a language — it is three pieces in one program: V8 runs the code, libuv handles the waiting, and the standard library is the interface to the machine.",
  },
  ru: {
    svgTitle: "Node.js — это три свинченные вместе части: V8 исполняет код, libuv берёт на себя ожидание, а стандартная библиотека — это интерфейс",
    headline: "NODE.JS: ТРИ ЧАСТИ, ОДНА ПРОГРАММА",
    sub: "V8 исполняет код — libuv ждёт — stdlib даёт интерфейс",
    roleV8: "исполняет код",
    v8Line1: "JS в машинный код",
    v8Line2: "движок как в Chrome",
    v8Line3: "без файлов и сокетов",
    part1: "часть 1 из 3",
    roleLibuv: "берёт ожидание",
    libuvLine1: "event loop, один поток",
    libuvLine2: "async I/O: диск, сеть",
    libuvLine3: "пул: 4 потока",
    part2: "часть 2 из 3",
    roleStdlib: "интерфейс",
    stdlibLine1: "fs — файлы",
    stdlibLine2: "http/net — сеть",
    stdlibLine3: "process/crypto/stream",
    part3: "часть 3 из 3",
    foot: "три части в одной программе",
    caption:
      "Node.js — это не язык, а три части в одной программе: V8 исполняет код, libuv берёт на себя ожидание, а стандартная библиотека — это интерфейс к машине.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="100" width="225" height="210" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="142" y="132" text-anchor="middle" font-size="14" fill="var(--ink)">V8</text>
    <text x="142" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.roleV8}</text>
    <text x="142" y="190" text-anchor="middle" font-size="11" fill="var(--ink)">{t.v8Line1}</text>
    <text x="142" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.v8Line2}</text>
    <text x="142" y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{t.v8Line3}</text>
    <text x="142" y="284" text-anchor="middle" font-size="11" fill="var(--muted)">{t.part1}</text>

    <circle cx="271" cy="205" r="10" fill="var(--accent)" />

    <rect x="287" y="100" width="225" height="210" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="399" y="132" text-anchor="middle" font-size="14" fill="var(--ink)">libuv</text>
    <text x="399" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.roleLibuv}</text>
    <text x="399" y="190" text-anchor="middle" font-size="11" fill="var(--ink)">{t.libuvLine1}</text>
    <text x="399" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.libuvLine2}</text>
    <text x="399" y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{t.libuvLine3}</text>
    <text x="399" y="284" text-anchor="middle" font-size="11" fill="var(--muted)">{t.part2}</text>

    <circle cx="528" cy="205" r="10" fill="var(--accent)" />

    <rect x="544" y="100" width="226" height="210" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="657" y="132" text-anchor="middle" font-size="14" fill="var(--ink)">stdlib</text>
    <text x="657" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.roleStdlib}</text>
    <text x="657" y="190" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stdlibLine1}</text>
    <text x="657" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stdlibLine2}</text>
    <text x="657" y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stdlibLine3}</text>
    <text x="657" y="284" text-anchor="middle" font-size="11" fill="var(--muted)">{t.part3}</text>

    <text x="400" y="364" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
