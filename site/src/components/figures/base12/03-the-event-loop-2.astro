---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Tracing log(1), setTimeout(fn, 0), log(3): the synchronous lines run while the stack is busy, fn waits in the queue, and only after the stack empties does fn run — output 1, 3, 2",
    headline: "SYNC FIRST, CALLBACK LAST: 1, 3, 2",
    sub: "console.log(1) · setTimeout(fn, 0) · console.log(3)",
    step: "step",
    sBusy: "stack: busy",
    sEmpty: "stack: empty",
    qEmpty: "queue: empty",
    qFn: "queue: [fn]",
    o1: "output: 1",
    o13: "output: 1, 3",
    o132: "output: 1, 3, 2",
    vNow: "runs now",
    vWait: "waits in queue",
    vLast: "runs last",
    foot1: "the 0 queues fn fast — it never runs fn now",
    foot2: "sync prints 1, 3 first · the callback prints 2 last",
    caption:
      "Tracing log(1), setTimeout(fn, 0), log(3): the synchronous lines run while the stack is busy, fn waits in the queue, and only after the stack empties does fn run — output 1, 3, 2.",
  },
  ru: {
    svgTitle: "Трассировка log(1), setTimeout(fn, 0), log(3): синхронные строки выполняются при занятом стеке, fn ждёт в очереди, и только после опустошения стека fn запускается — вывод 1, 3, 2",
    headline: "СНАЧАЛА СИНХРОННОЕ, КОЛБЭК ПОСЛЕДНИМ: 1, 3, 2",
    sub: "console.log(1) · setTimeout(fn, 0) · console.log(3)",
    step: "шаг",
    sBusy: "стек: занят",
    sEmpty: "стек: пуст",
    qEmpty: "очередь: пуста",
    qFn: "очередь: [fn]",
    o1: "вывод: 1",
    o13: "вывод: 1, 3",
    o132: "вывод: 1, 3, 2",
    vNow: "выполняется",
    vWait: "ждёт в очереди",
    vLast: "последним",
    foot1: "0 быстро ставит fn в очередь — но не запускает",
    foot2: "синхронный код печатает 1, 3 · колбэк печатает 2 последним",
    caption:
      "Трассировка log(1), setTimeout(fn, 0), log(3): синхронные строки выполняются при занятом стеке, fn ждёт в очереди, и только после опустошения стека fn запускается — вывод 1, 3, 2.",
  },
};

const t = dict[lang];

const steps = [
  { code: "console.log(1)", stack: t.sBusy, queue: t.qEmpty, out: t.o1, verdict: t.vNow, x: 30 },
  { code: "setTimeout(fn, 0)", stack: t.sBusy, queue: t.qFn, out: t.o1, verdict: t.vWait, x: 223 },
  { code: "console.log(3)", stack: t.sBusy, queue: t.qFn, out: t.o13, verdict: t.vNow, x: 416 },
  { code: "console.log(2)", stack: t.sEmpty, queue: t.qEmpty, out: t.o132, verdict: t.vLast, x: 609 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {steps.map((s, i) => (
      <g>
        <rect x={s.x} y="100" width="160" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={s.x + 80} y="126" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step} {i + 1}</text>
        <text x={s.x + 80} y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{s.code}</text>
        <text x={s.x + 80} y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{s.stack}</text>
        <text x={s.x + 80} y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{s.queue}</text>
        <text x={s.x + 80} y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{s.out}</text>
        <text x={s.x + 80} y="264" text-anchor="middle" font-size="11" fill="var(--accent)">{s.verdict}</text>
      </g>
    ))}

    <line x1="190" y1="195" x2="223" y2="195" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#eloop2-ink)" />
    <line x1="383" y1="195" x2="416" y2="195" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#eloop2-ink)" />
    <line x1="576" y1="195" x2="609" y2="195" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#eloop2-ink)" />

    <text x="400" y="340" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="364" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>

    <defs>
      <marker id="eloop2-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--ink)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
