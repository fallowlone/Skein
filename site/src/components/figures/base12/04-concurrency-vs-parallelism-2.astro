---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Concurrency: one core runs tasks A, B, A, B taking turns. Parallelism: core 1 runs A while core 2 runs B at one and the same instant",
    headline: "TURNS ON ONE CORE, TOGETHER ON MANY",
    sub: "one core interleaves tasks · many cores run them together",
    row1Title: "CONCURRENCY — taking turns",
    row1Tag: "1 core",
    segs1: ["A", "B", "A", "B"],
    instant: "one instant",
    row1Note: "only one runs",
    row2Title: "PARALLELISM — running together",
    core1: "core 1",
    core2: "core 2",
    segsA: ["A", "A", "A", "A"],
    segsB: ["B", "B", "B", "B"],
    row2Note: "two run together",
    foot1: "concurrency is structure · parallelism is execution",
    caption:
      "Concurrency: one core runs task A, then B, then A — taking turns, only one runs at any instant. Parallelism: core 1 runs A while core 2 runs B at one and the same instant. Concurrency is structure; parallelism is execution.",
  },
  ru: {
    svgTitle: "Конкурентность: одно ядро выполняет задачи A, B, A, B по очереди. Параллелизм: ядро 1 выполняет A, пока ядро 2 выполняет B в один и тот же миг",
    headline: "ПО ОЧЕРЕДИ НА ОДНОМ, ВМЕСТЕ НА МНОГИХ",
    sub: "одно ядро чередует задачи · много ядер выполняют их вместе",
    row1Title: "КОНКУРЕНТНОСТЬ — по очереди",
    row1Tag: "1 ядро",
    segs1: ["A", "B", "A", "B"],
    instant: "один миг",
    row1Note: "выполняется только одна",
    row2Title: "ПАРАЛЛЕЛИЗМ — выполнение вместе",
    core1: "ядро 1",
    core2: "ядро 2",
    segsA: ["A", "A", "A", "A"],
    segsB: ["B", "B", "B", "B"],
    row2Note: "две выполняются вместе",
    foot1: "конкурентность — структура · параллелизм — исполнение",
    caption:
      "Конкурентность: одно ядро выполняет задачу A, затем B, затем A — по очереди, в любой миг выполняется только одна. Параллелизм: ядро 1 выполняет A, пока ядро 2 выполняет B в один и тот же миг. Конкурентность — структура; параллелизм — исполнение.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="30" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="52" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="220" y="92" font-size="13" fill="var(--ink)">{t.row1Title}</text>
    <text x="580" y="92" text-anchor="middle" font-size="11" fill="var(--accent)">{t.instant}</text>

    <text x="200" y="139" text-anchor="end" font-size="11" fill="var(--muted)">{t.row1Tag}</text>
    {t.segs1.map((label, i) => (
      <g>
        <rect x={220 + i * 120} y="112" width="120" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
        <text x={280 + i * 120} y="139" text-anchor="middle" font-size="13" fill="var(--ink)">{label}</text>
      </g>
    ))}

    <text x="460" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.row1Note}</text>

    <text x="220" y="210" font-size="13" fill="var(--ink)">{t.row2Title}</text>

    <text x="200" y="259" text-anchor="end" font-size="11" fill="var(--muted)">{t.core1}</text>
    {t.segsA.map((label, i) => (
      <g>
        <rect x={220 + i * 120} y="234" width="120" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
        <text x={280 + i * 120} y="259" text-anchor="middle" font-size="13" fill="var(--ink)">{label}</text>
      </g>
    ))}

    <text x="200" y="303" text-anchor="end" font-size="11" fill="var(--muted)">{t.core2}</text>
    {t.segsB.map((label, i) => (
      <g>
        <rect x={220 + i * 120} y="278" width="120" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
        <text x={280 + i * 120} y="303" text-anchor="middle" font-size="13" fill="var(--ink)">{label}</text>
      </g>
    ))}

    <line x1="580" y1="102" x2="580" y2="318" stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 4" />

    <text x="460" y="346" text-anchor="middle" font-size="11" fill="var(--muted)">{t.row2Note}</text>
    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
