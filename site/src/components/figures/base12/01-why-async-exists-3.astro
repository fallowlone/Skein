---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Async does not speed the disk: the device takes 10 milliseconds either way; only the CPU changes from idle to busy with other work",
    headline: "ASYNC DOES NOT SPEED THE DISK",
    sub: "the device takes 10 ms either way",
    tagSync: "sync",
    tagAsync: "async",
    device: "disk: 10 ms",
    cpuIdle: "CPU: idle, wasted",
    cpuBusy: "CPU: other work",
    foot1: "what changes is only what the CPU does meanwhile",
    foot2: "idle (wasted) or busy with other work (async)",
    caption:
      "Async does not speed the disk: the device takes its 10 milliseconds either way. What changes is only what the CPU does meanwhile — idle and wasted, or busy with other work.",
  },
  ru: {
    svgTitle: "Async не ускоряет диск: устройству нужны 10 миллисекунд в любом случае; меняется лишь CPU — с простоя на занятость другой работой",
    headline: "ASYNC НЕ УСКОРЯЕТ ДИСК",
    sub: "устройству нужны 10 мс в любом случае",
    tagSync: "синхронно",
    tagAsync: "async",
    device: "диск: 10 мс",
    cpuIdle: "CPU: простаивает, впустую",
    cpuBusy: "CPU: другая работа",
    foot1: "меняется лишь то, что CPU делает тем временем",
    foot2: "простаивает (впустую) или занят другой работой (async)",
    caption:
      "Async не ускоряет диск: устройство тратит свои 10 миллисекунд в любом случае. Меняется лишь то, что CPU делает тем временем, — простаивает впустую или занят другой работой.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="148" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagSync}</text>
    <rect x="170" y="112" width="230" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="285" y="148" text-anchor="middle" font-size="12" fill="var(--ink)">{t.device}</text>
    <rect x="420" y="112" width="250" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="545" y="148" text-anchor="middle" font-size="12" fill="var(--muted)">{t.cpuIdle}</text>

    <text x="150" y="246" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagAsync}</text>
    <rect x="170" y="210" width="230" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="285" y="246" text-anchor="middle" font-size="12" fill="var(--ink)">{t.device}</text>
    <rect x="420" y="210" width="250" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="545" y="246" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cpuBusy}</text>

    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
