---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Blocking call: the frame stays stuck on the stack the full 10 ms, the next line waits, and the CPU does 0 instructions",
    headline: "BLOCKING: NO RETURN UNTIL THE WORK IS DONE",
    sub: 'name = readFileBlocking("user.txt") — the frame waits the full 10 ms',
    timeA: "t = 0",
    timeB: "10 ms pass",
    timeC: "t = 10 ms",
    boxA1: "call pushes frame",
    boxA2: "request → disk",
    boxB1: "frame STUCK 10 ms",
    boxB2: "10,000,000 cycles frozen",
    boxB3: "next line waits",
    boxC1: "return with bytes",
    boxC2: "frame popped",
    bar: "CPU during the wait: 0 instructions",
    foot1: "a blocking call blocks the line below it from running",
    foot2: "blocking = frozen on a stuck frame",
    caption:
      "A blocking call does not return until the work is done: its frame stays stuck on the stack the full 10 ms, the next line waits, and the CPU does 0 instructions during the wait.",
  },
  ru: {
    svgTitle: "Блокирующий вызов: кадр остаётся застрявшим на стеке все 10 мс, следующая строка ждёт, а CPU выполняет 0 инструкций",
    headline: "БЛОКИРУЮЩИЙ: ВОЗВРАТА НЕТ, ПОКА РАБОТА НЕ СДЕЛАНА",
    sub: 'name = readFileBlocking("user.txt") — кадр ждёт все 10 мс',
    timeA: "t = 0",
    timeB: "проходят 10 мс",
    timeC: "t = 10 мс",
    boxA1: "вызов кладёт кадр",
    boxA2: "запрос → диску",
    boxB1: "кадр ЗАСТРЯЛ на 10 мс",
    boxB2: "10 000 000 циклов заморожены",
    boxB3: "следующая строка ждёт",
    boxC1: "возврат с байтами",
    boxC2: "кадр снят",
    bar: "CPU за время ожидания: 0 инструкций",
    foot1: "блокирующий вызов блокирует строку под собой",
    foot2: "блокирующий = заморожен на застрявшем кадре",
    caption:
      "Блокирующий вызов не возвращается, пока работа не сделана: его кадр остаётся застрявшим на стеке все 10 мс, следующая строка ждёт, а CPU выполняет 0 инструкций за время ожидания.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b12-02-1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="142" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.timeA}</text>
    <text x="410" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.timeB}</text>
    <text x="668" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.timeC}</text>

    <rect x="36" y="120" width="212" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="142" y="168" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxA1}</text>
    <text x="142" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxA2}</text>

    <line x1="248" y1="175" x2="284" y2="175" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b12-02-1)" />

    <rect x="284" y="120" width="252" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="410" y="150" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxB1}</text>
    <text x="410" y="172" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxB2}</text>
    <text x="410" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxB3}</text>

    <line x1="536" y1="175" x2="572" y2="175" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b12-02-1)" />

    <rect x="572" y="120" width="192" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="668" y="168" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxC1}</text>
    <text x="668" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxC2}</text>

    <rect x="284" y="260" width="252" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" stroke-dasharray="7 5" />
    <text x="410" y="287" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bar}</text>

    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
