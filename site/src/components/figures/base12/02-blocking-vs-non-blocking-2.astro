---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Non-blocking call: it hands the request to the disk and returns at once, the next line runs now, and the disk works in the background",
    headline: "NON-BLOCKING: RETURNS AT ONCE",
    sub: "readFileNonBlocking hands the request over and returns",
    timeA: "t = 0",
    timeB: "≈ 0 ms",
    timeC: "keeps running",
    boxA1: "call pushes frame",
    boxA2: "hands request to disk",
    boxB1: "returns at once",
    boxB2: "handful of cycles",
    boxB3: "frame popped",
    boxC1: "next line runs now",
    boxC2: "CPU keeps working",
    bar: "disk works in the background · 10 ms",
    foot1: "the result does not exist yet when the call returns",
    foot2: "non-blocking = return now, result later",
    caption:
      "A non-blocking call hands the request to the disk and returns at once after a handful of cycles: the next line runs now while the disk works in the background for 10 ms — but the result does not exist yet at return time.",
  },
  ru: {
    svgTitle: "Неблокирующий вызов: он передаёт запрос диску и возвращается сразу, следующая строка выполняется сейчас, а диск работает в фоне",
    headline: "НЕБЛОКИРУЮЩИЙ: ВОЗВРАЩАЕТСЯ СРАЗУ",
    sub: "readFileNonBlocking передаёт запрос и возвращается",
    timeA: "t = 0",
    timeB: "≈ 0 мс",
    timeC: "продолжает работать",
    boxA1: "вызов кладёт кадр",
    boxA2: "передаёт запрос диску",
    boxB1: "возвращается сразу",
    boxB2: "горстка циклов",
    boxB3: "кадр снят",
    boxC1: "строка идёт сейчас",
    boxC2: "CPU продолжает работать",
    bar: "диск работает в фоне · 10 мс",
    foot1: "результата ещё нет, когда вызов возвращается",
    foot2: "неблокирующий = возврат сейчас, результат позже",
    caption:
      "Неблокирующий вызов передаёт запрос диску и возвращается сразу после горстки циклов: следующая строка выполняется сейчас, пока диск работает в фоне 10 мс — но результата ещё нет в момент возврата.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b12-02-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="142" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.timeA}</text>
    <text x="410" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.timeB}</text>
    <text x="668" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.timeC}</text>

    <rect x="36" y="120" width="212" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="142" y="168" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxA1}</text>
    <text x="142" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxA2}</text>

    <line x1="248" y1="175" x2="284" y2="175" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b12-02-2)" />

    <rect x="284" y="120" width="252" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="410" y="150" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxB1}</text>
    <text x="410" y="172" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxB2}</text>
    <text x="410" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxB3}</text>

    <line x1="536" y1="175" x2="572" y2="175" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b12-02-2)" />

    <rect x="572" y="120" width="192" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="668" y="168" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxC1}</text>
    <text x="668" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxC2}</text>

    <rect x="36" y="260" width="728" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" stroke-dasharray="7 5" />
    <text x="400" y="287" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bar}</text>

    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
