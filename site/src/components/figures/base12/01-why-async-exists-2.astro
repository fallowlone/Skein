---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Synchronous sits idle through the 10 millisecond disk read and wastes ten million cycles; async fills the same wait with other work and wastes zero",
    headline: "SYNC WAITS · ASYNC WORKS",
    sub: "the same 10 ms disk read, a different CPU",
    tagSync: "sync",
    tagAsync: "async",
    req: "ask disk",
    idleGap: "idle: 10M cycles wasted",
    workGap: "other work: 0 wasted",
    answer: "answer",
    foot1: "sync: the CPU is powered on and does nothing",
    foot2: "the disk still takes 10 ms — only the CPU stops wasting",
    caption:
      "Synchronous sits idle through the 10-millisecond disk read and wastes ten million cycles; async fills the same wait with other work and wastes zero — the disk still takes its 10 ms either way.",
  },
  ru: {
    svgTitle: "Синхронный подход простаивает всё чтение диска за 10 миллисекунд и теряет десять миллионов циклов; async заполняет то же ожидание другой работой и теряет ноль",
    headline: "СИНХРОННЫЙ ЖДЁТ · ASYNC РАБОТАЕТ",
    sub: "то же чтение диска 10 мс, другой CPU",
    tagSync: "синхронный",
    tagAsync: "async",
    req: "запрос к диску",
    idleGap: "простой: 10M циклов впустую",
    workGap: "другая работа: 0 впустую",
    answer: "ответ",
    foot1: "синхронно: CPU включён и ничего не делает",
    foot2: "диску всё те же 10 мс — перестаёт тратить только CPU",
    caption:
      "Синхронный подход простаивает всё чтение диска за 10 миллисекунд и теряет десять миллионов циклов; async заполняет то же ожидание другой работой и теряет ноль — диск всё равно тратит свои 10 мс в любом случае.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="148" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagSync}</text>
    <rect x="170" y="112" width="130" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="235" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.req}</text>
    <rect x="300" y="112" width="270" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="435" y="148" text-anchor="middle" font-size="11" fill="var(--muted)">{t.idleGap}</text>
    <rect x="570" y="112" width="110" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="625" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.answer}</text>

    <text x="150" y="246" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagAsync}</text>
    <rect x="170" y="210" width="130" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="235" y="246" text-anchor="middle" font-size="11" fill="var(--ink)">{t.req}</text>
    <rect x="300" y="210" width="270" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="435" y="246" text-anchor="middle" font-size="11" fill="var(--ink)">{t.workGap}</text>
    <rect x="570" y="210" width="110" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="625" y="246" text-anchor="middle" font-size="11" fill="var(--ink)">{t.answer}</text>

    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
