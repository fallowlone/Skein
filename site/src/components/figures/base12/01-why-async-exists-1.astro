---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One CPU instruction takes about one nanosecond, but one disk read takes about 10 milliseconds — roughly ten million CPU cycles",
    headline: "ONE INSTRUCTION ≈ ONE NANOSECOND",
    sub: "the gap async exists to fill",
    tagCpu: "CPU",
    tagDisk: "disk",
    cpuLine1: "1 instruction ≈ 1 ns",
    cpuLine2: "1 ms = 1,000,000 cycles",
    diskLine1: "1 disk read ≈ 10 ms",
    diskLine2: "≈ 10,000,000 CPU cycles",
    foot1: "10 ms of disk is 10 million cycles of CPU",
    foot2: "at 1 cycle = 1 second, the wait is ~4 months",
    caption:
      "One CPU instruction takes about one nanosecond, but one disk read takes about 10 milliseconds — roughly ten million CPU cycles, or about four months at one cycle per second.",
  },
  ru: {
    svgTitle: "Одна инструкция CPU занимает примерно наносекунду, а одно чтение с диска — примерно 10 миллисекунд, то есть около десяти миллионов циклов CPU",
    headline: "ОДНА ИНСТРУКЦИЯ ≈ НАНОСЕКУНДА",
    sub: "промежуток, ради которого существует async",
    tagCpu: "CPU",
    tagDisk: "диск",
    cpuLine1: "1 инструкция ≈ 1 нс",
    cpuLine2: "1 мс = 1 000 000 циклов",
    diskLine1: "1 чтение диска ≈ 10 мс",
    diskLine2: "≈ 10 000 000 циклов CPU",
    foot1: "10 мс диска — это 10 миллионов циклов CPU",
    foot2: "в масштабе 1 цикл = 1 с ожидание ≈ 4 месяца",
    caption:
      "Одна инструкция CPU занимает примерно наносекунду, а одно чтение с диска — примерно 10 миллисекунд, то есть около десяти миллионов циклов CPU, или примерно четыре месяца в масштабе один цикл в секунду.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagCpu}</text>
    <rect x="170" y="104" width="240" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="290" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cpuLine1}</text>
    <text x="290" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cpuLine2}</text>

    <text x="150" y="226" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagDisk}</text>
    <rect x="170" y="194" width="460" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.diskLine1}</text>
    <text x="400" y="246" text-anchor="middle" font-size="11" fill="var(--ink)">{t.diskLine2}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
