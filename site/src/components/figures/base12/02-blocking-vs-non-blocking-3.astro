---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Callback: line 1 hands over the request and greet, the call returns at once, and about 10 ms later greet is called with the name",
    headline: "CALLBACK: CODE HANDED OVER NOW, RUN LATER",
    sub: "split in two: the call starts it, the callback finishes it",
    boxA1: "line 1: hand over request + greet",
    boxA2: 'readFileNonBlocking("user.txt", greet)',
    boxB1: "returns at once",
    boxB2: "result does not exist yet",
    gapNote: "≈ 10 ms later",
    boxC1: "disk done → greet(name) is called",
    boxC2: "print runs inside the callback",
    foot1: "the “use the file” line lives inside the callback, not below the call",
    caption:
      "The program hands the request and greet to the non-blocking call, which returns at once; about 10 ms later the disk finishes and greet is called with the name — the code that uses the result lives inside the callback.",
  },
  ru: {
    svgTitle: "Колбэк: строка 1 передаёт запрос и greet, вызов возвращается сразу, а примерно через 10 мс greet вызывается с именем",
    headline: "КОЛБЭК: КОД ПЕРЕДАН СЕЙЧАС, ЗАПУСК ПОЗЖЕ",
    sub: "разделено надвое: вызов запускает, колбэк завершает",
    boxA1: "строка 1: передать запрос + greet",
    boxA2: 'readFileNonBlocking("user.txt", greet)',
    boxB1: "возвращается сразу",
    boxB2: "результата ещё нет",
    gapNote: "≈ через 10 мс",
    boxC1: "диск готов → вызван greet(name)",
    boxC2: "print — внутри колбэка",
    foot1: "строка «использовать файл» живёт внутри колбэка, а не под вызовом",
    caption:
      "Программа передаёт запрос и greet неблокирующему вызову, который возвращается сразу; примерно через 10 мс диск заканчивает и greet вызывается с именем — код, использующий результат, живёт внутри колбэка.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b12-02-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="170" y="90" width="460" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="400" y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxA1}</text>
    <text x="400" y="142" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxA2}</text>

    <line x1="400" y1="160" x2="400" y2="186" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b12-02-3)" />

    <rect x="170" y="186" width="460" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="214" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxB1}</text>
    <text x="400" y="238" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxB2}</text>

    <line x1="400" y1="256" x2="400" y2="282" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b12-02-3)" />
    <text x="652" y="273" text-anchor="start" font-size="11" fill="var(--muted)">{t.gapNote}</text>

    <rect x="170" y="282" width="460" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="400" y="310" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxC1}</text>
    <text x="400" y="334" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxC2}</text>

    <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
