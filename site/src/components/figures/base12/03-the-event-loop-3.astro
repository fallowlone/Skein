---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The queue is first-in-first-out: A added first runs first. One rule gates everything: a waiting callback runs only when the stack is empty, then runs to completion",
    headline: "FIRST IN, FIRST OUT — ONLY ON AN EMPTY STACK",
    sub: "the queue orders · the rule gates",
    panelA: "a queue: first in, first out",
    addedFirst: "front · added 1st",
    addedLast: "back · added 3rd",
    runBox: "runs 1st",
    devBox: "device finished",
    resA1: "A in first → A out first",
    resA2: "holds ready callbacks",
    panelB: "one rule gates every callback",
    stBusy: "stack: busy",
    wait: "loop waits",
    nothing: "does nothing",
    stEmpty: "stack: empty",
    take: "take front",
    runFull: "run it fully",
    resB1: "sync finishes first",
    resB2: "callbacks never interrupt",
    foot1: "queued is not running — only an empty stack runs",
    foot2: "each callback runs to completion, never interrupted",
    caption:
      "The queue is first-in-first-out: A added first runs first. And one rule gates everything: a waiting callback runs only when the stack is empty, then runs to completion.",
  },
  ru: {
    svgTitle: "Очередь — первый вошёл, первый вышел: A, добавленный первым, запускается первым. Одно правило для всего: ждущий колбэк запускается, только когда стек пуст, затем выполняется до конца",
    headline: "ПЕРВЫЙ ВОШЁЛ — ПЕРВЫЙ ВЫШЕЛ, И ТОЛЬКО НА ПУСТОМ СТЕКЕ",
    sub: "очередь упорядочивает · правило разрешает",
    panelA: "очередь: первый вошёл — первый вышел",
    addedFirst: "начало · 1-й в очередь",
    addedLast: "конец · 3-й в очередь",
    runBox: "запуск 1-й",
    devBox: "устройство готово",
    resA1: "A первый вошёл → A первый вышел",
    resA2: "держит готовые колбэки",
    panelB: "одно правило для всех колбэков",
    stBusy: "стек: занят",
    wait: "цикл ждёт",
    nothing: "ничего не делает",
    stEmpty: "стек: пуст",
    take: "берёт 1-й",
    runFull: "выполняет до конца",
    resB1: "синхронный — первым",
    resB2: "колбэки не прерывают друг друга",
    foot1: "в очереди ≠ запущен — запускает лишь пустой стек",
    foot2: "каждый колбэк — до конца, без прерываний",
    caption:
      "Очередь — первый вошёл, первый вышел: A, добавленный первым, запускается первым. И одно правило для всего: ждущий колбэк запускается, только когда стек пуст, затем выполняется до конца.",
  },
};

const t = dict[lang];

const cells = [
  { name: "A", x: 70 },
  { name: "B", x: 150 },
  { name: "C", x: 230 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="80" width="360" height="260" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="210" y="106" text-anchor="middle" font-size="12" fill="var(--ink)">{t.panelA}</text>

    <text x="105" y="134" text-anchor="middle" font-size="11" fill="var(--muted)">{t.addedFirst}</text>
    <text x="265" y="134" text-anchor="middle" font-size="11" fill="var(--muted)">{t.addedLast}</text>

    {cells.map((c) => (
      <g>
        <rect x={c.x} y="160" width="70" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={c.x + 35} y="196" text-anchor="middle" font-size="14" fill="var(--ink)">{c.name}</text>
      </g>
    ))}

    <line x1="105" y1="220" x2="105" y2="244" stroke="var(--accent)" stroke-width="2" marker-end="url(#eloop3-acc)" />
    <rect x="45" y="244" width="120" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="1.5" />
    <text x="105" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.runBox}</text>

    <line x1="265" y1="244" x2="265" y2="220" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#eloop3-ink)" />
    <rect x="205" y="244" width="120" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="1" />
    <text x="265" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.devBox}</text>

    <text x="210" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resA1}</text>
    <text x="210" y="326" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resA2}</text>

    <rect x="410" y="80" width="360" height="260" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="106" text-anchor="middle" font-size="12" fill="var(--ink)">{t.panelB}</text>

    <rect x="430" y="140" width="90" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="1" />
    <text x="475" y="175" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stBusy}</text>

    <line x1="520" y1="170" x2="600" y2="170" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#eloop3-ink)" />
    <text x="560" y="161" text-anchor="middle" font-size="11" fill="var(--muted)">{t.wait}</text>

    <rect x="600" y="140" width="150" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="1" />
    <text x="675" y="175" text-anchor="middle" font-size="11" fill="var(--ink)">{t.nothing}</text>

    <rect x="430" y="220" width="90" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="1" />
    <text x="475" y="255" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stEmpty}</text>

    <line x1="520" y1="250" x2="600" y2="250" stroke="var(--accent)" stroke-width="2" marker-end="url(#eloop3-acc)" />
    <text x="560" y="241" text-anchor="middle" font-size="11" fill="var(--accent)">{t.take}</text>

    <rect x="600" y="220" width="150" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="675" y="255" text-anchor="middle" font-size="11" fill="var(--ink)">{t.runFull}</text>

    <text x="590" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resB1}</text>
    <text x="590" y="326" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resB2}</text>

    <text x="400" y="366" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="390" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>

    <defs>
      <marker id="eloop3-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
      </marker>
      <marker id="eloop3-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--ink)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
