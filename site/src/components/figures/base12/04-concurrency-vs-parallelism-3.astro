---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four situations: one core with a loop is concurrent, eight threads on eight cores are parallel, one core asked for parallel is impossible, one task on eight cores leaves seven idle",
    headline: "FOUR SITUATIONS, TWO NAMES",
    sub: "classify: turns or together?",
    cards: [
      { setup: "1 core + event loop", detail: "100 callbacks take turns", verdict: "✓ concurrent" },
      { setup: "8 cores + 8 threads", detail: "run at the same instant", verdict: "✓ parallel" },
      { setup: "1 core asked for parallel", detail: "one instruction at a time", verdict: "✗ never parallel" },
      { setup: "1 task on 8 cores", detail: "7 cores sit idle", verdict: "✗ neither" },
    ],
    foot1: "concurrency is structure · parallelism is execution",
    caption:
      "Four situations: one core with an event loop is concurrent; eight threads on eight cores are parallel; one core asked for parallel is impossible; one task on eight cores leaves seven idle. Concurrency is structure; parallelism is execution.",
  },
  ru: {
    svgTitle: "Четыре ситуации: одно ядро с циклом — конкурентно, восемь потоков на восьми ядрах — параллельно, одно ядро просят параллельно — невозможно, одна задача на восьми ядрах — семь простаивают",
    headline: "ЧЕТЫРЕ СИТУАЦИИ, ДВА НАЗВАНИЯ",
    sub: "классифицируй: по очереди или вместе?",
    cards: [
      { setup: "1 ядро + цикл событий", detail: "100 колбэков по очереди", verdict: "✓ конкурентно" },
      { setup: "8 ядер + 8 потоков", detail: "выполняются в один миг", verdict: "✓ параллельно" },
      { setup: "1 ядро просят параллельно", detail: "одна инструкция за раз", verdict: "✗ никогда не параллельно" },
      { setup: "1 задача на 8 ядрах", detail: "7 ядер простаивают", verdict: "✗ ни то, ни другое" },
    ],
    foot1: "конкурентность — структура · параллелизм — исполнение",
    caption:
      "Четыре ситуации: одно ядро с циклом событий — конкурентно; восемь потоков на восьми ядрах — параллельно; одно ядро просят параллельно — невозможно; одна задача на восьми ядрах — семь простаивают. Конкурентность — структура; параллелизм — исполнение.",
  },
};

const t = dict[lang];

const cardX = [60, 410, 60, 410];
const cardY = [110, 110, 235, 235];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.cards.map((card, i) => (
      <g>
        <rect
          x={cardX[i]}
          y={cardY[i]}
          width="330"
          height="110"
          fill="var(--card)"
          stroke={i < 2 ? "var(--accent)" : "var(--muted)"}
          stroke-width="2"
          {...(i < 2 ? {} : { "stroke-dasharray": "7 5" })}
        />
        <text x={cardX[i] + 165} y={cardY[i] + 30} text-anchor="middle" font-size="12" fill="var(--ink)">{card.setup}</text>
        <text x={cardX[i] + 165} y={cardY[i] + 54} text-anchor="middle" font-size="11" fill="var(--muted)">{card.detail}</text>
        <text x={cardX[i] + 165} y={cardY[i] + 84} text-anchor="middle" font-size="12" fill={i < 2 ? "var(--accent)" : "var(--muted)"}>{card.verdict}</text>
      </g>
    ))}

    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
