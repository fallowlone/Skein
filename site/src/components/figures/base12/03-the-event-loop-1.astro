---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The event loop as a closed cycle: it checks the call stack, and only when the stack is empty it takes the front callback off the queue and pushes it onto the stack to run",
    headline: "NOTHING RUNS UNTIL THE STACK IS EMPTY",
    sub: "a queue that waits · a loop that checks",
    stack: "Call stack",
    stackSub: "empty?",
    loop: "Event loop",
    loopSub: "checks the stack",
    queue: "Task queue",
    queueSub: "waiting callbacks",
    push: "Push next task",
    pushSub: "onto the stack",
    edgeTop: "stack empty",
    edgeRight: "take front",
    edgeBottom: "front callback",
    edgeLeft: "repeat",
    center1: "a callback runs",
    center2: "only on an empty stack",
    foot1: "sync code finishes first · each callback runs to completion",
    foot2: "callbacks never interrupt each other",
    caption:
      "The event loop as a closed cycle: it checks the call stack, and only when the stack is empty it takes the front callback off the queue and pushes it onto the stack to run.",
  },
  ru: {
    svgTitle: "Цикл событий как замкнутый круг: он проверяет стек вызовов, и только когда стек пуст, берёт передний колбэк из очереди и кладёт его на стек для запуска",
    headline: "НИЧТО НЕ ЗАПУСКАЕТСЯ, ПОКА СТЕК НЕ ПУСТ",
    sub: "очередь ждёт · цикл проверяет",
    stack: "Стек вызовов",
    stackSub: "пуст?",
    loop: "Цикл событий",
    loopSub: "проверяет стек",
    queue: "Очередь задач",
    queueSub: "ждущие колбэки",
    push: "Кладём задачу",
    pushSub: "на стек",
    edgeTop: "стек пуст",
    edgeRight: "берём передний",
    edgeBottom: "передний колбэк",
    edgeLeft: "повтор",
    center1: "колбэк запускается",
    center2: "только на пустом стеке",
    foot1: "синхронный код — первым · каждый колбэк — до конца",
    foot2: "колбэки никогда не прерывают друг друга",
    caption:
      "Цикл событий как замкнутый круг: он проверяет стек вызовов, и только когда стек пуст, берёт передний колбэк из очереди и кладёт его на стек для запуска.",
  },
};

const t = dict[lang];

const nodes = [
  { title: t.stack, sub: t.stackSub, x: 60, y: 110, cx: 160 },
  { title: t.loop, sub: t.loopSub, x: 540, y: 110, cx: 640 },
  { title: t.queue, sub: t.queueSub, x: 540, y: 230, cx: 640 },
  { title: t.push, sub: t.pushSub, x: 60, y: 230, cx: 160 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {nodes.map((n) => (
      <g>
        <rect x={n.x} y={n.y} width="200" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={n.cx} y={n.y + 25} text-anchor="middle" font-size="12" fill="var(--ink)">{n.title}</text>
        <text x={n.cx} y={n.y + 45} text-anchor="middle" font-size="11" fill="var(--muted)">{n.sub}</text>
      </g>
    ))}

    <line x1="260" y1="140" x2="540" y2="140" stroke="var(--accent)" stroke-width="2" marker-end="url(#eloop1-acc)" />
    <text x="400" y="130" text-anchor="middle" font-size="11" fill="var(--accent)">{t.edgeTop}</text>

    <line x1="640" y1="170" x2="640" y2="230" stroke="var(--accent)" stroke-width="2" marker-end="url(#eloop1-acc)" />
    <text x="628" y="204" text-anchor="end" font-size="11" fill="var(--accent)">{t.edgeRight}</text>

    <line x1="540" y1="260" x2="260" y2="260" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#eloop1-ink)" />
    <text x="400" y="251" text-anchor="middle" font-size="11" fill="var(--muted)">{t.edgeBottom}</text>

    <line x1="160" y1="230" x2="160" y2="170" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#eloop1-ink)" />
    <text x="148" y="204" text-anchor="end" font-size="11" fill="var(--muted)">{t.edgeLeft}</text>

    <rect x="290" y="185" width="220" height="50" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.center1}</text>
    <text x="400" y="224" text-anchor="middle" font-size="11" fill="var(--ink)">{t.center2}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>

    <defs>
      <marker id="eloop1-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
      </marker>
      <marker id="eloop1-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--ink)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
