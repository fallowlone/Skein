---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Two layers: a thread is one stream of instructions, a core is one fetch-decode-execute engine, and a core runs one thread at an instant",
    headline: "THREADS ARE STREAMS, CORES ARE ENGINES",
    sub: "a stream of work · the hardware that runs it",
    tagThread: "software",
    tagCore: "hardware",
    threadTitle: "THREAD — one stream",
    threadL1: "one program counter",
    threadL2: "one call stack",
    threadL3: "a software choice",
    coreTitle: "CORE — one engine",
    coreL1: "one instruction at a time",
    coreL2: "fetch–decode–execute",
    coreL3: "a hardware fact",
    arrowL1: "a core runs",
    arrowL2: "one thread at a time",
    foot1: "threads are a software choice · cores are a hardware fact",
    foot2: "cores are the ceiling on true simultaneity",
    caption:
      "Two layers: a thread is one stream of instructions — one program counter, one stack — a software choice; a core is one fetch–decode–execute engine — one instruction at a time — a hardware fact. A core runs one thread at an instant.",
  },
  ru: {
    svgTitle: "Два слоя: поток — это один стрим инструкций, ядро — один движок выборки–декодирования–исполнения, и ядро выполняет один поток за раз",
    headline: "ПОТОКИ — СТРИМЫ, ЯДРА — ДВИЖКИ",
    sub: "стрим работы · оборудование, его выполняющее",
    tagThread: "программное",
    tagCore: "аппаратное",
    threadTitle: "ПОТОК — один стрим",
    threadL1: "один счётчик команд",
    threadL2: "один стек вызовов",
    threadL3: "выбор программный",
    coreTitle: "ЯДРО — один движок",
    coreL1: "одна инструкция за раз",
    coreL2: "выборка–декодирование–исполнение",
    coreL3: "факт аппаратный",
    arrowL1: "ядро выполняет",
    arrowL2: "один поток за раз",
    foot1: "потоки — выбор программный · ядра — факт аппаратный",
    foot2: "ядра — потолок настоящей одновременности",
    caption:
      "Два слоя: поток — это один стрим инструкций — один счётчик команд, один стек — выбор программный; ядро — это один движок выборки–декодирования–исполнения — одна инструкция за раз — факт аппаратный. Ядро выполняет один поток за раз.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b12-04-1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="190" y="102" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagThread}</text>
    <text x="610" y="102" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagCore}</text>

    <rect x="60" y="124" width="260" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="190" y="158" text-anchor="middle" font-size="13" fill="var(--ink)">{t.threadTitle}</text>
    <text x="190" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.threadL1}</text>
    <text x="190" y="208" text-anchor="middle" font-size="11" fill="var(--ink)">{t.threadL2}</text>
    <text x="190" y="230" text-anchor="middle" font-size="11" fill="var(--ink)">{t.threadL3}</text>

    <rect x="480" y="124" width="260" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="158" text-anchor="middle" font-size="13" fill="var(--ink)">{t.coreTitle}</text>
    <text x="610" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.coreL1}</text>
    <text x="610" y="208" text-anchor="middle" font-size="11" fill="var(--ink)">{t.coreL2}</text>
    <text x="610" y="230" text-anchor="middle" font-size="11" fill="var(--ink)">{t.coreL3}</text>

    <text x="400" y="172" text-anchor="middle" font-size="10" fill="var(--accent)">{t.arrowL1}</text>
    <text x="400" y="187" text-anchor="middle" font-size="10" fill="var(--accent)">{t.arrowL2}</text>
    <line x1="480" y1="199" x2="320" y2="199" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b12-04-1)" />

    <text x="400" y="322" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="346" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
