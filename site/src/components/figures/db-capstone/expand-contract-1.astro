---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Expand-contract in six lock-cheap steps: nullable add, batched backfill, not-valid check, online validate, instant set not null, cleanup",
    headline: "SIX LOCK-CHEAP STEPS, ZERO FROZEN MINUTES",
    sub: "expand-contract for ADD COLUMN tenant_id NOT NULL",
    steps: ["1 · ADD nullable", "2 · BACKFILL batches", "3 · CHECK NOT VALID", "4 · VALIDATE", "5 · SET NOT NULL", "6 · DROP check"],
    notes: ["no default · no rewrite", "LIMIT 10000 · row locks", "adds check · no scan", "ShareUpdateExclusiveLock", "metadata-only · instant", "cleanup"],
    flowA: "no queue builds",
    flowB: "reads go on",
    naive: "naive ALTER: AccessExclusiveLock · up to 10 min",
    caption:
      "Adding tenant_id BIGINT NOT NULL in one ALTER takes AccessExclusiveLock and freezes prod for eight minutes. Expand-contract splits it into six steps — nullable add, batched backfill, NOT VALID check, online validate, instant SET NOT NULL, cleanup — none of which queues the table.",
  },
  ru: {
    svgTitle: "Expand-contract за шесть lock-cheap шагов: nullable-добавление, батчевый backfill, not-valid проверка, онлайн-валидация, мгновенный set not null, очистка",
    headline: "ШЕСТЬ LOCK-CHEAP ШАГОВ · НОЛЬ ЗАМОРОЗКИ",
    sub: "expand-contract для ADD COLUMN tenant_id NOT NULL",
    steps: ["1 · ADD nullable", "2 · BACKFILL батчами", "3 · CHECK NOT VALID", "4 · VALIDATE", "5 · SET NOT NULL", "6 · DROP check"],
    notes: ["без default · без перезаписи", "LIMIT 10000 · строчные блокировки", "добавляет check · без скана", "ShareUpdateExclusiveLock", "только metadata · мгновенно", "очистка"],
    flowA: "очередь не растёт",
    flowB: "чтения идут",
    naive: "наивный ALTER: AccessExclusiveLock · до 10 мин",
    caption:
      "Добавление tenant_id BIGINT NOT NULL одним ALTER берёт AccessExclusiveLock и замораживает prod на восемь минут. Expand-contract разбивает это на шесть шагов — nullable-добавление, батчевый backfill, NOT VALID проверка, онлайн-валидация, мгновенный SET NOT NULL, очистка — ни один из которых не ставит таблицу в очередь.",
  },
};

const t = dict[lang];

const boxX = [35, 275, 515];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbcap-expand-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.steps.map((p, i) => (
      <g>
        <rect x={boxX[i % 3]} y={i < 3 ? 100 : 225} width="240" height="100" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={boxX[i % 3] + 120} y={i < 3 ? 130 : 255} text-anchor="middle" font-size="12" fill="var(--ink)">{p}</text>
        <text x={boxX[i % 3] + 120} y={i < 3 ? 156 : 281} text-anchor="middle" font-size="11" fill="var(--muted)">{t.notes[i]}</text>
        <text x={boxX[i % 3] + 120} y={i < 3 ? 182 : 307} text-anchor="middle" font-size="11" fill="var(--accent)">{i < 3 ? t.flowA : t.flowB}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.naive}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
