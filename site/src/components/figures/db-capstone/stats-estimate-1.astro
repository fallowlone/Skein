---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A 1000x wrong row estimate picks a nested loop over a hash join: expecting 10 rows, the loop scans 10M index entries instead of one 10K build side",
    headline: "A 1000x WRONG GUESS, A 1000x SLOWER PLAN",
    sub: "the planner trusts histograms, not the table",
    expTitle: "PLANNER EXPECTS · 10 ROWS",
    expChip: "expects 10 rows",
    planBox: "nested loop",
    planSub: "scans 10M entries",
    realTitle: "REALITY · 10000 ROWS",
    realChip: "real 10000 rows",
    goodBox: "hash join",
    goodSub: "one 10K build side",
    verdict: "1000x slower than planned",
    strip: "one ANALYZE rebuilds the histograms",
    caption:
      "Expecting 10 rows, the planner picks a nested loop; with 10000 real rows the loop scans 10M index entries where one hash join over a 10K build side would do — a 1000x slower plan. ANALYZE rebuilds the histograms the estimate came from.",
  },
  ru: {
    svgTitle: "Ошибка оценки строк в 1000 раз выбирает nested loop вместо hash join: ожидая 10 строк, цикл сканирует 10M записей вместо одной 10K build side",
    headline: "ОШИБКА В 1000x — ПЛАН В 1000x МЕДЛЕННЕЕ",
    sub: "планировщик верит гистограммам, а не таблице",
    expTitle: "ПЛАНИРОВЩИК ЖДЁТ · 10 СТРОК",
    expChip: "ждёт 10 строк",
    planBox: "nested loop",
    planSub: "сканирует 10M записей",
    realTitle: "РЕАЛЬНОСТЬ · 10000 СТРОК",
    realChip: "реально 10000 строк",
    goodBox: "hash join",
    goodSub: "одна 10K build side",
    verdict: "в 1000x медленнее плана",
    strip: "один ANALYZE перестраивает гистограммы",
    caption:
      "Ожидая 10 строк, планировщик выбирает nested loop; при 10000 реальных строк цикл сканирует 10M записей там, где хватило бы одного hash join по 10K build side — план в 1000 раз медленнее. ANALYZE перестраивает гистограммы, из которых взялась оценка.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbcap-stats-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="340" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.expTitle}</text>
    <rect x="60" y="142" width="300" height="36" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="210" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.expChip}</text>
    <line x1="210" y1="178" x2="210" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbcap-stats-arrow)" />
    <rect x="60" y="200" width="300" height="62" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="226" text-anchor="middle" font-size="15" fill="var(--accent)">{t.planBox}</text>
    <text x="210" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.planSub}</text>
    <text x="210" y="296" text-anchor="middle" font-size="13" fill="var(--accent)">{t.verdict}</text>

    <rect x="420" y="100" width="340" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.realTitle}</text>
    <rect x="440" y="142" width="300" height="36" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.realChip}</text>
    <line x1="590" y1="178" x2="590" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbcap-stats-arrow)" />
    <rect x="440" y="200" width="300" height="62" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="226" text-anchor="middle" font-size="15" fill="var(--ink)">{t.goodBox}</text>
    <text x="590" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.goodSub}</text>
    <text x="590" y="296" text-anchor="middle" font-size="13" fill="var(--muted)">{t.goodBox} · {t.realChip}</text>

    <rect x="120" y="334" width="560" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="361" text-anchor="middle" font-size="12" fill="var(--ink)">{t.strip}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
