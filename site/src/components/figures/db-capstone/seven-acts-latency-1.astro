---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Email search latency climbs from 30 ms to 800 ms on a sequential scan and drops to 4 ms with an index; a 30x wrong estimate keeps half the requests at 600 ms until ANALYZE",
    headline: "SLOW QUERIES: MILLISECONDS THAT MATTER",
    sub: "Act 2: missing index · Act 3: stale statistics",
    act2Title: "ACT 2 · EMAIL SEARCH",
    states: ["30 ms", "800 ms", "4 ms"],
    results: ["baseline", "seq-scan", "index"],
    noteCode: "CREATE INDEX users_email_idx",
    notePages: "WHERE email = ? · two page reads",
    act3Title: "ACT 3 · PLANNER MISSES",
    estChip: "est · off 30x",
    actChip: "fact · 100K rows",
    loopLine: "seq-scan picked",
    loopSub: "half the queries take 600 ms",
    verdict: "estimate off by 30x",
    fixLine: "ANALYZE users",
    foot: "first lever: index, then statistics",
    caption:
      "Email search climbs from 30 ms to 800 ms on a sequential scan; one index drops p95 to 4 ms with two page reads. When half the requests still take 600 ms, the estimate is off by 30x — ANALYZE rebuilds the histograms.",
  },
  ru: {
    svgTitle: "Задержка поиска по email растёт с 30 мс до 800 мс на sequential scan и падает до 4 мс с индексом; оценка с ошибкой в 30 раз держит половину запросов на 600 мс до ANALYZE",
    headline: "МЕДЛЕННЫЕ ЗАПРОСЫ: МИЛЛИСЕКУНДЫ РЕШАЮТ",
    sub: "Акт 2: нет индекса · Акт 3: устаревшая статистика",
    act2Title: "АКТ 2 · ПОИСК ПО EMAIL",
    states: ["30 мс", "800 мс", "4 мс"],
    results: ["старт", "seq-scan", "индекс"],
    noteCode: "CREATE INDEX users_email_idx",
    notePages: "WHERE email = ? · два page reads",
    act3Title: "АКТ 3 · ПРОМАХ ПЛАНИРОВЩИКА",
    estChip: "оценка · мимо 30x",
    actChip: "факт · 100K строк",
    loopLine: "всё равно seq-scan",
    loopSub: "половина запросов · 600 мс",
    verdict: "оценка врёт в 30 раз",
    fixLine: "ANALYZE users",
    foot: "сначала индекс, потом статистика",
    caption:
      "Поиск по email растёт с 30 мс до 800 мс на sequential scan; один индекс роняет p95 до 4 мс за два page reads. Когда половина запросов всё ещё занимает 600 мс, оценка врёт в 30 раз — ANALYZE перестраивает гистограммы.",
  },
};

const t = dict[lang];

const rowY = [150, 192, 234];
const rowH = 28;
const barW = [24, 130, 12];
const resX = [199, 305, 187];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbcap-latency-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="100" width="355" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="207" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.act2Title}</text>
    {t.states.map((v, i) => (
      <g>
        <text x="150" y={rowY[i] + 20} text-anchor="end" font-size="13" fill="var(--ink)">{v}</text>
        <rect x="165" y={rowY[i]} width={barW[i]} height={rowH} fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x={resX[i]} y={rowY[i] + 20} font-size="12" fill="var(--muted)">{t.results[i]}</text>
      </g>
    ))}
    <text x="60" y="302" font-size="11" fill="var(--muted)">{t.noteCode}</text>
    <text x="60" y="320" font-size="12" fill="var(--ink)">{t.notePages}</text>

    <rect x="415" y="100" width="355" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="592" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.act3Title}</text>
    <rect x="435" y="150" width="150" height="36" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="510" y="173" text-anchor="middle" font-size="12" fill="var(--ink)">{t.estChip}</text>
    <rect x="585" y="150" width="150" height="36" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="660" y="173" text-anchor="middle" font-size="12" fill="var(--ink)">{t.actChip}</text>
    <line x1="510" y1="186" x2="510" y2="206" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbcap-latency-arrow)" />
    <line x1="660" y1="186" x2="660" y2="206" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbcap-latency-arrow)" />
    <rect x="455" y="206" width="280" height="54" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="229" text-anchor="middle" font-size="15" fill="var(--accent)">{t.loopLine}</text>
    <text x="595" y="250" text-anchor="middle" font-size="11" fill="var(--muted)">{t.loopSub}</text>
    <text x="592" y="292" text-anchor="middle" font-size="13" fill="var(--accent)">{t.verdict}</text>
    <text x="592" y="314" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fixLine}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
