---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "An index on user_id plus created_at serves filters on user_id but never on created_at alone, which falls back to a sequential scan",
    headline: "INDEX (a, b) SERVES a, NEVER b ALONE",
    sub: "the leading-column rule — the most-violated principle",
    goodTitle: "HELPS · FILTER ON user_id",
    goodQuery: "WHERE user_id = ?",
    goodResult: "INDEX SCAN",
    goodNote: "filter matches column a",
    badTitle: "USELESS · FILTER ON created_at ONLY",
    badQuery: "WHERE created_at = ?",
    badResult: "SEQ-SCAN",
    badNote: "column b alone never matches",
    strip: "fix: second index on (created_at)",
    caption:
      "An index on (user_id, created_at) serves filters on user_id but never on created_at alone — those queries fall back to a sequential scan. The fix is a second index on (created_at); where only 5% of rows are active, a partial index costs a fraction.",
  },
  ru: {
    svgTitle: "Индекс на user_id плюс created_at обслуживает фильтры по user_id, но никогда по одному created_at — такие запросы падают в sequential scan",
    headline: "ИНДЕКС (a, b) СЛУЖИТ a, НО НЕ b ОДНОМУ",
    sub: "правило leading-column — самый нарушаемый принцип",
    goodTitle: "ПОМОГАЕТ · ФИЛЬТР ПО user_id",
    goodQuery: "WHERE user_id = ?",
    goodResult: "INDEX SCAN",
    goodNote: "фильтр совпал с колонкой a",
    badTitle: "БЕСПОЛЕЗЕН · ФИЛЬТР ТОЛЬКО ПО created_at",
    badQuery: "WHERE created_at = ?",
    badResult: "SEQ-SCAN",
    badNote: "один b никогда не совпадает",
    strip: "фикс: второй индекс на (created_at)",
    caption:
      "Индекс на (user_id, created_at) обслуживает фильтры по user_id, но никогда по одному created_at — такие запросы падают в sequential scan. Фикс — второй индекс на (created_at); где активны лишь 5% строк, partial index стоит долю цены.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbcap-leading-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="340" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodTitle}</text>
    <rect x="60" y="146" width="300" height="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="210" y="171" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodQuery}</text>
    <line x1="210" y1="186" x2="210" y2="210" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbcap-leading-arrow)" />
    <rect x="60" y="210" width="300" height="64" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="238" text-anchor="middle" font-size="15" fill="var(--accent)">{t.goodResult}</text>
    <text x="210" y="260" text-anchor="middle" font-size="11" fill="var(--muted)">{t.goodNote}</text>
    <text x="210" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">(user_id, created_at)</text>

    <rect x="420" y="100" width="340" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.badTitle}</text>
    <rect x="440" y="146" width="300" height="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="171" text-anchor="middle" font-size="12" fill="var(--ink)">{t.badQuery}</text>
    <line x1="590" y1="186" x2="590" y2="210" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbcap-leading-arrow)" />
    <rect x="440" y="210" width="300" height="64" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="238" text-anchor="middle" font-size="15" fill="var(--ink)">{t.badResult}</text>
    <text x="590" y="260" text-anchor="middle" font-size="11" fill="var(--muted)">{t.badNote}</text>
    <text x="590" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">(user_id, created_at)</text>

    <rect x="120" y="344" width="560" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="371" text-anchor="middle" font-size="12" fill="var(--ink)">{t.strip}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
