---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four distribution methods and their prices: hash spreads evenly, range stays local, list is manual, directory is a lookup; joining tables must stay co-located",
    headline: "FOUR WAYS TO SPREAD ROWS, FOUR PRICES",
    sub: "Decision 2 of sharding · Decision 3 is co-location",
    methods: ["Hash", "Range", "List", "Directory"],
    prices: ["even spread · range fans out", "range stays local · hot range risk", "manual map · high ops cost", "lookup table · highest ops cost"],
    coloc: "co-located: users + events on tenant_id · tenant 42 stays local",
    caption:
      "Hash spreads evenly but fans range queries out; range keeps ranges local but risks a hot range; list and directory trade manual control for operational cost. Whichever wins, tables that join — users, orgs, events, audit_log on tenant_id — must stay co-located or every join pays the federation tax.",
  },
  ru: {
    svgTitle: "Четыре метода распределения и их цены: hash раскладывает равномерно, range локален, list ручной, directory через lookup; join-ящиеся таблицы должны оставаться co-located",
    headline: "ЧЕТЫРЕ СПОСОБА РАЗЛОЖИТЬ СТРОКИ, ЧЕТЫРЕ ЦЕНЫ",
    sub: "Решение 2 шардинга · Решение 3 — co-location",
    methods: ["Hash", "Range", "List", "Directory"],
    prices: ["равномерно · range веером", "range локален · риск горячего диапазона", "вручную · высокая цена операций", "lookup-таблица · максимальная цена"],
    coloc: "co-location: users + events на tenant_id · tenant 42 локален",
    caption:
      "Hash раскладывает равномерно, но разбрасывает range-запросы веером; range держит диапазоны локально, но рискует горячим диапазоном; list и directory меняют ручное управление на операционную цену. Как бы ни вышло, таблицы, что join-ятся — users, orgs, events, audit_log на tenant_id — должны оставаться co-located, иначе каждый join платит federation tax.",
  },
};

const t = dict[lang];

const rowY = [110, 168, 226, 284];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbcap-dist-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.methods.map((d, i) => (
      <g>
        <rect x="40" y={rowY[i]} width="150" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="115" y={rowY[i] + 28} text-anchor="middle" font-size="13" fill="var(--ink)">{d}</text>
        <rect x="200" y={rowY[i]} width="560" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="220" y={rowY[i] + 28} font-size="12" fill="var(--muted)">{t.prices[i]}</text>
      </g>
    ))}

    <rect x="40" y="348" width="720" height="42" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="374" text-anchor="middle" font-size="11" fill="var(--ink)">{t.coloc}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
