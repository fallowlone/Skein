---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Tenant Acme sends 40 percent of queries to its shard while five shards idle; split Acme out or give it a cluster via online resharding",
    headline: "ONE TENANT, 40% OF QUERIES, ONE HOT SHARD",
    sub: "shard key tenant_id · six shards · co-located tables",
    loadTitle: "LOAD · 6 SHARDS",
    names: ["Acme", "shard 2", "shard 3", "shard 4", "shard 5", "shard 6"],
    acmeLab: "Acme · 40%",
    idleLab: "idle",
    fixTitle: "FIX · ONLINE RESHARD",
    optA: "A · logical split",
    optANote: "Acme to dedicated shards",
    optB: "B · own cluster",
    optBNote: "Acme moves out",
    toolLine: "citus_rebalance_table_shards",
    pauseLine: "pause under 1 second per shard",
    foot: "the key choice, not sharding, designed the hotspot",
    caption:
      "Tenant Acme sends 40% of all queries to its shard while the other five idle — the hotspot was designed in when tenant_id became the shard key. Split Acme across dedicated logical shards or move it to its own cluster, both via citus_rebalance_table_shards with sub-second write pauses.",
  },
  ru: {
    svgTitle: "Tenant Acme посылает 40 процентов запросов на свой шард, пять шардов простаивают; выдели Acme или отдай ему кластер через онлайн-решардинг",
    headline: "ОДИН TENANT, 40% ЗАПРОСОВ, ОДИН ГОРЯЧИЙ ШАРД",
    sub: "shard key tenant_id · шесть шардов · co-located таблицы",
    loadTitle: "НАГРУЗКА · 6 ШАРДОВ",
    names: ["Acme", "шард 2", "шард 3", "шард 4", "шард 5", "шард 6"],
    acmeLab: "Acme · 40%",
    idleLab: "простой",
    fixTitle: "ФИКС · ОНЛАЙН-РЕШАРДИНГ",
    optA: "A · логическое разбиение",
    optANote: "Acme на выделенные шарды",
    optB: "B · свой кластер",
    optBNote: "Acme переезжает",
    toolLine: "citus_rebalance_table_shards",
    pauseLine: "пауза менее 1 секунды на шард",
    foot: "пятно спроектировал выбор ключа, а не шардинг",
    caption:
      "Tenant Acme посылает 40% всех запросов на свой шард, пока остальные пять простаивают — пятно было спроектировано в день, когда tenant_id стал shard key. Разложи Acme по выделенным логическим шардам или перевези на свой кластер — оба пути через citus_rebalance_table_shards с суб-секундными паузами записи.",
  },
};

const t = dict[lang];

const barW = [215, 60, 60, 60, 60, 60];
const barY = [148, 176, 204, 232, 260, 288];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbcap-hot-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="340" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.loadTitle}</text>
    {t.names.map((h, i) => (
      <g>
        <text x="140" y={barY[i] + 16} text-anchor="end" font-size="11" fill="var(--muted)">{h}</text>
        <rect x="150" y={barY[i]} width={barW[i]} height="20" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="158" y={barY[i] + 15} font-size="11" fill="var(--ink)">{i === 0 ? t.acmeLab : t.idleLab}</text>
      </g>
    ))}

    <rect x="420" y="100" width="340" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixTitle}</text>
    <rect x="440" y="146" width="300" height="56" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.optA}</text>
    <text x="590" y="190" text-anchor="middle" font-size="11" fill="var(--muted)">{t.optANote}</text>
    <rect x="440" y="212" width="300" height="56" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="234" text-anchor="middle" font-size="12" fill="var(--ink)">{t.optB}</text>
    <text x="590" y="256" text-anchor="middle" font-size="11" fill="var(--muted)">{t.optBNote}</text>
    <text x="590" y="296" text-anchor="middle" font-size="11" fill="var(--ink)">{t.toolLine}</text>
    <text x="590" y="316" text-anchor="middle" font-size="11" fill="var(--muted)">{t.pauseLine}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
