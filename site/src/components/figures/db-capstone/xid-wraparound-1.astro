---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Transaction IDs run toward 2 to the 31: at 10K TPS the 864M IDs per day hit wraparound in 2.5 days, so freezing at 200M and alerting at 80 percent are mandatory",
    headline: "2^31 IDS — THEN THE COUNTER WRAPS",
    sub: "wraparound corrupts visibility — freezing prevents it",
    countTitle: "COUNTDOWN TO WRAP",
    zeroLab: "0",
    freezeLab: "freeze · 200M",
    wrapLab: "wrap · 2^31",
    rateLine: "10K TPS · 864M per day",
    daysLine: "~2.5 days without freezing",
    warnLine: "emergency vacuum hogs I/O",
    monTitle: "MONITOR · age(datfrozenxid)",
    queryLine: "SELECT age(datfrozenxid)",
    alertLine: "alert at 80%",
    alertSub: "of autovacuum_freeze_max_age",
    defLine: "default freeze age · 200M",
    foot: "correctness cliff, not a slowdown",
    caption:
      "At 10K TPS the cluster burns 864M transaction IDs per day and would hit the 2^31 wraparound in about 2.5 days; preventive freezing at autovacuum_freeze_max_age (default 200M) stops that. Watch age(datfrozenxid) and alert at 80% — past the cliff, old rows look like they come from the future.",
  },
  ru: {
    svgTitle: "ID транзакций бегут к 2 в 31: при 10K TPS 864M ID в день дают wraparound за 2.5 дня, поэтому заморозка на 200M и алерт на 80 процентах обязательны",
    headline: "2^31 ID — ДАЛЕЕ СЧЁТЧИК ОБОРАЧИВАЕТСЯ",
    sub: "wraparound портит видимость — спасает заморозка",
    countTitle: "ОБРАТНЫЙ ОТСЧЁТ",
    zeroLab: "0",
    freezeLab: "заморозка · 200M",
    wrapLab: "оборот · 2^31",
    rateLine: "10K TPS · 864M в день",
    daysLine: "~2,5 дня без заморозки",
    warnLine: "аварийный vacuum душит I/O",
    monTitle: "МОНИТОРИНГ · age(datfrozenxid)",
    queryLine: "SELECT age(datfrozenxid)",
    alertLine: "алерт на 80%",
    alertSub: "от autovacuum_freeze_max_age",
    defLine: "дефолт freeze age · 200M",
    foot: "порог корректности, а не замедление",
    caption:
      "При 10K TPS кластер сжигает 864M ID транзакций в день и упёрся бы в wraparound 2^31 примерно за 2,5 дня; превентивная заморозка при autovacuum_freeze_max_age (дефолт 200M) это останавливает. Следи за age(datfrozenxid) и алерть на 80% — за порогом старые строки выглядят как пришедшие из будущего.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbcap-xid-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="340" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.countTitle}</text>
    <rect x="60" y="150" width="300" height="28" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <rect x="60" y="150" width="30" height="28" fill="var(--accent)" stroke="var(--accent)" stroke-width="1" />
    <text x="60" y="196" font-size="11" fill="var(--muted)">{t.zeroLab}</text>
    <text x="120" y="196" font-size="11" fill="var(--accent)">{t.freezeLab}</text>
    <text x="360" y="196" text-anchor="end" font-size="11" fill="var(--ink)">{t.wrapLab}</text>
    <text x="210" y="232" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rateLine}</text>
    <text x="210" y="262" text-anchor="middle" font-size="13" fill="var(--accent)">{t.daysLine}</text>
    <text x="210" y="300" text-anchor="middle" font-size="11" fill="var(--muted)">{t.warnLine}</text>

    <rect x="420" y="100" width="340" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.monTitle}</text>
    <rect x="440" y="146" width="300" height="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="171" text-anchor="middle" font-size="11" fill="var(--ink)">{t.queryLine}</text>
    <line x1="590" y1="186" x2="590" y2="208" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbcap-xid-arrow)" />
    <rect x="440" y="208" width="300" height="60" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="232" text-anchor="middle" font-size="15" fill="var(--accent)">{t.alertLine}</text>
    <text x="590" y="254" text-anchor="middle" font-size="11" fill="var(--muted)">{t.alertSub}</text>
    <text x="590" y="300" text-anchor="middle" font-size="11" fill="var(--muted)">{t.defLine}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
