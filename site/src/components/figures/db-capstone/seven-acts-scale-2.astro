---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Scale breaks one layer at a time: bloat from 200 MB to 80 GB, latency from 4 ms to 4 s, an 8 minute freeze, and one tenant with 40 percent of queries",
    headline: "SCALE BREAKS ONE LAYER AT A TIME",
    sub: "Act 4 bloat · Act 5 storm · Act 6 freeze · Act 7 hot shard",
    titles: ["ACT 4 · BLOAT", "ACT 5 · STORM", "ACT 6 · FREEZE", "ACT 7 · HOT SHARD"],
    causes: ["200 MB table", "1000 backends", "one ALTER waits", "tenant Acme"],
    froms: ["swells to", "4 ms becomes", "queue grows to", "sends"],
    tos: ["80 GB", "4 s", "8 min", "40%"],
    levers: ["kill tx + pg_repack", "PgBouncer pool", "expand-contract", "co-location"],
    stages: ["Month 6", "Year 1", "Year 2", "Year 3"],
    foot: "the symptom names the lever",
    caption:
      "Month 6: a table swells from 200 MB to 80 GB. Year 1: 1000 backends turn 4 ms queries into 4 s. Year 2: one waiting ALTER freezes prod for 8 minutes. Year 3: tenant Acme sends 40% of queries to one shard. Each symptom names its act — and its lever.",
  },
  ru: {
    svgTitle: "Масштаб ломает по одному слою: bloat с 200 MB до 80 GB, задержка с 4 мс до 4 с, заморозка на 8 минут и один tenant с 40 процентами запросов",
    headline: "МАСШТАБ ЛОМАЕТ ПО ОДНОМУ СЛОЮ",
    sub: "Акт 4 bloat · Акт 5 шторм · Акт 6 заморозка · Акт 7 hot shard",
    titles: ["АКТ 4 · BLOAT", "АКТ 5 · ШТОРМ", "АКТ 6 · ЗАМОРОЗКА", "АКТ 7 · HOT SHARD"],
    causes: ["таблица 200 MB", "1000 backends", "один ALTER ждёт", "tenant Acme"],
    froms: ["вздулась до", "4 мс стали", "очередь выросла до", "посылает"],
    tos: ["80 GB", "4 с", "8 мин", "40%"],
    levers: ["убить tx · pg_repack", "пул PgBouncer", "expand-contract", "co-location"],
    stages: ["Месяц 6", "Год 1", "Год 2", "Год 3"],
    foot: "симптом называет рычаг",
    caption:
      "Месяц 6: таблица вздулась с 200 MB до 80 GB. Год 1: 1000 backends превращают запросы по 4 мс в 4 с. Год 2: один ожидающий ALTER замораживает prod на 8 минут. Год 3: tenant Acme посылает 40% запросов на один шард. Каждый симптом называет свой акт — и свой рычаг.",
  },
};

const t = dict[lang];

const colX = [40, 225, 410, 595];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbcap-scale-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.titles.map((w, i) => (
      <g>
        <rect x={colX[i]} y="100" width="165" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={colX[i] + 82} y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{w}</text>
        <text x={colX[i] + 82} y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.causes[i]}</text>
        <text x={colX[i] + 82} y="188" text-anchor="middle" font-size="13" fill="var(--ink)">{t.froms[i]}</text>
        <text x={colX[i] + 82} y="222" text-anchor="middle" font-size="20" fill="var(--accent)">{t.tos[i]}</text>
        <text x={colX[i] + 82} y="268" text-anchor="middle" font-size="11" fill="var(--ink)">{t.levers[i]}</text>
        <text x={colX[i] + 82} y="306" text-anchor="middle" font-size="11" fill="var(--muted)">{t.stages[i]}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
