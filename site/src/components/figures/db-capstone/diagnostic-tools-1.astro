---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Each act has its diagnostic tool: unused indexes, slow queryids, dead-tuple ratio, backend count, lock blockers, per-shard latency",
    headline: "THE RIGHT TOOL FOR EACH ACT",
    sub: "pg_stat_activity first — it tells you which act you are in",
    acts: ["Act 2", "Act 3", "Act 4", "Act 5", "Act 6", "Act 7"],
    tools: ["pg_stat_user_indexes", "pg_stat_statements", "pg_stat_user_tables", "pg_stat_activity", "pg_locks", "app metrics"],
    signals: ["idx_scan = 0 · drop it", "slow queryids first", "ratio above 20%", "near max_connections", "who blocks ALTER", "one shard hot"],
    caption:
      "Each act has its diagnostic: unused indexes show idx_scan = 0, slow plans surface in pg_stat_statements, bloat shows as dead/live above 20%, storms show in pg_stat_activity, migration blockers in pg_locks, hot shards in per-shard latency. Open pg_stat_activity before touching anything.",
  },
  ru: {
    svgTitle: "У каждого акта свой диагностический инструмент: неиспользуемые индексы, медленные queryids, доля мёртвых tuples, число backends, блокировщики, задержка на шард",
    headline: "ПРАВИЛЬНЫЙ ИНСТРУМЕНТ ДЛЯ КАЖДОГО АКТА",
    sub: "сначала pg_stat_activity — он скажет, в каком ты акте",
    acts: ["Акт 2", "Акт 3", "Акт 4", "Акт 5", "Акт 6", "Акт 7"],
    tools: ["pg_stat_user_indexes", "pg_stat_statements", "pg_stat_user_tables", "pg_stat_activity", "pg_locks", "app metrics"],
    signals: ["idx_scan = 0 · удалить", "сначала медленные queryids", "доля выше 20%", "около max_connections", "кто блокирует ALTER", "один шард горячий"],
    caption:
      "У каждого акта своя диагностика: неиспользуемые индексы показывают idx_scan = 0, медленные планы всплывают в pg_stat_statements, bloat виден как dead/live выше 20%, штормы — в pg_stat_activity, блокировщики миграций — в pg_locks, горячие шарды — в задержке на шард. Открывай pg_stat_activity прежде чем что-либо трогать.",
  },
};

const t = dict[lang];

const rowY = [108, 153, 198, 243, 288, 333];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbcap-tools-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.acts.map((r, i) => (
      <g>
        <rect x="40" y={rowY[i]} width="720" height="38" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="56" y={rowY[i] + 25} font-size="12" fill="var(--ink)">{r}</text>
        <text x="140" y={rowY[i] + 25} font-size="11" fill="var(--accent)">{t.tools[i]}</text>
        <text x="380" y={rowY[i] + 25} font-size="11" fill="var(--muted)">{t.signals[i]}</text>
      </g>
    ))}
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
