---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One transaction open for four hours pins the xmin horizon so VACUUM reclaims nothing and the table swells from 200 MB to 80 GB",
    headline: "ONE OPEN TRANSACTION FREEZES VACUUM",
    sub: "the xmin horizon pins every cleanup behind it",
    leftTitle: "OPEN TX · 4 HOURS",
    horizonLab: "xmin · pinned",
    nowLab: "now",
    openLab: "open 4 h · read-only snapshot",
    vacLab: "VACUUM reclaims nothing",
    deadNote: "xmax vs horizon · dead stays",
    rightTitle: "TABLE SWELLS · NO NEW ROWS",
    sizes: ["200 MB", "80 GB"],
    leverLine: "kill tx · 60s timeout · pg_repack",
    foot: "idle_in_transaction_session_timeout = 60s",
    caption:
      "A report runner holds one transaction open for four hours; the xmin horizon freezes and VACUUM cannot reclaim a single dead tuple — the table swells from 200 MB to 80 GB with no new rows. Kill the long transaction, cap idle transactions at 60 s, reclaim with pg_repack.",
  },
  ru: {
    svgTitle: "Одна транзакция, открытая четыре часа, фиксирует xmin-горизонт: VACUUM ничего не возвращает, таблица вздувается с 200 MB до 80 GB",
    headline: "ОДНА ОТКРЫТАЯ ТРАНЗАКЦИЯ МОРОЗИТ VACUUM",
    sub: "xmin-горизонт держит всю очистку позади",
    leftTitle: "ОТКРЫТАЯ TX · 4 ЧАСА",
    horizonLab: "xmin · зафиксирован",
    nowLab: "сейчас",
    openLab: "открыта 4 ч · снапшот только для чтения",
    vacLab: "VACUUM ничего не возвращает",
    deadNote: "xmax vs горизонта · мёртвые остаются",
    rightTitle: "ТАБЛИЦА РАСТЁТ · ВСТАВОК НЕТ",
    sizes: ["200 MB", "80 GB"],
    leverLine: "убить tx · 60s timeout · pg_repack",
    foot: "idle_in_transaction_session_timeout = 60s",
    caption:
      "Report runner держит одну транзакцию открытой четыре часа; xmin-горизонт замирает, и VACUUM не возвращает ни одного мёртвого tuple — таблица вздувается с 200 MB до 80 GB без новых строк. Убей долгую транзакцию, ограничь idle-транзакции 60 секундами, верни место через pg_repack.",
  },
};

const t = dict[lang];

const barW = [60, 280];
const barY = [150, 200];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbcap-xmin-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="340" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <line x1="60" y1="170" x2="360" y2="170" stroke="var(--ink)" stroke-width="2" />
    <line x1="140" y1="158" x2="140" y2="182" stroke="var(--accent)" stroke-width="3" />
    <text x="140" y="200" text-anchor="middle" font-size="11" fill="var(--accent)">{t.horizonLab}</text>
    <line x1="340" y1="158" x2="340" y2="182" stroke="var(--ink)" stroke-width="2" />
    <text x="340" y="200" text-anchor="middle" font-size="11" fill="var(--muted)">{t.nowLab}</text>
    <rect x="75" y="214" width="270" height="26" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
    <text x="210" y="232" text-anchor="middle" font-size="11" fill="var(--muted)">{t.openLab}</text>
    <text x="210" y="276" text-anchor="middle" font-size="12" fill="var(--accent)">{t.vacLab}</text>
    <text x="210" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">{t.deadNote}</text>

    <rect x="420" y="100" width="340" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    {t.sizes.map((v, i) => (
      <g>
        <rect x="440" y={barY[i]} width={barW[i]} height="30" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="450" y={barY[i] + 21} font-size="12" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="590" y="272" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leverLine}</text>
    <text x="590" y="304" text-anchor="middle" font-size="11" fill="var(--muted)">hot_standby_feedback = off</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
