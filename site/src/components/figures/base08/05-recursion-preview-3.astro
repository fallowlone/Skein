---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Without a base case, frames pile up until the stack overflows",
    headline: "NO BASE CASE: OVERFLOW",
    sub: "calls never stop · frames pile up",
    region1: "stack",
    region2: "1–8 MB",
    side1: "no base case",
    side2: "calls never stop",
    overflow: "STACK OVERFLOW",
    ostext: "OS terminates the program",
    foot1: "stack region 1–8 MB fills up in milliseconds",
    foot2: "the base case is not optional",
    caption:
      "Without the base case, countdown(-1) calls countdown(-2), then countdown(-3), and so on forever. Each call pushes a new frame, the 1–8 MB stack region fills up within milliseconds, and the OS terminates the program with a stack overflow.",
  },
  ru: {
    svgTitle: "Без базового случая кадры копятся, пока стек не переполнится",
    headline: "НЕТ БАЗОВОГО СЛУЧАЯ: ПЕРЕПОЛНЕНИЕ",
    sub: "вызовы не останавливаются · кадры копятся",
    region1: "стек",
    region2: "1–8 МБ",
    side1: "базового случая нет",
    side2: "вызовы не останавливаются",
    overflow: "ПЕРЕПОЛНЕНИЕ СТЕКА",
    ostext: "ОС завершает программу",
    foot1: "область стека 1–8 МБ заполняется за миллисекунды",
    foot2: "базовый случай не опционален",
    caption:
      "Без базового случая countdown(-1) вызывает countdown(-2), затем countdown(-3) и так далее бесконечно. Каждый вызов кладёт новый кадр, область стека 1–8 МБ заполняется за миллисекунды, и ОС завершает программу с ошибкой переполнения стека.",
  },
};

const t = dict[lang];
const frames = [3, 2, 1, 0, -1, -2, -3, -4, -5, -6, -7];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="300" y="100" width="200" height="235" fill="none" stroke="var(--muted)" stroke-width="1.6" stroke-dasharray="6 4" />

    {frames.map((n, i) => (
      <g>
        <rect
          x="310"
          y={315 - i * 25}
          width="180"
          height="20"
          fill="var(--card)"
          stroke={i >= 9 ? "var(--accent)" : "var(--ink)"}
          stroke-width={i >= 9 ? 2 : 1.4}
        />
        <text x="400" y={329 - i * 25} text-anchor="middle" font-size="11" fill="var(--ink)">{`n=${n}`}</text>
      </g>
    ))}

    <text x="288" y="210" text-anchor="end" font-size="11" fill="var(--muted)">{t.region1}</text>
    <text x="288" y="226" text-anchor="end" font-size="11" fill="var(--muted)">{t.region2}</text>

    <text x="512" y="78" font-size="11" fill="var(--muted)">{t.side1}</text>
    <text x="512" y="94" font-size="11" fill="var(--muted)">{t.side2}</text>
    <text x="512" y="126" font-size="13" fill="var(--accent)">{t.overflow}</text>
    <text x="512" y="142" font-size="11" fill="var(--muted)">{t.ostext}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
