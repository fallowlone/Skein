---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Recursion has two parts: the base case and the recursive case",
    headline: "TWO PARTS: BASE + RECURSIVE",
    sub: "check n < 0 · return or call again",
    top: "countdown(n) called",
    leftQ: "n < 0",
    rightQ: "n ≥ 0",
    leftHead: "BASE CASE",
    leftLines: ["n < 0 → return", "no call · stops the descent", "bottom of the descent"],
    rightHead: "RECURSIVE CASE",
    rightLines: ["countdown(n - 1)", "new frame · n shrinks by 1", "moves toward the base"],
    foot1: "base case but no step toward it → returns at once",
    foot2: "recursive step but no base case → stack overflows",
    caption:
      "Recursion has exactly two parts: the base case (n < 0) returns a direct value without calling again and stops the descent, while the recursive case calls countdown(n - 1), pushing a new frame with n shrunk by 1 and moving toward the base. Both parts are required and neither is optional.",
  },
  ru: {
    svgTitle: "У рекурсии две части: базовый случай и рекурсивный случай",
    headline: "ДВЕ ЧАСТИ: БАЗА + РЕКУРСИЯ",
    sub: "проверь n < 0 · вернись или вызови снова",
    top: "вызов countdown(n)",
    leftQ: "n < 0",
    rightQ: "n ≥ 0",
    leftHead: "БАЗОВЫЙ СЛУЧАЙ",
    leftLines: ["n < 0 → return", "без вызова · останавливает спуск", "дно спуска"],
    rightHead: "РЕКУРСИВНЫЙ СЛУЧАЙ",
    rightLines: ["countdown(n - 1)", "новый кадр · n меньше на 1", "движение к базовому случаю"],
    foot1: "есть база, но нет шага к ней → возврат сразу",
    foot2: "есть шаг, но нет базы → переполнение стека",
    caption:
      "У рекурсии ровно две части: базовый случай (n < 0) возвращает прямое значение без следующего вызова и останавливает спуск, а рекурсивный случай вызывает countdown(n - 1), кладя новый кадр с n меньше на 1 и двигаясь к базе. Обе части обязательны, ни одна не опциональна.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="295" y="85" width="210" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="112" text-anchor="middle" font-size="13" fill="var(--ink)">{t.top}</text>

    <line x1="350" y1="129" x2="230" y2="185" stroke="var(--ink)" stroke-width="1.6" />
    <polygon points="230,185 239,175 243,184" fill="var(--ink)" />
    <line x1="450" y1="129" x2="570" y2="185" stroke="var(--ink)" stroke-width="1.6" />
    <polygon points="570,185 561,175 557,184" fill="var(--ink)" />
    <text x="282" y="152" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftQ}</text>
    <text x="518" y="152" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightQ}</text>

    <rect x="90" y="185" width="280" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="230" y="212" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftHead}</text>
    {t.leftLines.map((line, i) => (
      <text x="230" y={236 + i * 22} text-anchor="middle" font-size="11" fill="var(--muted)">{line}</text>
    ))}

    <rect x="430" y="185" width="280" height="120" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="570" y="212" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightHead}</text>
    {t.rightLines.map((line, i) => (
      <text x="570" y={236 + i * 22} text-anchor="middle" font-size="11" fill="var(--muted)">{line}</text>
    ))}

    <text x="400" y="342" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="366" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
