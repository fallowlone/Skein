---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Calls push depth 1 to 3, returns unwind inner-first to 0",
    headline: "LAST IN, FIRST OUT",
    sub: "newest frame on top · pops first",
    depths: ["depth 1", "depth 2", "depth 3", "depth 0"],
    boxes: [["main · a=1"], ["main · a=1", "outer · b=2"], ["main · a=1", "outer · b=2", "inner · c=3"], []],
    trans: ["CALL outer", "CALL inner", "RET x3"],
    empty: "stack empty",
    foot1: "calls push: 1 → 2 → 3 · returns pop: inner → outer → main",
    foot2: "LIFO: inner must finish before outer can continue",
    caption:
      "Successive calls push the stack from depth 1 to depth 3; three returns unwind it inner-first back to depth 0. The newest frame is always on top and pops first — last in, first out — because inner must finish before outer can continue.",
  },
  ru: {
    svgTitle: "Вызовы кладут кадры, возвраты снимают их начиная с inner",
    headline: "ПОСЛЕДНИМ ВОШЁЛ — ПЕРВЫМ ВЫШЕЛ",
    sub: "новейший кадр сверху · снимается первым",
    depths: ["depth 1", "depth 2", "depth 3", "depth 0"],
    boxes: [["main · a=1"], ["main · a=1", "outer · b=2"], ["main · a=1", "outer · b=2", "inner · c=3"], []],
    trans: ["CALL outer", "CALL inner", "RET x3"],
    empty: "стек пуст",
    foot1: "вызовы кладут: 1 → 2 → 3 · возвраты снимают: inner → outer → main",
    foot2: "LIFO: inner обязан завершиться, прежде чем outer продолжится",
    caption:
      "Последовательные вызовы кладут кадры: один, два, три; три возврата снимают их начиная с inner, пока стек не опустеет. Новейший кадр всегда сверху и снимается первым — последним вошёл, первым вышел, — потому что inner обязан завершиться, прежде чем outer сможет продолжить.",
  },
};

const t = dict[lang];

const xs = [30, 215, 400, 585];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.depths.map((d, ci) => (
      <g>
        <text x={xs[ci] + 85} y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{d}</text>
        {t.boxes[ci].map((b, bi) => (
          <g>
            <rect x={xs[ci]} y={276 - bi * 44} width="170" height="44" fill="var(--card)" stroke={bi === t.boxes[ci].length - 1 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
            <text x={xs[ci] + 85} y={304 - bi * 44} text-anchor="middle" font-size="11" fill="var(--ink)">{b}</text>
          </g>
        ))}
      </g>
    ))}

    <rect x="585" y="276" width="170" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="5 4" />
    <text x="670" y="304" text-anchor="middle" font-size="11" fill="var(--muted)">{t.empty}</text>

    {t.trans.map((tr, i) => (
      <g>
        <line x1={xs[i] + 170} y1="298" x2={xs[i + 1]} y2="298" stroke="var(--accent)" stroke-width="1.6" />
        <polygon points={`${xs[i + 1]},298 ${xs[i + 1] - 8},293 ${xs[i + 1] - 8},303`} fill="var(--accent)" />
        <text x={(xs[i] + 170 + xs[i + 1]) / 2} y="342" text-anchor="middle" font-size="11" fill="var(--muted)">{tr}</text>
      </g>
    ))}

    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="390" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
