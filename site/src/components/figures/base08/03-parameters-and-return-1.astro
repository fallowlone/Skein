---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Arguments 3 and 5 are copied into add's frame as x and y at CALL",
    headline: "ARGUMENTS COPY INTO THE FRAME",
    sub: "in at CALL · before the body runs",
    caller: "call site (main)",
    callExpr: "add(3, 5)",
    argsLabel: "arguments",
    argsVals: "3 · 5",
    frame: "add's frame",
    cells: ["x = 3", "y = 5"],
    copyLabel: "copy in at CALL",
    bodyLabel: "body",
    bodyExpr: "x + y = 8",
    foot1: "before the body runs: x = 3, y = 5",
    foot2: "inside the frame, parameters act like local variables",
    caption:
      "At CALL, the arguments 3 and 5 are copied into add's new stack frame as the parameters x and y, before the body starts running. Inside the function, x and y behave exactly like local variables — named cells pre-filled with the caller's values.",
  },
  ru: {
    svgTitle: "Аргументы 3 и 5 копируются в кадр add как x и y на CALL",
    headline: "АРГУМЕНТЫ КОПИРУЮТСЯ В КАДР",
    sub: "вход на CALL · до тела функции",
    caller: "точка вызова (main)",
    callExpr: "add(3, 5)",
    argsLabel: "аргументы",
    argsVals: "3 · 5",
    frame: "кадр add",
    cells: ["x = 3", "y = 5"],
    copyLabel: "копия внутрь на CALL",
    bodyLabel: "тело",
    bodyExpr: "x + y = 8",
    foot1: "до тела функции: x = 3, y = 5",
    foot2: "внутри кадра параметры — как локальные переменные",
    caption:
      "На CALL аргументы 3 и 5 копируются в новый кадр стека add как параметры x и y — до начала выполнения тела. Внутри функции x и y ведут себя точно как локальные переменные: это именованные ячейки, заранее заполненные значениями вызывающей стороны.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="160" y="105" text-anchor="middle" font-size="11" fill="var(--muted)">{t.caller}</text>
    <rect x="60" y="120" width="200" height="130" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="160" y="158" text-anchor="middle" font-size="13" fill="var(--ink)">{t.callExpr}</text>
    <text x="160" y="186" text-anchor="middle" font-size="11" fill="var(--muted)">{t.argsLabel}</text>
    <text x="160" y="214" text-anchor="middle" font-size="13" fill="var(--ink)">{t.argsVals}</text>

    <text x="640" y="85" text-anchor="middle" font-size="11" fill="var(--muted)">{t.frame}</text>
    <rect x="540" y="95" width="200" height="200" fill="none" stroke="var(--ink)" stroke-width="2" />

    {t.cells.map((c, i) => (
      <g>
        <rect x="556" y={125 + i * 54} width="168" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x="640" y={152 + i * 54} text-anchor="middle" font-size="13" fill="var(--ink)">{c}</text>
        <line x1="260" y1={147 + i * 54} x2="548" y2={147 + i * 54} stroke="var(--accent)" stroke-width="1.6" />
        <polygon points={`556,${147 + i * 54} 548,${142 + i * 54} 548,${152 + i * 54}`} fill="var(--accent)" />
      </g>
    ))}

    <text x="408" y="178" text-anchor="middle" font-size="11" fill="var(--muted)">{t.copyLabel}</text>

    <text x="640" y="252" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bodyLabel}</text>
    <text x="640" y="276" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bodyExpr}</text>

    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
