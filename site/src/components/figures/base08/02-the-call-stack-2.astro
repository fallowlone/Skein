---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three nested calls hold three frames: main, outer, inner",
    headline: "THREE CALLS, THREE FRAMES",
    sub: "main calls outer · outer calls inner",
    names: ["inner (top — current call)", "outer", "main (bottom — first call)"],
    notes: ["c = 3 · pushed last, pops first", "b = 2 · return → main", "a = 1 · return → program end"],
    calls: ["CALL inner", "CALL outer", "CALL main"],
    pops: ["pops first", "pops after inner", "pops after outer"],
    foot1: "the stack holds exactly the frames of all active functions",
    foot2: "the stack unwinds: inner → outer → main",
    caption:
      "At the deepest point three frames sit on the stack: main at the bottom (first call, a = 1), outer above it (b = 2), inner on top (current call, c = 3). Each CALL pushes a frame; each RET pops the top frame, so the stack unwinds inner → outer → main.",
  },
  ru: {
    svgTitle: "Три вложенных вызова держат три кадра: main, outer, inner",
    headline: "ТРИ ВЫЗОВА — ТРИ КАДРА",
    sub: "main вызывает outer · outer вызывает inner",
    names: ["inner (вершина — текущий вызов)", "outer", "main (низ — первый вызов)"],
    notes: ["c=3 · положен последним, снят первым", "b=2 · возврат → main", "a=1 · возврат → конец программы"],
    calls: ["CALL inner", "CALL outer", "CALL main"],
    pops: ["снят первым", "снят после inner", "снят после outer"],
    foot1: "стек хранит ровно кадры всех текущих активных функций",
    foot2: "стек разматывается: inner → outer → main",
    caption:
      "В самой глубокой точке на стеке три кадра: main внизу (первый вызов, a = 1), outer над ним (b = 2), inner сверху (текущий вызов, c = 3). Каждый CALL кладёт кадр; каждый RET снимает верхний кадр, поэтому стек разматывается inner → outer → main.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.names.map((n, i) => (
      <g>
        <rect x="270" y={104 + i * 84} width="260" height="56" fill="var(--card)" stroke={i === 0 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x="400" y={128 + i * 84} text-anchor="middle" font-size="13" fill="var(--ink)">{n}</text>
        <text x="400" y={147 + i * 84} text-anchor="middle" font-size="11" fill="var(--muted)">{t.notes[i]}</text>
        <text x="250" y={136 + i * 84} text-anchor="end" font-size="11" fill="var(--accent)">{t.calls[i]}</text>
        <line x1="254" y1={132 + i * 84} x2="270" y2={132 + i * 84} stroke="var(--accent)" stroke-width="1.6" />
        <polygon points={`270,${132 + i * 84} 262,${127 + i * 84} 262,${137 + i * 84}`} fill="var(--accent)" />
        <text x="550" y={136 + i * 84} text-anchor="start" font-size="11" fill="var(--ink)">{t.pops[i]}</text>
        <line x1="530" y1={132 + i * 84} x2="546" y2={132 + i * 84} stroke="var(--ink)" stroke-width="1.6" />
        <polygon points={`546,${132 + i * 84} 538,${127 + i * 84} 538,${137 + i * 84}`} fill="var(--ink)" />
      </g>
    ))}

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
