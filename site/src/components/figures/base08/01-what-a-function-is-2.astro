---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "CALL saves the return address and jumps; RET jumps back to it",
    headline: "CALL JUMPS THERE, RET JUMPS BACK",
    sub: "PC 20 → 80 → 81 → 21",
    caps: ["① call", "② body", "③ return", "④ resume"],
    lines: [
      ["PC 20 → 80", "saved ret = 21"],
      ["MUL R1, 2 at 80", "PC → 81"],
      ["RET reads 21", "PC = 21"],
      ["ADD R0, 1 at 21", "caller continues"],
    ],
    loop: "same body · any caller",
    foot1: "a return jumps to the address recorded at call time",
    foot2: "after RET, the caller resumes exactly where it left off",
    caption:
      "Calling is a jump that remembers the way back: CALL at 20 saves 21 and jumps to 80, the body runs MUL, RET reads the saved 21, and the caller resumes at 21 with ADD. The same body serves callers from anywhere because each call records its own return.",
  },
  ru: {
    svgTitle: "CALL сохраняет адрес возврата и прыгает; RET прыгает назад",
    headline: "CALL — ТУДА, RET — ОБРАТНО",
    sub: "СК 20 → 80 → 81 → 21",
    caps: ["① вызов", "② тело", "③ возврат", "④ продолжение"],
    lines: [
      ["СК 20 → 80", "сохранён возврат 21"],
      ["MUL R1, 2 на 80", "СК → 81"],
      ["RET читает 21", "СК = 21"],
      ["ADD R0, 1 на 21", "вызывающий дальше"],
    ],
    loop: "одно тело · любой вызывающий",
    foot1: "возврат — переход на адрес, записанный при вызове",
    foot2: "после RET вызывающий продолжает с места остановки",
    caption:
      "Вызов — это переход, запоминающий дорогу назад: CALL на 20 сохраняет 21 и прыгает на 80, тело выполняет MUL, RET читает сохранённый 21, и вызывающий продолжает с 21 инструкцией ADD. Одно тело служит вызывающим отовсюду, потому что каждый вызов записывает свой возврат.",
  },
};

const t = dict[lang];
const gaps = [0, 1, 2];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.caps.map((c, i) => (
      <g>
        <text x={113 + i * 191} y="112" text-anchor="middle" font-size="11" fill="var(--muted)">{c}</text>
        <rect x={31 + i * 191} y="130" width="165" height="80" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={113 + i * 191} y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.lines[i][0]}</text>
        <text x={113 + i * 191} y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.lines[i][1]}</text>
      </g>
    ))}

    {gaps.map((i) => (
      <g>
        <line x1={196 + i * 191} y1="170" x2={218 + i * 191} y2="170" stroke="var(--accent)" stroke-width="1.6" />
        <polygon points={`${222 + i * 191},170 ${214 + i * 191},165 ${214 + i * 191},175`} fill="var(--accent)" />
      </g>
    ))}

    <path d="M686,210 L686,300 L113,300 L113,214" fill="none" stroke="var(--muted)" stroke-width="1.6" stroke-dasharray="6 4" />
    <polygon points="113,210 108,218 118,218" fill="var(--muted)" />
    <text x="400" y="292" text-anchor="middle" font-size="11" fill="var(--muted)">{t.loop}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
