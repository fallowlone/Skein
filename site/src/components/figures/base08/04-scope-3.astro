---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A local is created at push and destroyed at pop",
    headline: "LIFETIME = FRAME LIFETIME",
    sub: "how long in time the variable exists in memory",
    cards: [
      { h: "CALL f · push", b: "x is created", s: "call starts" },
      { h: "f runs", b: "x lives in frame", s: "name is usable" },
      { h: "return · pop", b: "x is destroyed", s: "name is gone" },
    ],
    time: "time",
    foot1: "lifetime = frame lifetime",
    foot2: "a local exists exactly as long as the call that created it",
    caption:
      "Lifetime is how long a variable exists in memory. A local comes into existence when its frame is pushed and is destroyed when the frame is popped — it exists for exactly as long as the call that created it.",
  },
  ru: {
    svgTitle: "Локальная переменная создаётся при кладке и уничтожается при снятии",
    headline: "ВРЕМЯ ЖИЗНИ = ВРЕМЯ ЖИЗНИ КАДРА",
    sub: "как долго во времени переменная существует в памяти",
    cards: [
      { h: "вызов f · кадр кладётся", b: "x появляется", s: "вызов начался" },
      { h: "f выполняется", b: "x живёт в кадре", s: "имя можно использовать" },
      { h: "возврат · кадр снят", b: "x уничтожается", s: "имя исчезло" },
    ],
    time: "время",
    foot1: "время жизни = время жизни кадра",
    foot2: "локальная переменная существует, пока длится её вызов",
    caption:
      "Время жизни — как долго переменная существует в памяти. Локальная переменная появляется, когда её кадр кладётся, и уничтожается, когда кадр снимается, — она существует ровно столько, сколько длится создавший её вызов.",
  },
};

const t = dict[lang];
const cardX = [45, 300, 555];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.cards.map((c, i) => (
      <g>
        <rect x={cardX[i]} y="125" width="200" height="150" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cardX[i] + 100} y="150" text-anchor="middle" font-size="11" fill="var(--muted)">{c.h}</text>
        <line x1={cardX[i] + 15} y1="163" x2={cardX[i] + 185} y2="163" stroke="var(--muted)" stroke-width="1" />
        <text x={cardX[i] + 100} y="208" text-anchor="middle" font-size="13" fill="var(--ink)">{c.b}</text>
        <text x={cardX[i] + 100} y="238" text-anchor="middle" font-size="11" fill="var(--muted)">{c.s}</text>
      </g>
    ))}

    <line x1="245" y1="200" x2="293" y2="200" stroke="var(--accent)" stroke-width="2" />
    <polygon points="300,200 292,195 292,205" fill="var(--accent)" />
    <line x1="500" y1="200" x2="548" y2="200" stroke="var(--accent)" stroke-width="2" />
    <polygon points="555,200 547,195 547,205" fill="var(--accent)" />

    <line x1="45" y1="315" x2="738" y2="315" stroke="var(--muted)" stroke-width="1.6" />
    <polygon points="745,315 737,310 737,320" fill="var(--muted)" />
    <text x="400" y="335" text-anchor="middle" font-size="11" fill="var(--muted)">{t.time}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="385" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
