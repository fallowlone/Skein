---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "f and g each hold their own x cell",
    headline: "ONE NAME, TWO CELLS",
    sub: "f and g each declare x — separate frames, separate cells",
    frames: [
      { title: "function f: let x = 1;", cell: "x = 1", addr: "cell in f's frame" },
      { title: "function g: let x = 2;", cell: "x = 2", addr: "cell in g's frame" },
    ],
    mid: "2 cells",
    foot1: "same spelling, zero sharing",
    foot2: "changing x in f has no effect on x in g",
    caption:
      "Two functions declaring the same name create two different variables. The x in f and the x in g are separate cells in separate stack frames at different addresses; changing one has no effect on the other.",
  },
  ru: {
    svgTitle: "f и g хранят каждая свою ячейку x",
    headline: "ОДНО ИМЯ — ДВЕ ЯЧЕЙКИ",
    sub: "f и g объявляют x — разные кадры, разные ячейки",
    frames: [
      { title: "function f: let x = 1;", cell: "x = 1", addr: "ячейка кадра f" },
      { title: "function g: let x = 2;", cell: "x = 2", addr: "ячейка кадра g" },
    ],
    mid: "2 ячейки",
    foot1: "одинаковое написание, ноль общего",
    foot2: "изменение x в f не влияет на x в g",
    caption:
      "Две функции, объявляющие одно имя, создают две разные переменные. x в f и x в g — отдельные ячейки в отдельных кадрах стека по разным адресам; изменение одной не влияет на другую.",
  },
};

const t = dict[lang];
const boxX = [70, 440];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.frames.map((f, i) => (
      <g>
        <rect x={boxX[i]} y="115" width="290" height="175" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={boxX[i] + 145} y="142" text-anchor="middle" font-size="12" fill="var(--ink)">{f.title}</text>
        <line x1={boxX[i] + 15} y1="158" x2={boxX[i] + 275} y2="158" stroke="var(--muted)" stroke-width="1" />
        <rect x={boxX[i] + 45} y="175" width="200" height="55" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={boxX[i] + 145} y="209" text-anchor="middle" font-size="13" fill="var(--ink)">{f.cell}</text>
        <text x={boxX[i] + 145} y="260" text-anchor="middle" font-size="11" fill="var(--muted)">{f.addr}</text>
      </g>
    ))}

    <text x="400" y="212" text-anchor="middle" font-size="28" fill="var(--accent)">≠</text>
    <text x="400" y="242" text-anchor="middle" font-size="11" fill="var(--muted)">{t.mid}</text>

    <text x="400" y="340" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="365" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
