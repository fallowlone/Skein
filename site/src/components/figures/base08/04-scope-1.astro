---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Scope of x spans from its declaration to the closing brace",
    headline: "SCOPE IS THE VISIBLE REGION",
    sub: "where in the code a name can be used",
    rows: [
      { code: "function f() {", note: "" },
      { code: "let x = 1;", note: "← declared here" },
      { code: "return x;", note: "← OK: in scope" },
      { code: "}", note: "" },
      { code: "x here? ✗", note: "← error: out of scope" },
    ],
    bracket: "scope of x",
    foot1: "visible from the declaration to the closing }",
    foot2: "outside the block the name does not exist",
    caption:
      "Scope is the region of code where a name is visible. The variable x declared inside f is visible from its declaration to the closing brace; outside the block the name does not exist, and referencing it is a compile error.",
  },
  ru: {
    svgTitle: "Область видимости x — от объявления до закрывающей скобки",
    headline: "ОБЛАСТЬ ВИДИМОСТИ — ГДЕ ИМЯ ВИДНО",
    sub: "где в коде видимо имя",
    rows: [
      { code: "function f() {", note: "" },
      { code: "let x = 1;", note: "← объявлена здесь" },
      { code: "return x;", note: "← ОК: в области" },
      { code: "}", note: "" },
      { code: "x здесь? ✗", note: "← ошибка: вне области" },
    ],
    bracket: "область видимости x",
    foot1: "видно от объявления до закрывающей }",
    foot2: "вне блока имени не существует",
    caption:
      "Область видимости — регион кода, где видимо имя. Переменная x, объявленная внутри f, видна от точки объявления до закрывающей скобки; вне блока имя не существует, и обращение к нему — ошибка компиляции.",
  },
};

const t = dict[lang];
const rowY = [125, 155, 185, 215, 255];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="140" y="95" width="340" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />

    {t.rows.map((r, i) => (
      <g>
        <text x="160" y={rowY[i]} font-size="13" fill="var(--ink)">{r.code}</text>
        {r.note !== "" ? <text x="300" y={rowY[i]} font-size="13" fill="var(--muted)">{r.note}</text> : null}
      </g>
    ))}

    <line x1="505" y1="148" x2="505" y2="222" stroke="var(--accent)" stroke-width="2" />
    <line x1="505" y1="148" x2="495" y2="148" stroke="var(--accent)" stroke-width="2" />
    <line x1="505" y1="222" x2="495" y2="222" stroke="var(--accent)" stroke-width="2" />
    <text x="515" y="188" font-size="11" fill="var(--accent)">{t.bracket}</text>

    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="370" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
