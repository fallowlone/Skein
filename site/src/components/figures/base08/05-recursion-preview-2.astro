---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "countdown(3) at its deepest: five frames stacked, then unwinding to zero",
    headline: "COUNTDOWN(3): FIVE FRAMES, THEN ZERO",
    sub: "deepest point · 5 frames stacked",
    baseTag: "BASE",
    pushHead: "CALL ×5",
    pushSub: "depth 1 → 5",
    popHead: "RET ×5",
    popSub: "depth 5 → 0",
    foot1: "each call keeps its own n",
    foot2: "base case on top returns first, rest follow",
    caption:
      "The deepest point of countdown(3): 5 frames stacked, from countdown(3) at the bottom to the base case countdown(-1) on top. Each CALL pushed one frame with its own n; the base case returns without calling, then the five frames pop back to empty.",
  },
  ru: {
    svgTitle: "countdown(3) на максимальной глубине: пять кадров в стопке, затем размотка до нуля",
    headline: "COUNTDOWN(3): ПЯТЬ КАДРОВ, ЗАТЕМ НОЛЬ",
    sub: "максимальная глубина · 5 кадров в стопке",
    baseTag: "БАЗА",
    pushHead: "CALL ×5",
    pushSub: "глубина 1 → 5",
    popHead: "RET ×5",
    popSub: "глубина 5 → 0",
    foot1: "у каждого вызова свой n",
    foot2: "базовый случай наверху возвращается первым",
    caption:
      "Самая глубокая точка countdown(3): 5 кадров в стопке — от countdown(3) внизу до базового случая countdown(-1) наверху. Каждый CALL положил один кадр со своим n; базовый случай возвращается без вызова, затем пять кадров снимаются до пустоты.",
  },
};

const t = dict[lang];
const frames = [3, 2, 1, 0, -1];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {frames.map((n, i) => (
      <g>
        <rect
          x="270"
          y={88 + i * 48}
          width="260"
          height="40"
          fill="var(--card)"
          stroke={i === 0 ? "var(--accent)" : "var(--ink)"}
          stroke-width="2"
        />
        <text x="400" y={113 + i * 48} text-anchor="middle" font-size="11" fill="var(--ink)">
          {i === 0 ? `${t.baseTag} · countdown(${n}) · n=${n}` : `countdown(${n}) · n=${n}`}
        </text>
      </g>
    ))}

    <line x1="268" y1="108" x2="215" y2="108" stroke="var(--muted)" stroke-width="1.4" />
    <line x1="268" y1="300" x2="215" y2="300" stroke="var(--muted)" stroke-width="1.4" />
    <line x1="215" y1="108" x2="215" y2="300" stroke="var(--muted)" stroke-width="1.6" />
    <polygon points="215,308 210,298 220,298" fill="var(--muted)" />
    <text x="203" y="198" text-anchor="end" font-size="11" fill="var(--muted)">{t.pushHead}</text>
    <text x="203" y="214" text-anchor="end" font-size="11" fill="var(--muted)">{t.pushSub}</text>

    <line x1="532" y1="108" x2="585" y2="108" stroke="var(--muted)" stroke-width="1.4" />
    <line x1="532" y1="300" x2="585" y2="300" stroke="var(--muted)" stroke-width="1.4" />
    <line x1="585" y1="300" x2="585" y2="104" stroke="var(--muted)" stroke-width="1.6" />
    <polygon points="585,100 580,110 590,110" fill="var(--muted)" />
    <text x="597" y="198" font-size="11" fill="var(--muted)">{t.popHead}</text>
    <text x="597" y="214" font-size="11" fill="var(--muted)">{t.popSub}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
