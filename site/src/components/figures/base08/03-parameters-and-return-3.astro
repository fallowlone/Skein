---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "add's frame holds three named cells: x, y, and result",
    headline: "ONE FRAME: PARAMS + LOCALS",
    sub: "x, y pre-filled · result set by the body",
    callerLabel: "call site",
    argsLabel: "arguments",
    argsVals: "3 · 5",
    frame: "add's frame",
    cells: ["x = 3 — parameter", "y = 5 — parameter", "result = 8 — local"],
    bodyLabel: "body",
    bodyExpr: "x + y = 8",
    foot1: "x, y are parameters; result is a local variable",
    foot2: "3 named cells in add's frame",
    caption:
      "add's stack frame holds three named cells: the parameters x = 3 and y = 5, copied in from the caller's arguments at CALL, and the local variable result = 8, set by the body computing x + y. Parameters and locals live side by side in the same frame.",
  },
  ru: {
    svgTitle: "Кадр add содержит три именованные ячейки: x, y и result",
    headline: "ОДИН КАДР: ПАРАМЕТРЫ И ЛОКАЛЬНЫЕ",
    sub: "x, y — заранее · result — присваиванием",
    callerLabel: "точка вызова",
    argsLabel: "аргументы",
    argsVals: "3 · 5",
    frame: "кадр add",
    cells: ["x = 3 — параметр", "y = 5 — параметр", "result = 8 — локальная"],
    bodyLabel: "тело",
    bodyExpr: "x + y = 8",
    foot1: "x, y — параметры; result — локальная переменная",
    foot2: "3 именованные ячейки в кадре add",
    caption:
      "Кадр стека add содержит три именованные ячейки: параметры x = 3 и y = 5, скопированные из аргументов вызывающей стороны на CALL, и локальную переменную result = 8, заданную телом при вычислении x + y. Параметры и локальные переменные живут рядом в одном кадре.",
  },
};

const t = dict[lang];

const cellYs = [141, 203];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="145" y="130" text-anchor="middle" font-size="11" fill="var(--muted)">{t.callerLabel}</text>
    <rect x="70" y="140" width="150" height="90" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="145" y="170" text-anchor="middle" font-size="11" fill="var(--muted)">{t.argsLabel}</text>
    <text x="145" y="198" text-anchor="middle" font-size="13" fill="var(--ink)">{t.argsVals}</text>

    <text x="400" y="85" text-anchor="middle" font-size="11" fill="var(--muted)">{t.frame}</text>
    <rect x="250" y="95" width="300" height="220" fill="none" stroke="var(--ink)" stroke-width="2" />

    {t.cells.map((c, i) => (
      <g>
        <rect x="270" y={115 + i * 62} width="260" height="52" fill="var(--card)" stroke={i < 2 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x="400" y={146 + i * 62} text-anchor="middle" font-size="13" fill="var(--ink)">{c}</text>
      </g>
    ))}

    {cellYs.map((yy) => (
      <g>
        <line x1="220" y1={yy} x2="242" y2={yy} stroke="var(--accent)" stroke-width="1.6" />
        <polygon points={`250,${yy} 242,${yy - 5} 242,${yy + 5}`} fill="var(--accent)" />
      </g>
    ))}

    <rect x="580" y="217" width="150" height="62" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="655" y="240" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bodyLabel}</text>
    <text x="655" y="263" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bodyExpr}</text>
    <line x1="580" y1="265" x2="558" y2="265" stroke="var(--muted)" stroke-width="1.6" />
    <polygon points="550,265 558,260 558,270" fill="var(--muted)" />

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
