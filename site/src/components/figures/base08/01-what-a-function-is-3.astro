---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One function body serves many callers; each call saves its own return",
    headline: "ONE BODY SERVES EVERY CALLER",
    sub: "two call sites · one body · zero copies",
    callerCol: "call sites",
    bodyCol: "one body at 80–81",
    bodyName: "greet:",
    bodyLines: ["80 · MUL R1, 2", "81 · RET"],
    sites: ["line 10: CALL greet", "line 50: CALL greet"],
    rets: ["saves return 11", "saves return 51"],
    back: ["RET → 11", "RET → 51"],
    foot1: "each call saves its own return address",
    foot2: "fixing the function fixes all callers at once",
    caption:
      "One function body serves every caller: the greet body at 80–81 is called from line 10 and from line 50, and each call saves its own return address — 11 and 51 — so each returns to the right place. The body exists once; nothing is copied.",
  },
  ru: {
    svgTitle: "Одно тело функции служит многим вызывающим; у каждого свой возврат",
    headline: "ОДНО ТЕЛО — ВСЕМ ВЫЗЫВАЮЩИМ",
    sub: "две точки вызова · одно тело · ноль копий",
    callerCol: "точки вызова",
    bodyCol: "одно тело: 80–81",
    bodyName: "greet:",
    bodyLines: ["80 · MUL R1, 2", "81 · RET"],
    sites: ["строка 10: CALL greet", "строка 50: CALL greet"],
    rets: ["сохраняет возврат 11", "сохраняет возврат 51"],
    back: ["RET → 11", "RET → 51"],
    foot1: "каждый вызов хранит свой адрес возврата",
    foot2: "исправление функции исправляет всех вызывающих сразу",
    caption:
      "Одно тело функции служит всем вызывающим: тело greet по адресам 80–81 вызывается из строки 10 и из строки 50, и каждый вызов сохраняет свой адрес возврата — 11 и 51, — поэтому каждый возвращается в правильное место. Тело существует в одном экземпляре; ничего не копируется.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="170" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.callerCol}</text>
    <text x="630" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bodyCol}</text>

    <rect x="520" y="140" width="220" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="630" y="196" text-anchor="middle" font-size="13" fill="var(--ink)">{t.bodyName}</text>
    {t.bodyLines.map((b, i) => (
      <text x="630" y={226 + i * 30} text-anchor="middle" font-size="13" fill="var(--ink)">{b}</text>
    ))}

    {t.sites.map((s, i) => (
      <g>
        <rect x="60" y={140 + i * 110} width="220" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="170" y={164 + i * 110} text-anchor="middle" font-size="11" fill="var(--ink)">{s}</text>
        <text x="170" y={186 + i * 110} text-anchor="middle" font-size="11" fill="var(--muted)">{t.rets[i]}</text>
        <text x="400" y={152 + i * 110} text-anchor="middle" font-size="11" fill="var(--muted)">CALL</text>
        <line x1="284" y1={160 + i * 110} x2="516" y2={160 + i * 110} stroke="var(--accent)" stroke-width="1.6" />
        <polygon points={`520,${160 + i * 110} 512,${155 + i * 110} 512,${165 + i * 110}`} fill="var(--accent)" />
        <text x="400" y={184 + i * 110} text-anchor="middle" font-size="11" fill="var(--muted)">{t.back[i]}</text>
        <line x1="520" y1={190 + i * 110} x2="284" y2={190 + i * 110} stroke="var(--muted)" stroke-width="1.6" stroke-dasharray="6 4" />
        <polygon points={`280,${190 + i * 110} 288,${185 + i * 110} 288,${195 + i * 110}`} fill="var(--muted)" />
      </g>
    ))}

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
