---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A stack frame holds the return address and the local variables",
    headline: "FRAME = RETURN ADDRESS + LOCALS",
    sub: "one frame per active function call",
    frameTitle: "outer's frame",
    retLabel: "return address",
    retValue: "line 13 → main",
    locLabel: "local variables",
    locValue: "b = 2",
    retNote: "where the PC goes on RET",
    locNote: "b lives in this frame",
    foot1: "no return address → the CPU has no way home",
    foot2: "isolated locals → two calls can't overwrite each other",
    caption:
      "One stack frame holds exactly two things: the return address (where the program counter goes on return — line 13 for outer) and the call's own local variables (b = 2). Without the return address the CPU would have no way home; without isolated locals, two calls to the same function would overwrite each other's variables.",
  },
  ru: {
    svgTitle: "Кадр стека хранит адрес возврата и локальные переменные",
    headline: "КАДР = АДРЕС ВОЗВРАТА + ЛОКАЛЬНЫЕ",
    sub: "по одному кадру на каждый активный вызов функции",
    frameTitle: "кадр outer",
    retLabel: "адрес возврата",
    retValue: "строка 13 → main",
    locLabel: "локальные переменные",
    locValue: "b = 2",
    retNote: "куда идёт счётчик команд на RET",
    locNote: "b живёт в этом кадре",
    foot1: "без адреса возврата CPU некуда вернуться",
    foot2: "изолированные локальные: вызовы не затирают друг друга",
    caption:
      "Один кадр стека хранит ровно две вещи: адрес возврата (куда перейдёт счётчик команд при возврате — строка 13 для outer) и собственные локальные переменные вызова (b = 2). Без адреса возврата CPU некуда было бы вернуться; без изолированных локальных переменных два вызова одной функции перезаписывали бы данные друг друга.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.frameTitle}</text>

    <rect x="250" y="115" width="300" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <line x1="250" y1="210" x2="550" y2="210" stroke="var(--ink)" stroke-width="1.5" />

    <text x="400" y="140" text-anchor="middle" font-size="11" fill="var(--muted)">{t.retLabel}</text>
    <text x="400" y="172" text-anchor="middle" font-size="15" fill="var(--ink)">{t.retValue}</text>
    <text x="400" y="235" text-anchor="middle" font-size="11" fill="var(--muted)">{t.locLabel}</text>
    <text x="400" y="267" text-anchor="middle" font-size="15" fill="var(--ink)">{t.locValue}</text>

    <text x="238" y="166" text-anchor="end" font-size="11" fill="var(--muted)">{t.retNote}</text>
    <line x1="240" y1="162" x2="250" y2="162" stroke="var(--muted)" stroke-width="1.6" />
    <polygon points="250,162 242,157 242,167" fill="var(--muted)" />

    <text x="562" y="261" text-anchor="start" font-size="11" fill="var(--muted)">{t.locNote}</text>
    <line x1="550" y1="257" x2="560" y2="257" stroke="var(--muted)" stroke-width="1.6" />
    <polygon points="550,257 558,252 558,262" fill="var(--muted)" />

    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="369" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
