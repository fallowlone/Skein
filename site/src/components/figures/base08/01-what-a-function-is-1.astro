---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A function is a name for the address of its first instruction",
    headline: "A FUNCTION IS A LABEL FOR AN ADDRESS",
    sub: "greet() compiles to CALL 80",
    srcCol: "source code",
    srcName: "greet()",
    srcNote: "a human name",
    compiler: "compiler",
    memCol: "memory",
    cells: ["20 · CALL 80", "80 · MUL R1, 2", "81 · RET"],
    bodyTag: "body · 80–81",
    foot1: "names do not exist at runtime — the CPU knows addresses",
    foot2: "the compiler turns greet into the jump target 80",
    caption:
      "A function is a name for the address of its first instruction: the source name greet is translated by the compiler into the jump target 80, while the CPU only ever sees addresses — CALL 80 at 20, then the body MUL at 80 and RET at 81.",
  },
  ru: {
    svgTitle: "Функция — это имя адреса её первой инструкции",
    headline: "ФУНКЦИЯ — МЕТКА ДЛЯ АДРЕСА",
    sub: "greet() компилируется в CALL 80",
    srcCol: "исходный код",
    srcName: "greet()",
    srcNote: "имя для людей",
    compiler: "компилятор",
    memCol: "память",
    cells: ["20 · CALL 80", "80 · MUL R1, 2", "81 · RET"],
    bodyTag: "тело · 80–81",
    foot1: "в рантайме имён нет — CPU знает адреса",
    foot2: "компилятор превращает greet в цель перехода 80",
    caption:
      "Функция — это имя адреса её первой инструкции: имя greet из исходного кода компилятор превращает в цель перехода 80, а CPU видит только адреса — CALL 80 по адресу 20, затем тело: MUL на 80 и RET на 81.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="180" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.srcCol}</text>
    <text x="565" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.memCol}</text>

    <rect x="90" y="120" width="180" height="70" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="180" y="152" text-anchor="middle" font-size="16" fill="var(--ink)">{t.srcName}</text>
    <text x="180" y="172" text-anchor="middle" font-size="11" fill="var(--muted)">{t.srcNote}</text>

    <text x="362" y="145" text-anchor="middle" font-size="11" fill="var(--muted)">{t.compiler}</text>
    <line x1="270" y1="155" x2="451" y2="155" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="455,155 447,150 447,160" fill="var(--accent)" />

    {t.cells.map((c, i) => (
      <g>
        <rect x="455" y={120 + i * 75} width="220" height="54" fill="var(--card)" stroke={i === 0 ? "var(--ink)" : "var(--accent)"} stroke-width="2" />
        <text x="565" y={153 + i * 75} text-anchor="middle" font-size="13" fill="var(--ink)">{c}</text>
      </g>
    ))}

    <line x1="437" y1="195" x2="445" y2="195" stroke="var(--accent)" stroke-width="1.6" />
    <line x1="445" y1="195" x2="445" y2="324" stroke="var(--accent)" stroke-width="1.6" />
    <line x1="437" y1="324" x2="445" y2="324" stroke="var(--accent)" stroke-width="1.6" />
    <text x="430" y="263" text-anchor="end" font-size="11" fill="var(--muted)">{t.bodyTag}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
