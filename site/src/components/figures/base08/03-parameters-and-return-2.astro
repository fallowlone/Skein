---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The return value 8 travels out through a register after RET",
    headline: "RETURN HANDS ONE VALUE BACK",
    sub: "via a register · RET fires · frame popped",
    frame: "add's frame",
    paramsCell: "x = 3 · y = 5",
    resultCell: "result = 8",
    returnLine: "return result;",
    thenRet: "then RET",
    regLabel: "return register",
    regVal: "ret = 8",
    arrow1: "return 8",
    arrow2: "after RET",
    callerLabel: "caller (main)",
    totalVal: "total = 8",
    totalNote: "read from register",
    resume: "main resumes",
    foot1: "one value out · the frame is popped",
    foot2: "the register survives the frame",
    caption:
      "When add reaches return, the value 8 is placed in the return register and RET fires. The frame is popped, and the caller reads 8 from the register: total becomes 8 in main's frame. Parameters carry data in at CALL; the single return value carries data out at RET.",
  },
  ru: {
    svgTitle: "Возвращаемое значение 8 выходит через регистр после RET",
    headline: "RETURN ВОЗВРАЩАЕТ ОДНО ЗНАЧЕНИЕ",
    sub: "через регистр · RET · кадр снят",
    frame: "кадр add",
    paramsCell: "x = 3 · y = 5",
    resultCell: "result = 8",
    returnLine: "return result;",
    thenRet: "затем RET",
    regLabel: "регистр возврата",
    regVal: "ret = 8",
    arrow1: "return 8",
    arrow2: "после RET",
    callerLabel: "вызывающая сторона",
    totalVal: "total = 8",
    totalNote: "из регистра возврата",
    resume: "main возобновляется",
    foot1: "одно значение наружу · кадр снят",
    foot2: "регистр переживает кадр",
    caption:
      "Когда add достигает return, значение 8 помещается в регистр возврата и срабатывает RET. Кадр снимается, а вызывающая сторона читает 8 из регистра: total становится 8 в кадре main. Параметры несут данные внутрь на CALL; единственное возвращаемое значение несёт данные наружу на RET.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="160" y="88" text-anchor="middle" font-size="11" fill="var(--muted)">{t.frame}</text>
    <rect x="60" y="100" width="200" height="210" fill="none" stroke="var(--ink)" stroke-width="2" />
    <rect x="76" y="124" width="168" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="160" y="149" text-anchor="middle" font-size="13" fill="var(--ink)">{t.paramsCell}</text>
    <rect x="76" y="174" width="168" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="160" y="199" text-anchor="middle" font-size="13" fill="var(--ink)">{t.resultCell}</text>
    <text x="160" y="246" text-anchor="middle" font-size="11" fill="var(--muted)">{t.returnLine}</text>
    <text x="160" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.thenRet}</text>

    <text x="400" y="150" text-anchor="middle" font-size="11" fill="var(--muted)">{t.regLabel}</text>
    <rect x="330" y="160" width="140" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="201" text-anchor="middle" font-size="13" fill="var(--ink)">{t.regVal}</text>

    <text x="640" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.callerLabel}</text>
    <rect x="540" y="130" width="200" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="640" y="172" text-anchor="middle" font-size="13" fill="var(--ink)">{t.totalVal}</text>
    <text x="640" y="200" text-anchor="middle" font-size="11" fill="var(--muted)">{t.totalNote}</text>
    <text x="640" y="224" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resume}</text>

    <line x1="260" y1="195" x2="322" y2="195" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="330,195 322,190 322,200" fill="var(--accent)" />
    <text x="295" y="187" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow1}</text>
    <line x1="470" y1="195" x2="532" y2="195" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="540,195 532,190 532,200" fill="var(--accent)" />
    <text x="505" y="187" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow2}</text>

    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
