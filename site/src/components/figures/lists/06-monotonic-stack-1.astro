---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Monotonic increasing and decreasing stacks: push 2 pops 7, 5, 3; push 6 pops 5, 3, 1",
    headline: "POP VIOLATORS FIRST, THEN PUSH",
    sub: "after every push the stack is sorted again",
    rowInc: "increasing",
    rowDec: "decreasing",
    pushLabel: "push",
    popLabel: "pop",
    caption:
      "Push-with-pop keeps the invariant. Increasing: stack [1, 3, 5, 7], pushing 2 pops 7, 5, 3 first, giving [1, 2]. Decreasing: stack [7, 5, 3, 1], pushing 6 pops 5, 3, 1 first, giving [7, 6].",
  },
  ru: {
    svgTitle: "Монотонные возрастающий и убывающий стеки: добавление 2 удаляет 7, 5, 3; добавление 6 удаляет 5, 3, 1",
    headline: "СНАЧАЛА УДАЛИ НАРУШИТЕЛЕЙ, ПОТОМ ДОБАВЬ",
    sub: "после каждого добавления стек снова отсортирован",
    rowInc: "возрастающий",
    rowDec: "убывающий",
    pushLabel: "добавить",
    popLabel: "удалить",
    caption:
      "Добавление с удалением держит инвариант. Возрастающий: стек [1, 3, 5, 7], добавляя 2 сначала удаляем 7, 5, 3, получаем [1, 2]. Убывающий: стек [7, 5, 3, 1], добавляя 6 сначала удаляем 5, 3, 1, получаем [7, 6].",
  },
};

const t = dict[lang];

const incBefore = ["1", "3", "5", "7"];
const incAfter = ["1", "2"];
const decBefore = ["7", "5", "3", "1"];
const decAfter = ["7", "6"];
const incPopped = [1, 2, 3];
const decPopped = [1, 2, 3];

const cw = 52;
const ch = 48;
const step = 62;
const bx0 = 200;
const ax0 = 200;
const cellX0 = (i: number) => bx0 + i * step;
const cellX1 = (i: number) => ax0 + i * step;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="182" y="118" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowInc}</text>
    {incBefore.map((v, i) => (
      <g>
        <rect x={cellX0(i)} y="89" width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" stroke-dasharray={incPopped.indexOf(i) >= 0 ? "6 4" : undefined} opacity={incPopped.indexOf(i) >= 0 ? "0.55" : "1"} />
        <text x={cellX0(i) + cw / 2} y="118" text-anchor="middle" font-size="15" fill="var(--ink)" opacity={incPopped.indexOf(i) >= 0 ? "0.55" : "1"}>{v}</text>
      </g>
    ))}
    <text x="470" y="118" font-size="12" fill="var(--muted)">{t.popLabel} 7, 5, 3</text>
    <text x="470" y="186" font-size="12" fill="var(--accent)">{t.pushLabel} 2</text>
    {incAfter.map((v, i) => (
      <g>
        <rect x={cellX1(i)} y="157" width={cw} height={ch} fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={cellX1(i) + cw / 2} y="186" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <line x1="400" y1="137" x2="400" y2="152" stroke="var(--accent)" stroke-width="2" />
    <polygon points="393,152 407,152 400,162" fill="var(--accent)" />

    <text x="182" y="268" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowDec}</text>
    {decBefore.map((v, i) => (
      <g>
        <rect x={cellX0(i)} y="239" width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" stroke-dasharray={decPopped.indexOf(i) >= 0 ? "6 4" : undefined} opacity={decPopped.indexOf(i) >= 0 ? "0.55" : "1"} />
        <text x={cellX0(i) + cw / 2} y="268" text-anchor="middle" font-size="15" fill="var(--ink)" opacity={decPopped.indexOf(i) >= 0 ? "0.55" : "1"}>{v}</text>
      </g>
    ))}
    <text x="470" y="268" font-size="12" fill="var(--muted)">{t.popLabel} 5, 3, 1</text>
    <text x="470" y="336" font-size="12" fill="var(--accent)">{t.pushLabel} 6</text>
    {decAfter.map((v, i) => (
      <g>
        <rect x={cellX1(i)} y="307" width={cw} height={ch} fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={cellX1(i) + cw / 2} y="336" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <line x1="400" y1="287" x2="400" y2="302" stroke="var(--accent)" stroke-width="2" />
    <polygon points="393,302 407,302 400,312" fill="var(--accent)" />

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
