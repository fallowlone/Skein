---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Finding the middle of [10, 20, 30, 40, 50]: slow moves one step, fast moves two",
    headline: "FAST AT THE END, SLOW IN THE MIDDLE",
    sub: "both start at the head · slow +1, fast +2 per round",
    slow: "slow",
    fast: "fast",
    both: "slow + fast",
    slowMiddle: "slow · MIDDLE",
    rowStart: "start",
    row1: "after 1",
    row2: "after 2",
    exit: "loop exits: fast.next is null → slow = 30, the middle",
    caption:
      "Finding the middle of [10, 20, 30, 40, 50]: start slow=10, fast=10; after round 1 slow=20, fast=30; after round 2 slow=30, fast=50. The loop exits because fast.next is null, so slow stands on 30, the middle.",
  },
  ru: {
    svgTitle: "Поиск середины [10, 20, 30, 40, 50]: медленный идёт на шаг, быстрый — на два",
    headline: "БЫСТРЫЙ В КОНЦЕ — МЕДЛЕННЫЙ В СЕРЕДИНЕ",
    sub: "оба стартуют с головы · медленный +1, быстрый +2 за раунд",
    slow: "медленный",
    fast: "быстрый",
    both: "медленный + быстрый",
    slowMiddle: "медленный · СЕРЕДИНА",
    rowStart: "старт",
    row1: "после 1",
    row2: "после 2",
    exit: "выход из цикла: fast.next = null → slow = 30, середина",
    caption:
      "Поиск середины [10, 20, 30, 40, 50]: старт slow=10, fast=10; после раунда 1 slow=20, fast=30; после раунда 2 slow=30, fast=50. Цикл выходит, потому что fast.next — null, и slow стоит на 30, середине.",
  },
};

const t = dict[lang];

const cells = ["10", "20", "30", "40", "50"];
const links = [0, 1, 2, 3];
const rows = [
  { label: t.rowStart, slow: 0, fast: 0, y: 105, last: false },
  { label: t.row1, slow: 1, fast: 2, y: 190, last: false },
  { label: t.row2, slow: 2, fast: 4, y: 275, last: true },
];

const cw = 72;
const ch = 44;
const step = 104;
const cellX = (i: number) => 210 + i * step;
const cellCX = (i: number) => 210 + i * step + cw / 2;
const linkX = (i: number) => 210 + i * step + cw + 16;
const tri = (cx: number, y: number) => `${cx - 6},${y + 8} ${cx + 6},${y + 8} ${cx},${y}`;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {rows.map((row) => (
      <g>
        <text x="192" y={row.y + 29} text-anchor="end" font-size="13" fill="var(--ink)">{row.label}</text>
        {cells.map((v, i) => (
          <g>
            <rect x={cellX(i)} y={row.y} width={cw} height={ch} fill="var(--card)" stroke={row.last && row.slow === i ? "var(--accent)" : "var(--ink)"} stroke-width={row.last && row.slow === i ? "3" : "2"} />
            <text x={cellCX(i)} y={row.y + 29} text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
            {row.slow === i && row.fast === i ? (
              <g>
                <polygon points={tri(cellCX(i) - 12, row.y + 50)} fill="var(--accent)" />
                <polygon points={tri(cellCX(i) + 12, row.y + 50)} fill="var(--ink)" />
                <text x={cellCX(i)} y={row.y + 76} text-anchor="middle" font-size="12" fill="var(--accent)">{t.both}</text>
              </g>
            ) : row.slow === i ? (
              <g>
                <polygon points={tri(cellCX(i), row.y + 50)} fill="var(--accent)" />
                <text x={cellCX(i)} y={row.y + 76} text-anchor="middle" font-size="12" fill="var(--accent)">{row.last ? t.slowMiddle : t.slow}</text>
              </g>
            ) : row.fast === i ? (
              <g>
                <polygon points={tri(cellCX(i), row.y + 50)} fill="var(--ink)" />
                <text x={cellCX(i)} y={row.y + 76} text-anchor="middle" font-size="12" fill="var(--ink)">{t.fast}</text>
              </g>
            ) : null}
          </g>
        ))}
        {links.map((i) => (
          <text x={linkX(i)} y={row.y + 29} text-anchor="middle" font-size="14" fill="var(--muted)">→</text>
        ))}
      </g>
    ))}

    <text x="400" y="398" text-anchor="middle" font-size="13" fill="var(--muted)">{t.exit}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
