---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Next greater element of [2, 1, 2, 4, 3] is [4, 2, 4, -1, -1]",
    headline: "NEXT GREATER: EACH ITEM → FIRST LARGER RIGHT",
    sub: "no larger item to the right → -1",
    rowArr: "arr",
    rowAns: "answer",
    scanLabel: "scan right → left",
    caption:
      "Next greater element for arr = [2, 1, 2, 4, 3]: element 2 (index 0) → 4, element 1 (index 1) → 2, element 2 (index 2) → 4, element 4 (index 3) → -1, element 3 (index 4) → -1. Final result [4, 2, 4, -1, -1].",
  },
  ru: {
    svgTitle: "Следующий больший элемент для [2, 1, 2, 4, 3] это [4, 2, 4, -1, -1]",
    headline: "СЛЕДУЮЩИЙ БОЛЬШИЙ: ЭЛЕМЕНТ → ПЕРВЫЙ СПРАВА",
    sub: "нет большего элемента справа → -1",
    rowArr: "массив",
    rowAns: "ответ",
    scanLabel: "сканируем справа ← налево",
    caption:
      "Следующий больший элемент для arr = [2, 1, 2, 4, 3]: элемент 2 (индекс 0) → 4, элемент 1 (индекс 1) → 2, элемент 2 (индекс 2) → 4, элемент 4 (индекс 3) → -1, элемент 3 (индекс 4) → -1. Итоговый результат [4, 2, 4, -1, -1].",
  },
};

const t = dict[lang];

const arr = ["2", "1", "2", "4", "3"];
const ans = ["4", "2", "4", "-1", "-1"];
const idx = ["0", "1", "2", "3", "4"];
const links = [
  { from: 0, to: 3 },
  { from: 1, to: 2 },
  { from: 2, to: 3 },
];

const x0 = 190;
const cw = 64;
const ch = 50;
const step = 84;
const cellX = (i: number) => x0 + i * step;
const cellCX = (i: number) => x0 + i * step + cw / 2;
const linkY = 168;
const linkPath = (a: number, b: number) =>
  "M " + cellCX(a) + " " + linkY + " C " + cellCX(a) + " 205, " + cellCX(b) + " 205, " + cellCX(b) + " " + linkY;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="172" y="118" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowArr}</text>
    {arr.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="89" width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellCX(i)} y="118" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {idx.map((v, i) => (
      <text x={cellCX(i)} y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{v}</text>
    ))}

    {links.map((l) => (
      <path d={linkPath(l.from, l.to)} fill="none" stroke="var(--accent)" stroke-width="2" />
    ))}
    {links.map((l) => (
      <polygon points={(cellCX(l.to) - 6) + ",174 " + (cellCX(l.to) + 6) + ",174 " + cellCX(l.to) + ",166"} fill="var(--accent)" />
    ))}

    <text x="172" y="298" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowAns}</text>
    {ans.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="269" width={cw} height={ch} fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={cellCX(i)} y="298" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <line x1="560" y1="352" x2="252" y2="352" stroke="var(--muted)" stroke-width="2" />
    <polygon points="252,345 252,359 240,352" fill="var(--muted)" />
    <text x="400" y="378" text-anchor="middle" font-size="13" fill="var(--muted)">{t.scanLabel}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
