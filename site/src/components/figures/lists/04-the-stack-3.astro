---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: 'Trace of "{[]}": push open brackets, pop and match closing ones',
    headline: '"{[]}" IS BALANCED',
    sub: "push opening · pop + match closing · stack empty at end",
    results: ["stack: [{]", "stack: [{, []", "`[` matches `]`", "`{` matches `}`"],
    emptyWord: "empty",
    verdict: "end: stack empty → balanced!",
    note: '"({[}])" fails: `}` meets `[` — wrong bracket → false',
    caption:
      'Trace of "{[]}": push `{`, push `[`, then `]` pops `[` (match) and `}` pops `{` (match). The stack ends empty, so the string is balanced. In "{[}]" the `}` meets `[` instead — wrong bracket, return false.',
  },
  ru: {
    svgTitle: 'Трассировка "{[]}": открывающие — push, закрывающие — pop и совпадение',
    headline: '"{[]}" СБАЛАНСИРОВАНА',
    sub: "открывающую — push · закрывающую — pop + совпадение · в конце пусто",
    results: ["стек: [{]", "стек: [{, []", "`[` совпадает с `]`", "`{` совпадает с `}`"],
    emptyWord: "пусто",
    verdict: "конец: стек пуст → сбалансирована!",
    note: '"({[}])" не проходит: `}` встречает `[` — не та скобка → false',
    caption:
      'Трассировка "{[]}": push `{`, push `[`, потом `]` pop-ает `[` (совпадение) и `}` pop-ает `{` (совпадение). Стек в конце пуст, значит строка сбалансирована. В "{[}]" `}` встречает `[` — не та скобка, возврати false.',
  },
};

const t = dict[lang];

const chars = ["{", "[", "]", "}"];
const actions = ["push `{`", "push `[`", "pop `[` ✓", "pop `{` ✓"];
const stacks: string[][] = [["{"], ["{", "["], ["{"], []];

const colX = [95, 265, 435, 605];
const cw = 120;
const ch = 40;
const baseY = 300;
const cellY = (row: number) => baseY - (row + 1) * ch;

const placed = stacks.map((cells, c) =>
  cells.map((v, r) => ({ v, x: colX[c], y: cellY(r) }))
);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {colX.map((x, c) => (
      <text x={x + cw / 2} y="114" text-anchor="middle" font-size="22" fill="var(--ink)">{chars[c]}</text>
    ))}
    {colX.map((x, c) => (
      <text x={x + cw / 2} y="140" text-anchor="middle" font-size="13" fill="var(--accent)">{actions[c]}</text>
    ))}

    {placed.map((cells) => (
      <g>
        {cells.map((cell) => (
          <g>
            <rect x={cell.x} y={cell.y} width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
            <text x={cell.x + cw / 2} y={cell.y + ch / 2 + 7} text-anchor="middle" font-size="17" fill="var(--ink)">{cell.v}</text>
          </g>
        ))}
      </g>
    ))}

    <rect x={colX[3]} y={cellY(0)} width={cw} height={ch} fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x={colX[3] + cw / 2} y={cellY(0) + ch / 2 + 5} text-anchor="middle" font-size="13" fill="var(--muted)">{t.emptyWord}</text>

    {colX.map((x, c) => (
      <text x={x + cw / 2} y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.results[c]}</text>
    ))}

    <text x="400" y="370" text-anchor="middle" font-size="14" fill="var(--ink)">{t.verdict}</text>
    <text x="400" y="395" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
