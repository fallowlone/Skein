---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Removing index 0 from [10, 20, 30, 40] forces reindexing all remaining elements",
    headline: "WHY .shift() IS O(n): REINDEX ALL",
    sub: "remove index 0 (10) · every remaining element moves down one index",
    beforeLabel: "before",
    afterLabel: "after",
    removeLabel: "remove 10",
    reindexLabel: "reindex all!",
    note: "n dequeues cost O(n²) total — never .shift() in a real queue",
    caption:
      "Before: [10, 20, 30, 40] at indices 0, 1, 2, 3. Removing index 0 (10) leaves [20, 30, 40] at indices 0, 1, 2 — the language reindexes every remaining element, which is O(n) work.",
  },
  ru: {
    svgTitle: "Удаление индекса 0 из [10, 20, 30, 40] вынуждает переиндексировать все оставшиеся элементы",
    headline: "ПОЧЕМУ .shift() ЭТО O(n): ПЕРЕИНДЕКСАЦИЯ",
    sub: "удали индекс 0 (10) · каждый оставшийся элемент сдвигается на индекс вниз",
    beforeLabel: "до",
    afterLabel: "после",
    removeLabel: "удали 10",
    reindexLabel: "переиндексируй все!",
    note: "n dequeue стоят O(n²) итого — никогда .shift() в настоящей очереди",
    caption:
      "До: [10, 20, 30, 40] на индексах 0, 1, 2, 3. Удаление индекса 0 (10) даёт [20, 30, 40] на индексах 0, 1, 2 — язык переиндексирует каждый оставшийся элемент, это O(n) работы.",
  },
};

const t = dict[lang];

const before = ["10", "20", "30", "40"];
const after = ["20", "30", "40"];
const shifts = [1, 2, 3];

const x0 = 252;
const cw = 56;
const ch = 48;
const step = 72;
const beforeY = 116;
const afterY = 262;
const cellX = (i: number) => x0 + i * step;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="234" y={beforeY + 30} text-anchor="end" font-size="13" fill="var(--ink)">{t.beforeLabel}</text>
    {before.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={beforeY} width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" stroke-dasharray={i === 0 ? "6 4" : "none"} opacity={i === 0 ? 0.55 : 1} />
        <text x={cellX(i) + cw / 2} y={beforeY + 30} text-anchor="middle" font-size="15" fill="var(--ink)" opacity={i === 0 ? 0.55 : 1}>{v}</text>
        <text x={cellX(i) + cw / 2} y={beforeY - 8} text-anchor="middle" font-size="12" fill="var(--muted)">{i}</text>
      </g>
    ))}
    <text x={cellX(0) + cw / 2} y={beforeY + ch + 22} text-anchor="middle" font-size="12" fill="var(--accent)">{t.removeLabel}</text>

    {shifts.map((i) => (
      <g>
        <line x1={cellX(i) + cw / 2} y1={beforeY + ch + 34} x2={cellX(i) + cw / 2 - step} y2={afterY - 24} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${cellX(i) + cw / 2 - step - 7},${afterY - 24} ${cellX(i) + cw / 2 - step + 7},${afterY - 24} ${cellX(i) + cw / 2 - step},${afterY - 12}`} fill="var(--accent)" />
      </g>
    ))}
    <text x={cellX(3) + cw + 16} y="222" text-anchor="start" font-size="12" fill="var(--accent)">{t.reindexLabel}</text>

    <text x="234" y={afterY + 30} text-anchor="end" font-size="13" fill="var(--ink)">{t.afterLabel}</text>
    {after.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={afterY} width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y={afterY + 30} text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
        <text x={cellX(i) + cw / 2} y={afterY + ch + 22} text-anchor="middle" font-size="12" fill="var(--muted)">{i}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
