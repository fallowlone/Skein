---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Push 10, push 20, push 30, then pop: only the top moves",
    headline: "PUSH 10 · PUSH 20 · PUSH 30 · POP",
    sub: "only the top moves — the end of the array is the top",
    colLabels: ["push(10)", "push(20)", "push(30)", "pop → 30"],
    top: "◀ top",
    bottom: "bottom",
    note: "30 went on last — 30 comes off first",
    caption:
      "Push 10, push 20, push 30, then pop: the stack grows [10] → [10, 20] → [10, 20, 30], and pop returns 30, leaving [10, 20]. Only the top moves, so push, pop and peek are all O(1).",
  },
  ru: {
    svgTitle: "Push 10, push 20, push 30, потом pop: движется только верх",
    headline: "PUSH 10 · PUSH 20 · PUSH 30 · POP",
    sub: "движется только верх — конец массива это верх",
    colLabels: ["push(10)", "push(20)", "push(30)", "pop → 30"],
    top: "◀ верх",
    bottom: "низ",
    note: "30 лёг последним — 30 снимается первым",
    caption:
      "Push 10, push 20, push 30, потом pop: стек растёт [10] → [10, 20] → [10, 20, 30], а pop возвращает 30, оставляя [10, 20]. Движется только верх, поэтому push, pop и peek все O(1).",
  },
};

const t = dict[lang];

const stacks: string[][] = [["10"], ["10", "20"], ["10", "20", "30"], ["10", "20"]];
const states = ["[10]", "[10, 20]", "[10, 20, 30]", "[10, 20]"];

const colX = [95, 265, 435, 605];
const cw = 120;
const ch = 42;
const baseY = 320;
const cellY = (row: number) => baseY - (row + 1) * ch;
const topY = stacks.map((cells) => cellY(cells.length - 1) + ch / 2 + 5);

const placed = stacks.map((cells, c) =>
  cells.map((v, r) => ({ v, x: colX[c], y: cellY(r) }))
);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {colX.map((x, c) => (
      <text x={x + cw / 2} y="108" text-anchor="middle" font-size="15" fill="var(--accent)">{t.colLabels[c]}</text>
    ))}

    {placed.map((cells) => (
      <g>
        {cells.map((cell) => (
          <g>
            <rect x={cell.x} y={cell.y} width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
            <text x={cell.x + cw / 2} y={cell.y + ch / 2 + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{cell.v}</text>
          </g>
        ))}
      </g>
    ))}

    {colX.map((x, c) => (
      <text x={x + cw + 8} y={topY[c]} font-size="12" fill="var(--accent)">{t.top}</text>
    ))}

    <text x="83" y="305" text-anchor="end" font-size="12" fill="var(--muted)">{t.bottom}</text>

    {colX.map((x, c) => (
      <text x={x + cw / 2} y="350" text-anchor="middle" font-size="13" fill="var(--muted)">{states[c]}</text>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
