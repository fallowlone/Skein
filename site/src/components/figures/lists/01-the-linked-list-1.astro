---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Linked list of three nodes: head points to 10, 20, 30, last next is null",
    headline: "A NODE HOLDS A VALUE + A POINTER",
    sub: "head starts the walk · read value, follow next, repeat · last next = null",
    head: "head",
    step1: "read 10 → follow",
    step2: "read 20 → follow",
    step3: "read 30 → stop",
    nodeNote: "each [ value | next → ] is one node",
    listNote: "the list holds [10, 20, 30]",
    caption:
      "A linked list is a sequence of nodes: head → [10 | next] → [20 | next] → [30 | next → null]. Each node holds a value and a pointer to the next node; the last node's next is null, meaning there is no next node.",
  },
  ru: {
    svgTitle: "Связный список из трёх узлов: head указывает на 10, 20, 30, последний next — null",
    headline: "УЗЕЛ ДЕРЖИТ ЗНАЧЕНИЕ + УКАЗАТЕЛЬ",
    sub: "head начинает обход · прочитай значение, иди по next, повтори · последний next = null",
    head: "head",
    step1: "прочитай 10 → иди",
    step2: "прочитай 20 → иди",
    step3: "прочитай 30 → стоп",
    nodeNote: "каждый [ value | next → ] — это один узел",
    listNote: "список держит [10, 20, 30]",
    caption:
      "Связный список — это последовательность узлов: head → [10 | next] → [20 | next] → [30 | next → null]. Каждый узел держит значение и указатель на следующий узел; next последнего узла — null, то есть следующего узла нет.",
  },
};

const t = dict[lang];

const nodes = [
  { value: "10", next: "next →" },
  { value: "20", next: "next →" },
  { value: "30", next: "next → null" },
];
const steps = [t.step1, t.step2, t.step3];
const links = [0, 1];
const boxY = 150;
const boxH = 60;
const midY = boxY + boxH / 2;
const nodeX = (i: number) => 93 + i * 220;
const vw = 64;
const nw = 110;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="50" y={midY + 5} text-anchor="end" font-size="15" fill="var(--accent)">{t.head}</text>
    <line x1="56" y1={midY} x2="87" y2={midY} stroke="var(--accent)" stroke-width="2" />
    <polygon points="87,180 77,175 77,185" fill="var(--accent)" />

    {nodes.map((n, i) => (
      <g>
        <rect x={nodeX(i)} y={boxY} width={vw} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={nodeX(i) + vw / 2} y={midY + 6} text-anchor="middle" font-size="17" fill="var(--ink)">{n.value}</text>
        <rect x={nodeX(i) + vw} y={boxY} width={nw} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={nodeX(i) + vw + nw / 2} y={midY + 5} text-anchor="middle" font-size="13" fill="var(--muted)">{n.next}</text>
        <text x={nodeX(i) + (vw + nw) / 2} y={boxY + boxH + 30} text-anchor="middle" font-size="13" fill="var(--ink)">{steps[i]}</text>
      </g>
    ))}
    {links.map((i) => (
      <g>
        <line x1={nodeX(i) + vw + nw} y1={midY} x2={nodeX(i + 1) - 6} y2={midY} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${nodeX(i + 1) - 6},${midY} ${nodeX(i + 1) - 16},${midY - 5} ${nodeX(i + 1) - 16},${midY + 5}`} fill="var(--accent)" />
      </g>
    ))}

    <text x="400" y="300" text-anchor="middle" font-size="14" fill="var(--ink)">{t.nodeNote}</text>
    <text x="400" y="330" text-anchor="middle" font-size="14" fill="var(--accent)">{t.listNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
