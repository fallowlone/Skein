---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Reversing 10 to 20 to 30 into 30 to 20 to 10 by flipping every pointer",
    headline: "REVERSAL: FLIP EVERY LINK BACKWARD",
    sub: "save next · rewire · advance · O(n) time · O(1) space",
    origLabel: "Start: [10] → [20] → [30] → null",
    step0cap: "Step 0: prev = null, cur = 10 — save nxt = 20 first",
    revLabel: "Done: [30] → [20] → [10] → null",
    headTag: "prev = 30 · the new head",
    note: "golden rule: save next before you overwrite it, or you lose the list",
    caption:
      "Reversing [10] → [20] → [30] → null into [30] → [20] → [10] → null: at each node save nxt first, flip cur.next backward to prev, then slide both pointers forward until cur is null and prev (30) is the new head. One pass, O(n) time and O(1) space — no nodes allocated or freed, only pointers change.",
  },
  ru: {
    svgTitle: "Разворот 10, 20, 30 в 30, 20, 10 переворотом каждого указателя",
    headline: "РАЗВОРОТ: ПЕРЕВЕРНИ КАЖДУЮ ССЫЛКУ НАЗАД",
    sub: "сохрани next · перенаправь · продвинь · O(n) времени · O(1) памяти",
    origLabel: "Начало: [10] → [20] → [30] → null",
    step0cap: "Шаг 0: prev = null, cur = 10 — сначала сохрани nxt = 20",
    revLabel: "Готово: [30] → [20] → [10] → null",
    headTag: "prev = 30 · новый head",
    note: "золотое правило: сохрани next до перезаписи, иначе потеряешь список",
    caption:
      "Разворот [10] → [20] → [30] → null в [30] → [20] → [10] → null: в каждом узле сначала сохрани nxt, переверни cur.next назад на prev, потом сдвинь оба указателя вперёд, пока cur не станет null, а prev (30) — новым head. Один проход, O(n) времени и O(1) памяти — узлы не выделяются и не освобождаются, меняются только указатели.",
  },
};

const t = dict[lang];

const orig = ["10", "20", "30", "null"];
const rev = ["30", "20", "10", "null"];
const nx = [130, 280, 430, 580];
const chainArrows = [
  { x1: 204, x2: 276 },
  { x1: 354, x2: 426 },
  { x1: 504, x2: 576 },
];
const oMid = 128;
const rMid = 314;
const codeLines = [
  "const next = current.next;",
  "current.next = prev;",
  "prev = current;  current = next;",
];
const codeY = [205, 225, 245];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="92" text-anchor="middle" font-size="13" fill="var(--ink)">{t.origLabel}</text>
    {orig.map((v, i) => (
      <g>
        <rect x={nx[i]} y="104" width="70" height="48" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={nx[i] + 35} y="133" text-anchor="middle" font-size={v === "null" ? 13 : 15} fill="var(--ink)">{v}</text>
      </g>
    ))}
    {chainArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={oMid} x2={a.x2} y2={oMid} stroke="var(--ink)" stroke-width="2" />
        <polygon points={`${a.x2},${oMid - 5} ${a.x2},${oMid + 5} ${a.x2 + 8},${oMid}`} fill="var(--ink)" />
      </g>
    ))}
    <text x="400" y="172" text-anchor="middle" font-size="12" fill="var(--accent)">{t.step0cap}</text>

    {codeLines.map((ln, i) => (
      <text x="400" y={codeY[i]} text-anchor="middle" font-size="13" fill="var(--ink)">{ln}</text>
    ))}

    <text x="400" y="278" text-anchor="middle" font-size="13" fill="var(--ink)">{t.revLabel}</text>
    {rev.map((v, i) => (
      <g>
        <rect x={nx[i]} y="290" width="70" height="48" fill="var(--card)" stroke={i === 0 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={nx[i] + 35} y="319" text-anchor="middle" font-size={v === "null" ? 13 : 15} fill="var(--ink)">{v}</text>
      </g>
    ))}
    {chainArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={rMid} x2={a.x2} y2={rMid} stroke="var(--ink)" stroke-width="2" />
        <polygon points={`${a.x2},${rMid - 5} ${a.x2},${rMid + 5} ${a.x2 + 8},${rMid}`} fill="var(--ink)" />
      </g>
    ))}
    <text x="165" y="358" text-anchor="middle" font-size="12" fill="var(--accent)">{t.headTag}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
