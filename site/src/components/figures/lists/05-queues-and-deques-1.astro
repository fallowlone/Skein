---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Queue of 10, 20, 30, 40: enqueue at the rear, dequeue from the front",
    headline: "FIFO: FIRST IN IS FIRST OUT",
    sub: "enqueue adds at the rear · dequeue removes from the front",
    frontLabel: "FRONT (dequeue)",
    rearLabel: "REAR (enqueue)",
    leaveFirst: "10 entered first → 10 leaves first",
    dequeueLabel: "dequeue → 10 · O(1)",
    enqueueLabel: "enqueue · O(1)",
    note: "the mirror image of a stack: opposite ends decide the order",
    caption:
      "FIFO: enqueue adds 10, 20, 30, 40 at the rear; dequeue removes from the front, so 10 — which entered first — leaves first. Both operations are O(1) with a proper implementation.",
  },
  ru: {
    svgTitle: "Очередь 10, 20, 30, 40: enqueue на спину, dequeue с передней",
    headline: "FIFO: ПЕРВЫЙ ВОШЁЛ — ПЕРВЫЙ ВЫШЕЛ",
    sub: "enqueue добавляет на спину · dequeue забирает с передней",
    frontLabel: "ПЕРЕДНЯЯ (dequeue)",
    rearLabel: "СПИНА (enqueue)",
    leaveFirst: "10 вошло первым → 10 выходит первым",
    dequeueLabel: "dequeue → 10 · O(1)",
    enqueueLabel: "enqueue · O(1)",
    note: "зеркало стека: порядок решают разные концы",
    caption:
      "FIFO: enqueue добавляет 10, 20, 30, 40 на спину; dequeue забирает с передней, поэтому 10 — вошедшее первым — выходит первым. Обе операции — O(1) при правильной реализации.",
  },
};

const t = dict[lang];

const cells = ["10", "20", "30", "40"];

const x0 = 272;
const cw = 52;
const ch = 56;
const step = 64;
const rowY = 168;
const cellX = (i: number) => x0 + i * step;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={cellX(0) + cw / 2} y="132" text-anchor="middle" font-size="13" fill="var(--accent)">{t.frontLabel}</text>
    <text x={cellX(3) + cw / 2} y="132" text-anchor="middle" font-size="13" fill="var(--accent)">{t.rearLabel}</text>

    {cells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={rowY} width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y={rowY + 36} text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <line x1={cellX(0) - 14} y1={rowY + ch / 2} x2={cellX(0) - 84} y2={rowY + ch / 2} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${cellX(0) - 84},${rowY + ch / 2 - 7} ${cellX(0) - 84},${rowY + ch / 2 + 7} ${cellX(0) - 96},${rowY + ch / 2}`} fill="var(--accent)" />
    <text x={cellX(0) - 102} y={rowY + ch / 2 - 12} text-anchor="end" font-size="12" fill="var(--ink)">{t.dequeueLabel}</text>

    <line x1={cellX(3) + cw + 84} y1={rowY + ch / 2} x2={cellX(3) + cw + 14} y2={rowY + ch / 2} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${cellX(3) + cw + 14},${rowY + ch / 2 - 7} ${cellX(3) + cw + 14},${rowY + ch / 2 + 7} ${cellX(3) + cw + 2},${rowY + ch / 2}`} fill="var(--accent)" />
    <text x={cellX(3) + cw + 90} y={rowY + ch / 2 - 12} text-anchor="start" font-size="12" fill="var(--ink)">{t.enqueueLabel}</text>

    <text x="400" y="292" text-anchor="middle" font-size="15" fill="var(--ink)">{t.leaveFirst}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
