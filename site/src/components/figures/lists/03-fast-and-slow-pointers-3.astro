---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Why slow and fast must meet inside a cycle, and the O(1) space advantage over a hash set",
    headline: "GAP −1 PER ROUND → THEY MUST MEET",
    sub: "fast gains one step each round · in a finite cycle the gap hits 0",
    panelWhy: "WHY THEY MUST MEET",
    lines: [
      "cycle length = c",
      "slow: +1 node per round",
      "fast: +2 nodes per round",
      "gap shrinks by 1 per round",
      "gap = 0 → meet inside the cycle",
    ],
    panelCost: "SAME TIME, NO EXTRA SPACE",
    colMethod: "method",
    colTime: "time",
    colSpace: "space",
    rowTwo: "two pointers",
    rowHash: "hash set",
    noSet: "two pointers: no hash set, no array",
    win: "same O(n) time, O(1) not O(n) space",
    warn: "fast must move exactly 2 steps — 3 or 4 may skip over slow",
    note: "detects that a cycle exists, not where it starts — the start needs a second pass",
    caption:
      "When slow enters a cycle of length c, fast is already inside and gains one step per round, so the gap shrinks by 1 until it reaches 0 and they meet — always inside the cycle. Middle-finding and cycle detection both cost O(n) time and O(1) space with two pointers, versus O(n) space for a hash set of visited nodes. Fast must move exactly 2 steps, or it may skip over slow.",
  },
  ru: {
    svgTitle: "Почему медленный и быстрый обязаны встретиться внутри цикла и выигрыш O(1) памяти против hash set",
    headline: "РАЗРЫВ −1 ЗА РАУНД → ВСТРЕЧА НЕИЗБЕЖНА",
    sub: "быстрый нагоняет шаг каждый раунд · в конечном цикле разрыв станет 0",
    panelWhy: "ПОЧЕМУ ОНИ ВСТРЕТЯТСЯ",
    lines: [
      "длина цикла = c",
      "медленный: +1 узел за раунд",
      "быстрый: +2 узла за раунд",
      "разрыв тает на 1 за раунд",
      "разрыв = 0 → встреча внутри цикла",
    ],
    panelCost: "ТО ЖЕ ВРЕМЯ, БЕЗ ЛИШНЕЙ ПАМЯТИ",
    colMethod: "метод",
    colTime: "время",
    colSpace: "память",
    rowTwo: "два указателя",
    rowHash: "hash set",
    noSet: "два указателя: ни hash set, ни массива",
    win: "то же O(n) время, но O(1) вместо O(n) памяти",
    warn: "быстрый идёт ровно на 2 шага — 3 или 4 могут перепрыгнуть медленного",
    note: "метод фиксирует сам факт цикла, а не его начало — для начала нужен второй проход",
    caption:
      "Когда медленный входит в цикл длины c, быстрый уже внутри и нагоняет шаг за раунд, так что разрыв тает на 1, пока не станет 0, и они встречаются — всегда внутри цикла. Поиск середины и обнаружение цикла стоят O(n) времени и O(1) памяти с двумя указателями против O(n) памяти под hash set посещённых узлов. Быстрый идёт ровно на 2 шага, иначе может перепрыгнуть медленного.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="60" y="108" font-family="var(--font-display)" font-size="16" fill="var(--ink)">{t.panelWhy}</text>
    {t.lines.map((line, i) => (
      <g>
        <rect x="60" y={130 + i * 38} width="10" height="10" fill="var(--accent)" />
        <text x="80" y={139 + i * 38} font-size="13" fill="var(--ink)">{line}</text>
      </g>
    ))}

    <text x="450" y="108" font-family="var(--font-display)" font-size="16" fill="var(--ink)">{t.panelCost}</text>
    <text x="462" y="140" font-size="12" fill="var(--muted)">{t.colMethod}</text>
    <text x="635" y="140" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colTime}</text>
    <text x="705" y="140" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colSpace}</text>
    <rect x="450" y="150" width="290" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="462" y="176" font-size="13" fill="var(--ink)">{t.rowTwo}</text>
    <text x="635" y="176" text-anchor="middle" font-size="13" fill="var(--ink)">O(n)</text>
    <text x="705" y="176" text-anchor="middle" font-size="13" fill="var(--accent)">O(1)</text>
    <rect x="450" y="198" width="290" height="40" fill="none" stroke="var(--ink)" stroke-width="1" opacity="0.6" />
    <text x="462" y="224" font-size="13" fill="var(--ink)">{t.rowHash}</text>
    <text x="635" y="224" text-anchor="middle" font-size="13" fill="var(--ink)">O(n)</text>
    <text x="705" y="224" text-anchor="middle" font-size="13" fill="var(--ink)">O(n)</text>
    <text x="450" y="266" font-size="12" fill="var(--muted)">{t.noSet}</text>
    <text x="450" y="290" font-size="12" fill="var(--muted)">{t.win}</text>

    <line x1="60" y1="322" x2="740" y2="322" stroke="var(--muted)" stroke-width="1" opacity="0.5" />
    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--accent)">{t.warn}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
