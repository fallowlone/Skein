---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Inserting node 15 between nodes 10 and 20 by updating two pointers",
    headline: "INSERTION: THE SPLICE OPERATION",
    sub: "insert 15 between 10 and 20 · two pointer updates · O(1)",
    beforeLabel: "Before: [10] → [20] → [30]",
    step1: "1. 15.next = 20 — new node points at the old successor",
    step2: "2. 10.next = 15 — given node points at the new node",
    afterLabel: "After: [10] → [15] → [20] → [30]",
    newTag: "↑ newly inserted",
    note: "chain rebuilt: 10 → 15 → 20 · reaching position i costs O(i)",
    caption:
      "Inserting 15 between 10 and 20: set 15.next to the old successor (20), then set 10.next to 15, rebuilding the chain as 10 → 15 → 20. Only pointers change, so it is O(1) — but you need a reference to the node before the insertion point, and traversing to position i costs O(i).",
  },
  ru: {
    svgTitle: "Вставка узла 15 между узлами 10 и 20 обновлением двух указателей",
    headline: "ВСТАВКА: ОПЕРАЦИЯ SPLICE",
    sub: "вставь 15 между 10 и 20 · два обновления указателей · O(1)",
    beforeLabel: "Раньше: [10] → [20] → [30]",
    step1: "1. 15.next = 20 — новый узел указывает на старого наследника",
    step2: "2. 10.next = 15 — данный узел указывает на новый узел",
    afterLabel: "После: [10] → [15] → [20] → [30]",
    newTag: "↑ вновь вставлен",
    note: "цепь пересобрана: 10 → 15 → 20 · проход на позицию i стоит O(i)",
    caption:
      "Вставка 15 между 10 и 20: установи 15.next на старого наследника (20), потом установи 10.next на 15, пересобрав цепь как 10 → 15 → 20. Меняются только указатели, поэтому это O(1) — но нужна ссылка на узел перед точкой вставки, а проход на позицию i стоит O(i).",
  },
};

const t = dict[lang];

const before = ["10", "20", "30"];
const after = ["10", "15", "20", "30"];
const bx = [235, 385, 535];
const ax = [115, 265, 415, 565];
const bw = 70;
const bh = 48;
const bArrows = [
  { x1: 309, x2: 381 },
  { x1: 459, x2: 531 },
];
const aArrows = [
  { x1: 189, x2: 261, c: "var(--accent)" },
  { x1: 339, x2: 411, c: "var(--accent)" },
  { x1: 489, x2: 561, c: "var(--ink)" },
];
const bMid = 132;
const aMid = 272;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="92" text-anchor="middle" font-size="13" fill="var(--ink)">{t.beforeLabel}</text>
    {before.map((v, i) => (
      <g>
        <rect x={bx[i]} y="108" width={bw} height={bh} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={bx[i] + bw / 2} y="137" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {bArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={bMid} x2={a.x2} y2={bMid} stroke="var(--ink)" stroke-width="2" />
        <polygon points={`${a.x2},${bMid - 5} ${a.x2},${bMid + 5} ${a.x2 + 8},${bMid}`} fill="var(--ink)" />
      </g>
    ))}

    <text x="400" y="196" text-anchor="middle" font-size="13" fill="var(--ink)">{t.step1}</text>
    <text x="400" y="217" text-anchor="middle" font-size="13" fill="var(--ink)">{t.step2}</text>

    <text x="400" y="240" text-anchor="middle" font-size="13" fill="var(--ink)">{t.afterLabel}</text>
    {after.map((v, i) => (
      <g>
        <rect x={ax[i]} y="248" width={bw} height={bh} fill="var(--card)" stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={ax[i] + bw / 2} y="277" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {aArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={aMid} x2={a.x2} y2={aMid} stroke={a.c} stroke-width="2" />
        <polygon points={`${a.x2},${aMid - 5} ${a.x2},${aMid + 5} ${a.x2 + 8},${aMid}`} fill={a.c} />
      </g>
    ))}
    <text x="300" y="322" text-anchor="middle" font-size="12" fill="var(--accent)">{t.newTag}</text>

    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
