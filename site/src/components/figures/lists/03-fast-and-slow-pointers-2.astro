---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Cycle detection: [1, 2, 3, 4, 5] with 5 looping back to 3; slow and fast meet at 4",
    headline: "ON A LOOP, FAST MUST LAP SLOW",
    sub: "[1] → [2] → [3] → [4] → [5] → [3] · slow +1, fast +2",
    loopsBack: "loops back to 3",
    colRound: "round",
    colSlow: "slow",
    colFast: "fast",
    rowStart: "start",
    iter: "iter",
    slowTag: "slow",
    fastTag: "fast",
    match: "iter 3: slow = fast = 4 → cycle detected",
    note: "meet on the same node ⇒ cycle · reach null ⇒ no cycle",
    caption:
      "Cycle [1] → [2] → [3] → [4] → [5] → [3]: start slow=1, fast=1; iter 1 slow=2, fast=3; iter 2 slow=3, fast=5; iter 3 slow=4, fast=4 — fast caught slow, so a cycle exists. If fast ever reached null instead, there would be no cycle.",
  },
  ru: {
    svgTitle: "Обнаружение цикла: [1, 2, 3, 4, 5], где 5 ссылается назад на 3; медленный и быстрый встречаются на 4",
    headline: "НА ПЕТЛЕ БЫСТРЫЙ ОБЯЗАН ДОГНАТЬ МЕДЛЕННОГО",
    sub: "[1] → [2] → [3] → [4] → [5] → [3] · медленный +1, быстрый +2",
    loopsBack: "назад к 3",
    colRound: "раунд",
    colSlow: "медленный",
    colFast: "быстрый",
    rowStart: "старт",
    iter: "итер",
    slowTag: "slow",
    fastTag: "fast",
    match: "итер 3: slow = fast = 4 → цикл обнаружен",
    note: "встреча на одном узле ⇒ цикл · достижение null ⇒ нет цикла",
    caption:
      "Цикл [1] → [2] → [3] → [4] → [5] → [3]: старт slow=1, fast=1; итер 1 slow=2, fast=3; итер 2 slow=3, fast=5; итер 3 slow=4, fast=4 — быстрый поймал медленного, значит цикл есть. Если бы быстрый достиг null, цикла бы не было.",
  },
};

const t = dict[lang];

const nodes = ["1", "2", "3", "4", "5"];
const links = [0, 1, 2, 3];
const trace = [
  { r: 0, slow: "1", fast: "1" },
  { r: 1, slow: "2", fast: "3" },
  { r: 2, slow: "3", fast: "5" },
  { r: 3, slow: "4", fast: "4" },
];

const nw = 80;
const nh = 46;
const ny = 112;
const nodeX = (i: number) => 100 + i * 130;
const nodeCX = (i: number) => 100 + i * 130 + nw / 2;
const rowY = (i: number) => 252 + i * 27;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {nodes.map((v, i) => (
      <g>
        <rect x={nodeX(i)} y={ny} width={nw} height={nh} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={nodeCX(i)} y={ny + 30} text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {links.map((i) => (
      <g>
        <line x1={nodeX(i) + nw + 6} y1={ny + 23} x2={nodeX(i + 1) - 14} y2={ny + 23} stroke="var(--ink)" stroke-width="2" />
        <polygon points={`${nodeX(i + 1) - 14},${ny + 17} ${nodeX(i + 1) - 14},${ny + 29} ${nodeX(i + 1) - 4},${ny + 23}`} fill="var(--ink)" />
      </g>
    ))}
    <path d="M 660 158 L 660 196 L 400 196 L 400 170" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 4" />
    <polygon points="392,170 408,170 400,158" fill="var(--accent)" />
    <text x="530" y="214" text-anchor="middle" font-size="12" fill="var(--accent)">{t.loopsBack}</text>

    <text x="260" y="242" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colRound}</text>
    <text x="410" y="242" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colSlow}</text>
    <text x="550" y="242" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colFast}</text>
    {trace.map((row, i) => (
      <g>
        <rect x="160" y={rowY(i)} width="480" height="23" fill={i === 3 ? "var(--card)" : "none"} stroke={i === 3 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 3 ? "2" : "1"} opacity={i === 3 ? "1" : "0.45"} />
        <text x="260" y={rowY(i) + 16} text-anchor="middle" font-size="13" fill="var(--ink)">{row.r === 0 ? t.rowStart : t.iter + " " + row.r}</text>
        <text x="410" y={rowY(i) + 16} text-anchor="middle" font-size="13" fill="var(--ink)">{t.slowTag + "=" + row.slow}</text>
        <text x="550" y={rowY(i) + 16} text-anchor="middle" font-size="13" fill="var(--ink)">{t.fastTag + "=" + row.fast}</text>
      </g>
    ))}

    <text x="400" y="384" text-anchor="middle" font-size="13" fill="var(--accent)">{t.match}</text>
    <text x="400" y="406" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
