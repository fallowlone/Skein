---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Monotonic stack is O(n) because each element is pushed and popped at most once, versus O(n squared) naive",
    headline: "PUSHED ONCE + POPPED ONCE = O(n)",
    sub: "pushes + pops ≤ 2n vs naive n × n = O(n²)",
    colApproach: "approach",
    colTime: "time",
    colSpace: "space",
    naive: "nested loop (naive)",
    mono: "monotonic stack",
    rule1: "1 · while top ≤ current → pop",
    rule2: "2 · top (if any) is the answer",
    rule3: "3 · push current",
    note: "each element moves once — the nested while shares one budget",
    caption:
      "Why O(n): each element is pushed once and popped at most once, so pushes + pops ≤ 2n. Space is O(n). The naive nested loop is O(n²) time, O(n) space. Rule per element, scanning right to left: pop while top ≤ current, read the top as the answer, push current.",
  },
  ru: {
    svgTitle: "Монотонный стек это O(n), потому что каждый элемент добавляется и удаляется не более раза, против наивных O(n²)",
    headline: "ДОБАВЛЕН РАЗ + УДАЛЁН РАЗ = O(n)",
    sub: "добавления + удаления ≤ 2n против наивных n × n = O(n²)",
    colApproach: "подход",
    colTime: "время",
    colSpace: "память",
    naive: "вложенный цикл (наивный)",
    mono: "монотонный стек",
    rule1: "1 · пока вершина ≤ текущему → удалить",
    rule2: "2 · вершина (если есть) это ответ",
    rule3: "3 · добавить текущий",
    note: "каждый элемент движется раз — вложенный while делит один бюджет",
    caption:
      "Почему O(n): каждый элемент добавляется раз и удаляется не более раза, так что добавления + удаления ≤ 2n. Память O(n). Наивный вложенный цикл: O(n²) время, O(n) память. Правило для элемента при сканировании справа налево: удаляй пока вершина ≤ текущему, читай вершину как ответ, добавляй текущий.",
  },
};

const t = dict[lang];

const rows = [
  { name: "naive", time: "O(n²)", space: "O(n)" },
  { name: "mono", time: "O(n)", space: "O(n)" },
];
const rowLabel = (n: string) => (n === "naive" ? t.naive : t.mono);
const rowY = (i: number) => 150 + i * 62;
const rules = [t.rule1, t.rule2, t.rule3];
const ruleY = (i: number) => 300 + i * 26;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="215" y="108" font-size="13" fill="var(--muted)">{t.colApproach}</text>
    <text x="520" y="108" font-size="13" fill="var(--muted)">{t.colTime}</text>
    <text x="650" y="108" font-size="13" fill="var(--muted)">{t.colSpace}</text>
    <line x1="200" y1="118" x2="700" y2="118" stroke="var(--muted)" stroke-width="1" />

    {rows.map((r, i) => (
      <g>
        <rect x="200" y={rowY(i)} width="500" height="50" fill="var(--card)" stroke={r.name === "mono" ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x="215" y={rowY(i) + 31} font-size="14" fill="var(--ink)">{rowLabel(r.name)}</text>
        <text x="520" y={rowY(i) + 31} font-size="14" fill={r.name === "mono" ? "var(--accent)" : "var(--ink)"}>{r.time}</text>
        <text x="650" y={rowY(i) + 31} font-size="14" fill="var(--ink)">{r.space}</text>
      </g>
    ))}

    {rules.map((r, i) => (
      <text x="400" y={ruleY(i)} text-anchor="middle" font-size="13" fill="var(--ink)">{r}</text>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
