---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Push trace: pushing 10, 20, 30 builds [30, 20, 10]; getAtIndex(2) returns 10 after 2 hops",
    headline: "PUSH IS O(1) · INDEX COSTS O(i) HOPS",
    sub: "push: new node → point at old head → update head · index: follow one pointer per hop",
    head: "head",
    pushCost: "O(1) each",
    hop1: "hop 1",
    hop2: "hop 2",
    indexResult: "getAtIndex(2) = 10 · 2 hops",
    caption:
      "Trace of push: push(10) gives [10], push(20) gives [20, 10], push(30) gives [30, 20, 10] — each push is O(1), no shifting. Then getAtIndex(2) on [30, 20, 10] starts at head (30), follows one pointer to 20, another to 10, and returns 10 after 2 hops: reaching position i costs O(i).",
  },
  ru: {
    svgTitle: "Трассировка push: вставка 10, 20, 30 строит [30, 20, 10]; getAtIndex(2) возвращает 10 после 2 прыжков",
    headline: "PUSH — O(1) · ИНДЕКС СТОИТ O(i) ПРЫЖКОВ",
    sub: "push: новый узел → укажи на старый head → обнови head · индекс: один указатель за прыжок",
    head: "head",
    pushCost: "O(1) каждый",
    hop1: "прыжок 1",
    hop2: "прыжок 2",
    indexResult: "getAtIndex(2) = 10 · 2 прыжка",
    caption:
      "Трассировка push: push(10) даёт [10], push(20) даёт [20, 10], push(30) даёт [30, 20, 10] — каждый push это O(1), без сдвигов. Затем getAtIndex(2) на [30, 20, 10] стартует с head (30), идёт по одному указателю к 20, по другому к 10 и возвращает 10 после 2 прыжков: достижение позиции i стоит O(i).",
  },
};

const t = dict[lang];

const rows = [
  { label: "push(10)", cells: ["10"], y: 96 },
  { label: "push(20)", cells: ["20", "10"], y: 156 },
  { label: "push(30)", cells: ["30", "20", "10"], y: 216 },
];
const cw = 64;
const ch = 44;
const step = 76;
const x0 = 300;
const cellX = (j: number) => x0 + j * step;
const hopCells = ["30", "20", "10"];
const hopY = 316;
const hopLabels = [t.hop1, t.hop2];
const hopIdx = [0, 1];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {rows.map((r) => (
      <g>
        <text x="284" y={r.y + 28} text-anchor="end" font-size="13" fill="var(--ink)">{r.label}</text>
        <text x={x0 + 20} y={r.y - 8} text-anchor="middle" font-size="11" fill="var(--accent)">{t.head} ↓</text>
        {r.cells.map((c, j) => (
          <g>
            <rect x={cellX(j)} y={r.y} width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
            <text x={cellX(j) + cw / 2} y={r.y + 28} text-anchor="middle" font-size="15" fill="var(--ink)">{c}</text>
          </g>
        ))}
        <text x="580" y={r.y + 28} font-size="13" fill="var(--muted)">{t.pushCost}</text>
      </g>
    ))}

    <line x1="120" y1="286" x2="680" y2="286" stroke="var(--muted)" stroke-width="1" stroke-dasharray="6 4" />
    {hopCells.map((c, j) => (
      <g>
        <rect x={cellX(j)} y={hopY} width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(j) + cw / 2} y={hopY + 28} text-anchor="middle" font-size="15" fill="var(--ink)">{c}</text>
      </g>
    ))}
    {hopIdx.map((j) => (
      <g>
        <line x1={cellX(j) + cw} y1={hopY + ch / 2} x2={cellX(j + 1) - 4} y2={hopY + ch / 2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${cellX(j + 1) - 4},${hopY + ch / 2} ${cellX(j + 1) - 12},${hopY + ch / 2 - 5} ${cellX(j + 1) - 12},${hopY + ch / 2 + 5}`} fill="var(--accent)" />
        <text x={(cellX(j) + cw + cellX(j + 1)) / 2} y={hopY - 8} text-anchor="middle" font-size="11" fill="var(--accent)">{hopLabels[j]}</text>
      </g>
    ))}
    <text x="400" y="396" text-anchor="middle" font-size="14" fill="var(--ink)">{t.indexResult}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
