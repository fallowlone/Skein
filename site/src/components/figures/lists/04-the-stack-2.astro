---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Push adds on top, pop removes the top, peek reads the top",
    headline: "PUSH · POP · PEEK — ALL O(1)",
    sub: "every operation touches only the top — no traversal",
    titles: ["PUSH", "POP", "PEEK"],
    ops: ["push(30)", "pop()", "peek()"],
    effects: ["adds 30 on top", "removes + returns 30", "reads 30, keeps it"],
    states: ["→ [10, 20, 30]", "→ 30 · [10, 20]", "→ 30 · unchanged"],
    note: "empty pop / peek → null · only the top moves",
    caption:
      "Push adds to the top, pop removes and returns the top, peek returns the top without removing it. On an empty stack pop and peek return null. Every operation touches only the top, so all run in O(1).",
  },
  ru: {
    svgTitle: "Push кладёт сверху, pop снимает верх, peek читает верх",
    headline: "PUSH · POP · PEEK — ВСЁ O(1)",
    sub: "каждая операция трогает только верх — без обхода",
    titles: ["PUSH", "POP", "PEEK"],
    ops: ["push(30)", "pop()", "peek()"],
    effects: ["кладёт 30 сверху", "снимает + возвращает 30", "читает 30, оставляет"],
    states: ["→ [10, 20, 30]", "→ 30 · [10, 20]", "→ 30 · без изменений"],
    note: "pop / peek пустого → null · движется только верх",
    caption:
      "Push добавляет на верх, pop удаляет и возвращает верх, peek возвращает верх без удаления. На пустом стеке pop и peek возвращают null. Каждая операция трогает только верх, поэтому все выполняются за O(1).",
  },
};

const t = dict[lang];

const cx = [143, 400, 657];
const cellW = 104;
const cellH = 36;
const cellX = cx.map((x) => x - cellW / 2);
const rowY = (r: number) => 216 - r * cellH;

const stacks: string[][] = [["10", "20"], ["10", "20"], ["10", "20", "30"]];
const placed = stacks.map((cells, c) =>
  cells.map((v, r) => ({ v, x: cellX[c], y: rowY(r), hot: c === 2 && r === cells.length - 1 }))
);

const downPts = `${cx[0] - 6},162 ${cx[0] + 6},162 ${cx[0]},172`;
const upPts = `${cx[1] - 6},144 ${cx[1] + 6},144 ${cx[1]},134`;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <line x1="272" y1="92" x2="272" y2="330" stroke="var(--muted)" stroke-width="1" />
    <line x1="530" y1="92" x2="530" y2="330" stroke="var(--muted)" stroke-width="1" />

    {cx.map((x, c) => (
      <text x={x} y="116" text-anchor="middle" font-family="var(--font-display)" font-size="17" fill="var(--ink)">{t.titles[c]}</text>
    ))}
    {cx.map((x, c) => (
      <text x={x} y="138" text-anchor="middle" font-size="12" fill="var(--muted)">{t.ops[c]}</text>
    ))}

    <line x1={cx[0]} y1="136" x2={cx[0]} y2="168" stroke="var(--accent)" stroke-width="2" />
    <polygon points={downPts} fill="var(--accent)" />
    <text x={cx[0] + 14} y="162" font-size="15" fill="var(--accent)">30</text>

    <line x1={cx[1]} y1="170" x2={cx[1]} y2="138" stroke="var(--accent)" stroke-width="2" />
    <polygon points={upPts} fill="var(--accent)" />
    <text x={cx[1] + 14} y="162" font-size="15" fill="var(--accent)">30</text>

    {placed.map((cells) => (
      <g>
        {cells.map((cell) => (
          <g>
            <rect x={cell.x} y={cell.y} width={cellW} height={cellH} fill="var(--card)" stroke={cell.hot ? "var(--accent)" : "var(--ink)"} stroke-width={cell.hot ? 3 : 2} />
            <text x={cell.x + cellW / 2} y={cell.y + cellH / 2 + 6} text-anchor="middle" font-size="15" fill="var(--ink)">{cell.v}</text>
          </g>
        ))}
      </g>
    ))}

    {cx.map((x, c) => (
      <text x={x} y="288" text-anchor="middle" font-size="12" fill="var(--ink)">{t.effects[c]}</text>
    ))}
    {cx.map((x, c) => (
      <text x={x} y="310" text-anchor="middle" font-size="12" fill="var(--muted)">{t.states[c]}</text>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
