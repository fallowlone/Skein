---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Deleting node 15 by skipping it, and the dummy head anchoring the list",
    headline: "DELETION + THE DUMMY HEAD",
    sub: "unlink by skipping · dummy(0) anchors the real head · O(1)",
    delBeforeLabel: "Before: [10] → [15] → [20] → [30]",
    delAfterLabel: "After: 10.next skips 15 and points at 20",
    goneTag: "15 is now unreachable",
    dummyLabel: "Dummy (0) → [10] → [20] → [30]: every op has a prev",
    dummyTag: "always exists",
    note: "with a dummy, head and middle use the same code — no special cases",
    caption:
      "Deleting 15 from [10] → [15] → [20] → [30]: set 10.next to skip the target and point directly at 20, leaving 15 unreachable — O(1) given the previous node. A dummy head (0) anchoring the real head guarantees that previous node always exists, so head and middle operations share one code path.",
  },
  ru: {
    svgTitle: "Удаление узла 15 пропуском и dummy head как якорь списка",
    headline: "УДАЛЕНИЕ + DUMMY HEAD",
    sub: "отсоедини пропуском · dummy(0) держит настоящий head · O(1)",
    delBeforeLabel: "Раньше: [10] → [15] → [20] → [30]",
    delAfterLabel: "После: 10.next пропускает 15 и указывает на 20",
    goneTag: "15 теперь недостижим",
    dummyLabel: "Dummy (0) → [10] → [20] → [30]: у каждой операции есть prev",
    dummyTag: "всегда существует",
    note: "с dummy head и середина идут одним кодом — без особых случаев",
    caption:
      "Удаление 15 из [10] → [15] → [20] → [30]: установи 10.next чтобы пропустить цель и указать прямо на 20, оставив 15 недостижимым — O(1) если есть предыдущий узел. Dummy head (0) перед настоящим head гарантирует, что предыдущий узел всегда существует, поэтому операции с head и серединой идут одной веткой кода.",
  },
};

const t = dict[lang];

const delBefore = ["10", "15", "20", "30"];
const dx = [115, 265, 415, 565];
const dArrows = [
  { x1: 193, x2: 261 },
  { x1: 343, x2: 411 },
  { x1: 493, x2: 561 },
];
const dMid = 126;
const afterVals = ["10", "20", "30"];
const ax = [170, 380, 560];
const skipArrow = { x1: 244, x2: 376 };
const tailArrow = { x1: 454, x2: 556 };
const aMid = 228;
const dummyVals = ["0", "10", "20", "30"];
const ux = [150, 300, 450, 580];
const uArrows = [
  { x1: 224, x2: 296 },
  { x1: 374, x2: 446 },
  { x1: 524, x2: 576 },
];
const uMid = 346;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="92" text-anchor="middle" font-size="13" fill="var(--ink)">{t.delBeforeLabel}</text>
    {delBefore.map((v, i) => (
      <g>
        <rect x={dx[i]} y="104" width="70" height="44" fill="var(--card)" stroke={i === 1 ? "var(--muted)" : "var(--ink)"} stroke-width="2" stroke-dasharray={i === 1 ? "6 4" : "none"} />
        <text x={dx[i] + 35} y="131" text-anchor="middle" font-size="15" fill={i === 1 ? "var(--muted)" : "var(--ink)"}>{v}</text>
      </g>
    ))}
    {dArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={dMid} x2={a.x2} y2={dMid} stroke="var(--ink)" stroke-width="2" />
        <polygon points={`${a.x2},${dMid - 5} ${a.x2},${dMid + 5} ${a.x2 + 8},${dMid}`} fill="var(--ink)" />
      </g>
    ))}

    <text x="400" y="196" text-anchor="middle" font-size="13" fill="var(--ink)">{t.delAfterLabel}</text>
    {afterVals.map((v, i) => (
      <g>
        <rect x={ax[i]} y="206" width="70" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={ax[i] + 35} y="233" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <line x1={skipArrow.x1} y1={aMid} x2={skipArrow.x2} y2={aMid} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${skipArrow.x2},${aMid - 5} ${skipArrow.x2},${aMid + 5} ${skipArrow.x2 + 8},${aMid}`} fill="var(--accent)" />
    <line x1={tailArrow.x1} y1={aMid} x2={tailArrow.x2} y2={aMid} stroke="var(--ink)" stroke-width="2" />
    <polygon points={`${tailArrow.x2},${aMid - 5} ${tailArrow.x2},${aMid + 5} ${tailArrow.x2 + 8},${aMid}`} fill="var(--ink)" />
    <rect x="265" y="258" width="70" height="34" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 4" />
    <text x="300" y="281" text-anchor="middle" font-size="14" fill="var(--muted)">15</text>
    <text x="345" y="281" font-size="12" fill="var(--muted)">{t.goneTag}</text>

    <text x="400" y="318" text-anchor="middle" font-size="13" fill="var(--ink)">{t.dummyLabel}</text>
    {dummyVals.map((v, i) => (
      <g>
        <rect x={ux[i]} y="328" width="70" height="36" fill="var(--card)" stroke={i === 0 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={ux[i] + 35} y="352" text-anchor="middle" font-size="14" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {uArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={uMid} x2={a.x2} y2={uMid} stroke="var(--ink)" stroke-width="2" />
        <polygon points={`${a.x2},${uMid - 5} ${a.x2},${uMid + 5} ${a.x2 + 8},${uMid}`} fill="var(--ink)" />
      </g>
    ))}
    <text x="185" y="380" text-anchor="middle" font-size="12" fill="var(--accent)">{t.dummyTag}</text>

    <text x="400" y="402" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
