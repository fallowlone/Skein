---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Scattered memory: nodes with values 10, 20, 30 at addresses 1000, 3008, 5016 linked by pointers",
    headline: "SCATTERED MEMORY, LINKED BY POINTERS",
    sub: "nodes live anywhere · each pointer stores the next address",
    addrLabel: "address",
    valueLabel: "value",
    nextLabel: "pointer",
    note1: "addresses 1000, 3008, 5016 are not consecutive",
    note2: "a pointer is just a number — 8 bytes on a 64-bit system",
    caption:
      "Nodes can live anywhere in memory: node [10] at address 1000 points to 3008, node [20] at 3008 points to 5016, node [30] at 5016 points to null. The addresses are not consecutive, but the pointers chain the nodes together so the list can be traversed.",
  },
  ru: {
    svgTitle: "Разреженная память: узлы со значениями 10, 20, 30 по адресам 1000, 3008, 5016, связанные указателями",
    headline: "РАЗРЕЖЕННАЯ ПАМЯТЬ, СВЯЗАННАЯ УКАЗАТЕЛЯМИ",
    sub: "узлы живут где угодно · каждый указатель хранит следующий адрес",
    addrLabel: "адрес",
    valueLabel: "значение",
    nextLabel: "указатель",
    note1: "адреса 1000, 3008, 5016 не последовательны",
    note2: "указатель — это просто число, 8 байт на 64-битной системе",
    caption:
      "Узлы могут жить где угодно в памяти: узел [10] по адресу 1000 указывает на 3008, узел [20] по адресу 3008 указывает на 5016, узел [30] по адресу 5016 указывает на null. Адреса не последовательны, но указатели связывают узлы в цепочку, так что список можно обойти.",
  },
};

const t = dict[lang];

const slots = [
  { addr: "1000", value: "10", ptr: "→ 3008", x: 70, y: 120 },
  { addr: "3008", value: "20", ptr: "→ 5016", x: 310, y: 235 },
  { addr: "5016", value: "30", ptr: "→ null", x: 550, y: 120 },
];
const bw = 180;
const bh = 80;
const arrows = [
  { d: "M250,160 C280,160 270,275 306,275", points: "306,275 294,269 294,281" },
  { d: "M490,275 C520,275 530,160 546,160", points: "546,160 534,154 534,166" },
];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {arrows.map((a) => (
      <g>
        <path d={a.d} fill="none" stroke="var(--accent)" stroke-width="2" />
        <polygon points={a.points} fill="var(--accent)" />
      </g>
    ))}
    {slots.map((s) => (
      <g>
        <text x={s.x + bw / 2} y={s.y - 12} text-anchor="middle" font-size="13" fill="var(--accent)">{t.addrLabel} {s.addr}</text>
        <rect x={s.x} y={s.y} width={bw} height={bh} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <line x1={s.x + 80} y1={s.y} x2={s.x + 80} y2={s.y + bh} stroke="var(--ink)" stroke-width="2" />
        <text x={s.x + 40} y={s.y + 24} text-anchor="middle" font-size="11" fill="var(--muted)">{t.valueLabel}</text>
        <text x={s.x + 40} y={s.y + 58} text-anchor="middle" font-size="20" fill="var(--ink)">{s.value}</text>
        <text x={s.x + 130} y={s.y + 24} text-anchor="middle" font-size="11" fill="var(--muted)">{t.nextLabel}</text>
        <text x={s.x + 130} y={s.y + 58} text-anchor="middle" font-size="16" fill="var(--ink)">{s.ptr}</text>
      </g>
    ))}

    <text x="400" y="360" text-anchor="middle" font-size="13" fill="var(--ink)">{t.note1}</text>
    <text x="400" y="386" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
