---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Deque with 10, 20, 30: push and pop at both the front and the rear, all O(1)",
    headline: "DEQUE: BOTH ENDS OPEN, ALL O(1)",
    sub: "push and pop at the front and the rear alike",
    frontLabel: "FRONT",
    rearLabel: "REAR",
    pushFront: "pushFront · O(1)",
    popFront: "popFront · O(1)",
    pushBack: "pushBack · O(1)",
    popBack: "popBack · O(1)",
    note: "proper deque: circular buffer or doubly linked list — all four stay O(1)",
    caption:
      "A deque (double-ended queue) allows insertion and deletion at both ends: pushFront, popFront, pushBack, popBack — all O(1) with a circular buffer or doubly linked list. A naive array .shift() would make popFront O(n).",
  },
  ru: {
    svgTitle: "Дек с 10, 20, 30: push и pop и спереди, и сзади, все O(1)",
    headline: "ДЕК: ОБА КОНЦА ОТКРЫТЫ, ВСЁ O(1)",
    sub: "push и pop и спереди, и сзади",
    frontLabel: "ПЕРЕДНЯЯ",
    rearLabel: "СПИНА",
    pushFront: "pushFront · O(1)",
    popFront: "popFront · O(1)",
    pushBack: "pushBack · O(1)",
    popBack: "popBack · O(1)",
    note: "правильный дек: circular buffer или двусвязный список — все четыре O(1)",
    caption:
      "Дек (двухконечная очередь) разрешает вставку и удаление на обоих концах: pushFront, popFront, pushBack, popBack — все O(1) на circular buffer или двусвязном списке. Наивный массив с .shift() сделал бы popFront O(n).",
  },
};

const t = dict[lang];

const cells = ["10", "20", "30"];

const x0 = 296;
const cw = 56;
const ch = 56;
const step = 72;
const rowY = 170;
const midY = rowY + ch / 2;
const leftEdge = x0;
const rightEdge = x0 + 2 * step + cw;
const cellX = (i: number) => x0 + i * step;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={cellX(0) + cw / 2} y="136" text-anchor="middle" font-size="13" fill="var(--accent)">{t.frontLabel}</text>
    <text x={cellX(2) + cw / 2} y="136" text-anchor="middle" font-size="13" fill="var(--accent)">{t.rearLabel}</text>

    {cells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={rowY} width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y={rowY + 37} text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <line x1={leftEdge - 90} y1={midY - 16} x2={leftEdge - 14} y2={midY - 16} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${leftEdge - 14},${midY - 23} ${leftEdge - 14},${midY - 9} ${leftEdge - 2},${midY - 16}`} fill="var(--accent)" />
    <text x={leftEdge - 96} y={midY - 22} text-anchor="end" font-size="12" fill="var(--ink)">{t.pushFront}</text>

    <line x1={leftEdge - 14} y1={midY + 16} x2={leftEdge - 90} y2={midY + 16} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${leftEdge - 90},${midY + 9} ${leftEdge - 90},${midY + 23} ${leftEdge - 102},${midY + 16}`} fill="var(--accent)" />
    <text x={leftEdge - 96} y={midY + 40} text-anchor="end" font-size="12" fill="var(--ink)">{t.popFront}</text>

    <line x1={rightEdge + 90} y1={midY - 16} x2={rightEdge + 14} y2={midY - 16} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${rightEdge + 14},${midY - 23} ${rightEdge + 14},${midY - 9} ${rightEdge + 2},${midY - 16}`} fill="var(--accent)" />
    <text x={rightEdge + 96} y={midY - 22} text-anchor="start" font-size="12" fill="var(--ink)">{t.pushBack}</text>

    <line x1={rightEdge + 14} y1={midY + 16} x2={rightEdge + 90} y2={midY + 16} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${rightEdge + 90},${midY + 9} ${rightEdge + 90},${midY + 23} ${rightEdge + 102},${midY + 16}`} fill="var(--accent)" />
    <text x={rightEdge + 96} y={midY + 40} text-anchor="start" font-size="12" fill="var(--ink)">{t.popBack}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
