---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Production type defaults: NUMERIC for money, TIMESTAMPTZ for time, TEXT for strings",
    headline: "DEFAULTS THAT SAVE YOU",
    sub: "money · time · strings",
    avoidHead: "avoid",
    useHead: "use",
    wrongs: ["REAL", "TIMESTAMP", "CHAR(n)"],
    rights: ["NUMERIC · exact, no cent drift", "TIMESTAMPTZ · stores UTC", "TEXT · no padding surprises"],
    foot: "hard to change on large tables — decide at design time",
    caption:
      "Three production defaults: NUMERIC instead of REAL so money never drifts cents, TIMESTAMPTZ instead of TIMESTAMP so instants survive timezones, TEXT instead of CHAR(n) so no padding sneaks into comparisons.",
  },
  ru: {
    svgTitle: "Продакшн-дефолты типов: NUMERIC для денег, TIMESTAMPTZ для времени, TEXT для строк",
    headline: "ДЕФОЛТЫ, КОТОРЫЕ СПАСАЮТ",
    sub: "деньги · время · строки",
    avoidHead: "избегать",
    useHead: "использовать",
    wrongs: ["REAL", "TIMESTAMP", "CHAR(n)"],
    rights: ["NUMERIC · точный, без дрейфа центов", "TIMESTAMPTZ · хранит UTC", "TEXT · без сюрпризов padding"],
    foot: "на больших таблицах менять трудно — решай при проектировании",
    caption:
      "Три продакшн-дефолта: NUMERIC вместо REAL, чтобы деньги не дрейфовали на центы, TIMESTAMPTZ вместо TIMESTAMP, чтобы моменты переживали часовые пояса, TEXT вместо CHAR(n), чтобы padding не прокрался в сравнения.",
  },
};

const t = dict[lang];

const bandY = [115, 180, 245];
const bandH = 55;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-types-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="150" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.avoidHead}</text>
    <text x="530" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.useHead}</text>

    {t.wrongs.map((w, i) => (
      <g>
        <rect x="40" y={bandY[i]} width="220" height={bandH} fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
        <text x="150" y={bandY[i] + 36} text-anchor="middle" font-size="13" fill="var(--muted)">{w}</text>
        <line x1="262" y1={bandY[i] + bandH / 2} x2="292" y2={bandY[i] + bandH / 2} stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-types-arrow)" />
        <rect x="300" y={bandY[i]} width="460" height={bandH} fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
        <text x="530" y={bandY[i] + 36} text-anchor="middle" font-size="12" fill="var(--ink)">{t.rights[i]}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
