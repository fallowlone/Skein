---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Constraints refuse bad writes: CHECK blocks amount -5, FOREIGN KEY blocks the orphan",
    headline: "CONSTRAINTS REFUSE BAD DATA",
    sub: "declare the rule once — every bad write is refused",
    codes: ["INSERT amount = -5", "INSERT favourite user 99", "INSERT duplicate (1, 7)", "INSERT valid row"],
    chips: ["CHECK (amount >= 0)", "FOREIGN KEY users(id)", "PRIMARY KEY (user_id, item_id)", "all constraints pass"],
    verdicts: ["REFUSED", "REFUSED", "REFUSED", "STORED"],
    foot: "checked before every write — the engine refuses for every caller",
    caption:
      "Constraints are declarative rules checked before every insert, update, or delete: CHECK refuses amount -5, FOREIGN KEY refuses the orphan favourite, PRIMARY KEY refuses the duplicate — only the valid row is stored.",
  },
  ru: {
    svgTitle: "Ограничения отклоняют плохие записи: CHECK блокирует amount -5, FOREIGN KEY блокирует сироту",
    headline: "ОГРАНИЧЕНИЯ ОТКЛОНЯЮТ ПЛОХИЕ ДАННЫЕ",
    sub: "объяви правило один раз — каждая плохая запись отклонена",
    codes: ["INSERT amount = -5", "INSERT favourite user 99", "INSERT duplicate (1, 7)", "INSERT valid row"],
    chips: ["CHECK (amount >= 0)", "FOREIGN KEY users(id)", "PRIMARY KEY (user_id, item_id)", "все ограничения пройдены"],
    verdicts: ["ОТКАЗАНО", "ОТКАЗАНО", "ОТКАЗАНО", "ЗАПИСАНО"],
    foot: "проверяются перед каждой записью — движок отказывает за всех",
    caption:
      "Ограничения — декларативные правила, проверяемые перед каждой вставкой, обновлением или удалением: CHECK отказывает amount -5, FOREIGN KEY отказывает сироте, PRIMARY KEY отказывает дубликату — записывается только корректная строка.",
  },
};

const t = dict[lang];

const bandY = [115, 170, 225, 280];
const bandH = 46;
const verdictFill = ["var(--accent)", "var(--accent)", "var(--accent)", "var(--ink)"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-refuse-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.codes.map((c, i) => (
      <g>
        <rect x="40" y={bandY[i]} width="720" height={bandH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="60" y={bandY[i] + 29} font-size="12" fill="var(--ink)">{c}</text>
        <rect x="300" y={bandY[i] + 7} width="280" height="32" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="440" y={bandY[i] + 28} text-anchor="middle" font-size="11" fill="var(--ink)">{t.chips[i]}</text>
        <text x="728" y={bandY[i] + 30} text-anchor="end" font-size="13" fill={verdictFill[i]}>{t.verdicts[i]}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
