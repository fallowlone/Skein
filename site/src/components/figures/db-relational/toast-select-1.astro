---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "SELECT star pays the TOAST tax: an 8KB payload is detoasted per row, a column list skips it",
    headline: "SELECT * PAYS THE TOAST TAX",
    sub: "values over ~2KB spill aside — * fetches them all",
    leftTitle: "SELECT *",
    leftCols: ["id", "event_type", "created_at"],
    leftWide: "payload · 8KB → TOAST fetch",
    leftVerdict: "detoasts every row",
    rightTitle: "SELECT id, event_type, created_at",
    rightCols: ["id", "event_type", "created_at"],
    rightWide: "18 B pointer · not fetched",
    rightVerdict: "no TOAST fetch",
    foot: "list rows without the payload — detoast only on detail pages",
    caption:
      "Values wider than ~2KB live in the TOAST side table behind an 18-byte pointer: SELECT * follows the pointer for every row and detoasts the 8KB payload each time, while a targeted column list never touches it.",
  },
  ru: {
    svgTitle: "SELECT звёздочка платит TOAST-налог: payload 8КБ читается на строку, список колонок пропускает",
    headline: "SELECT * ПЛАТИТ TOAST-НАЛОГ",
    sub: "значения шире ~2КБ лежат в стороне — * тянет их все",
    leftTitle: "SELECT *",
    leftCols: ["id", "event_type", "created_at"],
    leftWide: "payload · 8КБ → TOAST-чтение",
    leftVerdict: "распаковка на каждую строку",
    rightTitle: "SELECT id, event_type, created_at",
    rightCols: ["id", "event_type", "created_at"],
    rightWide: "указатель 18 B · не читается",
    rightVerdict: "без TOAST-чтения",
    foot: "перечисляй строки без payload — распаковка только на детальных страницах",
    caption:
      "Значения шире ~2КБ живут в TOAST side-таблице за 18-байтовым указателем: SELECT * идёт по указателю в каждой строке и распаковывает payload 8КБ каждый раз, а адресный список колонок его вообще не касается.",
  },
};

const t = dict[lang];

const chipY = [140, 174, 208];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-toast-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="350" height="240" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="215" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    {t.leftCols.map((c, i) => (
      <g>
        <rect x="60" y={chipY[i]} width="310" height="30" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="215" y={chipY[i] + 21} text-anchor="middle" font-size="12" fill="var(--ink)">{c}</text>
      </g>
    ))}
    <rect x="60" y="242" width="310" height="36" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="215" y="265" text-anchor="middle" font-size="12" fill="var(--accent)">{t.leftWide}</text>
    <rect x="60" y="288" width="310" height="38" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="215" y="313" text-anchor="middle" font-size="12" fill="var(--accent)">{t.leftVerdict}</text>

    <rect x="410" y="100" width="350" height="240" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="585" y="124" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightTitle}</text>
    {t.rightCols.map((c, i) => (
      <g>
        <rect x="430" y={chipY[i]} width="310" height="30" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="585" y={chipY[i] + 21} text-anchor="middle" font-size="12" fill="var(--ink)">{c}</text>
      </g>
    ))}
    <rect x="430" y="242" width="310" height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="585" y="265" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightWide}</text>
    <rect x="430" y="288" width="310" height="38" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="585" y="313" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightVerdict}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
