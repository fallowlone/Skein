---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "SQL versus Codd: NULL logic, unordered rows, and duplicates kept unless asked",
    headline: "SQL: ALGEBRA + COMPROMISES",
    sub: "three surprises explained by one gap",
    codes: ["NULL = NULL", "no ORDER BY", "duplicate rows kept"],
    effects: ["NULL, not true · three-valued logic", "engine may return any order", "ask with DISTINCT"],
    foot: "SQL = relational algebra + practical compromises",
    caption:
      "SQL is a non-strict implementation of Codd's algebra: NULL = NULL is NULL rather than true, rows arrive in any order without ORDER BY, and duplicates stay unless DISTINCT is asked for.",
  },
  ru: {
    svgTitle: "SQL против Кодда: NULL-логика, неупорядоченные строки и дубли пока не попросишь",
    headline: "SQL: АЛГЕБРА + КОМПРОМИССЫ",
    sub: "три сюрприза из одного разрыва",
    codes: ["NULL = NULL", "no ORDER BY", "duplicate rows kept"],
    effects: ["NULL, а не true · трёхзначная логика", "движок вернёт любой порядок", "проси через DISTINCT"],
    foot: "SQL = реляционная алгебра + практические компромиссы",
    caption:
      "SQL — нестрогая реализация алгебры Кодда: NULL = NULL даёт NULL, а не true, без ORDER BY строки приходят в любом порядке, а дубли остаются, пока не попросишь DISTINCT.",
  },
};

const t = dict[lang];

const bandY = [120, 185, 250];
const bandH = 52;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-gap-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.codes.map((c, i) => (
      <g>
        <rect x="40" y={bandY[i]} width="330" height={bandH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="205" y={bandY[i] + 33} text-anchor="middle" font-size="12" fill="var(--ink)">{c}</text>
        <line x1="372" y1={bandY[i] + bandH / 2} x2="422" y2={bandY[i] + bandH / 2} stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-gap-arrow)" />
        <rect x="430" y={bandY[i]} width="330" height={bandH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="595" y={bandY[i] + 33} text-anchor="middle" font-size="11" fill="var(--ink)">{t.effects[i]}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
