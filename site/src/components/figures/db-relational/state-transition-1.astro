---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "State transitions need a trigger: completed orders cannot move back to pending",
    headline: "COMPLETED MEANS COMPLETED",
    sub: "CHECK guards values · a trigger guards transitions",
    states: ["pending", "completed", "cancelled"],
    allowed: "allowed",
    refused: "REFUSED",
    triggerLine: "BEFORE UPDATE trigger raises EXCEPTION",
    foot: "declarative rules in schema · procedural rules in triggers",
    caption:
      "CHECK constrains one row's values but cannot see transitions, so a BEFORE UPDATE trigger refuses the completed-to-pending move: declarative rules live in the schema, procedural rules live in triggers.",
  },
  ru: {
    svgTitle: "Переходы состояний требуют триггера: завершённый заказ не возвращается в pending",
    headline: "COMPLETED ЗНАЧИТ COMPLETED",
    sub: "CHECK хранит значения · триггер хранит переходы",
    states: ["pending", "completed", "cancelled"],
    allowed: "разрешено",
    refused: "ОТКАЗАНО",
    triggerLine: "BEFORE UPDATE триггер бросает EXCEPTION",
    foot: "декларативное — в схеме · процедурное — в триггерах",
    caption:
      "CHECK ограничивает значения одной строки, но не видит переходов, поэтому BEFORE UPDATE триггер отказывает движению из completed в pending: декларативные правила живут в схеме, процедурные — в триггерах.",
  },
};

const t = dict[lang];

const stateX = [50, 305, 560];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-trans-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.states.map((s, i) => (
      <g>
        <rect x={stateX[i]} y="150" width="190" height="64" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={stateX[i] + 95} y="189" text-anchor="middle" font-size="14" fill="var(--ink)">{s}</text>
      </g>
    ))}

    <line x1="242" y1="182" x2="297" y2="182" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-trans-arrow)" />
    <text x="270" y="168" text-anchor="middle" font-size="11" fill="var(--muted)">{t.allowed}</text>
    <line x1="497" y1="182" x2="552" y2="182" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-trans-arrow)" />
    <text x="525" y="168" text-anchor="middle" font-size="11" fill="var(--muted)">{t.allowed}</text>

    <path d="M 400 214 C 400 282, 200 282, 148 214" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 4" marker-end="url(#dbrel-trans-arrow)" />
    <text x="272" y="296" text-anchor="middle" font-size="13" fill="var(--accent)">{t.refused}</text>

    <rect x="180" y="312" width="440" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="341" text-anchor="middle" font-size="12" fill="var(--ink)">{t.triggerLine}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
