---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Postgres extensions cover specialist needs: JSONB, pg_vector, PostGIS, TimescaleDB",
    headline: "POSTGRES COVERS THE SPREAD",
    sub: "one engine + the right extension",
    needs: ["document queries", "vector search (AI embeddings)", "geospatial queries", "time-series compression"],
    exts: ["JSONB + GIN", "pg_vector", "PostGIS", "TimescaleDB"],
    foot: "under ~10 TB, Postgres + extension beats a second database",
    caption:
      "Document queries run on JSONB with GIN, vector search on pg_vector, geospatial on PostGIS, time-series on TimescaleDB — a second database earns its place only past specialist limits.",
  },
  ru: {
    svgTitle: "Расширения Postgres закрывают спецнужды: JSONB, pg_vector, PostGIS, TimescaleDB",
    headline: "POSTGRES ЗАКРЫВАЕТ РАЗБРОС",
    sub: "один движок + нужное расширение",
    needs: ["документные запросы", "векторный поиск (AI-эмбеддинги)", "геозапросы", "сжатие временных рядов"],
    exts: ["JSONB + GIN", "pg_vector", "PostGIS", "TimescaleDB"],
    foot: "до ~10 ТБ Postgres + расширение бьёт вторую базу",
    caption:
      "Документные запросы идут на JSONB с GIN, векторный поиск — на pg_vector, гео — на PostGIS, временные ряды — на TimescaleDB: вторая база оправдана лишь за пределами спецлимитов.",
  },
};

const t = dict[lang];

const bandY = [105, 165, 225, 285];
const bandH = 50;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-ext-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.needs.map((n, i) => (
      <g>
        <rect x="40" y={bandY[i]} width="330" height={bandH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="205" y={bandY[i] + 32} text-anchor="middle" font-size="12" fill="var(--muted)">{n}</text>
        <line x1="372" y1={bandY[i] + bandH / 2} x2="402" y2={bandY[i] + bandH / 2} stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-ext-arrow)" />
        <rect x="410" y={bandY[i]} width="350" height={bandH} fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
        <text x="585" y={bandY[i] + 33} text-anchor="middle" font-size="14" fill="var(--ink)">{t.exts[i]}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
