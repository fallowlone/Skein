---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "ORM N-plus-1: 100 orders lazy-load into 101 queries where one JOIN would do",
    headline: "N+1: 101 QUERIES FOR 1 JOIN",
    sub: "lazy by default — annotate every relation",
    leftTitle: "ORM default · lazy load",
    leftBox1a: "1 query",
    leftBox1b: "100 orders",
    leftBox2a: "100 queries",
    leftBox2b: "one customer each",
    leftTotal: "total: 101 queries",
    rightTitle: "declared eager load",
    rightBig: "1 JOIN",
    rightMid: "100 orders + customers",
    rightSub: "one round trip",
    rightTotal: "total: 1 query",
    foot: "annotate every FK relation with its loading strategy",
    caption:
      "The ORM loads 100 orders with one query, then fetches each customer separately — 101 queries where one JOIN would do. Declaring the eager load up front collapses the same fetch into a single round trip.",
  },
  ru: {
    svgTitle: "ORM N-plus-1: 100 заказов с lazy-load дают 101 запрос там, где хватило бы одного JOIN",
    headline: "N+1: 101 ЗАПРОС ВМЕСТО 1 JOIN",
    sub: "лениво по умолчанию — аннотируй каждую связь",
    leftTitle: "ORM по умолчанию · lazy load",
    leftBox1a: "1 запрос",
    leftBox1b: "100 заказов",
    leftBox2a: "100 запросов",
    leftBox2b: "по клиенту на каждый",
    leftTotal: "итого: 101 запрос",
    rightTitle: "объявленный eager load",
    rightBig: "1 JOIN",
    rightMid: "100 заказов + клиенты",
    rightSub: "один round trip",
    rightTotal: "итого: 1 запрос",
    foot: "аннотируй каждую FK-связь стратегией загрузки",
    caption:
      "ORM загружает 100 заказов одним запросом, затем подтягивает каждого клиента отдельно — 101 запрос там, где справился бы один JOIN. Объявленная eager-загрузка заранее сворачивает ту же выборку в один round trip.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-n1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="350" height="240" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="215" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <rect x="60" y="140" width="310" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="215" y="165" text-anchor="middle" font-size="15" fill="var(--ink)">{t.leftBox1a}</text>
    <text x="215" y="185" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftBox1b}</text>
    <line x1="215" y1="202" x2="215" y2="214" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-n1-arrow)" />
    <rect x="60" y="222" width="310" height="60" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="215" y="247" text-anchor="middle" font-size="15" fill="var(--accent)">{t.leftBox2a}</text>
    <text x="215" y="267" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftBox2b}</text>
    <rect x="60" y="290" width="310" height="38" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="215" y="315" text-anchor="middle" font-size="13" fill="var(--accent)">{t.leftTotal}</text>

    <rect x="430" y="100" width="330" height="240" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="595" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    <rect x="450" y="140" width="290" height="142" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="595" y="192" text-anchor="middle" font-size="20" fill="var(--ink)">{t.rightBig}</text>
    <text x="595" y="220" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightMid}</text>
    <text x="595" y="242" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightSub}</text>
    <rect x="450" y="290" width="290" height="38" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="595" y="315" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTotal}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
