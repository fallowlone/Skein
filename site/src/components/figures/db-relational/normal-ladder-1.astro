---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Normal-form ladder: atomic cells, whole-key dependence, no transitive dependence, BCNF",
    headline: "1NF → 3NF: REMOVE DUPLICATE FACTS",
    sub: "each form strictly stronger · production target is 3NF",
    badges: ["1NF", "2NF", "3NF", "BCNF"],
    rules: ["atomic cells — one value per cell", "non-key cols depend on the WHOLE key", "no transitive dependency", "every determinant is a candidate key"],
    viols: ["split(',') parses it → violates 1NF", "product_name needs product_id only → move it", "customer_city needs customer_id → extract it", "overlapping keys — rare, target 3NF"],
    foot: "in practice 3NF is the target — each form is strictly stronger",
    caption:
      "Each normal form removes one disagreement shape: 1NF bans multi-valued cells, 2NF bans partial-key dependence, 3NF bans transitive dependence, BCNF tightens overlapping keys — production stops at 3NF.",
  },
  ru: {
    svgTitle: "Лестница нормальных форм: атомарные ячейки, полная зависимость, без транзитивности, BCNF",
    headline: "1NF → 3NF: УБРАТЬ ДУБЛИ ФАКТОВ",
    sub: "каждая форма строже · продакшн-цель — 3NF",
    badges: ["1NF", "2NF", "3NF", "BCNF"],
    rules: ["атомарные ячейки — одно значение", "неключевые зависят от ВСЕГО ключа", "нет транзитивных зависимостей", "каждый детерминант — candidate key"],
    viols: ["парсится через split(',') → нарушение 1NF", "product_name нужен лишь product_id → перенести", "customer_city нужен customer_id → извлечь", "перекрывающиеся ключи — редко, цель 3NF"],
    foot: "на практике цель — 3NF: каждая форма строго сильнее",
    caption:
      "Каждая нормальная форма убирает одну форму расхождения: 1NF запрещает многозначные ячейки, 2NF — частичную зависимость от ключа, 3NF — транзитивную зависимость, BCNF ужесточает перекрывающиеся ключи — продакшн останавливается на 3NF.",
  },
};

const t = dict[lang];

const bandY = [105, 170, 235, 300];
const bandH = 60;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-ladder-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.badges.map((b, i) => (
      <g>
        <rect x="40" y={bandY[i]} width="720" height={bandH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <rect x="56" y={bandY[i] + 12} width="90" height="36" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
        <text x="101" y={bandY[i] + 37} text-anchor="middle" font-size="15" fill="var(--accent)">{b}</text>
        <text x="162" y={bandY[i] + 27} font-size="12" fill="var(--ink)">{t.rules[i]}</text>
        <text x="162" y={bandY[i] + 47} font-size="11" fill="var(--muted)">{t.viols[i]}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
