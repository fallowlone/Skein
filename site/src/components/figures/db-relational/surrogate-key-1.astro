---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Surrogate key absorbs the change: email moves from A to B while id 7 never moves",
    headline: "EMAIL CHANGES, ID 7 DOES NOT",
    sub: "surrogate primary key absorbs the change",
    beforeTitle: "BEFORE",
    beforeRow: "id 7 · email A",
    afterTitle: "AFTER",
    afterRow: "id 7 · email B",
    afterSub: "email changed · id stable",
    panelTitle: "why it holds",
    box1Title: "UNIQUE NOT NULL on email",
    box1Sub: "natural key still guarded",
    box2Title: "FK points at id 7",
    box2Sub: "email change cascades nothing",
    foot: "natural keys change — surrogate keys never do",
    caption:
      "Surrogate primary key plus UNIQUE NOT NULL on the natural key: the customer changes email from A to B, id 7 never moves, and every foreign key still points at 7 — no cascade through referencing tables.",
  },
  ru: {
    svgTitle: "Суррогатный ключ поглощает изменение: email переезжает с A на B, а id 7 неподвижен",
    headline: "EMAIL МЕНЯЕТСЯ, ID 7 — НЕТ",
    sub: "суррогатный primary key поглощает изменение",
    beforeTitle: "БЫЛО",
    beforeRow: "id 7 · email A",
    afterTitle: "СТАЛО",
    afterRow: "id 7 · email B",
    afterSub: "email сменён · id стабилен",
    panelTitle: "почему держится",
    box1Title: "UNIQUE NOT NULL на email",
    box1Sub: "натуральный ключ защищён",
    box2Title: "FK указывает на id 7",
    box2Sub: "смена email ничего не каскадирует",
    foot: "натуральные ключи меняются — суррогатные никогда",
    caption:
      "Суррогатный primary key плюс UNIQUE NOT NULL на натуральном ключе: клиент меняет email с A на B, id 7 неподвижен, и каждый foreign key по-прежнему указывает на 7 — без каскада через ссылающиеся таблицы.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-surr-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="105" width="340" height="105" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="129" text-anchor="middle" font-size="12" fill="var(--muted)">{t.beforeTitle}</text>
    <rect x="60" y="140" width="300" height="52" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="210" y="172" text-anchor="middle" font-size="13" fill="var(--ink)">{t.beforeRow}</text>

    <line x1="210" y1="212" x2="210" y2="224" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-surr-arrow)" />

    <rect x="40" y="232" width="340" height="105" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="256" text-anchor="middle" font-size="12" fill="var(--muted)">{t.afterTitle}</text>
    <rect x="60" y="267" width="300" height="52" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="289" text-anchor="middle" font-size="13" fill="var(--ink)">{t.afterRow}</text>
    <text x="210" y="309" text-anchor="middle" font-size="11" fill="var(--muted)">{t.afterSub}</text>

    <rect x="420" y="105" width="340" height="232" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="129" text-anchor="middle" font-size="12" fill="var(--muted)">{t.panelTitle}</text>
    <rect x="440" y="145" width="300" height="70" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="173" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1Title}</text>
    <text x="590" y="195" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box1Sub}</text>
    <rect x="440" y="225" width="300" height="70" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="253" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2Title}</text>
    <text x="590" y="275" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box2Sub}</text>
    <text x="590" y="321" text-anchor="middle" font-size="11" fill="var(--accent)">id 7 = id 7</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
