---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Generated STORED column: line_total_cents computed at write, visible in the schema",
    headline: "STORED, NOT TRIGGERED",
    sub: "per-row math declared in the schema",
    leftTitle: "inputs · same row",
    in1: "unit_price_cents",
    in2: "quantity",
    resultTitle: "line_total_cents",
    resultSub: "AS (unit_price_cents × quantity) STORED",
    panelTitle: "why not a trigger",
    box1Title: "queryable + indexable",
    box1Sub: "auto-updated on every write",
    box2Title: "declared in the schema",
    box2Sub: "visible to every reader",
    box3Title: "triggers: cross-row only",
    box3Sub: "for computations across rows",
    foot: "per-row arithmetic → generated column · cross-row → trigger",
    caption:
      "A generated STORED column computes line_total_cents from unit_price_cents and quantity at write time: queryable, indexable, and declared in the schema where every reader sees it. Triggers stay for computations that reach across rows.",
  },
  ru: {
    svgTitle: "Generated STORED колонка: line_total_cents считается при записи, видна в схеме",
    headline: "STORED, А НЕ ТРИГГЕР",
    sub: "per-row арифметика, объявленная в схеме",
    leftTitle: "входы · та же строка",
    in1: "unit_price_cents",
    in2: "quantity",
    resultTitle: "line_total_cents",
    resultSub: "AS (unit_price_cents × quantity) STORED",
    panelTitle: "почему не триггер",
    box1Title: "запрашиваемая + индексируемая",
    box1Sub: "обновляется при каждой записи",
    box2Title: "объявлена в схеме",
    box2Sub: "видна каждому читателю",
    box3Title: "триггеры: только cross-row",
    box3Sub: "для вычислений между строками",
    foot: "per-row арифметика → generated колонка · cross-row → триггер",
    caption:
      "Generated STORED колонка вычисляет line_total_cents из unit_price_cents и quantity при записи: запрашиваемая, индексируемая и объявленная в схеме, где её видит каждый читатель. Триггеры остаются для вычислений, выходящих за пределы строки.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-gen-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="360" height="240" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="220" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <rect x="60" y="140" width="320" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="220" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.in1}</text>
    <rect x="60" y="196" width="320" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="220" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.in2}</text>
    <line x1="220" y1="242" x2="220" y2="254" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-gen-arrow)" />
    <rect x="60" y="262" width="320" height="60" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="220" y="287" text-anchor="middle" font-size="14" fill="var(--ink)">{t.resultTitle}</text>
    <text x="220" y="308" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resultSub}</text>

    <rect x="420" y="100" width="340" height="240" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.panelTitle}</text>
    <rect x="440" y="140" width="300" height="52" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1Title}</text>
    <text x="590" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box1Sub}</text>
    <rect x="440" y="200" width="300" height="52" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2Title}</text>
    <text x="590" y="242" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box2Sub}</text>
    <rect x="440" y="260" width="300" height="52" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="282" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3Title}</text>
    <text x="590" y="302" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box3Sub}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
