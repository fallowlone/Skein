---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "JSONB index choice: GIN for containment over many paths, expression B-tree for one path",
    headline: "GIN OR B-TREE? ASK THE QUERY",
    sub: "containment over many paths → GIN · one path equality → B-tree",
    ginTitle: "GIN — many paths",
    ginOps: ["@>", "?", "?|", "?&amp;"],
    ginExample: "contains key or value X?",
    ginNote: "jsonb_path_ops: @> only · faster · smaller",
    ginIdx: "idx_events_payload",
    btreeTitle: "expression B-tree — one path",
    btreeExample: "((payload->>'user_id'))",
    btreeSub: "equality and range on that path",
    btreeIdx: "idx_events_user_id",
    btreeOps: "=, range, BETWEEN",
    barLine: "GIN is 5-20x larger than B-tree · wrong index runs 10-100x slower",
    foot: "GIN asks containment · B-tree asks one extracted value",
    caption:
      "GIN indexes every key for containment and existence operators (?, ?|, ?&amp;, @>); an expression B-tree indexes one extracted path for equality and range. GIN costs 5-20x the size — the wrong family runs 10-100x slower.",
  },
  ru: {
    svgTitle: "Выбор JSONB-индекса: GIN для containment по путям, expression B-tree для одного пути",
    headline: "GIN ИЛИ B-TREE? СПРОСИ ЗАПРОС",
    sub: "containment по многим путям → GIN · равенство пути → B-tree",
    ginTitle: "GIN — много путей",
    ginOps: ["@>", "?", "?|", "?&amp;"],
    ginExample: "содержит ключ или значение X?",
    ginNote: "jsonb_path_ops: только @> · быстрее · меньше",
    ginIdx: "idx_events_payload",
    btreeTitle: "expression B-tree — один путь",
    btreeExample: "((payload->>'user_id'))",
    btreeSub: "равенство и диапазон по этому пути",
    btreeIdx: "idx_events_user_id",
    btreeOps: "=, диапазон, BETWEEN",
    barLine: "GIN в 5-20 раз больше B-tree · неверный индекс медленнее в 10-100 раз",
    foot: "GIN отвечает containment · B-tree отвечает одним извлечённым значением",
    caption:
      "GIN индексирует каждый ключ для операторов containment и наличия (?, ?|, ?&amp;, @>); expression B-tree индексирует один извлечённый путь для равенства и диапазона. GIN стоит в 5-20 раз больше места — неверное семейство работает в 10-100 раз медленнее.",
  },
};

const t = dict[lang];

const chipX = [60, 137, 214, 291];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-gin-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="350" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="215" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ginTitle}</text>
    {t.ginOps.map((o, i) => (
      <g>
        <rect x={chipX[i]} y="142" width="72" height="32" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={chipX[i] + 36} y="164" text-anchor="middle" font-size="12" fill="var(--ink)">{o}</text>
      </g>
    ))}
    <text x="215" y="212" text-anchor="middle" font-size="12" fill="var(--accent)">{t.ginExample}</text>
    <text x="215" y="236" text-anchor="middle" font-size="11" fill="var(--muted)">{t.ginNote}</text>
    <text x="215" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.ginIdx}</text>

    <rect x="410" y="100" width="350" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="585" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.btreeTitle}</text>
    <rect x="430" y="142" width="310" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="585" y="170" text-anchor="middle" font-size="12" fill="var(--ink)">{t.btreeExample}</text>
    <text x="585" y="222" text-anchor="middle" font-size="12" fill="var(--accent)">{t.btreeSub}</text>
    <text x="585" y="246" text-anchor="middle" font-size="11" fill="var(--muted)">{t.btreeIdx}</text>
    <text x="585" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.btreeOps}</text>

    <rect x="40" y="306" width="720" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="334" text-anchor="middle" font-size="12" fill="var(--ink)">{t.barLine}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
