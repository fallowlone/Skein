---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Relation anatomy: shared shape, per-attribute domains, one candidate key as primary key",
    headline: "A RELATION: ONE SHAPE, MANY TUPLES",
    sub: "every tuple shares the same attributes · each attribute draws from one domain",
    tableTitle: "users · relation (table)",
    panelTitle: "shape + identity",
    colId: "id",
    colEmail: "email",
    rowIds: ["1", "2", "3"],
    rowEmails: ["user 1", "user 2", "user 3"],
    setTitle: "a SET of tuples",
    setSub: "no duplicates, no order",
    box1Title: "candidate key → primary key",
    box1Sub: "minimal subset identifying every tuple",
    box2Title: "attribute ← domain (a type)",
    box2Sub: "one named typed value per row",
    box3Title: "PRIMARY KEY = NOT NULL + UNIQUE",
    box3Sub: "refuses nulls and duplicates",
    foot: "a relation is a set of tuples sharing one shape · the key identifies every tuple",
    caption:
      "A relation is a set of tuples sharing one fixed shape: every tuple carries the same attributes, each attribute draws values from a single domain, and one candidate key is designated the primary key — NOT NULL and UNIQUE together.",
  },
  ru: {
    svgTitle: "Анатомия отношения: общая форма, домены атрибутов, один candidate key как primary key",
    headline: "ОТНОШЕНИЕ: ОДНА ФОРМА, МНОГО КОРТЕЖЕЙ",
    sub: "каждый кортеж делит атрибуты · каждый атрибут берёт значения из домена",
    tableTitle: "users · отношение (таблица)",
    panelTitle: "форма + идентичность",
    colId: "id",
    colEmail: "email",
    rowIds: ["1", "2", "3"],
    rowEmails: ["user 1", "user 2", "user 3"],
    setTitle: "НАБОР кортежей",
    setSub: "нет дублей, нет порядка",
    box1Title: "candidate key → primary key",
    box1Sub: "минимальный идентификатор кортежа",
    box2Title: "атрибут ← домен (тип)",
    box2Sub: "одно типизированное значение в строке",
    box3Title: "PRIMARY KEY = NOT NULL + UNIQUE",
    box3Sub: "отказывает null и дублям",
    foot: "отношение — набор кортежей общей формы · ключ идентифицирует каждый кортеж",
    caption:
      "Отношение — это набор кортежей общей фиксированной формы: каждый кортеж несёт те же атрибуты, каждый атрибут берёт значения из одного домена, а один candidate key назначается primary key — NOT NULL и UNIQUE вместе.",
  },
};

const t = dict[lang];

const rowY = [176, 210, 244];
const rowH = 30;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-anatomy-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="300" height="236" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="190" y="124" text-anchor="middle" font-size="13" fill="var(--ink)">{t.tableTitle}</text>
    <rect x="60" y="140" width="90" height="30" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="105" y="161" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colId}</text>
    <rect x="150" y="140" width="170" height="30" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="235" y="161" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colEmail}</text>
    {t.rowIds.map((r, i) => (
      <g>
        <rect x="60" y={rowY[i]} width="90" height={rowH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="105" y={rowY[i] + 21} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
        <rect x="150" y={rowY[i]} width="170" height={rowH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="235" y={rowY[i] + 21} text-anchor="middle" font-size="11" fill="var(--ink)">{t.rowEmails[i]}</text>
      </g>
    ))}
    <rect x="60" y="286" width="260" height="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="190" y="302" text-anchor="middle" font-size="12" fill="var(--ink)">{t.setTitle}</text>
    <text x="190" y="318" text-anchor="middle" font-size="11" fill="var(--muted)">{t.setSub}</text>

    <line x1="342" y1="218" x2="392" y2="218" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-anatomy-arrow)" />

    <rect x="400" y="100" width="360" height="236" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="580" y="124" text-anchor="middle" font-size="13" fill="var(--muted)">{t.panelTitle}</text>
    <rect x="420" y="140" width="320" height="58" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="580" y="164" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1Title}</text>
    <text x="580" y="184" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box1Sub}</text>
    <rect x="420" y="206" width="320" height="58" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="580" y="230" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2Title}</text>
    <text x="580" y="250" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box2Sub}</text>
    <rect x="420" y="272" width="320" height="58" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="580" y="296" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3Title}</text>
    <text x="580" y="316" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box3Sub}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
