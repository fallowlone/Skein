---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Circular foreign keys need deferral: neither row inserts first unless checks wait for COMMIT",
    headline: "CIRCULAR FK NEEDS DEFERRAL",
    sub: "A needs B · B needs A — defer checks to COMMIT",
    aTitle: "table A",
    aFk: "b_id → B (FK)",
    bTitle: "table B",
    bFk: "a_id → A (FK)",
    midLine: "IMMEDIATE: neither inserts first",
    steps: ["1 · INSERT A · deferred OK", "2 · INSERT B · now consistent", "3 · COMMIT · checks pass"],
    foot: "deferred violations abort at COMMIT — use sparingly",
    caption:
      "With a circular dependency neither row inserts first under IMMEDIATE checks; declared DEFERRABLE INITIALLY DEFERRED, both inserts land and both foreign keys are verified once at COMMIT.",
  },
  ru: {
    svgTitle: "Циклические ключи требуют deferral: ни одна строка не вставится первой без проверки при COMMIT",
    headline: "ЦИКЛИЧЕСКИЙ FK ТРЕБУЕТ DEFERRAL",
    sub: "A нужен B · B нужен A — отложи проверки до COMMIT",
    aTitle: "таблица A",
    aFk: "b_id → B (FK)",
    bTitle: "таблица B",
    bFk: "a_id → A (FK)",
    midLine: "IMMEDIATE: ни одна строка не вставится первой",
    steps: ["1 · INSERT A · deferred OK", "2 · INSERT B · уже согласовано", "3 · COMMIT · проверки пройдены"],
    foot: "отложенные нарушения откатывают COMMIT — используй экономно",
    caption:
      "При циклической зависимости ни одна строка не вставится первой при IMMEDIATE-проверках; объявленные DEFERRABLE INITIALLY DEFERRED, обе вставки проходят, а оба foreign key проверяются один раз при COMMIT.",
  },
};

const t = dict[lang];

const stepX = [40, 287, 534];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-def-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="60" y="110" width="280" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="200" y="140" text-anchor="middle" font-size="13" fill="var(--ink)">{t.aTitle}</text>
    <text x="200" y="180" text-anchor="middle" font-size="13" fill="var(--accent)">{t.aFk}</text>

    <rect x="460" y="110" width="280" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="600" y="140" text-anchor="middle" font-size="13" fill="var(--ink)">{t.bTitle}</text>
    <text x="600" y="180" text-anchor="middle" font-size="13" fill="var(--accent)">{t.bFk}</text>

    <line x1="342" y1="140" x2="452" y2="140" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-def-arrow)" />
    <line x1="458" y1="196" x2="348" y2="196" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbrel-def-arrow)" />

    <text x="400" y="254" text-anchor="middle" font-size="12" fill="var(--muted)">{t.midLine}</text>

    {t.steps.map((s, i) => (
      <g>
        <rect x={stepX[i]} y="270" width="226" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={stepX[i] + 113} y="306" text-anchor="middle" font-size="11" fill="var(--ink)">{s}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
