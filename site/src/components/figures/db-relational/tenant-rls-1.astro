---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Row-level isolation: every row carries workspace_id and RLS filters by session",
    headline: "ONE TABLE, TENANT-SCOPED",
    sub: "every row carries workspace_id · RLS filters by session",
    leftTitle: "projects · all tenants",
    rows: ["proj 1 · ws 1", "proj 2 · ws 1", "proj 3 · ws 2"],
    leftStrip: "this connection sees ws 1 only",
    rightTitle: "RLS policy",
    box1Title: "workspace_id = current_setting(...)",
    box1Sub: "set once after login",
    box2Title: "SET app.current_workspace_id = 1",
    box2Sub: "session scope for every query",
    strip: "missed WHERE → still only ws 1",
    foot: "RLS is the net · CI lint is the signal",
    caption:
      "Every tenanted row carries workspace_id; the connection sets app.current_workspace_id once after login and the RLS policy filters every query to it — an application query that forgets WHERE still returns only its own workspace.",
  },
  ru: {
    svgTitle: "Построчная изоляция: каждая строка несёт workspace_id, а RLS фильтрует по сессии",
    headline: "ОДНА ТАБЛИЦА, СКОУП ТЕНАНТА",
    sub: "каждая строка несёт workspace_id · RLS фильтрует по сессии",
    leftTitle: "projects · все тенанты",
    rows: ["proj 1 · ws 1", "proj 2 · ws 1", "proj 3 · ws 2"],
    leftStrip: "это соединение видит только ws 1",
    rightTitle: "RLS-политика",
    box1Title: "workspace_id = current_setting(...)",
    box1Sub: "устанавливается после входа",
    box2Title: "SET app.current_workspace_id = 1",
    box2Sub: "скоп сессии для каждого запроса",
    strip: "WHERE забыт → всё равно только ws 1",
    foot: "RLS — страховка · CI-линт — сигнал",
    caption:
      "Каждая тенантная строка несёт workspace_id; соединение один раз после входа устанавливает app.current_workspace_id, а RLS-политика фильтрует каждый запрос под него — запрос приложения без WHERE всё равно вернёт только свой workspace.",
  },
};

const t = dict[lang];

const rowY = [142, 178, 214];
const rowFill = ["var(--paper)", "var(--paper)", "var(--card)"];
const rowInk = ["var(--ink)", "var(--ink)", "var(--muted)"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbrel-rls-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="360" height="240" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="220" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    {t.rows.map((r, i) => (
      <g>
        <rect x="60" y={rowY[i]} width="320" height="32" fill={rowFill[i]} stroke="var(--ink)" stroke-width="1.5" />
        <text x="220" y={rowY[i] + 22} text-anchor="middle" font-size="12" fill={rowInk[i]}>{r}</text>
      </g>
    ))}
    <rect x="60" y="262" width="320" height="56" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="220" y="297" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftStrip}</text>

    <rect x="420" y="100" width="340" height="240" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    <rect x="440" y="140" width="300" height="56" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="163" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Title}</text>
    <text x="590" y="183" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box1Sub}</text>
    <rect x="440" y="204" width="300" height="56" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="227" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Title}</text>
    <text x="590" y="247" text-anchor="middle" font-size="11" fill="var(--muted)">{t.box2Sub}</text>
    <rect x="440" y="268" width="300" height="52" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="300" text-anchor="middle" font-size="12" fill="var(--ink)">{t.strip}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
