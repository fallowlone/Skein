---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Jump Game II on [2,3,1,1,4]: levels {0}, {1,2}, {3,4}; path 0 to 1 to 4, minimum 2 jumps",
    headline: "MINIMUM JUMPS AS LEVEL EXPANSION",
    sub: "with k jumps you stand on level k · spend a jump at each edge",
    result: "path 0 → 1 → 4 · minimum 2 jumps",
    rowIdx: "index i",
    level: "level",
    note: "spend a jump exactly when i reaches the level edge",
    caption:
      "Jump Game II on [2,3,1,1,4]: level 0 holds index 0, level 1 holds 1–2 (everything 1 jump reaches from index 0), level 2 holds 3–4. The optimal path 0 → 1 → 4 spends 2 jumps, one per level edge.",
  },
  ru: {
    svgTitle: "Jump Game II на [2,3,1,1,4]: уровни {0}, {1,2}, {3,4}; путь 0 в 1 в 4, минимум 2 прыжка",
    headline: "МИНИМУМ ПРЫЖКОВ КАК РАСШИРЕНИЕ ПО УРОВНЯМ",
    sub: "с k прыжками ты стоишь на уровне k · трать прыжок на каждом краю",
    result: "путь 0 → 1 → 4 · минимум 2 прыжка",
    rowIdx: "индекс i",
    level: "уровень",
    note: "трать прыжок ровно когда i достигает края уровня",
    caption:
      "Jump Game II на [2,3,1,1,4]: уровень 0 держит индекс 0, уровень 1 держит 1–2 (всё что 1 прыжок достаёт с индекса 0), уровень 2 держит 3–4. Оптимальный путь 0 → 1 → 4 тратит 2 прыжка, по одному на край уровня.",
  },
};

const t = dict[lang];

const idx = ["0", "1", "2", "3", "4"];
const nums = ["2", "3", "1", "1", "4"];
const bands = [
  { from: 0, to: 0, j: "0" },
  { from: 1, to: 2, j: "1" },
  { from: 3, to: 4, j: "2" },
];

const x0 = 130;
const cw = 80;
const step = 130;
const cellX = (i: number) => x0 + i * step;
const cellCX = (i: number) => x0 + i * step + cw / 2;
const bandX = (from: number) => cellX(from) - 12;
const bandW = (from: number, to: number) => (to - from) * step + cw + 24;
const bandCX = (from: number, to: number) => bandX(from) + bandW(from, to) / 2;

const topY = 200;
const midY = 150;
const hiY = 118;
const hopX = cellCX(1) - 18;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>
    <text x="400" y="92" text-anchor="middle" font-size="14" fill="var(--accent)">{t.result}</text>

    {bands.map((b) => (
      <rect x={bandX(b.from)} y="188" width={bandW(b.from, b.to)} height={104} rx="8" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    ))}

    {nums.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={topY} width={cw} height={48} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellCX(i)} y={topY + 31} text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <line x1={cellCX(0)} y1={topY} x2={cellCX(0)} y2={midY} stroke="var(--accent)" stroke-width="2" />
    <line x1={cellCX(0)} y1={midY} x2={cellCX(1)} y2={midY} stroke="var(--accent)" stroke-width="2" />
    <line x1={cellCX(1)} y1={midY} x2={cellCX(1)} y2={topY} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${cellCX(1) - 7},${topY - 7} ${cellCX(1) + 7},${topY - 7} ${cellCX(1)},${topY}`} fill="var(--accent)" />

    <line x1={hopX} y1={topY} x2={hopX} y2={hiY} stroke="var(--accent)" stroke-width="2" />
    <line x1={hopX} y1={hiY} x2={cellCX(4)} y2={hiY} stroke="var(--accent)" stroke-width="2" />
    <line x1={cellCX(4)} y1={hiY} x2={cellCX(4)} y2={topY} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${cellCX(4) - 7},${topY - 7} ${cellCX(4) + 7},${topY - 7} ${cellCX(4)},${topY}`} fill="var(--accent)" />

    {idx.map((v, i) => (
      <text x={cellCX(i)} y="270" text-anchor="middle" font-size="12" fill="var(--muted)">{`${t.rowIdx} ${v}`}</text>
    ))}

    {bands.map((b) => (
      <text x={bandCX(b.from, b.to)} y="312" text-anchor="middle" font-size="13" fill="var(--ink)">{`${t.level} ${b.j}`}</text>
    ))}

    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
