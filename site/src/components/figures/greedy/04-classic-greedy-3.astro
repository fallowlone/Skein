---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Gas Station circuit A: nets minus 2, minus 2, minus 2, plus 3, plus 3; resets land on start 3",
    headline: "RUN DRY? SKIP THE WHOLE STRETCH",
    sub: "circuit A: gas minus cost per station · total decides feasibility",
    resetRule: "tank < 0 → start = i + 1, tank = 0",
    rowNet: "net",
    rowTank: "tank",
    verdictTotal: "total",
    verdictAnswer: "answer",
    note: "running dry from start to i disqualifies every station between",
    caption:
      "Gas Station circuit A with nets -2, -2, -2, +3, +3 and total 0 ≥ 0, so a start exists. Candidates S0, S1, S2 each run the tank negative and reset to i + 1; S3 survives through S4, so the answer is 3.",
  },
  ru: {
    svgTitle: "Gas Station круг A: чистый газ минус 2, минус 2, минус 2, плюс 3, плюс 3; сбросы ведут к старту 3",
    headline: "ИССЯК? ПРОПУСТИ ВЕСЬ ОТРЕЗОК",
    sub: "круг A: газ минус стоимость на заправку · сумма решает выполнимость",
    resetRule: "бак < 0 → старт = i + 1, бак = 0",
    rowNet: "чистое",
    rowTank: "бак",
    verdictTotal: "сумма",
    verdictAnswer: "ответ",
    note: "иссякание от start к i дисквалифицирует каждую заправку между",
    caption:
      "Gas Station круг A с чистым газом -2, -2, -2, +3, +3 и суммой 0 ≥ 0, так что старт существует. Кандидаты S0, S1, S2 каждый уводят бак в минус и сбрасываются на i + 1; S3 выживает через S4, так что ответ 3.",
  },
};

const t = dict[lang];

const stations = ["S0", "S1", "S2", "S3", "S4"];
const nets = ["-2", "-2", "-2", "+3", "+3"];
const tanks = ["-2", "-2", "-2", "+3", "+6"];
const failed = [true, true, true, false, false];
const resets = [0, 1, 2];
const total = "0";
const answer = "3";

const x0 = 110;
const cw = 104;
const step = 134;
const cardY = 110;
const cardH = 100;
const cardX = (i: number) => x0 + i * step;
const cardCX = (i: number) => x0 + i * step + cw / 2;
const arrowY = cardY + 50;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>
    <text x="400" y="90" text-anchor="middle" font-size="13" fill="var(--accent)">{t.resetRule}</text>

    {stations.map((s, i) => (
      <g>
        <rect x={cardX(i)} y={cardY} width={cw} height={cardH} fill={failed[i] ? "var(--card)" : "var(--accent)"} stroke="var(--ink)" stroke-width="2" />
        <text x={cardCX(i)} y={cardY + 30} text-anchor="middle" font-size="15" fill={failed[i] ? "var(--ink)" : "var(--card)"}>{s}</text>
        <text x={cardCX(i)} y={cardY + 58} text-anchor="middle" font-size="22" fill={failed[i] ? "var(--ink)" : "var(--card)"}>{nets[i]}</text>
        <text x={cardCX(i)} y={cardY + 82} text-anchor="middle" font-size="12" fill={failed[i] ? "var(--muted)" : "var(--card)"}>{t.rowNet}</text>
      </g>
    ))}

    {resets.map((k) => (
      <g>
        <line x1={cardX(k) + cw} y1={arrowY} x2={cardX(k + 1)} y2={arrowY} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${cardX(k + 1) - 7},${arrowY - 5} ${cardX(k + 1) - 7},${arrowY + 5} ${cardX(k + 1)},${arrowY}`} fill="var(--accent)" />
      </g>
    ))}

    <text x="98" y="252" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowTank}</text>
    {tanks.map((v, i) => (
      <text x={cardCX(i)} y="252" text-anchor="middle" font-size="15" fill={failed[i] ? "var(--accent)" : "var(--ink)"}>{v}</text>
    ))}

    <text x="400" y="310" text-anchor="middle" font-size="16" fill="var(--ink)">{`${t.verdictTotal} ${total} ≥ 0 → ${t.verdictAnswer} ${answer}`}</text>
    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
