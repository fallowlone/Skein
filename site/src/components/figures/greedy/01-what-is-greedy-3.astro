---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Greedy is correct only with the greedy-choice property and optimal substructure, and costs O of n log n",
    headline: "CORRECT ONLY WITH BOTH PROPERTIES",
    sub: "if either is missing, greedy can lose silently",
    condTitle: ["1 · greedy-choice property", "2 · optimal substructure"],
    condBody: [
      "an optimum can always start with the locally-best choice",
      "an optimum contains optima of its subproblems",
    ],
    sortWord: "sort",
    scanWord: "scan",
    dpNote: "DP coin change",
    note: "greedy must be proven, never assumed",
    caption:
      "Greedy is optimal only with the greedy-choice property (an optimum can always start with the locally-best choice) and optimal substructure (an optimum contains optima of its subproblems). Cost is O(n log n) = sort + O(n) scan, far cheaper than DP coin change at O(coins x amount) — but only when both properties hold.",
  },
  ru: {
    svgTitle: "Жадный корректен только со свойством жадного выбора и оптимальной подструктурой, стоимость O от n log n",
    headline: "КОРРЕКТЕН ТОЛЬКО С ОБОИМИ СВОЙСТВАМИ",
    sub: "если любого нет, жадный может тихо проиграть",
    condTitle: ["1 · свойство жадного выбора", "2 · оптимальная подструктура"],
    condBody: [
      "оптимум всегда может начинаться с локально лучшего",
      "оптимум содержит оптимумы своих подзадач",
    ],
    sortWord: "сортировка",
    scanWord: "проход",
    dpNote: "DP размен монет",
    note: "жадный надо доказывать, никогда не предполагать",
    caption:
      "Жадный оптимален только со свойством жадного выбора (оптимум всегда может начинаться с локально лучшего) и оптимальной подструктурой (оптимум содержит оптимумы своих подзадач). Стоимость O(n log n) = сортировка + проход O(n) — намного дешевле DP размена монет за O(coins x amount), но только когда держатся оба свойства.",
  },
};

const t = dict[lang];

const boxY = [84, 180];
const total = "O(n log n)";
const scan = "O(n)";
const dpCost = "O(coins x amount)";
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.condTitle.map((ct, i) => (
      <g>
        <rect x="70" y={boxY[i]} width="660" height="80" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="400" y={boxY[i] + 30} text-anchor="middle" font-size="14" fill="var(--ink)">{ct}</text>
        <text x="400" y={boxY[i] + 56} text-anchor="middle" font-size="12" fill="var(--muted)">{t.condBody[i]}</text>
      </g>
    ))}

    <rect x="70" y="276" width="660" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="304" text-anchor="middle" font-size="14" fill="var(--ink)">{total} = {t.sortWord} + {scan} {t.scanWord}</text>
    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.dpNote}: {dpCost}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--ink)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
