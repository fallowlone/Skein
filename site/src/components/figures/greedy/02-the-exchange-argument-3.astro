---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Coins {1,3,4} for 6: greedy takes 3 coins, optimum takes 2, no valid exchange",
    headline: "NO SWAP WORKS — GREEDY IS UNSAFE",
    sub: "coins {1, 3, 4} · amount 6",
    greedyTag: "greedy",
    greedyNote: "grabs 4, then 1 + 1",
    greedyTotal: "= 3 coins",
    optTag: "optimum",
    optNote: "3 + 3",
    optTotal: "= 2 coins",
    swapFail: "swap a 3 for a 4: overshoots — no valid exchange",
    verdict: "greedy 3 vs optimum 2 → greedy unsafe here",
    caption:
      "Greedy on {1,3,4} for 6 grabs 4 then needs 1+1: 3 coins, while the optimum is 3+3: 2 coins. Removing a 3 and adding a 4 overshoots, so no exchange exists — the failed exchange predicts greedy is wrong.",
  },
  ru: {
    svgTitle: "Монеты {1,3,4} для 6: жадный берёт 3 монеты, оптимум 2, допустимого обмена нет",
    headline: "ОБМЕН НЕ РАБОТАЕТ — ЖАДНЫЙ НЕБЕЗОПАСЕН",
    sub: "монеты {1, 3, 4} · сумма 6",
    greedyTag: "жадный",
    greedyNote: "хватает 4, потом 1 + 1",
    greedyTotal: "= 3 монеты",
    optTag: "оптимум",
    optNote: "3 + 3",
    optTotal: "= 2 монеты",
    swapFail: "замена тройки на четвёрку: перелёт — допустимого обмена нет",
    verdict: "жадный: 3 против оптимальных 2 → жадный здесь небезопасен",
    caption:
      "Жадный на {1,3,4} для 6 хватает 4, потом нуждается в 1+1: 3 монеты, тогда как оптимум это 3+3: 2 монеты. Убрать тройку и добавить четвёрку это перелёт, так что обмена нет — проваленный обмен предсказывает, что жадный неправ.",
  },
};

const t = dict[lang];

const greedy = ["4", "1", "1"];
const opt = ["3", "3"];
const greedyCX = [300, 400, 500];
const optCX = [350, 450];
const greedyCY = 130;
const optCY = 230;
const coinR = 30;
const cross = "✕";
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    <text x="180" y="138" text-anchor="end" font-size="13" fill="var(--ink)">{t.greedyTag}</text>
    {greedy.map((v, i) => (
      <g>
        <circle cx={greedyCX[i]} cy={greedyCY} r={coinR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={greedyCX[i]} y={greedyCY + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="552" y="124" font-size="13" fill="var(--ink)">{t.greedyTotal}</text>
    <text x="552" y="148" font-size="12" fill="var(--muted)">{t.greedyNote}</text>

    <line x1="354" y1="196" x2="392" y2="166" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" />
    <polygon points="393,171 388,164 400,160" fill="var(--accent)" />
    <text x="377" y="186" text-anchor="middle" font-size="18" fill="var(--accent)">{cross}</text>

    <text x="180" y="238" text-anchor="end" font-size="13" fill="var(--ink)">{t.optTag}</text>
    {opt.map((v, i) => (
      <g>
        <circle cx={optCX[i]} cy={optCY} r={coinR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={optCX[i]} y={optCY + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="502" y="224" font-size="13" fill="var(--ink)">{t.optTotal}</text>
    <text x="502" y="248" font-size="12" fill="var(--muted)">{t.optNote}</text>

    <text x="400" y="300" text-anchor="middle" font-size="12" fill="var(--ink)">{t.swapFail}</text>

    <rect x="170" y="326" width="460" height="40" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="351" text-anchor="middle" font-size="12" fill="var(--card)">{t.verdict}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
