---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Exchange argument in three moves: reshape optimal O toward greedy choice G",
    headline: "RESHAPE THE OPTIMUM TOWARD GREEDY",
    sub: "assume optimal O · exchange X → G · conclude O′ optimal",
    oTag: "O: optimal, starts with X",
    swap: "swap X → G",
    opTag: "O′: optimal, starts with G",
    rest: "rest…",
    check1: "feasible — still valid",
    check2: "no worse — same value",
    verdict: "G is safe: an optimum with the greedy pick exists",
    caption:
      "The exchange argument in three moves: assume an optimal O that starts with X instead of greedy's G, exchange X for G to get O′, and conclude O′ is optimal because it stays feasible and no worse — so a greedy-aligned optimum exists.",
  },
  ru: {
    svgTitle: "Аргумент обмена в трёх ходах: переформуй оптимальный O к жадному выбору G",
    headline: "ПЕРЕФОРМУЙ ОПТИМУМ К ЖАДНОМУ",
    sub: "предположи оптимальный O · обмен X → G · заключи: O′ оптимален",
    oTag: "O: оптимален, начинается с X",
    swap: "обмен X → G",
    opTag: "O′: оптимален, начинается с G",
    rest: "остаток…",
    check1: "допустимо — всё ещё корректно",
    check2: "не хуже — то же значение",
    verdict: "G безопасен: оптимум с жадным выбором существует",
    caption:
      "Аргумент обмена в трёх ходах: предположи оптимальный O, который начинается с X вместо жадной G, обменяй X на G, чтобы получить O′, и заключи, что O′ оптимален, потому что он остаётся допустимым и не хуже — значит оптимум, согласованный с жадным, существует.",
  },
};

const t = dict[lang];

const symO = "O";
const symOp = "O′";
const symX = "X";
const symG = "G";

const cellIdx = [0, 1, 2];
const boxX = [210, 310, 430];
const boxW = [90, 110, 110];
const oRowY = 96;
const opRowY = 210;
const boxH = 52;
const arrowCX = 255;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    <text x="192" y="128" text-anchor="end" font-size="16" fill="var(--ink)">{symO}</text>
    {cellIdx.map((i) => (
      <g>
        <rect x={boxX[i]} y={oRowY} width={boxW[i]} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={boxX[i] + boxW[i] / 2} y={oRowY + 33} text-anchor="middle" font-size="15" fill="var(--ink)">{i === 0 ? symX : t.rest}</text>
      </g>
    ))}
    <text x="560" y="128" font-size="12" fill="var(--muted)">{t.oTag}</text>

    <line x1={arrowCX} y1="158" x2={arrowCX} y2="203" stroke="var(--accent)" stroke-width="2" />
    <polygon points="248,203 262,203 255,210" fill="var(--accent)" />
    <text x="270" y="190" font-size="12" fill="var(--ink)">{t.swap}</text>

    <text x="192" y="242" text-anchor="end" font-size="16" fill="var(--ink)">{symOp}</text>
    {cellIdx.map((i) => (
      <g>
        <rect x={boxX[i]} y={opRowY} width={boxW[i]} height={boxH} fill={i === 0 ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={boxX[i] + boxW[i] / 2} y={opRowY + 33} text-anchor="middle" font-size="15" fill={i === 0 ? "var(--card)" : "var(--ink)"}>{i === 0 ? symG : t.rest}</text>
      </g>
    ))}
    <text x="560" y="242" font-size="12" fill="var(--muted)">{t.opTag}</text>

    <rect x="160" y="296" width="230" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="275" y="321" text-anchor="middle" font-size="12" fill="var(--ink)">{t.check1}</text>
    <rect x="400" y="296" width="230" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="515" y="321" text-anchor="middle" font-size="12" fill="var(--ink)">{t.check2}</text>

    <rect x="180" y="348" width="440" height="40" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="373" text-anchor="middle" font-size="13" fill="var(--card)">{t.verdict}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
