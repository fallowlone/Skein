---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Activity selection by earliest finish time, take and skip sweep",
    headline: "EARLIEST FINISH FIRST, SKIP WHAT CLASHES",
    sub: "sort by finish · take when start ≥ lastEnd",
    take: "take",
    skip: "skip",
    gate: "lastEnd =",
    note: "the earliest finish leaves the most room behind it",
    capA: "Finish order:",
    capTaken: "taken, gate at",
    capAnd: "and",
    capSkipped: "start before it and are skipped.",
    capSkippedOne: "starts before it and is skipped.",
    capMax: "Maximum:",
    capIvs: "intervals.",
  },
  ru: {
    svgTitle: "Выбор активностей по раннему завершению, проход со взятиями и пропусками",
    headline: "РАНЬШЕ ВСЕХ КОНЕЦ — ПЕРВЫМ, КОНФЛИКТ — ВОН",
    sub: "сортируй по концу · бери когда начало ≥ lastEnd",
    take: "бери",
    skip: "пропуск",
    gate: "lastEnd =",
    note: "ранний конец оставляет за собой больше всего места",
    capA: "Порядок завершения:",
    capTaken: "взят, ворота на",
    capAnd: "и",
    capSkipped: "начинаются раньше и пропущены.",
    capSkippedOne: "начинается раньше и пропущен.",
    capMax: "Максимум:",
    capIvs: "интервала.",
  },
};

const t = dict[lang];

interface Row {
  iv: string;
  s: number;
  e: number;
  take: boolean;
}

const rows: Row[] = [
  { iv: "[1,4]", s: 1, e: 4, take: true },
  { iv: "[3,5]", s: 3, e: 5, take: false },
  { iv: "[2,6]", s: 2, e: 6, take: false },
  { iv: "[5,7]", s: 5, e: 7, take: true },
  { iv: "[6,8]", s: 6, e: 8, take: false },
];

const ticks = [0, 1, 2, 3, 4, 5, 6, 7, 8];
const res = "2";

const X = (v: number) => 170 + v * 60;
const rowY = (i: number) => 100 + i * 44;
const gates = [
  { v: "4", x: X(4), y1: 134, y2: 216, ly: 230 },
  { v: "7", x: X(7), y1: 276, y2: 322, ly: 336 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <line x1="170" y1="94" x2="650" y2="94" stroke="var(--ink)" stroke-width="1" />
    {ticks.map((v) => (
      <g>
        <line x1={X(v)} y1="94" x2={X(v)} y2="100" stroke="var(--ink)" stroke-width="1" />
        <text x={X(v)} y="86" text-anchor="middle" font-size="11" fill="var(--muted)">{v}</text>
      </g>
    ))}

    {rows.map((r, i) => (
      <g>
        <text x="160" y={rowY(i) + 19} text-anchor="end" font-size="13" fill="var(--ink)">{r.iv}</text>
        <rect x={X(r.s)} y={rowY(i)} width={(r.e - r.s) * 60} height="28" fill={r.take ? "var(--accent)" : "var(--card)"} stroke={r.take ? "var(--accent)" : "var(--muted)"} stroke-width="2" stroke-dasharray={r.take ? undefined : "6 4"} />
        <text x="660" y={rowY(i) + 19} font-size="12" fill={r.take ? "var(--accent)" : "var(--muted)"}>{r.take ? t.take : t.skip}</text>
      </g>
    ))}

    {gates.map((g) => (
      <g>
        <line x1={g.x} y1={g.y1} x2={g.x} y2={g.y2} stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="5 4" />
        <text x={g.x} y={g.ly} text-anchor="middle" font-size="12" fill="var(--ink)">{t.gate} {g.v}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.capA} {rows[0].iv} {t.capTaken} {gates[0].v} — {rows[1].iv} {t.capAnd} {rows[2].iv} {t.capSkipped} {rows[3].iv} {t.capTaken} {gates[1].v} — {rows[4].iv} {t.capSkippedOne} {t.capMax} {res} {t.capIvs}</figcaption>
</figure>
