---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Greedy commits to one local choice per step; dynamic programming explores all combinations and keeps the best",
    headline: "GREEDY COMMITS · DP COMPARES",
    sub: "same kind of problem — opposite spirits",
    greedyPanel: "greedy: one choice / step",
    dpPanel: "DP: all combos",
    gSteps: ["take locally-best", "commit, move on", "never reconsider"],
    dTop: "explore all combos",
    opt: "option",
    keepBest: "keep the best",
    greedyVerdict: "fast · sometimes wrong",
    dpVerdict: "slower · compares all",
    caption:
      "Greedy commits to one locally-best choice per step and never reconsiders — fast but sometimes wrong. DP explores all combinations of subproblem choices and keeps the best — slower but still right.",
  },
  ru: {
    svgTitle: "Жадный фиксирует один локальный выбор на шаг; динамическое программирование исследует все комбинации и хранит лучшую",
    headline: "ЖАДНЫЙ ФИКСИРУЕТ · DP СРАВНИВАЕТ",
    sub: "один вид задачи — противоположный дух",
    greedyPanel: "жадный: один выбор на шаг",
    dpPanel: "DP: все комбинации",
    gSteps: ["бери локально лучшее", "фиксируй, иди дальше", "не пересматривай"],
    dTop: "исследуй все комбинации",
    opt: "вариант",
    keepBest: "храни лучшую",
    greedyVerdict: "быстро · иногда неверно",
    dpVerdict: "медленнее · всё ещё прав",
    caption:
      "Жадный фиксирует один локально лучший выбор на шаг и никогда не пересматривает — быстро, но иногда неверно. DP исследует все комбинации выборов подзадач и хранит лучшую — медленнее, но всё ещё прав.",
  },
};

const t = dict[lang];

const gY = [120, 192, 264];
const gArrowPts = ["198,182 212,182 205,192", "198,254 212,254 205,264"];
const gArrowY = [
  { y1: 162, y2: 182 },
  { y1: 234, y2: 254 },
];
const branchX = [435, 605];
const branchC = [510, 680];
const optNums = ["1", "2"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="80" width="350" height="250" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="205" y="106" text-anchor="middle" font-size="13" fill="var(--ink)">{t.greedyPanel}</text>
    {t.gSteps.map((s, i) => (
      <g>
        <rect x="90" y={gY[i]} width="230" height="42" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="205" y={gY[i] + 26} text-anchor="middle" font-size="12" fill="var(--ink)">{s}</text>
      </g>
    ))}
    {gArrowY.map((a, i) => (
      <g>
        <line x1="205" y1={a.y1} x2="205" y2={a.y2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={gArrowPts[i]} fill="var(--accent)" />
      </g>
    ))}
    <text x="205" y="324" text-anchor="middle" font-size="12" fill="var(--accent)">{t.greedyVerdict}</text>

    <rect x="420" y="80" width="350" height="250" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="595" y="106" text-anchor="middle" font-size="13" fill="var(--ink)">{t.dpPanel}</text>
    <rect x="480" y="120" width="230" height="42" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="595" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.dTop}</text>

    <line x1="595" y1="162" x2="595" y2="177" stroke="var(--ink)" stroke-width="2" />
    <line x1="510" y1="177" x2="680" y2="177" stroke="var(--ink)" stroke-width="2" />
    {branchX.map((bx, i) => (
      <g>
        <line x1={branchC[i]} y1="177" x2={branchC[i]} y2="182" stroke="var(--accent)" stroke-width="2" />
        <rect x={bx} y="192" width="150" height="42" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={branchC[i]} y="218" text-anchor="middle" font-size="12" fill="var(--ink)">{t.opt} {optNums[i]}</text>
      </g>
    ))}
    <polygon points="503,182 517,182 510,192" fill="var(--accent)" />
    <polygon points="673,182 687,182 680,192" fill="var(--accent)" />

    <line x1="510" y1="234" x2="510" y2="254" stroke="var(--accent)" stroke-width="2" />
    <polygon points="503,254 517,254 510,264" fill="var(--accent)" />
    <line x1="680" y1="234" x2="680" y2="254" stroke="var(--accent)" stroke-width="2" />
    <polygon points="673,254 687,254 680,264" fill="var(--accent)" />
    <rect x="480" y="264" width="230" height="42" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="595" y="290" text-anchor="middle" font-size="12" fill="var(--ink)">{t.keepBest}</text>
    <text x="595" y="324" text-anchor="middle" font-size="12" fill="var(--accent)">{t.dpVerdict}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
