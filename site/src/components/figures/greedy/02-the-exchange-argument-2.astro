---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Activity-selection swap: X out, G in, P and Q still fit, count stays 3",
    headline: "SWAP X OUT, G IN — NOTHING LOST",
    sub: "G=[0,3] finishes earliest · O={X,P,Q} skips G",
    rowO: "O",
    rowOp: "O′",
    swap: "swap X → G",
    ineq: "G.finish 3 ≤ X.finish 4",
    fitNote: "P starts at 4 ≥ G.finish 3: still fits",
    countNote: "count 3 = 3: same value",
    verdict: "O′ optimal + holds G → greedy first pick safe",
    caption:
      "Trace the swap on G=[0,3], X=[1,4], P=[4,6], Q=[6,9]: since G finishes at 3, no later than X at 4, replacing X with G keeps P and Q fitting and the count at 3 — O′ is optimal and holds G.",
  },
  ru: {
    svgTitle: "Обмен в выборе активностей: X вон, G внутрь, P и Q всё ещё лезут, число 3",
    headline: "ОБМЕН: X ВОН, G ВНУТРЬ — БЕЗ ПОТЕРЬ",
    sub: "G=[0,3] завершается раньше всех · O={X,P,Q} пропускает G",
    rowO: "O",
    rowOp: "O′",
    swap: "обмен X → G",
    ineq: "G.finish 3 ≤ X.finish 4",
    fitNote: "P в 4 ≥ G.finish 3: пересечений нет",
    countNote: "число 3 = 3: то же значение",
    verdict: "O′ оптимален и держит G → жадный первый выбор безопасен",
    caption:
      "Трассировка обмена на G=[0,3], X=[1,4], P=[4,6], Q=[6,9]: раз G завершается в 3, не позже X в 4, замена X на G сохраняет P и Q вмещающимися, а число равным 3 — O′ оптимален и держит G.",
  },
};

const t = dict[lang];

const rowO = [
  { n: "X", a: 1, b: 4, hot: false },
  { n: "P", a: 4, b: 6, hot: false },
  { n: "Q", a: 6, b: 9, hot: false },
];
const rowOp = [
  { n: "G", a: 0, b: 3, hot: true },
  { n: "P", a: 4, b: 6, hot: false },
  { n: "Q", a: 6, b: 9, hot: false },
];

const x = (time: number) => 170 + time * 56;
const barY0 = 110;
const barY1 = 210;
const barH = 36;
const jobLabel = (n: string, a: number, b: number) => `${n} [${a},${b}]`;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    <text x="152" y="133" text-anchor="end" font-size="16" fill="var(--ink)">{t.rowO}</text>
    {rowO.map((j) => (
      <g>
        <rect x={x(j.a)} y={barY0} width={x(j.b) - x(j.a)} height={barH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={(x(j.a) + x(j.b)) / 2} y={barY0 + 23} text-anchor="middle" font-size="13" fill="var(--ink)">{jobLabel(j.n, j.a, j.b)}</text>
      </g>
    ))}

    <line x1="300" y1="150" x2="263" y2="203" stroke="var(--accent)" stroke-width="2" />
    <polygon points="256,202 270,202 263,210" fill="var(--accent)" />
    <text x="140" y="186" font-size="12" fill="var(--ink)">{t.swap}</text>
    <text x="500" y="186" text-anchor="middle" font-size="13" fill="var(--ink)">{t.ineq}</text>

    <text x="152" y="233" text-anchor="end" font-size="16" fill="var(--ink)">{t.rowOp}</text>
    {rowOp.map((j) => (
      <g>
        <rect x={x(j.a)} y={barY1} width={x(j.b) - x(j.a)} height={barH} fill={j.hot ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={(x(j.a) + x(j.b)) / 2} y={barY1 + 23} text-anchor="middle" font-size="13" fill={j.hot ? "var(--card)" : "var(--ink)"}>{jobLabel(j.n, j.a, j.b)}</text>
      </g>
    ))}

    <text x="400" y="280" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fitNote}</text>
    <text x="400" y="302" text-anchor="middle" font-size="12" fill="var(--muted)">{t.countNote}</text>

    <rect x="160" y="322" width="480" height="40" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="347" text-anchor="middle" font-size="12" fill="var(--card)">{t.verdict}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
