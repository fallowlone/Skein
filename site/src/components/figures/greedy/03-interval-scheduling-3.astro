---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Merge overlapping intervals by sorting on start time",
    headline: "MERGE: SORT BY START, ONE SWEEP",
    sub: "extend the run on overlap, else open a new run",
    sortedBy: "sorted by start",
    run: "run",
    extend: "extend →",
    gap: "gap →",
    out: "result",
    note: "nothing later can reach back behind the run",
    capA: "become",
    capB: "overlaps, so extend the run;",
    capAnd: "and",
    capC: "gap, so open new runs.",
  },
  ru: {
    svgTitle: "Слияние пересекающихся интервалов сортировкой по началу",
    headline: "СЛИЯНИЕ: СОРТИРУЙ ПО НАЧАЛУ, ОДИН ПРОХОД",
    sub: "расширяй серию при пересечении, иначе открой новую",
    sortedBy: "сортируй по началу",
    run: "серия",
    extend: "расширяй →",
    gap: "разрыв →",
    out: "результат",
    note: "ничто позже не может дотянуться назад за начало серии",
    capA: "становится",
    capB: "пересекает, так что расширяй серию;",
    capAnd: "и",
    capC: "разрывы, так что открой новые серии.",
  },
};

const t = dict[lang];

interface IRow {
  iv: string;
  s: number;
  e: number;
  kind: "run" | "extend" | "gap";
  out: string | undefined;
}

const inputs: IRow[] = [
  { iv: "[1,3]", s: 1, e: 3, kind: "run", out: undefined },
  { iv: "[2,6]", s: 2, e: 6, kind: "extend", out: "[1,6]" },
  { iv: "[8,10]", s: 8, e: 10, kind: "gap", out: "[8,10]" },
  { iv: "[15,18]", s: 15, e: 18, kind: "gap", out: "[15,18]" },
];

interface ORow {
  iv: string;
  s: number;
  e: number;
}

const outputs: ORow[] = [
  { iv: "[1,6]", s: 1, e: 6 },
  { iv: "[8,10]", s: 8, e: 10 },
  { iv: "[15,18]", s: 15, e: 18 },
];

const X = (v: number) => 150 + v * 27;
const inY = (i: number) => 104 + i * 34;
const outY = 280;
const verdict = (r: IRow) => (r.kind === "run" ? t.run : r.kind === "extend" ? t.extend : t.gap);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="92" font-size="13" fill="var(--ink)">{t.sortedBy}</text>
    {inputs.map((r, i) => (
      <g>
        <text x="140" y={inY(i) + 17} text-anchor="end" font-size="13" fill="var(--ink)">{r.iv}</text>
        <rect x={X(r.s)} y={inY(i)} width={(r.e - r.s) * 27} height="24" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="646" y={inY(i) + 17} font-size="12" fill={r.kind === "run" ? "var(--muted)" : "var(--accent)"}>{verdict(r)} {r.out}</text>
      </g>
    ))}

    <line x1="190" y1="238" x2="190" y2="268" stroke="var(--accent)" stroke-width="2" />
    <polygon points="183,268 197,268 190,280" fill="var(--accent)" />

    <text x="140" y={outY + 19} text-anchor="end" font-size="13" fill="var(--ink)">{t.out}</text>
    {outputs.map((o) => (
      <g>
        <rect x={X(o.s)} y={outY} width={(o.e - o.s) * 27} height="28" fill="var(--accent)" stroke="var(--accent)" stroke-width="2" />
        <text x={(X(o.s) + X(o.e)) / 2} y={outY + 19} text-anchor="middle" font-size="12" fill="var(--card)">{o.iv}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{inputs[0].iv}, {inputs[1].iv}, {inputs[2].iv}, {inputs[3].iv} {t.capA} {outputs[0].iv}, {outputs[1].iv}, {outputs[2].iv}: {inputs[1].iv} {t.capB} {inputs[2].iv} {t.capAnd} {inputs[3].iv} {t.capC}</figcaption>
</figure>
