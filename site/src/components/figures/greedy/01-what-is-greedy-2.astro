---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Greedy on coins 1, 3, 4 for target 6 takes 4, 1, 1 for 3 coins while the optimum 3 plus 3 is 2 coins",
    headlineA: "COINS",
    headlineB: "TARGET",
    headlineC: "GREEDY LOSES",
    sub: "largest coin that fits, every step — never look back",
    take: "take",
    skip: "skip",
    rem: "rem",
    greedyTag: "greedy",
    coinsWord: "coins",
    optTag: "optimum",
    note1: "the 4 blocked the two 3s — take-4 is in no optimum",
    note2: "same algorithm, different coins, opposite outcomes",
    caption:
      "Coins {1, 3, 4}, target 6: greedy takes 4 (rem 6 → 2), skips 3 (3 > 2), then takes 1, 1 (rem 2 → 1 → 0) — 4 + 1 + 1 = 3 coins. The optimum 3 + 3 = 2 coins never uses a 4 at all.",
  },
  ru: {
    svgTitle: "Жадный на монетах 1, 3, 4 для суммы 6 берёт 4, 1, 1 — 3 монеты, тогда как оптимум 3 плюс 3 это 2 монеты",
    headlineA: "МОНЕТЫ",
    headlineB: "СУММА",
    headlineC: "ЖАДНЫЙ ПРОИГРЫВАЕТ",
    sub: "самая большая монета что помещается — не оглядывайся",
    take: "бери",
    skip: "пропусти",
    rem: "ост",
    greedyTag: "жадный",
    coinsWord: "монеты",
    optTag: "оптимум",
    note1: "четвёрка заблокировала две тройки — взять-4 ни в каком оптимуме",
    note2: "тот же алгоритм, другие монеты, противоположные исходы",
    caption:
      "Монеты {1, 3, 4}, сумма 6: жадный берёт 4 (ост 6 → 2), пропускает 3 (3 > 2), потом берёт 1, 1 (ост 2 → 1 → 0) — 4 + 1 + 1 = 3 монеты. Оптимум 3 + 3 = 2 монеты вообще не использует четвёрку.",
  },
};

const t = dict[lang];

const coinSet = "{1, 3, 4}";
const target = "6";
const coins = ["4", "3", "1", "1"];
const cx = [90, 270, 450, 630];
const taken = [true, false, true, true];
const cy = 145;
const cr = 28;
const arrows = [
  { x1: 130, x2: 232, tip: 242, mid: 180 },
  { x1: 310, x2: 412, tip: 422, mid: 360 },
  { x1: 490, x2: 592, tip: 602, mid: 540 },
];
const arrowPts = [
  "232,138 232,152 242,145",
  "412,138 412,152 422,145",
  "592,138 592,152 602,145",
];
const rems = ["6 → 2", "3 > 2", "2 → 1", "1 → 0"];
const picksG = "4 + 1 + 1";
const nG = "3";
const picksO = "3 + 3";
const nO = "2";
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headlineA} {coinSet}, {t.headlineB} {target}: {t.headlineC}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {coins.map((c, i) => (
      <g>
        <circle cx={cx[i]} cy={cy} r={cr} fill="var(--card)" stroke={taken[i] ? "var(--ink)" : "var(--muted)"} stroke-width="2" stroke-dasharray={taken[i] ? undefined : "6 4"} />
        <text x={cx[i]} y={cy + 6} text-anchor="middle" font-size="17" fill={taken[i] ? "var(--ink)" : "var(--muted)"}>{c}</text>
        <text x={cx[i]} y={cy + 52} text-anchor="middle" font-size="12" fill={taken[i] ? "var(--ink)" : "var(--muted)"}>{taken[i] ? t.take : t.skip}</text>
      </g>
    ))}
    <line x1="252" y1="127" x2="288" y2="163" stroke="var(--muted)" stroke-width="2" />

    {arrows.map((a, i) => (
      <g>
        <line x1={a.x1} y1={cy} x2={a.x2} y2={cy} stroke="var(--accent)" stroke-width="2" />
        <polygon points={arrowPts[i]} fill="var(--accent)" />
      </g>
    ))}
    <text x="180" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rem} {rems[0]}</text>
    <text x="360" y="128" text-anchor="middle" font-size="12" fill="var(--muted)">{rems[1]} · {t.skip}</text>
    <text x="540" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rem} {rems[2]}</text>
    <text x="716" y="149" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rem} {rems[3]}</text>

    <rect x="40" y="240" width="350" height="64" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="215" y="264" text-anchor="middle" font-size="12" fill="var(--muted)">{t.greedyTag}</text>
    <text x="215" y="291" text-anchor="middle" font-size="16" fill="var(--ink)">{picksG} = {nG} {t.coinsWord}</text>

    <rect x="410" y="240" width="350" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="585" y="264" text-anchor="middle" font-size="12" fill="var(--muted)">{t.optTag}</text>
    <text x="585" y="291" text-anchor="middle" font-size="16" fill="var(--ink)">{picksO} = {nO} {t.coinsWord}</text>

    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--ink)">{t.note1}</text>
    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
