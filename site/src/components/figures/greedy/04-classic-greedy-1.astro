---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Jump Game sweep on [2,3,1,1,4]: farthest stays ahead of i, return true",
    headline: "ONE NUMBER SUMMARISES EVERY PATH",
    sub: "reach from i is i + nums[i] · farthest is the best reach so far",
    rowIdx: "index i",
    rowNums: "nums[i]",
    rowReach: "i + nums[i]",
    rowFar: "farthest",
    hitNote: "last index 4 covered already at i = 1",
    verdict: "i ≤ farthest at every step → reachable, return true",
    caption:
      "Jump Game on [2,3,1,1,4]: reach row 2, 4, 3, 4, 8 and frontier row 2, 4, 4, 4, 8. The check i > farthest never fires, the last index is covered as early as i = 1, so the sweep returns true.",
  },
  ru: {
    svgTitle: "Проход Jump Game на [2,3,1,1,4]: farthest впереди i, верни true",
    headline: "ОДНО ЧИСЛО ПОДЫТОЖИВАЕТ ВСЕ ПУТИ",
    sub: "охват с i это i + nums[i] · farthest это лучший охват до сих пор",
    rowIdx: "индекс i",
    rowNums: "nums[i]",
    rowReach: "i + nums[i]",
    rowFar: "farthest",
    hitNote: "индекс 4 покрыт уже при i = 1",
    verdict: "i ≤ farthest на каждом шаге → достижим, верни true",
    caption:
      "Jump Game на [2,3,1,1,4]: строка охватов 2, 4, 3, 4, 8 и строка фронтира 2, 4, 4, 4, 8. Проверка i > farthest ни разу не срабатывает, последний индекс покрыт уже при i = 1, так что проход возвращает true.",
  },
};

const t = dict[lang];

const idx = ["0", "1", "2", "3", "4"];
const nums = ["2", "3", "1", "1", "4"];
const reach = ["2", "4", "3", "4", "8"];
const far = ["2", "4", "4", "4", "8"];
const hot = [false, true, false, false, false];

const x0 = 200;
const cw = 76;
const step = 104;
const cellX = (i: number) => x0 + i * step;
const cellCX = (i: number) => x0 + i * step + cw / 2;
const labelX = 184;

const arrowX = cellCX(1);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={labelX} y="112" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowIdx}</text>
    {idx.map((v, i) => (
      <text x={cellCX(i)} y="112" text-anchor="middle" font-size="13" fill="var(--muted)">{v}</text>
    ))}

    <text x={labelX} y="153" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowNums}</text>
    {nums.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="124" width={cw} height={44} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellCX(i)} y="153" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <line x1={arrowX} y1="168" x2={arrowX} y2="192" stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${arrowX - 7},185 ${arrowX + 7},185 ${arrowX},192`} fill="var(--accent)" />

    <text x={labelX} y="221" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowReach}</text>
    {reach.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="192" width={cw} height={44} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellCX(i)} y="221" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x={labelX} y="289" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowFar}</text>
    {far.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="260" width={cw} height={44} fill={hot[i] ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={cellCX(i)} y="289" text-anchor="middle" font-size="15" fill={hot[i] ? "var(--card)" : "var(--ink)"}>{v}</text>
      </g>
    ))}

    <text x={cellCX(1)} y="330" text-anchor="middle" font-size="13" fill="var(--accent)">{t.hitNote}</text>
    <text x="400" y="378" text-anchor="middle" font-size="13" fill="var(--ink)">{t.verdict}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
