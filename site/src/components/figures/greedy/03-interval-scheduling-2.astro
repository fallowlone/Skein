---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Shortest duration counterexample against earliest finish",
    headline: "SHORTEST DURATION LOSES",
    sub: "a short interval in the middle blocks two that do not overlap",
    grpA: "shortest-duration picks:",
    grpB: "earliest-finish picks:",
    taken: "taken",
    blocked: "blocked",
    skipped: "skipped",
    note: "finish time is the only key that is provably safe",
    capA: "Trap input:",
    capB: "the shortest",
    capC: "sits in the middle and blocks both, so you get",
    capD: "But",
    capAnd: "and",
    capE: "do not overlap each other, so the real answer is",
  },
  ru: {
    svgTitle: "Контрпример кратчайшей длительности против раннего завершения",
    headline: "КРАТЧАЙШАЯ ДЛИТЕЛЬНОСТЬ ПРОИГРЫВАЕТ",
    sub: "короткий интервал посередине блокирует двух непересекающихся соседей",
    grpA: "кратчайшая длительность берёт:",
    grpB: "раннее завершение берёт:",
    taken: "взят",
    blocked: "заблокирован",
    skipped: "пропущен",
    note: "время завершения — единственный доказуемо безопасный ключ",
    capA: "Ловушка-вход:",
    capB: "самый короткий",
    capC: "сидит посередине и блокирует оба, так что ты получаешь",
    capD: "Но",
    capAnd: "и",
    capE: "друг друга не пересекают, так что настоящий ответ — это",
  },
};

const t = dict[lang];

interface FRow {
  iv: string;
  s: number;
  e: number;
  st: "taken" | "blocked" | "skipped";
}

interface Group {
  key: "grpA" | "grpB";
  count: string;
  rows: FRow[];
}

const groups: Group[] = [
  {
    key: "grpA",
    count: "1",
    rows: [
      { iv: "[0,4]", s: 0, e: 4, st: "blocked" },
      { iv: "[3,5]", s: 3, e: 5, st: "taken" },
      { iv: "[4,8]", s: 4, e: 8, st: "blocked" },
    ],
  },
  {
    key: "grpB",
    count: "2",
    rows: [
      { iv: "[0,4]", s: 0, e: 4, st: "taken" },
      { iv: "[3,5]", s: 3, e: 5, st: "skipped" },
      { iv: "[4,8]", s: 4, e: 8, st: "taken" },
    ],
  },
];

const ticks = [0, 1, 2, 3, 4, 5, 6, 7, 8];

const X = (v: number) => 170 + v * 60;
const gLabelY = (gi: number) => 84 + gi * 124;
const rowY = (gi: number, ri: number) => 96 + gi * 124 + ri * 34;
const glabel = (k: string) => (k === "grpA" ? t.grpA : t.grpB);
const word = (st: string) => (st === "taken" ? t.taken : st === "blocked" ? t.blocked : t.skipped);
const dash = (st: string) => (st === "taken" ? undefined : st === "blocked" ? "6 4" : undefined);
const edge = (st: string) => (st === "taken" ? "var(--accent)" : st === "blocked" ? "var(--muted)" : "var(--ink)");
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {groups.map((g, gi) => (
      <g>
        <text x="170" y={gLabelY(gi)} font-size="13" fill="var(--ink)">{glabel(g.key)} {g.count}</text>
        {g.rows.map((r, ri) => (
          <g>
            <text x="160" y={rowY(gi, ri) + 18} text-anchor="end" font-size="13" fill="var(--ink)">{r.iv}</text>
            <rect x={X(r.s)} y={rowY(gi, ri)} width={(r.e - r.s) * 60} height="26" fill={r.st === "taken" ? "var(--accent)" : "var(--card)"} stroke={edge(r.st)} stroke-width="2" stroke-dasharray={dash(r.st)} />
            <g opacity={r.st === "blocked" ? 1 : 0}>
              <line x1={X(r.s) + 6} y1={rowY(gi, ri) + 5} x2={X(r.e) - 6} y2={rowY(gi, ri) + 21} stroke="var(--muted)" stroke-width="2" />
              <line x1={X(r.s) + 6} y1={rowY(gi, ri) + 21} x2={X(r.e) - 6} y2={rowY(gi, ri) + 5} stroke="var(--muted)" stroke-width="2" />
            </g>
            <text x="660" y={rowY(gi, ri) + 18} font-size="12" fill={r.st === "taken" ? "var(--accent)" : "var(--muted)"}>{word(r.st)}</text>
          </g>
        ))}
      </g>
    ))}

    <line x1="170" y1="332" x2="650" y2="332" stroke="var(--ink)" stroke-width="1" />
    {ticks.map((v) => (
      <g>
        <line x1={X(v)} y1="332" x2={X(v)} y2="338" stroke="var(--ink)" stroke-width="1" />
        <text x={X(v)} y="352" text-anchor="middle" font-size="11" fill="var(--muted)">{v}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.capA} {groups[0].rows[0].iv}, {groups[0].rows[1].iv}, {groups[0].rows[2].iv}: {t.capB} {groups[0].rows[1].iv} {t.capC} {groups[0].count}. {t.capD} {groups[1].rows[0].iv} {t.capAnd} {groups[1].rows[2].iv} {t.capE} {groups[1].count}.</figcaption>
</figure>
