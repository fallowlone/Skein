---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Prepared-statement eras: before PgBouncer 1.21 transaction mode works but prepares must be disabled losing 10 to 30 percent; 1.21 from October 2023 re-prepares transparently; 1.22 plus Postgres 17 adds clean Close",
    headline: "1.21 ENDED THE FORCED CHOICE",
    sub: "transaction mode AND prepared statements since October 2023",
    eras: ["pre-1.21 · pre-2024", "1.21+ · Oct 2023", "1.22+ · PG17 Sep 2024"],
    txStats: ["works", "works", "works"],
    prepStats: ["disabled: −10–30% lost", "works · re-prepares", "works + clean Close"],
    prepSubs: ["driver prepares off", "max_prepared_statements = 1000", "libpq Close on disconnect"],
    txHead: "transaction mode",
    prepHead: "prepared statements",
    eraHead: "era",
    foot: "2026 default: 1.21+ · 1000 · transaction mode",
    caption:
      "Before PgBouncer 1.21 transaction mode forced drivers to disable prepared statements, losing 10–30% throughput; 1.21 with max_prepared_statements = 1000 re-prepares transparently, and 1.22 with Postgres 17 closes cleanly.",
  },
  ru: {
    svgTitle: "Эры prepared statements: до PgBouncer 1.21 transaction mode работает, но prepare надо отключать теряя 10–30%; 1.21 с октября 2023 переподготавливает прозрачно; 1.22 плюс Postgres 17 даёт чистый Close",
    headline: "1.21 СНЯЛ ВЫНУЖДЕННЫЙ ВЫБОР",
    sub: "transaction mode И prepared statements с октября 2023",
    eras: ["до 1.21 · до 2024", "1.21+ · окт 2023", "1.22+ · PG17 сен 2024"],
    txStats: ["работает", "работает", "работает"],
    prepStats: ["выкл: −10–30% теряем", "работает · re-prepare", "работает + чистый Close"],
    prepSubs: ["prepare в драйвере выкл", "max_prepared_statements = 1000", "libpq Close при disconnect"],
    txHead: "transaction mode",
    prepHead: "prepared statements",
    eraHead: "эра",
    foot: "дефолт 2026: 1.21+ · 1000 · transaction mode",
    caption:
      "До PgBouncer 1.21 transaction mode вынуждал отключать prepared statements в драйвере, теряя 10–30% пропускной способности; 1.21 с max_prepared_statements = 1000 переподготавливает прозрачно, а 1.22 с Postgres 17 закрывает чисто.",
  },
};

const t = dict[lang];

const eraY = [110, 190, 270];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-era-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="150" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.eraHead}</text>
    <text x="400" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.txHead}</text>
    <text x="620" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.prepHead}</text>

    {t.eras.map((e, i) => (
      <g>
        <rect x="40" y={eraY[i]} width="220" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="150" y={eraY[i] + 37} text-anchor="middle" font-size="12" fill="var(--ink)">{e}</text>
        <rect x="272" y={eraY[i]} width="130" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="337" y={eraY[i] + 37} text-anchor="middle" font-size="12" fill="var(--ink)">{t.txStats[i]}</text>
        <rect x="414" y={eraY[i]} width="346" height="60" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="587" y={eraY[i] + 28} text-anchor="middle" font-size="12" fill="var(--ink)">{t.prepStats[i]}</text>
        <text x="587" y={eraY[i] + 48} text-anchor="middle" font-size="11" fill="var(--muted)">{t.prepSubs[i]}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
