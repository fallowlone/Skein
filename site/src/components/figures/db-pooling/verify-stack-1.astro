---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Five stack checks before the canary: PgBouncer 1.21.0 or later, max_prepared_statements 1000, Postgres 14 plus with libpq 17, driver protocol-level prepares, and a 30-minute load test with zero errors",
    headline: "FIVE CHECKS BEFORE THE CANARY",
    sub: "skip one and production finds it under load",
    checks: ["1 · PgBouncer 1.21.0+ · pgbouncer -V", "2 · max_prepared_statements = 1000 · SHOW CONFIG", "3 · Postgres 14+ · libpq 17+ for Close", "4 · driver protocol prepares · prepareThreshold over 0", "5 · 30-min load test · zero statement errors"],
    foot: "all five green before promoting the canary",
    caption:
      "Verify PgBouncer 1.21.0+, max_prepared_statements = 1000, Postgres 14+ with libpq 17+, driver protocol-level prepares, and a 30-minute load test — then promote the canary.",
  },
  ru: {
    svgTitle: "Пять проверок стека до canary: PgBouncer 1.21.0 или новее, max_prepared_statements 1000, Postgres 14 плюс с libpq 17, prepare драйвера на уровне протокола и 30-минутный нагрузочный тест без ошибок",
    headline: "ПЯТЬ ПРОВЕРОК ДО CANARY",
    sub: "пропустишь одну — production найдёт её под нагрузкой",
    checks: ["1 · PgBouncer 1.21.0+ · pgbouncer -V", "2 · max_prepared_statements = 1000 · SHOW CONFIG", "3 · Postgres 14+ · libpq 17+ для Close", "4 · prepare драйвера на протоколе · prepareThreshold больше 0", "5 · 30-минутный нагрузочный тест · ноль ошибок операторов"],
    foot: "все пять зелёные — только потом canary в production",
    caption:
      "Проверь PgBouncer 1.21.0+, max_prepared_statements = 1000, Postgres 14+ с libpq 17+, prepare драйвера на уровне протокола и 30-минутный нагрузочный тест — затем переводи canary.",
  },
};

const t = dict[lang];

const checkY = [110, 158, 206, 254, 302];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-verify-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.checks.map((c, i) => (
      <g>
        <rect x="80" y={checkY[i]} width="640" height="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="104" y={checkY[i] + 26} font-size="12" fill="var(--ink)">{c}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
