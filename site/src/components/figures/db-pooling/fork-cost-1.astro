---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Fork cost: each client makes the postmaster fork one backend OS process costing about 5 ms startup, 5 to 10 MB private memory, and one proc-array slot — against about 2 KB per PgBouncer client",
    headline: "ONE CONNECTION = ONE OS PROCESS",
    sub: "the postmaster forks · every fork costs memory and a slot",
    clientT: "client connects",
    clientS: "TCP + auth",
    pmT: "postmaster",
    pmS: "supervisor · forks",
    beT: "backend process",
    beS: "~10 MB private",
    costLine: "startup ~5 ms · private ~5–10 MB · 1 proc-array slot each",
    asymLine: "~2 KB per PgBouncer client vs ~10 MB per backend",
    caption:
      "Every connection forks a backend via the postmaster at ~5 ms startup with ~10 MB private memory and a shared-memory slot; a PgBouncer client costs ~2 KB — that asymmetry is why pools exist.",
  },
  ru: {
    svgTitle: "Стоимость форка: каждый клиент заставляет postmaster форкнуть один backend-процесс ценой около 5 мс запуска, 5–10 МБ приватной памяти и слот proc array — против около 2 КБ на клиента PgBouncer",
    headline: "ОДНО СОЕДИНЕНИЕ = ОДИН OS-ПРОЦЕСС",
    sub: "postmaster форкает · каждый форк стоит памяти и слота",
    clientT: "клиент",
    clientS: "TCP + auth",
    pmT: "postmaster",
    pmS: "супервизор · fork",
    beT: "backend-процесс",
    beS: "~10 МБ приватной",
    costLine: "старт ~5 мс · приватная ~5–10 МБ · слот proc array каждый",
    asymLine: "~2 КБ на клиента PgBouncer против ~10 МБ на backend",
    caption:
      "Каждое соединение форкает backend через postmaster ценой ~5 мс запуска с ~10 МБ приватной памяти и слотом общей памяти; клиент PgBouncer стоит ~2 КБ — эта асимметрия и есть причина пулов.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-fork-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="110" width="180" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="130" y="156" text-anchor="middle" font-size="13" fill="var(--ink)">{t.clientT}</text>
    <text x="130" y="180" text-anchor="middle" font-size="11" fill="var(--muted)">{t.clientS}</text>

    <line x1="220" y1="165" x2="258" y2="165" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-fork-arrow)" />

    <rect x="262" y="110" width="200" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="362" y="156" text-anchor="middle" font-size="13" fill="var(--ink)">{t.pmT}</text>
    <text x="362" y="180" text-anchor="middle" font-size="11" fill="var(--muted)">{t.pmS}</text>

    <line x1="462" y1="165" x2="500" y2="165" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-fork-arrow)" />

    <rect x="504" y="110" width="256" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="632" y="156" text-anchor="middle" font-size="13" fill="var(--ink)">{t.beT}</text>
    <text x="632" y="180" text-anchor="middle" font-size="11" fill="var(--muted)">{t.beS}</text>

    <rect x="40" y="252" width="720" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="284" text-anchor="middle" font-size="13" fill="var(--ink)">{t.costLine}</text>

    <rect x="40" y="318" width="720" height="52" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="350" text-anchor="middle" font-size="13" fill="var(--accent)">{t.asymLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
