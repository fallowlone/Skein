---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Why SET breaks in transaction mode: SET search_path runs on backend B1, COMMIT returns B1 to the pool, the next query lands on B2 which never saw the SET — fix with ALTER ROLE",
    headline: "SET ON B1 · NEXT QUERY ON B2 · GONE",
    sub: "transaction mode returns the backend after each COMMIT",
    s1Title: "1 · SET",
    s1Line: "SET search_path",
    s1Sub: "runs on B1",
    s2Title: "2 · COMMIT",
    s2Line: "COMMIT",
    s2Sub: "B1 back to pool",
    s3Title: "3 · next query",
    s3Line: "lands on B2",
    s3Sub: "SET is gone",
    fixLine: "fix: ALTER ROLE app SET search_path on every backend",
    caption:
      "In transaction mode the SET runs on B1 but COMMIT returns B1 to the pool, so the next query lands on B2 which never saw it; ALTER ROLE applies the setting on every backend instead.",
  },
  ru: {
    svgTitle: "Почему SET ломается в transaction mode: SET search_path выполняется на B1, COMMIT возвращает B1 в пул, следующий запрос попадает на B2, который SET не видел, — фикс через ALTER ROLE",
    headline: "SET НА B1 · СЛЕДУЮЩИЙ ЗАПРОС НА B2 · НЕТ",
    sub: "transaction mode возвращает backend после каждого COMMIT",
    s1Title: "1 · SET",
    s1Line: "SET search_path",
    s1Sub: "выполнен на B1",
    s2Title: "2 · COMMIT",
    s2Line: "COMMIT",
    s2Sub: "B1 назад в пул",
    s3Title: "3 · следующий запрос",
    s3Line: "попадает на B2",
    s3Sub: "SET потерян",
    fixLine: "фикс: ALTER ROLE app SET search_path на каждом backend",
    caption:
      "В transaction mode SET выполняется на B1, но COMMIT возвращает B1 в пул, поэтому следующий запрос попадает на B2, который его не видел; ALTER ROLE применяет настройку на каждом backend.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-set-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="110" width="220" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="140" y="140" text-anchor="middle" font-size="13" fill="var(--ink)">{t.s1Title}</text>
    <rect x="50" y="160" width="180" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="140" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s1Line}</text>
    <text x="140" y="238" text-anchor="middle" font-size="12" fill="var(--accent)">{t.s1Sub}</text>

    <line x1="250" y1="195" x2="288" y2="195" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-set-arrow)" />

    <rect x="290" y="110" width="220" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="140" text-anchor="middle" font-size="13" fill="var(--ink)">{t.s2Title}</text>
    <rect x="310" y="160" width="180" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s2Line}</text>
    <text x="400" y="238" text-anchor="middle" font-size="12" fill="var(--accent)">{t.s2Sub}</text>

    <line x1="510" y1="195" x2="548" y2="195" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-set-arrow)" />

    <rect x="550" y="110" width="220" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="660" y="140" text-anchor="middle" font-size="13" fill="var(--ink)">{t.s3Title}</text>
    <rect x="570" y="160" width="180" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="660" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s3Line}</text>
    <text x="660" y="238" text-anchor="middle" font-size="12" fill="var(--accent)">{t.s3Sub}</text>

    <rect x="30" y="312" width="740" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="344" text-anchor="middle" font-size="13" fill="var(--ink)">{t.fixLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
