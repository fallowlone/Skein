---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Connection budget: 24 pool plus 6 reserve plus 40 for two replicas plus 3 superuser plus 10 admin is 83, so max_connections 100 is fine — while 1000 is wasteful and harmful",
    headline: "24 + 6 + 40 + 3 + 10 = 83 OF 100",
    sub: "budget every consumer · cap at a few hundred",
    parts: ["24", "6", "40", "3", "10"],
    partLabels: ["pool_size", "reserve", "replicas x2", "superuser", "admin/mon"],
    totalLine: "= 83 · max_connections = 100 is fine",
    warnLine: "max_connections = 1000: wasteful + harmful",
    caption:
      "Pool 24 plus reserve 6 plus two replica pools of 20 plus 3 superuser plus 10 admin totals 83, so max_connections = 100 fits; raising it to 1000 pre-allocates shared memory and degrades throughput.",
  },
  ru: {
    svgTitle: "Бюджет соединений: 24 пул плюс 6 резерв плюс 40 на две реплики плюс 3 superuser плюс 10 admin — итого 83, поэтому max_connections 100 достаточно, а 1000 расточительно и вредно",
    headline: "24 + 6 + 40 + 3 + 10 = 83 ИЗ 100",
    sub: "заложи каждого потребителя · лимит — сотни",
    parts: ["24", "6", "40", "3", "10"],
    partLabels: ["pool_size", "reserve", "реплики x2", "superuser", "admin/монитор"],
    totalLine: "= 83 · max_connections = 100 достаточно",
    warnLine: "max_connections = 1000: расточительно и вредно",
    caption:
      "Пул 24 плюс резерв 6 плюс два пула реплик по 20 плюс 3 superuser плюс 10 admin дают 83, поэтому max_connections = 100 достаточно; подъём до 1000 выделяет общую память и снижает пропускную способность.",
  },
};

const t = dict[lang];

const partX = [40, 172, 304, 436, 568];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-budget-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.parts.map((p, i) => (
      <g>
        <rect x={partX[i]} y="120" width="120" height="110" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={partX[i] + 60} y="172" text-anchor="middle" font-size="20" fill="var(--ink)">{p}</text>
        <text x={partX[i] + 60} y="200" text-anchor="middle" font-size="11" fill="var(--muted)">{t.partLabels[i]}</text>
      </g>
    ))}

    <rect x="40" y="262" width="720" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="294" text-anchor="middle" font-size="13" fill="var(--ink)">{t.totalLine}</text>

    <rect x="40" y="328" width="720" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="360" text-anchor="middle" font-size="13" fill="var(--accent)">{t.warnLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
