---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Client-pool math: 100 concurrent requests times 2 DB calls times 5 ms over a 50 ms budget is 20 connections per worker; 10 workers make 200 cheap clients onto a 24-backend pool",
    headline: "100 × 2 × 5 / 50 = 20 PER WORKER",
    sub: "worker pools follow concurrency · backend pools follow CPUs",
    c1t: "step 1 · per worker",
    c1v: "100 × 2 × 5 / 50",
    c2t: "client pool max",
    c2v: "= 20 connections",
    c3t: "× 10 workers",
    c3v: "= 200 clients",
    c4t: "PgBouncer",
    c4v: "→ 24 backends",
    foot: "200 × ~2 KB clients multiplex onto (8 × 2) + 50% = 24 backends",
    caption:
      "One worker needs 100 × 2 × 5 / 50 = 20 connections; ten workers make 200 cheap client connections that PgBouncer multiplexes onto a 24-backend pool sized by the CPU formula.",
  },
  ru: {
    svgTitle: "Математика клиентского пула: 100 параллельных запросов на 2 вызова БД по 5 мс при бюджете 50 мс — это 20 соединений на воркер; 10 воркеров дают 200 дешёвых клиентов на пул из 24 backend",
    headline: "100 × 2 × 5 / 50 = 20 НА ВОРКЕР",
    sub: "пул воркера — от конкурентности · пул backend — от CPU",
    c1t: "шаг 1 · на воркер",
    c1v: "100 × 2 × 5 / 50",
    c2t: "max клиентского пула",
    c2v: "= 20 соединений",
    c3t: "× 10 воркеров",
    c3v: "= 200 клиентов",
    c4t: "PgBouncer",
    c4v: "→ 24 backend",
    foot: "200 × ~2 КБ клиентов → (8 × 2) + 50% = 24 backend",
    caption:
      "Одному воркеру нужно 100 × 2 × 5 / 50 = 20 соединений; десять воркеров дают 200 дешёвых клиентских соединений, которые PgBouncer мультиплексирует на пул из 24 backend по CPU-формуле.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-worker-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="26" y="130" width="168" height="120" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="110" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.c1t}</text>
    <text x="110" y="200" text-anchor="middle" font-size="14" fill="var(--ink)">{t.c1v}</text>

    <line x1="194" y1="190" x2="214" y2="190" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-worker-arrow)" />

    <rect x="218" y="130" width="168" height="120" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="302" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.c2t}</text>
    <text x="302" y="200" text-anchor="middle" font-size="14" fill="var(--accent)">{t.c2v}</text>

    <line x1="386" y1="190" x2="406" y2="190" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-worker-arrow)" />

    <rect x="410" y="130" width="168" height="120" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="494" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.c3t}</text>
    <text x="494" y="200" text-anchor="middle" font-size="14" fill="var(--ink)">{t.c3v}</text>

    <line x1="578" y1="190" x2="598" y2="190" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-worker-arrow)" />

    <rect x="602" y="130" width="172" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="688" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.c4t}</text>
    <text x="688" y="200" text-anchor="middle" font-size="14" fill="var(--accent)">{t.c4v}</text>

    <rect x="26" y="282" width="748" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="314" text-anchor="middle" font-size="13" fill="var(--ink)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
