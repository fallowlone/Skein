---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Per-request cost: opening a new Postgres connection costs 5–50 ms and about 10 MB per backend, while borrowing from a pool costs under 1 ms — P99 drops from 80 ms to 4 ms",
    headline: "NEW CONNECTION: 80 MS · POOLED: 4 MS",
    sub: "per-request setup cost decides P99 before any SQL runs",
    leftTitle: "WITHOUT POOL · per request",
    leftRows: ["TCP handshake + TLS + auth", "fork backend OS process", "~10 MB per backend"],
    leftFoot: "5–50 ms per new connection",
    rightTitle: "WITH POOL · per request",
    rightRows: ["borrow idle connection", "sub-ms list lookup", "conn returned, not closed"],
    rightFoot: "under 1 ms per checkout",
    heroLine: "P99: 80 ms new → 4 ms pooled · 20×",
    foot: "open once at startup · reuse for thousands of queries",
    caption:
      "Opening a connection per request costs 5–50 ms plus ~10 MB per backend; a pool turns that into a sub-millisecond checkout, dropping P99 from 80 ms to 4 ms on the same database.",
  },
  ru: {
    svgTitle: "Стоимость на запрос: новое соединение с Postgres стоит 5–50 мс и около 10 МБ на backend, а заимствование из пула — меньше 1 мс: P99 падает с 80 мс до 4 мс",
    headline: "НОВОЕ СОЕДИНЕНИЕ: 80 МС · ИЗ ПУЛА: 4 МС",
    sub: "стоимость setup на запрос решает P99 до запуска SQL",
    leftTitle: "БЕЗ ПУЛА · на запрос",
    leftRows: ["TCP handshake + TLS + auth", "fork backend OS-процесса", "~10 МБ на backend"],
    leftFoot: "5–50 мс на новое соединение",
    rightTitle: "С ПУЛОМ · на запрос",
    rightRows: ["берём idle-соединение", "поиск в списке за долю мс", "соединение возвращено, не закрыто"],
    rightFoot: "меньше 1 мс на checkout",
    heroLine: "P99: 80 мс новое → 4 мс из пула · 20×",
    foot: "открыть раз при старте · переиспользовать тысячи запросов",
    caption:
      "Соединение на каждый запрос стоит 5–50 мс плюс ~10 МБ на backend; пул превращает это в checkout за долю миллисекунды, снижая P99 с 80 мс до 4 мс на той же базе.",
  },
};

const t = dict[lang];

const rowY = [150, 192, 234];
const rowH = 34;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-cost-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="340" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    {t.leftRows.map((r, i) => (
      <g>
        <rect x="60" y={rowY[i]} width="300" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="210" y={rowY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}
    <text x="210" y="292" text-anchor="middle" font-size="13" fill="var(--accent)">{t.leftFoot}</text>

    <rect x="420" y="100" width="340" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    {t.rightRows.map((r, i) => (
      <g>
        <rect x="440" y={rowY[i]} width="300" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="590" y={rowY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}
    <text x="590" y="292" text-anchor="middle" font-size="13" fill="var(--accent)">{t.rightFoot}</text>

    <line x1="380" y1="200" x2="420" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-cost-arrow)" />

    <rect x="40" y="322" width="720" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="355" text-anchor="middle" font-size="15" fill="var(--ink)">{t.heroLine}</text>

    <text x="400" y="398" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
