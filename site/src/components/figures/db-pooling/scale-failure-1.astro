---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Scale failure: 40 workers times 20 pooled connections is 800 attempts against max_connections 100, so 700 fail; PgBouncer multiplexes 800 clients onto 50 backends",
    headline: "40 × 20 = 800 ATTEMPTS · CAP IS 100",
    sub: "client pools multiply across workers — the cap does not",
    workTitle: "40 workers × 20 conns",
    workLine: "= 800 attempts",
    workNote: "pools add up",
    capTitle: "max_connections = 100",
    capLine: "700 × FATAL",
    capNote: "too many clients already",
    fixTitle: "PgBouncer",
    fixLine: "800 → 50 backends",
    fixNote: "real backends: 50",
    foot: "scale workers without a server pooler and the cap fails first",
    caption:
      "Forty workers with a client pool of 20 each open 800 connections against max_connections = 100, so 700 attempts fail; PgBouncer multiplexes those 800 clients onto 50 real backends instead.",
  },
  ru: {
    svgTitle: "Сбой масштабирования: 40 воркеров по 20 соединений пула дают 800 попыток против max_connections 100 — 700 отклоняются; PgBouncer мультиплексирует 800 клиентов на 50 backend",
    headline: "40 × 20 = 800 ПОПЫТОК · ЛИМИТ 100",
    sub: "клиентские пулы умножаются на воркеры — лимит нет",
    workTitle: "40 воркеров × 20 соед.",
    workLine: "= 800 попыток",
    workNote: "пулы складываются",
    capTitle: "max_connections = 100",
    capLine: "700 × FATAL",
    capNote: "too many clients already",
    fixTitle: "PgBouncer",
    fixLine: "800 → 50 backend",
    fixNote: "реальных backend: 50",
    foot: "масштаб без серверного пулера — лимит падает первым",
    caption:
      "Сорок воркеров с клиентским пулом по 20 открывают 800 соединений против max_connections = 100, поэтому 700 попыток отклоняются; PgBouncer мультиплексирует эти 800 клиентов на 50 реальных backend.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-scale-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="110" width="220" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="140" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.workTitle}</text>
    <rect x="50" y="160" width="180" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="140" y="188" text-anchor="middle" font-size="16" fill="var(--ink)">{t.workLine}</text>
    <text x="140" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.workNote}</text>

    <line x1="250" y1="195" x2="288" y2="195" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-scale-arrow)" />

    <rect x="290" y="110" width="220" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.capTitle}</text>
    <rect x="310" y="160" width="180" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="190" text-anchor="middle" font-size="16" fill="var(--accent)">{t.capLine}</text>
    <text x="400" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.capNote}</text>

    <line x1="510" y1="195" x2="548" y2="195" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-scale-arrow)" />

    <rect x="550" y="110" width="220" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="660" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixTitle}</text>
    <rect x="570" y="160" width="180" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="660" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixLine}</text>
    <text x="660" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.fixNote}</text>

    <rect x="30" y="312" width="740" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="344" text-anchor="middle" font-size="13" fill="var(--ink)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
