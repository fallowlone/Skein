---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One idle-in-transaction backend holds a pool slot causing exhaustion, row locks blocking writers, and an MVCC snapshot blocking VACUUM — the free safety net is idle_in_transaction_session_timeout 60s",
    headline: "ONE STUCK BACKEND HOLDS THREE THINGS",
    sub: "BEGIN without COMMIT pins the pool, the locks, and the snapshot",
    beginTitle: "BEGIN",
    beginSub: "no COMMIT",
    holds: ["pool slot", "row locks", "MVCC snapshot"],
    holdSubs: ["held → exhaustion", "held → writers wait", "held → VACUUM blocked"],
    fixLine: "safety net: idle_in_transaction_session_timeout = 60s",
    caption:
      "A backend stuck idle in transaction holds a pool slot, row locks, and an MVCC snapshot that blocks VACUUM; setting idle_in_transaction_session_timeout to 60s aborts it instead of draining the pool.",
  },
  ru: {
    svgTitle: "Один backend в idle-in-transaction держит слот пула вызывая исчерпание, блокировки строк и MVCC-снапшот блокирующий VACUUM — бесплатная страховка это idle_in_transaction_session_timeout 60s",
    headline: "ОДИН ЗАВИСШИЙ BACKEND ДЕРЖИТ ТРИ ВЕЩИ",
    sub: "BEGIN без COMMIT фиксирует пул, блокировки и снапшот",
    beginTitle: "BEGIN",
    beginSub: "без COMMIT",
    holds: ["слот пула", "блокировки строк", "MVCC-снапшот"],
    holdSubs: ["занят → исчерпание", "держат → writer ждут", "держит → VACUUM стоит"],
    fixLine: "страховка: idle_in_transaction_session_timeout = 60s",
    caption:
      "Backend в idle in transaction держит слот пула, блокировки строк и MVCC-снапшот, блокирующий VACUUM; idle_in_transaction_session_timeout в 60s прерывает его вместо опустошения пула.",
  },
};

const t = dict[lang];

const holdY = [120, 190, 260];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-hold-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="150" width="200" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="140" y="190" text-anchor="middle" font-size="16" fill="var(--ink)">{t.beginTitle}</text>
    <text x="140" y="216" text-anchor="middle" font-size="12" fill="var(--accent)">{t.beginSub}</text>

    {t.holds.map((h, i) => (
      <g>
        <line x1="240" y1="200" x2="292" y2={holdY[i] + 28} stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-hold-arrow)" />
        <rect x="296" y={holdY[i]} width="464" height="56" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="320" y={holdY[i] + 24} font-size="13" fill="var(--ink)">{h}</text>
        <text x="320" y={holdY[i] + 44} font-size="11" fill="var(--muted)">{t.holdSubs[i]}</text>
      </g>
    ))}

    <rect x="40" y="340" width="720" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="368" text-anchor="middle" font-size="13" fill="var(--ink)">{t.fixLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
