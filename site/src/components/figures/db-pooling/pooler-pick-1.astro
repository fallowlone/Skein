---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Pooler pick: PgBouncer 1.21 single-threaded is the default OLTP choice, Odyssey multi-threaded passes 100k QPS on one node, PgCat adds pooling plus routing, Supavisor on BEAM takes serverless and millions of connections",
    headline: "PGBOUNCER DEFAULT · OTHERS BY MEASURE",
    sub: "pick by the measured bottleneck, not by fashion",
    names: ["PgBouncer 1.21+", "Odyssey", "PgCat", "Supavisor"],
    threads: ["single-thread C", "multi-thread C", "multi-thread Rust", "BEAM Erlang/Elixir"],
    bests: ["default OLTP", "over 100k QPS one node", "pooling + routing", "serverless · millions conns"],
    nameHead: "pooler",
    threadHead: "threading",
    bestHead: "reach for it when",
    foot: "one PgBouncer handles tens of thousands of QPS · re-evaluate at the CPU ceiling",
    caption:
      "PgBouncer 1.21+ is the production default for OLTP; Odyssey wins past 100k QPS on one node, PgCat adds replica routing, and Supavisor absorbs serverless storms of millions of connections.",
  },
  ru: {
    svgTitle: "Выбор пулера: PgBouncer 1.21 однопоточный — дефолт для OLTP, Odyssey многопоточный тянет 100k QPS на ноде, PgCat добавляет пулинг плюс маршрутизацию, Supavisor на BEAM берёт serverless и миллионы соединений",
    headline: "PGBOUNCER ДЕФОЛТ · ОСТАЛЬНЫЕ ПО ЗАМЕРАМ",
    sub: "выбирай по измеренному узкому месту, а не по моде",
    names: ["PgBouncer 1.21+", "Odyssey", "PgCat", "Supavisor"],
    threads: ["однопоточный C", "многопоточный C", "многопоточный Rust", "BEAM Erlang/Elixir"],
    bests: ["OLTP по умолчанию", "больше 100k QPS на ноде", "пулинг + маршрутизация", "serverless · миллионы conn"],
    nameHead: "пулер",
    threadHead: "потоки",
    bestHead: "бери когда",
    foot: "один PgBouncer тянет десятки тысяч QPS · пересмотри у потолка CPU",
    caption:
      "PgBouncer 1.21+ — production-дефолт для OLTP; Odyssey выигрывает после 100k QPS на ноде, PgCat добавляет маршрутизацию к репликам, а Supavisor поглощает serverless-штормы из миллионов соединений.",
  },
};

const t = dict[lang];

const poolY = [110, 172, 234, 296];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-pick-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="125" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.nameHead}</text>
    <text x="305" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.threadHead}</text>
    <text x="565" y="98" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bestHead}</text>

    {t.names.map((n, i) => (
      <g>
        <rect x="40" y={poolY[i]} width="170" height="52" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="125" y={poolY[i] + 33} text-anchor="middle" font-size="12" fill="var(--ink)">{n}</text>
        <rect x="220" y={poolY[i]} width="170" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="305" y={poolY[i] + 33} text-anchor="middle" font-size="11" fill="var(--ink)">{t.threads[i]}</text>
        <rect x="400" y={poolY[i]} width="330" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="565" y={poolY[i] + 33} text-anchor="middle" font-size="11" fill="var(--ink)">{t.bests[i]}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
