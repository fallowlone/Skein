---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Connection storm: hundreds to thousands of serverless cold starts each open Postgres connections and exhaust max_connections 100 — a colocated pooler absorbs the burst, an HTTP driver serves the edge, idle timeouts reclaim dead workers",
    headline: "COLD STARTS × CONNS = STORM",
    sub: "serverless violates the long-lived-client assumption",
    stormT: "cold-start storm",
    stormS: "100s–1000s workers × conns",
    capT: "max_connections = 100",
    capS: "backends out · FATAL",
    fixes: ["pooler absorbs the burst", "HTTP driver: Neon / Hyperdrive", "idle timeouts drop dead conns"],
    foot: "stateless dispatch at the edge · persistent conns at the pooler",
    caption:
      "Serverless cold starts open a real backend each and exhaust max_connections under burst; a colocated pooler absorbs the storm, an HTTP-based driver serves edge workers, and aggressive idle timeouts reclaim dead connections.",
  },
  ru: {
    svgTitle: "Шторм соединений: сотни и тысячи serverless cold start открывают соединения Postgres и исчерпывают max_connections 100 — расположенный рядом пулер поглощает всплеск, HTTP-драйвер обслуживает edge, idle-таймауты чистят мёртвых worker",
    headline: "COLD START × CONN = ШТОРМ",
    sub: "serverless нарушает допущение о долгоживущих клиентах",
    stormT: "шторм cold start",
    stormS: "сотни–тысячи worker × conn",
    capT: "max_connections = 100",
    capS: "backend кончились · FATAL",
    fixes: ["пулер поглощает всплеск", "HTTP-драйвер (Neon/Hyperdrive)", "idle-таймауты чистят мёртвые"],
    foot: "stateless dispatch на edge · постоянные conn у пулера",
    caption:
      "Serverless cold start открывают по реальному backend и исчерпывают max_connections при всплеске; расположенный рядом пулер поглощает шторм, HTTP-драйвер обслуживает edge-воркеры, а агрессивные idle-таймауты чистят мёртвые соединения.",
  },
};

const t = dict[lang];

const fixX = [40, 280, 520];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-storm-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="110" width="340" height="130" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="150" text-anchor="middle" font-size="13" fill="var(--ink)">{t.stormT}</text>
    <rect x="60" y="168" width="300" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stormS}</text>

    <line x1="380" y1="175" x2="418" y2="175" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-storm-arrow)" />

    <rect x="422" y="110" width="338" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="591" y="150" text-anchor="middle" font-size="13" fill="var(--ink)">{t.capT}</text>
    <rect x="442" y="168" width="298" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="591" y="196" text-anchor="middle" font-size="12" fill="var(--accent)">{t.capS}</text>

    {t.fixes.map((f, i) => (
      <g>
        <rect x={fixX[i]} y="272" width="230" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={fixX[i] + 115} y="307" text-anchor="middle" font-size="11" fill="var(--ink)">{f}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
