---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Backend pool formula: 8 cores on NVMe gives 16 plus headroom is 24, 16 cores gives 32 plus headroom is 48, 8 cores on HDD RAID gives 22 plus headroom is 33 — the naive match-client-count 200 overshoots tenfold",
    headline: "POOL_SIZE = (CORES × 2) + SPINDLES",
    sub: "size backends for the CPU, not for the client count",
    rows: ["8 cores · NVMe · RAM", "16 cores · NVMe · RAM", "8 cores · HDD RAID · cold", "naive: match client count"],
    vals: ["→ 24", "→ 48", "→ 33", "= 200"],
    foot: "formula lands on 24–48 backends · matching clients overshoots ~10×",
    caption:
      "The (cores × 2) + spindles formula with ~50% headroom lands on 24–48 backends; sizing by client count gives 200 and degrades Postgres throughput instead of raising it.",
  },
  ru: {
    svgTitle: "Формула backend-пула: 8 ядер на NVMe дают 16 плюс запас — 24, 16 ядер дают 32 плюс запас — 48, 8 ядер на HDD RAID дают 22 плюс запас — 33; наивные 200 по числу клиентов завышают в 10 раз",
    headline: "POOL_SIZE = (ЯДРА × 2) + ШПИНДЕЛИ",
    sub: "размер backend под CPU, а не под число клиентов",
    rows: ["8 ядер · NVMe · RAM", "16 ядер · NVMe · RAM", "8 ядер · HDD RAID · холодные", "наивно: по числу клиентов"],
    vals: ["→ 24", "→ 48", "→ 33", "= 200"],
    foot: "формула даёт 24–48 backend · равнение на клиентов завышает ~в 10×",
    caption:
      "Формула (ядра × 2) + шпиндели с запасом ~50% даёт 24–48 backend; размер по числу клиентов даёт 200 и снижает пропускную способность Postgres вместо роста.",
  },
};

const t = dict[lang];

const barY = [110, 168, 226, 284];
const barH = [40, 40, 40, 40];
const barW = [48, 96, 66, 400];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-formula-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.rows.map((r, i) => (
      <g>
        <text x="40" y={barY[i] + 26} font-size="12" fill="var(--ink)">{r}</text>
        <rect x="300" y={barY[i]} width={barW[i]} height={barH[i]} fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x={300 + barW[i] + 10} y={barY[i] + 27} font-size="15" fill="var(--accent)">{t.vals[i]}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
