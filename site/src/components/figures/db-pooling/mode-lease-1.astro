---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Lease scope: session mode holds one backend per client for the whole connection with 1 to 1 multiplexing; transaction mode leases a backend per transaction for 10 to 100 times multiplexing",
    headline: "LEASE: CONNECTION vs TRANSACTION",
    sub: "the lease scope decides what state survives",
    sesTitle: "SESSION MODE · 1:1",
    sesClients: ["client A", "client B"],
    sesBackends: ["B1 · held", "B2 · held"],
    sesFoot: "lease: whole connection · multiplexing none",
    txTitle: "TRANSACTION MODE · 10–100×",
    txClients: ["client A", "client B", "client C"],
    txBackends: ["B1 · reused", "B2 · reused"],
    txFoot: "lease: one transaction · multiplexing 10–100×",
    foot: "10,000 clients run on 20–50 backends in transaction mode",
    caption:
      "Session mode pins one backend per client for the whole connection, so nothing multiplexes; transaction mode leases a backend for one transaction and returns it, multiplexing 10–100× — which is why session state does not survive.",
  },
  ru: {
    svgTitle: "Аренда: session mode держит backend на клиента всё соединение 1 к 1; transaction mode арендует backend на транзакцию — мультиплексирование 10–100×",
    headline: "АРЕНДА: СОЕДИНЕНИЕ vs ТРАНЗАКЦИЯ",
    sub: "границы аренды решают, какое состояние выживет",
    sesTitle: "SESSION MODE · 1:1",
    sesClients: ["клиент A", "клиент B"],
    sesBackends: ["B1 · держит", "B2 · держит"],
    sesFoot: "аренда: всё соединение · мультиплексирования нет",
    txTitle: "TRANSACTION MODE · 10–100×",
    txClients: ["клиент A", "клиент B", "клиент C"],
    txBackends: ["B1 · повторно", "B2 · повторно"],
    txFoot: "аренда: транзакция · 10–100×",
    foot: "10 000 клиентов работают на 20–50 backend в transaction mode",
    caption:
      "Session mode закрепляет backend за клиентом на всё соединение — мультиплексирования нет; transaction mode арендует backend на одну транзакцию и возвращает его, давая 10–100×, — поэтому session-состояние не переживает границы.",
  },
};

const t = dict[lang];

const sesCY = [150, 208];
const txCY = [140, 190, 240];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-lease-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="100" width="350" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="205" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.sesTitle}</text>
    {t.sesClients.map((c, i) => (
      <g>
        <rect x="50" y={sesCY[i]} width="120" height="36" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="110" y={sesCY[i] + 24} text-anchor="middle" font-size="11" fill="var(--ink)">{c}</text>
        <line x1="170" y1={sesCY[i] + 18} x2="232" y2={sesCY[i] + 18} stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-lease-arrow)" />
        <rect x="236" y={sesCY[i]} width="120" height="36" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
        <text x="296" y={sesCY[i] + 24} text-anchor="middle" font-size="11" fill="var(--ink)">{t.sesBackends[i]}</text>
      </g>
    ))}
    <text x="205" y="290" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sesFoot}</text>

    <rect x="420" y="100" width="350" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="595" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.txTitle}</text>
    {t.txClients.map((c, i) => (
      <g>
        <rect x="440" y={txCY[i]} width="110" height="32" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="495" y={txCY[i] + 22} text-anchor="middle" font-size="11" fill="var(--ink)">{c}</text>
      </g>
    ))}
    <rect x="630" y="140" width="120" height="36" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="690" y="163" text-anchor="middle" font-size="11" fill="var(--ink)">{t.txBackends[0]}</text>
    <rect x="630" y="204" width="120" height="36" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="690" y="227" text-anchor="middle" font-size="11" fill="var(--ink)">{t.txBackends[1]}</text>
    <line x1="550" y1="156" x2="622" y2="158" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-lease-arrow)" />
    <line x1="550" y1="206" x2="622" y2="222" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-lease-arrow)" />
    <line x1="550" y1="256" x2="622" y2="226" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-lease-arrow)" />
    <text x="595" y="290" text-anchor="middle" font-size="11" fill="var(--muted)">{t.txFoot}</text>

    <rect x="30" y="322" width="740" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="355" text-anchor="middle" font-size="13" fill="var(--ink)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
