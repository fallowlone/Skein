---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "02:14 page: pool of 24 is fully held, 180 clients wait in cl_waiting, and 19 backends sit idle in transaction with max age 8 minutes",
    headline: "02:14 · POOL = 24 · CL_WAITING = 180",
    sub: "the pool was sized correctly this morning — holds changed",
    poolTitle: "pool: 24 / 24 held",
    poolNote: "no free slot",
    waitTitle: "cl_waiting = 180",
    waitLine: "180",
    waitSub: "queued · app 503",
    stuckLine: "19 × idle in transaction",
    stuckSub: "max age 8 min",
    diagNote: "diagnose: pg_stat_activity by state",
    foot: "find the hold · fix the hold",
    caption:
      "At 02:14 all 24 pool slots are held while 180 clients queue; pg_stat_activity shows 19 backends idle in transaction up to 8 minutes old — exhaustion is a hold-time problem, not a sizing problem.",
  },
  ru: {
    svgTitle: "Пейджер в 02:14: пул из 24 полностью занят, 180 клиентов ждут в cl_waiting, 19 backend в idle in transaction с возрастом до 8 минут",
    headline: "02:14 · ПУЛ = 24 · CL_WAITING = 180",
    sub: "утром пул был настроен верно — изменились удержания",
    poolTitle: "пул: 24 / 24 заняты",
    poolNote: "нет свободных",
    waitTitle: "cl_waiting = 180",
    waitLine: "180",
    waitSub: "очередь · 503",
    stuckLine: "19 × idle in transaction",
    stuckSub: "возраст до 8 мин",
    diagNote: "диагностика: pg_stat_activity по state",
    foot: "найди удержание · исправь удержание",
    caption:
      "В 02:14 все 24 слота пула заняты, а 180 клиентов в очереди; pg_stat_activity показывает 19 backend в idle in transaction возрастом до 8 минут — исчерпание это проблема удержания, а не размера.",
  },
};

const t = dict[lang];

const slotX = [60, 94, 128, 162, 196, 230, 60, 94, 128, 162, 196, 230, 60, 94, 128, 162, 196, 230, 60, 94, 128, 162, 196, 230];
const slotY = [150, 150, 150, 150, 150, 150, 178, 178, 178, 178, 178, 178, 206, 206, 206, 206, 206, 206, 234, 234, 234, 234, 234, 234];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbpool-page-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="240" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="160" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.poolTitle}</text>
    {slotX.map((sx, i) => (
      <g>
        <rect x={sx} y={slotY[i]} width="28" height="22" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
      </g>
    ))}
    <text x="160" y="292" text-anchor="middle" font-size="11" fill="var(--muted)">{t.poolNote}</text>

    <line x1="280" y1="210" x2="318" y2="210" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbpool-page-arrow)" />

    <rect x="320" y="100" width="440" height="220" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="540" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.waitTitle}</text>
    <text x="430" y="200" text-anchor="middle" font-size="30" fill="var(--accent)">{t.waitLine}</text>
    <text x="430" y="228" text-anchor="middle" font-size="11" fill="var(--muted)">{t.waitSub}</text>
    <rect x="520" y="150" width="220" height="100" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="630" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stuckLine}</text>
    <text x="630" y="212" text-anchor="middle" font-size="11" fill="var(--muted)">{t.stuckSub}</text>
    <text x="540" y="292" text-anchor="middle" font-size="11" fill="var(--muted)">{t.diagNote}</text>

    <rect x="40" y="340" width="720" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="368" text-anchor="middle" font-size="13" fill="var(--ink)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
