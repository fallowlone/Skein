---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Naive union builds an O(n) chain; union by rank keeps trees shallow",
    headline: "NAIVE CHAIN VS UNION BY RANK",
    sub: "blind links degenerate · rank keeps height logarithmic",
    leftTitle: "naive: blind links build a chain",
    chainCode: "union(1,0), union(2,1), union(3,2), union(4,3)",
    walkLine1: "find(4) walks:",
    walkLine2: "4 → 3 → 2 → 1 → 0",
    walkLine3: "4 hops = n − 1 = O(n)",
    rightTitle: "union by rank: smaller under larger",
    beforeLine: "before: A (rank 1) + x · B (rank 0)",
    rankA: "rank 1",
    rankB: "rank 0",
    bound1: "rank[A] stays 1 — shallow, not a chain",
    bound2: "rank-r tree holds ≥ 2ʳ elements",
    bound3: "height ≤ log₂(n) · find is O(log n)",
    caption:
      "Blind unions chain 0←1←2←3←4, so find(4) walks 4 hops (O(n)). Union by rank instead attaches B (rank 0) under A (rank 1); a rank-r tree holds at least 2ʳ elements, so height stays within log₂(n).",
  },
  ru: {
    svgTitle: "Наивный union строит цепь O(n); union по рангу держит деревья мелкими",
    headline: "НАИВНАЯ ЦЕПЬ ПРОТИВ UNION ПО РАНГУ",
    sub: "слепые связи вырождаются · ранг держит высоту логарифмической",
    leftTitle: "наивно: слепые связи строят цепь",
    chainCode: "union(1,0), union(2,1), union(3,2), union(4,3)",
    walkLine1: "find(4) проходит:",
    walkLine2: "4 → 3 → 2 → 1 → 0",
    walkLine3: "4 прыжка = n − 1 = O(n)",
    rightTitle: "union по рангу: меньшее под большее",
    beforeLine: "до: A (ранг 1) + x · B (ранг 0)",
    rankA: "ранг 1",
    rankB: "ранг 0",
    bound1: "rank[A] остаётся 1 — мелко, не цепь",
    bound2: "дерево ранга r держит ≥ 2ʳ элементов",
    bound3: "высота ≤ log₂(n) · find это O(log n)",
    caption:
      "Слепые union выстраивают цепь 0←1←2←3←4, так что find(4) проходит 4 прыжка (O(n)). Union по рангу вместо этого прицепляет B (ранг 0) под A (ранг 1); дерево ранга r держит хотя бы 2ʳ элементов, так что высота остаётся в пределах log₂(n).",
  },
};

const t = dict[lang];

interface Link {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  pts: string;
}

function arrow(x1: number, y1: number, x2: number, y2: number, r1: number, r2: number): Link {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  const sx = x1 + ux * (r1 + 2);
  const sy = y1 + uy * (r1 + 2);
  const ex = x2 - ux * (r2 + 2);
  const ey = y2 - uy * (r2 + 2);
  const s = 8;
  const bx = ex - ux * s;
  const by = ey - uy * s;
  const px = -uy;
  const py = ux;
  const pts = `${ex},${ey} ${bx + px * 4.5},${by + py * 4.5} ${bx - px * 4.5},${by - py * 4.5}`;
  return { x1: sx, y1: sy, x2: ex, y2: ey, pts };
}

const chainX = 110;
const chainR = 17;
const chainNodes = [
  { y: 148, label: "0" },
  { y: 202, label: "1" },
  { y: 256, label: "2" },
  { y: 310, label: "3" },
  { y: 364, label: "4" },
];
const chainPairs: Array<[number, number]> = [[202, 148], [256, 202], [310, 256], [364, 310]];
const chainLinks = chainPairs.map(([b, tp]) => arrow(chainX, b, chainX, tp, chainR, chainR));

const rootA = { x: 600, y: 168, label: "A" };
const childX = { x: 520, y: 252, label: "x" };
const childB = { x: 680, y: 252, label: "B" };
const treeR = 20;
const treeNodes = [rootA, childX, childB];
const treeLinks = [childX, childB].map((c) => arrow(c.x, c.y, rootA.x, rootA.y, treeR, treeR));
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="32" text-anchor="middle" font-family="var(--font-display)" font-size="21" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    <line x1="400" y1="78" x2="400" y2="392" stroke="var(--muted)" stroke-width="1" />

    <text x="200" y="94" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    <text x="200" y="116" text-anchor="middle" font-size="11" fill="var(--muted)">{t.chainCode}</text>
    {chainNodes.map((n) => (
      <g>
        <circle cx={chainX} cy={n.y} r={chainR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={chainX} y={n.y + 5} text-anchor="middle" font-size="14" fill="var(--ink)">{n.label}</text>
      </g>
    ))}
    {chainLinks.map((l) => (
      <g>
        <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={l.pts} fill="var(--accent)" />
      </g>
    ))}
    <text x="200" y="224" font-size="12" fill="var(--ink)">{t.walkLine1}</text>
    <text x="200" y="248" font-size="13" fill="var(--ink)">{t.walkLine2}</text>
    <text x="200" y="272" font-size="12" fill="var(--accent)">{t.walkLine3}</text>

    <text x="600" y="94" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    <text x="600" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.beforeLine}</text>
    {treeNodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r={treeR} fill="var(--card)" stroke={n.label === "A" ? "var(--accent)" : "var(--ink)"} stroke-width={n.label === "A" ? 3 : 2} />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="15" fill="var(--ink)">{n.label}</text>
      </g>
    ))}
    {treeLinks.map((l) => (
      <g>
        <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={l.pts} fill="var(--accent)" />
      </g>
    ))}
    <text x="628" y="172" font-size="11" fill="var(--accent)">{t.rankA}</text>
    <text x="708" y="256" font-size="11" fill="var(--muted)">{t.rankB}</text>

    <text x="600" y="302" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bound1}</text>
    <text x="600" y="328" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bound2}</text>
    <text x="600" y="354" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bound3}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
