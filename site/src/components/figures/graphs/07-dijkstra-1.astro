---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Directed weighted example graph with the A to B cost trap",
    headline: "THE TRAP GRAPH: DIRECT 4 vs DETOUR 3",
    sub: "directed · arrows show direction · numbers are weights",
    source: "source",
    direct: "direct A→B = 4",
    detour: "detour A→C→B = 1+2 = 3 ✓ cheaper",
    caption:
      "Example graph A:[B:4, C:1], B:[E:4], C:[B:2, D:5], D:[E:2], E:[F:3]. The direct edge A→B costs 4, but the detour A→C→B costs 1+2 = 3 — Dijkstra must discover the cheaper route through C.",
  },
  ru: {
    svgTitle: "Ориентированный взвешенный пример графа с ловушкой цены A в B",
    headline: "ГРАФ-ЛОВУШКА: НАПРЯМУЮ 4 vs ОБХОД 3",
    sub: "ориентированный · стрелки показывают направление · числа — веса",
    source: "источник",
    direct: "напрямую A→B = 4",
    detour: "обход A→C→B = 1+2 = 3 ✓ дешевле",
    caption:
      "Пример графа A:[B:4, C:1], B:[E:4], C:[B:2, D:5], D:[E:2], E:[F:3]. Прямое ребро A→B стоит 4, но обход A→C→B стоит 1+2 = 3 — Дейкстра должна обнаружить более дешёвый маршрут через C.",
  },
};

const t = dict[lang];

const nodes = [
  { id: "A", x: 170, y: 130 },
  { id: "B", x: 500, y: 130 },
  { id: "C", x: 170, y: 300 },
  { id: "D", x: 335, y: 300 },
  { id: "E", x: 500, y: 300 },
  { id: "F", x: 660, y: 300 },
];

const edges = [
  { x1: 196, y1: 130, x2: 474, y2: 130, w: "4", lx: 335, ly: 116, head: "474,130 462,124 462,136" },
  { x1: 170, y1: 156, x2: 170, y2: 274, w: "1", lx: 150, ly: 218, head: "170,274 164,262 176,262" },
  { x1: 197, y1: 286, x2: 473, y2: 144, w: "2", lx: 345, ly: 230, head: "473,144 465,154 460,145" },
  { x1: 196, y1: 300, x2: 309, y2: 300, w: "5", lx: 252, ly: 288, head: "309,300 297,294 297,306" },
  { x1: 361, y1: 300, x2: 474, y2: 300, w: "2", lx: 417, ly: 288, head: "474,300 462,294 462,306" },
  { x1: 500, y1: 156, x2: 500, y2: 274, w: "4", lx: 522, ly: 218, head: "500,274 494,262 506,262" },
  { x1: 526, y1: 300, x2: 634, y2: 300, w: "3", lx: 580, ly: 288, head: "634,300 622,294 622,306" },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="170" y="94" text-anchor="middle" font-size="12" fill="var(--muted)">{t.source}</text>

    {edges.map((e) => (
      <g>
        <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
        <polygon points={e.head} fill="var(--ink)" />
        <text x={e.lx} y={e.ly} text-anchor="middle" font-size="14" fill="var(--accent)">{e.w}</text>
      </g>
    ))}

    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="26" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="17" fill="var(--ink)">{n.id}</text>
      </g>
    ))}

    <text x="270" y="372" text-anchor="middle" font-size="14" fill="var(--muted)">{t.direct}</text>
    <text x="560" y="372" text-anchor="middle" font-size="14" fill="var(--accent)">{t.detour}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
