---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Mark-on-enqueue discipline: vertex 4 enqueued twice without it, exactly once with it",
    headline: "MARK ON ENQUEUE — EACH VERTEX ONCE",
    sub: "1 has neighbors 2, 3 · 2 and 3 both point at 4",
    badTitle: "BAD · mark on dequeue",
    goodTitle: "GOOD · mark on enqueue",
    badQueue: "queue: [4, 4] — duplicate!",
    goodQueue: "queue: [4] — exactly once",
    skipLabel: "skip",
    timeLine: "time O(V+E) · space O(V)",
    numLine: "5 vertices + 7 edges → O(5 + 7) = O(12)",
    caption:
      "Why mark-on-enqueue matters: with neighbors 1 → 2, 3 and 2, 3 → 4, marking on dequeue lets 4 enter the queue twice ([4, 4] duplicate), while marking on enqueue lets the second discovery of 4 skip, so 4 enters exactly once. BFS costs O(V+E) time and O(V) space — 5 vertices and 7 edges run in O(12).",
  },
  ru: {
    svgTitle: "Дисциплина отметки при добавлении: вершина 4 добавляется дважды без неё, ровно раз с ней",
    headline: "ОТМЕТКА ПРИ ДОБАВЛЕНИИ — КАЖДАЯ ВЕРШИНА РАЗ",
    sub: "у 1 соседи 2, 3 · 2 и 3 обе указывают на 4",
    badTitle: "ПЛОХО · отметка при извлечении",
    goodTitle: "ХОРОШО · отметка при добавлении",
    badQueue: "очередь: [4, 4] — дубликат!",
    goodQueue: "очередь: [4] — ровно раз",
    skipLabel: "пропуск",
    timeLine: "время O(V+E) · память O(V)",
    numLine: "5 вершин + 7 рёбер → O(5 + 7) = O(12)",
    caption:
      "Почему важна отметка при добавлении: при соседях 1 → 2, 3 и 2, 3 → 4 отметка при извлечении кладёт 4 в очередь дважды ([4, 4] дубликат), а отметка при добавлении заставляет повторное открытие 4 пропуститься, так 4 входит ровно раз. BFS стоит O(V+E) времени и O(V) памяти — 5 вершин и 7 рёбер выполняются за O(12).",
  },
};

const t = dict[lang];

const nodeR = 20;

const diamonds = [
  {
    title: t.badTitle,
    cx: 200,
    queue: t.badQueue,
    qx: 60,
    nodes: [
      { v: "1", x: 200, y: 118 },
      { v: "2", x: 125, y: 193 },
      { v: "3", x: 275, y: 193 },
      { v: "4", x: 200, y: 266 },
    ],
  },
  {
    title: t.goodTitle,
    cx: 600,
    queue: t.goodQueue,
    qx: 460,
    nodes: [
      { v: "1", x: 600, y: 118 },
      { v: "2", x: 525, y: 193 },
      { v: "3", x: 675, y: 193 },
      { v: "4", x: 600, y: 266 },
    ],
  },
];

const cut = (x1: number, y1: number, x2: number, y2: number, a: number, b: number) => {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  return { x1: x1 + ux * a, y1: y1 + uy * a, x2: x2 - ux * b, y2: y2 - uy * b };
};

const edgePairs = (cx: number) => [
  { e: cut(cx, 118, cx - 75, 193, nodeR + 2, nodeR + 3), dashed: false },
  { e: cut(cx, 118, cx + 75, 193, nodeR + 2, nodeR + 3), dashed: false },
  { e: cut(cx - 75, 193, cx, 266, nodeR + 2, nodeR + 3), dashed: false },
  { e: cut(cx + 75, 193, cx, 266, nodeR + 2, nodeR + 3), dashed: cx === 600 },
];

const edgesLeft = edgePairs(200);
const edgesRight = edgePairs(600);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="bfs3-arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
        <path d="M0,0 L8,4 L0,8 z" fill="var(--ink)" />
      </marker>
      <marker id="bfs3-arrMut" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
        <path d="M0,0 L8,4 L0,8 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="32" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="56" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="88" text-anchor="middle" font-size="13" fill="var(--ink)">{t.badTitle}</text>
    <text x="600" y="88" text-anchor="middle" font-size="13" fill="var(--accent)">{t.goodTitle}</text>

    {edgesLeft.map((ed) => (
      <line x1={ed.e.x1} y1={ed.e.y1} x2={ed.e.x2} y2={ed.e.y2} stroke="var(--ink)" stroke-width="2" marker-end="url(#bfs3-arr)" />
    ))}
    {edgesRight.map((ed) => (
      <line x1={ed.e.x1} y1={ed.e.y1} x2={ed.e.x2} y2={ed.e.y2} stroke={ed.dashed ? "var(--muted)" : "var(--ink)"} stroke-width="2" stroke-dasharray={ed.dashed ? "5 4" : undefined} marker-end={ed.dashed ? "url(#bfs3-arrMut)" : "url(#bfs3-arr)"} />
    ))}
    <text x="656" y="232" font-size="11" fill="var(--muted)">{t.skipLabel}</text>

    {diamonds.map((d) => (
      <g>
        {d.nodes.map((n) => (
          <g>
            <circle cx={n.x} cy={n.y} r={nodeR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
            <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="15" fill="var(--ink)">{n.v}</text>
          </g>
        ))}
        <rect x={d.qx} y="292" width="280" height="32" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={d.cx} y="313" text-anchor="middle" font-size="13" fill="var(--ink)">{d.queue}</text>
      </g>
    ))}

    <line x1="400" y1="96" x2="400" y2="324" stroke="var(--muted)" stroke-width="1" />

    <text x="400" y="356" text-anchor="middle" font-size="13" fill="var(--ink)">{t.timeLine}</text>
    <text x="400" y="380" text-anchor="middle" font-size="13" fill="var(--muted)">{t.numLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
