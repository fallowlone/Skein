---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Dijkstra settle order with stale entry skipped by lazy deletion",
    headline: "SETTLE ORDER: A → C → B → D → E → F",
    sub: "pop the heap minimum · settle it as final · relax its edges",
    settledBox: "B settled at 3",
    staleBox: "(4,B)",
    staleNote: "stale: skip",
    formula: "relax: if dist[u]+w < dist[v]: dist[v] = dist[u]+w, parent[v] = u",
    parents: "parent: B←C  C←A  D←C  E←B  F←E",
    caption:
      "Settle order A(0), C(1), B(3), D(6), E(7), F(10). B is relaxed twice — tentatively 4 via A, improved to 3 via C — so the stale (4,B) entry is skipped when popped (lazy deletion). Final: A=0 B=3 C=1 D=6 E=7 F=10.",
  },
  ru: {
    svgTitle: "Порядок фиксации Дейкстры с пропуском устаревшей записи ленивым удалением",
    headline: "ПОРЯДОК ФИКСАЦИИ: A → C → B → D → E → F",
    sub: "извлеки минимум кучи · зафиксируй как итог · релаксируй рёбра",
    settledBox: "B зафиксирована на 3",
    staleBox: "(4,B)",
    staleNote: "устарела: пропуск",
    formula: "relax: если dist[u]+w < dist[v]: dist[v] = dist[u]+w, parent[v] = u",
    parents: "parent: B←C  C←A  D←C  E←B  F←E",
    caption:
      "Порядок фиксации A(0), C(1), B(3), D(6), E(7), F(10). B релаксирована дважды — предварительно 4 через A, улучшена до 3 через C — так что устаревшая запись (4,B) пропускается при извлечении (ленивое удаление). Итог: A=0 B=3 C=1 D=6 E=7 F=10.",
  },
};

const t = dict[lang];

const chain = [
  { v: "A", d: "0" },
  { v: "C", d: "1" },
  { v: "B", d: "3" },
  { v: "D", d: "6" },
  { v: "E", d: "7" },
  { v: "F", d: "10" },
];

const cy = 168;
const cr = 34;
const cx = (i: number) => 80 + i * 128;
const links = [0, 1, 2, 3, 4];
const linkX1 = (i: number) => cx(i) + cr + 2;
const linkX2 = (i: number) => cx(i + 1) - cr - 2;
const head = (x2: number) => `${x2},${cy} ${x2 - 12},${cy - 6} ${x2 - 12},${cy + 6}`;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="80" y="106" text-anchor="middle" font-size="12" fill="var(--muted)">(0,A)</text>
    <text x="208" y="106" text-anchor="middle" font-size="12" fill="var(--muted)">(1,C)</text>
    <text x="336" y="106" text-anchor="middle" font-size="12" fill="var(--muted)">(3,B)</text>
    <text x="464" y="106" text-anchor="middle" font-size="12" fill="var(--muted)">(6,D)</text>
    <text x="592" y="106" text-anchor="middle" font-size="12" fill="var(--muted)">(7,E)</text>
    <text x="720" y="106" text-anchor="middle" font-size="12" fill="var(--muted)">(10,F)</text>

    {links.map((i) => (
      <g>
        <line x1={linkX1(i)} y1={cy} x2={linkX2(i)} y2={cy} stroke="var(--ink)" stroke-width="2" />
        <polygon points={head(linkX2(i))} fill="var(--ink)" />
      </g>
    ))}

    {chain.map((s, i) => (
      <g>
        <circle cx={cx(i)} cy={cy} r={cr} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cx(i)} y={cy - 2} text-anchor="middle" font-size="17" fill="var(--ink)">{s.v}</text>
        <text x={cx(i)} y={cy + 18} text-anchor="middle" font-size="13" fill="var(--accent)">{s.d}</text>
      </g>
    ))}

    <rect x="60" y="240" width="220" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="170" y="267" text-anchor="middle" font-size="13" fill="var(--ink)">{t.settledBox}</text>
    <line x1="280" y1="262" x2="348" y2="262" stroke="var(--ink)" stroke-width="2" />
    <polygon points="348,262 336,256 336,268" fill="var(--ink)" />
    <rect x="348" y="240" width="110" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="403" y="267" text-anchor="middle" font-size="13" fill="var(--muted)">{t.staleBox}</text>
    <line x1="356" y1="246" x2="450" y2="278" stroke="var(--accent)" stroke-width="2" />
    <line x1="450" y1="246" x2="356" y2="278" stroke="var(--accent)" stroke-width="2" />
    <text x="480" y="267" font-size="13" fill="var(--accent)">{t.staleNote}</text>

    <text x="400" y="330" text-anchor="middle" font-size="13" fill="var(--ink)">{t.formula}</text>
    <text x="400" y="362" text-anchor="middle" font-size="13" fill="var(--muted)">{t.parents}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
