---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Path compression flattens the tree; cost ladder down to amortized O of alpha n",
    headline: "PATH COMPRESSION + THE COST LADDER",
    sub: "flatten as you climb · both tricks together collapse cost to near-constant",
    beforeTitle: "before find(4)",
    afterTitle: "after find(4)",
    flatLine1: "every node now points near the root",
    flatLine2: "next find(4): one hop",
    halvingCode: "parent[x] = parent[parent[x]]",
    halvingNote: "path halving: point x at its grandparent",
    costTitle: "cost ladder",
    colN: "n",
    colA: "α(n)",
    tableNote: "still 4 — astronomically large input",
    cost1: "naive find: O(n)",
    cost2: "rank alone: O(log n)",
    cost3: "both: amortized O(α(n))",
    cost4: "α(n) < 5 · space O(n)",
    caption:
      "find(4) with compression repoints 1, 2, 3, 4 near root 0 (path halving: parent[x] = parent[parent[x]]), so the next find is one hop. Cost falls from O(n) to O(log n) with rank alone, to amortized O(α(n)) with both; α(n) stays below 5 and space is O(n).",
  },
  ru: {
    svgTitle: "Сжатие путей распрямляет дерево; лесенка стоимости до амортизированного O от альфа n",
    headline: "СЖАТИЕ ПУТЕЙ + ЛЕСЕНКА СТОИМОСТИ",
    sub: "распрямляй при подъёме · оба приёма вместе дают почти константу",
    beforeTitle: "до find(4)",
    afterTitle: "после find(4)",
    flatLine1: "все узлы теперь указывают на корень",
    flatLine2: "следующий find(4): один прыжок",
    halvingCode: "parent[x] = parent[parent[x]]",
    halvingNote: "уполовинивание: укажи x на его деда",
    costTitle: "лесенка стоимости",
    colN: "n",
    colA: "α(n)",
    tableNote: "всё ещё 4 — астрономически большой вход",
    cost1: "наивный find: O(n)",
    cost2: "только ранг: O(log n)",
    cost3: "оба: амортизированно O(α(n))",
    cost4: "α(n) < 5 · память O(n)",
    caption:
      "find(4) со сжатием перенаправляет 1, 2, 3, 4 близко к корню 0 (уполовинивание: parent[x] = parent[parent[x]]), так что следующий find — один прыжок. Стоимость падает с O(n) до O(log n) только с рангом, до амортизированного O(α(n)) с обоими; α(n) остаётся ниже 5, а память это O(n).",
  },
};

const t = dict[lang];

interface Link {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  pts: string;
}

function arrow(x1: number, y1: number, x2: number, y2: number, r1: number, r2: number): Link {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  const sx = x1 + ux * (r1 + 2);
  const sy = y1 + uy * (r1 + 2);
  const ex = x2 - ux * (r2 + 2);
  const ey = y2 - uy * (r2 + 2);
  const s = 8;
  const bx = ex - ux * s;
  const by = ey - uy * s;
  const px = -uy;
  const py = ux;
  const pts = `${ex},${ey} ${bx + px * 4.5},${by + py * 4.5} ${bx - px * 4.5},${by - py * 4.5}`;
  return { x1: sx, y1: sy, x2: ex, y2: ey, pts };
}

const chainX = 120;
const chainR = 16;
const chainNodes = [
  { y: 130, label: "0" },
  { y: 182, label: "1" },
  { y: 234, label: "2" },
  { y: 286, label: "3" },
  { y: 338, label: "4" },
];
const chainPairs: Array<[number, number]> = [[182, 130], [234, 182], [286, 234], [338, 286]];
const chainLinks = chainPairs.map(([b, tp]) => arrow(chainX, b, chainX, tp, chainR, chainR));

const flatRoot = { x: 320, y: 130 };
const flatR = 18;
const flatChildY = 230;
const flatChildR = 17;
const flatNodes = [
  { x: 228, label: "1" },
  { x: 290, label: "2" },
  { x: 352, label: "3" },
  { x: 414, label: "4" },
];
const flatLinks = flatNodes.map((n) => arrow(n.x, flatChildY, flatRoot.x, flatRoot.y, flatChildR, flatR));

const alphaRows = [
  { n: "2", a: "1" },
  { n: "4", a: "2" },
  { n: "16", a: "3" },
  { n: "65536", a: "4" },
  { n: "2^65536", a: "4" },
];
const rowY = (i: number) => 150 + i * 26;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="32" text-anchor="middle" font-family="var(--font-display)" font-size="21" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    <line x1="470" y1="78" x2="470" y2="395" stroke="var(--muted)" stroke-width="1" />

    <text x="120" y="96" text-anchor="middle" font-size="12" fill="var(--ink)">{t.beforeTitle}</text>
    <text x="320" y="96" text-anchor="middle" font-size="12" fill="var(--ink)">{t.afterTitle}</text>

    {chainNodes.map((n) => (
      <g>
        <circle cx={chainX} cy={n.y} r={chainR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={chainX} y={n.y + 5} text-anchor="middle" font-size="13" fill="var(--ink)">{n.label}</text>
      </g>
    ))}
    {chainLinks.map((l) => (
      <g>
        <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={l.pts} fill="var(--accent)" />
      </g>
    ))}

    <circle cx={flatRoot.x} cy={flatRoot.y} r={flatR} fill="var(--card)" stroke="var(--accent)" stroke-width="3" />
    <text x={flatRoot.x} y={flatRoot.y + 5} text-anchor="middle" font-size="14" fill="var(--ink)">0</text>
    {flatNodes.map((n) => (
      <g>
        <circle cx={n.x} cy={flatChildY} r={flatChildR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={flatChildY + 5} text-anchor="middle" font-size="13" fill="var(--ink)">{n.label}</text>
      </g>
    ))}
    {flatLinks.map((l) => (
      <g>
        <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={l.pts} fill="var(--accent)" />
      </g>
    ))}

    <text x="267" y="282" text-anchor="middle" font-size="12" fill="var(--ink)">{t.flatLine1}</text>
    <text x="267" y="306" text-anchor="middle" font-size="12" fill="var(--accent)">{t.flatLine2}</text>
    <text x="267" y="332" text-anchor="middle" font-size="11" fill="var(--muted)">{t.halvingCode}</text>
    <text x="267" y="356" text-anchor="middle" font-size="11" fill="var(--muted)">{t.halvingNote}</text>

    <text x="635" y="96" text-anchor="middle" font-size="13" fill="var(--ink)">{t.costTitle}</text>
    <text x="590" y="124" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colN}</text>
    <text x="690" y="124" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colA}</text>
    {alphaRows.map((r, i) => (
      <g>
        <text x="590" y={rowY(i)} text-anchor="middle" font-size="13" fill="var(--ink)">{r.n}</text>
        <text x="690" y={rowY(i)} text-anchor="middle" font-size="13" fill="var(--ink)">{r.a}</text>
      </g>
    ))}
    <text x="635" y="282" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tableNote}</text>
    <text x="635" y="310" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cost1}</text>
    <text x="635" y="334" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cost2}</text>
    <text x="635" y="358" text-anchor="middle" font-size="12" fill="var(--accent)">{t.cost3}</text>
    <text x="635" y="382" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cost4}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
