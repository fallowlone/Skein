---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Kahn trace on the course graph",
    headline: "KAHN: PEEL IN-DEGREE 0, REPEAT",
    sub: "pop one ready vertex · decrement its neighbors · enqueue new zeros",
    hStep: "step",
    hPop: "pop",
    hEffect: "decrement",
    hQueue: "queue",
    hOrder: "order",
    noEdges: "— no outgoing edges",
    orderLabel: "order",
    validNote: "6 of 6 → valid",
    note: "pop order = topological order: every arrow points forward",
    caption:
      "Kahn peels the ready first (IN intro, DS data-structures, DM discrete-math, DB databases, AL algorithms, ML ml): pop intro (data-structures 1→0, discrete-math 1→0), pop data-structures (algorithms 2→1, databases 1→0), pop discrete-math (algorithms 1→0), pop databases, pop algorithms (ml 1→0), pop ml. Order: intro → data-structures → discrete-math → databases → algorithms → ml — all 6 placed, every arrow forward.",
  },
  ru: {
    svgTitle: "Трассировка Kahn на графе курсов",
    headline: "KAHN: СЧИЩАЙ ВХОДНУЮ 0, ПОВТОРЯЙ",
    sub: "сними одну готовую вершину · уменьши соседям · добавь новые нули",
    hStep: "шаг",
    hPop: "сними",
    hEffect: "уменьшение",
    hQueue: "очередь",
    hOrder: "порядок",
    noEdges: "— нет исходящих рёбер",
    orderLabel: "порядок",
    validNote: "6 из 6 → годно",
    note: "порядок снятия = топологический: все стрелки вперёд",
    caption:
      "Kahn счищает готовых первыми (IN intro, DS data-structures, DM discrete-math, DB databases, AL algorithms, ML ml): сними intro (data-structures 1→0, discrete-math 1→0), сними data-structures (algorithms 2→1, databases 1→0), сними discrete-math (algorithms 1→0), сними databases, сними algorithms (ml 1→0), сними ml. Порядок: intro → data-structures → discrete-math → databases → algorithms → ml — все 6 встали, каждая стрелка вперёд.",
  },
};

const t = dict[lang];

const rows = [
  { n: "1", pop: "IN", effect: "DS 1→0 · DM 1→0", queue: "[DS, DM]", placed: "1/6" },
  { n: "2", pop: "DS", effect: "AL 2→1 · DB 1→0", queue: "[DM, DB]", placed: "2/6" },
  { n: "3", pop: "DM", effect: "AL 1→0", queue: "[DB, AL]", placed: "3/6" },
  { n: "4", pop: "DB", effect: undefined, queue: "[AL]", placed: "4/6" },
  { n: "5", pop: "AL", effect: "ML 1→0", queue: "[ML]", placed: "5/6" },
  { n: "6", pop: "ML", effect: undefined, queue: "[]", placed: "6/6 ✓" },
];

const orderCells = ["IN", "DS", "DM", "DB", "AL", "ML"];
const gaps = [0, 1, 2, 3, 4];

const rowY = (i: number) => 124 + i * 36;
const cellX = (i: number) => 150 + i * 84;
const gapX = (i: number) => 150 + i * 84 + 64 + 10;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="70" y="94" text-anchor="middle" font-size="11" fill="var(--muted)">{t.hStep}</text>
    <text x="130" y="94" text-anchor="middle" font-size="11" fill="var(--muted)">{t.hPop}</text>
    <text x="172" y="94" font-size="11" fill="var(--muted)">{t.hEffect}</text>
    <text x="470" y="94" font-size="11" fill="var(--muted)">{t.hQueue}</text>
    <text x="660" y="94" font-size="11" fill="var(--muted)">{t.hOrder}</text>

    {rows.map((r, i) => (
      <g>
        <text x="70" y={rowY(i)} text-anchor="middle" font-size="12" fill="var(--muted)">{r.n}</text>
        <rect x="104" y={rowY(i) - 18} width="52" height="24" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="130" y={rowY(i) - 1} text-anchor="middle" font-size="13" fill="var(--ink)">{r.pop}</text>
        <text x="172" y={rowY(i)} font-size="12" fill="var(--ink)">{r.effect === undefined ? t.noEdges : r.effect}</text>
        <text x="470" y={rowY(i)} font-size="12" fill="var(--ink)">{r.queue}</text>
        <text x="660" y={rowY(i)} font-size="12" fill="var(--ink)">{r.placed}</text>
      </g>
    ))}

    <line x1="60" y1="322" x2="740" y2="322" stroke="var(--muted)" stroke-width="1" />

    <text x="138" y="357" text-anchor="end" font-size="13" fill="var(--ink)">{t.orderLabel}</text>
    {orderCells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="336" width="64" height="30" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + 32} y="357" text-anchor="middle" font-size="13" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {gaps.map((i) => (
      <text x={gapX(i)} y="357" text-anchor="middle" font-size="13" fill="var(--muted)">→</text>
    ))}
    <text x="650" y="357" font-size="12" fill="var(--muted)">{t.validNote}</text>

    <text x="400" y="400" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
