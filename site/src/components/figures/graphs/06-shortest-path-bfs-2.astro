---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "BFS trace from A: queue evolution with dist and parent writes, then path rebuild",
    headline: "TRACE: QUEUE + DIST + PARENT",
    sub: "mark on enqueue — a dist value means seen",
    stepHeader: "step",
    queueHeader: "queue",
    writeHeader: "dist + parent writes",
    steps: ["init", "pop A", "pop B", "pop C", "pop D · E", "pop F", "rebuild"],
    noChange: "B, F seen — skip, no change",
    targetLabel: "target F",
    reverseLabel: "reverse",
    lenLabel: "len = dist[F] = 2",
    note: "final parent: B←A C←A D←B E←B F←C · never overwrite",
    caption:
      "Trace from A: pop A sets B, C to dist 1; pop B sets D, E to dist 2; pop C sets F to dist 2 with parent C. D, E, F pop with nothing new, and the path rebuilds as F → C → A, reversed to A → C → F with length dist[F] = 2.",
  },
  ru: {
    svgTitle: "Трассировка BFS из A: эволюция очереди с записями dist и parent, потом восстановление пути",
    headline: "ТРАССИРОВКА: ОЧЕРЕДЬ + DIST + PARENT",
    sub: "отмечай при добавлении — отметка: уже имеет dist",
    stepHeader: "шаг",
    queueHeader: "queue",
    writeHeader: "записи dist + parent",
    steps: ["init", "pop A", "pop B", "pop C", "pop D · E", "pop F", "восстанови"],
    noChange: "B, F посещены — пропусти, уже в dist",
    targetLabel: "цель F",
    reverseLabel: "разверни",
    lenLabel: "len = dist[F] = 2",
    note: "итог parent: B←A C←A D←B E←B F←C · не перезаписывай",
    caption:
      "Трассировка из A: pop A ставит B, C на dist 1; pop B ставит D, E на dist 2; pop C ставит F на dist 2 с parent C. D, E, F извлекаются без нового, и путь восстанавливается как F → C → A, развёрнутый в A → C → F с длиной dist[F] = 2.",
  },
};

const t = dict[lang];

const queues = [
  "queue = [A]",
  "queue = [B, C]",
  "queue = [C, D, E]",
  "queue = [D, E, F]",
  "queue = [F]",
  "queue = []",
];

const writes = [
  "dist[A] = 0 · parent[A] = null",
  "dist B, C = 1 · parent B, C ← A",
  "dist D, E = 2 · parent D, E ← B",
  "dist F = 2 · parent F ← C",
  t.noChange,
  "dist: A0 B1 C1 D2 E2 F2",
];

const rows = queues.map((q, i) => ({
  step: t.steps[i],
  q,
  w: writes[i],
  y: 118 + i * 34,
  ruleY: 132 + i * 34,
}));

const rebuildY = 336;
const chainBoxes = [
  { id: "F", x: 230 },
  { id: "C", x: 300 },
  { id: "A", x: 370 },
];
const chainArrows = [
  { x1: 266, x2: 296 },
  { x1: 336, x2: 366 },
  { x1: 410, x2: 452 },
];
const chainHeads = chainArrows.map((a) => ({
  points: `${a.x2 - 7},${rebuildY + 15 - 4.5} ${a.x2 - 7},${rebuildY + 15 + 4.5} ${a.x2},${rebuildY + 15}`,
}));
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="48" y="94" font-size="12" fill="var(--muted)">{t.stepHeader}</text>
    <text x="170" y="94" font-size="12" fill="var(--muted)">{t.queueHeader}</text>
    <text x="380" y="94" font-size="12" fill="var(--muted)">{t.writeHeader}</text>

    {rows.map((r) => (
      <g>
        <text x="48" y={r.y} font-size="13" fill="var(--ink)">{r.step}</text>
        <text x="170" y={r.y} font-size="13" fill="var(--accent)">{r.q}</text>
        <text x="380" y={r.y} font-size="13" fill="var(--ink)">{r.w}</text>
        <line x1="48" y1={r.ruleY} x2="752" y2={r.ruleY} stroke="var(--muted)" stroke-width="1" />
      </g>
    ))}

    <text x="48" y={rebuildY + 20} font-size="13" fill="var(--ink)">{t.steps[6]}</text>
    <text x="170" y={rebuildY + 20} font-size="13" fill="var(--accent)">{t.targetLabel}</text>
    {chainBoxes.map((b) => (
      <g>
        <rect x={b.x} y={rebuildY} width="36" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={b.x + 18} y={rebuildY + 20} text-anchor="middle" font-size="14" fill="var(--ink)">{b.id}</text>
      </g>
    ))}
    {chainArrows.map((a) => (
      <line x1={a.x1} y1={rebuildY + 15} x2={a.x2} y2={rebuildY + 15} stroke="var(--ink)" stroke-width="2" />
    ))}
    {chainHeads.map((h) => (
      <polygon points={h.points} fill="var(--ink)" />
    ))}
    <text x="431" y={rebuildY - 4} text-anchor="middle" font-size="11" fill="var(--muted)">{t.reverseLabel}</text>
    <rect x="456" y={rebuildY} width="112" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="512" y={rebuildY + 20} text-anchor="middle" font-size="14" fill="var(--ink)">A → C → F</text>
    <text x="580" y={rebuildY + 20} font-size="13" fill="var(--muted)">{t.lenLabel}</text>

    <text x="400" y="402" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
