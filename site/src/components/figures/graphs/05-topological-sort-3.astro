---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "DFS post-order reversed, and the cycle test",
    headline: "DFS REVERSES POST-ORDER · SHORT OUTPUT MEANS CYCLE",
    sub: "push on exit · reverse the stack · fewer than V placed means a cycle",
    postLabel: "post-order: push when a vertex finishes",
    reverseLabel: "reverse",
    topoLabel: "reversed = topological order (also valid)",
    cycleLabel: "cycle test: a → b → c → a, plus a → d",
    indegNote: "badge = in-degree (all 1)",
    queueLine: "queue = []",
    orderLine: "order = [] · 0 of 4",
    verdict: "0 < 4 → null: cycle, no order",
    caption:
      "DFS pushes each vertex on exit (IN intro, DS data-structures, DM discrete-math, DB databases, AL algorithms, ML ml): post-order ml, algorithms, databases, data-structures, discrete-math, intro; reversed it is intro → discrete-math → data-structures → databases → algorithms → ml — also valid. Cycle test: with a → b → c → a plus a → d every in-degree is 1, the queue starts empty, nothing is placed, 0 < 4 returns null: no topological order.",
  },
  ru: {
    svgTitle: "Развёрнутый post-order DFS и тест цикла",
    headline: "DFS РАЗВОРАЧИВАЕТ POST-ORDER · КОРОТКИЙ ВЫХОД — ЦИКЛ",
    sub: "клади при выходе · разверни стек · размещено меньше V — цикл",
    postLabel: "post-order: клади когда вершина завершается",
    reverseLabel: "разверни",
    topoLabel: "разворот = топологический порядок (тоже годный)",
    cycleLabel: "тест цикла: a → b → c → a, плюс a → d",
    indegNote: "бейдж = полустепень захода (все 1)",
    queueLine: "очередь = []",
    orderLine: "порядок = [] · 0 из 4",
    verdict: "0 < 4 → null: цикл, порядка нет",
    caption:
      "DFS кладёт каждую вершину при выходе (IN intro, DS data-structures, DM discrete-math, DB databases, AL algorithms, ML ml): post-order ml, algorithms, databases, data-structures, discrete-math, intro; разворот — intro → discrete-math → data-structures → databases → algorithms → ml — тоже годный. Тест цикла: при a → b → c → a плюс a → d каждая полустепень захода 1, очередь начинается пустой, ничего не размещено, 0 < 4 возвращает null: топологического порядка нет.",
  },
};

const t = dict[lang];

const postCells = ["ML", "AL", "DB", "DS", "DM", "IN"];
const topoCells = ["IN", "DM", "DS", "DB", "AL", "ML"];
const finishIdx = ["1", "2", "3", "4", "5", "6"];

const cellX = (i: number) => 150 + i * 84;

const cycleNodes = [
  { id: "a", x: 110, y: 320, bx: -15, by: 15 },
  { id: "b", x: 240, y: 320, bx: 15, by: 15 },
  { id: "c", x: 175, y: 378, bx: 15, by: 15 },
  { id: "d", x: 430, y: 320, bx: 15, by: 15 },
];

const cycleEdges = [
  { x1: 131, y1: 320, x2: 219, y2: 320 },
  { x1: 226, y1: 333, x2: 189, y2: 365 },
  { x1: 161, y1: 365, x2: 124, y2: 333 },
];

const nodeR = 19;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-ts3" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="12" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
        <path d="M1,1 L11,6 L1,11 z" fill="var(--ink)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="90" text-anchor="middle" font-size="12" fill="var(--ink)">{t.postLabel}</text>
    {postCells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="98" width="64" height="30" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + 32} y="119" text-anchor="middle" font-size="13" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {finishIdx.map((v, i) => (
      <text x={cellX(i) + 32} y="144" text-anchor="middle" font-size="10" fill="var(--muted)">{v}</text>
    ))}

    <line x1="400" y1="150" x2="400" y2="172" stroke="var(--accent)" stroke-width="2" />
    <polygon points="393,172 407,172 400,182" fill="var(--accent)" />
    <text x="414" y="170" font-size="12" fill="var(--ink)">{t.reverseLabel}</text>

    {topoCells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="186" width="64" height="30" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + 32} y="207" text-anchor="middle" font-size="13" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="400" y="232" text-anchor="middle" font-size="12" fill="var(--ink)">{t.topoLabel}</text>

    <line x1="60" y1="246" x2="740" y2="246" stroke="var(--muted)" stroke-width="1" />

    <text x="400" y="268" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cycleLabel}</text>

    {cycleEdges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" marker-end="url(#arr-ts3)" />
    ))}
    <polyline points="110,300 110,288 430,288 430,299" fill="none" stroke="var(--ink)" stroke-width="2" marker-end="url(#arr-ts3)" />

    {cycleNodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r={nodeR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="15" fill="var(--ink)">{n.id}</text>
        <circle cx={n.x + n.bx} cy={n.y + n.by} r="10" fill="var(--card)" stroke="var(--muted)" stroke-width="1" />
        <text x={n.x + n.bx} y={n.y + n.by + 4} text-anchor="middle" font-size="10" fill="var(--ink)">1</text>
      </g>
    ))}
    <text x="250" y="413" font-size="11" fill="var(--muted)">{t.indegNote}</text>

    <rect x="505" y="296" width="250" height="86" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="521" y="320" font-size="12" fill="var(--ink)">{t.queueLine}</text>
    <text x="521" y="342" font-size="12" fill="var(--ink)">{t.orderLine}</text>
    <text x="521" y="364" font-size="12" fill="var(--ink)">{t.verdict}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
