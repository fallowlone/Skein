---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Course prerequisite DAG with in-degrees",
    headline: "COURSES AS A DAG: EDGES ARE PREREQUISITES",
    sub: "u → v means u first · number = in-degree (unmet prerequisites)",
    indeg: "in-degree",
    note: "only intro has in-degree 0 · ml must come last",
    caption:
      "Course prerequisites as a DAG: intro feeds data-structures and discrete-math, both feed algorithms, data-structures also feeds databases, algorithms feeds ml. In-degrees: intro 0, data-structures 1, discrete-math 1, algorithms 2, databases 1, ml 1 — only intro can go first, ml must go last.",
  },
  ru: {
    svgTitle: "DAG курсов с полустепенями захода",
    headline: "КУРСЫ КАК DAG: РЁБРА — ПРЕРЕКВИЗИТЫ",
    sub: "u → v значит u раньше · число = полустепень захода",
    indeg: "полустепень захода",
    note: "только у intro полустепень захода 0 · ml идёт последним",
    caption:
      "Пререквизиты курсов как DAG: intro кормит data-structures и discrete-math, обе кормят algorithms, data-structures кормит ещё databases, algorithms кормит ml. Полустепени захода: intro 0, data-structures 1, discrete-math 1, algorithms 2, databases 1, ml 1 — только intro может идти первым, ml идёт последним.",
  },
};

const t = dict[lang];

const boxH = 46;
const boxW = 150;

const nodes = [
  { name: "intro", indeg: 0, x: 400, y: 92 },
  { name: "data-structures", indeg: 1, x: 170, y: 186 },
  { name: "discrete-math", indeg: 1, x: 630, y: 186 },
  { name: "databases", indeg: 1, x: 170, y: 282 },
  { name: "algorithms", indeg: 2, x: 470, y: 282 },
  { name: "ml", indeg: 1, x: 470, y: 372 },
];

const edges = [
  { x1: 350, y1: 116, x2: 228, y2: 161 },
  { x1: 450, y1: 116, x2: 572, y2: 161 },
  { x1: 170, y1: 211, x2: 170, y2: 257 },
  { x1: 247, y1: 196, x2: 398, y2: 257 },
  { x1: 553, y1: 196, x2: 525, y2: 257 },
  { x1: 470, y1: 307, x2: 470, y2: 347 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-ts1" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="12" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
        <path d="M1,1 L11,6 L1,11 z" fill="var(--ink)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" marker-end="url(#arr-ts1)" />
    ))}

    {nodes.map((n) => (
      <g>
        <rect x={n.x - boxW / 2} y={n.y - boxH / 2} width={boxW} height={boxH} rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y - 2} text-anchor="middle" font-size="13" fill="var(--ink)">{n.name}</text>
        <text x={n.x} y={n.y + 15} text-anchor="middle" font-size="10" fill="var(--muted)">{t.indeg}: {n.indeg}</text>
      </g>
    ))}

    <text x="400" y="412" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
