---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Parent array of six singletons and the forest after union(0,1)",
    headline: "PARENT[] FOREST: LINK ROOTS, NOT ELEMENTS",
    sub: "each element starts as its own parent — 6 singleton sets",
    rowIndex: "index",
    rowValue: "value",
    tableNote: "each points to itself = its own root",
    afterLabel: "after union(0,1): parent[1] = 0, rank[0] = 1 · count 6 → 5",
    linkTag: "parent[1] = 0",
    rootTag: "root",
    queryLine: "find(1) = 0 · connected(a, b) is find(a) === find(b)",
    note: "find climbs to the root · union links one root under the other",
    caption:
      "Six singletons start with parent[i] = i. union(0,1) links root 1 under root 0 (rank[0] = 1, count drops 6 → 5); find(1) now returns 0, and connected(a,b) holds exactly when both finds agree.",
  },
  ru: {
    svgTitle: "Массив parent шести одиночек и лес после union(0,1)",
    headline: "ЛЕС PARENT[]: СВЯЗЫВАЙ КОРНИ, НЕ ЭЛЕМЕНТЫ",
    sub: "каждый элемент начинает как свой собственный родитель — 6 одиночных множеств",
    rowIndex: "индекс",
    rowValue: "значение",
    tableNote: "каждый указывает на себя = свой корень",
    afterLabel: "после union(0,1): parent[1] = 0, rank[0] = 1 · count 6 → 5",
    linkTag: "parent[1] = 0",
    rootTag: "корень",
    queryLine: "find(1) = 0 · connected(a, b) это find(a) === find(b)",
    note: "find поднимается к корню · union вешает один корень под другой",
    caption:
      "Шесть одиночек начинают с parent[i] = i. union(0,1) связывает корень 1 под корень 0 (rank[0] = 1, count падает 6 → 5); find(1) теперь возвращает 0, а connected(a,b) верно ровно когда оба find согласны.",
  },
};

const t = dict[lang];

const cells = ["0", "1", "2", "3", "4", "5"];
const x0 = 244;
const step = 76;
const cw = 62;
const cellX = (i: number) => x0 + i * step;

const forestY = 268;
const forestR = 20;
const forest = [
  { x: 120, label: "0", root: true },
  { x: 220, label: "1", root: false },
  { x: 360, label: "2", root: false },
  { x: 470, label: "3", root: false },
  { x: 580, label: "4", root: false },
  { x: 690, label: "5", root: false },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="232" y="109" text-anchor="end" font-size="12" fill="var(--ink)">{t.rowIndex}</text>
    {cells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="88" width={cw} height={30} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="109" text-anchor="middle" font-size="14" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="232" y="143" text-anchor="end" font-size="12" fill="var(--ink)">{t.rowValue}</text>
    {cells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="122" width={cw} height={30} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="143" text-anchor="middle" font-size="14" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="400" y="172" text-anchor="middle" font-size="12" fill="var(--muted)">{t.tableNote}</text>

    <text x="60" y="206" font-size="13" fill="var(--ink)">{t.afterLabel}</text>

    <text x="170" y="240" text-anchor="middle" font-size="11" fill="var(--accent)">{t.linkTag}</text>
    {forest.map((n) => (
      <g>
        <circle cx={n.x} cy={forestY} r={forestR} fill="var(--card)" stroke={n.root ? "var(--accent)" : "var(--ink)"} stroke-width={n.root ? 3 : 2} />
        <text x={n.x} y={forestY + 6} text-anchor="middle" font-size="15" fill="var(--ink)">{n.label}</text>
      </g>
    ))}
    <line x1="196" y1={forestY} x2="146" y2={forestY} stroke="var(--accent)" stroke-width="2" />
    <polygon points="142,268 154,262 154,274" fill="var(--accent)" />
    <text x="120" y="302" text-anchor="middle" font-size="11" fill="var(--accent)">{t.rootTag}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--ink)">{t.queryLine}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
