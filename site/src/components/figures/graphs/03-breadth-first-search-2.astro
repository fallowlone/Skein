---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "BFS trace on adjacency 0:[1,2] 1:[3] 2:[3] 3:[2]: queue states from [0] to empty",
    headline: "BFS TRACE: QUEUE + VISITED",
    sub: "dequeue v · mark + enqueue unvisited neighbors · repeat",
    adjTitle: "adjacency list",
    cycleA: "2 → 3 → 2",
    cycleB: "skip if visited",
    s0: "start",
    q0: "queue [0]",
    v0: "visited {0}",
    s1: "dequeue 0",
    q1: "queue [1, 2]",
    v1: "visited {0, 1, 2}",
    s2: "dequeue 1",
    q2: "queue [2, 3]",
    v2: "visited {0, 1, 2, 3}",
    s3: "dequeue 2",
    q3: "queue [3]",
    v3: "3 visited → skip",
    s4: "dequeue 3",
    q4: "queue []",
    v4: "2 visited → skip",
    orderLine: "visit order (by dequeue): 0 → 1 → 2 → 3",
    levelsLine: "levels: {0} · {1, 2} · {3}",
    caption:
      "BFS from 0 on the lesson's example graph (0:[1,2], 1:[3], 2:[3], 3:[2]): the queue drains [0] → [1,2] → [2,3] → [3] → empty while visited grows to {0,1,2,3}. Vertices 3 and 2 are already visited when rediscovered, so they are skipped. Visit order 0, 1, 2, 3; levels {0}, {1, 2}, {3}.",
  },
  ru: {
    svgTitle: "Трассировка BFS на смежности 0:[1,2] 1:[3] 2:[3] 3:[2]: состояния очереди от [0] до пустой",
    headline: "ТРАССИРОВКА BFS: ОЧЕРЕДЬ + ПОСЕЩЁННЫЕ",
    sub: "извлеки v · отметь + добавь непосещённых соседей · повтори",
    adjTitle: "список смежности",
    cycleA: "2 → 3 → 2",
    cycleB: "пропусти если посещена",
    s0: "начало",
    q0: "очередь [0]",
    v0: "посещённо {0}",
    s1: "извлеки 0",
    q1: "очередь [1, 2]",
    v1: "посещённо {0, 1, 2}",
    s2: "извлеки 1",
    q2: "очередь [2, 3]",
    v2: "посещённо {0, 1, 2, 3}",
    s3: "извлеки 2",
    q3: "очередь [3]",
    v3: "3 посещена → пропуск",
    s4: "извлеки 3",
    q4: "очередь []",
    v4: "2 посещена → пропуск",
    orderLine: "порядок посещения (по извлечению): 0 → 1 → 2 → 3",
    levelsLine: "уровни: {0} · {1, 2} · {3}",
    caption:
      "BFS из 0 на примере графа из урока (0:[1,2], 1:[3], 2:[3], 3:[2]): очередь осушается [0] → [1,2] → [2,3] → [3] → пуста, а посещённые растут до {0,1,2,3}. Вершины 3 и 2 уже посещены при повторном открытии, поэтому пропускаются. Порядок посещения 0, 1, 2, 3; уровни {0}, {1, 2}, {3}.",
  },
};

const t = dict[lang];

const adjRows = ["0: [1, 2]", "1: [3]", "2: [3]", "3: [2]"];
const adjY = (i: number) => 126 + i * 26;

const rows = [
  { label: t.s0, q: t.q0, v: t.v0, y: 96 },
  { label: t.s1, q: t.q1, v: t.v1, y: 142 },
  { label: t.s2, q: t.q2, v: t.v2, y: 188 },
  { label: t.s3, q: t.q3, v: t.v3, y: 234 },
  { label: t.s4, q: t.q4, v: t.v4, y: 280 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="30" y="100" font-size="12" fill="var(--muted)">{t.adjTitle}</text>
    {adjRows.map((r, i) => (
      <text x="30" y={adjY(i)} font-size="14" fill="var(--ink)">{r}</text>
    ))}
    <text x="30" y="248" font-size="13" fill="var(--accent)">{t.cycleA}</text>
    <text x="30" y="268" font-size="12" fill="var(--muted)">{t.cycleB}</text>

    <line x1="228" y1="90" x2="228" y2="322" stroke="var(--muted)" stroke-width="1" />

    {rows.map((r) => (
      <g>
        <rect x="250" y={r.y} width="520" height="38" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="262" y={r.y + 25} font-size="13" fill="var(--accent)">{r.label}</text>
        <text x="370" y={r.y + 25} font-size="13" fill="var(--ink)">{r.q}</text>
        <text x="520" y={r.y + 25} font-size="13" fill="var(--muted)">{r.v}</text>
      </g>
    ))}

    <rect x="30" y="334" width="740" height="58" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="358" text-anchor="middle" font-size="13" fill="var(--ink)">{t.orderLine}</text>
    <text x="400" y="381" text-anchor="middle" font-size="13" fill="var(--muted)">{t.levelsLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
