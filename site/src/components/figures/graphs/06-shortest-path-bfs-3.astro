---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Weighted trap: BFS picks the 2-edge route costing 11 over the 3-edge route costing 3",
    headline: "THE WEIGHTED-GRAPH TRAP",
    sub: "same shape, new costs: A–C costs 10, every other edge costs 1",
    bfsPick: "BFS pick: fewest edges",
    bfsMath: "2 edges · cost 10 + 1 = 11 ✗",
    truePick: "true cheapest: smallest cost",
    trueMath: "3 edges · cost 1 + 1 + 1 = 3 ✓",
    verdict: "BFS counts edges, not cost → use Dijkstra",
    chipTime: "time O(V + E)",
    chipSpace: "space O(V)",
    note: "unweighted only — every edge counts the same",
    caption:
      "With A–C at cost 10 and the rest at 1, the cheapest route is A-B-E-F (cost 3) but BFS still reports A-C-F (cost 11) because it minimizes edge count, not cost. BFS shortest paths hold only for unweighted graphs; weighted graphs need Dijkstra. Cost stays O(V+E) time, O(V) space.",
  },
  ru: {
    svgTitle: "Ловушка весов: BFS выбирает 2-рёберный маршрут за 11 вместо 3-рёберного за 3",
    headline: "ЛОВУШКА ВЗВЕШЕННОГО ГРАФА",
    sub: "та же форма, новые стоимости: A–C стоит 10, остальные рёбра по 1",
    bfsPick: "выбор BFS: минимум рёбер",
    bfsMath: "2 ребра · стоимость 10 + 1 = 11 ✗",
    truePick: "дешевейший: минимум стоимости",
    trueMath: "3 ребра · стоимость 1 + 1 + 1 = 3 ✓",
    verdict: "BFS считает рёбра, а не стоимость → нужен Dijkstra",
    chipTime: "время O(V + E)",
    chipSpace: "память O(V)",
    note: "только невзвешенные — каждое ребро одинаково",
    caption:
      "Когда A–C стоит 10, а остальные по 1, самый дешёвый маршрут — A-B-E-F (стоимость 3), но BFS всё равно сообщает A-C-F (стоимость 11), потому что он минимизирует число рёбер, а не стоимость. Кратчайшие пути BFS верны только для невзвешенных графов; взвешенным нужен Dijkstra. Стоимость та же: время O(V+E), память O(V).",
  },
};

const t = dict[lang];

const route1Nodes = [
  { id: "A", x: 210 },
  { id: "C", x: 390 },
  { id: "F", x: 570 },
];
const route1Edges = [
  { x1: 230, x2: 370, w: "10", mx: 300 },
  { x1: 410, x2: 550, w: "1", mx: 480 },
];
const route2Nodes = [
  { id: "A", x: 180 },
  { id: "B", x: 320 },
  { id: "E", x: 460 },
  { id: "F", x: 600 },
];
const route2Edges = [
  { x1: 200, x2: 300, mx: 250 },
  { x1: 340, x2: 440, mx: 390 },
  { x1: 480, x2: 580, mx: 530 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="80" y="96" font-size="13" fill="var(--ink)">{t.bfsPick}</text>
    {route1Edges.map((e) => (
      <g>
        <line x1={e.x1} y1="132" x2={e.x2} y2="132" stroke="var(--ink)" stroke-width="2" />
        <text x={e.mx} y="120" text-anchor="middle" font-size="13" fill="var(--muted)">{e.w}</text>
      </g>
    ))}
    {route1Nodes.map((n) => (
      <g>
        <circle cx={n.x} cy="132" r="20" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y="138" text-anchor="middle" font-size="15" fill="var(--ink)">{n.id}</text>
      </g>
    ))}
    <text x="390" y="178" text-anchor="middle" font-size="14" fill="var(--ink)">{t.bfsMath}</text>

    <text x="80" y="204" font-size="13" fill="var(--ink)">{t.truePick}</text>
    {route2Edges.map((e) => (
      <g>
        <line x1={e.x1} y1="240" x2={e.x2} y2="240" stroke="var(--accent)" stroke-width="4" />
        <text x={e.mx} y="228" text-anchor="middle" font-size="13" fill="var(--muted)">1</text>
      </g>
    ))}
    {route2Nodes.map((n) => (
      <g>
        <circle cx={n.x} cy="240" r="20" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={n.x} y="246" text-anchor="middle" font-size="15" fill="var(--ink)">{n.id}</text>
      </g>
    ))}
    <text x="390" y="282" text-anchor="middle" font-size="14" fill="var(--ink)">{t.trueMath}</text>

    <rect x="60" y="300" width="680" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="326" text-anchor="middle" font-size="14" fill="var(--ink)">{t.verdict}</text>

    <rect x="222" y="354" width="150" height="28" fill="none" stroke="var(--muted)" stroke-width="1.5" />
    <text x="297" y="373" text-anchor="middle" font-size="13" fill="var(--ink)">{t.chipTime}</text>
    <rect x="428" y="354" width="150" height="28" fill="none" stroke="var(--muted)" stroke-width="1.5" />
    <text x="503" y="373" text-anchor="middle" font-size="13" fill="var(--ink)">{t.chipSpace}</text>

    <text x="400" y="404" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
