---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Directed graph 0 to 1, 0 to 2, 1 to 3, 2 to 3 with DFS order 0 1 3 2 versus BFS order 0 1 2 3",
    headline: "QUEUE SPREADS · STACK DIVES",
    sub: "edges 0→1, 0→2, 1→3, 2→3 · DFS from 0 vs BFS from 0",
    level0: "level 0",
    level1: "level 1",
    level2: "level 2",
    dfsLabel: "DFS · stack (LIFO)",
    bfsLabel: "BFS · queue (FIFO)",
    dfsNote: "deep: 0 → 1 → 3, backtrack, then 2",
    levelsNote: "level 0 {0} · level 1 {1, 2} · level 2 {3}",
    bottomNote: "same O(V+E) — only the order differs",
    caption:
      "The lesson's comparison graph (0→1, 0→2, 1→3, 2→3): DFS with a stack dives 0, 1, 3, then backtracks to 2, while BFS with a queue visits level by level — 0, 1, 2, 3 — with levels {0}, {1, 2}, {3}. Both cost O(V+E); only the order differs.",
  },
  ru: {
    svgTitle: "Ориентированный граф 0 в 1, 0 в 2, 1 в 3, 2 в 3 с порядком DFS 0 1 3 2 против порядка BFS 0 1 2 3",
    headline: "ОЧЕРЕДЬ РАСХОДИТСЯ · СТЕК НЫРЯЕТ",
    sub: "рёбра 0→1, 0→2, 1→3, 2→3 · DFS из 0 против BFS из 0",
    level0: "уровень 0",
    level1: "уровень 1",
    level2: "уровень 2",
    dfsLabel: "DFS · стек (LIFO)",
    bfsLabel: "BFS · очередь (FIFO)",
    dfsNote: "вглубь: 0 → 1 → 3, назад, потом 2",
    levelsNote: "уровень 0 {0} · уровень 1 {1, 2} · уровень 2 {3}",
    bottomNote: "тот же O(V+E) — отличается только порядок",
    caption:
      "Граф сравнения из урока (0→1, 0→2, 1→3, 2→3): DFS со стеком ныряет 0, 1, 3, потом возвращается к 2, а BFS с очередью посещает слой за слоем — 0, 1, 2, 3 — с уровнями {0}, {1, 2}, {3}. Оба стоят O(V+E); отличается только порядок.",
  },
};

const t = dict[lang];

const nodes = [
  { v: "0", x: 190, y: 135 },
  { v: "1", x: 100, y: 252 },
  { v: "2", x: 280, y: 252 },
  { v: "3", x: 190, y: 352 },
];
const nodeR = 22;

const cut = (x1: number, y1: number, x2: number, y2: number, a: number, b: number) => {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  return { x1: x1 + ux * a, y1: y1 + uy * a, x2: x2 - ux * b, y2: y2 - uy * b };
};

const edges = [
  cut(190, 135, 100, 252, nodeR + 2, nodeR + 3),
  cut(190, 135, 280, 252, nodeR + 2, nodeR + 3),
  cut(100, 252, 190, 352, nodeR + 2, nodeR + 3),
  cut(280, 252, 190, 352, nodeR + 2, nodeR + 3),
];

const levelTags = [
  { label: t.level0, y: 139 },
  { label: t.level1, y: 256 },
  { label: t.level2, y: 356 },
];

const dfsOrder = ["0", "1", "3", "2"];
const bfsOrder = ["0", "1", "2", "3"];
const gaps = [0, 1, 2];

const chipX = 365;
const chipStep = 62;
const chipW = 50;
const chipH = 40;
const chipAt = (i: number) => chipX + i * chipStep;
const arrowAt = (i: number) => chipX + i * chipStep + chipW + 6;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="bfs1-arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
        <path d="M0,0 L8,4 L0,8 z" fill="var(--ink)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {levelTags.map((lv) => (
      <text x="16" y={lv.y} font-size="12" fill="var(--muted)">{lv.label}</text>
    ))}

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" marker-end="url(#bfs1-arr)" />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r={nodeR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.v}</text>
      </g>
    ))}

    <line x1="340" y1="90" x2="340" y2="360" stroke="var(--muted)" stroke-width="1" />

    <text x="365" y="120" font-size="13" fill="var(--ink)">{t.dfsLabel}</text>
    {dfsOrder.map((v, i) => (
      <g>
        <rect x={chipAt(i)} y="132" width={chipW} height={chipH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={chipAt(i) + chipW / 2} y="159" text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {gaps.map((i) => (
      <text x={arrowAt(i)} y="159" font-size="14" fill="var(--muted)">→</text>
    ))}
    <text x="365" y="200" font-size="12" fill="var(--muted)">{t.dfsNote}</text>

    <text x="365" y="240" font-size="13" fill="var(--accent)">{t.bfsLabel}</text>
    {bfsOrder.map((v, i) => (
      <g>
        <rect x={chipAt(i)} y="252" width={chipW} height={chipH} fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={chipAt(i) + chipW / 2} y="279" text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {gaps.map((i) => (
      <text x={arrowAt(i)} y="279" font-size="14" fill="var(--muted)">→</text>
    ))}
    <text x="365" y="322" font-size="12" fill="var(--muted)">{t.levelsNote}</text>

    <text x="400" y="400" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bottomNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
