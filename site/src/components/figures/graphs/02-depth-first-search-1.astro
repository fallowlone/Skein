---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Directed example graph with 4 vertices and 5 edges plus its adjacency list",
    headline: "EXAMPLE GRAPH: 4 VERTICES, 5 EDGES",
    sub: "directed graph · vertex 3 links back to 2 (the cycle)",
    graphTitle: "directed graph",
    adjTitle: "adjacency list",
    cycleLabel: "cycle: 3 → 2",
    footer: "each directed edge is examined exactly once, from its source",
    caption:
      "The lesson's example graph: 4 vertices and 5 directed edges — 0 → 1, 0 → 2, 1 → 3, 2 → 3, 3 → 2 — with adjacency list 0: [1, 2], 1: [3], 2: [3], 3: [2]. Vertex 3 links back to 2, forming the cycle.",
  },
  ru: {
    svgTitle: "Ориентированный пример графа с 4 вершинами и 5 рёбрами и его список смежности",
    headline: "ПРИМЕР ГРАФА: 4 ВЕРШИНЫ, 5 РЁБЕР",
    sub: "ориентированный граф · вершина 3 ссылается назад на 2 (цикл)",
    graphTitle: "ориентированный граф",
    adjTitle: "список смежности",
    cycleLabel: "цикл: 3 → 2",
    footer: "каждое ориентированное ребро исследуется ровно раз — от исходной вершины",
    caption:
      "Пример графа из урока: 4 вершины и 5 ориентированных рёбер — 0 → 1, 0 → 2, 1 → 3, 2 → 3, 3 → 2 — со списком смежности 0: [1, 2], 1: [3], 2: [3], 3: [2]. Вершина 3 ссылается назад на 2, образуя цикл.",
  },
};

const t = dict[lang];

const nodes = [
  { id: "0", cx: 120, cy: 140 },
  { id: "1", cx: 300, cy: 140 },
  { id: "2", cx: 120, cy: 300 },
  { id: "3", cx: 300, cy: 300 },
];

const edges = [
  { x1: 146, y1: 140, x2: 268, y2: 140, head: "274,140 263,134 263,146" },
  { x1: 120, y1: 166, x2: 120, y2: 268, head: "120,274 114,263 126,263" },
  { x1: 300, y1: 166, x2: 300, y2: 268, head: "300,274 294,263 306,263" },
  { x1: 146, y1: 300, x2: 268, y2: 300, head: "274,300 263,294 263,306" },
];

const backEdge = [
  { x1: 300, y1: 326, x2: 300, y2: 352 },
  { x1: 300, y1: 352, x2: 120, y2: 352 },
  { x1: 120, y1: 352, x2: 120, y2: 332 },
];
const backHead = "120,326 114,337 126,337";

const adjRows = [
  { v: "0", ns: ["1", "2"] },
  { v: "1", ns: ["3"] },
  { v: "2", ns: ["3"] },
  { v: "3", ns: ["2"] },
];

const rowY = (i: number) => 154 + i * 56;
const chipX = (k: number) => 540 + k * 44;
const closeX = (n: number) => 540 + n * 44 - 8;
const commas = [{ x: 577, y: rowY(0) + 5 }];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="104" text-anchor="middle" font-size="13" fill="var(--muted)">{t.graphTitle}</text>
    <text x="605" y="104" text-anchor="middle" font-size="13" fill="var(--muted)">{t.adjTitle}</text>

    {edges.map((e) => (
      <g>
        <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
        <polygon points={e.head} fill="var(--ink)" />
      </g>
    ))}
    {backEdge.map((s) => (
      <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="var(--ink)" stroke-width="2" />
    ))}
    <polygon points={backHead} fill="var(--ink)" />
    {nodes.map((n) => (
      <g>
        <circle cx={n.cx} cy={n.cy} r="26" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.cx} y={n.cy + 6} text-anchor="middle" font-size="18" fill="var(--ink)">{n.id}</text>
      </g>
    ))}
    <text x="210" y="344" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cycleLabel}</text>

    {adjRows.map((r, i) => (
      <g>
        <rect x="450" y={rowY(i) - 22} width="310" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <circle cx="486" cy={rowY(i)} r="15" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x="486" y={rowY(i) + 5} text-anchor="middle" font-size="15" fill="var(--ink)">{r.v}</text>
        <text x="512" y={rowY(i) + 5} font-size="15" fill="var(--muted)">:</text>
        <text x="528" y={rowY(i) + 5} font-size="15" fill="var(--muted)">[</text>
        {r.ns.map((d, k) => (
          <g>
            <rect x={chipX(k)} y={rowY(i) - 13} width="30" height="26" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
            <text x={chipX(k) + 15} y={rowY(i) + 5} text-anchor="middle" font-size="14" fill="var(--ink)">{d}</text>
          </g>
        ))}
        <text x={closeX(r.ns.length)} y={rowY(i) + 5} font-size="15" fill="var(--muted)">]</text>
      </g>
    ))}
    {commas.map((c) => (
      <text x={c.x} y={c.y} font-size="15" fill="var(--muted)">,</text>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.footer}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
