---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "BFS levels from A with edge-count distances and the shortest route A-C-F",
    headline: "DIST IN EDGES: LEVELS FROM A",
    sub: "undirected · unweighted · 6 vertices · source A",
    distHeader: "dist from A (edges)",
    routesHeader: "A → F: two routes",
    routeShort: "A → C → F · 2 edges ✓ shortest",
    routeLong: "A → B → E → F · 3 edges",
    parentNote1: "parent[F] = C — C dequeued first",
    parentNote2: "first touch wins: fewest edges",
    note: "BFS empties level 0, then 1, then 2 — first arrival is shortest",
    caption:
      "BFS from A stamps dist in edges: B and C land at 1, D, E and F at 2. Two routes reach F — A-C-F (2 edges) and A-B-E-F (3 edges) — and F is first touched from C, so parent[F]=C and the 2-edge route wins.",
  },
  ru: {
    svgTitle: "Уровни BFS из A с дистанциями в рёбрах и кратчайшим маршрутом A-C-F",
    headline: "DIST В РЁБРАХ: УРОВНИ ИЗ A",
    sub: "неориентированный · невзвешенный · 6 вершин · источник A",
    distHeader: "dist из A (рёбра)",
    routesHeader: "A → F: два маршрута",
    routeShort: "A → C → F · 2 ребра ✓ кратчайший",
    routeLong: "A → B → E → F · 3 ребра",
    parentNote1: "parent[F] = C — C извлечена первой",
    parentNote2: "первое касание = минимум рёбер",
    note: "BFS опустошает уровень 0, потом 1, потом 2 — первое прибытие кратчайшее",
    caption:
      "BFS из A штампует dist в рёбрах: B и C встают на 1, D, E и F на 2. К F ведут два маршрута — A-C-F (2 ребра) и A-B-E-F (3 ребра) — и F впервые тронута из C, поэтому parent[F]=C и побеждает 2-рёберный маршрут.",
  },
};

const t = dict[lang];

const nodes = [
  { id: "A", x: 250, y: 130, d: "0", bx: 269, by: 111 },
  { id: "B", x: 140, y: 225, d: "1", bx: 121, by: 206 },
  { id: "C", x: 360, y: 225, d: "1", bx: 379, by: 206 },
  { id: "D", x: 80, y: 330, d: "2", bx: 61, by: 311 },
  { id: "E", x: 245, y: 330, d: "2", bx: 226, by: 349 },
  { id: "F", x: 410, y: 330, d: "2", bx: 429, by: 349 },
];

const byId: Record<string, (typeof nodes)[number]> = Object.fromEntries(
  nodes.map((n) => [n.id, n])
);

const hotPairs = new Set(["A|C", "C|F"]);
const edgePairs = [
  ["A", "B"],
  ["A", "C"],
  ["B", "D"],
  ["B", "E"],
  ["C", "F"],
  ["E", "F"],
];
const edges = edgePairs.map(([a, b]) => ({
  x1: byId[a].x,
  y1: byId[a].y,
  x2: byId[b].x,
  y2: byId[b].y,
  hot: hotPairs.has(a + "|" + b),
}));

const levels = [
  { label: "d = 0", y: 135 },
  { label: "d = 1", y: 230 },
  { label: "d = 2", y: 335 },
];

const distCells = nodes.map((n, i) => ({ id: n.id, d: n.d, x: 476 + i * 48 }));
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="106" y="191" width="288" height="68" rx="14" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 5" />
    <rect x="46" y="296" width="398" height="68" rx="14" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 5" />

    {levels.map((l) => (
      <text x="16" y={l.y} font-size="12" fill="var(--muted)">{l.label}</text>
    ))}

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke={e.hot ? "var(--accent)" : "var(--ink)"} stroke-width={e.hot ? 4 : 2} />
    ))}

    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="22" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.id}</text>
        <circle cx={n.bx} cy={n.by} r="11" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={n.bx} y={n.by + 4.5} text-anchor="middle" font-size="12" fill="var(--ink)">{n.d}</text>
      </g>
    ))}

    <text x="470" y="100" font-size="13" fill="var(--ink)">{t.distHeader}</text>
    {distCells.map((c) => (
      <g>
        <rect x={c.x} y="108" width="40" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={c.x + 20} y="124" text-anchor="middle" font-size="11" fill="var(--muted)">{c.id}</text>
        <text x={c.x + 20} y="143" text-anchor="middle" font-size="16" fill="var(--ink)">{c.d}</text>
      </g>
    ))}

    <text x="470" y="185" font-size="13" fill="var(--ink)">{t.routesHeader}</text>
    <circle cx="474" cy="205" r="4" fill="var(--accent)" />
    <text x="488" y="210" font-size="14" fill="var(--ink)">{t.routeShort}</text>
    <circle cx="474" cy="231" r="4" fill="none" stroke="var(--muted)" stroke-width="1.5" />
    <text x="488" y="236" font-size="14" fill="var(--muted)">{t.routeLong}</text>

    <text x="470" y="278" font-size="13" fill="var(--ink)">{t.parentNote1}</text>
    <text x="470" y="300" font-size="13" fill="var(--muted)">{t.parentNote2}</text>

    <text x="400" y="398" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
