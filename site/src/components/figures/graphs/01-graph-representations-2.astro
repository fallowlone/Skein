---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Directed graph with four vertices and five edges beside its adjacency list",
    headline: "ONE GRAPH → ONE LIST PER VERTEX",
    sub: "directed graph · 4 vertices · 5 edges",
    leftHead: "THE GRAPH",
    rightHead: "ADJACENCY LIST",
    bottom: "stores only the 5 real edges · O(V + E) space · neighbors in O(degree)",
    caption:
      "Directed graph 0 → 1, 0 → 2, 1 → 3, 2 → 3, 3 → 2. The adjacency list stores each vertex's outgoing neighbors: 0: [1, 2], 1: [3], 2: [3], 3: [2] — only the 5 edges, O(V + E) space.",
  },
  ru: {
    svgTitle: "Ориентированный граф из четырёх вершин и пяти рёбер рядом со списком смежности",
    headline: "ОДИН ГРАФ → ОДИН СПИСОК НА ВЕРШИНУ",
    sub: "ориентированный граф · 4 вершины · 5 рёбер",
    leftHead: "ГРАФ",
    rightHead: "СПИСОК СМЕЖНОСТИ",
    bottom: "хранит только 5 настоящих рёбер · O(V + E) памяти · соседи за O(степень)",
    caption:
      "Ориентированный граф 0 → 1, 0 → 2, 1 → 3, 2 → 3, 3 → 2. Список смежности хранит исходящих соседей каждой вершины: 0: [1, 2], 1: [3], 2: [3], 3: [2] — только 5 рёбер, O(V + E) памяти.",
  },
};

const t = dict[lang];

const nodes = [
  { label: "0", cx: 110, cy: 170 },
  { label: "1", cx: 270, cy: 170 },
  { label: "2", cx: 110, cy: 300 },
  { label: "3", cx: 270, cy: 300 },
];
const nodeR = 24;
const straight = [
  { x1: 134, y1: 170, x2: 240, y2: 170, head: "234,163 234,177 246,170" },
  { x1: 110, y1: 194, x2: 110, y2: 270, head: "103,264 117,264 110,276" },
  { x1: 270, y1: 194, x2: 270, y2: 270, head: "263,264 277,264 270,276" },
  { x1: 134, y1: 300, x2: 240, y2: 300, head: "234,293 234,307 246,300" },
];
const backCurve = "M 246,316 Q 190,348 134,316";
const backHead = "142,309 142,323 130,316";

const rows = [
  { label: "0", cells: ["1", "2"] },
  { label: "1", cells: ["3"] },
  { label: "2", cells: ["3"] },
  { label: "3", cells: ["2"] },
];
const rowY = (i: number) => 132 + i * 58;
const cellW = 44;
const cellH = 40;
const cellStep = 50;
const cellX0 = 480;
const cellX = (j: number) => cellX0 + j * cellStep;
const closeX = (n: number) => cellX0 + n * cellStep + 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="190" y="108" text-anchor="middle" font-size="14" fill="var(--ink)">{t.leftHead}</text>
    {straight.map((e) => (
      <g>
        <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={e.head} fill="var(--accent)" />
      </g>
    ))}
    <path d={backCurve} fill="none" stroke="var(--accent)" stroke-width="2" />
    <polygon points={backHead} fill="var(--accent)" />
    {nodes.map((n) => (
      <g>
        <circle cx={n.cx} cy={n.cy} r={nodeR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.cx} y={n.cy + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.label}</text>
      </g>
    ))}

    <line x1="370" y1="92" x2="370" y2="352" stroke="var(--muted)" stroke-width="1" stroke-dasharray="4 4" />

    <text x="590" y="108" text-anchor="middle" font-size="14" fill="var(--ink)">{t.rightHead}</text>
    {rows.map((r, i) => (
      <g>
        <text x="446" y={rowY(i) + 27} text-anchor="end" font-size="15" fill="var(--ink)">{r.label}:</text>
        <text x="470" y={rowY(i) + 27} text-anchor="middle" font-size="15" fill="var(--muted)">[</text>
        {r.cells.map((c, j) => (
          <g>
            <rect x={cellX(j)} y={rowY(i)} width={cellW} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
            <text x={cellX(j) + cellW / 2} y={rowY(i) + 27} text-anchor="middle" font-size="15" fill="var(--ink)">{c}</text>
          </g>
        ))}
        <text x={closeX(r.cells.length)} y={rowY(i) + 27} text-anchor="middle" font-size="15" fill="var(--muted)">]</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bottom}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
