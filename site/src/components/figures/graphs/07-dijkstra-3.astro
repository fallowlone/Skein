---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Cheapest path reconstruction and the negative edge counterexample",
    headline: "CHEAPEST PATH A→C→B→E→F = 10",
    sub: "walk parent[] back from F, then reverse",
    cost: "cost = 1+2+4+3 = 10 = dist[F]",
    negHead: "NEGATIVE EDGE BREAKS THE SETTLE INVARIANT",
    negNote: "B settled at 1 — then 1+(−3) = −2 arrives too late. Negatives need Bellman-Ford.",
    caption:
      "Walking parent[] back from F gives F→E→B→C→A, reversed to A→C→B→E→F with cost 1+2+4+3 = 10 = dist[F]. But with a negative edge (A→B 1, A→C 4, B→C −3), settling B locks 1 before the −2 route to C appears — the invariant fails, so use Bellman-Ford.",
  },
  ru: {
    svgTitle: "Восстановление дешёвого пути и контрпример с отрицательным ребром",
    headline: "ДЕШЁВЫЙ ПУТЬ A→C→B→E→F = 10",
    sub: "иди по parent[] назад от F, потом переверни",
    cost: "стоимость = 1+2+4+3 = 10 = dist[F]",
    negHead: "ОТРИЦАТЕЛЬНОЕ РЕБРО ЛОМАЕТ ИНВАРИАНТ УСТАНОВКИ",
    negNote: "B зафиксирована на 1 — а потом 1+(−3) = −2 приходит слишком поздно. Для отрицательных нужен Bellman-Ford.",
    caption:
      "Проход по parent[] назад от F даёт F→E→B→C→A, перевёрнутый в A→C→B→E→F со стоимостью 1+2+4+3 = 10 = dist[F]. Но с отрицательным ребром (A→B 1, A→C 4, B→C −3) фиксация B закрепляет 1 до того как появляется маршрут −2 к C — инвариант рушится, так что используй Bellman-Ford.",
  },
};

const t = dict[lang];

const path = [
  { v: "A", x: 120 },
  { v: "C", x: 250 },
  { v: "B", x: 380 },
  { v: "E", x: 510 },
  { v: "F", x: 640 },
];
const py = 148;
const pr = 24;
const weights = ["1", "2", "4", "3"];
const plinks = [0, 1, 2, 3];
const plinkX1 = (i: number) => path[i].x + pr + 2;
const plinkX2 = (i: number) => path[i + 1].x - pr - 2;
const phead = (x2: number) => `${x2},${py} ${x2 - 11},${py - 6} ${x2 - 11},${py + 6}`;
const wmid = (i: number) => (path[i].x + path[i + 1].x) / 2;

const tri = [
  { v: "A", x: 150, y: 340 },
  { v: "B", x: 400, y: 285 },
  { v: "C", x: 650, y: 340 },
];
const tlinks = [
  { x1: 177, y1: 334, x2: 373, y2: 291, w: "1", lx: 278, ly: 302, head: "373,291 363,297 361,289" },
  { x1: 178, y1: 340, x2: 622, y2: 340, w: "4", lx: 400, ly: 330, head: "622,340 610,334 610,346" },
  { x1: 427, y1: 291, x2: 623, y2: 334, w: "−3", lx: 522, ly: 302, head: "623,334 611,336 613,328" },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {plinks.map((i) => (
      <g>
        <line x1={plinkX1(i)} y1={py} x2={plinkX2(i)} y2={py} stroke="var(--accent)" stroke-width="2" />
        <polygon points={phead(plinkX2(i))} fill="var(--accent)" />
        <text x={wmid(i)} y={py - 34} text-anchor="middle" font-size="14" fill="var(--ink)">{weights[i]}</text>
      </g>
    ))}

    {path.map((n) => (
      <g>
        <circle cx={n.x} cy={py} r={pr} fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={n.x} y={py + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.v}</text>
      </g>
    ))}

    <text x="400" y="205" text-anchor="middle" font-size="14" fill="var(--ink)">{t.cost}</text>

    <line x1="60" y1="232" x2="740" y2="232" stroke="var(--muted)" stroke-width="1" />
    <text x="400" y="256" text-anchor="middle" font-family="var(--font-display)" font-size="15" fill="var(--ink)">{t.negHead}</text>

    {tlinks.map((e) => (
      <g>
        <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
        <polygon points={e.head} fill="var(--ink)" />
        <text x={e.lx} y={e.ly} text-anchor="middle" font-size="14" fill="var(--accent)">{e.w}</text>
      </g>
    ))}

    {tri.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r={pr} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.v}</text>
      </g>
    ))}

    <text x="400" y="398" text-anchor="middle" font-size="12" fill="var(--muted)">{t.negNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
