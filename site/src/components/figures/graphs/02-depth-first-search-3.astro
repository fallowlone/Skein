---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Iterative DFS stack and visited states across six pops, ending in order 0, 1, 3, 2",
    headline: "ITERATIVE DFS: EXPLICIT STACK",
    sub: "pop a vertex · push unvisited neighbors in reverse order",
    colPop: "pop",
    colStack: "stack",
    colVisited: "visited",
    skipNote: "already visited, skip",
    doneNote: "empty · order 0, 1, 3, 2",
    footer: "stack holds [2, 2] — one vertex twice → stack O(E) · time O(V+E), space O(V+E)",
    caption:
      "Iterative DFS from 0 over six pops: 0 → stack [2, 1]; 1 → [2, 3]; 3 → [2, 2]; 2 → [2]; 2 again (already visited, skip) → []; then done with visit order 0, 1, 3, 2. The duplicated [2, 2] is why the explicit stack can hold up to O(E) entries.",
  },
  ru: {
    svgTitle: "Состояния стека и посещённых в итеративном DFS за шесть извлечений, порядок 0, 1, 3, 2",
    headline: "ИТЕРАТИВНЫЙ DFS: ЯВНЫЙ СТЕК",
    sub: "извлеки вершину · добавь непосещённых соседей в обратном порядке",
    colPop: "извлеки",
    colStack: "стек",
    colVisited: "visited",
    skipNote: "уже посещена, пропусти",
    doneNote: "пуст · порядок 0, 1, 3, 2",
    footer: "стек хранит [2, 2] — одна вершина дважды → стек O(E) · время O(V+E), память O(V+E)",
    caption:
      "Итеративный DFS из 0 за шесть извлечений: 0 → стек [2, 1]; 1 → [2, 3]; 3 → [2, 2]; 2 → [2]; 2 снова (уже посещена, пропусти) → []; потом готово с порядком посещения 0, 1, 3, 2. Дублированный [2, 2] — почему явный стек может содержать до O(E) записей.",
  },
};

const t = dict[lang];

const rows = [
  { pop: "0", stack: "[2, 1]", visited: "{0}" },
  { pop: "1", stack: "[2, 3]", visited: "{0, 1}" },
  { pop: "3", stack: "[2, 2]", visited: "{0, 1, 3}" },
  { pop: "2", stack: "[2]", visited: "{0, 1, 3, 2}" },
  { pop: "2", stack: "[]", visited: "{0, 1, 3, 2}" },
  { pop: "—", stack: "[]", visited: "{0, 1, 3, 2}" },
];

const rowTop = (i: number) => 126 + i * 40;
const rowMid = (i: number) => rowTop(i) + 16;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="60" y="112" text-anchor="middle" font-size="12" fill="var(--muted)">#</text>
    <text x="120" y="112" font-size="12" fill="var(--muted)">{t.colPop}</text>
    <text x="250" y="112" font-size="12" fill="var(--muted)">{t.colStack}</text>
    <text x="400" y="112" font-size="12" fill="var(--muted)">{t.colVisited}</text>

    <line x1="60" y1="157" x2="60" y2="325" stroke="var(--muted)" stroke-width="2" />
    <polygon points="60,329 54,319 66,319" fill="var(--muted)" />

    {rows.map((r, i) => (
      <g>
        <circle cx="60" cy={rowMid(i)} r="13" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="60" y={rowMid(i) + 4} text-anchor="middle" font-size="12" fill="var(--ink)">{i + 1}</text>
        <rect x="96" y={rowTop(i)} width="648" height="32" fill="var(--card)" stroke={i === 2 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 2 ? 3 : 1.5} />
        <text x="120" y={rowMid(i) + 5} font-size="13" fill="var(--ink)">{r.pop}</text>
        <text x="250" y={rowMid(i) + 5} font-size="13" fill={i === 2 ? "var(--accent)" : "var(--ink)"}>{r.stack}</text>
        <text x="400" y={rowMid(i) + 5} font-size="13" fill="var(--ink)">{r.visited}</text>
      </g>
    ))}
    <text x="556" y={rowMid(4) + 5} font-size="12" fill="var(--muted)">{t.skipNote}</text>
    <text x="556" y={rowMid(5) + 5} font-size="12" fill="var(--muted)">{t.doneNote}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.footer}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
