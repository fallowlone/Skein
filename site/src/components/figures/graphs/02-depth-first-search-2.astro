---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Recursive DFS trace on the example graph with visit order 0, 1, 3, 2",
    headline: "RECURSIVE DFS: DIVE 0 → 1 → 3 → 2",
    sub: "mark, recurse into unvisited neighbors, backtrack on return",
    stepsTitle: "recursive DFS on the example",
    steps: [
      "mark 0, recurse into 1",
      "mark 1, recurse into 3",
      "mark 3, recurse into 2",
      "mark 2; 2 → 3 visited, skip",
      "done with 2, return 3 → 1 → 0",
      "0 → 2 visited, skip · done",
    ],
    skip: "skip",
    legRecurse: "recurse into unvisited",
    legSkip: "skip: already visited",
    footer: "final visit order: 0 → 1 → 3 → 2",
    caption:
      "Recursive DFS from 0 marks 0 and recurses 0 → 1 → 3 → 2, skips 2 → 3 (3 already visited), backtracks to 0, then skips 0 → 2 (2 already visited). Final visit order: 0, 1, 3, 2.",
  },
  ru: {
    svgTitle: "Трассировка рекурсивного DFS на примере графа с порядком 0, 1, 3, 2",
    headline: "РЕКУРСИВНЫЙ DFS: НЫРОК 0 → 1 → 3 → 2",
    sub: "отметь, рекурсия в непосещённых соседей, возврат при возврате",
    stepsTitle: "рекурсивный DFS на примере",
    steps: [
      "отметь 0, рекурсия в 1",
      "отметь 1, рекурсия в 3",
      "отметь 3, рекурсия в 2",
      "отметь 2; 2 → 3 посещена, пропусти",
      "готово с 2, возврат 3 → 1 → 0",
      "0 → 2 посещена, пропусти · готово",
    ],
    skip: "пропусти",
    legRecurse: "рекурсия в непосещённых",
    legSkip: "пропусти: уже посещена",
    footer: "финальный порядок посещения: 0 → 1 → 3 → 2",
    caption:
      "Рекурсивный DFS из 0 отмечает 0 и рекурсирует 0 → 1 → 3 → 2, пропускает 2 → 3 (3 уже посещена), возвращается назад в 0, потом пропускает 0 → 2 (2 уже посещена). Финальный порядок посещения: 0, 1, 3, 2.",
  },
};

const t = dict[lang];

const nodes = [
  { id: "0", cx: 120, cy: 140 },
  { id: "1", cx: 300, cy: 140 },
  { id: "2", cx: 120, cy: 300 },
  { id: "3", cx: 300, cy: 300 },
];

const plunge = [
  { x1: 146, y1: 140, x2: 268, y2: 140, head: "274,140 263,134 263,146" },
  { x1: 300, y1: 166, x2: 300, y2: 268, head: "300,274 294,263 306,263" },
];

const plungeBack = [
  { x1: 300, y1: 326, x2: 300, y2: 352 },
  { x1: 300, y1: 352, x2: 120, y2: 352 },
  { x1: 120, y1: 352, x2: 120, y2: 332 },
];
const plungeBackHead = "120,326 114,337 126,337";

const skips = [
  { x1: 120, y1: 166, x2: 120, y2: 268, head: "120,274 114,263 126,263" },
  { x1: 146, y1: 300, x2: 268, y2: 300, head: "274,300 263,294 263,306" },
];

const badges = [
  { x: 142, y: 118, n: "1" },
  { x: 322, y: 118, n: "2" },
  { x: 142, y: 278, n: "4" },
  { x: 322, y: 278, n: "3" },
];

const stepY = (i: number) => 140 + i * 40;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="575" y="104" text-anchor="middle" font-size="13" fill="var(--muted)">{t.stepsTitle}</text>

    {skips.map((e) => (
      <g>
        <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 5" />
        <polygon points={e.head} fill="var(--muted)" />
      </g>
    ))}
    {plunge.map((e) => (
      <g>
        <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--accent)" stroke-width="3" />
        <polygon points={e.head} fill="var(--accent)" />
      </g>
    ))}
    {plungeBack.map((s) => (
      <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="var(--accent)" stroke-width="3" />
    ))}
    <polygon points={plungeBackHead} fill="var(--accent)" />
    {nodes.map((n) => (
      <g>
        <circle cx={n.cx} cy={n.cy} r="26" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.cx} y={n.cy + 6} text-anchor="middle" font-size="18" fill="var(--ink)">{n.id}</text>
      </g>
    ))}
    {badges.map((b) => (
      <g>
        <circle cx={b.x} cy={b.y} r="12" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={b.x} y={b.y + 4} text-anchor="middle" font-size="12" fill="var(--ink)">{b.n}</text>
      </g>
    ))}
    <text x="134" y="224" font-size="12" fill="var(--muted)">{t.skip}</text>
    <text x="210" y="290" text-anchor="middle" font-size="12" fill="var(--muted)">{t.skip}</text>

    {t.steps.map((s, i) => (
      <g>
        <circle cx="398" cy={stepY(i)} r="12" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="398" y={stepY(i) + 4} text-anchor="middle" font-size="12" fill="var(--ink)">{i + 1}</text>
        <text x="418" y={stepY(i) + 4} font-size="12" fill="var(--ink)">{s}</text>
      </g>
    ))}

    <line x1="40" y1="372" x2="70" y2="372" stroke="var(--accent)" stroke-width="3" />
    <text x="78" y="376" font-size="12" fill="var(--ink)">{t.legRecurse}</text>
    <line x1="270" y1="372" x2="300" y2="372" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 5" />
    <text x="308" y="376" font-size="12" fill="var(--ink)">{t.legSkip}</text>

    <text x="400" y="400" text-anchor="middle" font-size="13" fill="var(--muted)">{t.footer}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
