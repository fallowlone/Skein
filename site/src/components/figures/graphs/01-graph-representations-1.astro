---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Undirected edge A-B versus directed chain A to B to C",
    headline: "UNDIRECTED: BOTH WAYS · DIRECTED: ONE WAY",
    sub: "undirected: symmetric · directed: one-way (digraph)",
    leftHead: "UNDIRECTED",
    rightHead: "DIRECTED",
    leftEdge: "A ↔ B",
    leftNote: "symmetric: A to B and B to A",
    rightEdge: "A → B → C",
    rightNote: "one-way: no edge C → A",
    bottom: "directed means follow the arrowhead — no arrowhead, no way back",
    caption:
      "Undirected A — B is symmetric: you can traverse A ↔ B. Directed A → B → C is one-way: you can go A → B → C, but not back from C to A because there is no edge C → A.",
  },
  ru: {
    svgTitle: "Неориентированное ребро A–B против ориентированной цепочки A в B в C",
    headline: "НЕОРИЕНТИРОВАННЫЙ: ОБЕ СТОРОНЫ · ОРИЕНТИРОВАННЫЙ: ОДНА",
    sub: "неориентированный: симметричный · ориентированный: односторонний (орграф)",
    leftHead: "НЕОРИЕНТИРОВАННЫЙ",
    rightHead: "ОРИЕНТИРОВАННЫЙ",
    leftEdge: "A ↔ B",
    leftNote: "симметрично: A в B и B в A",
    rightEdge: "A → B → C",
    rightNote: "односторонне: нет ребра C → A",
    bottom: "ориентированный — значит иди по стрелке: нет стрелки — нет пути назад",
    caption:
      "Неориентированное A — B симметрично: можно пересечь A ↔ B. Ориентированное A → B → C односторонне: можно идти A → B → C, но не обратно от C к A, потому что нет ребра C → A.",
  },
};

const t = dict[lang];

const leftNodes = [
  { label: "A", cx: 120, cy: 220 },
  { label: "B", cx: 280, cy: 220 },
];
const rightNodes = [
  { label: "A", cx: 470, cy: 220 },
  { label: "B", cx: 580, cy: 220 },
  { label: "C", cx: 690, cy: 220 },
];
const rightArrows = [
  { x1: 496, x2: 548, head: "542,213 542,227 554,220" },
  { x1: 606, x2: 658, head: "652,213 652,227 664,220" },
];
const nodeR = 26;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="110" text-anchor="middle" font-size="14" fill="var(--ink)">{t.leftHead}</text>
    <line x1="146" y1="220" x2="254" y2="220" stroke="var(--ink)" stroke-width="2" />
    {leftNodes.map((n) => (
      <g>
        <circle cx={n.cx} cy={n.cy} r={nodeR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.cx} y={n.cy + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.label}</text>
      </g>
    ))}
    <text x="200" y="292" text-anchor="middle" font-size="15" fill="var(--accent)">{t.leftEdge}</text>
    <text x="200" y="316" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftNote}</text>

    <line x1="400" y1="92" x2="400" y2="340" stroke="var(--muted)" stroke-width="1" stroke-dasharray="4 4" />

    <text x="580" y="110" text-anchor="middle" font-size="14" fill="var(--ink)">{t.rightHead}</text>
    {rightArrows.map((a) => (
      <g>
        <line x1={a.x1} y1="220" x2={a.x2} y2="220" stroke="var(--accent)" stroke-width="2" />
        <polygon points={a.head} fill="var(--accent)" />
      </g>
    ))}
    {rightNodes.map((n) => (
      <g>
        <circle cx={n.cx} cy={n.cy} r={nodeR} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.cx} y={n.cy + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.label}</text>
      </g>
    ))}
    <text x="580" y="292" text-anchor="middle" font-size="15" fill="var(--accent)">{t.rightEdge}</text>
    <text x="580" y="316" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightNote}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bottom}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
