---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Undirected graph with three connected components: triangle, pair, pair",
    headline: "3 PIECES · 3 COMPONENTS",
    sub: "maximal sets of mutually reachable vertices · one BFS visits one piece",
    compA: "Component A",
    compB: "Component B",
    compC: "Component C",
    setA: "{0, 1, 2}",
    setB: "{3, 4}",
    setC: "{5, 6}",
    edgesNote: "undirected: each edge appears in both directions",
    result: "count = 3",
    caption:
      "The lesson's example graph: triangle {0,1,2}, edge {3,4}, edge {5,6}. No edge bridges the three clusters, so the graph has 3 connected components. One BFS or DFS from any vertex visits its whole component and nothing else.",
  },
  ru: {
    svgTitle: "Неориентированный граф с тремя связными компонентами: треугольник, пара, пара",
    headline: "3 КУСКА · 3 КОМПОНЕНТЫ",
    sub: "максимальные множества взаимно достижимых вершин · один BFS посещает один кусок",
    compA: "Компонента A",
    compB: "Компонента B",
    compC: "Компонента C",
    setA: "{0, 1, 2}",
    setB: "{3, 4}",
    setC: "{5, 6}",
    edgesNote: "неориентированный: каждое ребро появляется в обоих направлениях",
    result: "count = 3",
    caption:
      "Пример графа из урока: треугольник {0,1,2}, ребро {3,4}, ребро {5,6}. Нет ребра соединяющего три кластера, так граф имеет 3 связные компоненты. Один BFS или DFS из любой вершины посещает всю её компоненту и ничего больше.",
  },
};

const t = dict[lang];

interface Node {
  id: string;
  x: number;
  y: number;
}

const nodes: Node[] = [
  { id: "0", x: 100, y: 180 },
  { id: "1", x: 210, y: 180 },
  { id: "2", x: 155, y: 262 },
  { id: "3", x: 400, y: 175 },
  { id: "4", x: 400, y: 265 },
  { id: "5", x: 575, y: 220 },
  { id: "6", x: 685, y: 220 },
];

const at = (id: string) => nodes.find((n) => n.id === id) as Node;
const edgePairs: Array<[string, string]> = [["0", "1"], ["1", "2"], ["2", "0"], ["3", "4"], ["5", "6"]];
const edges = edgePairs.map((pair) => ({ x1: at(pair[0]).x, y1: at(pair[0]).y, x2: at(pair[1]).x, y2: at(pair[1]).y }));

const boxes = [
  { x: 60, label: dict[lang].compA, cx: 155, set: dict[lang].setA },
  { x: 345, label: dict[lang].compB, cx: 400, set: dict[lang].setB },
  { x: 540, label: dict[lang].compC, cx: 630, set: dict[lang].setC },
];
const boxW = [190, 110, 180];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {boxes.map((b, i) => (
      <g>
        <text x={b.cx} y="100" text-anchor="middle" font-size="14" fill="var(--accent)">{b.label}</text>
        <rect x={b.x} y="116" width={boxW[i]} height="174" rx="12" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 5" />
        <text x={b.cx} y="304" text-anchor="middle" font-size="14" fill="var(--ink)">{b.set}</text>
      </g>
    ))}

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
    ))}

    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="22" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.id}</text>
      </g>
    ))}

    <text x="400" y="348" text-anchor="middle" font-size="13" fill="var(--muted)">{t.edgesNote}</text>
    <text x="400" y="388" text-anchor="middle" font-size="18" fill="var(--accent)">{t.result}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
