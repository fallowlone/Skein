---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Worked trace of counting connected components over vertices 0 to 6",
    headline: "ONE LAUNCH PER PIECE: SWALLOW, COUNT, SKIP",
    sub: "shared visited set · never double-count",
    colV: "vertex",
    colAct: "action",
    colCount: "counter",
    colVis: "visited",
    launch1: "launch #1 · BFS marks {0, 1, 2}",
    launch2: "launch #2 · BFS marks {3, 4}",
    launch3: "launch #3 · BFS marks {5, 6}",
    skip: "skip · already visited",
    result: "Result: count = 3",
    caption:
      "Worked trace on the 3-component graph: launches at v=0, v=3 and v=5 bump count to 1, 2 and 3, while v=1, v=2, v=4 and v=6 are skipped as already visited. The one shared visited set guarantees each component is counted exactly once.",
  },
  ru: {
    svgTitle: "Разобранная трассировка подсчёта связных компонент по вершинам от 0 до 6",
    headline: "ОДИН ЗАПУСК НА КУСОК: ГЛОТНИ, СОСЧИТАЙ, ПРОПУСТИ",
    sub: "общий visited · без двойного счёта",
    colV: "вершина",
    colAct: "действие",
    colCount: "счётчик",
    colVis: "visited",
    launch1: "запуск #1 · BFS метит {0, 1, 2}",
    launch2: "запуск #2 · BFS метит {3, 4}",
    launch3: "запуск #3 · BFS метит {5, 6}",
    skip: "пропуск · уже посещена",
    result: "Итог: count = 3",
    caption:
      "Разобранная трассировка на графе из 3 компонент: запуски в v=0, v=3 и v=5 поднимают счётчик до 1, 2 и 3, пока v=1, v=2, v=4 и v=6 пропускаются как уже посещённые. Одно общее множество visited гарантирует что каждая компонента посчитана ровно раз.",
  },
};

const t = dict[lang];

interface Row {
  v: string;
  action: string;
  count: string;
  visited: string;
  launch: boolean;
}

const rows: Row[] = [
  { v: "v = 0", action: t.launch1, count: "count = 1", visited: "{0, 1, 2}", launch: true },
  { v: "v = 1", action: t.skip, count: "count = 1", visited: "{0, 1, 2}", launch: false },
  { v: "v = 2", action: t.skip, count: "count = 1", visited: "{0, 1, 2}", launch: false },
  { v: "v = 3", action: t.launch2, count: "count = 2", visited: "{0, 1, 2, 3, 4}", launch: true },
  { v: "v = 4", action: t.skip, count: "count = 2", visited: "{0, 1, 2, 3, 4}", launch: false },
  { v: "v = 5", action: t.launch3, count: "count = 3", visited: "{0..6}", launch: true },
  { v: "v = 6", action: t.skip, count: "count = 3", visited: "{0..6}", launch: false },
];

const rowY = (i: number) => 120 + i * 34;
const dividers = rows.map((_r, i) => rowY(i) + 13).slice(0, 6);
const rowIndex = rows.map((_r, i) => i);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="95" y="94" font-size="12" fill="var(--muted)">{t.colV}</text>
    <text x="200" y="94" font-size="12" fill="var(--muted)">{t.colAct}</text>
    <text x="480" y="94" font-size="12" fill="var(--muted)">{t.colCount}</text>
    <text x="600" y="94" font-size="12" fill="var(--muted)">{t.colVis}</text>

    {dividers.map((y) => (
      <line x1="45" y1={y} x2="755" y2={y} stroke="var(--muted)" stroke-width="1" opacity="0.4" />
    ))}

    {rowIndex.map((i) => (
      <g>
        <circle cx="62" cy={rowY(i) - 5} r="6" fill={rows[i].launch ? "var(--accent)" : "var(--muted)"} />
        <text x="95" y={rowY(i)} font-size="14" fill="var(--ink)">{rows[i].v}</text>
        <text x="200" y={rowY(i)} font-size="13" fill="var(--ink)">{rows[i].action}</text>
        <text x="480" y={rowY(i)} font-size="13" fill="var(--ink)">{rows[i].count}</text>
        <text x="600" y={rowY(i)} font-size="13" fill="var(--muted)">{rows[i].visited}</text>
      </g>
    ))}

    <text x="400" y="388" text-anchor="middle" font-size="18" fill="var(--accent)">{t.result}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
