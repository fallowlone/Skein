---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Naive rescan of hello costs n times n, one frequency pass costs n",
    headline: "RESCAN PER LETTER vs REMEMBER IN A MAP",
    formula: "naive: n scans × n letters · map: n letters × O(1)",
    cost: "n = 1000 → naive 1,000,000 ops · map 2,000 ops",
    naiveTitle: "NAIVE O(n²)",
    scanWord: "scan",
    naiveSub: "“hello”: rescan per letter",
    mapTitle: "MAP O(n)",
    mapSub: "one pass, O(1) get/set",
    repeat: "repeat the full scan",
    remember: "the map remembers",
    verdictNaive: "5 letters × 5 scans = 25",
    verdictMap: "5 letters × 1 pass = 5",
    caption:
      "Naive counting rescans “hello” for every letter (h: 1, e: 1, l: 2, l: 2, o: 1) — n × n work. The frequency map counts once per letter into h→1, e→1, l→2, o→1 — n × 1 work.",
  },
  ru: {
    svgTitle: "Наивный перескан hello стоит n на n, один проход с частотой стоит n",
    headline: "ПЕРЕСКАН НА БУКВУ vs ПАМЯТЬ В КАРТЕ",
    formula: "наивно: n сканов × n букв · карта: n букв × O(1)",
    cost: "n = 1000 → наивно 1 000 000 оп. · карта 2 000 оп.",
    naiveTitle: "НАИВНО O(n²)",
    scanWord: "скан",
    naiveSub: "«hello»: перескан на букву",
    mapTitle: "КАРТА O(n)",
    mapSub: "один проход, O(1) get/set",
    repeat: "повторяй полный скан",
    remember: "карта помнит",
    verdictNaive: "5 букв × 5 сканов = 25",
    verdictMap: "5 букв × 1 проход = 5",
    caption:
      "Наивный подсчёт пересканирует «hello» ради каждой буквы (h: 1, e: 1, l: 2, l: 2, o: 1) — работы n × n. Карта частоты считает раз на букву в h→1, e→1, l→2, o→1 — работы n × 1.",
  },
};

const t = dict[lang];

const letters = ["h", "e", "l", "l", "o"];
const counts = ["1", "1", "2", "2", "1"];
const rowY = [160, 204, 248, 292, 336];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <text x="400" y="36" text-anchor="middle" font-family="var(--font-display)" font-size="25" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="62" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="84" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>

    <!-- left: naive rescans -->
    <text x="200" y="118" text-anchor="middle" font-size="15" fill="var(--ink)">{t.naiveTitle}</text>
    <text x="200" y="136" text-anchor="middle" font-size="12" fill="var(--muted)">{t.naiveSub}</text>
    {letters.map((ch, i) => (
      <g>
        <rect x="40" y={rowY[i] - 18} width="130" height="36" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="105" y={rowY[i] + 6} text-anchor="middle" font-size="15" fill="var(--ink)">{ch} · {t.scanWord} → {counts[i]}</text>
        <rect x="178" y={rowY[i] - 18} width="182" height="36" rx="8" fill="none" stroke="var(--muted)" stroke-width="2" stroke-dasharray="5 4" />
        <text x="269" y={rowY[i] + 6} text-anchor="middle" font-size="12" fill="var(--muted)">{t.repeat}</text>
      </g>
    ))}

    <!-- divider -->
    <line x1="380" y1="110" x2="380" y2="360" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" />

    <!-- right: one pass into map -->
    <text x="625" y="118" text-anchor="middle" font-size="15" fill="var(--ink)">{t.mapTitle}</text>
    <text x="625" y="136" text-anchor="middle" font-size="12" fill="var(--muted)">{t.mapSub}</text>
    {letters.map((ch, i) => (
      <g>
        <rect x="460" y={rowY[i] - 18} width="70" height="36" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="495" y={rowY[i] + 6} text-anchor="middle" font-size="15" fill="var(--ink)">{ch}</text>
        <line x1="538" y1={rowY[i]} x2="596" y2={rowY[i]} stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
        <polygon points={`596,${rowY[i] - 5} 596,${rowY[i] + 5} 606,${rowY[i]}`} fill="var(--accent)" />
      </g>
    ))}
    <rect x="610" y="146" width="150" height="212" rx="10" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="685" y="200" text-anchor="middle" font-size="14" fill="var(--ink)">h→1</text>
    <text x="685" y="236" text-anchor="middle" font-size="14" fill="var(--ink)">e→1</text>
    <text x="685" y="272" text-anchor="middle" font-size="14" fill="var(--ink)">l→2</text>
    <text x="685" y="308" text-anchor="middle" font-size="14" fill="var(--ink)">o→1</text>
    <text x="200" y="378" text-anchor="middle" font-size="13" fill="var(--muted)">{t.verdictNaive}</text>
    <text x="625" y="378" text-anchor="middle" font-size="13" fill="var(--accent)">{t.verdictMap} · {t.remember}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
