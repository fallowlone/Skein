---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Set versus map: a set stores values, a map stores key-value pairs, both at the hashed index",
    headline: "SET vs MAP — ONE SHAPE",
    setHead: "SET — stores the value",
    setRow1: "10 · has(10) → true",
    setRow2: "20 · has(20) → true",
    setRow3: "99 · has(99) → false",
    setNote: "answers has() in O(1)",
    mapHead: "MAP — stores key + value",
    mapRow1: "Alice → 555-1234",
    mapRow2: "Bob → 555-5678",
    mapCall: "get(Alice) → 555-1234 · O(1)",
    foot: "Both compute one index, then jump there.",
    caption: "A set keeps the value at its hash index; a map keeps the key–value pair there. Same shape, same O(1) jump.",
  },
  ru: {
    svgTitle: "Множество против словаря: множество хранит значения, словарь — пары ключ–значение, оба по хеш-индексу",
    headline: "SET vs MAP — ОДНА ФОРМА",
    setHead: "МНОЖЕСТВО — хранит значение",
    setRow1: "10 · has(10) → true",
    setRow2: "20 · has(20) → true",
    setRow3: "99 · has(99) → false",
    setNote: "отвечает has() за O(1)",
    mapHead: "СЛОВАРЬ — хранит ключ + значение",
    mapRow1: "Alice → 555-1234",
    mapRow2: "Bob → 555-5678",
    mapCall: "get(Alice) → 555-1234 · O(1)",
    foot: "Оба вычисляют один индекс, потом прыгают туда.",
    caption: "Множество держит значение по его хеш-индексу; словарь держит там пару ключ–значение. Та же форма, тот же прыжок O(1).",
  },
};

const t = dict[lang];
const setRows = [t.setRow1, t.setRow2, t.setRow3];
const mapRows = [t.mapRow1, t.mapRow2];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="36" text-anchor="middle" font-family="var(--font-display)" font-size="25" fill="var(--ink)">{t.headline}</text>

    <rect x="40" y="60" width="330" height="290" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="60" y="92" font-size="14" fill="var(--ink)">{t.setHead}</text>
    {setRows.map((r, i) => (
      <g>
        <rect x="60" y={106 + i * 52} width="290" height="40" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="76" y={131 + i * 52} font-size="13" fill="var(--ink)">{r}</text>
      </g>
    ))}
    <text x="60" y="330" font-size="13" fill="var(--accent)">{t.setNote}</text>

    <rect x="430" y="60" width="330" height="290" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="450" y="92" font-size="14" fill="var(--ink)">{t.mapHead}</text>
    {mapRows.map((r, i) => (
      <g>
        <rect x="450" y={106 + i * 52} width="290" height="40" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="466" y={131 + i * 52} font-size="13" fill="var(--ink)">{r}</text>
      </g>
    ))}
    <rect x="450" y={106 + 2 * 52} width="290" height="40" rx="8" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 5" />
    <text x="466" y={131 + 2 * 52} font-size="13" fill="var(--accent)">{t.mapCall}</text>
    <text x="450" y="330" font-size="13" fill="var(--muted)">set / get / delete · O(1)</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
