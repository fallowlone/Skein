---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Words sorting into anagram group keys",
    headline: "SORT EACH WORD INTO ITS KEY",
    formula: "key = word.split('').sort().join('')",
    colWord: "WORD",
    colKey: "KEY",
    colGroup: "GROUP",
    sortLabel: "sort",
    group1: "GROUP 1",
    group2: "GROUP 2",
    band: "same key → same bucket → same group",
    caption:
      "Each word sorts into its canonical key: eat, tea, ate share aet; tan, nat share ant. Same key, same group.",
  },
  ru: {
    svgTitle: "Слова сортируются в ключи групп анаграмм",
    headline: "ОТСОРТИРУЙ КАЖДОЕ СЛОВО В ЕГО КЛЮЧ",
    formula: "key = word.split('').sort().join('')",
    colWord: "СЛОВО",
    colKey: "КЛЮЧ",
    colGroup: "ГРУППА",
    sortLabel: "сортировка",
    group1: "ГРУППА 1",
    group2: "ГРУППА 2",
    band: "один ключ → одно ведро → одна группа",
    caption:
      "Каждое слово сортируется в канонический ключ: eat, tea, ate делят aet; tan, nat делят ant. Один ключ — одна группа.",
