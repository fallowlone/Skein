---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "One pass over a, b, a, c, a builds counts a to 3, b to 1, c to 1",
    headline: "ONE PASS BUILDS THE COUNTS",
    formula: "freq.set(char, (freq.get(char) ?? 0) + 1)",
    cost: "5 letters · 5 increments · O(n)",
    stepNew: "new → 1",
    stepBump: "+1",
    bucketA: "key a → 3",
    bucketB: "key b → 1",
    bucketC: "key c → 1",
    done: "after the single pass the map is complete",
    caption:
      "Scanning a, b, a, c, a left to right, each letter bumps its own key: a lands three times, b once, c once — counts 3, 1, 1.",
  },
  ru: {
    svgTitle: "Один проход по a, b, a, c, a строит счёт: a — 3, b — 1, c — 1",
    headline: "ОДИН ПРОХОД СТРОИТ СЧЁТ",
    formula: "freq.set(char, (freq.get(char) ?? 0) + 1)",
    cost: "5 букв · 5 инкрементов · O(n)",
    stepNew: "новая → 1",
    stepBump: "+1",
    bucketA: "ключ a → 3",
    bucketB: "ключ b → 1",
    bucketC: "ключ c → 1",
    done: "после единственного прохода карта готова",
    caption:
      "Сканируем a, b, a, c, a слева направо, каждая буква дёргает счётчик своего ключа: a ложится трижды, b раз, c раз — счёт 3, 1, 1.",
  },
};

const t = dict[lang];

const stream = ["a", "b", "a", "c", "a"];
const streamX = [110, 255, 400, 545, 690];
const tag = [t.stepNew, t.stepNew, "1→2", t.stepNew, "2→3"];

---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <text x="400" y="36" text-anchor="middle" font-family="var(--font-display)" font-size="25" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="62" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="84" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>

    {stream.map((ch, i) => (
      <g>
        <rect x={streamX[i] - 34} y="104" width="68" height="48" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={streamX[i]} y="134" text-anchor="middle" font-size="18" fill="var(--ink)">{ch}</text>
        <text x={streamX[i]} y="172" text-anchor="middle" font-size="12" fill="var(--muted)">{tag[i]}</text>
        <line x1={streamX[i]} y1="180" x2={streamX[i]} y2="208" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
        <polygon points={`${streamX[i] - 5},208 ${streamX[i] + 5},208 ${streamX[i]},216`} fill="var(--accent)" />
      </g>
    ))}

    <!-- bucket a: three stacked chips -->
    <g>
      <rect x="110" y="226" width="180" height="130" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="200" y="248" text-anchor="middle" font-size="14" fill="var(--ink)">{t.bucketA}</text>
      <rect x="130" y="258" width="140" height="28" rx="6" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="200" y="278" text-anchor="middle" font-size="13" fill="var(--ink)">a · 1</text>
      <rect x="130" y="290" width="140" height="28" rx="6" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="200" y="310" text-anchor="middle" font-size="13" fill="var(--ink)">a · 2</text>
      <rect x="130" y="322" width="140" height="28" rx="6" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="200" y="342" text-anchor="middle" font-size="13" fill="var(--ink)">a · 3</text>
    </g>

    <!-- bucket b: one chip -->
    <g>
      <rect x="310" y="226" width="180" height="130" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="400" y="248" text-anchor="middle" font-size="14" fill="var(--ink)">{t.bucketB}</text>
      <rect x="330" y="258" width="140" height="28" rx="6" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="278" text-anchor="middle" font-size="13" fill="var(--ink)">b · 1</text>
    </g>

    <!-- bucket c: one chip -->
    <g>
      <rect x="510" y="226" width="180" height="130" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="600" y="248" text-anchor="middle" font-size="14" fill="var(--ink)">{t.bucketC}</text>
      <rect x="530" y="258" width="140" height="28" rx="6" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="600" y="278" text-anchor="middle" font-size="13" fill="var(--ink)">c · 1</text>
    </g>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.done}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
