---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Rehashing restores short chains; worst case is one bucket",
    headline: "RESIZE AT 0.75 — REHASH TO O(1)",
    formula: "before: 10 items / 5 buckets, α = 2.0 → after: 10 items / 10 buckets, α = 1.0",
    before: "BEFORE α = 2.0",
    after: "AFTER α = 1.0",
    resize: "double + rehash",
    bucketsA: "5 buckets × ~2",
    bucketsB: "10 buckets × ~1",
    worst: "worst case: all n keys → one bucket → O(n)",
    caption:
      "Past 0.75 the table doubles and rehashes every key: 10 items move from 5 buckets to 10 and chains shorten. If every key lands in one bucket instead, lookup scans a chain of n: O(n).",
  },
  ru: {
    svgTitle: "Перехеширование возвращает короткие цепи; худший случай — одно ведро",
    headline: "RESIZE ПРИ 0.75 — ПЕРЕХЕШ В O(1)",
    formula: "было: 10 элементов / 5 вёдер, α = 2.0 → стало: 10 элементов / 10 вёдер, α = 1.0",
    before: "БЫЛО α = 2.0",
    after: "СТАЛО α = 1.0",
    resize: "удвоить + перехэш",
    bucketsA: "5 вёдер × ~2",
    bucketsB: "10 вёдер × ~1",
    worst: "худший случай: все n ключей → одно ведро → O(n)",
    caption:
      "После 0.75 таблица удваивается и перехеширует каждый ключ: 10 элементов переезжают с 5 вёдер на 10, и цепи короче. А если все ключи лягут в одно ведро, поиск сканирует цепь из n: O(n).",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 300" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <defs>
      <marker
        id="c3-arr"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)"></path>
      </marker>
      <marker
        id="c3-arr-acc"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)"></path>
      </marker>
    </defs>
    <text
      x="40"
      y="40"
      font-family="var(--font-display)"
      font-size="24"
      fill="var(--ink)">{t.headline}</text
    >
    <text
      x="40"
      y="64"
      font-family="var(--font-mono)"
      font-size="12"
      fill="var(--muted)">{t.formula}</text
    >
    <!-- BEFORE panel -->
    <text
      x="60"
      y="104"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.before}</text
    >
    <rect
      x="60"
      y="116"
      width="220"
      height="52"
      rx="10"
      fill="none"
      stroke="var(--accent)"
      stroke-width="2"></rect>
    <circle cx="100" cy="142" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <circle cx="128" cy="142" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <circle cx="156" cy="142" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <text x="182" y="148" font-family="var(--font-mono)" font-size="13" fill="var(--accent)">+…</text>
    <line
      x1="210"
      y1="142"
      x2="240"
      y2="142"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      marker-end="url(#c3-arr)"></line>
    <text
      x="60"
      y="190"
      font-family="var(--font-mono)"
      font-size="12"
      fill="var(--muted)">{t.bucketsA}</text
    >
    <!-- resize arrow -->
    <line
      x1="300"
      y1="142"
      x2="380"
      y2="142"
      stroke="var(--accent)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      marker-end="url(#c3-arr-acc)"></line>
    <text
      x="340"
      y="130"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="11"
      fill="var(--accent)">{t.resize}</text
    >
    <!-- AFTER panel -->
    <text
      x="400"
      y="104"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.after}</text
    >
    <rect
      x="400"
      y="116"
      width="110"
      height="52"
      rx="10"
      fill="none"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <circle cx="440" cy="142" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <rect
      x="524"
      y="116"
      width="110"
      height="52"
      rx="10"
      fill="none"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <circle cx="564" cy="142" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <text
      x="648"
      y="148"
      font-family="var(--font-mono)"
      font-size="12"
      fill="var(--muted)">… ×10</text
    >
    <text
      x="400"
      y="190"
      font-family="var(--font-mono)"
      font-size="12"
      fill="var(--muted)">{t.bucketsB}</text
    >
    <!-- worst-case band -->
    <line
      x1="40"
      y1="214"
      x2="760"
      y2="214"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></line>
    <rect
      x="60"
      y="228"
      width="300"
      height="40"
      rx="10"
      fill="none"
      stroke="var(--accent)"
      stroke-width="2"></rect>
    <circle cx="100" cy="248" r="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <circle cx="124" cy="248" r="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <circle cx="148" cy="248" r="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <text x="168" y="253" font-family="var(--font-mono)" font-size="13" fill="var(--accent)">… n</text>
    <text
      x="380"
      y="254"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--accent)">{t.worst}</text
    >
  </svg>
  <figcaption class="text-center">{t.caption}</figcaption>
</figure>
