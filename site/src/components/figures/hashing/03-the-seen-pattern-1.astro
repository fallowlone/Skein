---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Seen scan of 5, 2, 11, 9 with target 14: misses store, then 9 finds complement 5",
    headline: "SCAN ONCE: MISS MEANS STORE, HIT MEANS DONE",
    formula: "target 14 · array [5, 2, 11, 9] · comp = 14 − x",
    compShort: "comp",
    cost: "three misses + one O(1) hit · O(n)",
    ask: "is comp in seen?",
    miss: "MISS → add",
    hit: "HIT ✓",
    seenLabel: "seen after step",
    answer: "answer: 5 + 9 = 14",
    caption: "Each x asks about its complement before joining the set: 5, 2, 11 miss and are stored; 9 asks for 5 and hits. One pass, no nested loop.",
  },
  ru: {
    svgTitle: "Проход видел по 5, 2, 11, 9 с целью 14: промахи сохраняются, потом 9 находит дополнение 5",
    headline: "ОДИН ПРОХОД: МИМО — ХРАНИ, ЕСТЬ — ГОТОВО",
    formula: "цель 14 · массив [5, 2, 11, 9] · доп = 14 − x",
    compShort: "доп",
    cost: "три мимо + одно O(1)-попадание · O(n)",
    ask: "есть ли доп во видел?",
    miss: "МИМО → храни",
    hit: "ЕСТЬ ✓",
    seenLabel: "видел после шага",
    answer: "ответ: 5 + 9 = 14",
    caption: "Каждый x спрашивает про дополнение раньше, чем вступить во множество: 5, 2, 11 мажут и сохраняются; 9 спрашивает 5 и попадает. Один проход, без вложенного цикла.",
  },
};

const t = dict[lang];

// x, complement (14 - x), seen-set contents after the step, hit flag.
const steps = [
  { x: "5", comp: "9", seen: "{5}", hit: false },
  { x: "2", comp: "12", seen: "{5, 2}", hit: false },
  { x: "11", comp: "3", seen: "{5, 2, 11}", hit: false },
  { x: "9", comp: "5", seen: "5+9=14 ✓", hit: true },
];

const colX = [110, 303, 496, 689];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="82" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>

    {steps.map((s, i) => (
      <g>
        <rect x={colX[i] - 80} y="110" width="160" height="200" rx="10" fill="var(--card)" stroke={s.hit ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={colX[i]} y="138" text-anchor="middle" font-size="22" fill="var(--ink)">x={s.x}</text>
        <text x={colX[i]} y="164" text-anchor="middle" font-size="13" fill="var(--muted)">{t.compShort} {s.comp}</text>
        <text x={colX[i]} y="192" text-anchor="middle" font-size="12" fill="var(--muted)">{t.ask}</text>
        <text x={colX[i]} y="222" text-anchor="middle" font-size="14" fill={s.hit ? "var(--accent)" : "var(--ink)"}>{s.hit ? t.hit : t.miss}</text>
        <text x={colX[i]} y="250" text-anchor="middle" font-size="11" fill="var(--muted)">{t.seenLabel}</text>
        <text x={colX[i]} y="274" text-anchor="middle" font-size="14" fill="var(--ink)">{s.seen}</text>
        {i < 3 && (
          <g>
            <path d={`M ${colX[i] + 80} 210 L ${colX[i + 1] - 80} 210`} fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <polygon points={`${colX[i + 1] - 80},204 ${colX[i + 1] - 80},216 ${colX[i + 1] - 68},210`} fill="var(--ink)" />
          </g>
        )}
      </g>
    ))}

    <text x="400" y="352" text-anchor="middle" font-size="16" fill="var(--accent)">{t.answer}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">14 − 5 = 9 · 14 − 2 = 12 · 14 − 11 = 3 · 14 − 9 = 5</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
