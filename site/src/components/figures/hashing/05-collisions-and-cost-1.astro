---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Collision into chains: two keys share one bucket",
    headline: "SAME BUCKET? CHAIN UP",
    formula: "h(key) = key.charCodeAt(0) % 5",
    h0: "h=0",
    h1: "h=1",
    h2: "h=2",
    empty: "null",
    collision: "COLLISION",
    chain: "chain",
    lookup: "lookup April: hash to 0, walk Alice → April",
    caption:
      "Alice and April both hash to bucket 0, Bob and Ben to bucket 1: each bucket holds a chain. Lookup hashes to the bucket, then walks the short list.",
  },
  ru: {
    svgTitle: "Коллизия в цепочки: два ключа делят одно ведро",
    headline: "ОДНО ВЕДРО? СТРОЙ ЦЕПОЧКУ",
    formula: "h(key) = key.charCodeAt(0) % 5",
    h0: "h=0",
    h1: "h=1",
    h2: "h=2",
    empty: "null",
    collision: "КОЛЛИЗИЯ",
    chain: "цепь",
    lookup: "поиск April: хеш в 0, идём Alice → April",
    caption:
      "Alice и April оба хешируются в ведро 0, Bob и Ben — в ведро 1: каждое ведро держит цепочку. Поиск хеширует в ведро, потом идёт по короткому списку.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <defs>
      <marker
        id="c1-arr"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text
      x="40"
      y="46"
      font-family="var(--font-display)"
      font-size="25"
      fill="var(--ink)">{t.headline}</text
    >
    <text
      x="40"
      y="74"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--muted)">{t.formula}</text
    >
    <!-- row b0: Alice -> April, h=0, collision -->
    <rect
      x="60"
      y="100"
      width="70"
      height="40"
      rx="8"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="95"
      y="126"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="16"
