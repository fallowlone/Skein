---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One grouping shape with three different group keys",
    headline: "ONE SHAPE, MANY KEYS",
    sub: "key = f(item); map[key].push(item)",
    fnSort: "sort letters",
    fnMod: "n % 6",
    fnFirst: "first letter",
    caption:
      "Key design decides what same group means: sorted letters, remainder, first letter — one shape, map[key].push(item).",
  },
  ru: {
    svgTitle: "Одна форма группировки с тремя разными ключами групп",
    headline: "ОДНА ФОРМА, МНОГО КЛЮЧЕЙ",
    sub: "key = f(item); map[key].push(item)",
    fnSort: "сортировка букв",
    fnMod: "n % 6",
    fnFirst: "первая буква",
    caption:
      "Дизайн ключа решает, что значит одна группа: отсортированные буквы, остаток, первая буква — одна форма, map[key].push(item).",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 300" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <defs>
      <marker
        id="g3-arr"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text
      x="40"
      y="42"
      font-family="var(--font-display)"
      font-size="24"
      fill="var(--ink)">{t.headline}</text
    >
    <text
      x="40"
      y="68"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--muted)">{t.sub}</text
    >
    <!-- row 1: anagrams → aet -->
    <text
      x="40"
      y="128"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--ink)">eat · tea · ate</text
    >
    <line
      x1="210"
      y1="122"
      x2="286"
      y2="122"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-linecap="round"
      marker-end="url(#g3-arr)"></line>
    <rect
      x="296"
      y="105"
      width="180"
      height="34"
      rx="8"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="386"
      y="128"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--ink)">{t.fnSort}</text
    >
    <line
      x1="486"
      y1="122"
      x2="556"
      y2="122"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-linecap="round"
      marker-end="url(#g3-arr)"></line>
    <rect
      x="566"
      y="105"
      width="140"
      height="34"
      rx="8"
      fill="var(--card)"
      stroke="var(--accent)"
      stroke-width="2"></rect>
    <text
      x="636"
      y="128"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="16"
      fill="var(--ink)">aet</text
    >
    <!-- row 2: remainders → 5 -->
    <text
      x="40"
      y="188"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--ink)">5 · 11 · 17</text
    >
    <line
      x1="210"
      y1="182"
      x2="286"
      y2="182"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-linecap="round"
      marker-end="url(#g3-arr)"></line>
    <rect
      x="296"
      y="165"
      width="180"
      height="34"
      rx="8"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="386"
      y="188"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--ink)">{t.fnMod}</text
    >
    <line
      x1="486"
      y1="182"
      x2="556"
      y2="182"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-linecap="round"
      marker-end="url(#g3-arr)"></line>
    <rect
      x="566"
      y="165"
      width="140"
      height="34"
      rx="8"
      fill="var(--card)"
      stroke="var(--accent)"
      stroke-width="2"></rect>
    <text
      x="636"
      y="188"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="16"
      fill="var(--ink)">5</text
    >
    <!-- row 3: initials → a -->
    <text
      x="40"
      y="248"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--ink)">apple · apricot</text
    >
    <line
      x1="210"
      y1="242"
      x2="286"
      y2="242"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-linecap="round"
      marker-end="url(#g3-arr)"></line>
    <rect
      x="296"
      y="225"
      width="180"
      height="34"
      rx="8"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="386"
      y="248"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--ink)">{t.fnFirst}</text
    >
    <line
      x1="486"
      y1="242"
      x2="556"
      y2="242"
      stroke="var(--muted)"
      stroke-width="2"
      stroke-linecap="round"
      marker-end="url(#g3-arr)"></line>
    <rect
      x="566"
      y="225"
      width="140"
      height="34"
      rx="8"
      fill="var(--card)"
      stroke="var(--accent)"
      stroke-width="2"></rect>
    <text
      x="636"
      y="248"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="16"
      fill="var(--ink)">a</text
    >
  </svg>
  <figcaption class="text-center">{t.caption}</figcaption>
</figure>
