---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Set, get and delete each cost one hash plus one jump, O(1) average, paid for with extra memory",
    headline: "ONE HASH + ONE JUMP — EVERY OPERATION",
    ops: ["set — store", "get — lookup", "delete — remove"],
    each: "hash + jump · O(1)",
    buckets: "backing array · 4 buckets (spare capacity)",
    foot: "takeaway: hashing replaces scanning with arithmetic — memory buys speed",
    caption: "Add, lookup and delete share one shape: compute the index, go there directly. The spare buckets cost memory and keep O(1) reliable.",
  },
  ru: {
    svgTitle: "Set, get и delete стоят один хеш плюс один прыжок, O(1) в среднем, оплачено дополнительной памятью",
    headline: "ОДИН ХЕШ + ОДИН ПРЫЖОК — КАЖДАЯ ОПЕРАЦИЯ",
    ops: ["set — положить", "get — найти", "delete — убрать"],
    each: "хеш + прыжок · O(1)",
    buckets: "backing-массив · 4 ведра (с запасом)",
    foot: "вывод: хеширование заменяет скольжение арифметикой — память покупает скорость",
    caption: "Добавление, поиск и удаление имеют одну форму: вычисли индекс, иди туда напрямую. Запасные вёдра стоят памяти и держат O(1) надёжным.",
  },
};

const t = dict[lang];
const boxX = [40, 290, 540];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 300" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="25" fill="var(--ink)">{t.headline}</text>

    {t.ops.map((op, i) => (
      <g>
        <rect x={boxX[i]} y="56" width="220" height="72" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={boxX[i] + 20} y="86" font-size="14" fill="var(--ink)">{op}</text>
        <text x={boxX[i] + 20} y="110" font-size="13" fill="var(--accent)">{t.each}</text>
        <path d={`M ${boxX[i] + 110} 132 L ${boxX[i] + 110} 158`} stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
        <polygon points={`${boxX[i] + 104},158 ${boxX[i] + 116},158 ${boxX[i] + 110},168`} fill="var(--accent)" />
      </g>
    ))}

    <rect x="40" y="172" width="720" height="52" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    {[0, 1, 2, 3].map((b) => (
      <g>
        <line x1={40 + (b + 1) * 180} y1="172" x2={40 + (b + 1) * 180} y2="224" stroke="var(--ink)" stroke-width="2" />
        <text x={40 + b * 180 + 90} y="203" text-anchor="middle" font-size="13" fill="var(--muted)">{b}</text>
      </g>
    ))}
    <text x="400" y="252" text-anchor="middle" font-size="13" fill="var(--muted)">{t.buckets}</text>
    <text x="400" y="278" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
