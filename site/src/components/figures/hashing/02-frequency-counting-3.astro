---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "listen and silent share the same frequency map so they are anagrams, hello and world do not",
    headline: "SAME FREQUENCIES → ANAGRAM",
    formula: "count s, decrement t — all zeros means anagram",
    cost: "O(n) time · O(k) space",
    same: "same frequencies",
    different: "different frequencies",
    trueLabel: "true",
    falseLabel: "false",
    rowYes: "listen ↔ silent",
    rowNo: "hello ↔ world",
    band: "count first in one pass, then every follow-up is a lookup",
    caption:
      "“listen” and “silent” share the same character frequencies, so the check returns true; “hello” and “world” do not, so it returns false. Both answers read the finished map.",
  },
  ru: {
    svgTitle: "listen и silent делят одну карту частоты и это анаграммы, hello и world — нет",
    headline: "ОДИНАКОВЫЕ ЧАСТОТЫ → АНАГРАММА",
    formula: "посчитай s, вычти t — все нули значит анаграмма",
    cost: "O(n) времени · O(k) памяти",
    same: "частоты совпали",
    different: "частоты разошлись",
    trueLabel: "true",
    falseLabel: "false",
    rowYes: "listen ↔ silent",
    rowNo: "hello ↔ world",
    band: "сначала считай за проход, потом каждый вопрос — это lookup",
    caption:
      "«listen» и «silent» делят одинаковые частоты символов, поэтому проверка возвращает true; «hello» и «world» — нет, поэтому false. Оба ответа читают готовую карту.",
  },
};

const t = dict[lang];

const sharedKeys = ["l", "i", "s", "t", "e", "n"];
const sharedX = [120, 210, 300, 390, 480, 570];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <text x="400" y="36" text-anchor="middle" font-family="var(--font-display)" font-size="25" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="62" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="84" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>

    <!-- matching pair -->
    <rect x="60" y="104" width="170" height="44" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="145" y="132" text-anchor="middle" font-size="16" fill="var(--ink)">listen</text>
    <rect x="570" y="104" width="170" height="44" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="655" y="132" text-anchor="middle" font-size="16" fill="var(--ink)">silent</text>
    <text x="400" y="122" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rowYes}</text>
    <text x="400" y="142" text-anchor="middle" font-size="13" fill="var(--accent)">= {t.trueLabel} · {t.same}</text>
    <line x1="238" y1="126" x2="300" y2="180" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
    <line x1="562" y1="126" x2="500" y2="180" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />

    {sharedKeys.map((k, i) => (
      <g>
        <rect x={sharedX[i] - 38} y="186" width="76" height="60" rx="8" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={sharedX[i]} y="210" text-anchor="middle" font-size="15" fill="var(--ink)">{k}</text>
        <text x={sharedX[i]} y="232" text-anchor="middle" font-size="14" fill="var(--muted)">→1</text>
      </g>
    ))}

    <!-- mismatching pair -->
    <rect x="60" y="262" width="170" height="44" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="145" y="290" text-anchor="middle" font-size="16" fill="var(--ink)">hello</text>
    <rect x="570" y="262" width="170" height="44" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="655" y="290" text-anchor="middle" font-size="16" fill="var(--ink)">world</text>
    <text x="400" y="280" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rowNo}</text>
    <text x="400" y="300" text-anchor="middle" font-size="13" fill="var(--muted)">≠ {t.falseLabel} · {t.different}</text>
    <line x1="238" y1="284" x2="330" y2="330" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 4" />
    <line x1="562" y1="284" x2="470" y2="330" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 4" />
    <rect x="250" y="322" width="300" height="40" rx="8" fill="none" stroke="var(--muted)" stroke-width="2" stroke-dasharray="5 4" />
    <text x="400" y="347" text-anchor="middle" font-size="13" fill="var(--muted)">h→1 e→1 l→2 o→1 ✕ w r d</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.band}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
