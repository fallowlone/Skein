---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Check-then-add: 9 arrives, complement 5 is looked up in seen set {5, 2, 11} and hits",
    headline: "CHECK FIRST, THEN ADD",
    formula: "seen = {5, 2, 11} · x = 9 · comp = 14 − 9 = 5",
    compShort: "comp",
    cost: "seen.has(5) → HIT · O(1) lookup",
    incoming: "incoming x = 9",
    setTitle: "the seen set (the past)",
    ask: "9 asks: is 5 in the set?",
    yes: "YES — return [5, 9]",
    rule: "rule: ask about the complement BEFORE joining the set",
    caption: "9 never checks itself — it checks its complement 5 against the past. The set holds exactly {5, 2, 11}; the O(1) hit ends the scan with 5 + 9 = 14.",
  },
  ru: {
    svgTitle: "Сначала проверь, потом добавь: приходит 9, дополнение 5 ищется во видел {5, 2, 11} и находится",
    headline: "СНАЧАЛА ПРОВЕРЬ, ПОТОМ ДОБАВЬ",
    formula: "видел = {5, 2, 11} · x = 9 · доп = 14 − 9 = 5",
    compShort: "доп",
    cost: "seen.has(5) → ЕСТЬ · O(1)-поиск",
    incoming: "входящий x = 9",
    setTitle: "множество видел (прошлое)",
    ask: "9 спрашивает: есть ли 5 во множестве?",
    yes: "ДА — вернуть [5, 9]",
    rule: "правило: спроси про дополнение ДО вступления во множество",
    caption: "9 проверяет не себя, а своё дополнение 5 против прошлого. Множество держит ровно {5, 2, 11}; O(1)-попадание завершает скан: 5 + 9 = 14.",
  },
};

const t = dict[lang];

const members = ["5", "2", "11"];
const memberX = [340, 440, 540];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="25" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="82" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>

    <g>
      <rect x="60" y="150" width="150" height="90" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="135" y="178" text-anchor="middle" font-size="12" fill="var(--muted)">{t.incoming}</text>
      <text x="135" y="210" text-anchor="middle" font-size="28" fill="var(--ink)">9</text>
    </g>

    <text x="400" y="140" text-anchor="middle" font-size="13" fill="var(--muted)">{t.setTitle}</text>
    {members.map((m, i) => (
      <g>
        <rect x={memberX[i] - 42} y="156" width="84" height="84" rx="10" fill="var(--card)" stroke={m === "5" ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={memberX[i]} y="207" text-anchor="middle" font-size="26" fill="var(--ink)">{m}</text>
      </g>
    ))}

    <g>
      <path d="M 210 195 C 262 195, 262 176, 296 179" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <polygon points="296,173 296,185 308,179" fill="var(--accent)" />
      <text x="253" y="168" text-anchor="middle" font-size="12" fill="var(--accent)">{t.compShort} 5</text>
    </g>

    <g>
      <rect x="220" y="262" width="360" height="52" rx="10" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="284" text-anchor="middle" font-size="13" fill="var(--ink)">{t.ask}</text>
      <text x="400" y="304" text-anchor="middle" font-size="14" fill="var(--accent)">{t.yes}</text>
    </g>

    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rule}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">seen.has(complement) → return [complement, num]</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
