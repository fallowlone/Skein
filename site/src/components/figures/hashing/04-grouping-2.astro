---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Hash map buckets holding anagram groups as lists",
    headline: "THE MAP HOLDS KEY → LIST",
    sub: "map[key].push(item) — grouping answers which ones",
    inputLabel: "INPUT",
    result: '→ [["eat", "tea", "ate"], ["tan", "nat"]]',
    contrast: "frequency: map[key] is a count · grouping: map[key] is a list",
    caption:
      "The map holds key → list: aet maps to [eat, tea, ate], ant maps to [tan, nat]. Grouping answers which ones, not how many.",
  },
  ru: {
    svgTitle: "Ведра хеш-карты держат группы анаграмм как списки",
    headline: "СЛОВАРЬ ДЕРЖИТ КЛЮЧ → СПИСОК",
    sub: "map[key].push(item) — группировка отвечает какие",
    inputLabel: "ВХОД",
    result: '→ [["eat", "tea", "ate"], ["tan", "nat"]]',
    contrast: "частота: map[key] — это счёт · группировка: map[key] — это список",
    caption:
      "Словарь держит ключ → список: aet отображает на [eat, tea, ate], ant — на [tan, nat]. Группировка отвечает какие, а не сколько.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <defs>
      <marker
        id="g2-arr"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text
      x="40"
      y="46"
      font-family="var(--font-display)"
      font-size="25"
      fill="var(--ink)">{t.headline}</text
    >
    <text
      x="40"
      y="74"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--muted)">{t.sub}</text
    >
    <text
      x="60"
      y="108"
      font-family="var(--font-mono)"
      font-size="12"
      fill="var(--muted)">{t.inputLabel}</text
    >
    <!-- input chips -->
    <rect
      x="60"
      y="116"
      width="118"
      height="32"
      rx="8"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="119"
      y="138"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--ink)">eat</text
    >
    <rect
