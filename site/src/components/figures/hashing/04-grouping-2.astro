      width="118"
      height="32"
      rx="8"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="249"
      y="138"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
      fill="var(--ink)">tea</text
    >
    <rect
      x="320"
      y="116"
      width="118"
      height="32"
      rx="8"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="379"
      y="138"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="15"
