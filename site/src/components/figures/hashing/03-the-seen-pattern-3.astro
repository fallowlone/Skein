---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "One shape, five problems: two-sum, duplicates, intersection, first repeat, visited nodes all ask seen",
    headline: "ONE SHAPE, FIVE PROBLEMS",
    formula: "store as you go · check as you go",
    cost: "one pass · O(1) checks · O(n) time",
    rows: [
      { q: "two-sum", ask: "seen the complement?", ex: "[5,2,11,9] t=14 → 5+9" },
      { q: "duplicate?", ask: "seen this value?", ex: "[1,2,3,2,4] → 2" },
      { q: "intersection", ask: "seen in 1st array?", ex: "[1,2,2,1] ∩ [2,2] → 2" },
      { q: "first repeat", ask: "seen this before?", ex: "return it at once" },
      { q: "cycle?", ask: "visited this node?", ex: "node seen → cycle" },
    ],
    answer: "spot the question → reach for a set",
    caption: "Two-sum, duplicates, intersection, first repeat, and cycle detection are the same question in different clothing: does something seen match the current element?",
  },
  ru: {
    svgTitle: "Одна форма, пять задач: two-sum, дубликаты, пересечение, первый повтор, посещённые узлы — всё спрашивает видел",
    headline: "ОДНА ФОРМА, ПЯТЬ ЗАДАЧ",
    formula: "храни по дороге · проверяй по дороге",
    cost: "один проход · O(1)-проверки · O(n) время",
    rows: [
      { q: "two-sum", ask: "видел дополнение?", ex: "[5,2,11,9] t=14 → 5+9" },
      { q: "дубликат?", ask: "видел это значение?", ex: "[1,2,3,2,4] → 2" },
      { q: "пересечение", ask: "видел в 1-м массиве?", ex: "[1,2,2,1] ∩ [2,2] → 2" },
      { q: "первый повтор", ask: "видел это раньше?", ex: "вернуть его сразу" },
      { q: "цикл?", ask: "посещал этот узел?", ex: "узел виден → цикл" },
    ],
    answer: "узнал вопрос → бери множество",
    caption: "Two-sum, дубликаты, пересечение, первый повтор и обнаружение цикла — один вопрос в разной упаковке: совпадает ли виденное с текущим элементом?",
  },
};

const t = dict[lang];

const rowY = [122, 176, 230, 284, 338];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="25" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="82" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>

    {t.rows.map((r, i) => (
      <g>
        <rect x="90" y={rowY[i] - 22} width="220" height="44" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="110" y={rowY[i] + 5} font-size="14" fill="var(--ink)">{r.q}</text>
        <path d={`M 318 ${rowY[i]} L 372 ${rowY[i]}`} fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <polygon points={`372,${rowY[i] - 6} 372,${rowY[i] + 6} 384,${rowY[i]}`} fill="var(--accent)" />
        <rect x="392" y={rowY[i] - 22} width="318" height="44" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="410" y={rowY[i] - 2} font-size="13" fill="var(--ink)">{r.ask}</text>
        <text x="410" y={rowY[i] + 15} font-size="11" fill="var(--muted)">{r.ex}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--accent)">{t.answer}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
