---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;

const dict = {
  en: {
    svgTitle: "Hash keys fall into buckets: Alice to 2, Bob to 0, Eve to 3, Max to 1",
    headline: "COMPUTE THE INDEX, JUMP TO IT",
    formula: "hash(key) % 4 → bucket index",
    cost: "one formula + one jump · O(1)",
    bucket: "bucket",
    note: "same key → same index → same bucket",
    caption: "Each key hashes to exactly one bucket — lookup re-hashes the same key and jumps straight there. No scanning.",
  },
  ru: {
    svgTitle: "Ключи падают в вёдра: Alice в 2, Bob в 0, Eve в 3, Max в 1",
    headline: "ВЫЧИСЛИ ИНДЕКС, ПРЫГНИ К НЕМУ",
    formula: "hash(key) % 4 → индекс ведра",
    cost: "одна формула + один прыжок · O(1)",
    bucket: "ведро",
    note: "тот же ключ → тот же индекс → то же ведро",
    caption: "Каждый ключ хешируется ровно в одно ведро — поиск перехеширует тот же ключ и прыгает прямо туда. Без скольжения.",
  },
};

const t = dict[lang];

// Key rows (top to bottom) and the bucket index each key hashes to.
const keys = [
  { name: "Alice", h: "h=2", to: 2 },
  { name: "Bob", h: "h=0", to: 0 },
  { name: "Eve", h: "h=3", to: 3 },
  { name: "Max", h: "h=1", to: 1 },
];

const rowY = [130, 195, 260, 325];
const bucketY = [130, 195, 260, 325];
const occupant = ["Bob", "Max", "Alice", "Eve"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="25" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>
    <text x="400" y="82" text-anchor="middle" font-size="13" fill="var(--accent)">{t.cost}</text>

    {keys.map((k, i) => (
      <g>
        <rect x="60" y={rowY[i] - 22} width="180" height="44" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="78" y={rowY[i] + 5} font-size="14" fill="var(--ink)">{k.name}</text>
        <text x="224" y={rowY[i] + 5} text-anchor="end" font-size="13" fill="var(--muted)">{k.h}</text>
      </g>
    ))}

    {occupant.map((name, b) => (
      <g>
        <rect x="500" y={bucketY[b] - 22} width="220" height="44" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="520" y={bucketY[b] + 5} font-size="14" fill="var(--ink)">{t.bucket} {b} · {name}</text>
      </g>
    ))}

    {keys.map((k, i) => (
      <g>
        <path
          d={`M 248 ${rowY[i]} C 374 ${rowY[i]}, 374 ${bucketY[k.to]}, 492 ${bucketY[k.to]}`}
          fill="none"
          stroke="var(--accent)"
          stroke-width="2"
          stroke-linecap="round"
        />
        <polygon points={`492,${bucketY[k.to] - 6} 492,${bucketY[k.to] + 6} 504,${bucketY[k.to]}`} fill="var(--accent)" />
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
