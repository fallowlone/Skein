---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Load factor sets chain length and lookup cost",
    headline: "LOAD FACTOR RUNS THE SHOW",
    formula: "α = items ÷ buckets · lookup O(1 + α)",
    caseA: "10 items / 20 buckets",
    alphaA: "α = 0.5",
    costA: "short chains → O(1)",
    dotsA: "· · · 20 buckets",
    dotsB: "· · · 2 buckets",
    caseB: "10 items / 2 buckets",
    alphaB: "α = 5",
    costB: "long chains → O(1 + 5)",
    rule: "keep α ≤ 0.75 → O(1) average",
    caption:
      "Load factor α is the average chain length: 10 items over 20 buckets stay short, 10 over 2 crowd into long chains. Keep α at or below 0.75 and lookup stays O(1) average.",
  },
  ru: {
    svgTitle: "Коэффициент заполнения задаёт длину цепи и стоимость поиска",
    headline: "КОЭФФИЦИЕНТ ЗАПОЛНЕНИЯ РУЛИТ",
    formula: "α = элементы ÷ вёдра · поиск O(1 + α)",
    caseA: "10 элементов / 20 вёдер",
    alphaA: "α = 0.5",
    costA: "короткие цепи → O(1)",
    dotsA: "· · · 20 вёдер",
    dotsB: "· · · 2 ведра",
    caseB: "10 элементов / 2 ведра",
    alphaB: "α = 5",
    costB: "длинные цепи → O(1 + 5)",
    rule: "держи α ≤ 0.75 → O(1) в среднем",
    caption:
      "Коэффициент α — это средняя длина цепочки: 10 элементов на 20 вёдер дают короткие цепи, 10 на 2 — скученные длинные цепи. Держи α не выше 0.75, и поиск останется O(1) в среднем.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" width="100%">
    <title>{dict.en.svgTitle} / {dict.ru.svgTitle}</title>
    <defs>
      <marker
        id="c2-arr"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text
      x="40"
      y="46"
      font-family="var(--font-display)"
      font-size="25"
      fill="var(--ink)">{t.headline}</text
    >
    <text
      x="40"
      y="74"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--muted)">{t.formula}</text
    >
    <!-- left panel: sparse -->
    <rect
      x="40"
      y="100"
      width="330"
      height="230"
      rx="12"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="66"
      y="132"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.caseA}</text
    >
    <text
      x="66"
      y="160"
      font-family="var(--font-mono)"
      font-size="20"
      fill="var(--ink)">{t.alphaA}</text
    >
    <!-- sparse buckets: 4 mini buckets, single dots -->
    <rect
      x="66"
      y="182"
      width="60"
      height="60"
      rx="8"
      fill="none"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <circle cx="96" cy="212" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <rect
      x="140"
      y="182"
      width="60"
      height="60"
      rx="8"
      fill="none"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <circle cx="170" cy="212" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <rect
      x="214"
      y="182"
      width="60"
      height="60"
      rx="8"
      fill="none"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <circle cx="244" cy="212" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <rect
      x="288"
      y="182"
      width="60"
      height="60"
      rx="8"
      fill="none"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="318"
      y="218"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">∅</text
    >
    <text
      x="66"
      y="272"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.dotsA}</text
    >
    <text
      x="66"
      y="304"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--accent)">{t.costA}</text
    >
    <!-- right panel: crowded -->
    <rect
      x="430"
      y="100"
      width="330"
      height="230"
      rx="12"
      fill="var(--card)"
      stroke="var(--ink)"
      stroke-width="2"></rect>
    <text
      x="456"
      y="132"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.caseB}</text
    >
    <text
      x="456"
      y="160"
      font-family="var(--font-mono)"
      font-size="20"
      fill="var(--ink)">{t.alphaB}</text
    >
    <!-- crowded buckets: 2 buckets with 5 stacked dots each -->
    <rect
      x="456"
      y="182"
      width="120"
      height="60"
      rx="8"
      fill="none"
      stroke="var(--accent)"
      stroke-width="2"></rect>
    <circle cx="482" cy="212" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <circle cx="506" cy="212" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <circle cx="530" cy="212" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <text x="552" y="218" font-family="var(--font-mono)" font-size="13" fill="var(--accent)">+2</text>
    <rect
      x="592"
      y="182"
      width="120"
      height="60"
      rx="8"
      fill="none"
      stroke="var(--accent)"
      stroke-width="2"></rect>
    <circle cx="618" cy="212" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <circle cx="642" cy="212" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <circle cx="666" cy="212" r="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2"></circle>
    <text x="688" y="218" font-family="var(--font-mono)" font-size="13" fill="var(--accent)">+2</text>
    <text
      x="456"
      y="272"
      font-family="var(--font-mono)"
      font-size="13"
      fill="var(--muted)">{t.dotsB}</text
    >
    <text
      x="456"
      y="304"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--accent)">{t.costB}</text
    >
    <text
      x="400"
      y="380"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="14"
      fill="var(--accent)">{t.rule}</text
    >
  </svg>
  <figcaption class="text-center">{t.caption}</figcaption>
</figure>
