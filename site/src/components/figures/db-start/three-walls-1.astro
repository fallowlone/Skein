---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three walls: memory loses Alice on restart, files read every byte and lose links, the database does all three",
    headline: "THREE WALLS, ONE ANSWER",
    sub: "memory vs files vs a database",
    code: "id = 1 · name = Alice",
    colMem: "MEMORY",
    colFiles: "FILES",
    colDb: "DATABASE",
    walls: ["survives restart", "find by name", "links hold"],
    memV: ["gone", "—", "—"],
    fileV: ["yes", "reads every byte", "orphans"],
    dbV: ["yes", "milliseconds", "no orphans"],
    foot: "structured, durable, queryable storage",
    caption:
      "Memory loses Alice on restart; files keep her but read every byte to find her and let links rot into orphans. A database is structured, durable, queryable storage — it does all three at once.",
  },
  ru: {
    svgTitle: "Три стены: память теряет Алису при перезапуске, файлы читают каждый байт и теряют связи, база делает все три",
    headline: "ТРИ СТЕНЫ — ОДИН ОТВЕТ",
    sub: "память, файлы и база данных",
    code: "id = 1 · name = Alice",
    colMem: "ПАМЯТЬ",
    colFiles: "ФАЙЛЫ",
    colDb: "БАЗА ДАННЫХ",
    walls: ["переживает рестарт", "поиск по имени", "связи целы"],
    memV: ["пропало", "—", "—"],
    fileV: ["да", "читает все байты", "сироты"],
    dbV: ["да", "миллисекунды", "без сирот"],
    foot: "структурированное, надёжное, запрашиваемое хранилище",
    caption:
      "Память теряет Алису при перезапуске; файлы хранят её, но читают каждый байт ради поиска и плодят сирот в связях. База данных — структурированное, надёжное, запрашиваемое хранилище: все три стены сразу.",
  },
};

const t = dict[lang];

const rowY = [166, 220, 274];
const rowH = 46;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="270" y="76" width="260" height="30" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="96" text-anchor="middle" font-size="11" fill="var(--ink)">{t.code}</text>

    <rect x="226" y="118" width="176" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <rect x="410" y="118" width="176" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <rect x="594" y="118" width="176" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="314" y="143" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colMem}</text>
    <text x="498" y="143" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colFiles}</text>
    <text x="682" y="143" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colDb}</text>

    {t.walls.map((w, i) => (
      <g>
        <rect x="30" y={rowY[i]} width="180" height={rowH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="120" y={rowY[i] + 29} text-anchor="middle" font-size="11" fill="var(--muted)">{w}</text>
      </g>
    ))}
    {t.memV.map((v, i) => (
      <g>
        <rect x="226" y={rowY[i]} width="176" height={rowH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="314" y={rowY[i] + 29} text-anchor="middle" font-size="12" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {t.fileV.map((v, i) => (
      <g>
        <rect x="410" y={rowY[i]} width="176" height={rowH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="498" y={rowY[i] + 29} text-anchor="middle" font-size="12" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {t.dbV.map((v, i) => (
      <g>
        <rect x="594" y={rowY[i]} width="176" height={rowH} fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
        <text x="682" y={rowY[i] + 29} text-anchor="middle" font-size="12" fill="var(--accent)">{v}</text>
      </g>
    ))}

    <text x="400" y="356" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
