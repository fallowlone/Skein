---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Fast and correct: the B-tree index jumps to the row in milliseconds, the transaction moves money all-or-nothing",
    headline: "FAST AND CORRECT",
    sub: "an index jumps to the row · a transaction moves money all-or-nothing",
    idxTitle: "INDEX · a B-tree shortcut",
    scanLine: "scan: reads the entire table",
    jumpLine: "index jumps to the row",
    msLine: "· milliseconds",
    txnTitle: "TRANSACTION · all or nothing",
    accA: "account A",
    accB: "account B",
    commitLine: "all succeed → money moved",
    crashLine: "crash mid-way → nothing moved",
    txnNote: "only leaves A if it arrives in B",
    foot: "speed from the index · correctness from the transaction",
    caption:
      "An index is a B-tree shortcut that jumps to row id = 1 in milliseconds instead of scanning the table; a transaction moves money all-or-nothing so a crash can never leave it half-moved.",
  },
  ru: {
    svgTitle: "Быстро и корректно: B-tree-индекс прыгает к строке за миллисекунды, транзакция двигает деньги по принципу «всё или ничего»",
    headline: "БЫСТРО И КОРРЕКТНО",
    sub: "индекс прыгает к строке · транзакция двигает деньги по принципу «всё или ничего»",
    idxTitle: "ИНДЕКС · B-tree-ярлык",
    scanLine: "скан: читает всю таблицу",
    jumpLine: "индекс прыгает к строке",
    msLine: "· миллисекунды",
    txnTitle: "ТРАНЗАКЦИЯ · всё или ничего",
    accA: "счёт A",
    accB: "счёт B",
    commitLine: "всё успешно → деньги переведены",
    crashLine: "сбой посередине → ничего не изменено",
    txnNote: "уходит со счёта, только если приходит на другой",
    foot: "скорость — от индекса · корректность — от транзакции",
    caption:
      "Индекс — это B-tree-ярлык, прыгающий к строке id = 1 за миллисекунды вместо сканирования таблицы; транзакция двигает деньги по принципу «всё или ничего», так что сбой не оставит их наполовину переведёнными.",
  },
};

const t = dict[lang];

const cellX = [64, 126, 188, 250, 312];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbstart-fast-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
      <marker id="dbstart-fast-dim" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--muted)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="350" height="216" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="215" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.idxTitle}</text>
    {cellX.map((cx, i) => (
      <g>
        <rect x={cx} y="140" width="52" height="32" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={cx + 26} y="162" text-anchor="middle" font-size="14" fill="var(--muted)">·</text>
        <rect x={cx} y="222" width="52" height="32" fill="var(--paper)" stroke={i === 2 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 2 ? 2.5 : 1.5} />
        <text x={cx + 26} y="245" text-anchor="middle" font-size="14" fill="var(--ink)">{i === 2 ? "1" : "·"}</text>
      </g>
    ))}
    <line x1="64" y1="190" x2="356" y2="190" stroke="var(--muted)" stroke-width="2" marker-end="url(#dbstart-fast-dim)" />
    <text x="215" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.scanLine}</text>
    <path d="M 64 288 H 188 V 238" fill="none" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbstart-fast-arrow)" />
    <text x="210" y="284" font-size="12" fill="var(--ink)">{t.jumpLine}</text>
    <text x="210" y="304" font-size="12" fill="var(--accent)">{t.msLine}</text>

    <rect x="410" y="100" width="350" height="216" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="585" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.txnTitle}</text>
    <rect x="434" y="146" width="140" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <rect x="596" y="146" width="140" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="504" y="173" text-anchor="middle" font-size="12" fill="var(--ink)">{t.accA}</text>
    <text x="666" y="173" text-anchor="middle" font-size="12" fill="var(--ink)">{t.accB}</text>
    <line x1="574" y1="168" x2="595" y2="168" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbstart-fast-arrow)" />
    <rect x="434" y="206" width="302" height="84" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="585" y="232" text-anchor="middle" font-size="12" fill="var(--ink)">{t.commitLine}</text>
    <text x="585" y="258" text-anchor="middle" font-size="12" fill="var(--muted)">{t.crashLine}</text>
    <text x="585" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">{t.txnNote}</text>

    <text x="400" y="356" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
