---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Tables hold rows and keys link them: id names the user row, orders points back with a foreign key, orphans are refused",
    headline: "TABLES HOLD, KEYS LINK",
    sub: "one row, one record · a key names it, a key links it",
    usersTitle: "USERS · id is the primary key",
    uCols: ["id · PK", "name"],
    uVals: ["1", "Alice"],
    uMore: "···",
    uNote: "the primary key is unique for every row",
    ordersTitle: "ORDERS · user is the foreign key",
    oFk: ["order → 1", "order → ?"],
    oStatus: ["kept", "refused"],
    oNote: "? = no such user, so the order is refused",
    sql: "SELECT name FROM users WHERE id = 1",
    sqlSub: "any program asks without knowing the disk layout",
    caption:
      "Rows live in tables; id names each user row and the orders table points back at it with a foreign key. An order pointing at no user is refused — and any program can ask with SELECT without knowing the disk layout.",
  },
  ru: {
    svgTitle: "Таблицы хранят строки, ключи их связывают: id именует строку, orders ссылается внешним ключом, сироты отклоняются",
    headline: "ТАБЛИЦЫ ХРАНЯТ, КЛЮЧИ СВЯЗЫВАЮТ",
    sub: "строка — одна запись · ключ именует, ключ связывает",
    usersTitle: "USERS · id — первичный ключ",
    uCols: ["id · PK", "name"],
    uVals: ["1", "Alice"],
    uMore: "···",
    uNote: "первичный ключ уникален для каждой строки",
    ordersTitle: "ORDERS · user — внешний ключ",
    oFk: ["order → 1", "order → ?"],
    oStatus: ["принят", "отклонён"],
    oNote: "? = такого пользователя нет, заказ отклонён",
    sql: "SELECT name FROM users WHERE id = 1",
    sqlSub: "любая программа спрашивает, не зная устройства диска",
    caption:
      "Строки живут в таблицах; id именует каждую строку users, а таблица orders ссылается на неё внешним ключом. Заказ без пользователя отклоняется — а любая программа спрашивает через SELECT, не зная устройства диска.",
  },
};

const t = dict[lang];

const uCellX = [135, 245];
const oRowY = [140, 182];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbstart-keys-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="320" height="196" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="200" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.usersTitle}</text>
    <rect x="60" y="140" width="280" height="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    {t.uCols.map((c, i) => (
      <text x={uCellX[i]} y="162" text-anchor="middle" font-size="12" fill="var(--muted)">{c}</text>
    ))}
    <rect x="60" y="182" width="280" height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    {t.uVals.map((v, i) => (
      <text x={uCellX[i]} y="206" text-anchor="middle" font-size="12" fill="var(--ink)">{v}</text>
    ))}
    <text x="200" y="242" text-anchor="middle" font-size="16" fill="var(--muted)">{t.uMore}</text>
    <text x="200" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.uNote}</text>

    <line x1="360" y1="200" x2="439" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbstart-keys-arrow)" />

    <rect x="440" y="100" width="320" height="196" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="600" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.ordersTitle}</text>
    <rect x="460" y="140" width="280" height="36" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <rect x="460" y="182" width="280" height="36" fill="var(--paper)" stroke="var(--accent)" stroke-width="2.5" />
    {t.oFk.map((f, i) => (
      <text x="550" y={oRowY[i] + 24} text-anchor="middle" font-size="12" fill="var(--ink)">{f}</text>
    ))}
    {t.oStatus.map((s, i) => (
      <text x="672" y={oRowY[i] + 24} text-anchor="middle" font-size="12" fill={i === 1 ? "var(--accent)" : "var(--ink)"}>{s}</text>
    ))}
    <text x="600" y="250" text-anchor="middle" font-size="11" fill="var(--muted)">{t.oNote}</text>

    <rect x="140" y="312" width="520" height="48" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="334" text-anchor="middle" font-size="13" fill="var(--ink)">{t.sql}</text>
    <text x="400" y="354" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sqlSub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
