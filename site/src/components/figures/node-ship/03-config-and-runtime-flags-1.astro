---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One image SHA promotes dev to staging to prod; only the environment variables change, config is never baked into the image",
    headline: "ONE IMAGE · THREE ENVS · ONLY ENV CHANGES",
    sub: "twelve-factor: config lives in the environment, not the image",
    artifact1: "one image · SHA abc123",
    artifact2: "config NOT baked in",
    envNote: "only the env vars change",
    devName: "dev",
    stagName: "staging",
    prodName: "prod",
    devDb: "DATABASE_URL = dev",
    stagDb: "DATABASE_URL = staging",
    prodDb: "DATABASE_URL = prod",
    warn: "config.prod.json inside the image = different builds",
    caption:
      "The same image SHA promotes dev to staging to prod; only DATABASE_URL and other env vars change. Bake a config.prod.json into the image and the stages become different builds.",
  },
  ru: {
    svgTitle: "Один SHA образа продвигается из dev в staging и prod; меняются только переменные окружения, конфиг никогда не запекается в образ",
    headline: "ОДИН ОБРАЗ · ТРИ СРЕДЫ · МЕНЯЕТСЯ ТОЛЬКО ENV",
    sub: "twelve-factor: конфиг живёт в окружении, а не в образе",
    artifact1: "один образ · SHA abc123",
    artifact2: "конфиг НЕ запечён внутрь",
    envNote: "меняются только переменные окружения",
    devName: "dev",
    stagName: "staging",
    prodName: "prod",
    devDb: "DATABASE_URL = dev",
    stagDb: "DATABASE_URL = staging",
    prodDb: "DATABASE_URL = prod",
    warn: "config.prod.json внутри образа = разные сборки",
    caption:
      "Тот же SHA образа продвигается из dev в staging и prod; меняются только DATABASE_URL и другие переменные окружения. Запеки config.prod.json в образ — и стадии станут разными сборками.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nd7-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="86" width="680" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="110" text-anchor="middle" font-size="12" fill="var(--ink)">{t.artifact1}</text>
    <text x="400" y="132" text-anchor="middle" font-size="11" fill="var(--ink)">{t.artifact2}</text>

    <text x="400" y="170" text-anchor="middle" font-size="11" fill="var(--muted)">{t.envNote}</text>

    <line x1="140" y1="142" x2="140" y2="188" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd7-arrow)"></line>
    <line x1="400" y1="142" x2="400" y2="188" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd7-arrow)"></line>
    <line x1="660" y1="142" x2="660" y2="188" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd7-arrow)"></line>

    <rect x="40" y="192" width="200" height="96" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="140" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.devName}</text>
    <text x="140" y="258" text-anchor="middle" font-size="11" fill="var(--ink)">{t.devDb}</text>

    <rect x="300" y="192" width="200" height="96" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stagName}</text>
    <text x="400" y="258" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stagDb}</text>

    <rect x="560" y="192" width="200" height="96" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="660" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.prodName}</text>
    <text x="660" y="258" text-anchor="middle" font-size="11" fill="var(--ink)">{t.prodDb}</text>

    <text x="400" y="336" text-anchor="middle" font-size="11" fill="var(--muted)">{t.warn}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
