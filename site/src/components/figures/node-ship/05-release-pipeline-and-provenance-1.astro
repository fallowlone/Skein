---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Release pipeline gates: conventional commit, computed version, prepublishOnly build, dry-run tarball check, publish with provenance, dist-tag routing, caret-range resolution",
    headline: "GATES BEFORE PUBLISH: NOTHING IS REVERSIBLE",
    sub: "a safe automated release from commit to resolvable version",
    boxA1: "conventional commit",
    boxA2: "fix: / feat:",
    boxB1: "build + test",
    boxB2: "prepublishOnly",
    boxC1: "dry-run gate",
    boxC2: "total files: 4",
    boxD1: "npm publish",
    boxD2: "--provenance · OIDC",
    boxE1: "dist-tag",
    boxE2: "latest / next / legacy",
    boxF1: "consumers resolve",
    boxF2: "^ range",
    gate1: "build",
    gate2: "pack",
    gateMid: "verified",
    gate3: "route",
    gate4: "install",
    foot1: "dry-run: entry from main present · total files: 4 · package size 4.8 kB",
    foot2: "after publish: only deprecate + moved dist-tag — unpublish dies at 72 h",
    caption:
      "A conventional commit drives the computed version; a dry-run proves the tarball before upload; provenance signs the build; the dist-tag decides who resolves it — every gate exists because publish is irreversible.",
  },
  ru: {
    svgTitle: "Гейты релизного конвейера: conventional-коммит, вычисленная версия, сборка prepublishOnly, проверка тарбола dry-run, публикация с provenance, маршрутизация dist-tag, разрешение caret-диапазона",
    headline: "ГЕЙТЫ ДО PUBLISH: НИЧЕГО НЕ ОТКАТИТЬ",
    sub: "безопасный автоматический релиз: от коммита до разрешаемой версии",
    boxA1: "conventional commit",
    boxA2: "fix: / feat:",
    boxB1: "сборка и тесты",
    boxB2: "prepublishOnly",
    boxC1: "гейт dry-run",
    boxC2: "total files: 4",
    boxD1: "npm publish",
    boxD2: "--provenance · OIDC",
    boxE1: "dist-tag",
    boxE2: "latest / next / legacy",
    boxF1: "потребители разрешают",
    boxF2: "^ диапазон",
    gate1: "сборка",
    gate2: "пакует",
    gateMid: "проверено",
    gate3: "маршрут",
    gate4: "install",
    foot1: "dry-run: точка входа из main на месте · total files: 4 · package size 4.8 kB",
    foot2: "после publish: только deprecate и сдвиг dist-tag — unpublish умрёт через 72 ч",
    caption:
      "Conventional-коммит задаёт вычисленную версию; dry-run доказывает содержимое тарбола до загрузки; provenance подписывает сборку; dist-tag решает, кто её разрешит — каждый гейт существует потому, что publish необратим.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nd13-dim" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--muted)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="15" y="100" width="190" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="110" y="130" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxA1}</text>
    <text x="110" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxA2}</text>

    <rect x="305" y="100" width="190" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="130" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxB1}</text>
    <text x="400" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxB2}</text>

    <rect x="595" y="100" width="190" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="690" y="130" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxC1}</text>
    <text x="690" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxC2}</text>

    <line x1="205" y1="136" x2="297" y2="136" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd13-dim)" />
    <text x="255" y="127" text-anchor="middle" font-size="10" fill="var(--muted)">{t.gate1}</text>
    <line x1="495" y1="136" x2="587" y2="136" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd13-dim)" />
    <text x="545" y="127" text-anchor="middle" font-size="10" fill="var(--muted)">{t.gate2}</text>

    <path d="M690 172V206H110V231" fill="none" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd13-dim)" />
    <text x="400" y="198" text-anchor="middle" font-size="10" fill="var(--muted)">{t.gateMid}</text>

    <rect x="15" y="240" width="190" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="110" y="270" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxD1}</text>
    <text x="110" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxD2}</text>

    <rect x="305" y="240" width="190" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="270" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxE1}</text>
    <text x="400" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxE2}</text>

    <rect x="595" y="240" width="190" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="690" y="270" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxF1}</text>
    <text x="690" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxF2}</text>

    <line x1="205" y1="276" x2="297" y2="276" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd13-dim)" />
    <text x="255" y="267" text-anchor="middle" font-size="10" fill="var(--muted)">{t.gate3}</text>
    <line x1="495" y1="276" x2="587" y2="276" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd13-dim)" />
    <text x="545" y="267" text-anchor="middle" font-size="10" fill="var(--muted)">{t.gate4}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="376" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
