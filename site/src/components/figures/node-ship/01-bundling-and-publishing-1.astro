---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Dual-package tradeoff: ESM-only gives one module instance with working instanceof and single singletons, while dual-publishing ESM plus CJS gives two instances, broken instanceof, and duplicated module state",
    headline: "ONE PACKAGE, ONE INSTANCE — OR TWO",
    sub: "the dual-package hazard",
    colEsm: "ESM-only",
    colDual: "dual ESM + CJS",
    e1: "1 module instance",
    e2: "instanceof works",
    e3: "singletons stay single",
    e4: "lose pure-CJS consumers",
    d1: "2 module instances",
    d2: "instanceof breaks",
    d3: "module state duplicated",
    d4: "fix: one internal CJS core",
    foot1: "two copies = two class identities, one cache becomes two",
    foot2: "new library? ship ESM-only",
    caption:
      "Dual-publishing ESM plus CJS loads two module instances, so instanceof breaks and module state is duplicated. ESM-only has exactly one instance, so the hazard cannot arise — the only cost is losing pure-CJS consumers.",
  },
  ru: {
    svgTitle: "Компромисс dual-публикации: ESM-only даёт один экземпляр модуля с рабочим instanceof и едиными синглтонами, а dual-публикация ESM плюс CJS даёт два экземпляра, сломанный instanceof и дублированное состояние модуля",
    headline: "ОДИН ПАКЕТ: ОДИН ЭКЗЕМПЛЯР — ИЛИ ДВА",
    sub: "dual-package hazard",
    colEsm: "ESM-only",
    colDual: "dual ESM + CJS",
    e1: "1 экземпляр модуля",
    e2: "instanceof работает",
    e3: "синглтоны едины",
    e4: "потеря чисто-CJS потребителей",
    d1: "2 экземпляра модуля",
    d2: "instanceof ломается",
    d3: "состояние модуля дублируется",
    d4: "фикс: одно внутреннее CJS-ядро",
    foot1: "две копии = две идентичности класса, один кэш станет двумя",
    foot2: "новая библиотека? выпускай ESM-only",
    caption:
      "Dual-публикация ESM плюс CJS загружает два экземпляра модуля, так что instanceof ломается, а состояние модуля дублируется. У ESM-only ровно один экземпляр, поэтому hazard не возникает, — единственная цена — потеря чисто-CJS потребителей.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nd1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="88" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colEsm}</text>
    <rect x="30" y="110" width="340" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="150" text-anchor="middle" font-size="11" fill="var(--ink)">{t.e1}</text>
    <text x="200" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.e2}</text>
    <text x="200" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.e3}</text>
    <text x="200" y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{t.e4}</text>

    <text x="600" y="88" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colDual}</text>
    <rect x="430" y="110" width="340" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="600" y="150" text-anchor="middle" font-size="11" fill="var(--ink)">{t.d1}</text>
    <text x="600" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.d2}</text>
    <text x="600" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.d3}</text>
    <text x="600" y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{t.d4}</text>

    <line x1="600" y1="280" x2="600" y2="302" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd1-arrow)" />

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
