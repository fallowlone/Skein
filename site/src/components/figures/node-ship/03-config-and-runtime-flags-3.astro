---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "V8 flags passed via NODE_OPTIONS are inherited by worker threads, child_process.fork, and spawned node children, while a flag on the CMD line reaches only the entrypoint process",
    headline: "NODE_OPTIONS REACHES THE WHOLE TREE",
    sub: "young gen default is about 16 MB — stay at 16–32 MB in 512 MB",
    optLine1: "NODE_OPTIONS=",
    optLine2: "--max-old-space-size=384",
    optLine3: "--max-semi-space-size=16",
    optLine4: "in image / manifest, not in code",
    inherit: "inherited",
    child1: "worker threads",
    child2: "child_process.fork",
    child3: "spawn node children",
    foot: "a flag on the CMD line reaches only the entrypoint",
    caption:
      "Put --max-old-space-size and --max-semi-space-size in NODE_OPTIONS so worker threads, forked children, and spawned node processes inherit the same budget. A flag on the CMD line is guaranteed only for the entrypoint.",
  },
  ru: {
    svgTitle: "V8-флаги через NODE_OPTIONS наследуются worker-потоками, child_process.fork и spawn'ами node, а флаг в строке CMD доходит только до процесса entrypoint",
    headline: "NODE_OPTIONS ДОХОДИТ ДО ВСЕГО ДЕРЕВА",
    sub: "молодое поколение ≈ 16 МБ — держи 16–32 МБ в 512 МБ",
    optLine1: "NODE_OPTIONS=",
    optLine2: "--max-old-space-size=384",
    optLine3: "--max-semi-space-size=16",
    optLine4: "в образе / манифесте, не в коде",
    inherit: "наследуется",
    child1: "worker-потоки",
    child2: "child_process.fork",
    child3: "spawn-дети node",
    foot: "флаг в строке CMD доходит только до entrypoint",
    caption:
      "Клади --max-old-space-size и --max-semi-space-size в NODE_OPTIONS, чтобы worker-потоки, форкнутые дети и spawn'ы node наследовали тот же бюджет. Флаг в строке CMD гарантирован только для entrypoint.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nd9-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="150" width="280" height="140" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.optLine1}</text>
    <text x="200" y="214" text-anchor="middle" font-size="11" fill="var(--ink)">{t.optLine2}</text>
    <text x="200" y="238" text-anchor="middle" font-size="11" fill="var(--ink)">{t.optLine3}</text>
    <text x="200" y="266" text-anchor="middle" font-size="10" fill="var(--ink)">{t.optLine4}</text>

    <line x1="340" y1="196" x2="476" y2="144" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd9-arrow)"></line>
    <line x1="340" y1="220" x2="476" y2="238" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd9-arrow)"></line>
    <line x1="340" y1="244" x2="476" y2="332" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd9-arrow)"></line>

    <text x="408" y="222" text-anchor="middle" font-size="10" fill="var(--muted)">{t.inherit}</text>

    <rect x="480" y="110" width="240" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.child1}</text>

    <rect x="480" y="206" width="240" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="244" text-anchor="middle" font-size="11" fill="var(--ink)">{t.child2}</text>

    <rect x="480" y="300" width="240" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="338" text-anchor="middle" font-size="11" fill="var(--ink)">{t.child3}</text>

    <text x="400" y="398" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
