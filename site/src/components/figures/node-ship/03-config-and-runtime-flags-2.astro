---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A 512 MB container limit splits into a 384 MB old-space heap at about 75 percent and 128 MB of headroom; matching the heap to 512 overruns the cgroup and OOMKills at exit 137 with no JS stack",
    headline: "512 MB LIMIT · 384 MB HEAP · 128 MB HEADROOM",
    sub: "the container limit covers the whole process, not just the heap",
    barLabel: "container limit 512 MB",
    heapLine1: "old-space 384 MB",
    heapLine2: "~75–80% of the limit",
    headLine: "headroom 128 MB",
    covers: "headroom: Buffers · C++ stacks · native · code · young gen",
    badTitle: "heap = 512 MB → OOMKill 137",
    badLine1: "RSS overruns the cgroup",
    badLine2: "no V8 error, no JS stack",
    goodTitle: "heap = 384 MB → clean OOM 134",
    goodLine1: "V8 GCs hard near the ceiling",
    goodLine2: "throws with a stack, not SIGKILL",
    foot: "non-cgroup-aware Node sizes the heap from the 32 GB host",
    caption:
      "Size old-space to ~75% of the 512 MB limit (384 MB) and keep 128 MB of headroom for Buffers, stacks, native, and the young generation. Match the heap to 512 and total RSS overruns the cgroup — OOMKilled at 137 with no JS stack.",
  },
  ru: {
    svgTitle: "Лимит контейнера 512 МБ делится на old-space кучу 384 МБ (около 75 процентов) и запас 128 МБ; куча в 512 перерастает cgroup и получает OOMKill с кодом 137 без JS-стека",
    headline: "ЛИМИТ 512 МБ · КУЧА 384 МБ · ЗАПАС 128 МБ",
    sub: "лимит покрывает весь процесс, а не только кучу",
    barLabel: "лимит контейнера 512 МБ",
    heapLine1: "old-space 384 МБ",
    heapLine2: "~75–80% от лимита",
    headLine: "запас 128 МБ",
    covers: "запас: Buffer'ы · C++-стеки · нативное · код · молодое",
    badTitle: "куча = 512 МБ → OOMKill 137",
    badLine1: "RSS перерастает cgroup",
    badLine2: "нет ошибки V8, нет JS-стека",
    goodTitle: "куча = 384 МБ → чистый OOM 134",
    goodLine1: "V8 жёстко делает GC у потолка",
    goodLine2: "бросает со стеком, а не SIGKILL",
    foot: "не-cgroup-aware Node считает кучу от хоста на 32 ГБ",
    caption:
      "Задай old-space в ~75% от лимита 512 МБ (384 МБ) и держи 128 МБ запаса под Buffer'ы, стеки, нативное и молодое поколение. Сравняй кучу с 512 — и общий RSS перерастёт cgroup: OOMKill на 137 без JS-стека.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nd8-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="94" text-anchor="middle" font-size="11" fill="var(--muted)">{t.barLabel}</text>

    <rect x="60" y="106" width="510" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <rect x="570" y="106" width="170" height="72" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="315" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.heapLine1}</text>
    <text x="315" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.heapLine2}</text>
    <text x="655" y="148" text-anchor="middle" font-size="11" fill="var(--ink)">{t.headLine}</text>

    <text x="400" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.covers}</text>

    <line x1="280" y1="178" x2="200" y2="232" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd8-arrow)"></line>
    <line x1="520" y1="178" x2="600" y2="232" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd8-arrow)"></line>

    <rect x="60" y="236" width="320" height="104" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="220" y="264" text-anchor="middle" font-size="12" fill="var(--ink)">{t.badTitle}</text>
    <text x="220" y="292" text-anchor="middle" font-size="11" fill="var(--ink)">{t.badLine1}</text>
    <text x="220" y="316" text-anchor="middle" font-size="11" fill="var(--ink)">{t.badLine2}</text>

    <rect x="420" y="236" width="320" height="104" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="580" y="264" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodTitle}</text>
    <text x="580" y="292" text-anchor="middle" font-size="11" fill="var(--ink)">{t.goodLine1}</text>
    <text x="580" y="316" text-anchor="middle" font-size="11" fill="var(--ink)">{t.goodLine2}</text>

    <text x="400" y="376" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
