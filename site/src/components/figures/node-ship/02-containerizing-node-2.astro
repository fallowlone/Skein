---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Runtime image size by base: full node about 1000 MB, node slim about 250 MB, distroless about 50 MB; dockerignore keeps secrets out",
    headline: "SAME APP, ~20x SMALLER IMAGE",
    sub: "slim base + .dockerignore",
    rowFull: "node:22",
    rowSlim: "node:22-slim",
    rowDistro: "distroless",
    valFull: "~1000 MB (~1 GB)",
    valSlim: "~250 MB",
    valDistro: "~50 MB",
    stripTitle: "never enters the image",
    caption:
      "Full node is about 1 GB, node:22-slim about 250 MB, distroless about 50 MB — and node_modules, .git, .env and logs never enter the image thanks to .dockerignore.",
  },
  ru: {
    svgTitle: "Размер runtime-образа по базе: полный node около 1000 МБ, node slim около 250 МБ, distroless около 50 МБ; dockerignore не пускает секреты",
    headline: "ТОТ ЖЕ КОД — ОБРАЗ В ~20 РАЗ МЕНЬШЕ",
    sub: "тонкая база + .dockerignore",
    rowFull: "node:22",
    rowSlim: "node:22-slim",
    rowDistro: "distroless",
    valFull: "~1000 МБ (~1 ГБ)",
    valSlim: "~250 МБ",
    valDistro: "~50 МБ",
    stripTitle: "не входит в образ",
    caption:
      "Полный node — около 1 ГБ, node:22-slim — около 250 МБ, distroless — около 50 МБ, а node_modules, .git, .env и логи вообще не входят в образ благодаря .dockerignore.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="230" y="124" text-anchor="end" font-size="12" fill="var(--muted)">{t.rowFull}</text>
    <rect x="250" y="100" width="380" height="38" fill="var(--card)" stroke="var(--muted)" stroke-width="2"></rect>
    <text x="650" y="124" font-size="11" fill="var(--ink)">{t.valFull}</text>

    <text x="230" y="199" text-anchor="end" font-size="12" fill="var(--muted)">{t.rowSlim}</text>
    <rect x="250" y="175" width="95" height="38" fill="var(--card)" stroke="var(--muted)" stroke-width="2"></rect>
    <text x="365" y="199" font-size="11" fill="var(--ink)">{t.valSlim}</text>

    <text x="230" y="274" text-anchor="end" font-size="12" fill="var(--muted)">{t.rowDistro}</text>
    <rect x="250" y="250" width="30" height="38" fill="var(--card)" stroke="var(--accent)" stroke-width="2"></rect>
    <text x="300" y="274" font-size="11" fill="var(--ink)">{t.valDistro}</text>

    <text x="400" y="318" text-anchor="middle" font-size="12" fill="var(--muted)">.dockerignore — {t.stripTitle}</text>
    <rect x="234" y="330" width="110" height="38" fill="var(--card)" stroke="var(--muted)" stroke-width="2"></rect>
    <text x="289" y="354" text-anchor="middle" font-size="11" fill="var(--ink)">node_modules</text>
    <rect x="360" y="330" width="56" height="38" fill="var(--card)" stroke="var(--muted)" stroke-width="2"></rect>
    <text x="388" y="354" text-anchor="middle" font-size="11" fill="var(--ink)">.git</text>
    <rect x="432" y="330" width="56" height="38" fill="var(--card)" stroke="var(--muted)" stroke-width="2"></rect>
    <text x="460" y="354" text-anchor="middle" font-size="11" fill="var(--ink)">.env</text>
    <rect x="504" y="330" width="62" height="38" fill="var(--card)" stroke="var(--muted)" stroke-width="2"></rect>
    <text x="535" y="354" text-anchor="middle" font-size="11" fill="var(--ink)">*.log</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
