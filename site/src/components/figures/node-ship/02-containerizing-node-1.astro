---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const code = {
  builder: [
    "FROM node:22 AS builder",
    "COPY package*.json ./",
    "RUN npm ci",
    "COPY . .",
    "RUN npm run build -> /app/dist",
  ],
  runtime: [
    "FROM node:22-slim AS runtime",
    "COPY package*.json ./",
    "RUN npm ci --omit=dev",
    "COPY --from=builder /app/dist ./dist",
    "USER node",
    'CMD ["node", "dist/server.js"]',
  ],
};

const dict = {
  en: {
    svgTitle: "Multi-stage Dockerfile: a builder stage compiles the app, a slim runtime stage ships only dist and production dependencies",
    headline: "BUILD FAT, SHIP THIN",
    sub: "multi-stage: builder compiles, runtime ships",
    builderTitle: "builder stage",
    builderStay: "full deps + toolchain stay here",
    runtimeTitle: "runtime stage",
    runtimeBase: "slim or distroless base",
    arrowNote: "only the built artifacts cross into runtime",
    foot: "lockfile before source, so npm ci reuses the cache",
    caption:
      "A fat builder stage runs npm ci and the build; the slim runtime copies only dist plus production-only npm ci --omit=dev dependencies — the toolchain and dev dependencies never ship.",
  },
  ru: {
    svgTitle: "Multi-stage Dockerfile: стадия builder собирает приложение, тонкая runtime-стадия отгружает только dist и прод-зависимости",
    headline: "СОБИРАЙ ЖИРНО, ОТГРУЖАЙ ТОНКО",
    sub: "multi-stage: builder собирает, runtime отгружает",
    builderTitle: "стадия builder",
    builderStay: "полные зависимости остаются здесь",
    runtimeTitle: "стадия runtime",
    runtimeBase: "slim- или distroless-база",
    arrowNote: "только собранные артефакты едут в runtime",
    foot: "lock-файл раньше исходников — npm ci берётся из кэша",
    caption:
      "Жирная builder-стадия запускает npm ci и сборку; тонкая runtime-стадия копирует только dist и прод-зависимости npm ci --omit=dev — тулчейн и dev-зависимости не отгружаются.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nd4-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="85" width="360" height="225" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5"></rect>
    <text x="200" y="112" text-anchor="middle" font-size="13" fill="var(--ink)">{t.builderTitle}</text>
    <text x="40" y="140" font-size="11" fill="var(--ink)">{code.builder[0]}</text>
    <text x="40" y="169" font-size="11" fill="var(--ink)">{code.builder[1]}</text>
    <text x="40" y="198" font-size="11" fill="var(--ink)">{code.builder[2]}</text>
    <text x="40" y="227" font-size="11" fill="var(--ink)">{code.builder[3]}</text>
    <text x="40" y="256" font-size="11" fill="var(--ink)">{code.builder[4]}</text>
    <text x="40" y="288" font-size="11" fill="var(--ink)">{t.builderStay}</text>

    <rect x="420" y="85" width="360" height="225" fill="var(--card)" stroke="var(--accent)" stroke-width="2"></rect>
    <text x="600" y="112" text-anchor="middle" font-size="13" fill="var(--ink)">{t.runtimeTitle}</text>
    <text x="600" y="132" text-anchor="middle" font-size="11" fill="var(--ink)">{t.runtimeBase}</text>
    <text x="440" y="158" font-size="11" fill="var(--ink)">{code.runtime[0]}</text>
    <text x="440" y="184" font-size="11" fill="var(--ink)">{code.runtime[1]}</text>
    <text x="440" y="210" font-size="11" fill="var(--ink)">{code.runtime[2]}</text>
    <text x="440" y="236" font-size="11" fill="var(--ink)">{code.runtime[3]}</text>
    <text x="440" y="262" font-size="11" fill="var(--ink)">{code.runtime[4]}</text>
    <text x="440" y="288" font-size="11" fill="var(--ink)">{code.runtime[5]}</text>

    <line x1="382" y1="215" x2="416" y2="215" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd4-a)"></line>

    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.arrowNote}</text>
    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
