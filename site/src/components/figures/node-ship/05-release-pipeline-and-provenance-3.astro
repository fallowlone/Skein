---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Files allow-list failures: too narrow ships a 2 KB tarball with zero js files so require throws MODULE_NOT_FOUND, recoverable with a patch and deprecate; too broad leaks env, tokens, fixtures and source maps into an append-only registry and is irreversible",
    headline: "THE ALLOW-LIST DECIDES WHAT SHIPS",
    sub: "tarball, not repo — inspected with --dry-run",
    headL: "TOO NARROW · recoverable",
    headR: "TOO BROAD · irreversible",
    causeL: '"files": ["lib"] while the build emits to dist/',
    causeR: "no files · stale .npmignore · greedy wildcard",
    l1: "package.json",
    l2: "README.md",
    l3: "LICENSE",
    l4: "dist/index.js — absent",
    lSum: "2 KB · zero .js files · MODULE_NOT_FOUND",
    r1: "package.json",
    r2: "dist/index.js",
    r3: ".env · .npmrc auth token — LEAK",
    r4: "fixtures · source maps — LEAK",
    rSum: "mirrors keep it forever — rotate!",
    outL: "recoverable: publish 2.1.1, deprecate 2.1.0",
    outR: "irreversible — rotate the secret first",
    caption:
      "Too narrow ships an empty package — every install succeeds and every require throws; publish a fix and deprecate. Too broad ships secrets to an append-only registry — rotate the credential, because mirrors keep it forever.",
  },
  ru: {
    svgTitle: "Провалы allow-list files: слишком узко отправляет тарбол на 2 КБ с нулём js-файлов, и require кидает MODULE_NOT_FOUND, лечится патчем и deprecate; слишком широко заметает env, токены, фикстуры и сорс-мапы в реестр без кнопки редактирования — необратимо",
    headline: "ALLOW-LIST РЕШАЕТ, ЧТО УЕДЕТ",
    sub: "тарбол, а не репозиторий — смотрится через --dry-run",
    headL: "СЛИШКОМ УЗКО · поправимо",
    headR: "СЛИШКОМ ШИРОКО · необратимо",
    causeL: '"files": ["lib"], когда сборка — в dist/',
    causeR: "нет files · протухший .npmignore · жадная маска",
    l1: "package.json",
    l2: "README.md",
    l3: "LICENSE",
    l4: "dist/index.js — отсутствует",
    lSum: "2 КБ · ноль .js-файлов · MODULE_NOT_FOUND",
    r1: "package.json",
    r2: "dist/index.js",
    r3: ".env · .npmrc с auth-токеном — УТЕЧКА",
    r4: "фикстуры · сорс-мапы — УТЕЧКА",
    rSum: "зеркала хранят вечно — ротируй!",
    outL: "поправимо: выкатить 2.1.1 + deprecate",
    outR: "необратимо — сначала ротируй секрет",
    caption:
      "Слишком узко отправляет пустой пакет — каждая установка успешна, а каждый require падает; выкатывай фикс и помечай deprecate. Слишком широко отправляет секреты в реестр без кнопки редактирования — ротируй креденшл, потому что зеркала хранят его вечно.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.headL}</text>
    <text x="600" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.headR}</text>
    <text x="200" y="122" text-anchor="middle" font-size="10" fill="var(--muted)">{t.causeL}</text>
    <text x="600" y="122" text-anchor="middle" font-size="10" fill="var(--muted)">{t.causeR}</text>

    <rect x="30" y="148" width="340" height="185" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="200" y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.l1}</text>
    <text x="200" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.l2}</text>
    <text x="200" y="224" text-anchor="middle" font-size="11" fill="var(--ink)">{t.l3}</text>
    <text x="200" y="248" text-anchor="middle" font-size="11" fill="var(--ink)">{t.l4}</text>
    <line x1="50" y1="276" x2="350" y2="276" stroke="var(--muted)" stroke-width="1" />
    <text x="200" y="304" text-anchor="middle" font-size="11" fill="var(--ink)">{t.lSum}</text>

    <rect x="430" y="148" width="340" height="185" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r1}</text>
    <text x="600" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r2}</text>
    <text x="600" y="224" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r3}</text>
    <text x="600" y="248" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r4}</text>
    <line x1="450" y1="276" x2="750" y2="276" stroke="var(--muted)" stroke-width="1" />
    <text x="600" y="304" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rSum}</text>

    <text x="200" y="367" text-anchor="middle" font-size="11" fill="var(--muted)">{t.outL}</text>
    <text x="600" y="367" text-anchor="middle" font-size="11" fill="var(--accent)">{t.outR}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
