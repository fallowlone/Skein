---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The exports map resolves one specifier by condition — types first, import for ESM, require for CJS, default last — and only listed subpaths are importable, so deep imports of internal files throw ERR_PACKAGE_PATH_NOT_EXPORTED",
    headline: "ONE SPECIFIER, FOUR CONDITIONS",
    sub: "types first, default last; the rest is unreachable",
    labConsumers: "consumers",
    labFiles: "files",
    c1: 'import "pkg"',
    c2: 'require("pkg")',
    c3: "TS reads types",
    mapHead: '"exports" map',
    r1: "types -> index.d.ts",
    r2: "import -> index.js",
    r3: "require -> index.cjs",
    r4: "default -> index.js",
    f1: "./dist/index.js",
    f2: "./dist/index.cjs",
    f3: "./dist/index.d.ts",
    blocked1: "deep import dist/internal/secret.js",
    blocked2: "throws ERR_PACKAGE_PATH_NOT_EXPORTED",
    caption:
      "The exports map resolves the same specifier by condition — types first, then import or require, default last — and encapsulates the package: only listed subpaths resolve, so any deep import of an internal file throws ERR_PACKAGE_PATH_NOT_EXPORTED.",
  },
  ru: {
    svgTitle: "Карта exports разрешает один спецификатор по условию — types первым, import для ESM, require для CJS, default последним, — и импортируемы только перечисленные subpath, так что deep-import внутренних файлов бросает ERR_PACKAGE_PATH_NOT_EXPORTED",
    headline: "ОДИН СПЕЦИФИКАТОР — ЧЕТЫРЕ УСЛОВИЯ",
    sub: "types первым, default последним; остальное недостижимо",
    labConsumers: "потребители",
    labFiles: "файлы",
    c1: 'import "pkg"',
    c2: 'require("pkg")',
    c3: "TS читает types",
    mapHead: 'карта "exports"',
    r1: "types -> index.d.ts",
    r2: "import -> index.js",
    r3: "require -> index.cjs",
    r4: "default -> index.js",
    f1: "./dist/index.js",
    f2: "./dist/index.cjs",
    f3: "./dist/index.d.ts",
    blocked1: "deep-import dist/internal/secret.js",
    blocked2: "бросает ERR_PACKAGE_PATH_NOT_EXPORTED",
    caption:
      "Карта exports разрешает один спецификатор по условию — сначала types, затем import или require, default последним, — и инкапсулирует пакет: разрешаются только перечисленные subpath, так что любой deep-import внутреннего файла бросает ERR_PACKAGE_PATH_NOT_EXPORTED.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nd2-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="125" y="100" text-anchor="middle" font-size="12" fill="var(--ink)">{t.labConsumers}</text>
    <rect x="20" y="125" width="210" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="125" y="159" text-anchor="middle" font-size="11" fill="var(--ink)">{t.c1}</text>
    <rect x="20" y="195" width="210" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="125" y="229" text-anchor="middle" font-size="11" fill="var(--ink)">{t.c2}</text>
    <rect x="20" y="265" width="210" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="125" y="299" text-anchor="middle" font-size="11" fill="var(--ink)">{t.c3}</text>

    <rect x="290" y="120" width="220" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mapHead}</text>
    <text x="400" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r1}</text>
    <text x="400" y="208" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r2}</text>
    <text x="400" y="236" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r3}</text>
    <text x="400" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.r4}</text>

    <text x="675" y="100" text-anchor="middle" font-size="12" fill="var(--ink)">{t.labFiles}</text>
    <rect x="570" y="125" width="210" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="675" y="159" text-anchor="middle" font-size="11" fill="var(--ink)">{t.f1}</text>
    <rect x="570" y="195" width="210" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="675" y="229" text-anchor="middle" font-size="11" fill="var(--ink)">{t.f2}</text>
    <rect x="570" y="265" width="210" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="675" y="299" text-anchor="middle" font-size="11" fill="var(--ink)">{t.f3}</text>

    <line x1="230" y1="153" x2="290" y2="153" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd2-arrow)" />
    <line x1="230" y1="223" x2="290" y2="223" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd2-arrow)" />
    <line x1="230" y1="293" x2="290" y2="293" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd2-arrow)" />
    <line x1="510" y1="153" x2="570" y2="153" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd2-arrow)" />
    <line x1="510" y1="223" x2="570" y2="223" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd2-arrow)" />
    <line x1="510" y1="293" x2="570" y2="293" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd2-arrow)" />

    <text x="400" y="356" text-anchor="middle" font-size="11" fill="var(--muted)">{t.blocked1}</text>
    <text x="400" y="380" text-anchor="middle" font-size="11" fill="var(--muted)">{t.blocked2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
