---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Provenance: CI OIDC identity signs an attestation linking the tarball to its commit and build in a public log, while a stolen-token publish outside CI carries no attestation and is flagged untrusted",
    headline: "PROVENANCE MAKES PUBLISHES CHECKABLE",
    sub: "a signed link from tarball to commit and build",
    lane1: "trusted path: CI + OIDC",
    lane2: "attacker path: stolen token",
    a1l1: "GitHub Actions CI",
    a1l2: "GitLab runner",
    a2l1: "OIDC identity",
    a2l2: "id-token: write",
    a3l1: "signed attestation",
    a3l2: "commit + build linked",
    b1l1: "stolen token",
    b1l2: "publish token leaked",
    b2l1: "publish from laptop",
    b2l2: "outside CI",
    b3l1: "no attestation",
    b3l2: "flagged: untrusted",
    signLabel: "signs",
    unsignedLabel: "unsigned",
    logLine: "public transparency log · verified with npm audit signatures",
    foot: "provenance cannot block the publish — it makes a stolen-token release detectable",
    caption:
      "Legitimate releases ride CI OIDC into a signed attestation in a public log; a tarball pushed with a stolen token outside CI carries no valid provenance and is flagged — layer scoped automation tokens and 2FA underneath.",
  },
  ru: {
    svgTitle: "Provenance: OIDC-идентичность CI подписывает аттестацию, связывающую тарбол с его коммитом и сборкой, в публичном логе, а публикация с украденного токена вне CI не несёт аттестации и помечается недоверенной",
    headline: "PROVENANCE ДЕЛАЕТ ПУБЛИКАЦИИ ПРОВЕРЯЕМЫМИ",
    sub: "подписанная связь тарбола с коммитом и сборкой",
    lane1: "доверенный путь: CI + OIDC",
    lane2: "путь атакующего: украденный токен",
    a1l1: "GitHub Actions CI",
    a1l2: "раннер GitLab",
    a2l1: "OIDC-токен",
    a2l2: "id-token: write",
    a3l1: "подписанная аттестация",
    a3l2: "коммит + сборка связаны",
    b1l1: "украденный токен",
    b1l2: "токен публикации утёк",
    b2l1: "публикация с ноутбука",
    b2l2: "вне CI",
    b3l1: "нет аттестации",
    b3l2: "метка: недоверенный",
    signLabel: "подписывает",
    unsignedLabel: "без подписи",
    logLine: "публичный transparency-лог · проверка: npm audit signatures",
    foot: "provenance не блокирует публикацию — релиз с краденого токена становится обнаружимым",
    caption:
      "Легитимные релизы едут на OIDC из CI в подписанную аттестацию в публичном логе; тарбол, запушенный с краденого токена вне CI, не несёт валидного provenance и помечается — подстели снизу узкие automation-токены и 2FA.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nd14-dim" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--muted)" stroke-width="1.6" />
      </marker>
      <marker id="nd14-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="15" y="102" font-size="11" fill="var(--muted)">{t.lane1}</text>
    <rect x="15" y="130" width="180" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="105" y="156" text-anchor="middle" font-size="11" fill="var(--ink)">{t.a1l1}</text>
    <text x="105" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.a1l2}</text>

    <rect x="310" y="130" width="180" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="156" text-anchor="middle" font-size="11" fill="var(--ink)">{t.a2l1}</text>
    <text x="400" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.a2l2}</text>

    <rect x="605" y="130" width="180" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="695" y="156" text-anchor="middle" font-size="11" fill="var(--ink)">{t.a3l1}</text>
    <text x="695" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.a3l2}</text>

    <line x1="195" y1="162" x2="302" y2="162" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd14-dim)" />
    <line x1="490" y1="162" x2="597" y2="162" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd14-dim)" />
    <text x="547" y="153" text-anchor="middle" font-size="10" fill="var(--muted)">{t.signLabel}</text>

    <text x="15" y="214" font-size="11" fill="var(--muted)">{t.lane2}</text>
    <rect x="15" y="240" width="180" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="105" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b1l1}</text>
    <text x="105" y="288" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b1l2}</text>

    <rect x="310" y="240" width="180" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b2l1}</text>
    <text x="400" y="288" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b2l2}</text>

    <rect x="605" y="240" width="180" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="695" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b3l1}</text>
    <text x="695" y="288" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b3l2}</text>

    <line x1="195" y1="272" x2="302" y2="272" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd14-dim)" />
    <line x1="490" y1="272" x2="597" y2="272" stroke="var(--accent)" stroke-width="2" marker-end="url(#nd14-arr)" />
    <text x="547" y="263" text-anchor="middle" font-size="10" fill="var(--accent)">{t.unsignedLabel}</text>

    <rect x="15" y="325" width="770" height="42" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="351" text-anchor="middle" font-size="11" fill="var(--ink)">{t.logLine}</text>

    <text x="400" y="395" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
