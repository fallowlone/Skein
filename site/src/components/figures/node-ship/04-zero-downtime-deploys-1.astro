---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Rolling deploy: old pods fail readiness and drain while new ready pods take traffic — the load balancer must de-register old pods before they close",
    headline: "ROLLING DEPLOY: SHIFT TRAFFIC FIRST",
    sub: "fail readiness, then close — not the reverse",
    lbTitle: "Service / load balancer",
    lbSub: "endpoints: who gets traffic",
    verOld: "v1 · old",
    verNew: "v2 · new",
    readyOld: "/ready → 503",
    readyNew: "/ready → 200",
    stateOld: "draining",
    stateNew: "serving",
    noTraffic: "no traffic",
    yesTraffic: "traffic",
    step1: "1 · SIGTERM → ready = false → /ready 503",
    step2: "2 · LB de-registers over ms–s → then server.close()",
    foot: "naive order closes first → 502 burst ~2–10 s every rollout",
    caption:
      "A rolling deploy swaps pods while the load balancer de-registers the old ones over hundreds of milliseconds to seconds. Failing readiness first moves old pods out of rotation before server.close() stops accepting — otherwise new connections hit a closed listener and burst into 502s for about two to ten seconds.",
  },
  ru: {
    svgTitle: "Скользящая выкатка: старые поды роняют readiness и сливаются, а новые ready-поды забирают трафик — балансировщик должен снять старые поды с маршрутизации раньше, чем они закроются",
    headline: "ROLLING-ВЫКАТКА: СНАЧАЛА СДВИНЬ ТРАФИК",
    sub: "сначала урони readiness, потом закрывайся — не наоборот",
    lbTitle: "Service / балансировщик",
    lbSub: "endpoints: кому слать трафик",
    verOld: "v1 · старый",
    verNew: "v2 · новый",
    readyOld: "/ready → 503",
    readyNew: "/ready → 200",
    stateOld: "слив",
    stateNew: "обслуживает",
    noTraffic: "без трафика",
    yesTraffic: "трафик",
    step1: "1 · SIGTERM → ready = false → /ready 503",
    step2: "2 · LB снимает с маршрутизации за мс–с → затем server.close()",
    foot: "наивный порядок закрывает раньше → всплеск 502 ~2–10 с на каждой выкатке",
    caption:
      "Скользящая выкатка меняет поды, пока балансировщик от сотен миллисекунд до секунд снимает старые с маршрутизации. Если сначала уронить readiness, старые поды выйдут из ротации до того, как server.close() перестанет принимать, — иначе новые соединения бьют в закрытый listener и дают всплеск 502 примерно на две–десять секунд.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nd10-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
      <marker id="nd10-dim" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--muted)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="270" y="78" width="260" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="98" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lbTitle}</text>
    <text x="400" y="116" text-anchor="middle" font-size="11" fill="var(--ink)">{t.lbSub}</text>

    <text x="130" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.noTraffic}</text>
    <text x="310" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.noTraffic}</text>
    <text x="490" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.yesTraffic}</text>
    <text x="670" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.yesTraffic}</text>

    <line x1="330" y1="124" x2="140" y2="188" stroke="var(--muted)" stroke-width="1.6" stroke-dasharray="6 4" marker-end="url(#nd10-dim)" />
    <line x1="375" y1="124" x2="305" y2="188" stroke="var(--muted)" stroke-width="1.6" stroke-dasharray="6 4" marker-end="url(#nd10-dim)" />
    <line x1="425" y1="124" x2="485" y2="188" stroke="var(--accent)" stroke-width="2" marker-end="url(#nd10-arr)" />
    <line x1="470" y1="124" x2="660" y2="188" stroke="var(--accent)" stroke-width="2" marker-end="url(#nd10-arr)" />

    <rect x="50" y="190" width="160" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="130" y="216" text-anchor="middle" font-size="12" fill="var(--ink)">{t.verOld}</text>
    <text x="130" y="240" text-anchor="middle" font-size="11" fill="var(--ink)">{t.readyOld}</text>
    <text x="130" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stateOld}</text>

    <rect x="230" y="190" width="160" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="310" y="216" text-anchor="middle" font-size="12" fill="var(--ink)">{t.verOld}</text>
    <text x="310" y="240" text-anchor="middle" font-size="11" fill="var(--ink)">{t.readyOld}</text>
    <text x="310" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stateOld}</text>

    <rect x="410" y="190" width="160" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="490" y="216" text-anchor="middle" font-size="12" fill="var(--ink)">{t.verNew}</text>
    <text x="490" y="240" text-anchor="middle" font-size="11" fill="var(--ink)">{t.readyNew}</text>
    <text x="490" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stateNew}</text>

    <rect x="590" y="190" width="160" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="670" y="216" text-anchor="middle" font-size="12" fill="var(--ink)">{t.verNew}</text>
    <text x="670" y="240" text-anchor="middle" font-size="11" fill="var(--ink)">{t.readyNew}</text>
    <text x="670" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stateNew}</text>

    <text x="400" y="332" text-anchor="middle" font-size="12" fill="var(--muted)">{t.step1}</text>
    <text x="400" y="354" text-anchor="middle" font-size="12" fill="var(--muted)">{t.step2}</text>
    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
