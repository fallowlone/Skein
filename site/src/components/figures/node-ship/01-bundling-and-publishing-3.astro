---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Publish hygiene pipeline: build with tsup or esbuild into dist plus declarations, pack only dist via the files allowlist, verify with npm pack dry-run, and publish from CI with provenance; CLI needs bin plus shebang plus execute permission; engines pins Node 18.17 or newer",
    headline: "SHIP THE BUILD, NOT THE SOURCE",
    sub: "tarball hygiene plus an attested release",
    s1n: "build",
    s1d: "tsup -> dist + .d.ts",
    s2n: '"files"',
    s2d: 'only ["dist"]',
    s3n: "check",
    s3d: "pack --dry-run",
    s4n: "publish from CI",
    s4d: "--provenance",
    b1l1: "bin + shebang + chmod +x",
    b1l2: "link lands in node_modules/.bin",
    b2l1: "engines: node >= 18.17",
    b2l2: "sideEffects: false",
    foot1: "new exports map = semver-major; provenance ties the tarball to its commit",
    caption:
      "Ship the build, not the source: bundle into dist with declarations, allowlist only dist via files, verify with npm pack --dry-run, and publish from CI with provenance. The CLI needs bin plus shebang plus execute permission, and engines plus sideEffects keep the contract honest.",
  },
  ru: {
    svgTitle: "Гигиена публикации: сборка через tsup или esbuild в dist плюс декларации, упаковка только dist через allowlist files, проверка через npm pack dry-run и публикация из CI с provenance; CLI нужны bin плюс shebang плюс право на выполнение; engines фиксирует Node 18.17 и новее",
    headline: "ОТГРУЖАЙ СБОРКУ, А НЕ ИСХОДНИК",
    sub: "гигиена тарбола плюс аттестованный релиз",
    s1n: "сборка",
    s1d: "tsup -> dist + .d.ts",
    s2n: '"files"',
    s2d: 'только ["dist"]',
    s3n: "проверка",
    s3d: "pack --dry-run",
    s4n: "публикация из CI",
    s4d: "--provenance",
    b1l1: "bin + shebang + chmod +x",
    b1l2: "линк ляжет в node_modules/.bin",
    b2l1: "engines: node >= 18.17",
    b2l2: "sideEffects: false",
    foot1: "новая карта exports = semver-major; provenance привязывает тарбол к коммиту",
    caption:
      "Отгружай сборку, а не исходник: собери в dist с декларациями, оставь в files только dist, проверь через npm pack --dry-run и публикуй из CI с provenance. Для CLI нужны bin плюс shebang плюс право на выполнение, а engines и sideEffects держат контракт честным.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nd3-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="15" y="130" width="170" height="96" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="100" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s1n}</text>
    <text x="100" y="188" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s1d}</text>
    <rect x="215" y="130" width="170" height="96" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="300" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s2n}</text>
    <text x="300" y="188" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s2d}</text>
    <rect x="415" y="130" width="170" height="96" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="500" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s3n}</text>
    <text x="500" y="188" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s3d}</text>
    <rect x="615" y="130" width="170" height="96" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="700" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s4n}</text>
    <text x="700" y="188" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s4d}</text>

    <line x1="185" y1="178" x2="215" y2="178" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd3-arrow)" />
    <line x1="385" y1="178" x2="415" y2="178" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd3-arrow)" />
    <line x1="585" y1="178" x2="615" y2="178" stroke="var(--muted)" stroke-width="2" marker-end="url(#nd3-arrow)" />

    <rect x="15" y="260" width="380" height="84" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="205" y="292" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b1l1}</text>
    <text x="205" y="318" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b1l2}</text>
    <rect x="405" y="260" width="380" height="84" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="595" y="292" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b2l1}</text>
    <text x="595" y="318" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b2l2}</text>

    <text x="400" y="380" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot1}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
