---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Default PC advance: 100 to 104 to 108 to 112 in 4-byte steps",
    headline: "THE DEFAULT: PC += SIZE",
    sub: "100 → 104 → 108 → 112 · 4-byte steps",
    addrLabel: "addresses in memory",
    addrs: ["100", "104", "108", "112"],
    step: "+4",
    pcLine: "the PC visits each in order — top to bottom",
    cycleLabel: "after every non-jump instruction",
    stages: ["fetch", "execute", "PC += 4"],
    nextFetch: "next fetch",
    foot1: "no decision — automatic every time",
    foot2: "advance needs only an adder, the simplest circuit",
    caption:
      "The default PC update adds the instruction size: on a 4-byte architecture the PC sweeps 100, 104, 108, 112 in equal steps. After every non-jump instruction the same three stages repeat — fetch, execute, PC += 4 — with no decision involved.",
  },
  ru: {
    svgTitle: "Продвижение СК по умолчанию: 100, 104, 108, 112 шагами по 4 байта",
    headline: "УМОЛЧАНИЕ: СК += РАЗМЕР",
    sub: "100 → 104 → 108 → 112 · шаги по 4 байта",
    addrLabel: "адреса в памяти",
    addrs: ["100", "104", "108", "112"],
    step: "+4",
    pcLine: "СК обходит все по порядку — сверху вниз",
    cycleLabel: "после каждой инструкции без перехода",
    stages: ["выборка", "исполнение", "СК += 4"],
    nextFetch: "следующая выборка",
    foot1: "решений нет — срабатывает автоматически",
    foot2: "продвижению нужен лишь сумматор — простейшая схема",
    caption:
      "Обновление СК по умолчанию прибавляет размер инструкции: на архитектуре с 4-байтовыми инструкциями СК шагает 100, 104, 108, 112 равными шагами. После каждой инструкции без перехода повторяются те же три стадии — выборка, исполнение, СК += 4 — без всяких решений.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="118" text-anchor="middle" font-size="11" fill="var(--muted)">{t.addrLabel}</text>

    {t.addrs.map((a, i) => (
      <g>
        <rect x={90 + i * 170} y="140" width="110" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={145 + i * 170} y="176" text-anchor="middle" font-size="18" fill="var(--ink)">{a}</text>
        {i < 3 ? (
          <g>
            <line x1={200 + i * 170} y1="168" x2={252 + i * 170} y2="168" stroke="var(--accent)" stroke-width="1.6" />
            <polygon points={`${258 + i * 170},168 ${250 + i * 170},163 ${250 + i * 170},173`} fill="var(--accent)" />
            <text x={230 + i * 170} y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step}</text>
          </g>
        ) : null}
      </g>
    ))}

    <text x="400" y="224" text-anchor="middle" font-size="12" fill="var(--muted)">{t.pcLine}</text>
    <text x="400" y="254" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cycleLabel}</text>

    {t.stages.map((s, i) => (
      <g>
        <rect x={95 + i * 230} y="268" width="150" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={170 + i * 230} y="295" text-anchor="middle" font-size="12" fill="var(--ink)">{s}</text>
        {i < 2 ? (
          <g>
            <line x1={245 + i * 230} y1="290" x2={319 + i * 230} y2="290" stroke="var(--accent)" stroke-width="1.6" />
            <polygon points={`${323 + i * 230},290 ${315 + i * 230},285 ${315 + i * 230},295`} fill="var(--accent)" />
          </g>
        ) : null}
      </g>
    ))}

    <line x1="630" y1="312" x2="630" y2="342" stroke="var(--muted)" stroke-width="1.6" />
    <line x1="170" y1="312" x2="170" y2="342" stroke="var(--muted)" stroke-width="1.6" />
    <line x1="630" y1="342" x2="174" y2="342" stroke="var(--muted)" stroke-width="1.6" />
    <polygon points="171,342 179,337 179,347" fill="var(--muted)" />
    <text x="400" y="334" text-anchor="middle" font-size="11" fill="var(--muted)">{t.nextFetch}</text>

    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="390" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
