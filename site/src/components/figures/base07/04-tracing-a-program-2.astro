---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Frame-by-frame state of sumPositives over [3,-1,4]: add, skip, add, then exit with 7",
    headline: "THREE ITERATIONS, THEN EXIT",
    sub: "sumPositives([3,-1,4]) → 7",
    head: { iter: "iter", i: "i", elem: "nums[i]", test: "if test", sum: "sum" },
    rows: [
      { iter: "1", i: "0 → 1", elem: "3", test: "true → add", sum: "0 → 3", hot: false },
      { iter: "2", i: "1 → 2", elem: "-1", test: "false → skip", sum: "stays 3", hot: false },
      { iter: "3", i: "2 → 3", elem: "4", test: "true → add", sum: "3 → 7", hot: false },
      { iter: "exit", i: "3", elem: "—", test: "i<3 → false", sum: "return 7", hot: true },
    ],
    foot1: "sum += runs 2 times; -1 is skipped",
    foot2: "exit at i = 3: i < 3 is false",
    caption:
      "Tracing sumPositives([3,-1,4]): iteration 1 adds 3 (sum 0→3), iteration 2 skips -1 but still increments (sum stays 3), iteration 3 adds 4 (sum 3→7), then i=3 fails the while test and the function returns 7.",
  },
  ru: {
    svgTitle: "Покадровое состояние sumPositives по [3,-1,4]: сложить, пропустить, сложить, затем выход с 7",
    headline: "ТРИ ИТЕРАЦИИ, ЗАТЕМ ВЫХОД",
    sub: "sumPositives([3,-1,4]) → 7",
    head: { iter: "итер", i: "i", elem: "nums[i]", test: "тест if", sum: "sum" },
    rows: [
      { iter: "1", i: "0 → 1", elem: "3", test: "true → сложить", sum: "0 → 3", hot: false },
      { iter: "2", i: "1 → 2", elem: "-1", test: "false → пропуск", sum: "sum остаётся 3", hot: false },
      { iter: "3", i: "2 → 3", elem: "4", test: "true → сложить", sum: "3 → 7", hot: false },
      { iter: "выход", i: "3", elem: "—", test: "i<3 → false", sum: "return 7", hot: true },
    ],
    foot1: "sum += выполняется 2 раза; -1 пропущен",
    foot2: "выход при i = 3: i < 3 ложно",
    caption:
      "Трассировка sumPositives([3,-1,4]): итерация 1 добавляет 3 (sum 0→3), итерация 2 пропускает -1, но всё равно инкрементирует (sum остаётся 3), итерация 3 добавляет 4 (sum 3→7), затем i=3 проваливает тест while — и функция возвращает 7.",
  },
};

const t = dict[lang];
const cx = [115, 220, 335, 480, 650];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={cx[0]} y="115" text-anchor="middle" font-size="11" fill="var(--muted)">{t.head.iter}</text>
    <text x={cx[1]} y="115" text-anchor="middle" font-size="11" fill="var(--muted)">{t.head.i}</text>
    <text x={cx[2]} y="115" text-anchor="middle" font-size="11" fill="var(--muted)">{t.head.elem}</text>
    <text x={cx[3]} y="115" text-anchor="middle" font-size="11" fill="var(--muted)">{t.head.test}</text>
    <text x={cx[4]} y="115" text-anchor="middle" font-size="11" fill="var(--muted)">{t.head.sum}</text>
    <line x1="60" y1="130" x2="740" y2="130" stroke="var(--ink)" stroke-width="1.6" />

    {t.rows.map((r, i) => (
      <g>
        <text x={cx[0]} y={155 + i * 40} text-anchor="middle" font-size="12" fill={r.hot ? "var(--accent)" : "var(--ink)"}>{r.iter}</text>
        <text x={cx[1]} y={155 + i * 40} text-anchor="middle" font-size="12" fill={r.hot ? "var(--accent)" : "var(--ink)"}>{r.i}</text>
        <text x={cx[2]} y={155 + i * 40} text-anchor="middle" font-size="12" fill={r.hot ? "var(--accent)" : "var(--ink)"}>{r.elem}</text>
        <text x={cx[3]} y={155 + i * 40} text-anchor="middle" font-size="12" fill={r.hot ? "var(--accent)" : "var(--ink)"}>{r.test}</text>
        <text x={cx[4]} y={155 + i * 40} text-anchor="middle" font-size="12" fill={r.hot ? "var(--accent)" : "var(--ink)"}>{r.sum}</text>
      </g>
    ))}

    <line x1="60" y1="175" x2="740" y2="175" stroke="var(--muted)" stroke-width="0.8" />
    <line x1="60" y1="215" x2="740" y2="215" stroke="var(--muted)" stroke-width="0.8" />
    <line x1="60" y1="255" x2="740" y2="255" stroke="var(--muted)" stroke-width="0.8" />
    <line x1="60" y1="295" x2="740" y2="295" stroke="var(--muted)" stroke-width="0.8" />

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
