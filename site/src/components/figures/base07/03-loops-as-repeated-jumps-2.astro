---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "While loop machine structure: test first, body, unconditional backward jump",
    headline: "WHILE: TEST FIRST, BODY, JUMP BACK",
    sub: "test → body → backward jump · repeat until false",
    testFirst: "test first",
    trueDown: "true ↓",
    falseExit: "false → exit",
    loopEnd: "LOOP_END: …",
    zeroTimes: "runs 0, 1, 1000×",
    uncond: "unconditional",
    back: "back",
    foot1: "test at top: body runs zero times if false at first",
    foot2: "countdown 3→0: body ran 3×, 4th test Z=1 exits",
    caption:
      "A while loop compiles to a test at LOOP_TOP, a conditional exit jump, the body, and an unconditional backward jump: CMP tests the condition, JE exits forward to LOOP_END when false, otherwise the body runs and JUMP resets the PC to the test. The countdown 3→0 runs the body exactly 3 times — on the 4th test Z=1 and JE escapes.",
  },
  ru: {
    svgTitle: "Структура while в машинном коде: сначала тест, тело, безусловный прыжок назад",
    headline: "WHILE: СНАЧАЛА ТЕСТ, ТЕЛО, ПРЫЖОК НАЗАД",
    sub: "тест → тело → прыжок назад · повторять, пока ложно",
    testFirst: "сначала тест",
    trueDown: "истинно ↓",
    falseExit: "ложно → выход",
    loopEnd: "LOOP_END: …",
    zeroTimes: "0, 1 или 1000 раз",
    uncond: "безусловный",
    back: "назад",
    foot1: "тест в начале: при начальной лжи тело — 0 раз",
    foot2: "отсчёт 3→0: тело 3×, на 4-м тесте Z=1 — выход",
    caption:
      "Цикл while компилируется в тест на LOOP_TOP, условный переход-выход, тело и безусловный обратный переход: CMP проверяет условие, JE при лжи выходит вперёд на LOOP_END, иначе тело выполняется, а JUMP сбрасывает СК на тест. Обратный отсчёт 3→0 выполняет тело ровно 3 раза — на 4-м тесте Z=1, и JE вырывается из цикла.",
  },
};

const t = dict[lang];

const boxes = [
  { y: 100, label: "LOOP_TOP: CMP R0,0" },
  { y: 156, label: "JE 120: Z=1 → exit" },
  { y: 212, label: "body: SUB R0,1" },
  { y: 268, label: "JUMP 104 · backward" },
];

const ruLabels = [
  "LOOP_TOP: CMP R0,0",
  "JE 120: Z=1 → выход",
  "тело: SUB R0,1",
  "JUMP 104 · назад",
];

const labels = lang === "ru" ? ruLabels : boxes.map((b) => b.label);

const downs = [136, 192, 248];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {boxes.map((b, i) => (
      <g>
        <rect x="150" y={b.y} width="220" height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="260" y={b.y + 23} text-anchor="middle" font-size="11" fill="var(--ink)">{labels[i]}</text>
      </g>
    ))}

    {downs.map((dy) => (
      <g>
        <line x1="260" y1={dy} x2="260" y2={dy + 20} stroke="var(--ink)" stroke-width="1.5" />
        <polygon points={`260,${dy + 20} 255,${dy + 12} 265,${dy + 12}`} fill="var(--ink)" />
      </g>
    ))}

    <text x="388" y="122" text-anchor="start" font-size="11" fill="var(--muted)">{t.testFirst}</text>
    <text x="282" y="206" text-anchor="start" font-size="11" fill="var(--muted)">{t.trueDown}</text>
    <text x="388" y="234" text-anchor="start" font-size="11" fill="var(--muted)">{t.zeroTimes}</text>
    <text x="388" y="290" text-anchor="start" font-size="11" fill="var(--muted)">{t.uncond}</text>

    <line x1="370" y1="174" x2="520" y2="174" stroke="var(--accent)" stroke-width="2" />
    <polygon points="520,174 510,169 510,179" fill="var(--accent)" />
    <text x="445" y="165" text-anchor="middle" font-size="11" fill="var(--accent)">{t.falseExit}</text>
    <rect x="520" y="156" width="180" height="36" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="179" text-anchor="middle" font-size="11" fill="var(--ink)">{t.loopEnd}</text>

    <line x1="150" y1="286" x2="80" y2="286" stroke="var(--accent)" stroke-width="2" />
    <line x1="80" y1="286" x2="80" y2="118" stroke="var(--accent)" stroke-width="2" />
    <line x1="80" y1="118" x2="150" y2="118" stroke="var(--accent)" stroke-width="2" />
    <polygon points="150,118 140,113 140,123" fill="var(--accent)" />
    <text x="115" y="198" text-anchor="middle" font-size="10" fill="var(--accent)">JUMP 104</text>
    <text x="115" y="213" text-anchor="middle" font-size="10" fill="var(--muted)">{t.back}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
