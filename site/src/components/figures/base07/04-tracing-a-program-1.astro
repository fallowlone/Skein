---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three control-flow moments per iteration: while test, if test, increment and backward jump",
    headline: "THREE MOMENTS PER ITERATION",
    sub: "sumPositives over [3,-1,4] · while, if, i++",
    boxes: [
      { title: "while test", code: "i < length?", note: "true→body · false→exit" },
      { title: "if test", code: "nums[i] > 0?", note: "true→add · false→skip" },
      { title: "i++", code: "always runs", note: "back to while test" },
    ],
    back: "backward jump",
    foot1: "i++ runs every iteration — even when if skips",
    foot2: "every element is visited exactly once",
    caption:
      "Each iteration of sumPositives has three control-flow moments: the while test (i < length?), the if test (nums[i] > 0), and i++ followed by the backward jump to the while test. i++ runs every iteration — even when the if skips — so every element is visited exactly once.",
  },
  ru: {
    svgTitle: "Три момента управления потоком на итерацию: тест while, тест if, инкремент и обратный переход",
    headline: "ТРИ МОМЕНТА НА ИТЕРАЦИЮ",
    sub: "sumPositives по [3,-1,4] · while, if, i++",
    boxes: [
      { title: "тест while", code: "i < length?", note: "true→тело · false→выход" },
      { title: "тест if", code: "nums[i] > 0?", note: "true→сложить · false→пропуск" },
      { title: "i++", code: "выполняется всегда", note: "назад к тесту while" },
    ],
    back: "обратный переход",
    foot1: "i++ выполняется на каждой итерации — даже когда if пропускает",
    foot2: "каждый элемент посещается ровно один раз",
    caption:
      "Каждая итерация sumPositives — это три момента управления потоком: тест while (i < length?), тест if (nums[i] > 0) и i++ с обратным переходом к тесту while. i++ выполняется на каждой итерации — даже когда if пропускает, — поэтому каждый элемент посещается ровно один раз.",
  },
};

const t = dict[lang];
const boxX = [40, 290, 540];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.boxes.map((b, i) => (
      <g>
        <text x={boxX[i] + 110} y="135" text-anchor="middle" font-size="11" fill="var(--muted)">{i + 1}</text>
        <rect x={boxX[i]} y="150" width="220" height="100" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={boxX[i] + 110} y="182" text-anchor="middle" font-size="13" fill="var(--ink)">{b.title}</text>
        <text x={boxX[i] + 110} y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{b.code}</text>
        <text x={boxX[i] + 110} y="230" text-anchor="middle" font-size="11" fill="var(--muted)">{b.note}</text>
      </g>
    ))}

    <line x1="260" y1="200" x2="282" y2="200" stroke="var(--ink)" stroke-width="1.6" />
    <polygon points="280,195 280,205 290,200" fill="var(--ink)" />
    <line x1="510" y1="200" x2="532" y2="200" stroke="var(--ink)" stroke-width="1.6" />
    <polygon points="530,195 530,205 540,200" fill="var(--ink)" />

    <line x1="650" y1="250" x2="650" y2="300" stroke="var(--accent)" stroke-width="1.6" />
    <line x1="650" y1="300" x2="150" y2="300" stroke="var(--accent)" stroke-width="1.6" />
    <line x1="150" y1="300" x2="150" y2="258" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="144,258 156,258 150,250" fill="var(--accent)" />
    <text x="400" y="292" text-anchor="middle" font-size="11" fill="var(--muted)">{t.back}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
