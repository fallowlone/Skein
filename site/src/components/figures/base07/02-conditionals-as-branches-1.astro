---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Flags register: Z, N and C single-bit answers set by CMP",
    headline: "FLAGS: ONE BIT PER QUESTION",
    sub: "flags register · written by CMP",
    mid: "three single-bit answers",
    zName: "zero flag",
    zWhen: "result was 0 → 1",
    nName: "negative flag",
    nWhen: "result < 0 → 1",
    cName: "carry flag",
    cWhen: "carry out → 1",
    foot1: "LOAD and STORE never set flags",
    foot2: "each bit answers one yes/no question",
    caption:
      "The flags register holds single-bit answers: Z (zero) is 1 when the last result was zero, N (negative) is 1 when it was negative, C (carry) is 1 on unsigned carry-out. CMP updates them; LOAD and STORE never do.",
  },
  ru: {
    svgTitle: "Регистр флагов: однобитные ответы Z, N и C, которые ставит CMP",
    headline: "ФЛАГИ: ОДИН БИТ — ОДИН ВОПРОС",
    sub: "регистр флагов · записывает CMP",
    mid: "три однобитных ответа",
    zName: "флаг нуля",
    zWhen: "результат 0 → 1",
    nName: "флаг знака",
    nWhen: "результат < 0 → 1",
    cName: "флаг переноса",
    cWhen: "перенос был → 1",
    foot1: "LOAD и STORE флаги не ставят",
    foot2: "каждый бит — ответ «да/нет»",
    caption:
      "Регистр флагов хранит однобитные ответы: Z (флаг нуля) равен 1, если последний результат — ноль, N (флаг знака) равен 1, если результат отрицательный, C (флаг переноса) равен 1 при беззнаковом переносе. CMP обновляет их; LOAD и STORE — никогда.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="92" text-anchor="middle" font-size="12" fill="var(--muted)">{t.mid}</text>

    <rect x="20" y="110" width="240" height="140" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="140" y="168" text-anchor="middle" font-size="40" fill="var(--accent)">Z</text>
    <text x="140" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.zName}</text>
    <text x="140" y="222" text-anchor="middle" font-size="11" fill="var(--ink)">{t.zWhen}</text>

    <rect x="280" y="110" width="240" height="140" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="168" text-anchor="middle" font-size="40" fill="var(--accent)">N</text>
    <text x="400" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.nName}</text>
    <text x="400" y="222" text-anchor="middle" font-size="11" fill="var(--ink)">{t.nWhen}</text>

    <rect x="540" y="110" width="240" height="140" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="660" y="168" text-anchor="middle" font-size="40" fill="var(--accent)">C</text>
    <text x="660" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cName}</text>
    <text x="660" y="222" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cWhen}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
