---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Loop exit: i=3 fails the while test, control jumps forward to return sum = 7",
    headline: "EXIT LIVES AT THE TOP",
    sub: "i = 3: the while test is false, jump forward",
    body: "loop body",
    wtitle: "while test",
    wsub: "i = 3 < 3 → false",
    trueLab: "true",
    falseLab: "false: exit",
    rtitle: "return sum",
    rval: "= 7",
    finalLab: "final state",
    final: ["sum = 7", "i = 3", "length = 3"],
    foot1: "only the while test can end the loop",
    foot2: "sum = 7: only 3 and 4 were added; -1 was skipped",
    caption:
      "The loop exits only at the top: when i reaches 3, the while test i < 3 is false, the backward jump stays cold, and control jumps forward to return sum = 7. Only 3 and 4 were added; -1 was skipped.",
  },
  ru: {
    svgTitle: "Выход из цикла: i=3 проваливает тест while, управление прыгает вперёд к return sum = 7",
    headline: "ВЫХОД ЖИВЁТ НАВЕРХУ",
    sub: "i = 3: тест while ложен, прыжок вперёд",
    body: "тело цикла",
    wtitle: "тест while",
    wsub: "i = 3 < 3 → false",
    trueLab: "true",
    falseLab: "false: выход",
    rtitle: "return sum",
    rval: "= 7",
    finalLab: "финальное состояние",
    final: ["sum = 7", "i = 3", "length = 3"],
    foot1: "закончить цикл может только тест while",
    foot2: "sum = 7: только 3 и 4; -1 пропущен",
    caption:
      "Цикл выходит только наверху: когда i достигает 3, тест while i < 3 ложен, обратный переход остаётся холодным, а управление прыгает вперёд к return sum = 7. Только 3 и 4 были добавлены; -1 был пропущен.",
  },
};

const t = dict[lang];
const finalX = [150, 330, 510];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="140" y="80" width="160" height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="1.6" />
    <text x="220" y="103" text-anchor="middle" font-size="11" fill="var(--ink)">{t.body}</text>

    <rect x="90" y="160" width="260" height="90" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="220" y="192" text-anchor="middle" font-size="13" fill="var(--ink)">{t.wtitle}</text>
    <text x="220" y="214" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wsub}</text>

    <line x1="220" y1="160" x2="220" y2="124" stroke="var(--ink)" stroke-width="1.6" />
    <polygon points="214,124 226,124 220,116" fill="var(--ink)" />
    <text x="232" y="142" font-size="11" fill="var(--muted)">{t.trueLab}</text>

    <line x1="350" y1="205" x2="482" y2="205" stroke="var(--accent)" stroke-width="2" />
    <polygon points="480,200 480,210 490,205" fill="var(--accent)" />
    <text x="420" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.falseLab}</text>

    <rect x="490" y="160" width="220" height="90" fill="var(--card)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="600" y="192" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rtitle}</text>
    <text x="600" y="216" text-anchor="middle" font-size="18" fill="var(--ink)">{t.rval}</text>

    <text x="400" y="282" text-anchor="middle" font-size="11" fill="var(--muted)">{t.finalLab}</text>
    {t.final.map((c, i) => (
      <g>
        <rect x={finalX[i]} y="292" width="140" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="1.4" />
        <text x={finalX[i] + 70} y="317" text-anchor="middle" font-size="12" fill="var(--ink)">{c}</text>
      </g>
    ))}

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
