---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "CMP R0, R1 computes R0 minus R1, discards it, and sets flags",
    headline: "CMP SUBTRACTS, THEN DISCARDS",
    sub: "CMP R0, R1 → flags only",
    mid: "CMP computes R0 − R1, then throws the number away",
    row1: "R0 = R1 · 7 − 7 = 0",
    row1Flags: "Z = 1",
    row2: "R0 < R1 · 3 − 9 = −6",
    row2Flags: "Z = 0, N = 1",
    row3: "R0 > R1 · result > 0",
    row3Flags: "Z = 0, N = 0",
    foot1: "only the flags register changes",
    foot2: "R0 and R1 keep their values",
    caption:
      "CMP R0, R1 computes R0 − R1 and discards the number, keeping only flags: equal inputs set Z = 1, R0 < R1 sets N = 1, R0 > R1 leaves Z = 0 and N = 0. R0 and R1 keep their values.",
  },
  ru: {
    svgTitle: "CMP R0, R1 вычисляет R0 минус R1, отбрасывает и ставит флаги",
    headline: "CMP ВЫЧИТАЕТ И ОТБРАСЫВАЕТ",
    sub: "CMP R0, R1 → только флаги",
    mid: "CMP вычисляет R0 − R1 и выбрасывает число",
    row1: "R0 = R1 · 7 − 7 = 0",
    row1Flags: "Z = 1",
    row2: "R0 < R1 · 3 − 9 = −6",
    row2Flags: "Z = 0, N = 1",
    row3: "R0 > R1 · результат > 0",
    row3Flags: "Z = 0, N = 0",
    foot1: "меняется только регистр флагов",
    foot2: "R0 и R1 сохраняют свои значения",
    caption:
      "CMP R0, R1 вычисляет R0 − R1 и отбрасывает число, оставляя только флаги: равные входы ставят Z = 1, R0 < R1 ставит N = 1, R0 > R1 оставляет Z = 0 и N = 0. R0 и R1 сохраняют свои значения.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="88" text-anchor="middle" font-size="12" fill="var(--muted)">{t.mid}</text>

    <rect x="90" y="100" width="620" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <line x1="450" y1="100" x2="450" y2="156" stroke="var(--ink)" stroke-width="1" />
    <text x="120" y="135" font-size="13" fill="var(--ink)">{t.row1}</text>
    <text x="680" y="135" text-anchor="end" font-size="13" fill="var(--accent)">{t.row1Flags}</text>

    <rect x="90" y="168" width="620" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <line x1="450" y1="168" x2="450" y2="224" stroke="var(--ink)" stroke-width="1" />
    <text x="120" y="203" font-size="13" fill="var(--ink)">{t.row2}</text>
    <text x="680" y="203" text-anchor="end" font-size="13" fill="var(--accent)">{t.row2Flags}</text>

    <rect x="90" y="236" width="620" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <line x1="450" y1="236" x2="450" y2="292" stroke="var(--ink)" stroke-width="1" />
    <text x="120" y="271" font-size="13" fill="var(--ink)">{t.row3}</text>
    <text x="680" y="271" text-anchor="end" font-size="13" fill="var(--accent)">{t.row3Flags}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
