---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Execution flow is the sequence of PC values over time",
    headline: "FLOW IS THE PC SEQUENCE",
    sub: "bytes stay put · the PC moves",
    memCol: "memory cells (fixed)",
    pcCol: "PC at each fetch",
    mem: ["200 · LOAD R0,50", "204 · ADD R0,R1", "208 · STORE R0,60"],
    pcs: ["PC = 200", "PC = 204", "PC = 208"],
    fetch: "fetch",
    foot1: "bytes are fixed; the flow is dynamic",
    foot2: "flow = which address the PC holds at each fetch",
    caption:
      "Execution flow is the sequence of program-counter values over time: the instruction bytes sit fixed in memory at 200, 204, and 208, while the PC points to 200, then 204, then 208. The same bytes can run with a different flow if the PC is steered differently.",
  },
  ru: {
    svgTitle: "Поток выполнения — это значения СК во времени",
    headline: "ПОТОК — ЭТО ЗНАЧЕНИЯ СК",
    sub: "байты на месте · движется СК",
    memCol: "ячейки памяти (те же)",
    pcCol: "СК на каждой выборке",
    mem: ["200 · LOAD R0,50", "204 · ADD R0,R1", "208 · STORE R0,60"],
    pcs: ["СК = 200", "СК = 204", "СК = 208"],
    fetch: "выборка",
    foot1: "байты фиксированы; поток динамичен",
    foot2: "поток — адрес в СК на каждой выборке",
    caption:
      "Поток выполнения — это последовательность значений счётчика команд во времени: байты инструкций неподвижно лежат в памяти по адресам 200, 204 и 208, а СК указывает на 200, затем на 204, затем на 208. Те же байты могут исполняться с другим потоком, если направлять СК иначе.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="195" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.memCol}</text>
    <text x="605" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.pcCol}</text>

    {t.mem.map((m, i) => (
      <g>
        <rect x="90" y={120 + i * 75} width="210" height="54" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="195" y={153 + i * 75} text-anchor="middle" font-size="13" fill="var(--ink)">{m}</text>
        <rect x="500" y={120 + i * 75} width="210" height="54" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x="605" y={153 + i * 75} text-anchor="middle" font-size="13" fill="var(--ink)">{t.pcs[i]}</text>
        <line x1="500" y1={147 + i * 75} x2="304" y2={147 + i * 75} stroke="var(--accent)" stroke-width="1.6" />
        <polygon points={`301,${147 + i * 75} 309,${142 + i * 75} 309,${152 + i * 75}`} fill="var(--accent)" />
        <text x="400" y={139 + i * 75} text-anchor="middle" font-size="11" fill="var(--muted)">{t.fetch}</text>
      </g>
    ))}

    <line x1="605" y1="174" x2="605" y2="190" stroke="var(--muted)" stroke-width="1.6" />
    <polygon points="605,194 600,186 610,186" fill="var(--muted)" />
    <text x="620" y="190" font-size="11" fill="var(--muted)">+4</text>
    <line x1="605" y1="249" x2="605" y2="265" stroke="var(--muted)" stroke-width="1.6" />
    <polygon points="605,269 600,261 610,261" fill="var(--muted)" />
    <text x="620" y="265" font-size="11" fill="var(--muted)">+4</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
