---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "JNE 116 reads the Z bit: fall through to 108 or jump to 116",
    headline: "ONE BIT PICKS THE ROAD",
    sub: "JNE 116 reads one bit: Z",
    addrCmp: "100: CMP R0, R1",
    addrJne: "104: JNE 116",
    addrTrue: "108: STORE · if-true",
    addrElse: "116: STORE · if-false",
    fallLabel: "Z=1 → fall through",
    jumpLabel: "Z=0 → jump",
    foot1: "if/else: two destinations for the PC",
    foot2: "fall through = the absence of a jump",
    caption:
      "JNE 116 reads the single Z bit: Z = 1 means equal, so the CPU falls through to STORE at 108 (if-true); Z = 0 means not equal, so the PC jumps to STORE at 116 (else). An if/else is two destinations for the program counter.",
  },
  ru: {
    svgTitle: "JNE 116 читает бит Z: продолжение к 108 или прыжок на 116",
    headline: "ОДИН БИТ ВЫБЕРЕТ ДОРОГУ",
    sub: "JNE 116 читает один бит: Z",
    addrCmp: "100: CMP R0, R1",
    addrJne: "104: JNE 116",
    addrTrue: "108: STORE · if-true",
    addrElse: "116: STORE · if-false",
    fallLabel: "Z=1 → fall-through",
    jumpLabel: "Z=0 → прыжок",
    foot1: "if/else — два пункта назначения СК",
    foot2: "fall-through — отсутствие перехода",
    caption:
      "JNE 116 читает единственный бит Z: Z = 1 означает «равно», и CPU продолжает без перехода к STORE по адресу 108 (if-true); Z = 0 означает «не равно», и СК прыгает к STORE по адресу 116 (else). if/else — это два пункта назначения для счётчика команд.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="150" y="96" width="280" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="290" y="124" text-anchor="middle" font-size="13" fill="var(--ink)">{t.addrCmp}</text>

    <rect x="150" y="152" width="280" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="290" y="180" text-anchor="middle" font-size="13" fill="var(--ink)">{t.addrJne}</text>

    <rect x="150" y="218" width="280" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="290" y="246" text-anchor="middle" font-size="13" fill="var(--ink)">{t.addrTrue}</text>

    <rect x="150" y="274" width="280" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="290" y="302" text-anchor="middle" font-size="13" fill="var(--ink)">{t.addrElse}</text>

    <line x1="290" y1="196" x2="290" y2="210" stroke="var(--accent)" stroke-width="2" />
    <polygon points="284,210 296,210 290,218" fill="var(--accent)" />
    <text x="305" y="213" font-size="11" fill="var(--muted)">{t.fallLabel}</text>

    <polyline points="430,174 600,174 600,296 442,296" fill="none" stroke="var(--accent)" stroke-width="2" />
    <polygon points="442,290 442,302 430,296" fill="var(--accent)" />
    <text x="612" y="240" font-size="11" fill="var(--muted)">{t.jumpLabel}</text>

    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="370" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
