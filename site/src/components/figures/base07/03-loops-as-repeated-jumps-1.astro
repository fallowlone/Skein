---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Backward jump: JUMP 104 from 116 sets the PC to an earlier address",
    headline: "BACKWARD JUMP: PC TO AN EARLIER ADDRESS",
    sub: "JUMP 104 from 116 · negative offset = backward",
    legendTitle: "offset sign",
    legendFwd: "offset > 0 → forward",
    legendBack: "offset < 0 → backward",
    earlier: "earlier address",
    jumpSite: "jump is here",
    pcBack: "PC ← 104",
    backLabel: "backward jump",
    foot1: "same JUMP opcode — only the offset sign differs",
    foot2: "PC ← 104: CPU re-executes everything from 104 to 116",
    caption:
      "A backward jump sets the program counter to an address smaller than the jump instruction's own address: JUMP 104 executed at 116 resets the PC to 104, so the CPU re-executes everything between. It is the same JUMP opcode as a forward jump — only the target offset is negative instead of positive.",
  },
  ru: {
    svgTitle: "Обратный переход: JUMP 104 из 116 ставит СК на более ранний адрес",
    headline: "ОБРАТНЫЙ ПЕРЕХОД: СК НА РАННИЙ АДРЕС",
    sub: "JUMP 104 из 116 · отрицательное смещение = назад",
    legendTitle: "знак смещения",
    legendFwd: "смещение > 0 → вперёд",
    legendBack: "смещение < 0 → назад",
    earlier: "более ранний адрес",
    jumpSite: "переход здесь",
    pcBack: "СК ← 104",
    backLabel: "обратный переход",
    foot1: "тот же опкод JUMP — отличается лишь знак смещения",
    foot2: "СК ← 104: CPU заново выполняет всё с 104 по 116",
    caption:
      "Обратный переход устанавливает счётчик команд на адрес, меньший адреса самой инструкции перехода: JUMP 104, выполненный по адресу 116, сбрасывает СК на 104, и CPU заново выполняет всё между ними. Это тот же опкод JUMP, что и у прямого перехода, — только смещение цели отрицательное, а не положительное.",
  },
};

const t = dict[lang];

const rows = [
  { y: 104, label: "104  CMP R0,0", hot: false },
  { y: 152, label: "108  JE 120", hot: false },
  { y: 200, label: "112  SUB R0,1", hot: false },
  { y: 248, label: "116  JUMP 104", hot: true },
];

const gaps = [144, 192, 240];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="56" y="150" width="190" height="112" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="151" y="174" text-anchor="middle" font-size="11" fill="var(--muted)">{t.legendTitle}</text>
    <text x="151" y="202" text-anchor="middle" font-size="11" fill="var(--ink)">{t.legendFwd}</text>
    <text x="151" y="230" text-anchor="middle" font-size="11" fill="var(--ink)">{t.legendBack}</text>

    <text x="262" y="128" text-anchor="end" font-size="11" fill="var(--muted)">{t.earlier}</text>
    <text x="262" y="272" text-anchor="end" font-size="11" fill="var(--muted)">{t.jumpSite}</text>

    {rows.map((r) => (
      <g>
        <rect x="290" y={r.y} width="220" height="40" fill="var(--card)" stroke={r.hot ? "var(--accent)" : "var(--ink)"} stroke-width={r.hot ? 2.5 : 1.5} />
        <text x="400" y={r.y + 25} text-anchor="middle" font-size="12" fill="var(--ink)">{r.label}</text>
      </g>
    ))}

    {gaps.map((gy) => (
      <g>
        <line x1="400" y1={gy} x2="400" y2={gy + 8} stroke="var(--muted)" stroke-width="1.5" />
        <polygon points={`400,${gy + 8} 395,${gy + 1} 405,${gy + 1}`} fill="var(--muted)" />
      </g>
    ))}

    <line x1="510" y1="268" x2="566" y2="268" stroke="var(--accent)" stroke-width="2" />
    <line x1="566" y1="268" x2="566" y2="124" stroke="var(--accent)" stroke-width="2" />
    <line x1="566" y1="124" x2="510" y2="124" stroke="var(--accent)" stroke-width="2" />
    <polygon points="510,124 521,119 521,129" fill="var(--accent)" />

    <text x="662" y="188" text-anchor="middle" font-size="13" fill="var(--ink)">{t.pcBack}</text>
    <text x="662" y="210" text-anchor="middle" font-size="11" fill="var(--muted)">{t.backLabel}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
