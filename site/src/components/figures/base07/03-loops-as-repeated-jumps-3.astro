---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Infinite loop: no condition, or a condition that never becomes false",
    headline: "INFINITE LOOP: THE JUMP NEVER STOPS",
    sub: "two causes · the backward jump always fires",
    cause1: "1 · no condition at all",
    body: "body",
    jumpNoCmp: "JUMP top · no CMP",
    whileTrue: "while (true) · server loops",
    cause2: "2 · test never turns false",
    stuck: "R0 = 10 · stuck",
    cmpSame: "CMP sees 10 · Z = 0",
    jeNever: "JE never fires",
    backAlways: "jump back always fires",
    neverChanges: "body never changes R0",
    foot1: "not a hardware fault — the CPU obeys the code",
    foot2: "runs until the OS or an interrupt stops it",
    caption:
      "A loop runs forever when the backward jump never stops: either there is no condition at all — while (true) compiles to a plain JUMP with no CMP, used intentionally in server loops — or the test exists but the body never changes the compared values, so CMP always sees the same value and the exit jump never fires. The countdown-from-10 loop with a stuck counter is the classic example.",
  },
  ru: {
    svgTitle: "Бесконечный цикл: нет условия или условие никогда не становится ложным",
    headline: "БЕСКОНЕЧНЫЙ ЦИКЛ: ПЕРЕХОД НЕ ОСТАНАВЛИВАЕТСЯ",
    sub: "две причины · обратный переход срабатывает всегда",
    cause1: "1 · условия нет вообще",
    body: "тело",
    jumpNoCmp: "JUMP наверх · без CMP",
    whileTrue: "while (true) · серверные циклы",
    cause2: "2 · тест никогда не ложен",
    stuck: "R0 = 10 · застрял",
    cmpSame: "CMP видит 10 · Z = 0",
    jeNever: "JE не срабатывает",
    backAlways: "прыжок назад — всегда",
    neverChanges: "тело не меняет R0",
    foot1: "не сбой железа — CPU выполняет код",
    foot2: "работает, пока не остановит ОС или прерывание",
    caption:
      "Цикл работает вечно, когда обратный переход не останавливается: либо условия нет вообще — while (true) компилируется в простой JUMP без CMP, что намеренно используется в серверных циклах, — либо тест есть, но тело никогда не меняет сравниваемые значения, поэтому CMP всегда видит одно значение, а выходной переход не срабатывает. Классический пример — отсчёт от 10 с застрявшим счётчиком.",
  },
};

const t = dict[lang];

const rightLines = [t.stuck, t.cmpSame, t.jeNever, t.backAlways];
const rightY = [152, 180, 208, 236];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="96" width="330" height="204" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="205" y="122" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cause1}</text>

    <rect x="140" y="140" width="150" height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="215" y="163" text-anchor="middle" font-size="11" fill="var(--ink)">{t.body}</text>
    <rect x="140" y="200" width="150" height="36" fill="var(--card)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="215" y="223" text-anchor="middle" font-size="11" fill="var(--ink)">{t.jumpNoCmp}</text>

    <line x1="215" y1="176" x2="215" y2="200" stroke="var(--ink)" stroke-width="1.5" />
    <polygon points="215,200 210,192 220,192" fill="var(--ink)" />

    <line x1="140" y1="218" x2="100" y2="218" stroke="var(--accent)" stroke-width="2" />
    <line x1="100" y1="218" x2="100" y2="158" stroke="var(--accent)" stroke-width="2" />
    <line x1="100" y1="158" x2="140" y2="158" stroke="var(--accent)" stroke-width="2" />
    <polygon points="140,158 130,153 130,163" fill="var(--accent)" />

    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.whileTrue}</text>

    <rect x="430" y="96" width="330" height="204" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="595" y="122" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cause2}</text>

    {rightLines.map((line, i) => (
      <text x="595" y={rightY[i]} text-anchor="middle" font-size="12" fill={i === 3 ? "var(--accent)" : "var(--ink)"}>{line}</text>
    ))}

    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.neverChanges}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
