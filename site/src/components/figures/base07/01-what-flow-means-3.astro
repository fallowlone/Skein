---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Only a jump overwrites the PC: default plus 4 versus jump to target",
    headline: "JUMP IS THE ONLY OVERRIDE",
    sub: "default: PC += 4 · JUMP: PC = target",
    laneA: "ordinary instruction",
    boxA: "ADD @ 200 (no jump)",
    lblA: "+4 (default)",
    chipA: "PC = 204",
    laneB: "jump instruction",
    boxB: "JUMP 100 @ 200",
    lblB: "overwrite",
    chipB: "PC = 100",
    foot1: "branch = conditional jump · loop = backward jump",
    foot2: "only a PC rewrite breaks the straight line",
    caption:
      "An ordinary instruction at 200 lets the PC advance to 204, but a JUMP overwrites the PC with its target, so the next fetch comes from 100. A branch is a conditional jump and a loop is a backward jump — every deviation is one instruction rewriting the PC.",
  },
  ru: {
    svgTitle: "Только переход перезаписывает СК: умолчание плюс 4 против перехода к адресу",
    headline: "JUMP — ЕДИНСТВЕННОЕ ПЕРЕОПРЕДЕЛЕНИЕ",
    sub: "умолчание: СК += 4 · JUMP: СК = адрес",
    laneA: "обычная инструкция",
    boxA: "ADD @ 200 (без перехода)",
    lblA: "+4 (умолчание)",
    chipA: "СК = 204",
    laneB: "инструкция перехода",
    boxB: "JUMP 100 @ 200",
    lblB: "перезапись",
    chipB: "СК = 100",
    foot1: "ветвление — условный переход · цикл — обратный",
    foot2: "только перезапись СК ломает прямую линию",
    caption:
      "Обычная инструкция по адресу 200 даёт СК продвинуться к 204, а JUMP перезаписывает СК адресом назначения, и следующая выборка приходит из 100. Ветвление — условный переход, цикл — обратный переход: любое отклонение — это одна инструкция, переписавшая СК.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="230" y="115" text-anchor="middle" font-size="11" fill="var(--muted)">{t.laneA}</text>
    <rect x="120" y="130" width="220" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="230" y="163" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxA}</text>
    <line x1="340" y1="158" x2="466" y2="158" stroke="var(--muted)" stroke-width="1.6" />
    <polygon points="469,158 461,153 461,163" fill="var(--muted)" />
    <text x="405" y="150" text-anchor="middle" font-size="11" fill="var(--muted)">{t.lblA}</text>
    <rect x="470" y="130" width="210" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="575" y="163" text-anchor="middle" font-size="13" fill="var(--ink)">{t.chipA}</text>

    <text x="230" y="230" text-anchor="middle" font-size="11" fill="var(--muted)">{t.laneB}</text>
    <rect x="120" y="245" width="220" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="230" y="278" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxB}</text>
    <line x1="340" y1="273" x2="466" y2="273" stroke="var(--accent)" stroke-width="2" />
    <polygon points="469,273 461,268 461,278" fill="var(--accent)" />
    <text x="405" y="265" text-anchor="middle" font-size="11" fill="var(--muted)">{t.lblB}</text>
    <rect x="470" y="245" width="210" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="575" y="278" text-anchor="middle" font-size="13" fill="var(--ink)">{t.chipB}</text>

    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="376" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
