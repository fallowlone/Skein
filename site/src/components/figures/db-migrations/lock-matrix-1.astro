---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Postgres lock ladder: eight modes from ACCESS SHARE to ACCESS EXCLUSIVE; SELECT weakest, ALTER strongest, CONCURRENTLY in the DML-safe middle",
    headline: "EIGHT LOCKS, ONE RULE",
    sub: "weakest at top — strongest at bottom",
    modes: ["ACCESS SHARE", "ROW SHARE", "ROW EXCLUSIVE", "SHARE UPDATE EXCLUSIVE", "SHARE", "SHARE ROW EXCLUSIVE", "EXCLUSIVE", "ACCESS EXCLUSIVE"],
    holders: ["SELECT", "—", "—", "CONCURRENTLY · VALIDATE", "—", "—", "—", "ALTER · DROP · TRUNCATE"],
    foot: "ACCESS EXCLUSIVE conflicts with everything — even ACCESS SHARE",
    caption:
      "Postgres orders eight lock modes from ACCESS SHARE to ACCESS EXCLUSIVE; SELECT takes the weakest, most DDL the strongest, CONCURRENTLY and VALIDATE the DML-safe middle — and the strongest conflicts with everything.",
  },
  ru: {
    svgTitle: "Лестница блокировок Postgres: восемь режимов от ACCESS SHARE до ACCESS EXCLUSIVE; SELECT слабейший, ALTER сильнейший, CONCURRENTLY в DML-безопасной середине",
    headline: "ВОСЕМЬ БЛОКИРОВОК, ОДНО ПРАВИЛО",
    sub: "слабейшая сверху — сильнейшая снизу",
    modes: ["ACCESS SHARE", "ROW SHARE", "ROW EXCLUSIVE", "SHARE UPDATE EXCLUSIVE", "SHARE", "SHARE ROW EXCLUSIVE", "EXCLUSIVE", "ACCESS EXCLUSIVE"],
    holders: ["SELECT", "—", "—", "CONCURRENTLY · VALIDATE", "—", "—", "—", "ALTER · DROP · TRUNCATE"],
    foot: "ACCESS EXCLUSIVE конфликтует со всем — даже с ACCESS SHARE",
    caption:
      "Postgres упорядочивает восемь режимов от ACCESS SHARE до ACCESS EXCLUSIVE; SELECT берёт слабейший, большинство DDL — сильнейший, CONCURRENTLY и VALIDATE — DML-безопасную середину, — а сильнейший конфликтует со всем.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-ladder-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.modes.map((m, i) => (
      <g>
        <rect x="60" y={100 + i * 30} width="260" height="26" fill={i === 7 ? "var(--paper)" : "var(--card)"} stroke={i === 0 ? "var(--accent)" : i === 7 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 0 ? 2 : i === 7 ? 2.5 : 1.5} />
        <text x="190" y={118 + i * 30} text-anchor="middle" font-size="11" fill="var(--ink)">{m}</text>
        <text x="340" y={118 + i * 30} font-size="11" fill={i === 0 ? "var(--ink)" : i === 3 ? "var(--ink)" : i === 7 ? "var(--ink)" : "var(--muted)"}>{t.holders[i]}</text>
      </g>
    ))}

    <line x1="700" y1="112" x2="700" y2="328" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-ladder-arrow)" />
    <line x1="700" y1="328" x2="700" y2="112" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-ladder-arrow)" />

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
