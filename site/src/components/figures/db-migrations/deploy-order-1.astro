---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Deploy order flips with direction: additive change runs migration first, removal deploys code first and drains",
    headline: "DEPLOY ORDER FLIPS WITH DIRECTION",
    sub: "additive: migration first · removal: code first",
    laneA: "ADDITIVE · new column",
    stepsA: ["1 · migrate", "2 · deploy code"],
    verdictA: "safe — old ignores · new finds ready",
    laneB: "REMOVAL · drop column",
    stepsB: ["1 · deploy code", "2 · drain old", "3 · migrate"],
    verdictB: "safe — old drained · no missing column",
    foot: "schema and code must match at every moment of the deploy",
    caption:
      "Additive change runs migration first so new code finds its column; removal deploys code first and drains old pods so no in-flight request hits a dropped column — the safe order flips with the change direction.",
  },
  ru: {
    svgTitle: "Порядок деплоя зависит от направления: добавление запускает миграцию первой, удаление сначала деплоит код и сливает старый",
    headline: "ПОРЯДОК ДЕПЛОЯ ЗАВИСИТ ОТ НАПРАВЛЕНИЯ",
    sub: "добавление: сначала миграция · удаление: сначала код",
    laneA: "ДОБАВЛЕНИЕ · колонка",
    stepsA: ["1 · миграция", "2 · деплой кода"],
    verdictA: "безопасно — старый игнорирует · новый находит готовой",
    laneB: "УДАЛЕНИЕ · дроп",
    stepsB: ["1 · деплой кода", "2 · слив старого", "3 · миграция"],
    verdictB: "безопасно — старый сдренирован · колонка на месте",
    foot: "схема и код должны совпадать в каждый момент деплоя",
    caption:
      "Аддитивное изменение запускает миграцию первой, чтобы новый код нашёл колонку; удаление сначала деплоит код и сливает старые поды, чтобы ни один запрос не попал в дропнутую колонку, — безопасный порядок меняется с направлением.",
  },
};

const t = dict[lang];

const stepAX = [270, 480];
const stepBX = [250, 410, 570];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-order-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="95" width="720" height="118" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="60" y="123" font-size="13" fill="var(--ink)">{t.laneA}</text>
    {t.stepsA.map((s, i) => (
      <g>
        <rect x={stepAX[i]} y="140" width="150" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
        <text x={stepAX[i] + 75} y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{s}</text>
      </g>
    ))}
    <line x1="420" y1="162" x2="480" y2="162" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-order-arrow)" />
    <text x="400" y="203" text-anchor="middle" font-size="12" fill="var(--muted)">{t.verdictA}</text>

    <rect x="40" y="226" width="720" height="118" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="60" y="254" font-size="13" fill="var(--ink)">{t.laneB}</text>
    {t.stepsB.map((s, i) => (
      <g>
        <rect x={stepBX[i]} y="268" width="140" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
        <text x={stepBX[i] + 70} y="296" text-anchor="middle" font-size="12" fill="var(--ink)">{s}</text>
      </g>
    ))}
    <line x1="390" y1="290" x2="410" y2="290" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-order-arrow)" />
    <line x1="550" y1="290" x2="570" y2="290" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-order-arrow)" />
    <text x="400" y="333" text-anchor="middle" font-size="12" fill="var(--muted)">{t.verdictB}</text>

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
