---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "PG 11 fast path: constant default stored once in pg_attribute as atthasmissing and attmissingval, old heap rows never rewritten",
    headline: "ADD COLUMN: METADATA, NOT ROWS",
    sub: "constant default lives in pg_attribute since PG 11",
    heapTitle: "heap · 100M rows untouched",
    oldRow: "old row — synthesised at read",
    newRow: "new row — stored normally",
    catNote: "one catalog row — not 100M rewrites",
    readNote: "SELECT reads attmissingval — no row rewritten",
    foot: "lock held milliseconds — not minutes per 100M rows",
    caption:
      "Since PG 11 a constant default is one catalog entry — atthasmissing with attmissingval — so old heap rows are never rewritten and SELECT synthesises the value; the lock lasts milliseconds instead of minutes per 100M rows.",
  },
  ru: {
    svgTitle: "Быстрый путь PG 11: константный дефолт хранится один раз в pg_attribute как atthasmissing и attmissingval, старые heap-строки не переписываются",
    headline: "ADD COLUMN: МЕТАДАННЫЕ, А НЕ СТРОКИ",
    sub: "константный дефолт живёт в pg_attribute с PG 11",
    heapTitle: "heap · 100M строк не тронуты",
    oldRow: "старая строка — синтез при чтении",
    newRow: "новая строка — хранится обычно",
    catNote: "одна строка каталога — не 100M перезаписей",
    readNote: "SELECT читает attmissingval — строки не переписываются",
    foot: "блокировка держится миллисекунды — не минуты на 100M строк",
    caption:
      "Начиная с PG 11 константный дефолт — одна запись каталога: atthasmissing с attmissingval, — поэтому старые heap-строки никогда не переписываются, а SELECT синтезирует значение; блокировка длится миллисекунды вместо минут на 100M строк.",
  },
};

const t = dict[lang];

const heapY = [150, 192, 234];
const kind = [true, true, false];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-fast-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="300" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="190" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">pg_attribute</text>
    <rect x="60" y="146" width="260" height="40" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="190" y="171" text-anchor="middle" font-size="11" fill="var(--ink)">atthasmissing = true</text>
    <rect x="60" y="196" width="260" height="40" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="190" y="221" text-anchor="middle" font-size="11" fill="var(--ink)">attmissingval = 'pending'</text>
    <text x="190" y="266" text-anchor="middle" font-size="11" fill="var(--muted)">{t.catNote}</text>

    <line x1="340" y1="200" x2="460" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-fast-arrow)" />

    <rect x="460" y="100" width="300" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="610" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.heapTitle}</text>
    {heapY.map((_, i) => (
      <g>
        <rect x="480" y={heapY[i]} width="260" height="34" fill={kind[i] ? "var(--card)" : "var(--paper)"} stroke={kind[i] ? "var(--muted)" : "var(--accent)"} stroke-width={kind[i] ? 1.5 : 2} />
        <text x="610" y={heapY[i] + 23} text-anchor="middle" font-size="11" fill={kind[i] ? "var(--muted)" : "var(--ink)"}>{kind[i] ? t.oldRow : t.newRow}</text>
      </g>
    ))}

    <text x="400" y="340" text-anchor="middle" font-size="12" fill="var(--ink)">{t.readNote}</text>
    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
