---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "FIFO lock queue: slow SELECT 60 s holds, ALTER waits from T=10 s, new SELECTs queue behind it, 8 ms migration freezes table 60 s",
    headline: "FIFO: ONE WAITER FREEZES THE TABLE",
    sub: "new SELECTs queue BEHIND the waiting ALTER",
    colT: ["T = 0s", "T = 10s", "T = 70s"],
    colD: ["slow SELECT · 60 s", "ALTER waits · timeout 0", "ALTER 8 ms · drains"],
    colL: ["ACCESS SHARE held", "ACCESS EXCL waiting", "granted · queue clears"],
    queueNote: "queue order — FIFO, no skipping ahead",
    qChips: ["SELECT · 60 s", "ALTER · waiting", "new SELECTs · wait"],
    foot: "8 ms migration · 60 s freeze",
    caption:
      "At T=0 a slow SELECT holds ACCESS SHARE for 60 s; at T=10 the ALTER requests ACCESS EXCLUSIVE and waits; every new SELECT queues behind it — the 8 ms migration freezes the table for the full 60 s until the slow query releases.",
  },
  ru: {
    svgTitle: "FIFO-очередь блокировок: медленный SELECT 60 с держит, ALTER ждёт с T=10 с, новые SELECT встают за ним, миграция 8 мс морозит таблицу 60 с",
    headline: "FIFO: ОДИН ОЖИДАЮЩИЙ МОРОЗИТ ТАБЛИЦУ",
    sub: "новые SELECT встают ЗА ожидающим ALTER",
    colT: ["T = 0с", "T = 10с", "T = 70с"],
    colD: ["медленный SELECT · 60 с", "ALTER ждёт · таймаут 0", "ALTER 8 мс · сход"],
    colL: ["ACCESS SHARE держится", "ACCESS EXCL ждёт", "выдан · очередь сходит"],
    queueNote: "порядок очереди — FIFO, обгона нет",
    qChips: ["SELECT · 60 с", "ALTER · ждёт", "новые SELECT · ждут"],
    foot: "миграция 8 мс · заморозка 60 с",
    caption:
      "В T=0 медленный SELECT держит ACCESS SHARE 60 с; в T=10 ALTER запрашивает ACCESS EXCLUSIVE и ждёт; каждый новый SELECT встаёт за ним — миграция на 8 мс замораживает таблицу на полные 60 с, пока медленный запрос не отпустит блокировку.",
  },
};

const t = dict[lang];

const colX = [40, 290, 540];
const qX = [70, 300, 530];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-fifo-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.colT.map((c, i) => (
      <g>
        <rect x={colX[i]} y="100" width="220" height="170" fill="var(--card)" stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 1 ? 2.5 : 2} />
        <text x={colX[i] + 110} y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{c}</text>
        <text x={colX[i] + 110} y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.colD[i]}</text>
        <text x={colX[i] + 110} y="216" text-anchor="middle" font-size="11" fill="var(--muted)">{t.colL[i]}</text>
      </g>
    ))}

    <text x="400" y="294" text-anchor="middle" font-size="11" fill="var(--muted)">{t.queueNote}</text>
    {t.qChips.map((q, i) => (
      <g>
        <rect x={qX[i]} y="304" width="180" height="40" fill={i === 1 ? "var(--paper)" : "var(--card)"} stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 1 ? 2.5 : 1.5} />
        <text x={qX[i] + 90} y="329" text-anchor="middle" font-size="11" fill="var(--ink)">{q}</text>
      </g>
    ))}
    <line x1="250" y1="324" x2="300" y2="324" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-fifo-arrow)" />
    <line x1="480" y1="324" x2="530" y2="324" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-fifo-arrow)" />

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--accent)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
