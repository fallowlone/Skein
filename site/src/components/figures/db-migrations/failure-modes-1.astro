---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Nine migration failure modes on one card: freeze, INVALID index, deadlock, down rollback, replica drift, WAL flood, volatile default, NOT NULL gap, RENAME",
    headline: "NINE FAILURES, NINE SIGNALS",
    sub: "name it · read its signal · apply its fix",
    modes: ["(a) lock-queue freeze", "(b) INVALID index", "(c) deadlock", "(d) down rollback", "(e) replica drift", "(f) WAL flood", "(g) volatile default", "(h) NOT NULL gap", "(i) RENAME in deploy"],
    signals: ["pool out · 503", "indisvalid = false", "deadlock detected", "data loss", "standby stale", "lag climbs", "minutes rewrite", "fails at apply", "column missing"],
    foot: "nine names — one signal and one fix each",
    caption:
      "Nine named migration failure modes fit on one card: lock-queue freeze, INVALID index, deadlock, down-migration data loss, replica drift, WAL flood, volatile-default rewrite, NOT NULL without backfill, RENAME during deploy — each with its signal and its durable fix.",
  },
  ru: {
    svgTitle: "Девять сбоев миграций на одной карточке: заморозка, INVALID-индекс, дедлок, откат down, дрейф реплик, WAL-наводнение, волатильный дефолт, NOT NULL, RENAME",
    headline: "ДЕВЯТЬ СБОЕВ, ДЕВЯТЬ СИГНАЛОВ",
    sub: "назови · прочти сигнал · примени фикс",
    modes: ["(a) заморозка очереди", "(b) INVALID-индекс", "(c) дедлок", "(d) откат down", "(e) дрейф реплик", "(f) WAL-наводнение", "(g) волатильный дефолт", "(h) NOT NULL без бэкфила", "(i) RENAME в деплое"],
    signals: ["pool пуст · 503", "indisvalid = false", "deadlock detected", "потеря данных", "standby устарел", "лаг растёт", "минуты перезаписи", "падает при apply", "колонки нет"],
    foot: "девять имён — у каждого сигнал и фикс",
    caption:
      "Девять именованных сбоев миграций на одной карточке: заморозка очереди, INVALID-индекс, дедлок, потеря данных при down-миграции, дрейф реплик, WAL-наводнение, перезапись волатильным дефолтом, NOT NULL без бэкфила, RENAME при деплое — у каждого свой сигнал и устойчивый фикс.",
  },
};

const t = dict[lang];

const cellX9 = [40, 290, 540, 40, 290, 540, 40, 290, 540];
const cellY9 = [100, 100, 100, 185, 185, 185, 270, 270, 270];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.modes.map((m, i) => (
      <g>
        <rect x={cellX9[i]} y={cellY9[i]} width="220" height="70" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={cellX9[i] + 110} y={cellY9[i] + 28} text-anchor="middle" font-size="12" fill="var(--ink)">{m}</text>
        <text x={cellX9[i] + 110} y={cellY9[i] + 52} text-anchor="middle" font-size="11" fill="var(--muted)">{t.signals[i]}</text>
      </g>
    ))}

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
