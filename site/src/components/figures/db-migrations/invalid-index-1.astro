---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "INVALID index lifecycle: CONCURRENTLY build fails midway, index stays indisvalid false, verify then DROP CONCURRENTLY and retry",
    headline: "INVALID INDEX: CHECK, DROP, RETRY",
    sub: "a mid-build failure is left behind — never cleaned up",
    steps: ["1 · BUILD", "2 · FAILS", "3 · INVALID", "4 · DROP", "5 · RETRY"],
    subs: ["CONCURRENTLY", "midway · OOM", "indisvalid = false", "CONCURRENTLY", "verify · rebuild"],
    notes: ["SHARE UPD EXCL", "build stops", "planner ignores", "non-blocking", "DROP + retry"],
    verify: "after every build: SELECT ... WHERE NOT indisvalid — must be empty",
    foot: "a failed CONCURRENTLY leaves INVALID — DROP CONCURRENTLY + retry",
    caption:
      "CONCURRENTLY can fail midway and leave an INVALID index the planner will never use; verify indisvalid after every build, DROP INDEX CONCURRENTLY, and retry — Postgres never cleans it up for you.",
  },
  ru: {
    svgTitle: "Жизнь INVALID-индекса: сборка CONCURRENTLY падает в середине, индекс остаётся indisvalid false, проверить затем DROP CONCURRENTLY и повторить",
    headline: "INVALID-ИНДЕКС: ПРОВЕРЬ, ДРОПНИ, ПОВТОРИ",
    sub: "сбой в середине оставляет след — он не чистится сам",
    steps: ["1 · СБОРКА", "2 · СБОЙ", "3 · INVALID", "4 · DROP", "5 · ПОВТОР"],
    subs: ["CONCURRENTLY", "на полпути · OOM", "indisvalid = false", "CONCURRENTLY", "проверка · повтор"],
    notes: ["SHARE UPD EXCL", "сборка встала", "план его игнорит", "неблокирующий", "DROP + повтор"],
    verify: "после каждой сборки: SELECT ... WHERE NOT indisvalid — должно быть пусто",
    foot: "упавший CONCURRENTLY оставляет INVALID — DROP CONCURRENTLY + повтор",
    caption:
      "CONCURRENTLY может упасть в середине и оставить INVALID-индекс, который планировщик никогда не использует; проверяйте indisvalid после каждой сборки, выполняйте DROP INDEX CONCURRENTLY и повторяйте — Postgres сам его не уберёт.",
  },
};

const t = dict[lang];

const chipX = [36, 182, 328, 474, 620];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-inv-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.steps.map((s, i) => (
      <g>
        <rect x={chipX[i]} y="130" width="130" height="110" fill={i === 2 ? "var(--paper)" : "var(--card)"} stroke={i === 2 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 2 ? 2.5 : 2} />
        <text x={chipX[i] + 65} y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{s}</text>
        <text x={chipX[i] + 65} y="186" text-anchor="middle" font-size="11" fill={i === 2 ? "var(--accent)" : "var(--muted)"}>{t.subs[i]}</text>
        <text x={chipX[i] + 65} y="212" text-anchor="middle" font-size="11" fill="var(--muted)">{t.notes[i]}</text>
      </g>
    ))}
    <line x1="166" y1="185" x2="182" y2="185" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-inv-arrow)" />
    <line x1="312" y1="185" x2="328" y2="185" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-inv-arrow)" />
    <line x1="458" y1="185" x2="474" y2="185" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-inv-arrow)" />
    <line x1="604" y1="185" x2="620" y2="185" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-inv-arrow)" />

    <rect x="110" y="266" width="580" height="48" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="295" text-anchor="middle" font-size="12" fill="var(--ink)">{t.verify}</text>

    <text x="400" y="360" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
