---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Safe NOT NULL in five steps: instant add, batched backfill, NOT VALID, VALIDATE under light lock, then fast SET NOT NULL",
    headline: "NOT NULL IN FIVE SAFE STEPS",
    sub: "each step instant or DML-safe — no long ACCESS EXCLUSIVE",
    steps: ["1 · ADD COLUMN", "2 · BACKFILL", "3 · NOT VALID", "4 · VALIDATE", "5 · SET NOT NULL"],
    subs: ["no NOT NULL", "NULLs in batches", "new rows only", "scan existing", "fast — proved"],
    locks: ["instant", "short txns", "brief ACCESS EXCL", "SHARE UPD EXCL", "light lock"],
    batchNote: "backfill in 1k–10k batches with pg_sleep between",
    foot: "never SET NOT NULL in one step on a large table",
    caption:
      "NOT NULL on a large table is five safe steps: instant ADD without the constraint, batched backfill of NULLs, NOT VALID for new rows under a brief lock, VALIDATE scan under SHARE UPDATE EXCLUSIVE, then a fast SET NOT NULL — never one blocking ALTER.",
  },
  ru: {
    svgTitle: "Безопасный NOT NULL за пять шагов: мгновенное добавление, пакетный бэкфил, NOT VALID, VALIDATE под лёгкой блокировкой, затем быстрый SET NOT NULL",
    headline: "NOT NULL ЗА ПЯТЬ БЕЗОПАСНЫХ ШАГОВ",
    sub: "каждый шаг мгновенен или DML-безопасен — без долгого ACCESS EXCLUSIVE",
    steps: ["1 · ADD COLUMN", "2 · БЭКФИЛ", "3 · NOT VALID", "4 · VALIDATE", "5 · SET NOT NULL"],
    subs: ["без NOT NULL", "NULL пакетами", "новые строки", "скан строк", "быстро — доказано"],
    locks: ["мгновенно", "короткие транз.", "ACCESS EXCL кратко", "SHARE UPD EXCL", "лёгкий лок"],
    batchNote: "бэкфил пакетами 1к–10к с pg_sleep между ними",
    foot: "никогда не ставьте SET NOT NULL за один шаг на большой таблице",
    caption:
      "NOT NULL на большой таблице — пять безопасных шагов: мгновенный ADD без ограничения, пакетный бэкфил NULL, NOT VALID для новых строк под краткой блокировкой, скан VALIDATE под SHARE UPDATE EXCLUSIVE, затем быстрый SET NOT NULL — никогда одним блокирующим ALTER.",
  },
};

const t = dict[lang];

const chipX = [36, 182, 328, 474, 620];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-nn-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.steps.map((s, i) => (
      <g>
        <rect x={chipX[i]} y="130" width="130" height="96" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={chipX[i] + 65} y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{s}</text>
        <text x={chipX[i] + 65} y="184" text-anchor="middle" font-size="11" fill="var(--muted)">{t.subs[i]}</text>
        <text x={chipX[i] + 65} y="208" text-anchor="middle" font-size="11" fill="var(--ink)">{t.locks[i]}</text>
      </g>
    ))}
    <line x1="166" y1="178" x2="182" y2="178" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-nn-arrow)" />
    <line x1="312" y1="178" x2="328" y2="178" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-nn-arrow)" />
    <line x1="458" y1="178" x2="474" y2="178" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-nn-arrow)" />
    <line x1="604" y1="178" x2="620" y2="178" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-nn-arrow)" />

    <rect x="150" y="256" width="500" height="48" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="285" text-anchor="middle" font-size="12" fill="var(--ink)">{t.batchNote}</text>

    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
