---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Replica lag after DDL: standbys serve old schema until WAL replays; normal under 1 s, 5 to 30 s under load, gate deploy at 15 s",
    headline: "REPLICAS LAG — CODE MUST WAIT",
    sub: "old schema on standbys until WAL replays",
    primTitle: "primary",
    primSub: "commits DDL",
    streamNote: "WAL streams",
    reps: ["replica 1", "replica 2"],
    lagNorm: "under 1 s · normal",
    lagLoad: "5–30 s · under load",
    gate: "lag 15 s — gate deploy until replay_lag near 0",
    foot: "max_standby_streaming_delay cancels standby queries",
    caption:
      "DDL commits on the primary but standbys replay WAL seconds later — under a second normally, 5–30 s under load; deploying code at 15 s lag serves the old schema from replicas, so gate the rollout on replay_lag near zero.",
  },
  ru: {
    svgTitle: "Лаг реплик после DDL: standby отдают старую схему, пока WAL не проиграется; норма меньше 1 с, 5–30 с под нагрузкой, при 15 с деплой блокируется",
    headline: "РЕПЛИКИ ОТСТАЮТ — КОД ДОЛЖЕН ЖДАТЬ",
    sub: "на standby старая схема, пока WAL не проиграется",
    primTitle: "primary",
    primSub: "коммитит DDL",
    streamNote: "WAL течёт",
    reps: ["replica 1", "replica 2"],
    lagNorm: "меньше 1 с · норма",
    lagLoad: "5–30 с · нагрузка",
    gate: "лаг 15 с — блокируй деплой до replay_lag около 0",
    foot: "max_standby_streaming_delay отменяет запросы на standby",
    caption:
      "DDL коммитится на primary, но standby проигрывают WAL секундами позже — меньше секунды в норме, 5–30 с под нагрузкой; деплой кода при лаге 15 с отдаёт старую схему с реплик, поэтому блокируйте раскатку до replay_lag около нуля.",
  },
};

const t = dict[lang];

const repX = [330, 560];
const repLag = [true, false];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-rep-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="120" width="180" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="130" y="156" text-anchor="middle" font-size="13" fill="var(--ink)">{t.primTitle}</text>
    <text x="130" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.primSub}</text>

    <text x="275" y="150" text-anchor="middle" font-size="11" fill="var(--muted)">{t.streamNote}</text>
    <line x1="220" y1="170" x2="330" y2="150" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-rep-arrow)" />
    <line x1="220" y1="190" x2="330" y2="200" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-rep-arrow)" />

    {t.reps.map((r, i) => (
      <g>
        <rect x={repX[i]} y="120" width="190" height="130" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={repX[i] + 95} y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
        <rect x={repX[i] + 20} y="170" width="150" height="38" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={repX[i] + 95} y="194" text-anchor="middle" font-size="11" fill="var(--ink)">{repLag[i] ? t.lagNorm : t.lagLoad}</text>
      </g>
    ))}

    <rect x="110" y="280" width="580" height="48" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="309" text-anchor="middle" font-size="12" fill="var(--ink)">{t.gate}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
