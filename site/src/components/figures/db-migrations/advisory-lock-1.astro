---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Advisory lock serialises three pods: first acquires pg_advisory_lock 12345 and migrates, others wait then find nothing pending",
    headline: "ONE LOCK, THREE RUNNERS",
    sub: "pg_advisory_lock serialises concurrent migration runners",
    pods: ["pod 1", "pod 2", "pod 3"],
    role1: "runs migrations",
    roleWait: "waits · then no-op",
    lockSub: "held for the whole run",
    result: "next acquirer finds nothing pending — does nothing",
    foot: "one runner applies each migration — never two",
    caption:
      "Three pods boot at once; only the first acquires pg_advisory_lock(12345) and runs the pending migrations while the others wait — the next acquirer finds nothing pending and does nothing, so one migration is never applied twice.",
  },
  ru: {
    svgTitle: "Advisory-блокировка сериализует три пода: первый получает pg_advisory_lock 12345 и мигрирует, остальные ждут и не находят ожидающих",
    headline: "ОДИН ЛОК, ТРИ РАННЕРА",
    sub: "pg_advisory_lock сериализует конкурентные запуски миграций",
    pods: ["pod 1", "pod 2", "pod 3"],
    role1: "выполняет миграции",
    roleWait: "ждёт · затем no-op",
    lockSub: "держится весь прогон",
    result: "следующий получивший не находит ожидающих — ничего не делает",
    foot: "каждую миграцию применяет один runner — не два",
    caption:
      "Три пода стартуют одновременно; только первый получает pg_advisory_lock(12345) и выполняет ожидающие миграции, пока остальные ждут, — следующий получивший не находит ничего ожидающего и ничего не делает, поэтому одна миграция никогда не применяется дважды.",
  },
};

const t = dict[lang];

const podX = [80, 310, 540];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-adv-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.pods.map((p, i) => (
      <g>
        <rect x={podX[i]} y="110" width="180" height="64" fill={i === 0 ? "var(--paper)" : "var(--card)"} stroke={i === 0 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 0 ? 2.5 : 2} />
        <text x={podX[i] + 90} y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{p}</text>
        <text x={podX[i] + 90} y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{i === 0 ? t.role1 : t.roleWait}</text>
      </g>
    ))}

    <rect x="250" y="210" width="300" height="84" fill="var(--card)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="400" y="242" text-anchor="middle" font-size="12" fill="var(--ink)">pg_advisory_lock(12345)</text>
    <text x="400" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.lockSub}</text>

    <line x1="170" y1="174" x2="350" y2="210" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-adv-arrow)" />
    <line x1="400" y1="174" x2="400" y2="210" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#dbmig-adv-arrow)" />
    <line x1="630" y1="174" x2="450" y2="210" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#dbmig-adv-arrow)" />

    <rect x="110" y="316" width="580" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="343" text-anchor="middle" font-size="12" fill="var(--ink)">{t.result}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
