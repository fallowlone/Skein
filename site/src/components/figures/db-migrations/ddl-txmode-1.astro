---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "DDL transaction semantics: most DDL is atomic in BEGIN COMMIT, but CONCURRENTLY ops must run outside a transaction with txmode none",
    headline: "DDL IS TRANSACTIONAL — EXCEPT CONCURRENT",
    sub: "a tool wrapping CONCURRENT in BEGIN breaks silently",
    leftTitle: "transactional DDL",
    leftNote: "atomic · visible after COMMIT",
    leftNote2: "most DDL works this way",
    rightTitle: "must run outside BEGIN",
    exc: ["CREATE INDEX CONCURRENTLY", "REINDEX CONCURRENTLY", "ALTER TYPE ... ADD VALUE · PG 11-"],
    annNote: "Atlas opts out: atlas:txmode none",
    split: "CONCURRENT mixed with DDL — split into two files",
    foot: "one CONCURRENT op per non-transactional file",
    caption:
      "Most Postgres DDL is atomic inside BEGIN..COMMIT, but CREATE INDEX CONCURRENTLY, REINDEX CONCURRENTLY and ALTER TYPE ADD VALUE on PG 11 and earlier must run outside a transaction — annotate the file non-transactional and never mix them with other DDL.",
  },
  ru: {
    svgTitle: "Транзакционность DDL: большинство DDL атомарно в BEGIN COMMIT, но CONCURRENTLY-операции выполняются вне транзакции с txmode none",
    headline: "DDL ТРАНЗАКЦИОНЕН — КРОМЕ CONCURRENT",
    sub: "инструмент, обернувший CONCURRENT в BEGIN, ломается молча",
    leftTitle: "транзакционный DDL",
    leftNote: "атомарно · видно после COMMIT",
    leftNote2: "большинство DDL работает так",
    rightTitle: "только вне BEGIN",
    exc: ["CREATE INDEX CONCURRENTLY", "REINDEX CONCURRENTLY", "ALTER TYPE ... ADD VALUE · PG 11-"],
    annNote: "Atlas выходит: atlas:txmode none",
    split: "CONCURRENT смешан с DDL — разбей на два файла",
    foot: "один CONCURRENT-оп на нетранзакционный файл",
    caption:
      "Большинство DDL в Postgres атомарно внутри BEGIN..COMMIT, но CREATE INDEX CONCURRENTLY, REINDEX CONCURRENTLY и ALTER TYPE ADD VALUE на PG 11 и ниже должны выполняться вне транзакции — пометьте файл нетранзакционным и никогда не смешивайте их с другим DDL.",
  },
};

const t = dict[lang];

const leftX = [50, 165, 280];
const leftSteps = ["BEGIN", "ALTER TABLE", "COMMIT"];
const excY = [140, 180, 220];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-tx-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="340" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    {leftSteps.map((s, i) => (
      <g>
        <rect x={leftX[i]} y="150" width="90" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={leftX[i] + 45} y="177" text-anchor="middle" font-size="11" fill="var(--ink)">{s}</text>
      </g>
    ))}
    <line x1="140" y1="172" x2="165" y2="172" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-tx-arrow)" />
    <line x1="255" y1="172" x2="280" y2="172" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-tx-arrow)" />
    <text x="210" y="232" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftNote}</text>
    <text x="210" y="256" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftNote2}</text>

    <rect x="420" y="100" width="340" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    {t.exc.map((e, i) => (
      <g>
        <rect x="440" y={excY[i]} width="300" height="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="590" y={excY[i] + 23} text-anchor="middle" font-size="11" fill="var(--ink)">{e}</text>
      </g>
    ))}
    <text x="590" y="276" text-anchor="middle" font-size="11" fill="var(--accent)">{t.annNote}</text>

    <rect x="110" y="312" width="580" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="339" text-anchor="middle" font-size="12" fill="var(--ink)">{t.split}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
