---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Down migration destroys data new code wrote to handle; production rollback is a forward migration that keeps data",
    headline: "ROLLBACK MOVES FORWARD",
    sub: "down drops the column — and everything new code wrote",
    laneA: "DOWN · rollback destroys",
    stepsA: ["up: ADD handle", "new writes land", "down: DROP handle", "data destroyed"],
    verdictA: "DROP also drops the new data",
    laneB: "FORWARD · production fix",
    stepsB: ["up: ADD handle", "bug found", "new fix migration", "data kept"],
    verdictB: "forward migration preserves data",
    foot: "never run down migrations in production",
    caption:
      "A down migration that drops handle also destroys every row new code wrote since the up migration; production rollback is a forward migration that fixes the problem and keeps the data.",
  },
  ru: {
    svgTitle: "Down-миграция уничтожает данные, записанные новым кодом в handle; откат в продакшне — прямая миграция, сохраняющая данные",
    headline: "ОТКАТ ИДЁТ ВПЕРЁД",
    sub: "down дропает колонку — и всё, что записал новый код",
    laneA: "DOWN · откат уничтожает",
    stepsA: ["up: ADD handle", "новые записи идут", "down: DROP handle", "данные уничтожены"],
    verdictA: "DROP дропает и новые данные",
    laneB: "ВПЕРЁД · продакшн-фикс",
    stepsB: ["up: ADD handle", "найден баг", "новая fix-миграция", "данные целы"],
    verdictB: "прямая миграция сохраняет данные",
    foot: "никогда не запускайте down-миграции в продакшне",
    caption:
      "Down-миграция, дропающая handle, уничтожает каждую строку, записанную новым кодом после up-миграции; откат в продакшне — прямая миграция, исправляющая проблему и сохраняющая данные.",
  },
};

const t = dict[lang];

const chipX4 = [60, 225, 390, 555];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-down-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="95" width="720" height="118" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="60" y="123" font-size="13" fill="var(--ink)">{t.laneA}</text>
    {t.stepsA.map((s, i) => (
      <g>
        <rect x={chipX4[i]} y="136" width="150" height="52" fill={i === 3 ? "var(--paper)" : "var(--card)"} stroke={i === 3 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 3 ? 2.5 : 1.5} />
        <text x={chipX4[i] + 75} y="168" text-anchor="middle" font-size="11" fill="var(--ink)">{s}</text>
      </g>
    ))}
    <line x1="210" y1="162" x2="225" y2="162" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-down-arrow)" />
    <line x1="375" y1="162" x2="390" y2="162" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-down-arrow)" />
    <line x1="540" y1="162" x2="555" y2="162" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-down-arrow)" />
    <text x="400" y="205" text-anchor="middle" font-size="12" fill="var(--muted)">{t.verdictA}</text>

    <rect x="40" y="226" width="720" height="118" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="60" y="254" font-size="13" fill="var(--ink)">{t.laneB}</text>
    {t.stepsB.map((s, i) => (
      <g>
        <rect x={chipX4[i]} y="268" width="150" height="52" fill={i === 3 ? "var(--paper)" : "var(--card)"} stroke={i === 3 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 3 ? 2.5 : 1.5} />
        <text x={chipX4[i] + 75} y="300" text-anchor="middle" font-size="11" fill="var(--ink)">{s}</text>
      </g>
    ))}
    <line x1="210" y1="294" x2="225" y2="294" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-down-arrow)" />
    <line x1="375" y1="294" x2="390" y2="294" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-down-arrow)" />
    <line x1="540" y1="294" x2="555" y2="294" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-down-arrow)" />
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.verdictB}</text>

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
