---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One-step rename during rolling deploy: old pods still read username for 30 to 120 s and fail with column does not exist",
    headline: "ONE RENAME, TWO CODE VERSIONS",
    sub: "rolling deploy runs old + new for 30–120 s",
    oldTitle: "OLD pods",
    oldSub: "read username",
    dbTitle: "users · after RENAME",
    goneRow: "username — gone",
    newRow: "handle — new",
    newTitle: "NEW pods",
    newSub: "read handle",
    oldErr: "column does not exist",
    newOk: "new pods: ok",
    foot: "schema must fit old AND new code at every moment",
    caption:
      "A rolling deploy runs old and new pods against one database for 30–120 s; a one-step RENAME commits while old pods still read username, and every old request fails with column does not exist — the schema must stay compatible with both versions at every moment.",
  },
  ru: {
    svgTitle: "Одношаговое переименование при rolling deploy: старые поды ещё 30–120 с читают username и падают с column does not exist",
    headline: "ОДНО ПЕРЕИМЕНОВАНИЕ, ДВЕ ВЕРСИИ КОДА",
    sub: "rolling deploy держит старый + новый код 30–120 с",
    oldTitle: "СТАРЫЕ поды",
    oldSub: "читают username",
    dbTitle: "users · после RENAME",
    goneRow: "username — исчез",
    newRow: "handle — новый",
    newTitle: "НОВЫЕ поды",
    newSub: "читают handle",
    oldErr: "column does not exist",
    newOk: "новые поды: ok",
    foot: "схема должна подходить старому И новому коду в каждый момент",
    caption:
      "Rolling deploy держит старые и новые поды на одной базе 30–120 с; одношаговый RENAME коммитится, пока старые поды ещё читают username, и каждый старый запрос падает с column does not exist, — схема должна оставаться совместимой с обеими версиями в каждый момент.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-roll-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="210" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="145" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.oldTitle}</text>
    <text x="145" y="148" text-anchor="middle" font-size="11" fill="var(--muted)">{t.oldSub}</text>
    <rect x="60" y="170" width="170" height="40" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="145" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">username</text>
    <text x="145" y="262" text-anchor="middle" font-size="11" fill="var(--accent)">{t.oldErr}</text>

    <rect x="290" y="100" width="220" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.dbTitle}</text>
    <rect x="310" y="150" width="180" height="38" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="400" y="174" text-anchor="middle" font-size="12" fill="var(--muted)">{t.goneRow}</text>
    <rect x="310" y="200" width="180" height="38" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.newRow}</text>

    <rect x="550" y="100" width="210" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="655" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.newTitle}</text>
    <text x="655" y="148" text-anchor="middle" font-size="11" fill="var(--muted)">{t.newSub}</text>
    <rect x="570" y="170" width="170" height="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="655" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">handle</text>
    <text x="655" y="262" text-anchor="middle" font-size="11" fill="var(--muted)">{t.newOk}</text>

    <line x1="250" y1="150" x2="290" y2="150" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-roll-arrow)" />
    <line x1="550" y1="150" x2="510" y2="150" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-roll-arrow)" />

    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
