---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Constraint split: one-shot ADD CONSTRAINT scans under ACCESS EXCLUSIVE and blocks DML; NOT VALID plus VALIDATE keeps DML running",
    headline: "ONE SCAN IN LOCK, OR NONE",
    sub: "orders_status_valid on 100M rows — one shot vs split",
    laneA: "UNSAFE · one shot",
    stepsA: ["ADD CONSTRAINT", "full scan in lock", "DML blocked"],
    verdictA: "ACCESS EXCLUSIVE for the whole scan",
    laneB: "SAFE · split",
    stepsB: ["NOT VALID · instant", "VALIDATE · scan", "DML continues"],
    verdictB: "SHARE UPDATE EXCLUSIVE — DML lives",
    foot: "NOT VALID is instant · VALIDATE does not block DML",
    caption:
      "One-shot ADD CONSTRAINT scans 100M rows under ACCESS EXCLUSIVE and blocks DML; NOT VALID enforces for new rows instantly, then VALIDATE scans existing rows under SHARE UPDATE EXCLUSIVE while traffic runs.",
  },
  ru: {
    svgTitle: "Разделение constraint: одношаговый ADD CONSTRAINT сканирует под ACCESS EXCLUSIVE и блокирует DML; NOT VALID плюс VALIDATE не останавливают DML",
    headline: "СКАН ПОД БЛОКИРОВКОЙ — ИЛИ БЕЗ",
    sub: "orders_status_valid на 100M строк — за раз против split",
    laneA: "ОПАСНО · за один шаг",
    stepsA: ["ADD CONSTRAINT", "полный скан в блоке", "DML заблокирован"],
    verdictA: "ACCESS EXCLUSIVE на всё сканирование",
    laneB: "БЕЗОПАСНО · split",
    stepsB: ["NOT VALID · сразу", "VALIDATE · скан", "DML продолжается"],
    verdictB: "SHARE UPDATE EXCLUSIVE — DML живёт",
    foot: "NOT VALID мгновенен · VALIDATE не блокирует DML",
    caption:
      "Одношаговый ADD CONSTRAINT сканирует 100M строк под ACCESS EXCLUSIVE и блокирует DML; NOT VALID мгновенно применяется для новых строк, затем VALIDATE сканирует существующие под SHARE UPDATE EXCLUSIVE при живом трафике.",
  },
};

const t = dict[lang];

const stepX = [240, 410, 580];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-nv-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="95" width="720" height="118" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="60" y="123" font-size="13" fill="var(--ink)">{t.laneA}</text>
    {t.stepsA.map((s, i) => (
      <g>
        <rect x={stepX[i]} y="140" width="150" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={stepX[i] + 75} y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{s}</text>
      </g>
    ))}
    <line x1="390" y1="162" x2="410" y2="162" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-nv-arrow)" />
    <line x1="560" y1="162" x2="580" y2="162" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-nv-arrow)" />
    <text x="400" y="203" text-anchor="middle" font-size="12" fill="var(--muted)">{t.verdictA}</text>

    <rect x="40" y="226" width="720" height="118" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="60" y="254" font-size="13" fill="var(--ink)">{t.laneB}</text>
    {t.stepsB.map((s, i) => (
      <g>
        <rect x={stepX[i]} y="268" width="150" height="44" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
        <text x={stepX[i] + 75} y="296" text-anchor="middle" font-size="12" fill="var(--ink)">{s}</text>
      </g>
    ))}
    <line x1="390" y1="290" x2="410" y2="290" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-nv-arrow)" />
    <line x1="560" y1="290" x2="580" y2="290" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-nv-arrow)" />
    <text x="400" y="333" text-anchor="middle" font-size="12" fill="var(--muted)">{t.verdictB}</text>

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
