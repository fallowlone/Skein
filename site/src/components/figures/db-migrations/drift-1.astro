---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Ad-hoc DDL drift: Otto laptop has the phone column but staging and a teammate database do not, and schema_migrations records nothing",
    headline: "AD-HOC DDL: THREE ENVS, THREE SCHEMAS",
    sub: "no migration file — nobody knows what changed",
    envs: ["LAPTOP · Otto", "STAGING · CI", "TEAMMATE · new hire"],
    hasPhone: "phone TEXT · present",
    noPhone: "phone · missing",
    envNote: ["hand-run ALTER", "no ALTER run", "fresh clone · broken"],
    recLine: "schema_migrations: empty",
    foot: "one ALTER in psql works once, on one machine",
    caption:
      "Ad-hoc ALTER TABLE works once on one machine: Otto laptop has phone, staging and the new hire clone do not, and no record says what changed — migration files plus schema_migrations keep every environment reproducible.",
  },
  ru: {
    svgTitle: "Дрейф ad-hoc DDL: на ноутбуке Отто колонка phone есть, а на стейджинге и у коллеги её нет, и schema_migrations ничего не записывает",
    headline: "AD-HOC DDL: ТРИ СРЕДЫ — ТРИ СХЕМЫ",
    sub: "нет файла миграции — никто не знает, что изменилось",
    envs: ["НОУТБУК · Отто", "СТЕЙДЖИНГ · CI", "КОЛЛЕГА · новичок"],
    hasPhone: "phone TEXT · есть",
    noPhone: "phone · нет",
    envNote: ["ALTER вручную", "ALTER не запускался", "свежий клон · сломан"],
    recLine: "schema_migrations: пусто",
    foot: "один ALTER в psql работает раз, на одной машине",
    caption:
      "Ad-hoc ALTER TABLE работает один раз на одной машине: у Отто phone есть, на стейджинге и у новичка её нет, и ни одна запись не говорит, что изменилось, — файлы миграций и schema_migrations держат каждую среду воспроизводимой.",
  },
};

const t = dict[lang];

const envX = [30, 290, 550];
const has = [true, false, false];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbmig-drift-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.envs.map((e, i) => (
      <g>
        <rect x={envX[i]} y="100" width="220" height="225" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={envX[i] + 110} y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{e}</text>
        <rect x={envX[i] + 20} y="146" width="180" height="36" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={envX[i] + 110} y="170" text-anchor="middle" font-size="12" fill="var(--ink)">users</text>
        <rect x={envX[i] + 20} y="194" width="180" height="40" fill={has[i] ? "var(--paper)" : "var(--card)"} stroke={has[i] ? "var(--accent)" : "var(--muted)"} stroke-width={has[i] ? 2.5 : 1.5} />
        <text x={envX[i] + 110} y="219" text-anchor="middle" font-size="12" fill={has[i] ? "var(--ink)" : "var(--muted)"}>{has[i] ? t.hasPhone : t.noPhone}</text>
        <text x={envX[i] + 110} y="262" text-anchor="middle" font-size="11" fill="var(--muted)">{t.envNote[i]}</text>
        <text x={envX[i] + 110} y="300" text-anchor="middle" font-size="11" fill="var(--muted)">{t.recLine}</text>
      </g>
    ))}

    <line x1="250" y1="214" x2="290" y2="214" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-drift-arrow)" />
    <line x1="510" y1="214" x2="550" y2="214" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbmig-drift-arrow)" />

    <text x="400" y="368" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
