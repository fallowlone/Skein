---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four Node stream types: Readable pulls, Writable pushes, Duplex does both, Transform maps input to output",
    headline: "FOUR STREAM TYPES, ONE MODEL",
    sub: "chunks in flight, never the whole in RAM",
    tagRoot: "stream",
    nameR: "Readable",
    rLine1: "source you pull from",
    rLine2: "file read, request, socket",
    nameW: "Writable",
    wLine1: "sink you push to",
    wLine2: "file write, response, socket",
    nameD: "Duplex",
    dLine1: "both, sides independent",
    dLine2: "TCP socket",
    nameT: "Transform",
    tLine1: "in mapped to out",
    tLine2: "gzip, cipher, CSV parser",
    foot: "Transform is the streaming map: in one side, modified out the other",
    caption:
      "Four stream types, one mental model: Readable pulls, Writable pushes, Duplex does both with independent sides, and Transform maps input to output — the streaming map.",
  },
  ru: {
    svgTitle: "Четыре типа потоков Node: Readable тянет, Writable пушит, Duplex делает оба, Transform отображает вход в выход",
    headline: "ЧЕТЫРЕ ТИПА ПОТОКОВ",
    sub: "chunk'и в полёте, никогда всё целиком в RAM",
    tagRoot: "поток",
    nameR: "Readable",
    rLine1: "источник, тянут из него",
    rLine2: "файл, запрос, сокет",
    nameW: "Writable",
    wLine1: "сток, пушат в него",
    wLine2: "запись, ответ, сокет",
    nameD: "Duplex",
    dLine1: "оба сразу, стороны свои",
    dLine2: "TCP-сокет",
    nameT: "Transform",
    tLine1: "вход отображает в выход",
    tLine2: "gzip, шифр, парсер CSV",
    foot: "Transform — потоковый map: вход с одной, выход с другой",
    caption:
      "Четыре типа потоков, одна модель: Readable тянет, Writable пушит, Duplex делает оба с независимыми сторонами, а Transform отображает вход в выход — потоковый map.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="310" y="82" width="180" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="107" text-anchor="middle" font-size="12" fill="var(--ink)">{t.tagRoot}</text>

    <line x1="107" y1="122" x2="107" y2="150" stroke="var(--muted)" stroke-width="2" />
    <line x1="302" y1="122" x2="302" y2="150" stroke="var(--muted)" stroke-width="2" />
    <line x1="498" y1="122" x2="498" y2="150" stroke="var(--muted)" stroke-width="2" />
    <line x1="693" y1="122" x2="693" y2="150" stroke="var(--muted)" stroke-width="2" />
    <line x1="107" y1="122" x2="693" y2="122" stroke="var(--muted)" stroke-width="2" />

    <rect x="20" y="150" width="175" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="107" y="178" text-anchor="middle" font-size="13" fill="var(--ink)">{t.nameR}</text>
    <text x="107" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rLine1}</text>
    <text x="107" y="230" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rLine2}</text>

    <rect x="215" y="150" width="175" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="302" y="178" text-anchor="middle" font-size="13" fill="var(--ink)">{t.nameW}</text>
    <text x="302" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wLine1}</text>
    <text x="302" y="230" text-anchor="middle" font-size="11" fill="var(--muted)">{t.wLine2}</text>

    <rect x="410" y="150" width="175" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="498" y="178" text-anchor="middle" font-size="13" fill="var(--ink)">{t.nameD}</text>
    <text x="498" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.dLine1}</text>
    <text x="498" y="230" text-anchor="middle" font-size="11" fill="var(--muted)">{t.dLine2}</text>

    <rect x="605" y="150" width="175" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="693" y="178" text-anchor="middle" font-size="13" fill="var(--ink)">{t.nameT}</text>
    <text x="693" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.tLine1}</text>
    <text x="693" y="230" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tLine2}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
