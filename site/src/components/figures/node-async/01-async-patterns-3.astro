---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Never swallow a rejection: an ignored async error becomes an unhandledRejection that crashes the process; each failure is either handled with recovery or propagated by re-throw, and abandoned work is cancelled with AbortController",
    headline: "NEVER SWALLOW A REJECTION",
    sub: "handle it — or propagate it",
    warnLine: "empty catch {} → unhandledRejection → process crash",
    boxHandle: "HANDLE",
    handleLine1: "you can recover",
    handleLine2: "retry · default · 503",
    boxPropagate: "PROPAGATE",
    propagateLine1: "you cannot recover",
    propagateLine2: "re-throw for more context",
    cancelLine: "cancel abandoned work: AbortController + timer",
    foot1: "a catch that neither recovers nor re-throws is a bug",
    caption:
      "An async error you ignore becomes an unhandledRejection and crashes the process. For each failure decide: handle it when you can recover (retry, default, 503) or propagate it with re-throw — and cancel abandoned work with AbortController.",
  },
  ru: {
    svgTitle: "Никогда не проглатывай rejection: проигнорированная async-ошибка становится unhandledRejection и роняет процесс; каждое падение либо обрабатывается с восстановлением, либо прокидывается через re-throw, а брошенная работа отменяется через AbortController",
    headline: "НЕ ПРОГЛАТЫВАЙ REJECTION",
    sub: "обработай — или прокинь",
    warnLine: "пустой catch {} → unhandledRejection → процесс падает",
    boxHandle: "ОБРАБОТАТЬ",
    handleLine1: "можешь восстановиться",
    handleLine2: "retry · дефолт · 503",
    boxPropagate: "ПРОКИНУТЬ",
    propagateLine1: "не можешь восстановиться",
    propagateLine2: "re-throw — решит вызывающий",
    cancelLine: "отмена брошенной работы: AbortController + таймер",
    foot1: "catch, что не лечит и не re-throw'ит, — почти всегда баг",
    caption:
      "Async-ошибка, которую ты игнорируешь, становится unhandledRejection и роняет процесс. На каждое падение решай: обработать, когда можешь восстановиться (retry, дефолт, 503), или прокинуть через re-throw — а брошенную работу отменяй через AbortController.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="150" y="88" width="500" height="54" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="121" text-anchor="middle" font-size="12" fill="var(--ink)">{t.warnLine}</text>

    <rect x="90" y="176" width="290" height="96" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="235" y="206" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxHandle}</text>
    <text x="235" y="230" text-anchor="middle" font-size="11" fill="var(--muted)">{t.handleLine1}</text>
    <text x="235" y="252" text-anchor="middle" font-size="11" fill="var(--ink)">{t.handleLine2}</text>

    <rect x="420" y="176" width="290" height="96" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="565" y="206" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxPropagate}</text>
    <text x="565" y="230" text-anchor="middle" font-size="11" fill="var(--muted)">{t.propagateLine1}</text>
    <text x="565" y="252" text-anchor="middle" font-size="11" fill="var(--ink)">{t.propagateLine2}</text>

    <rect x="150" y="302" width="500" height="54" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="335" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cancelLine}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
