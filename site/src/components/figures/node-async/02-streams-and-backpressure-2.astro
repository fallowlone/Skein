---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Two Readable modes: paused pulls via read(), flowing pushes via data events with no built-in brake",
    headline: "PAUSED PULLS, FLOWING PUSHES",
    sub: "attaching data or calling pipe() switches to flowing",
    tagPaused: "paused",
    pLine1: "you call read() to pull",
    pLine2: "next chunk on demand",
    tagFlowing: "flowing",
    fLine1: "chunks pushed via data",
    fLine2: "as fast as they arrive",
    tagObject: "object mode",
    oLine1: "chunks carry JS objects",
    oLine2: "instead of Buffer or string",
    caption:
      "Readables read in paused or flowing mode: paused pulls each chunk with read(), flowing pushes chunks via 'data' events as fast as they arrive with no built-in brake. Attaching 'data' or calling pipe() switches to flowing; object mode carries JS objects instead of Buffers.",
  },
  ru: {
    svgTitle: "Два режима Readable: paused тянет через read(), flowing пушит через события data без встроенного тормоза",
    headline: "PAUSED ТЯНЕТ, FLOWING ПУШИТ",
    sub: "обработчик data или вызов pipe() включает flowing",
    tagPaused: "paused",
    pLine1: "зовёшь read(), тянешь сам",
    pLine2: "следующий chunk по запросу",
    tagFlowing: "flowing",
    fLine1: "chunk'и пушатся через data",
    fLine2: "так быстро, как приходят",
    tagObject: "object mode",
    oLine1: "chunk'и несут JS-объекты",
    oLine2: "вместо Buffer или string",
    caption:
      "Readable читают в режимах paused или flowing: paused тянет каждый chunk через read(), flowing пушит chunk'и через события 'data' так быстро, как они приходят, без встроенного тормоза. Обработчик 'data' или вызов pipe() включает flowing; object mode несёт JS-объекты вместо Buffer.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="110" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagPaused}</text>
    <rect x="40" y="126" width="320" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <rect x="70" y="146" width="140" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="140" y="171" text-anchor="middle" font-size="12" fill="var(--ink)">read()</text>
    <line x1="210" y1="166" x2="250" y2="166" stroke="var(--muted)" stroke-width="2" />
    <rect x="250" y="146" width="80" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="290" y="171" text-anchor="middle" font-size="12" fill="var(--ink)">chunk</text>
    <text x="200" y="222" text-anchor="middle" font-size="11" fill="var(--ink)">{t.pLine1}</text>
    <text x="200" y="244" text-anchor="middle" font-size="11" fill="var(--ink)">{t.pLine2}</text>

    <text x="600" y="110" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagFlowing}</text>
    <rect x="440" y="126" width="320" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <rect x="470" y="146" width="80" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="510" y="171" text-anchor="middle" font-size="12" fill="var(--ink)">chunk</text>
    <line x1="550" y1="166" x2="590" y2="166" stroke="var(--accent)" stroke-width="2" />
    <rect x="590" y="146" width="140" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="660" y="171" text-anchor="middle" font-size="12" fill="var(--ink)">data</text>
    <text x="600" y="222" text-anchor="middle" font-size="11" fill="var(--ink)">{t.fLine1}</text>
    <text x="600" y="244" text-anchor="middle" font-size="11" fill="var(--ink)">{t.fLine2}</text>

    <rect x="180" y="296" width="440" height="72" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="318" text-anchor="middle" font-size="12" fill="var(--ink)">{t.tagObject}</text>
    <text x="400" y="340" text-anchor="middle" font-size="11" fill="var(--ink)">{t.oLine1}</text>
    <text x="400" y="360" text-anchor="middle" font-size="11" fill="var(--muted)">{t.oLine2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
