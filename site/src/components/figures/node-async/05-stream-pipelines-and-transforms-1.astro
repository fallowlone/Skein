---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: ".pipe() forwards data but not errors: when gunzip throws, req is never destroyed and one fd leaks per bad request until EMFILE",
    headline: "PIPE() MOVES DATA, NOT ERRORS",
    sub: "one bad request leaks one fd",
    sReq: "req",
    sReqSub: "Readable socket",
    sGunzip: "gunzip",
    sGunzipSub: "Transform",
    sParser: "parser",
    sParserSub: "objectMode records",
    flow1: "chunks",
    flow2: "records",
    errNote: "gunzip throws — error stays on gunzip",
    reqNote1: "req never destroyed",
    reqNote2: "one fd leaks per bad request",
    chainNote: "nothing tells req or parser to close",
    parserNote: "parser left hanging",
    stairNote: "each bad request leaks one fd — the staircase climbs to the ulimit",
    yTag: "open fds",
    ulimitTag: "ulimit 1024–4096",
    emfileTag: "EMFILE — new sockets fail",
    caption:
      ".pipe() forwards data but not errors: when gunzip throws, the error stays on gunzip, req is never destroyed, and one fd leaks per bad request until the staircase hits the ulimit and new connections fail with EMFILE.",
  },
  ru: {
    svgTitle: ".pipe() пробрасывает данные, но не ошибки: когда gunzip падает, req не разрушается и один fd течёт на каждый плохой запрос вплоть до EMFILE",
    headline: "PIPE() ГОНИТ ДАННЫЕ, НО НЕ ОШИБКИ",
    sub: "один плохой запрос — один утёкший fd",
    sReq: "req",
    sReqSub: "входящий сокет",
    sGunzip: "gunzip",
    sGunzipSub: "Трансформ",
    sParser: "parser",
    sParserSub: "записи objectMode",
    flow1: "чанки",
    flow2: "записи",
    errNote: "gunzip падает — ошибка остаётся на gunzip",
    reqNote1: "req не разрушен",
    reqNote2: "один fd течёт на плохой запрос",
    chainNote: "никто не велит req и парсеру закрыться",
    parserNote: "парсер висит открытым",
    stairNote: "каждый плохой запрос течёт одним fd — лесенка ползёт к ulimit",
    yTag: "открытые fd",
    ulimitTag: "ulimit 1024–4096",
    emfileTag: "EMFILE — новые сокеты валятся",
    caption:
      ".pipe() пробрасывает данные, но не ошибки: когда gunzip падает, ошибка остаётся на gunzip, req не разрушается, и по одному fd течёт на каждый плохой запрос, пока лесенка не упрётся в ulimit и новые соединения не начнут отказывать с EMFILE.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="245" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.flow1}</text>
    <text x="500" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.flow2}</text>

    <rect x="40" y="110" width="160" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="120" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sReq}</text>
    <text x="120" y="156" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sReqSub}</text>

    <rect x="290" y="110" width="170" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="375" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sGunzip}</text>
    <text x="375" y="156" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sGunzipSub}</text>

    <rect x="540" y="110" width="170" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="625" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sParser}</text>
    <text x="625" y="156" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sParserSub}</text>

    <line x1="202" y1="140" x2="278" y2="140" stroke="var(--ink)" stroke-width="2" />
    <polygon points="290,134 278,140 290,146" fill="var(--ink)" />
    <line x1="462" y1="140" x2="528" y2="140" stroke="var(--ink)" stroke-width="2" />
    <polygon points="540,134 528,140 540,146" fill="var(--ink)" />

    <line x1="375" y1="172" x2="375" y2="184" stroke="var(--muted)" stroke-width="2" stroke-dasharray="4 3" />
    <text x="375" y="198" text-anchor="middle" font-size="11" fill="var(--muted)">{t.errNote}</text>
    <text x="120" y="198" text-anchor="middle" font-size="11" fill="var(--muted)">{t.reqNote1}</text>

    <text x="120" y="220" text-anchor="middle" font-size="11" fill="var(--muted)">{t.reqNote2}</text>
    <text x="375" y="220" text-anchor="middle" font-size="11" fill="var(--muted)">{t.chainNote}</text>
    <text x="625" y="220" text-anchor="middle" font-size="11" fill="var(--muted)">{t.parserNote}</text>

    <text x="400" y="258" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stairNote}</text>

    <text x="55" y="319" text-anchor="middle" font-size="11" fill="var(--muted)" transform="rotate(-90 55 319)">{t.yTag}</text>
    <polyline points="100,345 220,345 220,330 340,330 340,315 460,315 460,300 580,300 580,288 700,288" fill="none" stroke="var(--ink)" stroke-width="2" />
    <line x1="80" y1="288" x2="740" y2="288" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="785" y="282" text-anchor="end" font-size="11" fill="var(--muted)">{t.ulimitTag}</text>
    <text x="785" y="318" text-anchor="end" font-size="11" fill="var(--muted)">{t.emfileTag}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
