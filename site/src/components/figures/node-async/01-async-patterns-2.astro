---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Twelve independent order lookups with sequential await take 4200 milliseconds, the sum of every latency; the same work in Promise.all takes 380 milliseconds, roughly the slowest single call",
    headline: "SEQUENTIAL AWAIT SUMS EVERY LATENCY",
    sub: "twelve independent lookups · same APIs, same data",
    tagSeq: "await in a loop",
    tagSeqMs: "4200 ms · the sum",
    tagPar: "Promise.all",
    tagParMs: "380 ms · slowest one",
    parNote: "≈ slowest single call",
    foot1: "4.2 s in a loop is the sum of every latency",
    foot2: "380 ms in Promise.all is roughly the slowest single call",
    caption:
      "Same APIs, same data — only the awaiting changed. Twelve independent lookups with sequential await in a loop sum every latency (4.2s); fired together with Promise.all they cost roughly the slowest single call (380ms).",
  },
  ru: {
    svgTitle: "Двенадцать независимых поисков заказов через последовательный await занимают 4200 миллисекунд — сумму всех задержек; та же работа через Promise.all — 380 миллисекунд, примерно как самый медленный одиночный вызов",
    headline: "ПОСЛЕДОВАТЕЛЬНЫЙ AWAIT СУММИРУЕТ ЗАДЕРЖКИ",
    sub: "двенадцать независимых поисков · те же API, те же данные",
    tagSeq: "await в цикле",
    tagSeqMs: "4200 мс · сумма",
    tagPar: "Promise.all",
    tagParMs: "380 мс · медленнейший",
    parNote: "≈ самый медленный вызов",
    foot1: "4.2 с в цикле — это сумма всех задержек",
    foot2: "380 мс в Promise.all — примерно самый медленный вызов",
    caption:
      "Те же API, те же данные — изменилось только ожидание. Двенадцать независимых поисков через последовательный await в цикле суммируют все задержки (4.2с); запущенные вместе через Promise.all они стоят примерно как самый медленный одиночный вызов (380мс).",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="215" y="132" text-anchor="end" font-size="12" fill="var(--ink)">{t.tagSeq}</text>
    <text x="215" y="152" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagSeqMs}</text>
    <rect x="235" y="112" width="480" height="58" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />

    <text x="215" y="236" text-anchor="end" font-size="12" fill="var(--ink)">{t.tagPar}</text>
    <text x="215" y="256" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagParMs}</text>
    <rect x="235" y="216" width="44" height="58" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="305" y="250" font-size="11" fill="var(--muted)">{t.parNote}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="355" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
