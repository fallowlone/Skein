---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Backpressure brake: write() returns false past highWaterMark, producer pauses until the drain event",
    headline: "WRITE UNTIL FALSE, WAIT FOR DRAIN",
    sub: "memory capped near highWaterMark — 16KB, or 16 objects",
    tagProd: "producer",
    prodSub: "Readable, fast",
    tagBuf: "buffer",
    bufSub: "highWaterMark",
    tagCons: "consumer",
    consSub: "Writable, slow",
    edgeWrite: "write(chunk)",
    edgeFlush: "flush",
    edgeBack: "false: pause / drain: resume",
    foot1: "false means the chunk was accepted — stop sending, do not retry",
    foot2: "pipe() and pipeline() automate this loop; pipeline() adds errors plus cleanup",
    caption:
      "Backpressure is the brake built into write(): once buffered bytes pass highWaterMark — 16KB for byte streams, 16 objects in object mode — write() returns false and the producer pauses until 'drain'. pipe() and pipeline() automate the loop; pipeline() also propagates errors and cleans up.",
  },
  ru: {
    svgTitle: "Тормоз backpressure: write() возвращает false за highWaterMark, producer паузится до события drain",
    headline: "ПИШИ ДО FALSE, ЖДИ DRAIN",
    sub: "память ограничена около highWaterMark — 16КБ или 16 объектов",
    tagProd: "producer",
    prodSub: "Readable, быстрый",
    tagBuf: "буфер",
    bufSub: "highWaterMark",
    tagCons: "consumer",
    consSub: "Writable, медленный",
    edgeWrite: "write(chunk)",
    edgeFlush: "сброс",
    edgeBack: "false: пауза / drain: дальше",
    foot1: "false значит chunk принят — перестань слать, не повторяй",
    foot2: "pipe() и pipeline() автоматизируют цикл; pipeline() даёт ошибки и очистку",
    caption:
      "Backpressure — тормоз, встроенный в write(): как только байты в буфере проходят highWaterMark — 16КБ для байтовых потоков, 16 объектов в object mode, — write() возвращает false, и producer паузится до 'drain'. pipe() и pipeline() автоматизируют цикл; pipeline() ещё пробрасывает ошибки и чистит ресурсы.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="150" width="180" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="130" y="184" text-anchor="middle" font-size="13" fill="var(--ink)">{t.tagProd}</text>
    <text x="130" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.prodSub}</text>

    <rect x="310" y="150" width="180" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="184" text-anchor="middle" font-size="13" fill="var(--ink)">{t.tagBuf}</text>
    <text x="400" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bufSub}</text>
    <line x1="310" y1="236" x2="490" y2="236" stroke="var(--accent)" stroke-width="2" stroke-dasharray="7 5" />

    <rect x="580" y="150" width="180" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="670" y="184" text-anchor="middle" font-size="13" fill="var(--ink)">{t.tagCons}</text>
    <text x="670" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.consSub}</text>

    <line x1="220" y1="205" x2="310" y2="205" stroke="var(--muted)" stroke-width="2" />
    <text x="265" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.edgeWrite}</text>
    <line x1="490" y1="205" x2="580" y2="205" stroke="var(--muted)" stroke-width="2" />
    <text x="535" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.edgeFlush}</text>

    <line x1="400" y1="260" x2="130" y2="260" stroke="var(--accent)" stroke-width="2" />
    <line x1="400" y1="260" x2="400" y2="282" stroke="var(--accent)" stroke-width="2" />
    <line x1="130" y1="260" x2="130" y2="282" stroke="var(--accent)" stroke-width="2" />
    <text x="265" y="304" text-anchor="middle" font-size="11" fill="var(--ink)">{t.edgeBack}</text>

    <text x="400" y="346" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="370" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
