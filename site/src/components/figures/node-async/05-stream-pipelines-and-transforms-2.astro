---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "pipeline() wires the same data flow, forwards an error from any stage to one await, and destroys every stream on failure and completion",
    headline: "PIPELINE() WIRES ERRORS AND CLEANUP",
    sub: "one error in, every stream destroyed",
    flowNote: "same data flow and backpressure as pipe()",
    sReq: "req",
    sReqSub: "Readable socket",
    sGunzip: "gunzip",
    sGunzipSub: "Transform",
    sParser: "parser",
    sParserSub: "objectMode out",
    sSink: "sink",
    sSinkSub: "Writable",
    throwNote: "gunzip throws",
    barNote: "one await catches an error from ANY stage",
    destroyNote: "every stream destroyed — on failure AND on completion",
    okNote: "fd released · no staircase · no uncaughtException",
    singleNote: "one stream only? use stream.finished()",
    caption:
      "pipeline() wires the same data flow and backpressure, forwards an error from any stage to one await or callback, and destroys every stream on failure and on completion — the fd is released, with no staircase and no uncaughtException.",
  },
  ru: {
    svgTitle: "pipeline() проводит тот же поток данных, пробрасывает ошибку из любого этапа в один await и разрушает каждый поток при сбое и при завершении",
    headline: "PIPELINE() ПРОВОДИТ ОШИБКИ И ОЧИСТКУ",
    sub: "одна ошибка — все потоки разрушены",
    flowNote: "тот же поток данных и backpressure, что у pipe()",
    sReq: "req",
    sReqSub: "входящий сокет",
    sGunzip: "gunzip",
    sGunzipSub: "Трансформ",
    sParser: "parser",
    sParserSub: "записи objectMode",
    sSink: "sink",
    sSinkSub: "Приёмник",
    throwNote: "gunzip падает",
    barNote: "один await ловит ошибку ЛЮБОГО этапа",
    destroyNote: "каждый поток разрушен — при сбое И при завершении",
    okNote: "fd освобождён · нет лесенки · нет uncaughtException",
    singleNote: "только один поток? используй stream.finished()",
    caption:
      "pipeline() проводит тот же поток данных и backpressure, пробрасывает ошибку из любого этапа в один await или callback и разрушает каждый поток при сбое и при завершении — fd освобождается, без лесенки и без uncaughtException.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.flowNote}</text>

    <rect x="30" y="110" width="140" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="100" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sReq}</text>
    <text x="100" y="156" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sReqSub}</text>

    <rect x="200" y="110" width="140" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="270" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sGunzip}</text>
    <text x="270" y="156" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sGunzipSub}</text>

    <rect x="370" y="110" width="140" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="440" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sParser}</text>
    <text x="440" y="156" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sParserSub}</text>

    <rect x="540" y="110" width="170" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="625" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sSink}</text>
    <text x="625" y="156" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sSinkSub}</text>

    <line x1="172" y1="140" x2="190" y2="140" stroke="var(--ink)" stroke-width="2" />
    <polygon points="200,134 188,140 200,146" fill="var(--ink)" />
    <line x1="342" y1="140" x2="360" y2="140" stroke="var(--ink)" stroke-width="2" />
    <polygon points="370,134 358,140 370,146" fill="var(--ink)" />
    <line x1="512" y1="140" x2="530" y2="140" stroke="var(--ink)" stroke-width="2" />
    <polygon points="540,134 528,140 540,146" fill="var(--ink)" />

    <line x1="270" y1="172" x2="270" y2="218" stroke="var(--muted)" stroke-width="2" stroke-dasharray="4 3" />
    <polygon points="262,218 278,218 270,230" fill="var(--muted)" />
    <text x="282" y="206" font-size="11" fill="var(--muted)">{t.throwNote}</text>

    <rect x="240" y="230" width="320" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="255" text-anchor="middle" font-size="12" fill="var(--ink)">{t.barNote}</text>

    <line x1="100" y1="272" x2="100" y2="294" stroke="var(--muted)" stroke-width="2" stroke-dasharray="4 3" />
    <line x1="270" y1="272" x2="270" y2="294" stroke="var(--muted)" stroke-width="2" stroke-dasharray="4 3" />
    <line x1="440" y1="272" x2="440" y2="294" stroke="var(--muted)" stroke-width="2" stroke-dasharray="4 3" />
    <line x1="625" y1="272" x2="625" y2="294" stroke="var(--muted)" stroke-width="2" stroke-dasharray="4 3" />

    <text x="400" y="318" text-anchor="middle" font-size="12" fill="var(--ink)">{t.destroyNote}</text>
    <text x="400" y="342" text-anchor="middle" font-size="12" fill="var(--muted)">{t.okNote}</text>
    <text x="400" y="366" text-anchor="middle" font-size="11" fill="var(--muted)">{t.singleNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
