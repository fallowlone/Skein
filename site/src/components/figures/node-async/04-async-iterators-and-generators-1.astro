---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Eager array materialization holds about 1.5 GB for 10M rows of 150 bytes and scales O(N), while the lazy generator pipeline holds about four live objects and scales O(1)",
    headline: "EAGER BUFFERS GIGABYTES · LAZY HOLDS FOUR OBJECTS",
    sub: "peak memory for 10M rows of ~150 bytes",
    leftTitle: "EAGER ARRAY",
    bar1: "rows ≈ 1.5 GB",
    bar2: ".map → +1 full array",
    bar3: ".filter → +1 full array",
    leftFoot1: "peak scales O(N)",
    leftFoot2: "no backpressure",
    rightTitle: "LAZY GENERATOR PIPELINE",
    stageNote: "one live row per stage",
    rightFoot1: "≈ 4 objects, peak O(1)",
    rightFoot2: "backpressure: sink → cursor",
    foot1: "10M rows × ~150 bytes ≈ 1.5 GB eager",
    foot2: "lazy: one row per stage — O(1) at any row count",
    caption:
      "Eager materialization scales peak memory with the result set (~1.5 GB for 10M rows); the lazy generator pipeline holds one item per stage — O(1) — and threads backpressure end to end.",
  },
  ru: {
    svgTitle: "Жадный массив держит около 1.5 ГБ на 10М строк по 150 байт и масштабируется O(N), а ленивый конвейер генераторов держит около четырёх живых объектов и масштабируется O(1)",
    headline: "ЖАДНО — ГИГАБАЙТЫ · ЛЕНИВО — ЧЕТЫРЕ ОБЪЕКТА",
    sub: "пиковая память на 10М строк по ~150 байт",
    leftTitle: "ЖАДНЫЙ МАССИВ",
    bar1: "строки ≈ 1.5 ГБ",
    bar2: ".map → +1 полный массив",
    bar3: ".filter → +1 полный массив",
    leftFoot1: "пик растёт O(N)",
    leftFoot2: "без backpressure",
    rightTitle: "ЛЕНИВЫЙ КОНВЕЙЕР",
    stageNote: "по одной живой строке на стадию",
    rightFoot1: "≈ 4 объекта, пик O(1)",
    rightFoot2: "backpressure: sink → cursor",
    foot1: "10М строк × ~150 байт ≈ 1.5 ГБ жадно",
    foot2: "лениво: по строке на стадию — O(1) при любом числе строк",
    caption:
      "Жадная материализация масштабирует пиковую память с результирующим набором (~1.5 ГБ на 10М строк); ленивый конвейер генераторов держит по одному элементу на стадию — O(1) — и прошивает backpressure из конца в конец.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="340" height="220" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="210" y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    <rect x="60" y="134" width="300" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="210" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar1}</text>
    <rect x="60" y="168" width="300" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="210" y="186" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar2}</text>
    <rect x="60" y="202" width="300" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="210" y="220" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar3}</text>
    <text x="210" y="254" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftFoot1}</text>
    <text x="210" y="280" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftFoot2}</text>

    <rect x="420" y="90" width="340" height="220" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    <rect x="440" y="134" width="62" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <rect x="514" y="134" width="62" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <rect x="588" y="134" width="62" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <rect x="662" y="134" width="62" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="471" y="160" text-anchor="middle" font-size="10" fill="var(--ink)">src</text>
    <text x="545" y="160" text-anchor="middle" font-size="10" fill="var(--ink)">filter</text>
    <text x="619" y="160" text-anchor="middle" font-size="10" fill="var(--ink)">map</text>
    <text x="693" y="160" text-anchor="middle" font-size="10" fill="var(--ink)">sink</text>
    <text x="590" y="208" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stageNote}</text>
    <text x="590" y="254" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightFoot1}</text>
    <text x="590" y="280" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightFoot2}</text>

    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="370" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
