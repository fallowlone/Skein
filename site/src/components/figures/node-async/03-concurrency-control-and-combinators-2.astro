---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Job completion time for 48,000 calls at 40 milliseconds each: N=1 sequential takes 1920 seconds, N=12 bounded takes 160 seconds, N=16 bounded takes 120 seconds, unbounded crashes instead of completing",
    headline: "COMPLETION TIME ≈ TOTAL WORK / N",
    sub: "48,000 calls × 40 ms against a pool of 20",
    n1: "N=1 · sequential",
    n1val: "1920 s (~32 min)",
    n12: "N=12 · bounded",
    n12val: "160 s",
    n16: "N=16 · bounded",
    n16val: "120 s",
    nunb: "N=∞ · unbounded",
    nunbVal: "crash — ETIMEDOUT, no bar",
    foot: "bounded N=12–16 finishes in ~2 min vs ~32 min sequential",
    caption:
      "Completion time is roughly total work / N: a bounded pool at N=12–16 finishes in ~2 minutes versus ~32 minutes sequential. Unbounded has no bar — it “finishes” only by crashing the shared pool.",
  },
  ru: {
    svgTitle: "Время выполнения задания на 48 000 вызовов по 40 миллисекунд: N=1 последовательно занимает 1920 секунд, N=12 ограниченный — 160 секунд, N=16 ограниченный — 120 секунд, неограниченный падает вместо завершения",
    headline: "ВРЕМЯ ВЫПОЛНЕНИЯ ≈ ОБЩАЯ РАБОТА / N",
    sub: "48 000 вызовов × 40 мс против пула из 20",
    n1: "N=1 · последовательно",
    n1val: "1920 с (~32 мин)",
    n12: "N=12 · ограниченный",
    n12val: "160 с",
    n16: "N=16 · ограниченный",
    n16val: "120 с",
    nunb: "N=∞ · без лимита",
    nunbVal: "падение — ETIMEDOUT, столбца нет",
    foot: "пул N=12–16 финиширует за ~2 мин против ~32 мин",
    caption:
      "Время выполнения примерно равно общей работе / N: ограниченный пул при N=12–16 финиширует за ~2 минуты против ~32 минут последовательно. У неограниченного нет столбца — он «финиширует» лишь падением общего пула.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="160" y="128" text-anchor="end" font-size="11" fill="var(--muted)">{t.n1}</text>
    <rect x="180" y="100" width="440" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="640" y="128" font-size="12" fill="var(--ink)">{t.n1val}</text>

    <text x="160" y="198" text-anchor="end" font-size="11" fill="var(--muted)">{t.n12}</text>
    <rect x="180" y="170" width="45" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="245" y="198" font-size="12" fill="var(--ink)">{t.n12val}</text>

    <text x="160" y="268" text-anchor="end" font-size="11" fill="var(--muted)">{t.n16}</text>
    <rect x="180" y="240" width="34" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="234" y="268" font-size="12" fill="var(--ink)">{t.n16val}</text>

    <text x="160" y="338" text-anchor="end" font-size="11" fill="var(--muted)">{t.nunb}</text>
    <rect x="180" y="310" width="440" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="338" text-anchor="middle" font-size="12" fill="var(--ink)">{t.nunbVal}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
