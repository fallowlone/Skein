---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "An async generator suspends at each yield until the consumer calls next(), and for await pulls one next() at a time, so memory stays at one page plus one record",
    headline: "YIELD SUSPENDS · NEXT() RESUMES",
    sub: "async function* builds the async iterator for you",
    proto: "Symbol.asyncIterator → next() → Promise{ value, done }",
    consumer: "consumer",
    consumerSub: "for await … of",
    producer: "producer",
    producerSub: "async function* + yield",
    pullLabel: "next(): pull one",
    yieldLabel: "yield: one value, then frozen",
    step1: "1 · for await calls next() — one at a time, sequential",
    step2: "2 · generator awaits the page, then yields one user",
    step3: "3 · generator frozen at yield until pulled again",
    step4: "4 · next page fetched only when the buffer is drained",
    caption:
      "Each yield suspends the generator until the consumer pulls again, so memory stays at one page plus one record whether the API has 100 users or 100 million.",
  },
  ru: {
    svgTitle: "Асинхронный генератор приостанавливается на каждом yield, пока потребитель не вызовет next(), а for await тянет по одному next() за раз, поэтому память — одна страница плюс одна запись",
    headline: "YIELD ПРИОСТАНАВЛИВАЕТ · NEXT() ВОЗОБНОВЛЯЕТ",
    sub: "async function* строит асинхронный итератор за тебя",
    proto: "Symbol.asyncIterator → next() → Promise{ value, done }",
    consumer: "потребитель",
    consumerSub: "for await … of",
    producer: "продюсер",
    producerSub: "async function* + yield",
    pullLabel: "next(): тяни по одному",
    yieldLabel: "yield: одно значение — функция приостановлена",
    step1: "1 · for await вызывает next() — по одному, последовательно",
    step2: "2 · генератор await-ит страницу, затем yield-ит пользователя",
    step3: "3 · генератор заморожен на yield, пока снова не потянут",
    step4: "4 · следующая страница — только когда буфер опустошён",
    caption:
      "Каждый yield приостанавливает генератор, пока потребитель снова не потянет, поэтому память — одна страница плюс одна запись, есть у API 100 пользователей или 100 миллионов.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="96" text-anchor="middle" font-size="12" fill="var(--ink)">{t.proto}</text>

    <rect x="80" y="120" width="220" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="190" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.consumer}</text>
    <text x="190" y="176" text-anchor="middle" font-size="11" fill="var(--muted)">{t.consumerSub}</text>

    <rect x="500" y="120" width="220" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.producer}</text>
    <text x="610" y="176" text-anchor="middle" font-size="11" fill="var(--muted)">{t.producerSub}</text>

    <text x="400" y="148" text-anchor="middle" font-size="11" fill="var(--muted)">{t.pullLabel}</text>
    <line x1="310" y1="156" x2="490" y2="156" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="194" text-anchor="middle" font-size="11" fill="var(--muted)">{t.yieldLabel}</text>
    <line x1="490" y1="206" x2="310" y2="206" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />

    <text x="60" y="252" font-size="12" fill="var(--ink)">{t.step1}</text>
    <text x="60" y="284" font-size="12" fill="var(--ink)">{t.step2}</text>
    <text x="60" y="316" font-size="12" fill="var(--ink)">{t.step3}</text>
    <text x="60" y="348" font-size="12" fill="var(--ink)">{t.step4}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
