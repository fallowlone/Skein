---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Pushing per chunk in _transform keeps memory flat at about 48KB; buffering everything to emit in _flush costs 4GB of RAM for a 4GB input and then OOMs",
    headline: "SAME JOB, TWO MEMORY PROFILES",
    sub: "memory cost as input grows",
    yTag: "RAM",
    zeroTag: "0",
    fourGbTag: "4 GB input",
    flatNote: "push per chunk: flat ~48KB (3×16KB)",
    bufNote: "buffering everything in _flush — grows with input",
    oomNote: "4 GB in → 4 GB RAM, then OOM",
    oomTag: "OOM",
    legFlat: "push as you go — ~48KB flat across 3 stages",
    legBuf: "buffer everything in _flush — scales with input, then OOMs",
    caption:
      "Pushing per chunk in _transform keeps memory flat at about 48KB (3×16KB) no matter how large the input grows; buffering everything to emit in _flush scales with input size, so a 4GB input costs 4GB of RAM and then OOMs.",
  },
  ru: {
    svgTitle: "Пуш по чанку в _transform держит память плоской на ~48КБ; буферизация всего ради отдачи в _flush стоит 4ГБ RAM на вход 4ГБ, а затем OOM",
    headline: "ТА ЖЕ РАБОТА, ДВА ПРОФИЛЯ ПАМЯТИ",
    sub: "цена памяти с ростом входа",
    yTag: "RAM",
    zeroTag: "0",
    fourGbTag: "вход 4 ГБ",
    flatNote: "пуш по чанку: плоско ~48КБ (3×16КБ)",
    bufNote: "буферизация всего в _flush — растёт со входом",
    oomNote: "4 ГБ входа → 4 ГБ RAM, затем OOM",
    oomTag: "OOM",
    legFlat: "пуш-по-ходу — ~48КБ плоско на 3 этапах",
    legBuf: "буфер-всё-в-_flush — растёт со входом, затем OOM",
    caption:
      "Пуш по чанку в _transform держит память плоской на ~48КБ (3×16КБ), каким бы большим ни рос вход; буферизация всего ради отдачи в _flush растёт с размером входа, так что вход 4ГБ стоит 4ГБ RAM, а затем OOM.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="60" y="215" text-anchor="middle" font-size="11" fill="var(--muted)" transform="rotate(-90 60 215)">{t.yTag}</text>
    <line x1="90" y1="120" x2="90" y2="310" stroke="var(--muted)" stroke-width="1" />
    <line x1="90" y1="310" x2="740" y2="310" stroke="var(--muted)" stroke-width="1" />
    <text x="90" y="332" text-anchor="middle" font-size="11" fill="var(--muted)">{t.zeroTag}</text>
    <text x="720" y="332" text-anchor="middle" font-size="11" fill="var(--muted)">{t.fourGbTag}</text>

    <line x1="90" y1="285" x2="740" y2="285" stroke="var(--accent)" stroke-width="3" />
    <text x="100" y="272" font-size="11" fill="var(--ink)">{t.flatNote}</text>

    <line x1="90" y1="285" x2="700" y2="130" stroke="var(--muted)" stroke-width="3" stroke-dasharray="7 5" />
    <text x="330" y="172" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bufNote}</text>
    <text x="520" y="250" text-anchor="middle" font-size="11" fill="var(--muted)">{t.oomNote}</text>
    <text x="712" y="122" font-size="12" fill="var(--ink)">{t.oomTag}</text>

    <line x1="90" y1="358" x2="140" y2="358" stroke="var(--accent)" stroke-width="3" />
    <text x="155" y="362" font-size="11" fill="var(--ink)">{t.legFlat}</text>
    <line x1="90" y1="382" x2="140" y2="382" stroke="var(--muted)" stroke-width="3" stroke-dasharray="7 5" />
    <text x="155" y="386" font-size="11" fill="var(--muted)">{t.legBuf}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
