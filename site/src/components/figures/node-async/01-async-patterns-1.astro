---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Callbacks, promises, and async/await are one model in three syntaxes: error-first callbacks hand control away, promises are a value you own, async/await reads top to bottom",
    headline: "ONE MODEL, THREE SYNTAXES",
    sub: "callbacks → promises → async/await",
    tagCallback: "callback",
    tagPromise: "promise",
    tagAsync: "async/await",
    cbLine1: "error-first: (err, data)",
    cbLine2: "hands control away — inversion of control",
    prLine1: "a value you own: pending → fulfilled / rejected",
    prLine2: ".then chains transforms · one .catch path",
    awLine1: "async fn always returns a promise",
    awLine2: "await unwraps — or throws → try/catch",
    foot1: "same model, each step composing better",
    foot2: "pick one syntax per logical flow",
    caption:
      "Callbacks, promises, and async/await are one model in three syntaxes: error-first callbacks hand control to someone else's function, promises take it back as a value you own, and async/await reads the same promises top to bottom with try/catch.",
  },
  ru: {
    svgTitle: "Callback, promise и async/await — одна модель в трёх синтаксисах: error-first callback отдаёт управление, promise — значение, которым владеешь ты, async/await читается сверху вниз",
    headline: "ОДНА МОДЕЛЬ, ТРИ СИНТАКСИСА",
    sub: "callback → promise → async/await",
    tagCallback: "callback",
    tagPromise: "promise",
    tagAsync: "async/await",
    cbLine1: "error-first: (err, data)",
    cbLine2: "управление — в чужих руках",
    prLine1: "значение твоё: pending → fulfilled / rejected",
    prLine2: ".then цепляет · один путь .catch",
    awLine1: "async-функция всегда возвращает promise",
    awLine2: "await разворачивает — или бросает → try/catch",
    foot1: "та же модель, каждый шаг композируется лучше",
    foot2: "один синтаксис на логический поток",
    caption:
      "Callback, promise и async/await — одна модель в трёх синтаксисах: error-first callback отдаёт управление в чужую функцию, promise забирает его обратно как значение, которым владеешь ты, а async/await читает те же promise сверху вниз через try/catch.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="126" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagCallback}</text>
    <rect x="170" y="94" width="460" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="122" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cbLine1}</text>
    <text x="400" y="144" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cbLine2}</text>

    <text x="150" y="216" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagPromise}</text>
    <rect x="170" y="184" width="460" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.prLine1}</text>
    <text x="400" y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{t.prLine2}</text>

    <text x="150" y="306" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagAsync}</text>
    <rect x="170" y="274" width="460" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="302" text-anchor="middle" font-size="12" fill="var(--ink)">{t.awLine1}</text>
    <text x="400" y="324" text-anchor="middle" font-size="11" fill="var(--ink)">{t.awLine2}</text>

    <text x="400" y="376" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="400" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
