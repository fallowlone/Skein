---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A Promise.race timeout leaks the loser which holds its socket to 30 seconds and more, while AbortSignal.timeout cancels for real and closes the socket at 2 seconds",
    headline: "race LEAKS THE LOSER — AbortController CANCELS IT",
    sub: "timeout = 2 s; stalled upstream = 30 s+",
    laneRace: "Promise.race",
    raceMark: "2 s — timeout wins, fetch NOT cancelled",
    raceTail: "holds socket to 30 s+; later reject → unhandledRejection",
    laneAbort: "AbortSignal.timeout(2000)",
    abortMark: "socket closed at 2 s — real cancellation",
    abortTail: "2 s instead of 30 s+ ≈ 15× less occupancy per call",
    foot: "thread the same signal into every await — one abort unwinds the whole tree",
    caption:
      "A Promise.race timeout only stops listening: the loser keeps running, holds its socket to 30 seconds and more, and risks an unhandled rejection. AbortSignal.timeout(2000) really cancels — the socket closes at 2 seconds, cutting worst-case occupancy roughly 15×.",
  },
  ru: {
    svgTitle: "Таймаут через Promise.race утекает проигравшим, который держит сокет 30 секунд и дольше, а AbortSignal.timeout отменяет по-настоящему и закрывает сокет на 2 секундах",
    headline: "race УТЕКАЕТ ПРОИГРАВШИМ — AbortController ОТМЕНЯЕТ",
    sub: "таймаут = 2 с; зависший upstream = 30+ с",
    laneRace: "Promise.race",
    raceMark: "2 с — таймаут победил, fetch НЕ отменён",
    raceTail: "держит сокет до 30+ с; поздний реджект → unhandledRejection",
    laneAbort: "AbortSignal.timeout(2000)",
    abortMark: "сокет закрыт на 2 с — настоящая отмена",
    abortTail: "2 с вместо 30+ с ≈ в 15 раз меньше занятости на вызов",
    foot: "протяни тот же сигнал в каждый await — одна отмена раскрутит всё дерево",
    caption:
      "Таймаут через Promise.race лишь перестаёт слушать: проигравший продолжает бежать, держит сокет 30 секунд и дольше и рискует необработанным реджектом. AbortSignal.timeout(2000) отменяет по-настоящему — сокет закрывается на 2 секундах, срезая worst-case-занятость примерно в 15 раз.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="180" y="145" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneRace}</text>
    <text x="254" y="112" font-size="11" fill="var(--ink)">{t.raceMark}</text>
    <rect x="200" y="125" width="540" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <line x1="234" y1="115" x2="234" y2="180" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="192" font-size="11" fill="var(--ink)">{t.raceTail}</text>

    <text x="180" y="272" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneAbort}</text>
    <rect x="200" y="245" width="34" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <line x1="234" y1="235" x2="234" y2="300" stroke="var(--accent)" stroke-width="2" />
    <text x="254" y="262" font-size="11" fill="var(--ink)">{t.abortMark}</text>
    <text x="200" y="312" font-size="11" fill="var(--ink)">{t.abortTail}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
