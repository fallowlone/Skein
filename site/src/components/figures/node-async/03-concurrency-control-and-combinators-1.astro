---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The four Promise combinators and how each settles when one input fails: all rejects first, allSettled never rejects, race takes the first settle, any takes the first fulfillment",
    headline: "FOUR COMBINATORS — ONE FAILURE, FOUR OUTCOMES",
    sub: "pick by what a single rejection should mean",
    rowAll: "Promise.all → ordered array, or rejects on FIRST rejection",
    rowAllSub: "rejection does NOT cancel siblings — they keep running",
    rowSettled: "Promise.allSettled → NEVER rejects",
    rowSettledSub: "one {status, value/reason} descriptor per input, in order",
    rowRace: "Promise.race → settles with the FIRST to settle",
    rowRaceSub: "win OR lose — the loser keeps running (leak)",
    rowAny: "Promise.any → first FULFILLMENT wins",
    rowAnySub: "all reject → AggregateError (.errors[])",
    foot: "all rejects but never cancels: siblings hold connections to the end",
    caption:
      "The four combinators differ the moment something fails: Promise.all rejects on the first rejection without cancelling its siblings, allSettled never rejects and reports every outcome, race takes the first settle win or lose, and any takes the first fulfillment or throws AggregateError.",
  },
  ru: {
    svgTitle: "Четыре комбинатора Promise и как каждый оседает при падении одного входа: all реджектится первым, allSettled не реджектится никогда, race берёт первое оседание, any — первое выполнение",
    headline: "ЧЕТЫРЕ КОМБИНАТОРА — ОДИН СБОЙ, ЧЕТЫРЕ ИСХОДА",
    sub: "выбирай по тому, что должен значить один реджект",
    rowAll: "Promise.all → упорядоченный массив или реджект на ПЕРВОМ",
    rowAllSub: "реджект НЕ отменяет соседей — они продолжают бежать",
    rowSettled: "Promise.allSettled → НИКОГДА не реджектится",
    rowSettledSub: "один дескриптор {status, value/reason} на вход, по порядку",
    rowRace: "Promise.race → оседает ПЕРВЫМ осевшим",
    rowRaceSub: "победа ИЛИ поражение — проигравший продолжает бежать",
    rowAny: "Promise.any → первое ВЫПОЛНЕНИЕ побеждает",
    rowAnySub: "все реджектнулись → AggregateError (.errors[])",
    foot: "реджект all не отменяет соседей: они держат соединения до конца",
    caption:
      "Четыре комбинатора различаются в миг сбоя: Promise.all реджектится на первом реджекте, не отменяя соседей, allSettled не реджектится никогда и отдаёт каждый исход, race берёт первое оседание в победу или поражение, а any — первое выполнение или бросает AggregateError.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="170" y="90" width="460" height="58" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="114" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rowAll}</text>
    <text x="400" y="136" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rowAllSub}</text>

    <rect x="170" y="160" width="460" height="58" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="184" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rowSettled}</text>
    <text x="400" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rowSettledSub}</text>

    <rect x="170" y="230" width="460" height="58" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="254" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rowRace}</text>
    <text x="400" y="276" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rowRaceSub}</text>

    <rect x="170" y="300" width="460" height="58" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="324" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rowAny}</text>
    <text x="400" y="346" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rowAnySub}</text>

    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
