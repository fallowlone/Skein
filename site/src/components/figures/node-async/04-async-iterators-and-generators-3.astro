---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Leaving for await with break, return or throw calls the iterator return(), which skips code after the yield but runs finally, so a cursor closed in finally always closes",
    headline: "BREAK CALLS RETURN() · FINALLY STILL RUNS",
    sub: "early exit from for await: break / return / throw",
    leftTitle: "CLEANUP IN finally",
    left1: "break → return() runs",
    left2: "code after yield skipped",
    left3: "finally runs: cursor closes",
    rightTitle: "CLEANUP AFTER LOOP",
    right1: "break skips those lines",
    right2: "conn never returns to pool",
    right3: "pool exhausted → queries hang",
    foot1: "manual iterator dropped without return() stays suspended — finally never runs",
    foot2: "for await always does the right thing; manual iteration is your job",
    caption:
      "On break, return, or throw, for await calls the iterator's return(): the code after the suspended yield is skipped but the enclosing finally runs, closing the cursor — cleanup placed after the loop instead leaks the connection until the pool dies.",
  },
  ru: {
    svgTitle: "Выход из for await через break, return или throw вызывает return() итератора, который пропускает код после yield, но выполняет finally, поэтому курсор, закрытый в finally, закрывается всегда",
    headline: "BREAK → RETURN() · FINALLY ВСЁ РАВНО РАБОТАЕТ",
    sub: "ранний выход из for await: break / return / throw",
    leftTitle: "ОЧИСТКА В finally",
    left1: "break → return() срабатывает",
    left2: "код после yield пропускается",
    left3: "finally выполняется: курсор закрыт",
    rightTitle: "ОЧИСТКА ПОСЛЕ ЦИКЛА",
    right1: "break пропускает эти строки",
    right2: "соединение не вернётся в пул",
    right3: "пул исчерпан → запросы висят",
    foot1: "ручной итератор, брошенный без return(), висит — finally не выполнится",
    foot2: "for await всегда делает правильно; ручная итерация — твоя задача",
    caption:
      "На break, return или throw for await вызывает return() итератора: код после приостановленного yield пропускается, но охватывающий finally выполняется и закрывает курсор — а очистка после цикла вместо этого утечёт соединением, пока пул не умрёт.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="340" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    <text x="210" y="158" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="210" y="198" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="210" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left3}</text>

    <rect x="420" y="90" width="340" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="590" y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    <text x="590" y="158" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="590" y="198" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="590" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right3}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
