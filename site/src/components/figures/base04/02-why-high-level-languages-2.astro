---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One TypeScript line expanded into six machine instructions",
    headline: "ONE STATEMENT, MANY INSTRUCTIONS",
    sub: "you express the intent — the compiler builds the mechanism",
    srcLabel: "one line of TypeScript",
    rowsLabel: "six machine instructions",
    noteRatio: "typically one line stands for 5 to 100 instructions",
    noteFortran: "FORTRAN teams measured about 20 to 1: weeks became days",
    caption:
      "One TypeScript line — const total = price * quantity + shipping — expands into six machine instructions: loads, a multiply, an add, and a store. The programmer chooses no instructions, registers, or addresses; the compiler handles all of it. Typically one line stands for 5 to 100 instructions, and FORTRAN teams measured about a 20 to 1 productivity gain over assembly.",
  },
  ru: {
    svgTitle: "Одна строка TypeScript, развёрнутая в шесть машинных инструкций",
    headline: "ОДИН ОПЕРАТОР — МНОГИЕ ИНСТРУКЦИИ",
    sub: "ты выражаешь замысел — компилятор создаёт механизм",
    srcLabel: "одна строка TypeScript",
    rowsLabel: "шесть машинных инструкций",
    noteRatio: "обычно одна строка — это 5–100 инструкций",
    noteFortran: "команда FORTRAN намерила ~20 к 1: недели стали днями",
    caption:
      "Одна строка TypeScript — const total = price * quantity + shipping — разворачивается в шесть машинных инструкций: загрузки, умножение, сложение и сохранение. Программист не выбирает ни инструкций, ни регистров, ни адресов; со всем справляется компилятор. Обычно одна строка соответствует 5–100 инструкциям, а команда FORTRAN намерила примерно 20-кратный выигрыш в производительности относительно ассемблера.",
  },
};

const t = dict[lang];

const SOURCE = "const total = price * quantity + shipping;";
const RATIO = "1 → 6";

const instrs = [
  "FLOAD Fr0, addr(price)",
  "FLOAD Fr1, addr(quantity)",
  "FMUL Fr0, Fr1",
  "FLOAD Fr1, addr(shipping)",
  "FADD Fr0, Fr1",
  "FSTORE addr(total), Fr0",
];

const rows = instrs.map((text, i) => ({ text, y: 84 + i * 46 }));

const SRC_X = 36;
const SRC_W = 304;
const SRC_Y = 196;
const SRC_H = 90;
const ROW_X = 440;
const ROW_W = 324;
const ROW_H = 38;
const ARROW_Y = 241;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="30" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="54" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={SRC_X + SRC_W / 2} y={SRC_Y - 12} text-anchor="middle" font-size="12" fill="var(--muted)">{t.srcLabel}</text>
    <text x={ROW_X + ROW_W / 2} y="76" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rowsLabel}</text>

    <rect x={SRC_X} y={SRC_Y} width={SRC_W} height={SRC_H} fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x={SRC_X + SRC_W / 2} y={ARROW_Y + 4} text-anchor="middle" font-size="11" fill="var(--card)">{SOURCE}</text>

    {rows.map((r) => (
      <g>
        <rect x={ROW_X} y={r.y} width={ROW_W} height={ROW_H} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={ROW_X + 12} y={r.y + 25} font-size="12" fill="var(--ink)">{r.text}</text>
      </g>
    ))}

    <text x="390" y={ARROW_Y - 12} text-anchor="middle" font-size="12" fill="var(--muted)">{RATIO}</text>
    <line x1={SRC_X + SRC_W} y1={ARROW_Y} x2={ROW_X - 10} y2={ARROW_Y} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${ROW_X},${ARROW_Y} ${ROW_X - 10},${ARROW_Y - 6} ${ROW_X - 10},${ARROW_Y + 6}`} fill="var(--accent)" />

    <text x="400" y="380" text-anchor="middle" font-size="13" fill="var(--muted)">{t.noteRatio}</text>
    <text x="400" y="402" text-anchor="middle" font-size="13" fill="var(--muted)">{t.noteFortran}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
