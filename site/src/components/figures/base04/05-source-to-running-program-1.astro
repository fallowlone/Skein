---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Six stages from source text to CPU execution",
    headline: "SOURCE TEXT → CPU EXECUTION",
    sub: "six stages · every program follows this chain",
    stages: ["source text", "translation", "linking", "loading", "runtime startup", "CPU execution"],
    note: "interpreted languages skip linking — imports resolve at run time",
    caption:
      "Every program travels six stages from source text to CPU execution: you write source, translation emits machine code, the linker builds one executable, the loader copies bytes into memory and sets the program counter, the runtime starts, and the fetch-decode-execute loop runs. The add.c example goes from 143 bytes of text to Result: 7.",
  },
  ru: {
    svgTitle: "Шесть этапов от исходного текста до выполнения на CPU",
    headline: "ОТ ИСХОДНОГО ТЕКСТА ДО CPU",
    sub: "шесть этапов · этот путь проходит каждая программа",
    stages: ["исходный текст", "трансляция", "компоновка", "загрузка", "запуск среды выполнения", "выполнение на CPU"],
    note: "интерпретируемые языки пропускают компоновку — импорты разрешаются во время выполнения",
    caption:
      "Каждая программа проходит шесть этапов от исходного текста до выполнения на CPU: ты пишешь исходный текст, трансляция выдаёт машинный код, компоновщик собирает один исполняемый файл, загрузчик копирует байты в память и ставит счётчик команд, среда выполнения запускается, а цикл выборка-декодирование-исполнение работает. Пример add.c идёт от 143 байт текста до Result: 7.",
  },
};

const t = dict[lang];

const nums = ["1", "2", "3", "4", "5", "6"];
const artifacts = ["add.c · 143 B", "add.o · ?printf", "add + libc", "memory + PC", "main()", "Result: 7"];
const links = [0, 1, 2, 3, 4];

const boxX = 230;
const boxW = 340;
const boxH = 34;
const topY = 78;
const rowStep = 50;
const midX = 400;
const rowY = (i: number) => topY + i * rowStep;
const headPoints = (tipY: number) => `${midX - 7},${tipY - 8} ${midX + 7},${tipY - 8} ${midX},${tipY}`;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.stages.map((s, i) => (
      <g>
        <rect x={boxX} y={rowY(i)} width={boxW} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <rect x={boxX + 10} y={rowY(i) + 7} width="20" height="20" fill="var(--accent)" />
        <text x={boxX + 20} y={rowY(i) + 21} text-anchor="middle" font-size="12" fill="var(--card)">{nums[i]}</text>
        <text x={boxX + 40} y={rowY(i) + 22} font-size="13" fill="var(--ink)">{s}</text>
        <text x={boxX + boxW - 12} y={rowY(i) + 22} text-anchor="end" font-size="12" fill="var(--muted)">{artifacts[i]}</text>
      </g>
    ))}
    {links.map((i) => (
      <g>
        <line x1={midX} y1={rowY(i) + boxH} x2={midX} y2={rowY(i + 1) - 8} stroke="var(--accent)" stroke-width="2" />
        <polygon points={headPoints(rowY(i + 1))} fill="var(--accent)" />
      </g>
    ))}

    <text x="400" y="398" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
