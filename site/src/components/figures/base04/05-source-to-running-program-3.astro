---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The CPU fetch-decode-execute loop runs forever",
    headline: "FETCH-DECODE-EXECUTE — FOREVER",
    sub: "from the first instruction the CPU runs its loop",
    steps: ["Fetch", "Decode", "Execute", "Advance PC"],
    details: ["read bytes at PC", "opcode? registers?", "add · load · jump", "PC to next"],
    loopWord: "loop",
    note: "ends only on: exit call, external kill, or crash",
    caption:
      "From the first instruction the CPU repeats fetch, decode, execute, advance PC: it reads the bytes at the program counter, interprets opcode and registers, carries out the operation, and moves the program counter on. By then each instruction is just a bit pattern in a memory cell, and the loop ends only on an exit call, an external kill, or a crash.",
  },
  ru: {
    svgTitle: "Цикл выборка-декодирование-исполнение на CPU работает бесконечно",
    headline: "ВЫБОРКА-ДЕКОДИРОВАНИЕ-ИСПОЛНЕНИЕ — БЕСКОНЕЧНО",
    sub: "с первой инструкции CPU запускает свой цикл",
    steps: ["Выборка", "Декодирование", "Исполнение", "Сдвиг PC"],
    details: ["байты по адресу PC", "опкод? регистры?", "сложение · переход", "PC на следующую"],
    loopWord: "цикл",
    note: "конец: вызов exit, уничтожение извне или крах",
    caption:
      "С первой инструкции CPU повторяет выборку, декодирование, исполнение и сдвиг PC: читает байты по адресу счётчика команд, интерпретирует опкод и регистры, выполняет операцию и двигает счётчик команд дальше. К этому моменту каждая инструкция — просто битовый паттерн в ячейке памяти, а цикл завершается только вызовом exit, уничтожением извне или крахом.",
  },
};

const t = dict[lang];

const nums = ["1", "2", "3", "4"];
const boxes = [
  { x: 90, y: 104 },
  { x: 460, y: 104 },
  { x: 460, y: 244 },
  { x: 90, y: 244 },
];
const boxW = 250;
const boxH = 80;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {boxes.map((b, i) => (
      <g>
        <rect x={b.x} y={b.y} width={boxW} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <rect x={b.x + 12} y={b.y + 12} width="20" height="20" fill="var(--accent)" />
        <text x={b.x + 22} y={b.y + 26} text-anchor="middle" font-size="12" fill="var(--card)">{nums[i]}</text>
        <text x={b.x + 42} y={b.y + 27} font-size="14" fill="var(--ink)">{t.steps[i]}</text>
        <text x={b.x + 42} y={b.y + 50} font-size="12" fill="var(--muted)">{t.details[i]}</text>
      </g>
    ))}

    <line x1="340" y1="144" x2="451" y2="144" stroke="var(--accent)" stroke-width="2" />
    <polygon points="460,144 451,139 451,149" fill="var(--accent)" />
    <line x1="585" y1="184" x2="585" y2="235" stroke="var(--accent)" stroke-width="2" />
    <polygon points="585,244 580,235 590,235" fill="var(--accent)" />
    <line x1="460" y1="284" x2="349" y2="284" stroke="var(--accent)" stroke-width="2" />
    <polygon points="340,284 349,279 349,289" fill="var(--accent)" />
    <line x1="215" y1="244" x2="215" y2="193" stroke="var(--accent)" stroke-width="2" />
    <polygon points="215,184 210,193 220,193" fill="var(--accent)" />

    <text x="400" y="219" text-anchor="middle" font-size="13" fill="var(--muted)">{t.loopWord}</text>
    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
