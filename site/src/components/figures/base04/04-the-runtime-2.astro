---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Garbage collector scanning the heap and freeing an unreferenced object",
    headline: "THE GC FREES WHAT NOTHING REACHES",
    sub: "runtime scans the heap · frees objects with no live references",
    liveVars: "live variables",
    ref: "reference",
    heap: "heap",
    objects: ["object 1", "object 2", "object 3", "object 4"],
    noRefs: "object 4 has no references",
    freed: "GC frees it automatically",
    legend: "solid = reachable · dashed = freed by GC",
    note: "your code just creates objects; the GC cleans up behind you",
    caption:
      "The runtime manages the heap and hands out pieces of it when code creates new values. The garbage collector periodically scans the heap for objects with no remaining references from live variables and frees them automatically: objects 1–3 are reachable, object 4 has no references, so the GC frees it.",
  },
  ru: {
    svgTitle: "Сборщик мусора сканирует кучу и освобождает объект без ссылок",
    headline: "GC ОСВОБОЖДАЕТ НЕДОСТИЖИМЫЕ ОБЪЕКТЫ",
    sub: "среда выполнения сканирует кучу · освобождает объекты без живых ссылок",
    liveVars: "живые переменные",
    ref: "ссылка",
    heap: "куча (heap)",
    objects: ["объект 1", "объект 2", "объект 3", "объект 4"],
    noRefs: "на объект 4 нет ссылок",
    freed: "GC освобождает его автоматически",
    legend: "сплошная рамка = достижим · пунктир = GC освобождает",
    note: "твой код просто создаёт объекты; GC убирает за тобой",
    caption:
      "Среда выполнения управляет кучей и выдаёт её части, когда код создаёт новые значения. Сборщик мусора периодически сканирует кучу в поисках объектов без оставшихся ссылок из живых переменных и освобождает их автоматически: объекты 1–3 достижимы, на объект 4 нет ссылок, поэтому GC освобождает его.",
  },
};

const t = dict[lang];

const chips = [
  { name: "a", y: 142 },
  { name: "b", y: 202 },
];
const objects = t.objects.map((label, i) => ({
  label,
  x: i < 2 ? 270 : 470,
  y: i % 2 === 0 ? 142 : 202,
  dashed: i === 3,
}));
const arrows = [
  { x1: 140, y1: 162, x2: 270, y2: 162, tip: "270,162 261,157 261,167" },
  { x1: 140, y1: 222, x2: 270, y2: 222, tip: "270,222 261,217 261,227" },
  { x1: 420, y1: 162, x2: 470, y2: 162, tip: "470,162 461,157 461,167" },
  { x1: 600, y1: 278, x2: 600, y2: 242, tip: "600,242 594,252 606,252" },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="60" y="128" font-size="12" fill="var(--muted)">{t.liveVars}</text>
    {chips.map((c) => (
      <g>
        <rect x="60" y={c.y} width="80" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="100" y={c.y + 26} text-anchor="middle" font-size="15" fill="var(--ink)">{c.name}</text>
      </g>
    ))}
    <text x="185" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.ref}</text>

    <rect x="230" y="100" width="420" height="240" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="250" y="126" font-size="13" fill="var(--ink)">{t.heap}</text>
    {objects.map((o) => (
      <g>
        <rect
          x={o.x}
          y={o.y}
          width="150"
          height="40"
          fill="var(--card)"
          stroke={o.dashed ? "var(--muted)" : "var(--ink)"}
          stroke-width="2"
          stroke-dasharray={o.dashed ? "6 4" : undefined}
        />
        <text x={o.x + 75} y={o.y + 26} text-anchor="middle" font-size="12" fill={o.dashed ? "var(--muted)" : "var(--ink)"}>{o.label}</text>
      </g>
    ))}
    {arrows.map((a) => (
      <g>
        <line x1={a.x1} y1={a.y1} x2={a.x2} y2={a.y2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={a.tip} fill="var(--accent)" />
      </g>
    ))}
    <text x="440" y="300" text-anchor="middle" font-size="13" fill="var(--ink)">{t.noRefs}</text>
    <text x="440" y="322" text-anchor="middle" font-size="13" fill="var(--ink)">{t.freed}</text>

    <text x="400" y="366" text-anchor="middle" font-size="12" fill="var(--muted)">{t.legend}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
