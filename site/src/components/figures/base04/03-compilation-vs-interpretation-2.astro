---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Compiled versus interpreted tradeoffs: speed, portability, errors, dev loop",
    headline: "SPEED, PORTABILITY, ERRORS, DEV LOOP",
    sub: "compiled: fast but platform-locked · interpreted: portable but slower",
    headerLabel: "tradeoff",
    headerA: "compiled",
    headerB: "interpreted",
    rows: [
      { label: "speed", a: ["runs faster", "translated up front"], b: ["runs slower", "overhead per statement"] },
      { label: "platform", a: ["one binary per CPU"], b: ["same source everywhere", "needs interpreter installed"] },
      { label: "errors", a: ["checked before run", "whole program visible"], b: ["found at run time", "only at the bad line"] },
      { label: "dev loop", a: ["edit → recompile", "seconds to minutes"], b: ["edit → re-run at once", "no compile step"] },
    ],
    slowPre: "CPython: ",
    slowPost: "× slower than C for CPU-bound work",
    caption:
      "Compiled programs run faster with the whole program checked before run, but need one binary per CPU and a recompile step. Interpreted programs run the same source anywhere with no compile step, but pay per-statement overhead — CPython is 10–100× slower than C on CPU-bound work.",
  },
  ru: {
    svgTitle: "Компромиссы компиляции и интерпретации: скорость, переносимость, ошибки, цикл",
    headline: "СКОРОСТЬ, ПЕРЕНОСИМОСТЬ, ОШИБКИ, ЦИКЛ",
    sub: "компиляция: быстро, но под платформу · интерпретация: везде, но медленнее",
    headerLabel: "компромисс",
    headerA: "компиляция",
    headerB: "интерпретация",
    rows: [
      { label: "скорость", a: ["выполняется быстрее", "транслировано заранее"], b: ["выполняется медленнее", "расходы на каждый оператор"] },
      { label: "платформа", a: ["один двоичный на CPU"], b: ["тот же источник — везде", "нужен установленный интерпретатор"] },
      { label: "ошибки", a: ["проверены до запуска", "видна вся программа"], b: ["находятся при работе", "лишь дойдя до плохой строки"] },
      { label: "цикл разработки", a: ["правка → перекомпиляция", "от секунд до минут"], b: ["правка → сразу перезапуск", "без шага компиляции"] },
    ],
    slowPre: "CPython: в ",
    slowPost: " раз медленнее C при нагрузке CPU",
    caption:
      "Скомпилированные программы выполняются быстрее, а вся программа проверена до запуска, но нужен отдельный двоичный файл на каждый CPU и шаг перекомпиляции. Интерпретируемые программы запускают тот же источник везде без шага компиляции, но платят накладные расходы на каждый оператор — CPython в 10–100 раз медленнее C при нагрузке CPU.",
  },
};

const t = dict[lang];

const archNote = "x86-64 ≠ ARM";
const slow = "10–100";
const rowA2 = [undefined, archNote, undefined, undefined];
const rowGeom = [{ y: 132 }, { y: 186 }, { y: 240 }, { y: 294 }];
const rowH = 54;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="172" y="108" text-anchor="end" font-size="12" fill="var(--muted)">{t.headerLabel}</text>
    <rect x="190" y="80" width="295" height="44" fill="var(--ink)" stroke="var(--ink)" stroke-width="2" />
    <text x="337" y="108" text-anchor="middle" font-size="13" fill="var(--card)">{t.headerA}</text>
    <rect x="495" y="80" width="285" height="44" fill="var(--ink)" stroke="var(--ink)" stroke-width="2" />
    <text x="637" y="108" text-anchor="middle" font-size="13" fill="var(--card)">{t.headerB}</text>

    {rowGeom.map((r, i) => (
      <g>
        <text x="172" y={r.y + 32} text-anchor="end" font-size="12" fill="var(--ink)">{t.rows[i].label}</text>
        <rect x="190" y={r.y} width="295" height={rowH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="337" y={r.y + 22} text-anchor="middle" font-size="12" fill="var(--ink)">{t.rows[i].a[0]}</text>
        <text x="337" y={r.y + 42} text-anchor="middle" font-size="11" fill="var(--muted)">{rowA2[i] ?? t.rows[i].a[1]}</text>
        <rect x="495" y={r.y} width="285" height={rowH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="637" y={r.y + 22} text-anchor="middle" font-size="12" fill="var(--ink)">{t.rows[i].b[0]}</text>
        <text x="637" y={r.y + 42} text-anchor="middle" font-size="11" fill="var(--muted)">{t.rows[i].b[1]}</text>
      </g>
    ))}

    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--ink)">{t.slowPre}{slow}{t.slowPost}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
