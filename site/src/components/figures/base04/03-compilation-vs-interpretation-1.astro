---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Compiler pipeline versus interpreter loop",
    headline: "TRANSLATE FIRST OR TRANSLATE WHILE RUNNING",
    sub: "compiler: whole file → binary before run · interpreter: line by line at run time",
    laneAot: "AOT · translate everything first",
    laneInterp: "interpret · one statement at a time",
    aot: [
      ["source file", "the whole file"],
      ["compiler", "before run"],
      ["binary file", "machine code"],
      ["CPU runs it", "no translation overhead"],
    ],
    interp: [
      ["source file", "plain text"],
      ["interpreter", "at run time"],
      ["carries out each action directly", "by its own machine code"],
    ],
    nextStmt: "next statement",
    foot1: "compiler: parse · analyse · optimise · emit machine code",
    foot2: "each statement: read · decide · execute · move to next",
    foot3: "the interpreter never writes a binary file",
    caption:
      "A compiler translates the whole source file into a binary before anything runs, and the CPU executes it with no translation overhead. An interpreter reads the source at run time, one statement at a time — read, decide, execute, move — and never produces a binary.",
  },
  ru: {
    svgTitle: "Конвейер компилятора против цикла интерпретатора",
    headline: "ТРАНСЛИРУЙ СНАЧАЛА ИЛИ ТРАНСЛИРУЙ НА ХОДУ",
    sub: "компилятор: весь файл → двоичный до запуска · интерпретатор: построчно на ходу",
    laneAot: "AOT · сначала транслируй всё",
    laneInterp: "интерпретация · по одному оператору за раз",
    aot: [
      ["исходный файл", "весь файл целиком"],
      ["компилятор", "до запуска"],
      ["двоичный файл", "машинный код"],
      ["CPU исполняет", "без накладных расходов"],
    ],
    interp: [
      ["исходный файл", "обычный текст"],
      ["интерпретатор", "во время выполнения"],
      ["выполняет каждое действие напрямую", "собственным машинным кодом"],
    ],
    nextStmt: "следующий оператор",
    foot1: "компилятор: разбор · анализ · оптимизация · генерация машинного кода",
    foot2: "каждый оператор: читает · определяет · выполняет · переходит дальше",
    foot3: "интерпретатор никогда не пишет двоичный файл",
    caption:
      "Компилятор транслирует весь исходный файл в двоичный до запуска чего-либо, и CPU исполняет его без накладных расходов на трансляцию. Интерпретатор читает исходный файл во время выполнения по одному оператору — читает, определяет, выполняет, переходит — и никогда не создаёт двоичный файл.",
  },
};

const t = dict[lang];

const boxH = 56;
const aotY = 98;
const intY = 190;
const aotBoxes = [
  { x: 30, w: 140 },
  { x: 195, w: 200 },
  { x: 420, w: 150 },
  { x: 600, w: 150 },
];
const intBoxes = [
  { x: 30, w: 140 },
  { x: 195, w: 200 },
  { x: 420, w: 330 },
];
const aotArrows = [
  { x1: 170, x2: 195, y: aotY + boxH / 2 },
  { x1: 395, x2: 420, y: aotY + boxH / 2 },
  { x1: 570, x2: 600, y: aotY + boxH / 2 },
];
const intArrows = [
  { x1: 170, x2: 195, y: intY + boxH / 2 },
  { x1: 395, x2: 420, y: intY + boxH / 2 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="30" y="90" font-size="12" fill="var(--muted)">{t.laneAot}</text>
    {aotBoxes.map((b, i) => (
      <g>
        <rect x={b.x} y={aotY} width={b.w} height={boxH} fill={i === 3 ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={b.x + b.w / 2} y={aotY + 23} text-anchor="middle" font-size="12" fill={i === 3 ? "var(--card)" : "var(--ink)"}>{t.aot[i][0]}</text>
        <text x={b.x + b.w / 2} y={aotY + 42} text-anchor="middle" font-size="10" fill={i === 3 ? "var(--card)" : "var(--muted)"}>{t.aot[i][1]}</text>
      </g>
    ))}
    {aotArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={a.y} x2={a.x2 - 8} y2={a.y} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${a.x2 - 8},${a.y - 5} ${a.x2 - 8},${a.y + 5} ${a.x2},${a.y}`} fill="var(--accent)" />
      </g>
    ))}

    <text x="30" y="182" font-size="12" fill="var(--muted)">{t.laneInterp}</text>
    {intBoxes.map((b, i) => (
      <g>
        <rect x={b.x} y={intY} width={b.w} height={boxH} fill={i === 2 ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={b.x + b.w / 2} y={intY + 23} text-anchor="middle" font-size="12" fill={i === 2 ? "var(--card)" : "var(--ink)"}>{t.interp[i][0]}</text>
        <text x={b.x + b.w / 2} y={intY + 42} text-anchor="middle" font-size="10" fill={i === 2 ? "var(--card)" : "var(--muted)"}>{t.interp[i][1]}</text>
      </g>
    ))}
    {intArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={a.y} x2={a.x2 - 8} y2={a.y} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${a.x2 - 8},${a.y - 5} ${a.x2 - 8},${a.y + 5} ${a.x2},${a.y}`} fill="var(--accent)" />
      </g>
    ))}

    <line x1="295" y1="246" x2="295" y2="270" stroke="var(--accent)" stroke-width="2" />
    <line x1="295" y1="270" x2="252" y2="270" stroke="var(--accent)" stroke-width="2" />
    <line x1="142" y1="270" x2="100" y2="270" stroke="var(--accent)" stroke-width="2" />
    <line x1="100" y1="270" x2="100" y2="254" stroke="var(--accent)" stroke-width="2" />
    <polygon points="95,254 105,254 100,246" fill="var(--accent)" />
    <text x="197" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.nextStmt}</text>

    <text x="400" y="312" text-anchor="middle" font-size="11" fill="var(--ink)">{t.foot1}</text>
    <text x="400" y="340" text-anchor="middle" font-size="11" fill="var(--ink)">{t.foot2}</text>
    <text x="400" y="368" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot3}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
