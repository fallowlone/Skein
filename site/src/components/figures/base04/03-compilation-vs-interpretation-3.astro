---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "JIT compiles hot spots to native code after a slow interpreted warm-up",
    headline: "JIT: HOT SPOTS TURN NATIVE MID-RUN",
    sub: "interpret first · detect hot spots · compile to native at run time",
    tagRun: "how JIT runs",
    stages: [
      ["first calls", "interpreted · slow"],
      ["hot spots found", "frequent code only"],
      ["native code", "fast · near-C speed"],
    ],
    tagPrice: "the price and the payoff",
    warmup: ["warm-up", "slow start · interpreted"],
    peak: ["peak after warm-up", "fast finish · native"],
    tagBytecode: "bytecode: the middle stage",
    bc: [
      ["source text", "plain text"],
      ["bytecode", "compact · portable"],
      ["virtual machine", "interprets or JITs it"],
    ],
    foot1: "bytecode: smaller and faster than source · still machine-independent",
    foot2: "no AOT step: fast startup + compiled speed on hot paths",
    caption:
      "JIT starts by interpreting, then compiles only the frequently executed hot spots to native machine code at run time. First calls are slow; peak speed comes after warm-up. Bytecode is the portable middle stage: smaller than source, executed by a virtual machine that interprets or JIT-compiles it.",
  },
  ru: {
    svgTitle: "JIT компилирует горячие точки в нативный код после медленного прогрева",
    headline: "JIT: ГОРЯЧИЕ ТОЧКИ СТАНОВЯТСЯ НАТИВНЫМИ",
    sub: "сначала интерпретация · горячие точки · нативный код на лету",
    tagRun: "как работает JIT",
    stages: [
      ["первые вызовы", "интерпретация · медленно"],
      ["горячие точки найдены", "только частый код"],
      ["нативный код", "быстро · почти как C"],
    ],
    tagPrice: "цена и выигрыш",
    warmup: ["прогрев", "медленный старт · интерпретация"],
    peak: ["пик после прогрева", "быстрый финиш · нативный"],
    tagBytecode: "байт-код: промежуточный этап",
    bc: [
      ["исходный текст", "обычный текст"],
      ["байт-код", "компактен · переносим"],
      ["виртуальная машина", "интерпретация или JIT"],
    ],
    foot1: "байт-код: меньше и быстрее исходника · но не зависит от железа",
    foot2: "без шага AOT: быстрый запуск + скорость компиляции на горячих путях",
    caption:
      "JIT начинает с интерпретации, а затем компилирует в нативный машинный код только часто исполняемые горячие точки — уже во время выполнения. Первые вызовы медленные; пиковая скорость приходит после прогрева. Байт-код — переносимый промежуточный этап: меньше исходника, исполняется виртуальной машиной, которая его интерпретирует или JIT-компилирует.",
  },
};

const t = dict[lang];

const stageY = 85;
const stageH = 62;
const stages = [
  { x: 40, w: 215 },
  { x: 292, w: 215 },
  { x: 544, w: 215 },
];
const stageArrows = [
  { x1: 255, x2: 292, y: stageY + stageH / 2 },
  { x1: 507, x2: 544, y: stageY + stageH / 2 },
];
const warmY = 170;
const warmH = 50;
const bcY = 245;
const bcH = 56;
const bcBoxes = [
  { x: 60, w: 200 },
  { x: 300, w: 200 },
  { x: 540, w: 200 },
];
const bcArrows = [
  { x1: 260, x2: 300, y: bcY + bcH / 2 },
  { x1: 500, x2: 540, y: bcY + bcH / 2 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="40" y="78" font-size="11" fill="var(--muted)">{t.tagRun}</text>
    {stages.map((s, i) => (
      <g>
        <rect x={s.x} y={stageY} width={s.w} height={stageH} fill={i === 2 ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={s.x + s.w / 2} y={stageY + 25} text-anchor="middle" font-size="13" fill={i === 2 ? "var(--card)" : "var(--ink)"}>{t.stages[i][0]}</text>
        <text x={s.x + s.w / 2} y={stageY + 47} text-anchor="middle" font-size="10" fill={i === 2 ? "var(--card)" : "var(--muted)"}>{t.stages[i][1]}</text>
      </g>
    ))}
    {stageArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={a.y} x2={a.x2 - 8} y2={a.y} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${a.x2 - 8},${a.y - 5} ${a.x2 - 8},${a.y + 5} ${a.x2},${a.y}`} fill="var(--accent)" />
      </g>
    ))}

    <text x="40" y="163" font-size="11" fill="var(--muted)">{t.tagPrice}</text>
    <rect x="40" y={warmY} width="290" height={warmH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="185" y={warmY + 21} text-anchor="middle" font-size="12" fill="var(--ink)">{t.warmup[0]}</text>
    <text x="185" y={warmY + 40} text-anchor="middle" font-size="11" fill="var(--muted)">{t.warmup[1]}</text>
    <line x1="330" y1="195" x2="362" y2="195" stroke="var(--accent)" stroke-width="2" />
    <polygon points="362,190 362,200 370,195" fill="var(--accent)" />
    <rect x="370" y={warmY} width="390" height={warmH} fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="565" y={warmY + 21} text-anchor="middle" font-size="12" fill="var(--card)">{t.peak[0]}</text>
    <text x="565" y={warmY + 40} text-anchor="middle" font-size="11" fill="var(--card)">{t.peak[1]}</text>

    <text x="60" y="238" font-size="11" fill="var(--muted)">{t.tagBytecode}</text>
    {bcBoxes.map((b, i) => (
      <g>
        <rect x={b.x} y={bcY} width={b.w} height={bcH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={b.x + b.w / 2} y={bcY + 23} text-anchor="middle" font-size="12" fill="var(--ink)">{t.bc[i][0]}</text>
        <text x={b.x + b.w / 2} y={bcY + 42} text-anchor="middle" font-size="10" fill="var(--muted)">{t.bc[i][1]}</text>
      </g>
    ))}
    {bcArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={a.y} x2={a.x2 - 8} y2={a.y} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${a.x2 - 8},${a.y - 5} ${a.x2 - 8},${a.y + 5} ${a.x2},${a.y}`} fill="var(--accent)" />
      </g>
    ))}

    <text x="400" y="330" text-anchor="middle" font-size="11" fill="var(--ink)">{t.foot1}</text>
    <text x="400" y="358" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
