---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four assembly lines produce exactly four machine instructions",
    headline: "ONE LINE = ONE INSTRUCTION",
    sub: "no folding · no expansion · just readable names for bits",
    colSource: "assembly source",
    colBinary: "machine code",
    note: "four lines in → four instructions out · 8 bytes total",
    caption:
      "One-to-one: LOAD R0, 200 / LOAD R1, 201 / ADD R0, R1 / STORE 202, R0 become four 2-byte machine instructions. Four assembly lines produced four machine instructions — 8 bytes written to the output file.",
  },
  ru: {
    svgTitle: "Четыре строки ассемблера дают ровно четыре машинные инструкции",
    headline: "ОДНА СТРОКА = ОДНА ИНСТРУКЦИЯ",
    sub: "без свёртки · без раскрытия · просто имена вместо битов",
    colSource: "исходник",
    colBinary: "машинный код",
    note: "четыре строки → четыре инструкции · всего 8 байтов",
    caption:
      "Один к одному: LOAD R0, 200 / LOAD R1, 201 / ADD R0, R1 / STORE 202, R0 становятся четырьмя 2-байтовыми машинными инструкциями. Четыре строки ассемблера породили четыре машинные инструкции — 8 байтов в выходном файле.",
  },
};

const t = dict[lang];

const source = ["LOAD R0, 200", "LOAD R1, 201", "ADD R0, R1", "STORE 202, R0"];
const binary = [
  "00000000 11001000",
  "00100000 11001001",
  "10000000 00000000",
  "01000000 11001010",
];

const rows = source.map((s, i) => ({
  s,
  b: binary[i],
  n: String(i + 1),
  y: 96 + i * 64,
}));

const ARROW_Y = 16;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>
    <text x="170" y="86" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colSource}</text>
    <text x="545" y="86" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colBinary}</text>
    {rows.map((r) => (
      <g>
        <text x="36" y={r.y + 31} text-anchor="middle" font-size="13" fill="var(--muted)">{r.n}</text>
        <rect x="60" y={r.y} width="220" height="48" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="170" y={r.y + 30} text-anchor="middle" font-size="14" fill="var(--ink)">{r.s}</text>
        <line x1="280" y1={r.y + 24} x2="317" y2={r.y + 24} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`313,${r.y + ARROW_Y + 2} 313,${r.y + ARROW_Y + 14} 325,${r.y + ARROW_Y + 8}`} fill="var(--accent)" />
        <rect x="325" y={r.y} width="415" height="48" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="532" y={r.y + 30} text-anchor="middle" font-size="14" fill="var(--ink)">{r.b}</text>
      </g>
    ))}
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
