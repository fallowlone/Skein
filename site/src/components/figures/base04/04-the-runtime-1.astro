---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Your code on top of the runtime: four services between code and OS",
    headline: "YOUR CODE SITS ON TOP OF THE RUNTIME",
    sub: "CPU: raw execution · OS: processes, files, hardware",
    yourCode: "your code",
    delegates: "delegates silently",
    runtime: "runtime",
    services: ["memory management + GC", "call-stack machinery", "standard library", "interpreter or VM"],
    osTitle: "OS",
    osDesc: "processes · files · hardware",
    cpuTitle: "CPU",
    cpuDesc: "fetch · decode · execute",
    note: "even C has a runtime — thinner, but always there",
    caption:
      "Your code sits on top of the runtime, which sits between the language and the OS: memory management with the garbage collector, call-stack machinery, the standard library, and the interpreter or VM. The CPU provides raw execution; the OS provides processes, files, and hardware. Even C has a runtime — thinner, but always there.",
  },
  ru: {
    svgTitle: "Твой код поверх среды выполнения: четыре сервиса между кодом и ОС",
    headline: "ТВОЙ КОД СТОИТ ПОВЕРХ СРЕДЫ ВЫПОЛНЕНИЯ",
    sub: "CPU: сырое выполнение · ОС: процессы, файлы, железо",
    yourCode: "твой код",
    delegates: "делегирует молча",
    runtime: "среда выполнения",
    services: ["управление памятью + GC", "механизм стека вызовов", "стандартная библиотека", "интерпретатор или виртуальная машина"],
    osTitle: "ОС",
    osDesc: "процессы · файлы · железо",
    cpuTitle: "CPU",
    cpuDesc: "выборка · декодирование · исполнение",
    note: "в C среда выполнения тоньше, но она всегда присутствует",
    caption:
      "Твой код стоит поверх среды выполнения, которая располагается между языком и ОС: управление памятью со сборщиком мусора, механизм стека вызовов, стандартная библиотека и интерпретатор или виртуальная машина. CPU обеспечивает сырое выполнение; ОС — процессы, файлы и доступ к железу. В C среда выполнения тоньше, но она всегда присутствует.",
  },
};

const t = dict[lang];

const rows = t.services.map((label, i) => ({ label, y: 160 + i * 42 }));
const dividers = [174, 216, 258];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="170" y="72" width="460" height="44" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="100" text-anchor="middle" font-size="15" fill="var(--card)">{t.yourCode}</text>

    <line x1="400" y1="116" x2="400" y2="132" stroke="var(--accent)" stroke-width="2" />
    <polygon points="400,132 394,122 406,122" fill="var(--accent)" />
    <text x="412" y="129" font-size="12" fill="var(--ink)">{t.delegates}</text>

    <text x="158" y="220" text-anchor="end" font-size="13" fill="var(--ink)">{t.runtime}</text>
    <rect x="170" y="132" width="460" height="168" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    {dividers.map((y) => (
      <line x1="170" y1={y} x2="630" y2={y} stroke="var(--ink)" stroke-width="1" />
    ))}
    {rows.map((r) => (
      <text x="400" y={r.y} text-anchor="middle" font-size="14" fill="var(--ink)">{r.label}</text>
    ))}

    <rect x="140" y="308" width="255" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="267" y="330" text-anchor="middle" font-size="13" fill="var(--ink)">{t.osTitle}</text>
    <text x="267" y="349" text-anchor="middle" font-size="10" fill="var(--muted)">{t.osDesc}</text>

    <rect x="405" y="308" width="255" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="532" y="330" text-anchor="middle" font-size="13" fill="var(--ink)">{t.cpuTitle}</text>
    <text x="532" y="349" text-anchor="middle" font-size="10" fill="var(--muted)">{t.cpuDesc}</text>

    <text x="400" y="390" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
