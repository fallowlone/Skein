---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Ladder of language levels from machine code to high-level language",
    headline: "THE LANGUAGE LADDER",
    sub: "higher = further from CPU operations, closer to human thought",
    lvlHigh: "HIGH-LEVEL LANGUAGE",
    lvlHighSub: "one statement stands for many instructions · portable",
    lvlMid: "ASSEMBLY LANGUAGE",
    lvlMidSub: "one mnemonic per instruction · still CPU-specific",
    lvlLow: "MACHINE CODE",
    lvlLowSub: "raw bit patterns · the CPU executes directly",
    tagHigh: "high",
    tagLow: "low",
    note: "abstraction: hide the mechanism, expose the concept",
    caption:
      "Machine code is raw bit patterns the CPU executes directly, with no readability. Assembly gives one mnemonic per machine instruction but stays CPU-specific. A high-level language lets one statement stand for many machine instructions, is portable across CPUs, and is designed around human concepts.",
  },
  ru: {
    svgTitle: "Лестница уровней языков от машинного кода до языка высокого уровня",
    headline: "ЛЕСТНИЦА ЯЗЫКОВ",
    sub: "выше = дальше от операций CPU, ближе к мышлению человека",
    lvlHigh: "ЯЗЫК ВЫСОКОГО УРОВНЯ",
    lvlHighSub: "один оператор — многие инструкции · переносим",
    lvlMid: "ЯЗЫК АССЕМБЛЕРА",
    lvlMidSub: "одна мнемоника на инструкцию · зависит от CPU",
    lvlLow: "МАШИННЫЙ КОД",
    lvlLowSub: "сырые битовые паттерны · CPU исполняет напрямую",
    tagHigh: "высокий",
    tagLow: "низкий",
    note: "абстракция: скрой механизм, обнажи концепцию",
    caption:
      "Машинный код — это сырые битовые паттерны, которые CPU исполняет напрямую, без читаемости. Ассемблер даёт одну мнемонику на машинную инструкцию, но остаётся зависимым от CPU. Язык высокого уровня позволяет одному оператору соответствовать многим машинным инструкциям, переносим между CPU и построен вокруг человеческих концепций.",
  },
};

const t = dict[lang];

const BOX_X = 170;
const BOX_W = 460;
const BOX_H = 78;
const MID_X = 400;

const levels = [
  { name: t.lvlHigh, detail: t.lvlHighSub, y: 92, hot: true },
  { name: t.lvlMid, detail: t.lvlMidSub, y: 196, hot: false },
  { name: t.lvlLow, detail: t.lvlLowSub, y: 300, hot: false },
];

const lifts = [170, 274];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {levels.map((l) => (
      <g>
        <rect x={BOX_X} y={l.y} width={BOX_W} height={BOX_H} fill={l.hot ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={MID_X} y={l.y + 33} text-anchor="middle" font-family="var(--font-display)" font-size="19" fill={l.hot ? "var(--card)" : "var(--ink)"}>{l.name}</text>
        <text x={MID_X} y={l.y + 59} text-anchor="middle" font-size="12.5" fill={l.hot ? "var(--card)" : "var(--muted)"}>{l.detail}</text>
      </g>
    ))}

    {lifts.map((tipY) => (
      <g>
        <line x1={MID_X} y1={tipY + 26} x2={MID_X} y2={tipY + 2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${MID_X},${tipY} ${MID_X - 7},${tipY + 10} ${MID_X + 7},${tipY + 10}`} fill="var(--accent)" />
      </g>
    ))}

    <text x="648" y="134" font-size="12" fill="var(--muted)">{t.tagHigh}</text>
    <text x="648" y="342" font-size="12" fill="var(--muted)">{t.tagLow}</text>

    <text x="400" y="405" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
