---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The linker combines object files and resolves printf from libc",
    headline: "LINK: MANY FILES, ONE PROGRAM",
    sub: "the linker resolves external symbols into one executable",
    objDetail1: "calls printf",
    objDetail2: "printf unresolved",
    libDetail1: "printf defined here",
    libDetail2: "libc.so on disk",
    exeDetail1: "call site patched",
    exeDetail2: "single executable",
    note: "dynamic linking is more common: printf stays in libc.so",
    caption:
      "The linker combines object files into one executable and resolves external symbols: add.o calls printf but does not define it, so the linker finds printf in libc and patches the call site. In a dynamic build printf stays in libc.so on disk and the OS loads it at run time.",
  },
  ru: {
    svgTitle: "Компоновщик объединяет объектные файлы и берёт printf из libc",
    headline: "КОМПОНОВКА: МНОГО ФАЙЛОВ — ОДНА ПРОГРАММА",
    sub: "компоновщик разрешает внешние символы в один исполняемый файл",
    objDetail1: "вызывает printf",
    objDetail2: "printf неразрешён",
    libDetail1: "printf определён здесь",
    libDetail2: "libc.so на диске",
    exeDetail1: "адрес вызова пропатчен",
    exeDetail2: "единый исполняемый файл",
    note: "динамическая компоновка шире: printf живёт в libc.so",
    caption:
      "Компоновщик объединяет объектные файлы в один исполняемый файл и разрешает внешние символы: add.o вызывает printf, но не определяет его, поэтому компоновщик находит printf в libc и патчит место вызова. При динамической компоновке printf остаётся в libc.so на диске, и ОС загружает её во время выполнения.",
  },
};

const t = dict[lang];

const objName = "add.o";
const libName = "libc";
const exeName = "add";
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="132" width="220" height="78" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="170" y="160" text-anchor="middle" font-size="16" fill="var(--ink)">{objName}</text>
    <text x="170" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.objDetail1}</text>
    <text x="170" y="200" text-anchor="middle" font-size="12" fill="var(--accent)">{t.objDetail2}</text>

    <rect x="60" y="246" width="220" height="78" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="170" y="274" text-anchor="middle" font-size="16" fill="var(--ink)">{libName}</text>
    <text x="170" y="296" text-anchor="middle" font-size="12" fill="var(--muted)">{t.libDetail1}</text>
    <text x="170" y="314" text-anchor="middle" font-size="12" fill="var(--muted)">{t.libDetail2}</text>

    <rect x="480" y="182" width="240" height="104" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="600" y="210" text-anchor="middle" font-size="16" fill="var(--ink)">{exeName}</text>
    <text x="600" y="236" text-anchor="middle" font-size="12" fill="var(--muted)">{t.exeDetail1}</text>
    <text x="600" y="258" text-anchor="middle" font-size="12" fill="var(--muted)">{t.exeDetail2}</text>

    <line x1="280" y1="171" x2="471" y2="208" stroke="var(--accent)" stroke-width="2" />
    <polygon points="480,210 470,213 472,204" fill="var(--accent)" />
    <line x1="280" y1="285" x2="471" y2="259" stroke="var(--accent)" stroke-width="2" />
    <polygon points="480,258 472,264 471,255" fill="var(--accent)" />

    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
