---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Call stack: each call pushes a frame with locals and a return address; return pops it",
    headline: "EACH CALL PUSHES A FRAME — RETURN POPS IT",
    sub: "frame = locals + return address + housekeeping",
    stackLabel: "call stack",
    frameBody: "locals + return address",
    push: "call: push frame",
    pop: "return: pop frame",
    resume: "resume after return",
    top: "top",
    retAddr: "the return address says where to resume after return",
    note: "infinite recursion fills the stack → stack overflow",
    caption:
      "Each function call pushes a stack frame holding local variables, the return address, and housekeeping data; when the function returns, its frame is popped. The return address tells the CPU where to resume execution after the return. Infinite recursion pushes frames without limit until the stack runs out of memory — a stack overflow.",
  },
  ru: {
    svgTitle: "Стек вызовов: каждый вызов кладёт кадр с переменными и адресом возврата; возврат снимает его",
    headline: "ВЫЗОВ КЛАДЁТ КАДР НА СТЕК — ВОЗВРАТ СНИМАЕТ ЕГО",
    sub: "кадр = локальные переменные + адрес возврата + служебные данные",
    stackLabel: "стек вызовов",
    frameBody: "переменные + адрес возврата",
    push: "вызов: поместить кадр",
    pop: "возврат: снять кадр",
    resume: "продолжить после возврата",
    top: "верх",
    retAddr: "адрес возврата: куда продолжить после возврата функции",
    note: "бесконечная рекурсия → переполнение стека (stack overflow)",
    caption:
      "Каждый вызов функции помещает на стек вызовов кадр с локальными переменными, адресом возврата и служебными данными; когда функция возвращает управление, её кадр снимается со стека. Адрес возврата сообщает CPU, куда возобновить выполнение после возврата. Бесконечная рекурсия кладёт кадры без ограничения, пока стек не исчерпает память — переполнение стека (stack overflow).",
  },
};

const t = dict[lang];

const frames = [
  { name: "g", y: 140 },
  { name: "f", y: 196 },
  { name: "main", y: 252 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="328" y="124" text-anchor="end" font-size="12" fill="var(--ink)">{t.push}</text>
    <line x1="340" y1="100" x2="340" y2="140" stroke="var(--accent)" stroke-width="2" />
    <polygon points="340,140 334,130 346,130" fill="var(--accent)" />

    <rect x="425" y="64" width="185" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="517" y="84" text-anchor="middle" font-size="11" fill="var(--ink)">{t.resume}</text>
    <line x1="515" y1="140" x2="515" y2="94" stroke="var(--accent)" stroke-width="2" />
    <polygon points="515,94 509,104 521,104" fill="var(--accent)" />
    <text x="527" y="122" font-size="12" fill="var(--ink)">{t.pop}</text>

    <text x="278" y="230" text-anchor="end" font-size="13" fill="var(--ink)">{t.stackLabel}</text>
    <text x="522" y="172" font-size="12" fill="var(--muted)">{t.top}</text>
    {frames.map((f) => (
      <g>
        <rect x="290" y={f.y} width="220" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="400" y={f.y + 24} text-anchor="middle" font-size="14" fill="var(--ink)">{f.name}</text>
        <text x="400" y={f.y + 44} text-anchor="middle" font-size="11" fill="var(--muted)">{t.frameBody}</text>
      </g>
    ))}

    <text x="400" y="346" text-anchor="middle" font-size="13" fill="var(--muted)">{t.retAddr}</text>
    <text x="400" y="378" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
