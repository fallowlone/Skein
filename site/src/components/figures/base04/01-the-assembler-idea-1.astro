---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Six mnemonics as human-readable names for opcode bit patterns",
    headline: "MNEMONIC: A NAME FOR A NUMBER",
    sub: "write text · the assembler looks it up · bits go to the CPU",
    lookupNote: "lookup in the table: mnemonic text becomes opcode bits",
    caption:
      "Each opcode has a mnemonic that suggests what it does: LOAD, STORE, ADD, SUB, JUMP, HALT. You write the text; the assembler replaces it with the exact opcode bit pattern the CPU needs — for example LOAD becomes 00 on the toy CPU.",
  },
  ru: {
    svgTitle: "Шесть мнемоник как человекочитаемые имена битовых паттернов опкодов",
    headline: "МНЕМОНИКА: ИМЯ ДЛЯ ЧИСЛА",
    sub: "пишешь текст · ассемблер ищет в таблице · биты идут в CPU",
    lookupNote: "поиск в таблице: текст мнемоники становится битами опкода",
    caption:
      "У каждого опкода есть мнемоника, говорящая о его действии: LOAD, STORE, ADD, SUB, JUMP, HALT. Ты пишешь текст; ассемблер заменяет его точным битовым паттерном опкода, нужным CPU, — например, LOAD становится 00 на игрушечном CPU.",
  },
};

const t = dict[lang];

const mnemonics = ["LOAD", "STORE", "ADD", "SUB", "JUMP", "HALT"];

const meanings: Record<"en" | "ru", string[]> = {
  en: [
    "read memory into a register",
    "write a register into memory",
    "add two register values",
    "subtract register values",
    "set the program counter",
    "stop the CPU",
  ],
  ru: [
    "читает память в регистр",
    "пишет регистр в память",
    "складывает два регистра",
    "вычитает регистры",
    "ставит счётчик команд",
    "останавливает CPU",
  ],
};

const rows = mnemonics.map((m, i) => ({
  m,
  meaning: meanings[lang][i],
  y: 84 + i * 42,
}));

const LOAD_OPCODE = "00";
const lookupLeft = `LOAD → ${LOAD_OPCODE}`;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>
    {rows.map((r) => (
      <g>
        <rect x="60" y={r.y} width="110" height="32" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="115" y={r.y + 21} text-anchor="middle" font-size="15" fill="var(--ink)">{r.m}</text>
        <line x1="170" y1={r.y + 16} x2="197" y2={r.y + 16} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`193,${r.y + 10} 193,${r.y + 22} 205,${r.y + 16}`} fill="var(--accent)" />
        <rect x="205" y={r.y} width="535" height="32" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="221" y={r.y + 21} font-size="13" fill="var(--muted)">{r.meaning}</text>
      </g>
    ))}
    <rect x="60" y="346" width="680" height="44" fill="var(--accent)" />
    <text x="400" y="373" text-anchor="middle" font-size="15" fill="var(--card)">{`${lookupLeft} · ${t.lookupNote}`}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
