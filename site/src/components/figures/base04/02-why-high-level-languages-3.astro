---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One source file translated for x86-64 and ARM by separate translators",
    headline: "PORTABILITY: ONE SOURCE, MANY CPUs",
    sub: "the programmer never changes the source",
    cpuA: "translator for x86-64",
    cpuB: "translator for ARM",
    outA: "x86-64 machine instructions",
    outB: "ARM machine instructions",
    note: "each translator is written once, by language implementors",
    caption:
      "The same source — area = 3.14159 * radius * radius — is translated by different translators: one emits x86-64 machine instructions, another ARM machine instructions, and the programmer never changes the source. Portability requires a translation layer written separately for each target CPU, done once by language implementors and shared by all users.",
  },
  ru: {
    svgTitle: "Один исходный файл, транслированный для x86-64 и ARM отдельными трансляторами",
    headline: "ПЕРЕНОСИМОСТЬ: ОДИН ИСХОДНЫЙ ФАЙЛ — МНОГИЕ CPU",
    sub: "программист не меняет исходный код",
    cpuA: "транслятор для x86-64",
    cpuB: "транслятор для ARM",
    outA: "машинные инструкции x86-64",
    outB: "машинные инструкции ARM",
    note: "каждый транслятор пишется один раз разработчиками языка",
    caption:
      "Один и тот же источник — area = 3.14159 * radius * radius — транслируется разными трансляторами: один выдаёт машинные инструкции x86-64, другой — инструкции ARM, а программист не меняет исходный код. Переносимость требует слоя трансляции, написанного отдельно для каждого целевого CPU, — один раз разработчиками языка для всех пользователей.",
  },
};

const t = dict[lang];

const AREA = "area = 3.14159 * radius * radius";

const SRC_X = 200;
const SRC_W = 400;
const SRC_Y = 76;
const SRC_H = 60;
const TR_Y = 196;
const TR_H = 70;
const OUT_Y = 316;
const OUT_H = 56;

const cols = [
  { x: 80, mid: 220, tr: t.cpuA, out: t.outA },
  { x: 440, mid: 580, tr: t.cpuB, out: t.outB },
];

const drops = [
  { from: SRC_Y + SRC_H, to: TR_Y },
  { from: TR_Y + TR_H, to: OUT_Y },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="30" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="54" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x={SRC_X} y={SRC_Y} width={SRC_W} height={SRC_H} fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x={SRC_X + SRC_W / 2} y={SRC_Y + 37} text-anchor="middle" font-size="13" fill="var(--card)">{AREA}</text>

    {cols.map((c) => (
      <g>
        <rect x={c.x} y={TR_Y} width="280" height={TR_H} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={c.mid} y={TR_Y + 42} text-anchor="middle" font-size="13" fill="var(--ink)">{c.tr}</text>
        <rect x={c.x} y={OUT_Y} width="280" height={OUT_H} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={c.mid} y={OUT_Y + 35} text-anchor="middle" font-size="13" fill="var(--ink)">{c.out}</text>
      </g>
    ))}

    {cols.map((c) => (
      <g>
        {drops.map((d) => (
          <g>
            <line x1={c.mid} y1={d.from} x2={c.mid} y2={d.to - 10} stroke="var(--accent)" stroke-width="2" />
            <polygon points={`${c.mid},${d.to} ${c.mid - 7},${d.to - 10} ${c.mid + 7},${d.to - 10}`} fill="var(--accent)" />
          </g>
        ))}
      </g>
    ))}

    <text x="400" y="400" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
