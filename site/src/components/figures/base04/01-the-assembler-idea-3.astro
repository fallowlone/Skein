---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Label loop_start resolved to address 84 through the symbol table",
    headline: "LABELS: NAMES FOR ADDRESSES",
    sub: "write the name · the assembler counts the address for you",
    colWrite: "you write",
    colTable: "symbol table",
    colResult: "assembler writes",
    tableName: "name",
    tableAddr: "address",
    note: "you never count addresses by hand",
    caption:
      "Instead of JUMP 84 you write JUMP loop_start. The assembler records every label's address in a symbol table — loop_start is at 84 — and replaces the reference with the numeric address.",
  },
  ru: {
    svgTitle: "Метка loop_start разрешается в адрес 84 через таблицу символов",
    headline: "МЕТКИ: ИМЕНА ДЛЯ АДРЕСОВ",
    sub: "пишешь имя · адрес считает ассемблер",
    colWrite: "ты пишешь",
    colTable: "таблица символов",
    colResult: "ассемблер пишет",
    tableName: "имя",
    tableAddr: "адрес",
    note: "считать адреса вручную не нужно",
    caption:
      "Вместо JUMP 84 ты пишешь JUMP loop_start. Ассемблер записывает адрес каждой метки в таблицу символов — loop_start находится по адресу 84 — и заменяет ссылку числовым адресом.",
  },
};

const t = dict[lang];

const LABEL = "loop_start";
const ADDR = "84";
const sourceLine = `JUMP ${LABEL}`;
const resultLine = `JUMP ${ADDR}`;

const stages = [
  { x: 40, w: 200 },
  { x: 290, w: 220 },
  { x: 560, w: 200 },
];

const headers = [t.colWrite, t.colTable, t.colResult];
const heads = stages.map((s, i) => ({ x: s.x + s.w / 2, label: headers[i] }));

const arrows = [
  { x1: 240, x2: 282, tip: 290 },
  { x1: 510, x2: 552, tip: 560 },
];
const arrowShapes = arrows.map((a) => ({
  line: { x1: a.x1, x2: a.x2 },
  points: `${a.x2 - 4},193 ${a.x2 - 4},205 ${a.tip},199`,
}));
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>
    {heads.map((h) => (
      <text x={h.x} y="108" text-anchor="middle" font-size="12" fill="var(--muted)">{h.label}</text>
    ))}
    <rect x="40" y="124" width="200" height="150" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="140" y="206" text-anchor="middle" font-size="15" fill="var(--ink)">{sourceLine}</text>
    <rect x="290" y="124" width="220" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{`${t.tableName} → ${t.tableAddr}`}</text>
    <line x1="290" y1="170" x2="510" y2="170" stroke="var(--accent)" stroke-width="1" />
    <text x="400" y="222" text-anchor="middle" font-size="15" fill="var(--ink)">{`${LABEL} → ${ADDR}`}</text>
    <rect x="560" y="124" width="200" height="150" fill="var(--accent)" />
    <text x="660" y="206" text-anchor="middle" font-size="15" fill="var(--card)">{resultLine}</text>
    {arrowShapes.map((a) => (
      <g>
        <line x1={a.line.x1} y1="199" x2={a.line.x2} y2="199" stroke="var(--accent)" stroke-width="2" />
        <polygon points={a.points} fill="var(--accent)" />
      </g>
    ))}
    <rect x="40" y="300" width="720" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="336" text-anchor="middle" font-size="14" fill="var(--ink)">{`${sourceLine}  →  ${resultLine}`}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
