---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "UDP datagrams above the path MTU of about 1,500 bytes are IP-fragmented: 1.2 KB is 1 fragment, 4 KB is 3, 8 KB is 6, 16 KB is 11 — if any one fragment is lost the whole datagram is discarded",
    headline: "THE MTU CLIFF: SIZE COMPOUNDS LOSS",
    sub: "above ~1,500 B every fragment must survive",
    bar1size: "1.2 KB",
    bar1frag: "1 fragment",
    bar1note: "atomic",
    bar2size: "4 KB",
    bar2frag: "3 fragments",
    bar3size: "8 KB",
    bar3frag: "6 fragments",
    bar4size: "16 KB",
    bar4frag: "11 fragments",
    dangerNote: "all must arrive",
    foot1: "path MTU ~1,500 B Ethernet, ~1,400 after tunnels/VPN",
    foot2: "safe target: payload under ~1,200 B — or fragment in app / use TCP",
    caption:
      "Above the path MTU, each datagram becomes N fragments that ALL must arrive — so effective loss compounds with size. Staying under ~1,200 B keeps every datagram a single atomic packet.",
  },
  ru: {
    svgTitle: "UDP-датаграммы больше path MTU около 1500 байт IP-фрагментируются: 1.2 КБ — 1 фрагмент, 4 КБ — 3, 8 КБ — 6, 16 КБ — 11; если потерян хоть один фрагмент, вся датаграмма отбрасывается",
    headline: "ОБРЫВ НА MTU: РАЗМЕР УСИЛИВАЕТ ПОТЕРЮ",
    sub: "выше ~1500 Б каждый фрагмент должен дойти",
    bar1size: "1,2 КБ",
    bar1frag: "1 фрагмент",
    bar1note: "атомарно",
    bar2size: "4 КБ",
    bar2frag: "3 фрагмента",
    bar3size: "8 КБ",
    bar3frag: "6 фрагментов",
    bar4size: "16 КБ",
    bar4frag: "11 фрагментов",
    dangerNote: "все должны дойти",
    foot1: "path MTU ~1500 Б Ethernet, ~1400 после туннелей/VPN",
    foot2: "цель: payload под ~1200 Б — или фрагментируй сам / TCP",
    caption:
      "Выше path MTU каждая датаграмма становится N фрагментами, что ВСЕ должны дойти — поэтому эффективная потеря растёт с размером. Под ~1200 Б каждая датаграмма — один атомарный пакет.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar1frag}</text>
    <rect x="155" y="162" width="90" height="140" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="232" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar1note}</text>
    <text x="200" y="326" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar1size}</text>

    <text x="350" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar2frag}</text>
    <rect x="305" y="162" width="90" height="140" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="350" y="326" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar2size}</text>

    <text x="500" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar3frag}</text>
    <rect x="455" y="140" width="90" height="162" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="500" y="326" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar3size}</text>

    <text x="650" y="84" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar4frag}</text>
    <rect x="605" y="96" width="90" height="206" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="650" y="326" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bar4size}</text>

    <text x="400" y="348" text-anchor="middle" font-size="11" fill="var(--muted)">{t.dangerNote}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="396" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
