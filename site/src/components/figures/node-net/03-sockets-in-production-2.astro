---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Half-open connection handling in English and Russian: a silent socket holds its file descriptor until setTimeout fires and destroy reclaims it",
    headline: "HALF-OPEN SOCKETS HOLD THE FD",
    sub: "timeout notifies — only destroy() reclaims",
    s1t: "connect",
    s1s: "socket accepted",
    s2t: "goes silent",
    s2s: "FIN never arrives",
    s3t: "'timeout' fires",
    s3s: "setTimeout(30_000)",
    s4t: "destroy()",
    s4s: "fd reclaimed",
    warn: "no timeout = fd pinned forever",
    note: "timeout notifies — it never closes the socket",
    caption:
      "A half-open client connects and goes silent with no FIN, pinning a file descriptor forever when there is no timeout. socket.setTimeout fires a timeout event after 30 seconds of no reads or writes, and only an explicit destroy in the handler reclaims the descriptor.",
  },
  ru: {
    svgTitle: "Обработка half-open соединений: молчащий сокет держит файловый дескриптор, пока setTimeout не сработает и destroy его не вернёт",
    headline: "HALF-OPEN ДЕРЖИТ FD",
    sub: "таймаут уведомляет — возвращает лишь destroy()",
    s1t: "коннект",
    s1s: "сокет принят",
    s2t: "замолчал",
    s2s: "FIN не пришёл",
    s3t: "'timeout' сработал",
    s3s: "setTimeout(30_000)",
    s4t: "destroy()",
    s4s: "fd возвращён",
    warn: "без таймаута = fd занят вечно",
    note: "событие 'timeout' само сокет не закрывает",
    caption:
      "Half-open клиент подключается и молчит без FIN, держа файловый дескриптор вечно, если таймаута нет. socket.setTimeout эмитит событие timeout после 30 секунд без чтений и записей, и лишь явный destroy в обработчике возвращает дескриптор.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="110" width="155" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="117" y="138" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s1t}</text>
    <text x="117" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.s1s}</text>

    <rect x="235" y="110" width="155" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="312" y="138" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s2t}</text>
    <text x="312" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.s2s}</text>

    <rect x="430" y="110" width="165" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="512" y="138" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s3t}</text>
    <text x="512" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.s3s}</text>

    <rect x="635" y="110" width="125" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="697" y="138" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s4t}</text>
    <text x="697" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.s4s}</text>

    <text x="200" y="210" text-anchor="middle" font-size="11" fill="var(--muted)">→</text>
    <text x="410" y="210" text-anchor="middle" font-size="11" fill="var(--muted)">→</text>
    <text x="615" y="210" text-anchor="middle" font-size="11" fill="var(--muted)">→</text>

    <rect x="40" y="240" width="350" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="215" y="275" text-anchor="middle" font-size="12" fill="var(--ink)">{t.warn}</text>

    <rect x="430" y="240" width="330" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="275" text-anchor="middle" font-size="11" fill="var(--ink)">{t.note}</text>

    <text x="160" y="345" text-anchor="end" font-size="11" fill="var(--muted)">lsof -p</text>
    <rect x="180" y="318" width="440" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--ink)">65 535</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
