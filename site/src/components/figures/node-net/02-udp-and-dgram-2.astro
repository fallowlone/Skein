---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "UDP gives none of TCP's guarantees: best-effort delivery, any order, possible duplicates, preserved boundaries of one send to one message, and no connection",
    headline: "NO DELIVERY, NO ORDER, NO DEDUP — BY DESIGN",
    sub: "UDP gives none of TCP's guarantees — that is the point",
    colProp: "Property",
    colTcp: "TCP (net)",
    colUdp: "UDP (dgram)",
    row1p: "Delivery",
    row1t: "Guaranteed (retransmit)",
    row1u: "Best-effort — may drop",
    row2p: "Ordering",
    row2t: "In-order",
    row2u: "Any order",
    row3p: "Duplicates",
    row3t: "Removed",
    row3u: "Possible",
    row4p: "Boundaries",
    row4t: "Erased (you frame)",
    row4u: "Kept (1 send = 1 message)",
    row5p: "Connection",
    row5t: "Stateful handshake",
    row5u: "Connectionless",
    foot1: "need reliability? sequence numbers, ACKs, retransmit — you build it",
    foot2: "QUIC and reliable-UDP game protocols start from UDP and add back only what they need",
    caption:
      "UDP gives none of TCP's guarantees — no delivery, no order, no dedup — and that is the whole point: no handshake round trip, no head-of-line blocking, no connection state.",
  },
  ru: {
    svgTitle: "UDP не даёт ни одной гарантии TCP: best-effort доставка, любой порядок, возможные дубликаты, сохранённые границы один send — одно message, без соединения",
    headline: "НИ ДОСТАВКИ, НИ ПОРЯДКА, НИ ДЕДУПА — ПО ЗАМЫСЛУ",
    sub: "UDP не даёт ни одной гарантии TCP — в этом смысл",
    colProp: "Свойство",
    colTcp: "TCP (net)",
    colUdp: "UDP (dgram)",
    row1p: "Доставка",
    row1t: "Гарантирована (ретрансмит)",
    row1u: "Best-effort — может теряться",
    row2p: "Порядок",
    row2t: "По порядку",
    row2u: "Любой порядок",
    row3p: "Дубликаты",
    row3t: "Убраны",
    row3u: "Возможны",
    row4p: "Границы",
    row4t: "Стёрты (фреймишь сам)",
    row4u: "Сохранены (1 send = 1 message)",
    row5p: "Соединение",
    row5t: "Stateful рукопожатие",
    row5u: "Бессоединительное",
    foot1: "нужна надёжность? номера, ACK, ретрансмит — строишь сам",
    foot2: "QUIC и надёжные UDP-протоколы игр стартуют с UDP и добавляют лишь нужное",
    caption:
      "UDP не даёт ни одной из гарантий TCP — ни доставки, ни порядка, ни дедупа — и в этом весь смысл: нет круга рукопожатия, нет head-of-line блокировки, нет состояния соединения.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="60" y="104" text-anchor="start" font-size="11" fill="var(--muted)">{t.colProp}</text>
    <text x="300" y="104" text-anchor="start" font-size="11" fill="var(--muted)">{t.colTcp}</text>
    <text x="540" y="104" text-anchor="start" font-size="11" fill="var(--muted)">{t.colUdp}</text>
    <rect x="40" y="116" width="720" height="2" fill="var(--muted)" />

    <text x="60" y="152" text-anchor="start" font-size="12" fill="var(--ink)">{t.row1p}</text>
    <text x="300" y="152" text-anchor="start" font-size="11" fill="var(--ink)">{t.row1t}</text>
    <text x="540" y="152" text-anchor="start" font-size="11" fill="var(--accent)">{t.row1u}</text>

    <text x="60" y="192" text-anchor="start" font-size="12" fill="var(--ink)">{t.row2p}</text>
    <text x="300" y="192" text-anchor="start" font-size="11" fill="var(--ink)">{t.row2t}</text>
    <text x="540" y="192" text-anchor="start" font-size="11" fill="var(--accent)">{t.row2u}</text>

    <text x="60" y="232" text-anchor="start" font-size="12" fill="var(--ink)">{t.row3p}</text>
    <text x="300" y="232" text-anchor="start" font-size="11" fill="var(--ink)">{t.row3t}</text>
    <text x="540" y="232" text-anchor="start" font-size="11" fill="var(--accent)">{t.row3u}</text>

    <text x="60" y="272" text-anchor="start" font-size="12" fill="var(--ink)">{t.row4p}</text>
    <text x="300" y="272" text-anchor="start" font-size="11" fill="var(--ink)">{t.row4t}</text>
    <text x="540" y="272" text-anchor="start" font-size="11" fill="var(--accent)">{t.row4u}</text>

    <text x="60" y="312" text-anchor="start" font-size="12" fill="var(--ink)">{t.row5p}</text>
    <text x="300" y="312" text-anchor="start" font-size="11" fill="var(--ink)">{t.row5t}</text>
    <text x="540" y="312" text-anchor="start" font-size="11" fill="var(--accent)">{t.row5u}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
