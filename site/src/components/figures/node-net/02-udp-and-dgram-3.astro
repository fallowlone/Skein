---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Choose UDP when latency beats reliability — metrics, discovery, games, DNS — using dgram: bind a port, fire-and-forget send, one send is one message, multicast reaches many with one send",
    headline: "WHEN LATENCY BEATS RELIABILITY, PICK UDP",
    sub: "metrics, discovery, games, DNS — reliability on top only if needed",
    leftHead: "UDP WINS",
    win1t: "metrics / StatsD",
    win1s: "latency beats accuracy",
    win2t: "discovery / mDNS",
    win2s: "one send, many receivers",
    win3t: "games / voice",
    win3s: "late is worse than lost",
    win4t: "DNS",
    win4s: "one small Q/A, no handshake",
    rightHead: "DGRAM API",
    api1c: "bind(8125)",
    api1d: "one socket receives from anyone (rinfo)",
    api2c: "send(buf, port, host)",
    api2d: "fire-and-forget: cb is hand-off to OS, not delivery",
    api3c: "1 send() = 1 'message'",
    api3d: "boundaries kept: never partial, never glued",
    api4c: "addMembership(group)",
    api4d: "multicast: 1 send reaches N joined members",
    foot1: "send() callback fires when the datagram reaches the OS — UDP has no delivery",
    foot2: "need more? fragment in app with sequencing, or use TCP",
    caption:
      "Choose UDP when latency and no head-of-line blocking beat reliability — metrics, discovery, games, voice, DNS — and accept that any reliability you need, you build on top.",
  },
  ru: {
    svgTitle: "Выбирай UDP, когда задержка важнее надёжности — метрики, discovery, игры, DNS — через dgram: bind порта, send выстрелил-и-забыл, один send — одно message, multicast достигает многих одним send",
    headline: "ЗАДЕРЖКА ВАЖНЕЕ НАДЁЖНОСТИ — БЕРИ UDP",
    sub: "метрики, discovery, игры, DNS — надёжность поверх, лишь если нужна",
    leftHead: "UDP ВЫИГРЫВАЕТ",
    win1t: "метрики / StatsD",
    win1s: "задержка важнее точности",
    win2t: "discovery / mDNS",
    win2s: "один send — много получателей",
    win3t: "игры / голос",
    win3s: "опоздавший хуже потерянного",
    win4t: "DNS",
    win4s: "один малый запрос — без рукопожатия",
    rightHead: "DGRAM API",
    api1c: "bind(8125)",
    api1d: "один сокет принимает от всех (rinfo)",
    api2c: "send(buf, port, host)",
    api2d: "выстрелил-и-забыл: cb — передача ОС, не доставка",
    api3c: "1 send() = 1 'message'",
    api3d: "границы целы: ни частичных, ни склеенных",
    api4c: "addMembership(group)",
    api4d: "multicast: 1 send достигает N вступивших",
    foot1: "колбэк send() срабатывает на передаче ОС — доставки у UDP нет",
    foot2: "нужно больше? фрагментируй сам с нумерацией или бери TCP",
    caption:
      "Выбирай UDP, когда задержка и отсутствие head-of-line блокировки важнее надёжности — метрики, discovery, игры, голос, DNS — и принимай, что любую нужную надёжность ты строишь поверх.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="40" y="88" text-anchor="start" font-size="11" fill="var(--muted)">{t.leftHead}</text>
    <text x="380" y="88" text-anchor="start" font-size="11" fill="var(--muted)">{t.rightHead}</text>

    <rect x="40" y="100" width="300" height="54" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="190" y="121" text-anchor="middle" font-size="12" fill="var(--ink)">{t.win1t}</text>
    <text x="190" y="143" text-anchor="middle" font-size="11" fill="var(--muted)">{t.win1s}</text>

    <rect x="40" y="164" width="300" height="54" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="190" y="185" text-anchor="middle" font-size="12" fill="var(--ink)">{t.win2t}</text>
    <text x="190" y="207" text-anchor="middle" font-size="11" fill="var(--muted)">{t.win2s}</text>

    <rect x="40" y="228" width="300" height="54" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="190" y="249" text-anchor="middle" font-size="12" fill="var(--ink)">{t.win3t}</text>
    <text x="190" y="271" text-anchor="middle" font-size="11" fill="var(--muted)">{t.win3s}</text>

    <rect x="40" y="292" width="300" height="54" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="190" y="313" text-anchor="middle" font-size="12" fill="var(--ink)">{t.win4t}</text>
    <text x="190" y="335" text-anchor="middle" font-size="11" fill="var(--muted)">{t.win4s}</text>

    <text x="380" y="121" text-anchor="start" font-size="12" fill="var(--ink)">{t.api1c}</text>
    <text x="380" y="143" text-anchor="start" font-size="11" fill="var(--muted)">{t.api1d}</text>

    <text x="380" y="185" text-anchor="start" font-size="12" fill="var(--ink)">{t.api2c}</text>
    <text x="380" y="207" text-anchor="start" font-size="11" fill="var(--muted)">{t.api2d}</text>

    <text x="380" y="249" text-anchor="start" font-size="12" fill="var(--ink)">{t.api3c}</text>
    <text x="380" y="271" text-anchor="start" font-size="11" fill="var(--muted)">{t.api3d}</text>

    <text x="380" y="313" text-anchor="start" font-size="12" fill="var(--ink)">{t.api4c}</text>
    <text x="380" y="335" text-anchor="start" font-size="11" fill="var(--muted)">{t.api4d}</text>

    <text x="400" y="374" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="398" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
