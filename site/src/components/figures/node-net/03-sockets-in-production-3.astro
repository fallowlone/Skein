---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Production socket tuning in English and Russian: keep-alive tension, load-balancer timeout ordering, and bound plus drain",
    headline: "TUNE KEEP-ALIVE, ORDER TIMEOUTS, DRAIN",
    sub: "reuse the handshake — never hoard the descriptor",
    k1t: "keepAlive too short",
    k1s: "reuse lost, reconnects",
    k2t: "keepAlive too long",
    k2s: "idle hoards fds",
    wHead: "WRONG: server closes first",
    wSub: "LB sends on closing socket → 502",
    rHead: "RIGHT: server outlasts LB",
    rSub: "LB closes idle socket, clean",
    bound: "maxConnections + ulimit -n: shed load",
    drain: "SIGTERM: server.close() + drain, destroy stragglers",
    caption:
      "Keep-alive reuses the handshake but idle connections still hold descriptors, so tune between lost reuse and hoarded fds. Make the server keepAliveTimeout longer than the load balancer idle timeout so the balancer always closes first, and bound with maxConnections plus drain on SIGTERM.",
  },
  ru: {
    svgTitle: "Продакшн-настройка сокетов: натяжение keep-alive, порядок таймаутов с балансировщиком, лимит и слив",
    headline: "НАСТРОЙ KEEP-ALIVE, СЛИВАЙ ЧИСТО",
    sub: "переиспользуй рукопожатие — не копи дескрипторы",
    k1t: "keepAlive короток",
    k1s: "нет переиспользования",
    k2t: "keepAlive долог",
    k2s: "простой копит fd",
    wHead: "ПЛОХО: сервер закрыл первым",
    wSub: "LB шлёт на закрытие → 502",
    rHead: "ВЕРНО: сервер живёт дольше LB",
    rSub: "LB закрывает idle-сокет, чисто",
    bound: "maxConnections + ulimit -n: сброс нагрузки",
    drain: "SIGTERM: server.close() + слив, destroy отставших",
    caption:
      "Keep-alive переиспользует рукопожатие, но простаивающие соединения держат дескрипторы, поэтому настраивай между потерей переиспользования и коплением fd. Сделай keepAliveTimeout сервера длиннее idle-таймаута балансировщика, чтобы первым закрывал он, и ограничивай через maxConnections плюс слив на SIGTERM.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="350" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="215" y="117" text-anchor="middle" font-size="12" fill="var(--ink)">{t.k1t}</text>
    <text x="215" y="139" text-anchor="middle" font-size="11" fill="var(--muted)">{t.k1s}</text>

    <rect x="410" y="90" width="350" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="585" y="117" text-anchor="middle" font-size="12" fill="var(--ink)">{t.k2t}</text>
    <text x="585" y="139" text-anchor="middle" font-size="11" fill="var(--muted)">{t.k2s}</text>

    <rect x="40" y="184" width="350" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="215" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.wHead}</text>
    <text x="215" y="236" text-anchor="middle" font-size="11" fill="var(--muted)">{t.wSub}</text>

    <rect x="410" y="184" width="350" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="585" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rHead}</text>
    <text x="585" y="236" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rSub}</text>

    <rect x="40" y="282" width="720" height="50" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="312" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bound}</text>

    <rect x="40" y="348" width="720" height="50" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="378" text-anchor="middle" font-size="11" fill="var(--ink)">{t.drain}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
