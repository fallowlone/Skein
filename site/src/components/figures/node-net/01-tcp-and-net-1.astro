---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Same small-write TCP protocol with opposite dials: setNoDelay flushes each write at once for low latency, default Nagle coalesces writes into full packets for throughput at the cost of a 40 ms stall",
    headline: "NAGLE: LATENCY OR THROUGHPUT",
    sub: "same small writes, opposite dials",
    tagFast: "setNoDelay(true)",
    tagBulk: "default Nagle",
    fastLine1: "each write() sent at once",
    fastLine2: "no ~40 ms delayed-ACK stall",
    fastNote1: "low latency: RPC / REPL / game",
    fastNote2: "cost: more, smaller packets",
    bulkLine1: "small writes coalesced",
    bulkLine2: "+ ~40 ms stall per round trip",
    bulkNote1: "bulk throughput wins",
    bulkNote2: "cost: latency on request/response",
    caption:
      "Same small-write protocol, opposite dials: setNoDelay buys latency at the cost of more packets; default Nagle buys throughput at the cost of a ~40 ms per-round-trip stall.",
  },
  ru: {
    svgTitle: "Тот же TCP-протокол с мелкими записями и противоположные ручки: setNoDelay сливает каждую запись сразу ради низкой задержки, дефолтный Nagle коалесцирует записи в целые пакеты ради пропускной цены застревания 40 мс",
    headline: "NAGLE: ЗАДЕРЖКА ИЛИ ПРОПУСКНАЯ",
    sub: "те же мелкие записи, ручки наоборот",
    tagFast: "setNoDelay(true)",
    tagBulk: "Nagle по умолчанию",
    fastLine1: "каждый write() уходит сразу",
    fastLine2: "без застревания ~40 мс на ACK",
    fastNote1: "низкая задержка: RPC / REPL / игра",
    fastNote2: "цена: больше мелких пакетов",
    bulkLine1: "мелкие записи коалесцируют",
    bulkLine2: "+ ~40 мс застревания на круг",
    bulkNote1: "выигрыш пропускной способности",
    bulkNote2: "цена: задержка запрос/ответа",
    caption:
      "Тот же протокол с мелкими записями, противоположные ручки: setNoDelay покупает задержку ценой пакетов; дефолтный Nagle покупает пропускную ценой застревания ~40 мс на круг.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagFast}</text>
    <rect x="170" y="104" width="360" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="350" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fastLine1}</text>
    <text x="350" y="156" text-anchor="middle" font-size="11" fill="var(--ink)">{t.fastLine2}</text>
    <text x="780" y="132" text-anchor="end" font-size="11" fill="var(--ink)">{t.fastNote1}</text>
    <text x="780" y="156" text-anchor="end" font-size="11" fill="var(--muted)">{t.fastNote2}</text>

    <text x="150" y="246" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagBulk}</text>
    <rect x="170" y="214" width="360" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="350" y="242" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bulkLine1}</text>
    <text x="350" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bulkLine2}</text>
    <text x="780" y="242" text-anchor="end" font-size="11" fill="var(--ink)">{t.bulkNote1}</text>
    <text x="780" y="266" text-anchor="end" font-size="11" fill="var(--muted)">{t.bulkNote2}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">setNoDelay(true) — {t.fastLine2}</text>
    <text x="400" y="355" text-anchor="middle" font-size="12" fill="var(--muted)">default Nagle — {t.bulkLine2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
