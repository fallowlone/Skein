---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "socket.write returns a boolean: true means the chunk reached the kernel buffer and you may keep writing, false means stop until drain, and ignoring false grows an unbounded buffer until OOM",
    headline: "WRITE() RETURNS A BOOLEAN",
    sub: "false is backpressure — stop until 'drain'",
    decide1: "socket.write(chunk)",
    decide2: "true or false?",
    trueLine1: "true: chunk in kernel buffer",
    trueLine2: "keep writing",
    falseLine1: "false: above high-water mark",
    falseLine2: "stop writing until 'drain'",
    foot1: "pipeline(source, socket) honors this for you",
    foot2: "ignoring false: unbounded buffer grows until OOM",
    caption:
      "socket.write returns true when the chunk reached the kernel buffer and false when the buffer crossed its high-water mark. Stop on false and resume on drain — or let pipeline manage it — because ignoring false buffers without bound until the process OOMs.",
  },
  ru: {
    svgTitle: "socket.write возвращает булево: true значит, чанк ушёл в буфер ядра и писать можно дальше, false значит стоп до drain, а игнор false растит безграничный буфер до OOM",
    headline: "WRITE() ВОЗВРАЩАЕТ БУЛЕВО",
    sub: "false это backpressure — стоп до 'drain'",
    decide1: "socket.write(chunk)",
    decide2: "true или false?",
    trueLine1: "true: чанк в буфере ядра",
    trueLine2: "писать можно дальше",
    falseLine1: "false: выше high-water mark",
    falseLine2: "стоп записи до 'drain'",
    foot1: "pipeline(source, socket) соблюдает это за тебя",
    foot2: "игнор false: безграничный буфер растёт до OOM",
    caption:
      "socket.write возвращает true, когда чанк ушёл в буфер ядра, и false, когда буфер пересёк high-water mark. Остановись на false и продолжи на drain — или доверь это pipeline, — потому что игнор false буферизует безгранично, пока процесс не упадёт по OOM.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="310" y="100" width="180" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="130" text-anchor="middle" font-size="12" fill="var(--ink)">{t.decide1}</text>
    <text x="400" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.decide2}</text>

    <line x1="350" y1="172" x2="205" y2="228" stroke="var(--muted)" stroke-width="2" />
    <line x1="450" y1="172" x2="595" y2="228" stroke="var(--muted)" stroke-width="2" />
    <text x="255" y="205" text-anchor="middle" font-size="11" fill="var(--muted)">true</text>
    <text x="545" y="205" text-anchor="middle" font-size="11" fill="var(--muted)">false</text>

    <rect x="40" y="228" width="330" height="92" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="264" text-anchor="middle" font-size="12" fill="var(--ink)">{t.trueLine1}</text>
    <text x="205" y="290" text-anchor="middle" font-size="11" fill="var(--ink)">{t.trueLine2}</text>

    <rect x="430" y="228" width="330" height="92" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="595" y="264" text-anchor="middle" font-size="12" fill="var(--ink)">{t.falseLine1}</text>
    <text x="595" y="290" text-anchor="middle" font-size="11" fill="var(--ink)">{t.falseLine2}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="385" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
