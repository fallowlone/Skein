---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "TCP socket lifecycle: data, then end when the peer sends FIN with the writable half still open, then close when both halves are down; an unhandled error crashes the process",
    headline: "SOCKET LIFECYCLE: FOUR EVENTS",
    sub: "wire all of them — error is not optional",
    evData: "'data'",
    evDataSub: "chunks, may be partial",
    evEnd: "'end'",
    evEndSub: "FIN, write half still open",
    evError: "'error'",
    evErrorSub: "ECONNRESET: must handle",
    evClose: "'close'",
    evCloseSub: "all down, fd gone",
    foot1: "unhandled 'error' throws and crashes the process",
    foot2: "'end' is not 'close': after FIN you can still write",
    halfLine: "allowHalfOpen: true — you own end(), or the fd leaks",
    finLine: "FIN closes one direction only",
    caption:
      "A net.Socket moves through data, end, and close — with error possible at any point. Handle error on every socket, and remember end leaves your writable half open while close releases the fd.",
  },
  ru: {
    svgTitle: "Жизненный цикл TCP-сокета: data, затем end, когда пир прислал FIN, а пишущая половина ещё открыта, затем close, когда обе половины закрыты; необработанный error роняет процесс",
    headline: "ЖИЗНЕННЫЙ ЦИКЛ: ЧЕТЫРЕ СОБЫТИЯ",
    sub: "подключи их все — error не опционален",
    evData: "'data'",
    evDataSub: "байты, частичные чанки",
    evEnd: "'end'",
    evEndSub: "FIN пира, запись открыта",
    evError: "'error'",
    evErrorSub: "ECONNRESET — обработай",
    evClose: "'close'",
    evCloseSub: "всё закрыто, fd нет",
    foot1: "необработанный 'error' кидает и роняет процесс",
    foot2: "'end' это не 'close': после FIN писать можно",
    halfLine: "allowHalfOpen: true — end() на тебе, иначе течёт fd",
    finLine: "FIN закрывает одно направление",
    caption:
      "Сокет net проходит через data, end и close — а error возможен в любой точке. Обрабатывай error на каждом сокете и помни: end оставляет пишущую половину открытой, а close освобождает fd.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="120" width="170" height="92" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="105" y="156" text-anchor="middle" font-size="12" fill="var(--ink)">{t.evData}</text>
    <text x="105" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.evDataSub}</text>

    <text x="202" y="172" text-anchor="middle" font-size="14" fill="var(--muted)">→</text>

    <rect x="214" y="120" width="170" height="92" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="299" y="156" text-anchor="middle" font-size="12" fill="var(--ink)">{t.evEnd}</text>
    <text x="299" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.evEndSub}</text>

    <text x="396" y="172" text-anchor="middle" font-size="14" fill="var(--muted)">→</text>

    <rect x="408" y="120" width="170" height="92" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="493" y="156" text-anchor="middle" font-size="12" fill="var(--ink)">{t.evClose}</text>
    <text x="493" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.evCloseSub}</text>

    <rect x="602" y="120" width="170" height="92" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="687" y="156" text-anchor="middle" font-size="12" fill="var(--ink)">{t.evError}</text>
    <text x="687" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.evErrorSub}</text>

    <text x="400" y="262" text-anchor="middle" font-size="12" fill="var(--ink)">{t.foot1}</text>
    <text x="400" y="290" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
    <text x="780" y="345" text-anchor="end" font-size="11" fill="var(--muted)">{t.halfLine}</text>
    <text x="780" y="370" text-anchor="end" font-size="11" fill="var(--muted)">{t.finLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
