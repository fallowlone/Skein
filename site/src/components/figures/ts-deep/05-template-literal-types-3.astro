---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle:
      "Non-greedy inference at the first delimiter: FirstSeg over a-b-c gives Head a and Tail b-c, and deep recursion silently falls back to string past ~50 levels",
    headline: "INFERENCE STOPS AT THE FIRST DELIMITER",
    sub: 'FirstSeg<"a-b-c"> — Head matches as little as possible',
    box1Title: "non-greedy (real)",
    box1Line1: 'Head = "a"',
    box1Line2: 'Tail = "b-c"',
    box1Foot: '["a", "b-c"]',
    box2Title: "greedy (wrong)",
    box2Line1: 'Head = "a-b"',
    box2Line2: 'Tail = "c"',
    box2Foot: "never happens",
    box3Title: "cost side",
    box3Line1: "~50 levels deep",
    box3Line2: "falls back to string",
    box3Foot: "or move to codegen",
    cross: "x",
    check: "ok",
    foot1: "Head stops at the FIRST -, Tail takes the rest — left-to-right parsing works",
    foot2: "String itself is the contract: template; string needs parsing: codegen",
    caption:
      "Pattern inference is non-greedy, so Head stops at the first delimiter and Tail takes the remainder — which is what makes recursive left-to-right parsing work. Past ~50 recursion levels the parser silently falls back to string, so move non-trivial grammars to codegen.",
  },
  ru: {
    svgTitle:
      "Нежадный вывод на первом разделителе: FirstSeg по a-b-c даёт Head a и Tail b-c, а глубокая рекурсия молча откатывается к string за ~50 уровнями",
    headline: "ВЫВОД ОСТАНАВЛИВАЕТСЯ НА ПЕРВОМ РАЗДЕЛИТЕЛЕ",
    sub: 'FirstSeg<"a-b-c"> — Head сопоставляется как можно меньше',
    box1Title: "нежадно (реально)",
    box1Line1: 'Head = "a"',
    box1Line2: 'Tail = "b-c"',
    box1Foot: '["a", "b-c"]',
    box2Title: "жадно (неверно)",
    box2Line1: 'Head = "a-b"',
    box2Line2: 'Tail = "c"',
    box2Foot: "не бывает",
    box3Title: "цена",
    box3Line1: "~50 уровней вглубь",
    box3Line2: "откат к string",
    box3Foot: "или в кодогенерацию",
    cross: "x",
    check: "ok",
    foot1: "Head останавливается на ПЕРВОМ '-', Tail берёт остальное — разбор слева направо работает",
    foot2: "Сама строка — контракт: шаблон; строку нужно разбирать: кодогенерация",
    caption:
      "Вывод образца нежадный, поэтому Head останавливается на первом разделителе, а Tail берёт остаток — именно это и делает рекурсивный разбор слева направо работающим. За ~50 уровнями рекурсии парсер молча откатывается к string, поэтому нетривиальные грамматики переносите в кодогенерацию.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsDeepTemplate-3">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="20" y="92" width="200" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="120" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box1Title}</text>
      <text x="120" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line1}</text>
      <text x="120" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line2}</text>
      <text x="120" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Foot}</text>

      <text x="260" y="192" text-anchor="middle" font-size="20" fill="var(--accent)">{t.check}</text>

      <rect x="300" y="92" width="200" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box2Title}</text>
      <text x="400" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line1}</text>
      <text x="400" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line2}</text>
      <text x="400" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Foot}</text>

      <text x="540" y="192" text-anchor="middle" font-size="20" fill="var(--accent)">{t.cross}</text>

      <rect x="580" y="92" width="200" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="680" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box3Title}</text>
      <text x="680" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box3Line1}</text>
      <text x="680" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box3Line2}</text>
      <text x="680" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Foot}</text>

      <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
      <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
