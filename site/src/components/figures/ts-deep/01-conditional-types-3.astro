<!-- TsDeepCond-3 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Tuple wrapper [T] extends [U] tests the union whole without splitting; an open generic T stays deferred until the call site instantiates it",
    headline: "SUPPRESS WITH TUPLES, DEFER WHILE OPEN",
    sub: "[T] extends [U] checks the union whole — an unresolved T waits",
    tag1: "1 · wrap both sides",
    box1line1: "[T] extends [U]",
    box1line2: "T no longer naked",
    tag2: "2 · test whole",
    box2line1: "[string | boolean]",
    box2line2: "checked in one shot",
    box2line3: "no split — false",
    tag3: "3 · resolve at call",
    box3line1: "unwrap(Promise<5>)",
    box3line2: "T known — number",
    box3line3: "unwrap(x) open — waits",
    foot1: "one signature models overload-like returns once the caller supplies T",
    foot2: "two deferred conditionals match only when checked, extends, and branches align",
    caption:
      "Wrapping both sides in a one-element tuple suppresses distribution so the union is tested whole; while T stays generic the conditional is deferred and resolves at instantiation.",
  },
  ru: {
    svgTitle: "Обёртка [T] extends [U] проверяет объединение целиком без разбиения; открытый обобщённый T остаётся отложенным до инстанцирования в точке вызова",
    headline: "ПОДАВИТЬ КОРТЕЖЕМ, ОТЛОЖИТЬ, ПОКА ОТКРЫТ",
    sub: "[T] extends [U] проверяет объединение целиком — неразрешённый T ждёт",
    tag1: "1 · обернуть обе стороны",
    box1line1: "[T] extends [U]",
    box1line2: "T уже не голый",
    tag2: "2 · проверить целиком",
    box2line1: "[string | boolean]",
    box2line2: "проверено за один проход",
    box2line3: "без разбиения — false",
    tag3: "3 · разрешить в вызове",
    box3line1: "unwrap(Promise<5>)",
    box3line2: "T известен — number",
    box3line3: "unwrap(x) открыт — ждёт",
    foot1: "одна сигнатура моделирует перегрузочные возвраты, когда вызывающий дал T",
    foot2: "два отложенных условия совпадают, только если сходятся проверяемое, extends и ветки",
    caption:
      "Обёртка обеих сторон в одноэлементный кортеж подавляет дистрибуцию, и объединение проверяется целиком; пока T обобщённый, условие отложено и разрешается при инстанцировании.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="142" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="32" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="142" y="172" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line1}</text>
    <text x="142" y="202" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line2}</text>

    <line x1="252" y1="185" x2="271" y2="185" stroke="var(--accent)" stroke-width="2" />
    <polygon points="271,179 283,185 271,191" fill="var(--accent)" />

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="290" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line1}</text>
    <text x="400" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line2}</text>
    <text x="400" y="215" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box2line3}</text>

    <line x1="510" y1="185" x2="529" y2="185" stroke="var(--accent)" stroke-width="2" />
    <polygon points="529,179 541,185 529,191" fill="var(--accent)" />

    <text x="658" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="548" y="120" width="220" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="658" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line1}</text>
    <text x="658" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line2}</text>
    <text x="658" y="215" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line3}</text>

    <text x="400" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
