---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Remap to never to delete keys: function-valued save and load vanish while id and name remap to themselves and survive",
    headline: "FILTER BY REMAPPING TO never",
    sub: "a never key is the empty union — the property is omitted",
    srcTitle: "Model",
    srcRow1: "id: number",
    srcRow2: "name: string",
    srcRow3: "save(): void",
    srcRow4: "load(): void",
    keepLabel: "as K — kept",
    dropLabel: "as never — dropped",
    outTitle: "DataOnly<Model>",
    outRow1: "id: number",
    outRow2: "name: string",
    outNote: "save and load are gone",
    condLine: "T[K] extends (...a: any[]) => any ? never : K",
    condNote1: "function-valued keys resolve to never — empty union, omitted",
    condNote2: "the dropped key's value T[K] is never emitted",
    foot: "swap the branches (? K : never) to keep only matches instead",
    caption:
      "Filtering runs a conditional per key: data fields remap to themselves via K and survive, while function-valued save and load remap to never — the empty union — so no property is generated and their values are never emitted.",
  },
  ru: {
    svgTitle: "Ремаппинг в never удаляет ключи: save и load со значениями-функциями исчезают, а id и name ремаппятся в самих себя и выживают",
    headline: "ФИЛЬТРАЦИЯ РЕМАППИНГОМ В never",
    sub: "ключ never — пустое объединение: свойство опускается",
    srcTitle: "Model",
    srcRow1: "id: number",
    srcRow2: "name: string",
    srcRow3: "save(): void",
    srcRow4: "load(): void",
    keepLabel: "as K — сохраняется",
    dropLabel: "as never — удаляется",
    outTitle: "DataOnly<Model>",
    outRow1: "id: number",
    outRow2: "name: string",
    outNote: "save и load исчезли",
    condLine: "T[K] extends (...a: any[]) => any ? never : K",
    condNote1: "ключи со значениями-функциями — в never: пустое объединение, опущены",
    condNote2: "значение T[K] удалённого ключа не выдаётся",
    foot: "поменяйте ветки местами (? K : never) — оставите только совпадения",
    caption:
      "Фильтрация выполняет условие по ключам: поля данных ремаппятся в самих себя через K и выживают, а save и load со значениями-функциями ремаппятся в never — пустое объединение, — поэтому свойство не порождается, а их значения не выдаются.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsDeepRemap-2">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="60" y="80" width="260" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="190" y="106" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcTitle}</text>
      <text x="190" y="130" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcRow1}</text>
      <text x="190" y="154" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcRow2}</text>
      <text x="190" y="178" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcRow3}</text>
      <text x="190" y="202" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcRow4}</text>

      <text x="400" y="112" text-anchor="middle" font-size="11" fill="var(--muted)">{t.keepLabel}</text>
      <line x1="330" y1="140" x2="462" y2="140" stroke="var(--accent)" stroke-width="2" />
      <polygon points="470,140 459,135 459,145" fill="var(--accent)" />
      <line x1="330" y1="190" x2="462" y2="190" stroke="var(--muted)" stroke-width="2" />
      <polygon points="470,190 459,185 459,195" fill="var(--muted)" />
      <text x="400" y="214" text-anchor="middle" font-size="11" fill="var(--muted)">{t.dropLabel}</text>

      <rect x="480" y="80" width="260" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="610" y="106" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outTitle}</text>
      <text x="610" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outRow1}</text>
      <text x="610" y="158" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outRow2}</text>
      <text x="610" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.outNote}</text>

      <rect x="150" y="262" width="500" height="104" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="290" text-anchor="middle" font-size="12" fill="var(--ink)">{t.condLine}</text>
      <text x="400" y="316" text-anchor="middle" font-size="12" fill="var(--ink)">{t.condNote1}</text>
      <text x="400" y="342" text-anchor="middle" font-size="12" fill="var(--muted)">{t.condNote2}</text>

      <text x="400" y="398" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
