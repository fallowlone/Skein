<!-- TsDeepInfer-1 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "How ReturnType resolves: match F against a function pattern, bind infer R to string, return the true branch",
    headline: "INFER IS A HOLE IN THE PATTERN",
    sub: "ReturnType<T> = T extends (...a: any) => infer R ? R : any",
    inputHead: "input",
    inputSub: "(a: number) => string",
    patternHead: "pattern",
    patternSub: "(...a: any) => infer R",
    branchHead: "true branch",
    branchSub: "R = string",
    arrowMatch: "match",
    arrowCapture: "capture",
    holeNote: "infer R is the hole in the return slot",
    resultLine: "ReturnType<F> = string",
    moral: "the hole binds whatever fills the slot — true branch only",
    caption:
      "ReturnType matches F against (...a: any) => infer R, binds R to string, and returns it from the true branch: the hole captures whatever fills the return slot.",
  },
  ru: {
    svgTitle: "Как разрешается ReturnType: сопоставь F с образцом-функцией, свяжи infer R со string, верни истинную ветку",
    headline: "INFER — ДЫРА В ОБРАЗЦЕ",
    sub: "ReturnType<T> = T extends (...a: any) => infer R ? R : any",
    inputHead: "вход",
    inputSub: "(a: number) => string",
    patternHead: "образец",
    patternSub: "(...a: any) => infer R",
    branchHead: "истинная ветка",
    branchSub: "R = string",
    arrowMatch: "сопоставь",
    arrowCapture: "захвати R",
    holeNote: "infer R — дыра в слоте возврата",
    resultLine: "ReturnType<F> = string",
    moral: "дыра связывает то, что заполняет слот, — только истинная ветка",
    caption:
      "ReturnType сопоставляет F с (...a: any) => infer R, связывает R со string и возвращает его из истинной ветки: дыра захватывает то, что заполняет слот возврата.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsDeepInfer-1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="100" width="170" height="72" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="115" y="128" text-anchor="middle" font-size="13" fill="var(--ink)">{t.inputHead}</text>
    <text x="115" y="150" text-anchor="middle" font-size="12" fill="var(--muted)">{t.inputSub}</text>

    <line x1="200" y1="136" x2="267" y2="136" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsDeepInfer-1)" />
    <text x="233" y="122" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowMatch}</text>

    <rect x="275" y="100" width="250" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="128" text-anchor="middle" font-size="13" fill="var(--ink)">{t.patternHead}</text>
    <text x="400" y="150" text-anchor="middle" font-size="12" fill="var(--muted)">{t.patternSub}</text>

    <line x1="525" y1="136" x2="592" y2="136" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsDeepInfer-1)" />
    <text x="558" y="122" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowCapture}</text>

    <rect x="600" y="100" width="170" height="72" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="685" y="128" text-anchor="middle" font-size="13" fill="var(--ink)">{t.branchHead}</text>
    <text x="685" y="150" text-anchor="middle" font-size="12" fill="var(--accent)">{t.branchSub}</text>

    <text x="400" y="212" text-anchor="middle" font-size="12" fill="var(--muted)">{t.holeNote}</text>

    <rect x="30" y="240" width="740" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="275" text-anchor="middle" font-size="15" fill="var(--accent)">{t.resultLine}</text>

    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
