---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "T extends U tests assignability: { a: 1; b: 2 } extends { a: 1 } is yes, 42 extends number is yes, string extends \"a\" is no",
    headline: "EXTENDS MEANS ASSIGNABLE TO",
    sub: "T extends U ? X : Y asks: is every T a valid U?",
    tag1: "1 · wider to narrower",
    box1line1: "{ a: 1; b: 2 }",
    box1line2: "extends { a: 1 }",
    box1line3: "assignable — yes",
    tag2: "2 · literal to base",
    box2line1: "42 extends number",
    box2line2: "? X : Y",
    box2line3: "assignable — yes",
    tag3: "3 · wider to literal",
    box3line1: "string extends \"a\"",
    box3line2: "? X : Y",
    box3line3: "not assignable — no",
    foot1: "no prototype chains here — structural assignability picks the branch",
    foot2: "misread extends as subclass and the wide-to-narrow case looks backwards",
    caption:
      "A conditional type tests whether T is assignable to U: a wider object passes a narrower check and a literal passes its base, while a wide string fails a literal check.",
  },
  ru: {
    svgTitle: "{ a: 1; b: 2 } extends { a: 1 } — да, 42 extends number — да, string extends \"a\" — нет: проверяется совместимость",
    headline: "EXTENDS ЗНАЧИТ СОВМЕСТИМ С",
    sub: "T extends U ? X : Y спрашивает: совместим ли T с U?",
    tag1: "1 · широкий к узкому",
    box1line1: "{ a: 1; b: 2 }",
    box1line2: "extends { a: 1 }",
    box1line3: "совместим — yes",
    tag2: "2 · литерал к базовому",
    box2line1: "42 extends number",
    box2line2: "? X : Y",
    box2line3: "совместим — yes",
    tag3: "3 · широкий к литералу",
    box3line1: "string extends \"a\"",
    box3line2: "? X : Y",
    box3line3: "несовместим — no",
    foot1: "никаких цепочек прототипов — ветку выбирает структурная совместимость",
    foot2: "прочтёте extends как потомка класса — случай «широкий к узкому» выглядит наоборот",
    caption:
      "Условный тип проверяет, совместим ли T с U: широкий объект проходит узкую проверку, литерал проходит базовый тип, а широкая строка не проходит проверку литерала.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="142" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="32" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="142" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line1}</text>
    <text x="142" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line2}</text>
    <text x="142" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box1line3}</text>

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="290" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line1}</text>
    <text x="400" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line2}</text>
    <text x="400" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box2line3}</text>

    <text x="658" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="548" y="120" width="220" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="658" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line1}</text>
    <text x="658" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line2}</text>
    <text x="658" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box3line3}</text>

    <text x="400" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
