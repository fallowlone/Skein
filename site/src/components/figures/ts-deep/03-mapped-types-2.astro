---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "four mapping modifiers on the same source: question mark adds or strips optionality, readonly adds or strips readonly — each touches only its own modifier",
    headline: "MODIFIERS ARE ORTHOGONAL",
    sub: "Src = { a?: number; readonly b: string }",
    tagPartial: "+ ? — add optional",
    partialSig: "MyPartial<T>",
    partialOp: "[K in keyof T]?",
    partialLine1: "{ a?: number }",
    partialLine2: "{ readonly b?: string }",
    tagRequired: "−? — strip optional",
    requiredSig: "MyRequired<T>",
    requiredOp: "[K in keyof T]-?",
    requiredLine1: "{ a: number }",
    requiredLine2: "{ readonly b: string }",
    tagReadonly: "+ readonly",
    readonlySig: "MyReadonly<T>",
    readonlyOp: "readonly [K in ...]",
    readonlyLine1: "{ readonly a? }",
    readonlyLine2: "{ readonly b }",
    tagMutable: "−readonly — strip it",
    mutableSig: "MyMutable<T>",
    mutableOp: "-readonly [K in ...]",
    mutableLine1: "{ a?: number }",
    mutableLine2: "{ b: string }",
    foot1: "−? touches only optionality, −readonly only readonly-ness",
    foot2: "Partial, Required, Readonly, Mutable — one line each, from scratch",
    caption:
      "The four mapping modifiers are orthogonal on Src = { a?: number; readonly b: string }: MyPartial adds ? but keeps readonly b, MyRequired strips ? from a but leaves readonly, MyReadonly makes both readonly, and MyMutable strips readonly from b but keeps a optional.",
  },
  ru: {
    svgTitle: "четыре модификатора отображения на одном источнике: вопросительный знак добавляет или снимает опциональность, readonly добавляет или снимает readonly — каждый касается только своего модификатора",
    headline: "МОДИФИКАТОРЫ ОРТОГОНАЛЬНЫ",
    sub: "Src = { a?: number; readonly b: string }",
    tagPartial: "+ ? — добавить опциональность",
    partialSig: "MyPartial<T>",
    partialOp: "[K in keyof T]?",
    partialLine1: "{ a?: number }",
    partialLine2: "{ readonly b?: string }",
    tagRequired: "−? — снять опциональность",
    requiredSig: "MyRequired<T>",
    requiredOp: "[K in keyof T]-?",
    requiredLine1: "{ a: number }",
    requiredLine2: "{ readonly b: string }",
    tagReadonly: "+ readonly",
    readonlySig: "MyReadonly<T>",
    readonlyOp: "readonly [K in ...]",
    readonlyLine1: "{ readonly a? }",
    readonlyLine2: "{ readonly b }",
    tagMutable: "−readonly — снять его",
    mutableSig: "MyMutable<T>",
    mutableOp: "-readonly [K in ...]",
    mutableLine1: "{ a?: number }",
    mutableLine2: "{ b: string }",
    foot1: "−? касается только опциональности, −readonly — только readonly",
    foot2: "Partial, Required, Readonly, Mutable — по одной строке каждый, с нуля",
    caption:
      "Четыре модификатора отображения ортогональны на Src = { a?: number; readonly b: string }: MyPartial добавляет ?, но сохраняет readonly b, MyRequired снимает ? с a, но оставляет readonly, MyReadonly делает оба readonly, а MyMutable снимает readonly с b, но оставляет a опциональным.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsDeepMapped-2" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="125" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagPartial}</text>
    <rect x="40" y="126" width="170" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="125" y="154" text-anchor="middle" font-size="12" fill="var(--ink)">{t.partialSig}</text>
    <text x="125" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.partialOp}</text>
    <text x="125" y="218" text-anchor="middle" font-size="11" fill="var(--ink)">{t.partialLine1}</text>
    <text x="125" y="242" text-anchor="middle" font-size="11" fill="var(--ink)">{t.partialLine2}</text>

    <text x="315" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRequired}</text>
    <rect x="230" y="126" width="170" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="315" y="154" text-anchor="middle" font-size="12" fill="var(--ink)">{t.requiredSig}</text>
    <text x="315" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.requiredOp}</text>
    <text x="315" y="218" text-anchor="middle" font-size="11" fill="var(--ink)">{t.requiredLine1}</text>
    <text x="315" y="242" text-anchor="middle" font-size="11" fill="var(--ink)">{t.requiredLine2}</text>

    <text x="505" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagReadonly}</text>
    <rect x="420" y="126" width="170" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="505" y="154" text-anchor="middle" font-size="12" fill="var(--ink)">{t.readonlySig}</text>
    <text x="505" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.readonlyOp}</text>
    <text x="505" y="218" text-anchor="middle" font-size="11" fill="var(--ink)">{t.readonlyLine1}</text>
    <text x="505" y="242" text-anchor="middle" font-size="11" fill="var(--ink)">{t.readonlyLine2}</text>

    <text x="695" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagMutable}</text>
    <rect x="610" y="126" width="170" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="695" y="154" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mutableSig}</text>
    <text x="695" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mutableOp}</text>
    <text x="695" y="218" text-anchor="middle" font-size="11" fill="var(--ink)">{t.mutableLine1}</text>
    <text x="695" y="242" text-anchor="middle" font-size="11" fill="var(--ink)">{t.mutableLine2}</text>

    <text x="400" y="340" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="365" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
