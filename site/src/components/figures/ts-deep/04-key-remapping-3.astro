---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Two rules for computed keys: the key must be a PropertyKey and adding as breaks homomorphism, dropping readonly and optional modifiers",
    headline: "TWO RULES FOR COMPUTED KEYS",
    sub: "a valid PropertyKey — and as breaks homomorphism",
    rule1Title: "rule 1 — key fits PropertyKey",
    rule1Ok: "string · number · symbol — accepted",
    rule1Bad: "object · boolean — TypeScript errors",
    rule2Title: "rule 2 — as breaks homomorphism",
    rule2Row1: "readonly is silently dropped",
    rule2Row2: "? is no longer auto-copied",
    rule2Row3: "re-apply modifiers explicitly",
    strip1: "Getters<T> drops the readonly and ? the source carried",
    strip2: "a field marked readonly later vanishes from setters — no error",
    strip3: "getName exists nowhere in source: grep and Find-References miss it",
    foot: "uniform open rule — remap; a handful of fixed fields — write them out",
    caption:
      "A computed key must be assignable to PropertyKey — string, number, or symbol — or TypeScript errors; and adding as severs homomorphism, so readonly and ? modifiers silently vanish and generated keys like getName become invisible to text search.",
  },
  ru: {
    svgTitle: "Два ограничения вычисленных ключей: ключ должен быть PropertyKey, а добавление as ломает гомоморфность и сбрасывает модификаторы readonly и ?",
    headline: "ДВА ОГРАНИЧЕНИЯ ВЫЧИСЛЕННЫХ КЛЮЧЕЙ",
    sub: "допустимый PropertyKey — и as ломает гомоморфность",
    rule1Title: "правило 1 — ключ совместим с PropertyKey",
    rule1Ok: "string · number · symbol — принимается",
    rule1Bad: "объект · булево — TypeScript выдаст ошибку",
    rule2Title: "правило 2 — as ломает гомоморфность",
    rule2Row1: "readonly молча сбрасывается",
    rule2Row2: "? больше не копируется автоматически",
    rule2Row3: "верните модификаторы явно",
    strip1: "Getters<T> сбрасывает readonly и ?, которые нёс источник",
    strip2: "поле позже пометили readonly — ограничение исчезло без ошибки",
    strip3: "getName нет нигде в источнике: grep и Find-References его не находят",
    foot: "единообразный открытый набор — ремаппинг; горстка полей — напишите вручную",
    caption:
      "Вычисленный ключ должен быть совместим с PropertyKey — string, number или symbol, — иначе TypeScript выдаст ошибку; а добавление as разрывает гомоморфность, поэтому модификаторы readonly и ? молча исчезают, а сгенерированные ключи вроде getName невидимы для текстового поиска.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsDeepRemap-3">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="40" y="80" width="340" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="210" y="110" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rule1Title}</text>
      <text x="210" y="138" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rule1Ok}</text>
      <text x="210" y="166" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rule1Bad}</text>

      <rect x="420" y="80" width="340" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="590" y="110" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rule2Title}</text>
      <text x="590" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rule2Row1}</text>
      <text x="590" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rule2Row2}</text>
      <text x="590" y="184" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rule2Row3}</text>

      <rect x="120" y="240" width="560" height="104" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="268" text-anchor="middle" font-size="12" fill="var(--ink)">{t.strip1}</text>
      <text x="400" y="294" text-anchor="middle" font-size="12" fill="var(--ink)">{t.strip2}</text>
      <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.strip3}</text>

      <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
