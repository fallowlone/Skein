---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "homomorphic map over keyof T preserves modifiers and array shape, while a map over a detached key union drops modifiers and collapses arrays to plain objects",
    headline: "SAME LOOP, OPPOSITE GUARANTEES",
    sub: "homomorphism is detected syntactically: the constraint must be exactly keyof T",
    vs: "VS",
    tagHomo: "homomorphic — { [K in keyof T] }",
    homoSig: "Clone<T>",
    homoLine1: "Clone<number[]> → number[] ✓",
    homoLine2: "Clone<[1, 2]> → [1, 2] ✓",
    homoLine3: "Clone<readonly ...> → readonly kept ✓",
    homoFoot: "powers Partial / Required / Readonly",
    tagNonHomo: "non-homomorphic — { [P in K] }",
    nonHomoSig: "FromKeys<K, V>",
    nonHomoLine1: "keys: length, push, ...",
    nonHomoLine2: "→ plain object ✗ — NOT an array",
    nonHomoLine3: "modifiers dropped, no source link",
    nonHomoFoot: "this is why Record always yields an object",
    foot1: "lose the exact keyof T shape — via a routed parameter or as — and the link is gone",
    foot2: "modifiers are dropped, arrays collapse to plain objects",
    caption:
      "Only the homomorphic form (constraint exactly keyof T) keeps modifiers and array/tuple-ness: Clone<number[]> stays number[] and Clone<[1, 2]> stays [1, 2]. Route keys through a detached union like FromKeys<K, V> and both are lost — the result is always a plain object, which is why Record<K, V> yields objects.",
  },
  ru: {
    svgTitle: "гомоморфное отображение по keyof T сохраняет модификаторы и форму массива, а отображение по оторванному объединению ключей сбрасывает модификаторы и схлопывает массивы в обычные объекты",
    headline: "ТОТ ЖЕ ЦИКЛ — ПРОТИВОПОЛОЖНЫЕ ГАРАНТИИ",
    sub: "гомоморфность определяется синтаксически: ограничение — в точности keyof T",
    vs: "VS",
    tagHomo: "гомоморфное — { [K in keyof T] }",
    homoSig: "Clone<T>",
    homoLine1: "Clone<number[]> → number[] ✓",
    homoLine2: "Clone<[1, 2]> → [1, 2] ✓",
    homoLine3: "Clone<readonly…> → сохранён ✓",
    homoFoot: "питает Partial / Required / Readonly",
    tagNonHomo: "негомоморфное — { [P in K] }",
    nonHomoSig: "FromKeys<K, V>",
    nonHomoLine1: "ключи: length, push, ...",
    nonHomoLine2: "→ обычный объект ✗ — НЕ массив",
    nonHomoLine3: "модификаторы сброшены, связи нет",
    nonHomoFoot: "поэтому Record всегда даёт объект",
    foot1: "потеряйте точную форму keyof T — через лишний параметр или as — и связь исчезнет",
    foot2: "модификаторы теряются, массивы схлопываются в обычные объекты",
    caption:
      "Только гомоморфная форма (ограничение в точности keyof T) сохраняет модификаторы и природу массива/кортежа: Clone<number[]> остаётся number[], а Clone<[1, 2]> — [1, 2]. Пропустите ключи через оторванное объединение вроде FromKeys<K, V> — и теряете и то, и другое: результат всегда обычный объект, поэтому Record<K, V> даёт объекты.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsDeepMapped-3" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="190" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagHomo}</text>
    <rect x="40" y="126" width="300" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="190" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.homoSig}</text>
    <text x="190" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.homoLine1}</text>
    <text x="190" y="220" text-anchor="middle" font-size="12" fill="var(--ink)">{t.homoLine2}</text>
    <text x="190" y="244" text-anchor="middle" font-size="12" fill="var(--ink)">{t.homoLine3}</text>
    <text x="190" y="288" text-anchor="middle" font-size="11" fill="var(--muted)">{t.homoFoot}</text>

    <text x="400" y="221" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--muted)">{t.vs}</text>

    <text x="610" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagNonHomo}</text>
    <rect x="460" y="126" width="300" height="190" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="610" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.nonHomoSig}</text>
    <text x="610" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.nonHomoLine1}</text>
    <text x="610" y="220" text-anchor="middle" font-size="12" fill="var(--ink)">{t.nonHomoLine2}</text>
    <text x="610" y="244" text-anchor="middle" font-size="12" fill="var(--ink)">{t.nonHomoLine3}</text>
    <text x="610" y="288" text-anchor="middle" font-size="11" fill="var(--muted)">{t.nonHomoFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
