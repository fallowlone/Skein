---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Each key K is recomputed into a new string key: name becomes getName and age becomes getAge",
    headline: "RENAME KEYS WITH as",
    sub: "each K is recomputed into a new string key",
    srcTitle: "State",
    srcRow1: "name: string",
    srcRow2: "age: number",
    midTop: "as NewKey",
    midBottom: "rename",
    outTitle: "Getters<State>",
    outRow1: "getName: () => string",
    outRow2: "getAge: () => number",
    outNote: "new keys exist only in the output",
    step1: "K = name — string & K narrows to its string part",
    step2: "Capitalize<'name'> is 'Name', template gives 'getName'",
    step3: "emit under 'getName': () => T['name'], i.e. () => string",
    foot: "one uniform rename rule — no hand-written key list",
    caption:
      "Key remapping recomputes every key: for K = name the string & K intersection narrows to the string part, Capitalize gives Name, and the template emits getName carrying () => string; age follows the same rule to become getAge.",
  },
  ru: {
    svgTitle: "Каждый ключ K пересчитывается в новый строковый ключ: name становится getName, а age — getAge",
    headline: "ПЕРЕИМЕНОВАНИЕ КЛЮЧЕЙ ЧЕРЕЗ as",
    sub: "каждый K пересчитывается в новый строковый ключ",
    srcTitle: "State",
    srcRow1: "name: string",
    srcRow2: "age: number",
    midTop: "as NewKey",
    midBottom: "переименование",
    outTitle: "Getters<State>",
    outRow1: "getName: () => string",
    outRow2: "getAge: () => number",
    outNote: "новых ключей нет в источнике",
    step1: "K = name — string & K сужает до строковой части",
    step2: "Capitalize<'name'> — это 'Name', шаблон даёт 'getName'",
    step3: "выдаёт под 'getName': () => T['name'], то есть () => string",
    foot: "одно единообразное правило — список ключей писать не нужно",
    caption:
      "Ремаппинг пересчитывает каждый ключ: для K = name пересечение string & K сужает до строковой части, Capitalize даёт Name, а шаблон выдаёт getName со значением () => string; age по тому же правилу становится getAge.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsDeepRemap-1">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="60" y="80" width="260" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="190" y="110" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcTitle}</text>
      <text x="190" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcRow1}</text>
      <text x="190" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcRow2}</text>

      <text x="400" y="112" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midTop}</text>
      <line x1="330" y1="140" x2="462" y2="140" stroke="var(--muted)" stroke-width="2" />
      <polygon points="470,140 459,135 459,145" fill="var(--muted)" />
      <text x="400" y="166" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midBottom}</text>

      <rect x="480" y="80" width="260" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="610" y="110" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outTitle}</text>
      <text x="610" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outRow1}</text>
      <text x="610" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outRow2}</text>
      <text x="610" y="186" text-anchor="middle" font-size="11" fill="var(--muted)">{t.outNote}</text>

      <line x1="190" y1="200" x2="190" y2="240" stroke="var(--muted)" stroke-width="2" />
      <polygon points="190,248 185,237 195,237" fill="var(--muted)" />
      <line x1="610" y1="200" x2="610" y2="240" stroke="var(--muted)" stroke-width="2" />
      <polygon points="610,248 605,237 615,237" fill="var(--muted)" />

      <rect x="150" y="248" width="500" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="276" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step1}</text>
      <text x="400" y="302" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step2}</text>
      <text x="400" y="328" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step3}</text>

      <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
