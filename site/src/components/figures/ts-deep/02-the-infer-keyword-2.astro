---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Tuple capture: one pattern binds head H, tail Rest and last L of [1, 2, 3]",
    headline: "SEVERAL INFERS, ONE PATTERN",
    sub: "T extends [infer H, ...unknown[]] ? H : never",
    inputHead: "[1, 2, 3]",
    inputSub: "input",
    headPat: "[infer H, ...unknown[]]",
    headRes: "H = 1",
    tailPat: "[unknown, ...infer Rest]",
    tailRes: "Rest = [2, 3]",
    lastPat: "[...unknown[], infer L]",
    lastRes: "L = 3",
    moral: "each infer name binds its own slot — head, tail and last at once",
    caption:
      "One pattern captures head, tail and last of [1, 2, 3] at once: H is 1, Rest is [2, 3], L is 3 — each infer name binds its own slot.",
  },
  ru: {
    svgTitle: "Захват кортежа: один образец связывает голову H, хвост Rest и последний L из [1, 2, 3]",
    headline: "НЕСКОЛЬКО INFER В ОДНОМ ОБРАЗЦЕ",
    sub: "T extends [infer H, ...unknown[]] ? H : never",
    inputHead: "[1, 2, 3]",
    inputSub: "вход",
    headPat: "[infer H, ...unknown[]]",
    headRes: "H = 1",
    tailPat: "[unknown, ...infer Rest]",
    tailRes: "Rest = [2, 3]",
    lastPat: "[...unknown[], infer L]",
    lastRes: "L = 3",
    moral: "каждое имя infer связывает свой слот — голова, хвост и последний одновременно",
    caption:
      "Один образец захватывает голову, хвост и последний элемент [1, 2, 3] одновременно: H — 1, Rest — [2, 3], L — 3 — каждое имя infer связывает свой слот.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsDeepInfer-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="230" y="96" width="340" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="400" y="122" text-anchor="middle" font-size="14" fill="var(--ink)">{t.inputHead}</text>
    <text x="400" y="144" text-anchor="middle" font-size="11" fill="var(--muted)">{t.inputSub}</text>

    <line x1="140" y1="156" x2="140" y2="222" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsDeepInfer-2)" />
    <line x1="400" y1="156" x2="400" y2="222" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsDeepInfer-2)" />
    <line x1="660" y1="156" x2="660" y2="222" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsDeepInfer-2)" />

    <rect x="30" y="230" width="220" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="140" y="258" text-anchor="middle" font-size="12" fill="var(--ink)">{t.headPat}</text>
    <text x="140" y="282" text-anchor="middle" font-size="13" fill="var(--accent)">{t.headRes}</text>

    <rect x="290" y="230" width="220" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="400" y="258" text-anchor="middle" font-size="12" fill="var(--ink)">{t.tailPat}</text>
    <text x="400" y="282" text-anchor="middle" font-size="13" fill="var(--accent)">{t.tailRes}</text>

    <rect x="550" y="230" width="220" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="660" y="258" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lastPat}</text>
    <text x="660" y="282" text-anchor="middle" font-size="13" fill="var(--accent)">{t.lastRes}</text>

    <text x="400" y="348" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
