---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle:
      "Parsing with infer inside a template pattern: RouteParam extracts id from /users/:id/posts, and Split peels one segment per recursion",
    headline: "INFER INSIDE A PATTERN PARSES STRINGS OUT",
    sub: "S extends `${string}:${infer Param}/${string}` ? Param : never",
    box1Title: "input string",
    box1Line1: "/users/:id/posts",
    box1Line2: "route with :id",
    box1Foot: "S extends string",
    box2Title: "pattern",
    box2Line1: "${infer Param}",
    box2Line2: "between : and /",
    box2Foot: "RouteParam<S>",
    box3Title: "parsed out",
    box3Line1: "Param = id",
    box3Line2: "Split peels one",
    box3Foot: "per recursion",
    arrow: "->",
    foot1: 'RouteParam<"/users/:id/posts"> resolves to "id"',
    foot2: 'Split<"a-b-c", "-"> recurses to ["a", "b", "c"]',
    caption:
      "Putting infer inside the template pattern pulls substrings out of the string type: RouteParam extracts id from the route, and Split peels one delimiter segment per recursion step.",
  },
  ru: {
    svgTitle:
      "Разбор через infer внутри шаблонного образца: RouteParam извлекает id из /users/:id/posts, а Split отслаивает по одному сегменту за рекурсию",
    headline: "INFER ВНУТРИ ОБРАЗЦА РАЗБИРАЕТ СТРОКИ",
    sub: "S extends `${string}:${infer Param}/${string}` ? Param : never",
    box1Title: "входная строка",
    box1Line1: "/users/:id/posts",
    box1Line2: "маршрут с :id",
    box1Foot: "S extends string",
    box2Title: "образец",
    box2Line1: "${infer Param}",
    box2Line2: "между : и /",
    box2Foot: "RouteParam<S>",
    box3Title: "разобрано",
    box3Line1: "Param = id",
    box3Line2: "Split отслаивает один",
    box3Foot: "сегмент за рекурсию",
    arrow: "->",
    foot1: 'RouteParam<"/users/:id/posts"> разрешается в "id"',
    foot2: 'Split<"a-b-c", "-"> рекурсирует в ["a", "b", "c"]',
    caption:
      "Помещённый внутрь шаблонного образца infer вытаскивает подстроки из строкового типа: RouteParam извлекает id из маршрута, а Split отслаивает по одному сегменту с разделителем за шаг рекурсии.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsDeepTemplate-2">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="20" y="92" width="200" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="120" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box1Title}</text>
      <text x="120" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line1}</text>
      <text x="120" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line2}</text>
      <text x="120" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Foot}</text>

      <text x="260" y="192" text-anchor="middle" font-size="20" fill="var(--accent)">{t.arrow}</text>

      <rect x="300" y="92" width="200" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box2Title}</text>
      <text x="400" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line1}</text>
      <text x="400" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line2}</text>
      <text x="400" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Foot}</text>

      <text x="540" y="192" text-anchor="middle" font-size="20" fill="var(--accent)">{t.arrow}</text>

      <rect x="580" y="92" width="200" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="680" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box3Title}</text>
      <text x="680" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box3Line1}</text>
      <text x="680" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box3Line2}</text>
      <text x="680" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Foot}</text>

      <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
      <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
