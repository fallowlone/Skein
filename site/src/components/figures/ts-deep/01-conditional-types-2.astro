---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Distribution: ToArray<string | number> splits on the naked T into ToArray<string> | ToArray<number> and unions to string[] | number[]",
    headline: "NAKED T DISTRIBUTES OVER UNIONS",
    sub: "ToArray<T> = T extends unknown ? T[] : never run per member",
    tag1: "1 · union argument",
    box1line1: "ToArray<string",
    box1line2: "| number>",
    tag2: "2 · member one",
    box2line1: "string extends",
    box2line2: "unknown ? string[]",
    tag3: "3 · member two",
    box3line1: "number extends",
    box3line2: "unknown ? number[]",
    tag4: "4 · union results",
    box4line1: "string[] | number[]",
    box4line2: "never drops out",
    foot1: "Exclude works the same way: matching members become never and vanish",
    foot2: "distributing over never yields never — the empty union has no members",
    caption:
      "A naked type parameter splits the union argument so the conditional runs once per member; the branch results are then unioned back together.",
  },
  ru: {
    svgTitle: "Дистрибуция: ToArray<string | number> разбивается по голому T на ToArray<string> | ToArray<number> и объединяется в string[] | number[]",
    headline: "ГОЛЫЙ T ДИСТРИБУТИРУЕТ ПО ОБЪЕДИНЕНИЯМ",
    sub: "ToArray<T> = T extends unknown ? T[] : never выполняется по членам",
    tag1: "1 · аргумент-объединение",
    box1line1: "ToArray<string",
    box1line2: "| number>",
    tag2: "2 · первый член",
    box2line1: "string extends",
    box2line2: "unknown ? string[]",
    tag3: "3 · второй член",
    box3line1: "number extends",
    box3line2: "unknown ? number[]",
    tag4: "4 · объединить результаты",
    box4line1: "string[] | number[]",
    box4line2: "never выпадает",
    foot1: "Exclude работает так же: совпавшие члены становятся never и исчезают",
    foot2: "дистрибуция над never даёт never — у пустого объединения нет членов",
    caption:
      "Голый параметр типа разбивает аргумент-объединение, условие выполняется по разу на каждый член, а результаты веток объединяются обратно.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="114" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="32" y="120" width="165" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="114" y="175" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1line1}</text>
    <text x="114" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1line2}</text>

    <line x1="197" y1="185" x2="216" y2="185" stroke="var(--accent)" stroke-width="2" />
    <polygon points="216,179 228,185 216,191" fill="var(--accent)" />

    <text x="304" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="222" y="120" width="165" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="304" y="175" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2line1}</text>
    <text x="304" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2line2}</text>

    <line x1="387" y1="185" x2="406" y2="185" stroke="var(--accent)" stroke-width="2" />
    <polygon points="406,179 418,185 406,191" fill="var(--accent)" />

    <text x="494" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="412" y="120" width="165" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="494" y="175" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3line1}</text>
    <text x="494" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3line2}</text>

    <line x1="577" y1="185" x2="596" y2="185" stroke="var(--accent)" stroke-width="2" />
    <polygon points="596,179 608,185 596,191" fill="var(--accent)" />

    <text x="684" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag4}</text>
    <rect x="602" y="120" width="165" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="684" y="175" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box4line1}</text>
    <text x="684" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box4line2}</text>

    <text x="400" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
