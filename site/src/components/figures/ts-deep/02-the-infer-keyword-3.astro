---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Variance of infer candidates: covariant positions union to string | number, contravariant parameters intersect to string & number",
    headline: "SAME NAME: OUTPUTS UNION, INPUTS INTERSECT",
    sub: "one U in two slots — union or intersection?",
    coInHead: "{ a: infer U; b: infer U }",
    coInSub: "{ a: string; b: number }",
    coArrow: "union",
    coOutHead: "U = string | number",
    coOutSub: "covariant positions",
    contraInHead: "f(x: infer U), g(x: infer U)",
    contraInSub: "x: string vs x: number",
    contraArrow: "intersect",
    contraOutHead: "U = string & number (never)",
    contraOutSub: "contravariant positions",
    moral: "outputs union, inputs intersect — straight from variance",
    caption:
      "One infer name U unions covariant candidates (string | number) but intersects contravariant parameter candidates (string & number, here never): outputs union, inputs intersect.",
  },
  ru: {
    svgTitle: "Вариантность кандидатов infer: ковариантные позиции объединяют в string | number, контравариантные параметры пересекают в string & number",
    headline: "ОДНО ИМЯ: ВЫХОДЫ ОБЪЕДИНЯЮТСЯ, ВХОДЫ ПЕРЕСЕКАЮТСЯ",
    sub: "один U в двух слотах — объединение или пересечение?",
    coInHead: "{ a: infer U; b: infer U }",
    coInSub: "{ a: string; b: number }",
    coArrow: "объединение",
    coOutHead: "U = string | number",
    coOutSub: "ковариантные позиции",
    contraInHead: "f(x: infer U), g(x: infer U)",
    contraInSub: "x: string vs x: number",
    contraArrow: "пересечение",
    contraOutHead: "U = string & number (never)",
    contraOutSub: "контравариантные позиции",
    moral: "выходы объединяются, входы пересекаются — прямо из вариантности",
    caption:
      "Одно имя infer U объединяет ковариантных кандидатов (string | number), но пересекает контравариантных кандидатов-параметров (string & number, здесь never): выходы объединяются, входы пересекаются.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsDeepInfer-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="100" width="270" height="72" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="165" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.coInHead}</text>
    <text x="165" y="150" text-anchor="middle" font-size="11" fill="var(--muted)">{t.coInSub}</text>

    <line x1="300" y1="136" x2="382" y2="136" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsDeepInfer-3)" />
    <text x="341" y="122" text-anchor="middle" font-size="11" fill="var(--accent)">{t.coArrow}</text>

    <rect x="390" y="100" width="380" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="580" y="128" text-anchor="middle" font-size="13" fill="var(--accent)">{t.coOutHead}</text>
    <text x="580" y="150" text-anchor="middle" font-size="11" fill="var(--muted)">{t.coOutSub}</text>

    <rect x="30" y="216" width="270" height="72" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="165" y="244" text-anchor="middle" font-size="12" fill="var(--ink)">{t.contraInHead}</text>
    <text x="165" y="266" text-anchor="middle" font-size="11" fill="var(--muted)">{t.contraInSub}</text>

    <line x1="300" y1="252" x2="382" y2="252" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsDeepInfer-3)" />
    <text x="341" y="238" text-anchor="middle" font-size="11" fill="var(--accent)">{t.contraArrow}</text>

    <rect x="390" y="216" width="380" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="580" y="244" text-anchor="middle" font-size="13" fill="var(--accent)">{t.contraOutHead}</text>
    <text x="580" y="266" text-anchor="middle" font-size="11" fill="var(--muted)">{t.contraOutSub}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
