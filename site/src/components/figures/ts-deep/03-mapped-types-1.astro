---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "a mapped type loops over keyof T and rebuilds the object key by key — Stringify turns every value to string",
    headline: "KEY LOOP: ONE PROPERTY PER KEY",
    sub: "Stringify<T> = { [K in keyof T]: string }",
    tagSource: "1 — source",
    srcTitle: "Config",
    srcLine1: "{ port: number }",
    srcLine2: "{ host: string }",
    srcLine3: "{ tls: boolean }",
    tagKeys: "2 — key union",
    keysTitle: "keyof Config",
    keysLine1: '"port" | "host"',
    keysLine2: '| "tls"',
    keysFoot: "computed at instantiation",
    tagOut: "3 — rebuilt",
    outTitle: "Stringify<Config>",
    outLine1: "{ port: string }",
    outLine2: "{ host: string }",
    outLine3: "{ tls: string }",
    foot1: "the keys are never listed — adding a field to Config adds it here too",
    foot2: "swap the value expression for T[K] and Clone reproduces the type",
    caption:
      "A mapped type iterates the keyof T union and emits one property per key: Stringify<Config> rebuilds { port, host, tls } with every value set to string, while Clone<T> = { [K in keyof T]: T[K] } keeps each original value type via T[K].",
  },
  ru: {
    svgTitle: "отображённый тип обходит keyof T и пересобирает объект ключ за ключом — Stringify ставит каждому значению string",
    headline: "ЦИКЛ ПО КЛЮЧАМ: ПО СВОЙСТВУ НА КЛЮЧ",
    sub: "Stringify<T> = { [K in keyof T]: string }",
    tagSource: "1 — источник",
    srcTitle: "Config",
    srcLine1: "{ port: number }",
    srcLine2: "{ host: string }",
    srcLine3: "{ tls: boolean }",
    tagKeys: "2 — объединение ключей",
    keysTitle: "keyof Config",
    keysLine1: '"port" | "host"',
    keysLine2: '| "tls"',
    keysFoot: "вычисляется при инстанцировании",
    tagOut: "3 — пересобран",
    outTitle: "Stringify<Config>",
    outLine1: "{ port: string }",
    outLine2: "{ host: string }",
    outLine3: "{ tls: string }",
    foot1: "ключи нигде не перечислены — новое поле в Config появится и здесь",
    foot2: "замените выражение значения на T[K] — и Clone воспроизведёт тип",
    caption:
      "Отображённый тип обходит объединение keyof T и выдаёт по одному свойству на ключ: Stringify<Config> пересобирает { port, host, tls }, ставя каждому значению string, а Clone<T> = { [K in keyof T]: T[K] } сохраняет каждый исходный тип значения через T[K].",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsDeepMapped-1" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="145" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagSource}</text>
    <rect x="40" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="145" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcTitle}</text>
    <text x="145" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcLine1}</text>
    <text x="145" y="220" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcLine2}</text>
    <text x="145" y="244" text-anchor="middle" font-size="12" fill="var(--ink)">{t.srcLine3}</text>

    <line x1="254" y1="221" x2="281" y2="221" stroke="var(--muted)" stroke-width="2" />
    <polygon points="281,214 291,221 281,228" fill="var(--muted)" />

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagKeys}</text>
    <rect x="295" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.keysTitle}</text>
    <text x="400" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.keysLine1}</text>
    <text x="400" y="220" text-anchor="middle" font-size="12" fill="var(--ink)">{t.keysLine2}</text>
    <text x="400" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.keysFoot}</text>

    <line x1="509" y1="221" x2="536" y2="221" stroke="var(--muted)" stroke-width="2" />
    <polygon points="536,214 546,221 536,228" fill="var(--muted)" />

    <text x="655" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagOut}</text>
    <rect x="550" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="655" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outTitle}</text>
    <text x="655" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outLine1}</text>
    <text x="655" y="220" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outLine2}</text>
    <text x="655" y="244" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outLine3}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
