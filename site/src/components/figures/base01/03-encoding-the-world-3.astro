---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "RGB encodes a pixel as three bytes; PCM samples air pressure as integers",
    headline: "COLOUR AS NUMBERS · SOUND AS SAMPLES",
    sub: "RGB: 8 bits per channel · PCM: pressure sampled at regular intervals",
    rgbHead: "RGB · ONE PIXEL = 3 BYTES",
    rgbExample: "pure red (255, 0, 0)",
    rgbBits: "8 bits × 3 = 24 bits per pixel",
    rgbCount: "2²⁴ = 16,777,216 colours",
    rgbEnds: "white all-max · black all-zero",
    pcmHead: "PCM · SOUND AS NUMBERS",
    pcmWave: "air pressure over time",
    pcmParams: "sample rate · bit depth",
    pcmCd: "CD: 44,100/s · 16-bit · 65,536 levels",
    pcmPro: "pro: 24-bit · 96 kHz",
    timeLabel: "time",
    note: "24 bits per pixel · samples are integers only the right decoder understands",
    caption:
      "RGB encodes one pixel as three bytes: pure red is (255, 0, 0); 8 bits per channel give 256 levels, 24 bits per pixel give 2²⁴ = 16,777,216 colours; white is all channels at maximum, black all at zero. PCM samples air pressure at regular intervals as integers; CD quality is 44,100 samples per second at 16 bits (65,536 levels), professional audio 24 bits at 96 kHz.",
  },
  ru: {
    svgTitle: "RGB кодирует пиксель тремя байтами; PCM семплирует давление воздуха целыми числами",
    headline: "ЦВЕТ КАК ЧИСЛА · ЗВУК КАК СЕМПЛЫ",
    sub: "RGB: 8 бит на канал · PCM: замеры давления через равные интервалы",
    rgbHead: "RGB · ОДИН ПИКСЕЛЬ = 3 БАЙТА",
    rgbExample: "чистый красный (255, 0, 0)",
    rgbBits: "8 бит × 3 = 24 бита на пиксель",
    rgbCount: "2²⁴ = 16 777 216 цветов",
    rgbEnds: "белый — всё макс · чёрный — нули",
    pcmHead: "PCM · ЗВУК КАК ЧИСЛА",
    pcmWave: "давление воздуха во времени",
    pcmParams: "частота дискретизации · битовая глубина",
    pcmCd: "CD: 44 100/с · 16 бит · 65 536 уровней",
    pcmPro: "профи: 24 бита · 96 кГц",
    timeLabel: "время",
    note: "24 бита на пиксель · семплы понятны лишь верному декодеру",
    caption:
      "RGB кодирует пиксель тремя байтами: чистый красный — (255, 0, 0); 8 бит на канал дают 256 уровней, 24 бита на пиксель — 2²⁴ = 16 777 216 цветов; белый — все каналы на максимуме, чёрный — все на нуле. PCM семплирует давление воздуха через равные интервалы целыми числами; CD-качество — 44 100 семплов в секунду при 16 битах (65 536 уровней), профессиональное аудио — 24 бита при 96 кГц.",
  },
};

const t = dict[lang];

const channels = [
  { name: "R", value: "255", fill: 170 },
  { name: "G", value: "0", fill: 0 },
  { name: "B", value: "0", fill: 0 },
];

const barY = (i: number) => 132 + i * 36;
const barX = 150;
const barW = 170;
const barH = 20;

const wavePts =
  "440,180 450,168 460,158 470,152 480,152 490,158 500,168 510,180 520,192 530,202 540,208 550,208 560,202 570,192 580,180 590,168 600,160 610,158 620,162 630,172 640,184 650,196 660,204 670,206 680,202 690,194 700,184 710,174 720,168 730,168";

const samples = [
  { x: 444, cy: 175 },
  { x: 480, cy: 152 },
  { x: 516, cy: 187 },
  { x: 552, cy: 207 },
  { x: 588, cy: 170 },
  { x: 624, cy: 166 },
  { x: 660, cy: 204 },
  { x: 696, cy: 188 },
];

const axisY = 228;

const leftX = 40;
const panelW = 350;
const panelY = 90;
const panelH = 250;
const rightX = 410;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x={leftX} y={panelY} width={panelW} height={panelH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x={leftX} y={panelY} width={panelW} height="30" fill="var(--accent)" />
    <text x={leftX + panelW / 2} y="111" text-anchor="middle" font-size="13" fill="var(--card)">{t.rgbHead}</text>
    {channels.map((c, i) => (
      <g>
        <text x="64" y={barY(i) + 15} font-size="13" fill="var(--ink)">{c.name}</text>
        <rect x={barX} y={barY(i)} width={barW} height={barH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <rect x={barX} y={barY(i)} width={c.fill} height={barH} fill="var(--accent)" />
        <text x="330" y={barY(i) + 15} font-size="13" fill="var(--ink)">{c.value}</text>
      </g>
    ))}
    <text x={leftX + panelW / 2} y="258" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rgbExample}</text>
    <text x={leftX + panelW / 2} y="284" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rgbBits}</text>
    <text x={leftX + panelW / 2} y="310" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rgbCount}</text>
    <text x={leftX + panelW / 2} y="332" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rgbEnds}</text>

    <rect x={rightX} y={panelY} width={panelW} height={panelH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x={rightX} y={panelY} width={panelW} height="30" fill="var(--accent)" />
    <text x={rightX + panelW / 2} y="111" text-anchor="middle" font-size="13" fill="var(--card)">{t.pcmHead}</text>
    <line x1="430" y1={axisY} x2="740" y2={axisY} stroke="var(--muted)" stroke-width="1.5" />
    <polyline points={wavePts} fill="none" stroke="var(--ink)" stroke-width="2" />
    {samples.map((s) => (
      <g>
        <line x1={s.x} y1={s.cy + 4} x2={s.x} y2={axisY} stroke="var(--muted)" stroke-width="1" />
        <circle cx={s.x} cy={s.cy} r="4" fill="var(--accent)" />
      </g>
    ))}
    <text x="740" y={axisY - 6} text-anchor="end" font-size="11" fill="var(--muted)">{t.timeLabel}</text>
    <text x={rightX + panelW / 2} y="252" text-anchor="middle" font-size="12" fill="var(--muted)">{t.pcmWave}</text>
    <text x={rightX + panelW / 2} y="278" text-anchor="middle" font-size="13" fill="var(--ink)">{t.pcmParams}</text>
    <text x={rightX + panelW / 2} y="304" text-anchor="middle" font-size="13" fill="var(--ink)">{t.pcmCd}</text>
    <text x={rightX + panelW / 2} y="330" text-anchor="middle" font-size="13" fill="var(--muted)">{t.pcmPro}</text>

    <text x="400" y="380" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
