---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Half-adder adding one and one into sum zero and carry one",
    headline: "HALF-ADDER: SUM AND CARRY",
    sub: "one AND gate and one XOR circuit on shared inputs",
    gateAnd: "AND",
    gateXor: "XOR",
    carry: "carry",
    sum: "sum",
    binaryGloss: " in binary",
    closure: "no new primitives — these gates are enough",
    caption:
      "A half-adder on inputs one and one: the AND gate reports carry one, the XOR circuit reports sum zero — one plus one is ten in binary. Sum is XOR, carry is AND; no new primitives needed.",
  },
  ru: {
    svgTitle: "Полусумматор складывает единицу и единицу: сумма ноль, перенос один",
    headline: "ПОЛУСУММАТОР: СУММА И ПЕРЕНОС",
    sub: "вентиль И и схема XOR на общих входах",
    gateAnd: "И",
    gateXor: "XOR",
    carry: "перенос",
    sum: "сумма",
    binaryGloss: " в двоичной записи",
    closure: "новые примитивы не нужны — этих вентилей достаточно",
    caption:
      "Полусумматор на входах единица и единица: вентиль И сообщает перенос один, схема XOR — сумму ноль: один плюс один — десять в двоичной записи. Сумма — это XOR, перенос — это И; новые примитивы не нужны.",
  },
};

const t = dict[lang];

const inputs = [
  { s: "A = 1", y: 120 },
  { s: "B = 1", y: 240 },
];
const eqCarry = " = 1";
const eqSum = " = 0";
const addFormula = "1 + 1 = 10";
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {inputs.map((inp) => (
      <g>
        <rect x="36" y={inp.y} width="104" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="88" y={inp.y + 26} text-anchor="middle" font-size="14" fill="var(--ink)">{inp.s}</text>
      </g>
    ))}

    <rect x="270" y="114" width="110" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="325" y="145" text-anchor="middle" font-size="15" fill="var(--ink)">{t.gateAnd}</text>
    <rect x="270" y="234" width="110" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="325" y="265" text-anchor="middle" font-size="15" fill="var(--ink)">{t.gateXor}</text>
    <rect x="560" y="114" width="150" height="52" fill="var(--accent)" />
    <text x="635" y="146" text-anchor="middle" font-size="14" fill="var(--card)"><tspan>{t.carry}</tspan><tspan>{eqCarry}</tspan></text>
    <rect x="560" y="234" width="150" height="52" fill="var(--accent)" />
    <text x="635" y="266" text-anchor="middle" font-size="14" fill="var(--card)"><tspan>{t.sum}</tspan><tspan>{eqSum}</tspan></text>

    <line x1="140" y1="132" x2="263" y2="132" stroke="var(--ink)" stroke-width="2" />
    <polygon points="263,127 263,137 270,132" fill="var(--ink)" />
    <polyline points="36,260 20,260 20,100 320,100 320,107" fill="none" stroke="var(--ink)" stroke-width="2" />
    <polygon points="315,107 325,107 320,114" fill="var(--ink)" />
    <polyline points="140,148 200,148 200,252 263,252" fill="none" stroke="var(--ink)" stroke-width="2" />
    <polygon points="263,247 263,257 270,252" fill="var(--ink)" />
    <line x1="140" y1="268" x2="263" y2="268" stroke="var(--ink)" stroke-width="2" />
    <polygon points="263,263 263,273 270,268" fill="var(--ink)" />
    <line x1="380" y1="140" x2="553" y2="140" stroke="var(--ink)" stroke-width="2" />
    <polygon points="553,135 553,145 560,140" fill="var(--ink)" />
    <line x1="380" y1="260" x2="553" y2="260" stroke="var(--ink)" stroke-width="2" />
    <polygon points="553,255 553,265 560,260" fill="var(--ink)" />

    <text x="400" y="352" text-anchor="middle" font-size="15" fill="var(--ink)"><tspan>{addFormula}</tspan><tspan>{t.binaryGloss}</tspan></text>
    <text x="400" y="376" text-anchor="middle" font-size="13" fill="var(--muted)">{t.closure}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
