---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Binary place weights are powers of two, each twice the one to its right",
    headline: "EACH PLACE IS WORTH TWICE THE ONE TO ITS RIGHT",
    sub: "base 2: weights are powers of 2 — 2⁰=1, 2¹=2, 2²=4, 2³=8, 2⁴=16",
    powLabel: "power",
    weightLabel: "weight",
    anchorNote: "weight 1 anchored at the right end",
    patNote: "one extra bit always doubles the range",
    patRows: ["1 bit → 2 patterns", "2 bits → 4 patterns", "3 bits → 8 patterns"],
    caption:
      "Place value in base 2: weights are powers of 2 (2⁰=1 … 2⁴=16), each place worth twice the one to its right; weight 1 anchors at the right end. One extra bit doubles the patterns: 1 bit → 2, 2 bits → 4, 3 bits → 8.",
  },
  ru: {
    svgTitle: "Двоичные веса разрядов — степени двойки, каждый вдвое больше правого",
    headline: "КАЖДЫЙ РАЗРЯД = ×2 К СОСЕДНЕМУ СПРАВА",
    sub: "основание 2: веса — степени двойки: 2⁰=1, 2¹=2, 2²=4, 2³=8, 2⁴=16",
    powLabel: "степень",
    weightLabel: "вес",
    anchorNote: "вес 1 привязан к правому краю",
    patNote: "один лишний бит всегда удваивает диапазон",
    patRows: ["1 бит → 2 паттерна", "2 бита → 4 паттерна", "3 бита → 8 паттернов"],
    caption:
      "Позиционная запись при основании 2: веса — степени двойки (2⁰=1 … 2⁴=16), каждый разряд вдвое больше соседнего справа; вес 1 привязан к правому краю. Один лишний бит удваивает паттерны: 1 бит → 2, 2 бита → 4, 3 бита → 8.",
  },
};

const t = dict[lang];

const cells = [
  { pow: "2⁴", val: "16" },
  { pow: "2³", val: "8" },
  { pow: "2²", val: "4" },
  { pow: "2¹", val: "2" },
  { pow: "2⁰", val: "1" },
];
const gaps = [0, 1, 2, 3];
const times2 = "×2";

const x0 = 120;
const cw = 96;
const ch = 64;
const cy = 172;
const step = 116;
const cellX = (i: number) => x0 + i * step;
const gapCX = (i: number) => x0 + i * step + cw + 10;
const arrowLX = (i: number) => cellX(i) + cw;
const arrowPoints = (i: number) =>
  `${arrowLX(i)},${cy} ${arrowLX(i) + 8},${cy - 6} ${arrowLX(i) + 8},${cy + 6}`;
const patX = (i: number) => 200 + i * 200;
const anchorX = cellX(4) + cw / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="108" y="128" text-anchor="end" font-size="13" fill="var(--ink)">{t.powLabel}</text>
    <text x="108" y="180" text-anchor="end" font-size="13" fill="var(--ink)">{t.weightLabel}</text>
    {cells.map((c, i) => (
      <g>
        <text x={cellX(i) + cw / 2} y="128" text-anchor="middle" font-size="14" fill="var(--muted)">{c.pow}</text>
        <rect x={cellX(i)} y="140" width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="180" text-anchor="middle" font-size="20" fill="var(--ink)">{c.val}</text>
      </g>
    ))}
    {gaps.map((i) => (
      <g>
        <line x1={cellX(i + 1) - 2} y1={cy} x2={cellX(i) + cw + 8} y2={cy} stroke="var(--accent)" stroke-width="2" />
        <polygon points={arrowPoints(i)} fill="var(--accent)" />
        <text x={gapCX(i)} y="152" text-anchor="middle" font-size="13" fill="var(--accent)">{times2}</text>
      </g>
    ))}

    <line x1={anchorX} y1="248" x2={anchorX} y2="214" stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${anchorX - 6},214 ${anchorX + 6},214 ${anchorX},204`} fill="var(--accent)" />
    <text x={anchorX} y="270" text-anchor="middle" font-size="13" fill="var(--ink)">{t.anchorNote}</text>

    <text x="400" y="314" text-anchor="middle" font-size="13" fill="var(--muted)">{t.patNote}</text>
    {t.patRows.map((r, i) => (
      <text x={patX(i)} y="348" text-anchor="middle" font-size="14" fill="var(--ink)">{r}</text>
    ))}
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
