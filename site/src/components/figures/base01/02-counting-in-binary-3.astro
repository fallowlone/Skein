---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Converting 13 to binary by repeated halving: remainders read bottom to top give 1101",
    headline: "WRITING BINARY: REPEATED HALVING",
    sub: "divide by 2, record each remainder, read them bottom to top",
    divLabel: "division",
    quotLabel: "quotient",
    remLabel: "remainder",
    readOrder: "read bottom → top",
    resultLabel: "binary result",
    sumLabel: "sum",
    remLine: "remainders bottom to top: 1, 1, 0, 1 → 1101",
    note: "odd numbers leave remainder 1 · even numbers leave 0",
    caption:
      "Converting 13 to binary: divide by 2 repeatedly, record remainders 1, 0, 1, 1, read them bottom to top → 1101. Check by place value: 8 + 4 + 0 + 1 = 13.",
  },
  ru: {
    svgTitle: "Перевод 13 в двоичное делением на 2: остатки снизу вверх дают 1101",
    headline: "ЗАПИСЬ ДВОИЧНОГО ЧИСЛА: ДЕЛЕНИЕ НА 2",
    sub: "дели на 2, записывай каждый остаток, читай их снизу вверх",
    divLabel: "деление",
    quotLabel: "частное",
    remLabel: "остаток",
    readOrder: "читай снизу вверх",
    resultLabel: "двоичный результат",
    sumLabel: "сумма",
    remLine: "остатки снизу вверх: 1, 1, 0, 1 → 1101",
    note: "нечётные числа дают остаток 1 · чётные — 0",
    caption:
      "Перевод 13 в двоичное: последовательно делим на 2, записываем остатки 1, 0, 1, 1, читаем их снизу вверх → 1101. Проверка весами: 8 + 4 + 0 + 1 = 13.",
  },
};

const t = dict[lang];

const rows = [
  { div: "13 ÷ 2", q: "6", r: "1" },
  { div: "6 ÷ 2", q: "3", r: "0" },
  { div: "3 ÷ 2", q: "1", r: "1" },
  { div: "1 ÷ 2", q: "0", r: "1" },
];
const resBits = ["1", "1", "0", "1"];
const resW = ["8", "4", "2", "1"];
const backSum = "8 + 4 + 0 + 1 = 13";

const rowY = (i: number) => 142 + i * 40;
const remBoxY = (i: number) => rowY(i) - 15;
const resX = (i: number) => 530 + i * 60;
const resFill = (v: string) => (v === "1" ? "var(--accent)" : "var(--card)");
const resBitFill = (v: string) => (v === "1" ? "var(--card)" : "var(--ink)");
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="90" y="112" font-size="12" fill="var(--muted)">{t.divLabel}</text>
    <text x="225" y="112" text-anchor="middle" font-size="12" fill="var(--muted)">{t.quotLabel}</text>
    <text x="340" y="112" text-anchor="middle" font-size="12" fill="var(--muted)">{t.remLabel}</text>
    {rows.map((r, i) => (
      <g>
        <text x="90" y={rowY(i) + 5} font-size="15" fill="var(--ink)">{r.div}</text>
        <text x="225" y={rowY(i) + 5} text-anchor="middle" font-size="15" fill="var(--ink)">{r.q}</text>
        <rect x="322" y={remBoxY(i)} width="36" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="340" y={rowY(i) + 5} text-anchor="middle" font-size="15" fill="var(--ink)">{r.r}</text>
      </g>
    ))}

    <path d="M358 262 H372 V142 H366" fill="none" stroke="var(--accent)" stroke-width="2" />
    <polygon points="358,142 366,136 366,148" fill="var(--accent)" />
    <text x="386" y="150" font-size="12" fill="var(--ink)">{t.readOrder}</text>

    <text x="646" y="112" text-anchor="middle" font-size="12" fill="var(--muted)">{t.resultLabel}</text>
    {resBits.map((v, i) => (
      <g>
        <rect x={resX(i)} y="127" width="52" height="56" fill={resFill(v)} stroke="var(--ink)" stroke-width="2" />
        <text x={resX(i) + 26} y="163" text-anchor="middle" font-size="20" fill={resBitFill(v)}>{v}</text>
        <text x={resX(i) + 26} y="210" text-anchor="middle" font-size="14" fill="var(--muted)">{resW[i]}</text>
      </g>
    ))}
    <text x="646" y="262" text-anchor="middle" font-size="15" fill="var(--ink)">{t.sumLabel}: {backSum}</text>

    <text x="400" y="312" text-anchor="middle" font-size="14" fill="var(--ink)">{t.remLine}</text>
    <text x="400" y="350" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
