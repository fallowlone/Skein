---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One bit is one binary digit: 0 or 1 — off or on, false or true, low or high",
    headline: "ONE BIT = ONE CHOICE BETWEEN TWO",
    sub: "bit = binary digit: 0 or 1, nothing between",
    left: ["off", "false", "low"],
    right: ["on", "true", "high"],
    mid: "or",
    note: "no halfway state — firmly one of two",
    caption:
      "One bit is one binary digit — 0 or 1: off or on, false or true, low or high. A single bit is one firm choice between two possibilities, with no halfway state.",
  },
  ru: {
    svgTitle:
      "Один бит — одна двоичная цифра: 0 или 1 — выключено или включено, ложь или истина, низкий или высокий",
    headline: "ОДИН БИТ — ОДИН ВЫБОР ИЗ ДВУХ",
    sub: "бит — binary digit: 0 или 1, ничего между",
    left: ["выключено", "ложь", "низкий"],
    right: ["включено", "истина", "высокий"],
    mid: "или",
    note: "без «промежуточного» состояния — твёрдо одно из двух",
    caption:
      "Один бит — одна двоичная цифра: 0 или 1 — выключено или включено, ложь или истина, низкий или высокий уровень. Один бит — один твёрдый выбор между двумя возможностями, без «промежуточного» состояния.",
  },
};

const t = dict[lang];

const boxes = [
  { x: 150, digit: "0", words: t.left },
  { x: 450, digit: "1", words: t.right },
];

const wordYs = [238, 264, 290];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {boxes.map((b) => (
      <g>
        <rect x={b.x} y="100" width="200" height="210" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <rect x={b.x + 60} y="124" width="80" height="80" fill="var(--accent)" />
        <text x={b.x + 100} y="180" text-anchor="middle" font-size="44" fill="var(--card)">{b.digit}</text>
        {b.words.map((w, j) => (
          <text x={b.x + 100} y={wordYs[j]} text-anchor="middle" font-size="14" fill="var(--ink)">{w}</text>
        ))}
      </g>
    ))}

    <text x="400" y="205" text-anchor="middle" font-size="18" fill="var(--muted)">{t.mid}</text>

    <text x="400" y="355" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
