---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Bit 1 is true and bit 0 is false",
    headline: "1 IS TRUE · 0 IS FALSE",
    sub: "a bit is already a boolean",
    bitWord: "bit",
    stored: "true stored as 1 · false stored as 0",
    trueWord: "true",
    falseWord: "false",
    caption:
      "A boolean is true or false with nothing in between; true is stored as 1 and false as 0. Reading a bit as a truth value instead of a number changes the meaning, not what the hardware stores.",
  },
  ru: {
    svgTitle: "Бит 1 — это истина, а бит 0 — это ложь",
    headline: "1 — ИСТИНА · 0 — ЛОЖЬ",
    sub: "бит уже является булевым значением",
    bitWord: "бит",
    stored: "истина хранится как 1 · ложь хранится как 0",
    trueWord: "истина",
    falseWord: "ложь",
    caption:
      "Булево значение — это истина или ложь без промежуточных вариантов; истина хранится как 1, а ложь — как 0. Чтение бита как значения истинности вместо числа меняет смысл, а не то, что хранит аппаратура.",
  },
};

const t = dict[lang];

const cards = [
  { bit: "1", value: t.trueWord, accent: true },
  { bit: "0", value: t.falseWord, accent: false },
];

const cardW = 300;
const cardH = 190;
const cardY = 100;
const cardX = (i: number) => 60 + i * (cardW + 80);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {cards.map((c, i) => (
      <g>
        <rect x={cardX(i)} y={cardY} width={cardW} height={cardH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <rect x={cardX(i)} y={cardY} width={cardW} height="76" fill={c.accent ? "var(--accent)" : "var(--ink)"} />
        <text x={cardX(i) + cardW / 2} y={cardY + 50} text-anchor="middle" font-size="28" fill="var(--card)">{t.bitWord} {c.bit}</text>
        <text x={cardX(i) + cardW / 2} y={cardY + 142} text-anchor="middle" font-size="30" fill="var(--ink)">{c.value}</text>
      </g>
    ))}

    <text x="400" y="348" text-anchor="middle" font-size="13" fill="var(--ink)">{t.stored}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
