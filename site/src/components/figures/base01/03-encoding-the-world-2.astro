---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "ASCII maps 0 to 127 to English characters; UTF-8 keeps that range and extends it",
    headline: "ASCII: 7 BITS, 128 CHARACTERS",
    sub: "numbers 0–127 map to letters · UTF-8 keeps them and adds every script",
    asciiHead: "ASCII · 7-BIT · 0–127",
    asciiCount: "2⁷ = 128 code points",
    asciiCase: "Aa differ by 32: flip one bit",
    asciiByte: "stored in bytes · high bit 0",
    uniHead: "UNICODE + UTF-8",
    uniLen1: "0–127 → 1 byte = ASCII",
    uniLen2: "above 127 → 2, 3, 4 bytes",
    uniFirst: "first byte signals length",
    extendsLabel: "extends",
    note: "same 'A' = 65 — UTF-8 is backward-compatible with ASCII",
    caption:
      "ASCII assigns 0–127 to English letters, digits, punctuation, and control codes ('A'=65, 'Z'=90, 'a'=97, 'z'=122, '0'=48, '9'=57); upper and lower case differ by 32, one bit; bytes carry a zero high bit. Unicode gives every character a code point ('A' U+0041, 'Ж' U+0416, '😀' U+1F600); UTF-8 stores 0–127 as one byte identical to ASCII and larger code points in 2, 3, or 4 bytes, the first byte signalling the length.",
  },
  ru: {
    svgTitle: "ASCII отображает 0–127 на английские символы; UTF-8 сохраняет диапазон и расширяет его",
    headline: "ASCII: 7 БИТ, 128 СИМВОЛОВ",
    sub: "числа 0–127 отображаются на буквы · UTF-8 сохраняет их и добавляет все письменности",
    asciiHead: "ASCII · 7 БИТ · 0–127",
    asciiCount: "2⁷ = 128 кодовых позиций",
    asciiCase: "A и a отличаются на 32: один бит",
    asciiByte: "байт: старший бит = 0",
    uniHead: "UNICODE + UTF-8",
    uniLen1: "0–127 → 1 байт = ASCII",
    uniLen2: "выше 127 → 2, 3, 4 байта",
    uniFirst: "первый байт задаёт длину",
    extendsLabel: "расширяет",
    note: "'A' = 65 и там, и там — UTF-8 обратно совместим с ASCII",
    caption:
      "ASCII присваивает 0–127 английским буквам, цифрам, пунктуации и управляющим кодам ('A'=65, 'Z'=90, 'a'=97, 'z'=122, '0'=48, '9'=57); регистры отличаются на 32 — один бит; старший бит байта нулевой. Unicode даёт каждому символу кодовую позицию ('A' U+0041, 'Ж' U+0416, '😀' U+1F600); UTF-8 хранит 0–127 одним байтом, идентичным ASCII, а большие позиции — 2, 3 или 4 байтами, первый байт задаёт длину.",
  },
};

const t = dict[lang];

const codeRows = [
  { left: "'A' = 65", right: "'Z' = 90" },
  { left: "'a' = 97", right: "'z' = 122" },
  { left: "'0' = 48", right: "'9' = 57" },
];

const uniRows = ["'A' → U+0041 = 65", "'Ж' → U+0416", "'😀' → U+1F600"];

const rowY = (i: number) => 140 + i * 32;

const leftX = 40;
const panelW = 300;
const panelY = 90;
const panelH = 250;
const rightX = 460;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x={leftX} y={panelY} width={panelW} height={panelH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x={leftX} y={panelY} width={panelW} height="30" fill="var(--accent)" />
    <text x={leftX + panelW / 2} y="111" text-anchor="middle" font-size="13" fill="var(--card)">{t.asciiHead}</text>
    {codeRows.map((r, i) => (
      <g>
        <text x={leftX + 24} y={rowY(i)} font-size="13" fill="var(--ink)">{r.left}</text>
        <text x={leftX + 164} y={rowY(i)} font-size="13" fill="var(--ink)">{r.right}</text>
      </g>
    ))}
    <text x={leftX + panelW / 2} y="244" text-anchor="middle" font-size="13" fill="var(--ink)">{t.asciiCount}</text>
    <text x={leftX + panelW / 2} y="274" text-anchor="middle" font-size="13" fill="var(--ink)">{t.asciiCase}</text>
    <text x={leftX + panelW / 2} y="304" text-anchor="middle" font-size="13" fill="var(--muted)">{t.asciiByte}</text>

    <text x="400" y="205" text-anchor="middle" font-size="12" fill="var(--muted)">{t.extendsLabel}</text>
    <line x1="340" y1="215" x2="450" y2="215" stroke="var(--accent)" stroke-width="2" />
    <polygon points="450,208 450,222 460,215" fill="var(--accent)" />

    <rect x={rightX} y={panelY} width={panelW} height={panelH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x={rightX} y={panelY} width={panelW} height="30" fill="var(--accent)" />
    <text x={rightX + panelW / 2} y="111" text-anchor="middle" font-size="13" fill="var(--card)">{t.uniHead}</text>
    {uniRows.map((v, i) => (
      <text x={rightX + panelW / 2} y={rowY(i)} text-anchor="middle" font-size="13" fill="var(--ink)">{v}</text>
    ))}
    <text x={rightX + panelW / 2} y="244" text-anchor="middle" font-size="13" fill="var(--ink)">{t.uniLen1}</text>
    <text x={rightX + panelW / 2} y="274" text-anchor="middle" font-size="13" fill="var(--ink)">{t.uniLen2}</text>
    <text x={rightX + panelW / 2} y="304" text-anchor="middle" font-size="13" fill="var(--muted)">{t.uniFirst}</text>

    <text x="400" y="380" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
