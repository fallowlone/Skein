---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Transistor switch: voltage on means on and 1, no voltage means off and 0",
    headline: "TRANSISTOR: A SWITCH WITH TWO STATES",
    sub: "control-pin voltage decides: current flows or stops",
    offWord: "off",
    onWord: "on",
    controlOff: "no voltage",
    controlOn: "voltage applied",
    offSub: "remove the voltage — current stops",
    onSub: "apply voltage — current flows",
    note: "solidly on or solidly off — no halfway",
    caption:
      "A transistor is an electrically controlled switch: voltage on the control pin and current flows (on, 1); no voltage and current stops (off, 0). It is designed to be solidly on or solidly off.",
  },
  ru: {
    svgTitle: "Транзистор-переключатель: есть напряжение — включён и 1, нет — выключен и 0",
    headline: "ТРАНЗИСТОР: ДВА СОСТОЯНИЯ ПЕРЕКЛЮЧАТЕЛЯ",
    sub: "напряжение на управляющем выводе: ток течёт или останавливается",
    offWord: "выключен",
    onWord: "включён",
    controlOff: "без напряжения",
    controlOn: "напряжение подано",
    offSub: "убери напряжение — ток останавливается",
    onSub: "подай напряжение — ток потечёт",
    note: "надёжно включён или надёжно выключен",
    caption:
      "Транзистор — электрически управляемый переключатель: есть напряжение на управляющем выводе — ток течёт (включён, 1); нет напряжения — ток останавливается (выключен, 0). Он спроектирован быть надёжно включён или надёжно выключен.",
  },
};

const t = dict[lang];

const digits = ["0", "1"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="96" width="320" height="240" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="220" y="126" text-anchor="middle" font-size="16" fill="var(--ink)">{t.offWord} = {digits[0]}</text>
    <line x1="126" y1="190" x2="196" y2="190" stroke="var(--ink)" stroke-width="3" />
    <circle cx="120" cy="190" r="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <circle cx="200" cy="190" r="4" fill="var(--ink)" />
    <line x1="200" y1="190" x2="262" y2="150" stroke="var(--ink)" stroke-width="3" />
    <circle cx="300" cy="190" r="4" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <line x1="304" y1="190" x2="314" y2="190" stroke="var(--ink)" stroke-width="3" />
    <circle cx="320" cy="190" r="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <line x1="220" y1="262" x2="220" y2="222" stroke="var(--muted)" stroke-width="2" />
    <text x="220" y="284" text-anchor="middle" font-size="12" fill="var(--muted)">{t.controlOff}</text>
    <text x="220" y="310" text-anchor="middle" font-size="13" fill="var(--ink)">{t.offSub}</text>

    <rect x="420" y="96" width="320" height="240" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="580" y="126" text-anchor="middle" font-size="16" fill="var(--ink)">{t.onWord} = {digits[1]}</text>
    <line x1="486" y1="190" x2="674" y2="190" stroke="var(--ink)" stroke-width="3" />
    <circle cx="480" cy="190" r="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <circle cx="680" cy="190" r="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <line x1="640" y1="168" x2="640" y2="192" stroke="var(--ink)" stroke-width="2" />
    <line x1="540" y1="180" x2="632" y2="180" stroke="var(--accent)" stroke-width="2" />
    <polygon points="632,175 632,185 640,180" fill="var(--accent)" />
    <line x1="560" y1="262" x2="560" y2="199" stroke="var(--accent)" stroke-width="2" />
    <polygon points="554,197 566,197 560,190" fill="var(--accent)" />
    <text x="560" y="284" text-anchor="middle" font-size="12" fill="var(--muted)">{t.controlOn}</text>
    <text x="580" y="310" text-anchor="middle" font-size="13" fill="var(--ink)">{t.onSub}</text>

    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
