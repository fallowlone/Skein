---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Reading binary 01011010 by place weights: 64 + 16 + 8 + 2 = 90",
    headline: "READING BINARY: SUM THE WEIGHTS OF THE 1s",
    sub: "8-bit pattern 0 1 0 1 1 0 1 0 · weights 1, 2, 4 … 128 from right to left",
    bitLabel: "bit",
    weightLabel: "weight",
    sumLabel: "sum",
    note: "only positions holding 1 contribute — 0s are ignored",
    caption:
      "Binary 01011010: place weights shown below each bit. Highlighted bits (value 1) contribute 64 + 16 + 8 + 2 = 90.",
  },
  ru: {
    svgTitle: "Чтение двоичного 01011010 по весам: 64 + 16 + 8 + 2 = 90",
    headline: "ЧТЕНИЕ ДВОИЧНОГО ЧИСЛА: СУММИРУЙ ВЕСА ЕДИНИЦ",
    sub: "8-битный паттерн 0 1 0 1 1 0 1 0 · веса 1, 2, 4 … 128 справа налево",
    bitLabel: "бит",
    weightLabel: "вес",
    sumLabel: "сумма",
    note: "вклад вносят только позиции с 1 — 0 игнорируются",
    caption:
      "Двоичное 01011010: под каждым битом показан его весовой коэффициент. Выделенные биты (значение 1) дают 64 + 16 + 8 + 2 = 90.",
  },
};

const t = dict[lang];

const bits = ["0", "1", "0", "1", "1", "0", "1", "0"];
const weights = ["128", "64", "32", "16", "8", "4", "2", "1"];
const active = [false, true, false, true, true, false, true, false];
const sumLine = "64 + 16 + 8 + 2 = 90";

const x0 = 102;
const cw = 64;
const step = 76;
const cellX = (i: number) => x0 + i * step;
const cellFill = (i: number) => (active[i] ? "var(--accent)" : "var(--card)");
const bitFill = (i: number) => (active[i] ? "var(--card)" : "var(--ink)");
const weightFill = (i: number) => (active[i] ? "var(--accent)" : "var(--muted)");
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="90" y="180" text-anchor="end" font-size="13" fill="var(--ink)">{t.bitLabel}</text>
    <text x="90" y="238" text-anchor="end" font-size="13" fill="var(--ink)">{t.weightLabel}</text>
    {bits.map((b, i) => (
      <g>
        <rect x={cellX(i)} y="140" width={cw} height="64" fill={cellFill(i)} stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="180" text-anchor="middle" font-size="20" fill={bitFill(i)}>{b}</text>
        <text x={cellX(i) + cw / 2} y="238" text-anchor="middle" font-size="14" fill={weightFill(i)}>{weights[i]}</text>
      </g>
    ))}

    <text x="400" y="302" text-anchor="middle" font-size="17" fill="var(--ink)">{t.sumLabel}: {sumLine}</text>
    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
