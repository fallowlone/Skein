---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "XOR circuit wired from AND, OR and NOT gates",
    headline: "XOR FROM AND, OR AND NOT",
    sub: "feed the same inputs to OR and AND, invert, combine",
    gateAnd: "AND",
    gateOr: "OR",
    gateNot: "NOT",
    gateXor: "XOR",
    wAnd: "A AND B",
    wOr: "A OR B",
    wNot: "NOT(A AND B)",
    formula: "XOR = (A OR B) AND NOT(A AND B)",
    gloss: "a gate output feeds the next gate directly",
    caption:
      "XOR wired from basic gates: A and B enter an OR gate and an AND gate; the AND result passes through NOT; a final AND combines both branches. The output is one exactly when the inputs differ.",
  },
  ru: {
    svgTitle: "Схема XOR, собранная из вентилей И, ИЛИ и НЕ",
    headline: "XOR ИЗ ВЕНТИЛЕЙ И, ИЛИ И НЕ",
    sub: "одни входы — в ИЛИ и И, затем инверсия и финальное И",
    gateAnd: "И",
    gateOr: "ИЛИ",
    gateNot: "НЕ",
    gateXor: "XOR",
    wAnd: "A И B",
    wOr: "A ИЛИ B",
    wNot: "НЕ(A И B)",
    formula: "XOR = (A ИЛИ B) И НЕ(A И B)",
    gloss: "выход одного вентиля совместим со входом следующего",
    caption:
      "XOR из базовых вентилей: A и B входят в ИЛИ и И; результат И проходит через НЕ; финальное И объединяет обе ветви. Выход — единица ровно когда входы различаются.",
  },
};

const t = dict[lang];

const inputs = [
  { s: "A", cy: 140 },
  { s: "B", cy: 280 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {inputs.map((inp) => (
      <g>
        <rect x="36" y={inp.cy - 18} width="56" height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="64" y={inp.cy + 5} text-anchor="middle" font-size="15" fill="var(--ink)">{inp.s}</text>
      </g>
    ))}

    <rect x="200" y="114" width="110" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="255" y="145" text-anchor="middle" font-size="15" fill="var(--ink)">{t.gateAnd}</text>
    <rect x="200" y="254" width="110" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="255" y="285" text-anchor="middle" font-size="15" fill="var(--ink)">{t.gateOr}</text>
    <rect x="410" y="114" width="90" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="455" y="145" text-anchor="middle" font-size="15" fill="var(--ink)">{t.gateNot}</text>
    <rect x="600" y="184" width="100" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="650" y="215" text-anchor="middle" font-size="15" fill="var(--ink)">{t.gateAnd}</text>
    <rect x="726" y="184" width="60" height="52" fill="var(--accent)" />
    <text x="756" y="215" text-anchor="middle" font-size="14" fill="var(--card)">{t.gateXor}</text>

    <line x1="92" y1="132" x2="193" y2="132" stroke="var(--ink)" stroke-width="2" />
    <polygon points="193,127 193,137 200,132" fill="var(--ink)" />
    <polyline points="36,280 20,280 20,100 250,100 250,107" fill="none" stroke="var(--ink)" stroke-width="2" />
    <polygon points="245,107 255,107 250,114" fill="var(--ink)" />
    <polyline points="92,148 150,148 150,272 193,272" fill="none" stroke="var(--ink)" stroke-width="2" />
    <polygon points="193,267 193,277 200,272" fill="var(--ink)" />
    <line x1="92" y1="284" x2="193" y2="284" stroke="var(--ink)" stroke-width="2" />
    <polygon points="193,279 193,289 200,284" fill="var(--ink)" />
    <line x1="310" y1="140" x2="403" y2="140" stroke="var(--ink)" stroke-width="2" />
    <polygon points="403,135 403,145 410,140" fill="var(--ink)" />
    <polyline points="500,140 545,140 545,198 593,198" fill="none" stroke="var(--ink)" stroke-width="2" />
    <polygon points="593,193 593,203 600,198" fill="var(--ink)" />
    <polyline points="310,280 565,280 565,222 593,222" fill="none" stroke="var(--ink)" stroke-width="2" />
    <polygon points="593,217 593,227 600,222" fill="var(--ink)" />
    <line x1="700" y1="210" x2="719" y2="210" stroke="var(--ink)" stroke-width="2" />
    <polygon points="719,205 719,215 726,210" fill="var(--ink)" />

    <text x="360" y="128" text-anchor="middle" font-size="13" fill="var(--ink)">{t.wAnd}</text>
    <text x="437" y="296" text-anchor="middle" font-size="13" fill="var(--ink)">{t.wOr}</text>
    <text x="553" y="172" font-size="13" fill="var(--ink)">{t.wNot}</text>

    <text x="400" y="352" text-anchor="middle" font-size="14" fill="var(--ink)">{t.formula}</text>
    <text x="400" y="376" text-anchor="middle" font-size="13" fill="var(--muted)">{t.gloss}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
