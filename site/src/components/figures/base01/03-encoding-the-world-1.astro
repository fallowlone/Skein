---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three bytes decoded as numbers, ASCII text, and an RGB colour",
    headline: "SAME BYTES, THREE MEANINGS",
    sub: "one byte pattern · many readings · the encoding decides",
    bytesLabel: "bytes",
    panels: [
      { head: "decimal numbers", v1: "65 · 66 · 67", v2: undefined, sub: "first byte = 65" },
      { head: "ASCII text", v1: "'A' · 'B' · 'C'", v2: "A=65, B=66, C=67", sub: undefined },
      { head: "RGB colour", v1: "red=65 · green=66", v2: "blue=67", sub: "near-black grey" },
    ],
    note: "identical bytes — the reader's encoding picks the meaning",
    caption:
      "Bytes 01000001 01000010 01000011 read three ways: decimal numbers 65, 66, 67; ASCII text 'A', 'B', 'C' (A=65, B=66, C=67); RGB colour red=65, green=66, blue=67 — a near-black grey. Identical bytes; the encoding applied by the reader decides the meaning.",
  },
  ru: {
    svgTitle: "Три байта, декодированные как числа, текст ASCII и цвет RGB",
    headline: "ОДНИ БАЙТЫ — ТРИ СМЫСЛА",
    sub: "один битовый паттерн · много прочтений · решает кодировка",
    bytesLabel: "байты",
    panels: [
      { head: "десятичные числа", v1: "65 · 66 · 67", v2: undefined, sub: "первый байт = 65" },
      { head: "текст ASCII", v1: "'A' · 'B' · 'C'", v2: "A=65, B=66, C=67", sub: undefined },
      { head: "цвет RGB", v1: "красный=65 · зелёный=66", v2: "синий=67", sub: "почти чёрный" },
    ],
    note: "байты идентичны — смысл выбирает кодировка читателя",
    caption:
      "Байты 01000001 01000010 01000011 тремя способами: десятичные числа 65, 66, 67; текст ASCII 'A', 'B', 'C' (A=65, B=66, C=67); цвет RGB: красный=65, зелёный=66, синий=67 — тёмно-серый, почти чёрный. Байты идентичны; смысл решает кодировка, которую применяет читатель.",
  },
};

const t = dict[lang];

const bytes = ["01000001", "01000010", "01000011"];

const byteX = (i: number) => 155 + i * 170;
const byteW = 150;
const byteY = 80;
const byteH = 44;

const panelX = (i: number) => 50 + i * 240;
const panelW = 220;
const panelY = 190;
const panelH = 140;
const panelCX = (i: number) => panelX(i) + panelW / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="140" y="108" text-anchor="end" font-size="13" fill="var(--ink)">{t.bytesLabel}</text>
    {bytes.map((v, i) => (
      <g>
        <rect x={byteX(i)} y={byteY} width={byteW} height={byteH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={byteX(i) + byteW / 2} y="108" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <line x1="400" y1="124" x2="400" y2="150" stroke="var(--accent)" stroke-width="2" />
    <line x1="160" y1="150" x2="640" y2="150" stroke="var(--accent)" stroke-width="2" />
    <line x1="160" y1="150" x2="160" y2="180" stroke="var(--accent)" stroke-width="2" />
    <polygon points="153,180 167,180 160,190" fill="var(--accent)" />
    <line x1="400" y1="150" x2="400" y2="180" stroke="var(--accent)" stroke-width="2" />
    <polygon points="393,180 407,180 400,190" fill="var(--accent)" />
    <line x1="640" y1="150" x2="640" y2="180" stroke="var(--accent)" stroke-width="2" />
    <polygon points="633,180 647,180 640,190" fill="var(--accent)" />

    {t.panels.map((p, i) => (
      <g>
        <rect x={panelX(i)} y={panelY} width={panelW} height={panelH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <rect x={panelX(i)} y={panelY} width={panelW} height="30" fill="var(--accent)" />
        <text x={panelCX(i)} y="211" text-anchor="middle" font-size="13" fill="var(--card)">{p.head}</text>
        <text x={panelCX(i)} y="250" text-anchor="middle" font-size="13" fill="var(--ink)">{p.v1}</text>
        {p.v2 ? <text x={panelCX(i)} y="274" text-anchor="middle" font-size="13" fill="var(--ink)">{p.v2}</text> : null}
        {p.sub ? <text x={panelCX(i)} y="302" text-anchor="middle" font-size="12" fill="var(--muted)">{p.sub}</text> : null}
      </g>
    ))}

    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
