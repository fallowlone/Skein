---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "package.json branches into four dependency buckets: dependencies shipped at runtime, devDependencies for build and test only, peerDependencies provided by the host, optionalDependencies that may fail",
    headline: "FOUR BUCKETS, NOT INTERCHANGEABLE",
    sub: "who needs the package, and when",
    tagDep: "dependencies",
    tagDev: "devDependencies",
    tagPeer: "peerDependencies",
    tagOpt: "optionalDependencies",
    depEx: "pino ^9.0.0",
    depSub: "shipped at runtime to every consumer",
    devEx: "vitest ~2.1.0",
    devSub: "build + test only, omitted in production",
    peerEx: "react >=18",
    peerSub: "host app provides it, one shared copy",
    optEx: "fsevents ^2.3.0",
    optSub: "install may fail, code must guard",
    foot1: "runtime vs build-time, bundled vs host-provided",
    foot2: "required vs best-effort — pick the right bucket",
    caption:
      "The four buckets are not interchangeable: each says something different about who needs the package and when — runtime vs build-time, bundled vs host-provided, required vs best-effort.",
  },
  ru: {
    svgTitle: "package.json ветвится на четыре корзины: dependencies для рантайма, devDependencies для сборки и тестов, peerDependencies от хоста, optionalDependencies с необязательной установкой",
    headline: "ЧЕТЫРЕ КОРЗИНЫ, НЕ ВЗАИМОЗАМЕНЯЕМЫ",
    sub: "кому нужен пакет и когда",
    tagDep: "dependencies",
    tagDev: "devDependencies",
    tagPeer: "peerDependencies",
    tagOpt: "optionalDependencies",
    depEx: "pino ^9.0.0",
    depSub: "отгружается в рантайме каждому потребителю",
    devEx: "vitest ~2.1.0",
    devSub: "только сборка и тесты, не идут в прод",
    peerEx: "react >=18",
    peerSub: "предоставляет хост, единая общая копия",
    optEx: "fsevents ^2.3.0",
    optSub: "установка может упасть, код учитывает",
    foot1: "рантайм или сборка, бандл или копия хоста",
    foot2: "обязателен или по возможности — выбери корзину",
    caption:
      "Четыре корзины не взаимозаменяемы: каждая говорит своё о том, кому и когда нужен пакет — рантайм или сборка, бандл или копия хоста, обязателен или по возможности.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="118" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagDep}</text>
    <rect x="220" y="84" width="540" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="490" y="108" text-anchor="middle" font-size="12" fill="var(--ink)">{t.depEx}</text>
    <text x="490" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.depSub}</text>

    <text x="200" y="184" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagDev}</text>
    <rect x="220" y="150" width="540" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="490" y="174" text-anchor="middle" font-size="12" fill="var(--ink)">{t.devEx}</text>
    <text x="490" y="196" text-anchor="middle" font-size="11" fill="var(--ink)">{t.devSub}</text>

    <text x="200" y="250" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagPeer}</text>
    <rect x="220" y="216" width="540" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="490" y="240" text-anchor="middle" font-size="12" fill="var(--ink)">{t.peerEx}</text>
    <text x="490" y="262" text-anchor="middle" font-size="11" fill="var(--ink)">{t.peerSub}</text>

    <text x="200" y="316" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagOpt}</text>
    <rect x="220" y="282" width="540" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="490" y="306" text-anchor="middle" font-size="12" fill="var(--ink)">{t.optEx}</text>
    <text x="490" y="328" text-anchor="middle" font-size="11" fill="var(--ink)">{t.optSub}</text>

    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
