---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "How Node picks the module system per file: extension overrides everything, then the nearest package.json type field, then exports conditions",
    headline: "NODE PICKS ONE SYSTEM PER FILE",
    sub: "signals in priority order — extension first",
    step1: ".mjs → ESM / .cjs → CJS",
    step1sub: "hard override, wins outright",
    step2: '"type" in package.json',
    step2sub: "module → ESM, else CJS",
    step3: '"exports" conditions',
    step3sub: "import vs require files",
    foot1: ".js defers to the nearest package.json type",
    foot2: "exports is the public API boundary of the package",
    caption:
      "Extension is the hard override (.mjs is ESM, .cjs is CJS); plain .js defers to the nearest package.json type field; the exports field then routes import vs require to different files.",
  },
  ru: {
    svgTitle: "Как Node выбирает систему на файл: расширение перекрывает всё, затем поле type ближайшего package.json, затем условия exports",
    headline: "NODE ВЫБИРАЕТ СИСТЕМУ НА ФАЙЛ",
    sub: "сигналы по приоритету — сначала расширение",
    step1: ".mjs → ESM / .cjs → CJS",
    step1sub: "жёсткий override, решает всё",
    step2: 'поле "type" в package.json',
    step2sub: "module → ESM, иначе CJS",
    step3: 'условия "exports"',
    step3sub: "файлы import и require",
    foot1: ".js доверяется ближайшему package.json type",
    foot2: "exports — граница публичного API пакета",
    caption:
      "Расширение — жёсткий override (.mjs — ESM, .cjs — CJS); обычный .js доверяется полю type ближайшего package.json; затем поле exports разводит import и require по разным файлам.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="110" width="210" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="145" y="158" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step1}</text>
    <text x="145" y="186" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step1sub}</text>

    <text x="270" y="176" text-anchor="middle" font-size="16" fill="var(--muted)">→</text>

    <rect x="290" y="110" width="210" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="395" y="158" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step2}</text>
    <text x="395" y="186" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step2sub}</text>

    <text x="520" y="176" text-anchor="middle" font-size="16" fill="var(--muted)">→</text>

    <rect x="540" y="110" width="210" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="645" y="158" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step3}</text>
    <text x="645" y="186" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step3sub}</text>

    <rect x="120" y="270" width="260" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="250" y="302" text-anchor="middle" font-size="12" fill="var(--ink)">ESM: import / export</text>

    <rect x="420" y="270" width="260" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="550" y="302" text-anchor="middle" font-size="12" fill="var(--ink)">CJS: require()</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="385" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
