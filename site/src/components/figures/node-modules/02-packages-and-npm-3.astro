---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Caret allows minor and patch, tilde allows patch only, an exact version pins everything, star allows anything and is never safe in production",
    headline: "A RANGE IS A PROMISE, NOT A PIN",
    sub: "the operator sets the ceiling of what may enter",
    opCaret: "^1.2.3",
    opTilde: "~1.2.3",
    opExact: "1.2.3",
    opStar: "*",
    caretAllows: "allows <2.0.0",
    caretLets: "minor + patch — default, trust their semver",
    tildeAllows: "allows <1.3.0",
    tildeLets: "patch only — fixes, not features",
    exactAllows: "allows 1.2.3 only",
    exactLets: "exact pin — maximum determinism",
    starAllows: "allows any version",
    starLets: "everything incl. majors — never in prod",
    foot1: "the range sets the ceiling; the lockfile pins reality",
    foot2: "^0.x is a trap: ^0.2.3 means >=0.2.3 <0.3.0, patch only",
    caption:
      "What you write is a range, and the operator decides how much drift you accept: caret takes minor and patch, tilde takes patch only, exact pins everything, star is never safe in production — and the range is only the ceiling, the lockfile pins reality.",
  },
  ru: {
    svgTitle: "Caret пускает minor и patch, тильда — только patch, точная версия пинит всё, звёздочка пускает всё и никогда не безопасна в проде",
    headline: "ДИАПАЗОН — ОБЕЩАНИЕ, А НЕ ПИН",
    sub: "оператор задаёт потолок того, что может войти",
    opCaret: "^1.2.3",
    opTilde: "~1.2.3",
    opExact: "1.2.3",
    opStar: "*",
    caretAllows: "допускает <2.0.0",
    caretLets: "minor + patch — по умолчанию, доверяешь semver",
    tildeAllows: "допускает <1.3.0",
    tildeLets: "только patch — фиксы, не фичи",
    exactAllows: "допускает только 1.2.3",
    exactLets: "точный пин — максимум детерминизма",
    starAllows: "допускает любую версию",
    starLets: "всё, включая мажоры — никогда в проде",
    foot1: "диапазон задаёт потолок; lockfile пинит реальность",
    foot2: "^0.x — ловушка: ^0.2.3 значит >=0.2.3 <0.3.0",
    caption:
      "То, что ты пишешь, — диапазон, и оператор решает, сколько дрейфа ты принимаешь: caret берёт minor и patch, тильда — только patch, точная версия пинит всё, звёздочка никогда не безопасна в проде — а диапазон лишь потолок, реальность пинит lockfile.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="118" text-anchor="end" font-size="12" fill="var(--muted)">{t.opCaret}</text>
    <rect x="170" y="84" width="560" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="450" y="108" text-anchor="middle" font-size="12" fill="var(--ink)">{t.caretAllows}</text>
    <text x="450" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.caretLets}</text>

    <text x="150" y="184" text-anchor="end" font-size="12" fill="var(--muted)">{t.opTilde}</text>
    <rect x="170" y="150" width="560" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="450" y="174" text-anchor="middle" font-size="12" fill="var(--ink)">{t.tildeAllows}</text>
    <text x="450" y="196" text-anchor="middle" font-size="11" fill="var(--ink)">{t.tildeLets}</text>

    <text x="150" y="250" text-anchor="end" font-size="12" fill="var(--muted)">{t.opExact}</text>
    <rect x="170" y="216" width="560" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="450" y="240" text-anchor="middle" font-size="12" fill="var(--ink)">{t.exactAllows}</text>
    <text x="450" y="262" text-anchor="middle" font-size="11" fill="var(--ink)">{t.exactLets}</text>

    <text x="150" y="316" text-anchor="end" font-size="12" fill="var(--muted)">{t.opStar}</text>
    <rect x="170" y="282" width="560" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="450" y="306" text-anchor="middle" font-size="12" fill="var(--ink)">{t.starAllows}</text>
    <text x="450" y="328" text-anchor="middle" font-size="11" fill="var(--ink)">{t.starLets}</text>

    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="392" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
