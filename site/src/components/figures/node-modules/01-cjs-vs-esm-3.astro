---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The asymmetric interop seam: ESM imports CJS as default with best-effort named imports, CJS reaches ESM only via dynamic import",
    headline: "INTEROP IS ASYMMETRIC",
    sub: "and the guidance follows from it",
    esmBox: "ESM file (import)",
    cjsMod: "CJS module (module.exports)",
    okArrow: "import → default export",
    okNote: "named imports are best-effort",
    cjsBox: "CJS file (require)",
    esmMod: "ESM module (export)",
    fixArrow: "await import() → promise",
    fixNote: "require(ESM) throws ERR_REQUIRE_ESM",
    rule: "Author ESM; ship dual-package exports (import + require)",
    caption:
      "ESM can import CJS (module.exports becomes default; named imports are best-effort), but CJS cannot synchronously require ESM — use dynamic import(). Prefer ESM for new code with a deliberate exports map.",
  },
  ru: {
    svgTitle: "Асимметричный стык interop: ESM импортирует CJS как default с best-effort именами, а CJS достаёт ESM только через dynamic import",
    headline: "INTEROP АСИММЕТРИЧЕН",
    sub: "а вывод следует из асимметрии",
    esmBox: "ESM-файл (import)",
    cjsMod: "CJS-модуль (module.exports)",
    okArrow: "import → default-экспорт",
    okNote: "именованные импорты best-effort",
    cjsBox: "CJS-файл (require)",
    esmMod: "ESM-модуль (export)",
    fixArrow: "await import() → промис",
    fixNote: "require(ESM) кидает ERR_REQUIRE_ESM",
    rule: "Пиши ESM; поставляй dual-package exports (import + require)",
    caption:
      "ESM может импортировать CJS (module.exports становится default; именованные импорты best-effort), но CJS не может синхронно require ESM — используй dynamic import(). Для нового кода выбирай ESM с осознанной картой exports.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="220" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="150" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.esmBox}</text>

    <rect x="540" y="100" width="220" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="650" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cjsMod}</text>

    <text x="400" y="118" text-anchor="middle" font-size="12" fill="var(--ink)">{t.okArrow}</text>
    <text x="400" y="142" text-anchor="middle" font-size="11" fill="var(--muted)">{t.okNote}</text>

    <rect x="40" y="200" width="220" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="150" y="234" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cjsBox}</text>

    <rect x="540" y="200" width="220" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="650" y="234" text-anchor="middle" font-size="12" fill="var(--ink)">{t.esmMod}</text>

    <text x="400" y="218" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixArrow}</text>
    <text x="400" y="242" text-anchor="middle" font-size="11" fill="var(--muted)">{t.fixNote}</text>

    <rect x="100" y="300" width="600" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="334" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rule}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
