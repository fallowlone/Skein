---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Deleting require.cache or minting ESM query-string URLs is not a reload: stale holders keep the old exports so two versions run at once and orphaned instances leak — restart a fresh process instead",
    headline: "CACHE-BUSTING IS NOT A RELOAD",
    sub: "the hack breaks identity and leaks; the fix is a new process",
    leftTitle: "delete require.cache[id]",
    leftLine1: "stale holders keep old exports",
    leftLine2: "two versions live at once",
    leftLine3: "heap grows every reload",
    rightTitle: "import('./m.mjs?t=' + Date.now())",
    rightLine1: "new URL = new map entry",
    rightLine2: "entries never collected",
    rightLine3: "RSS climbs — a leak",
    doLine: "production reload = new process",
    doSub: "restart behind a supervisor, never mutate the cache",
    foot: "two hacks, one leak — restart instead",
    caption:
      "Never reload by deleting require.cache or by minting ESM query-string URLs: stale closures keep the old exports so two versions run at once, and every orphaned instance leaks. Real reload restarts a fresh process behind a supervisor — it never mutates one process's cache in place.",
  },
  ru: {
    svgTitle: "Удаление require.cache или чеканка query-строк ESM — не перезагрузка: старые держатели хранят прежний exports, две версии живут сразу, а осиротевшие экземпляры утекают — вместо этого перезапускай свежий процесс",
    headline: "СБРОС КЭША — НЕ ПЕРЕЗАГРУЗКА",
    sub: "хак ломает идентичность и утекает; лечится новым процессом",
    leftTitle: "delete require.cache[id]",
    leftLine1: "старые держатели хранят exports",
    leftLine2: "две версии живут сразу",
    leftLine3: "куча растёт с каждым разом",
    rightTitle: "import('./m.mjs?t=' + Date.now())",
    rightLine1: "новый URL — новая запись",
    rightLine2: "записи никогда не собираются",
    rightLine3: "RSS растёт — это утечка",
    doLine: "перезагрузка в проде — новый процесс",
    doSub: "рестарт под супервизором, не мутация кэша",
    foot: "два хака, одна утечка — рестартуй вместо",
    caption:
      "Не перезагружай через delete require.cache или query-строки ESM: старые замыкания держат прежний exports, так что две версии живут сразу, а каждый осиротевший экземпляр утекает. Настоящая перезагрузка рестартует свежий процесс под супервизором и никогда не мутирует кэш одного процесса на месте.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="100" width="320" height="148" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="220" y="130" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <text x="220" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine1}</text>
    <text x="220" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine2}</text>
    <text x="220" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine3}</text>

    <rect x="420" y="100" width="320" height="148" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="580" y="130" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightTitle}</text>
    <text x="580" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine1}</text>
    <text x="580" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine2}</text>
    <text x="580" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine3}</text>

    <line x1="400" y1="248" x2="400" y2="272" stroke="var(--muted)" stroke-width="2" />
    <rect x="150" y="272" width="500" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="302" text-anchor="middle" font-size="12" fill="var(--ink)">{t.doLine}</text>
    <text x="400" y="328" text-anchor="middle" font-size="11" fill="var(--muted)">{t.doSub}</text>

    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
