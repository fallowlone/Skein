---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The module cache is keyed by the resolved absolute path: the first require evaluates the file once, every later require of the same path returns the same object",
    headline: "CACHE KEY = RESOLVED ABSOLUTE PATH",
    sub: "miss evaluates once, hit returns the same object",
    callLine: 'require("./config")',
    callSub: "resolve the specifier first",
    keyLine: "key = /srv/app/config.js",
    keySub: "require.cache[key]",
    missTitle: "MISS → evaluate once",
    missLine1: "body runs a single time",
    missLine2: "cold ≈ milliseconds",
    hitTitle: "HIT → same object",
    hitLine1: "a === b → true",
    hitLine2: "hit ≈ µs · 100–1000× faster",
    foot: "first require runs the file; every later require returns the same reference",
    caption:
      "The cache is keyed by the resolved absolute path: the first require evaluates the file once (milliseconds), and every later require of the same path is a microsecond hit returning the same object reference.",
  },
  ru: {
    svgTitle: "Кэш модулей ключуется разрешённым абсолютным путём: первый require выполняет файл один раз, каждый следующий require того же пути возвращает тот же объект",
    headline: "КЛЮЧ КЭША — РАЗРЕШЁННЫЙ ПУТЬ",
    sub: "промах выполняет один раз, попадание отдаёт тот же объект",
    callLine: 'require("./config")',
    callSub: "сначала — резолв пути",
    keyLine: "key = /srv/app/config.js",
    keySub: "require.cache[key]",
    missTitle: "MISS — выполнить один раз",
    missLine1: "тело выполняется один раз",
    missLine2: "холодно ≈ миллисекунды",
    hitTitle: "HIT — тот же объект",
    hitLine1: "a === b → true",
    hitLine2: "попадание ≈ мкс · 100–1000×",
    foot: "первый require выполняет файл; остальные возвращают ту же ссылку",
    caption:
      "Кэш ключуется разрешённым абсолютным путём: первый require выполняет файл один раз (миллисекунды), а каждый следующий require того же пути — попадание за микросекунды, возвращающее ту же ссылку на объект.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="230" y="96" width="340" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="118" text-anchor="middle" font-size="12" fill="var(--ink)">{t.callLine}</text>
    <text x="400" y="139" text-anchor="middle" font-size="11" fill="var(--muted)">{t.callSub}</text>

    <line x1="400" y1="148" x2="400" y2="166" stroke="var(--muted)" stroke-width="2" />
    <rect x="180" y="166" width="440" height="58" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.keyLine}</text>
    <text x="400" y="212" text-anchor="middle" font-size="11" fill="var(--muted)">{t.keySub}</text>

    <line x1="245" y1="224" x2="245" y2="246" stroke="var(--muted)" stroke-width="2" />
    <line x1="555" y1="224" x2="555" y2="246" stroke="var(--muted)" stroke-width="2" />
    <rect x="90" y="246" width="310" height="94" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="245" y="272" text-anchor="middle" font-size="12" fill="var(--ink)">{t.missTitle}</text>
    <text x="245" y="296" text-anchor="middle" font-size="11" fill="var(--ink)">{t.missLine1}</text>
    <text x="245" y="320" text-anchor="middle" font-size="11" fill="var(--ink)">{t.missLine2}</text>

    <rect x="400" y="246" width="310" height="94" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="555" y="272" text-anchor="middle" font-size="12" fill="var(--ink)">{t.hitTitle}</text>
    <text x="555" y="296" text-anchor="middle" font-size="11" fill="var(--ink)">{t.hitLine1}</text>
    <text x="555" y="320" text-anchor="middle" font-size="11" fill="var(--ink)">{t.hitLine2}</text>

    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
