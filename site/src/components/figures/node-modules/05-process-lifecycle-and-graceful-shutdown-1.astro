---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Process exit codes as 128 plus signal number: 0 is a clean drain, 130 is SIGINT, 143 is unhandled SIGTERM, 137 is SIGKILL after the grace period",
    headline: "EXIT CODE = 128 + N CONTRACT",
    sub: "decode the code to read which signal ended the process",
    code0: "0 — clean exit",
    mean0: "loop drained on its own, nothing to call",
    tag0: "success",
    code130: "130 = 128 + 2 — SIGINT (Ctrl-C)",
    mean130: "terminal interrupt, catchable",
    tag130: "catchable",
    code143: "143 = 128 + 15 — unhandled SIGTERM",
    mean143: "polite request you ignored, catchable",
    tag143: "catchable",
    code137: "137 = 128 + 9 — SIGKILL",
    mean137: "hammer after the grace period, never a code crash",
    tag137: "hammer",
    caption:
      "Exit codes are the supervisor contract: 0 is a clean drain, 130 and 143 are caught signals decoded as 128 + N, and 137 is the SIGKILL hammer after the grace period expired.",
  },
  ru: {
    svgTitle: "Коды выхода процесса как 128 плюс номер сигнала: 0 — чистый слив, 130 — SIGINT, 143 — необработанный SIGTERM, 137 — SIGKILL после grace-периода",
    headline: "КОД ВЫХОДА = КОНТРАКТ 128 + N",
    sub: "расшифруйте код, чтобы понять, какой сигнал завершил процесс",
    code0: "0 — чистый выход",
    mean0: "цикл слился сам, вызывать ничего не надо",
    tag0: "успех",
    code130: "130 = 128 + 2 — SIGINT (Ctrl-C)",
    mean130: "терминальное прерывание, перехватываем",
    tag130: "перехват",
    code143: "143 = 128 + 15 — необработанный SIGTERM",
    mean143: "вежливая просьба без обработчика",
    tag143: "перехват",
    code137: "137 = 128 + 9 — SIGKILL",
    mean137: "молоток после grace-периода, не крах кода",
    tag137: "молоток",
    caption:
      "Код выхода — контракт с супервизором: 0 — чистый слив, 130 и 143 — сигналы по формуле 128 + N, а 137 — молоток SIGKILL после истечения grace-периода.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="92" width="680" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="90" y="117" font-size="13" fill="var(--ink)">{t.code0}</text>
    <text x="90" y="139" font-size="11" fill="var(--muted)">{t.mean0}</text>
    <text x="710" y="128" text-anchor="end" font-size="11" fill="var(--accent)">{t.tag0}</text>

    <rect x="60" y="164" width="680" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="90" y="189" font-size="13" fill="var(--ink)">{t.code130}</text>
    <text x="90" y="211" font-size="11" fill="var(--muted)">{t.mean130}</text>
    <text x="710" y="200" text-anchor="end" font-size="11" fill="var(--muted)">{t.tag130}</text>

    <rect x="60" y="236" width="680" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="90" y="261" font-size="13" fill="var(--ink)">{t.code143}</text>
    <text x="90" y="283" font-size="11" fill="var(--muted)">{t.mean143}</text>
    <text x="710" y="272" text-anchor="end" font-size="11" fill="var(--muted)">{t.tag143}</text>

    <rect x="60" y="308" width="680" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="90" y="333" font-size="13" fill="var(--ink)">{t.code137}</text>
    <text x="90" y="355" font-size="11" fill="var(--muted)">{t.mean137}</text>
    <text x="710" y="344" text-anchor="end" font-size="11" fill="var(--accent)">{t.tag137}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
