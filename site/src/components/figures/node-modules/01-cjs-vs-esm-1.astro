---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "CommonJS versus ESM: synchronous require with value-copy exports against an async static graph with live bindings",
    headline: "CJS: SYNC COPY — ESM: ASYNC LIVE GRAPH",
    sub: "one root difference: dynamic runtime resolution vs static analysis before execution",
    colCjs: "CommonJS",
    colEsm: "ESM",
    cjsSyn: "require() / module.exports",
    esmSyn: "import / export",
    cjsTime: "sync, blocking until evaluated",
    esmTime: "async graph + top-level await",
    cjsRes: "dynamic, line by line at runtime",
    esmRes: "static, hoisted before run",
    cjsSem: "value copy at require time",
    esmSem: "live read-only binding",
    cjsPath: "__dirname, __filename",
    esmPath: "import.meta.url",
    cjsShake: "no tree-shaking",
    esmShake: "tree-shakeable",
    caption:
      "CommonJS resolves require() synchronously at runtime with value-copy exports; ESM is a static, hoisted, async graph with live read-only bindings, tree-shaking, and top-level await.",
  },
  ru: {
    svgTitle: "CommonJS против ESM: синхронный require с копиями значений против асинхронного статического графа с живыми биндингами",
    headline: "CJS: SYNC-КОПИЯ — ESM: ASYNC-ГРАФ",
    sub: "корень один: динамический резолв в рантайме и статический анализ до запуска",
    colCjs: "CommonJS",
    colEsm: "ESM",
    cjsSyn: "require() / module.exports",
    esmSyn: "import / export",
    cjsTime: "синхронно, блок до выполнения",
    esmTime: "async-граф + top-level await",
    cjsRes: "динамика, построчно в рантайме",
    esmRes: "статика, поднят до запуска",
    cjsSem: "копия значения на момент require",
    esmSem: "живой read-only биндинг",
    cjsPath: "__dirname, __filename",
    esmPath: "import.meta.url",
    cjsShake: "без tree-shaking",
    esmShake: "tree-shakeable",
    caption:
      "CommonJS резолвит require() синхронно в рантайме и отдаёт копии значений; ESM — статический поднятый async-граф с живыми read-only биндингами, tree-shaking и top-level await.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="104" text-anchor="middle" font-size="14" fill="var(--ink)">{t.colCjs}</text>
    <text x="590" y="104" text-anchor="middle" font-size="14" fill="var(--ink)">{t.colEsm}</text>

    <rect x="40" y="120" width="340" height="230" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <rect x="420" y="120" width="340" height="230" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />

    <text x="210" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cjsSyn}</text>
    <text x="590" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.esmSyn}</text>

    <text x="210" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cjsTime}</text>
    <text x="590" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.esmTime}</text>

    <text x="210" y="220" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cjsRes}</text>
    <text x="590" y="220" text-anchor="middle" font-size="11" fill="var(--ink)">{t.esmRes}</text>

    <text x="210" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cjsSem}</text>
    <text x="590" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.esmSem}</text>

    <text x="210" y="288" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cjsPath}</text>
    <text x="590" y="288" text-anchor="middle" font-size="11" fill="var(--ink)">{t.esmPath}</text>

    <text x="210" y="322" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cjsShake}</text>
    <text x="590" y="322" text-anchor="middle" font-size="11" fill="var(--muted)">{t.esmShake}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
