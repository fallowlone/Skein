---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Node has two I/O paths: network sockets scale on epoll and kqueue with no threadpool, while fs, dns.lookup, crypto, and zlib share a 4-slot libuv threadpool where the fifth concurrent op queues",
    headline: "TWO I/O PATHS: SOCKETS VS POOL",
    sub: "only one of them uses the threadpool",
    tagNet: "network",
    netLine1: "sockets → epoll / kqueue in poll",
    netLine2: "no pool · 10,000 idle sockets cost nothing",
    tagPool: "pool",
    poolLine1: "fs · dns.lookup · crypto · zlib",
    poolLine2: "share 4 slots (max 1024) · 5th op queues",
    foot1: "default 4 · max 1024 · read once at startup",
    foot2: "the p99 cliff is a queue behind four threads, not a network fault",
    caption:
      "Network sockets scale on epoll/kqueue with no threadpool, so tens of thousands of idle sockets cost nothing — while fs, crypto, dns.lookup, and zlib share a 4-slot libuv threadpool where the fifth concurrent op waits for a slot.",
  },
  ru: {
    svgTitle: "У Node два пути I/O: сетевые сокеты масштабируются на epoll и kqueue без threadpool, а fs, dns.lookup, crypto и zlib делят threadpool libuv из 4 слотов, где пятая параллельная операция встаёт в очередь",
    headline: "ДВА ПУТИ I/O: СОКЕТЫ И ПУЛ",
    sub: "threadpool использует только один из них",
    tagNet: "сеть",
    netLine1: "сокеты → epoll / kqueue в фазе poll",
    netLine2: "без пула · 10 000 простаивающих стоят ничего",
    tagPool: "пул",
    poolLine1: "fs · dns.lookup · crypto · zlib",
    poolLine2: "делят 4 слота (макс. 1024) · 5-я встаёт в очередь",
    foot1: "по умолчанию 4 · максимум 1024 · читается раз при старте",
    foot2: "обрыв p99 — это очередь за четырьмя потоками, а не сбой сети",
    caption:
      "Сетевые сокеты масштабируются на epoll/kqueue без threadpool, поэтому десятки тысяч простаивающих сокетов не стоят ничего, — а fs, crypto, dns.lookup и zlib делят threadpool libuv из 4 слотов, где пятая параллельная операция ждёт слота.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagNet}</text>
    <rect x="170" y="104" width="460" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.netLine1}</text>
    <text x="400" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.netLine2}</text>

    <text x="150" y="226" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagPool}</text>
    <rect x="170" y="194" width="460" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.poolLine1}</text>
    <text x="400" y="246" text-anchor="middle" font-size="11" fill="var(--ink)">{t.poolLine2}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
