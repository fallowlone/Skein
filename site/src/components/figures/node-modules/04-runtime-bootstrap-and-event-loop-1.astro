---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "From node app.js to your first line: the binary boots the runtime, V8 isolate and context, libuv default loop, internal JS bootstrap, then your entry module runs synchronously to the end",
    headline: "FROM node app.js TO YOUR FIRST LINE",
    sub: "nothing of yours runs first",
    step1: "node binary boots runtime",
    step2: "V8 isolate + context",
    step3: "libuv default loop init",
    step4: "internal bootstrap: process, globals, loaders",
    step5: "entry module runs sync to end, then loop",
    foot1: "no async callback fires before sync code ends",
    foot2: "the loop is entered only when the call stack is empty",
    caption:
      "Between node app.js and your first line the binary boots the runtime, creates a V8 isolate and context, libuv initializes the default loop, and Node's internal bootstrap wires up process, globals, and loaders — only then does your entry module run synchronously to completion.",
  },
  ru: {
    svgTitle: "От node app.js до вашей первой строки: бинарник поднимает рантайм, изолят и контекст V8, loop libuv по умолчанию, внутренний JS-bootstrap, затем ваш входной модуль выполняется синхронно до конца",
    headline: "ОТ node app.js ДО ВАШЕЙ ПЕРВОЙ СТРОКИ",
    sub: "сначала не выполняется ничего вашего",
    step1: "бинарник node поднимает рантайм",
    step2: "изолят V8 + контекст",
    step3: "libuv: loop по умолчанию",
    step4: "внутренний bootstrap: process, глобалы, загрузчики",
    step5: "входной модуль: синхронно до конца, затем loop",
    foot1: "ни один асинхронный колбэк не срабатывает раньше конца синхронного кода",
    foot2: "в loop входят, только когда стек вызовов пуст",
    caption:
      "Между node app.js и вашей первой строкой бинарник поднимает рантайм, создаёт изолят и контекст V8, libuv инициализирует loop по умолчанию, а внутренний bootstrap Node подключает process, глобальные объекты и загрузчики — и только потом входной модуль выполняется синхронно до конца.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="180" y="117" text-anchor="end" font-size="12" fill="var(--muted)">1</text>
    <rect x="200" y="92" width="430" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="415" y="117" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step1}</text>
    <line x1="415" y1="132" x2="415" y2="146" stroke="var(--muted)" stroke-width="2" />

    <text x="180" y="171" text-anchor="end" font-size="12" fill="var(--muted)">2</text>
    <rect x="200" y="146" width="430" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="415" y="171" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step2}</text>
    <line x1="415" y1="186" x2="415" y2="200" stroke="var(--muted)" stroke-width="2" />

    <text x="180" y="225" text-anchor="end" font-size="12" fill="var(--muted)">3</text>
    <rect x="200" y="200" width="430" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="415" y="225" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step3}</text>
    <line x1="415" y1="240" x2="415" y2="254" stroke="var(--muted)" stroke-width="2" />

    <text x="180" y="279" text-anchor="end" font-size="12" fill="var(--muted)">4</text>
    <rect x="200" y="254" width="430" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="415" y="279" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step4}</text>
    <line x1="415" y1="294" x2="415" y2="308" stroke="var(--muted)" stroke-width="2" />

    <text x="180" y="333" text-anchor="end" font-size="12" fill="var(--muted)">5</text>
    <rect x="200" y="308" width="430" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="415" y="333" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step5}</text>

    <text x="400" y="376" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="399" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
