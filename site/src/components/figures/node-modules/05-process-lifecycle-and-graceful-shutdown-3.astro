---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Graceful shutdown order: flip readiness to 503, server.close to drain in-flight requests, close pools after drain, then exit below the grace period",
    headline: "SHUTDOWN ORDER: DRAIN, THEN EXIT",
    sub: "readiness first, drain in-flight, pools after drain, exit below the grace period",
    stepA: "(a)",
    stepB: "(b)",
    stepC: "(c)",
    stepD: "(d)",
    stepE: "(e)",
    a1: "readiness",
    a2: "/readyz → 503",
    a3: "LB stops routing",
    b1: "server.close()",
    b2: "stop accepting",
    b3: "NEW connections",
    c1: "drain in-flight",
    c2: "requests finish",
    c3: "loop runs dry",
    d1: "pool.end()",
    d2: "broker.close()",
    d3: "logger.flush()",
    e1: "exit 0",
    e2: "before SIGKILL",
    e3: "timeout → exit 1",
    foot1: "order is load-bearing: readiness before close, pools after drain",
    foot2: "never process.exit() mid-flight — it truncates pending I/O",
    foot3: "hard setTimeout below the grace period, or SIGKILL (137) decides",
    caption:
      "Flip readiness to 503 first, server.close() to drain in-flight, close pools only after drain, then exit — guarded by a hard timeout below the grace period; never process.exit() mid-flight.",
  },
  ru: {
    svgTitle: "Порядок graceful shutdown: выключить readiness в 503, server.close для слива запросов в полёте, пулы после слива, затем выход ниже grace-периода",
    headline: "СЛЕЙ, НЕ УБИВАЙ: ПОРЯДОК",
    sub: "сначала readiness, слив полёта, пулы после слива, выход ниже grace-периода",
    stepA: "(a)",
    stepB: "(b)",
    stepC: "(c)",
    stepD: "(d)",
    stepE: "(e)",
    a1: "readiness",
    a2: "/readyz → 503",
    a3: "снят с ротации",
    b1: "server.close()",
    b2: "стоп приёма",
    b3: "новых соединений",
    c1: "слив полёта",
    c2: "запросы — до конца",
    c3: "цикл пустеет",
    d1: "pool.end()",
    d2: "broker.close()",
    d3: "logger.flush()",
    e1: "exit 0",
    e2: "до SIGKILL",
    e3: "таймаут → exit 1",
    foot1: "порядок несущий: readiness раньше close, пулы после слива",
    foot2: "никогда process.exit() посреди полёта — он обрезает I/O",
    foot3: "жёсткий setTimeout ниже grace-периода, иначе решит SIGKILL",
    caption:
      "Сначала readiness в 503, server.close() для слива полёта, пулы только после слива, затем выход — под жёстким таймаутом ниже grace-периода; никогда process.exit() посреди полёта.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="80" y="102" text-anchor="middle" font-size="11" fill="var(--muted)">{t.stepA}</text>
    <text x="240" y="102" text-anchor="middle" font-size="11" fill="var(--muted)">{t.stepB}</text>
    <text x="400" y="102" text-anchor="middle" font-size="11" fill="var(--muted)">{t.stepC}</text>
    <text x="560" y="102" text-anchor="middle" font-size="11" fill="var(--muted)">{t.stepD}</text>
    <text x="720" y="102" text-anchor="middle" font-size="11" fill="var(--muted)">{t.stepE}</text>

    <rect x="16" y="124" width="128" height="118" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <rect x="176" y="124" width="128" height="118" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <rect x="336" y="124" width="128" height="118" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <rect x="496" y="124" width="128" height="118" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <rect x="656" y="124" width="128" height="118" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />

    <line x1="150" y1="183" x2="170" y2="183" stroke="var(--muted)" stroke-width="2" />
    <polygon points="170,177 178,183 170,189" fill="var(--muted)" />
    <line x1="310" y1="183" x2="330" y2="183" stroke="var(--muted)" stroke-width="2" />
    <polygon points="330,177 338,183 330,189" fill="var(--muted)" />
    <line x1="470" y1="183" x2="490" y2="183" stroke="var(--muted)" stroke-width="2" />
    <polygon points="490,177 498,183 490,189" fill="var(--muted)" />
    <line x1="630" y1="183" x2="650" y2="183" stroke="var(--muted)" stroke-width="2" />
    <polygon points="650,177 658,183 650,189" fill="var(--muted)" />

    <text x="80" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.a1}</text>
    <text x="80" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.a2}</text>
    <text x="80" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.a3}</text>

    <text x="240" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.b1}</text>
    <text x="240" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.b2}</text>
    <text x="240" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.b3}</text>

    <text x="400" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.c1}</text>
    <text x="400" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.c2}</text>
    <text x="400" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.c3}</text>

    <text x="560" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.d1}</text>
    <text x="560" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.d2}</text>
    <text x="560" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.d3}</text>

    <text x="720" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.e1}</text>
    <text x="720" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.e2}</text>
    <text x="720" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.e3}</text>

    <text x="400" y="300" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="326" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot3}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
