---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One libuv tick walks timers, pending, poll, check, and close in fixed order, draining each phase queue, while nextTick and Promise microtasks drain between every callback",
    headline: "ONE TICK: PHASES IN FIXED ORDER",
    sub: "microtasks cut between everything",
    phTimers: "timers",
    phTimersSub: "setTimeout",
    phPending: "pending",
    phPendingSub: "deferred sys",
    phPoll: "poll",
    phPollSub: "blocks for I/O",
    phCheck: "check",
    phCheckSub: "setImmediate",
    phClose: "close",
    phCloseSub: "on(close)",
    microLabel: "between every callback and phase",
    microLine1: "nextTick drains first, then Promise",
    microLine2: "both empty before the loop advances",
    foot1: "nextTick > Promise > setTimeout / setImmediate / I-O",
    foot2: "recursive nextTick starves poll — I/O waits forever",
    caption:
      "Each loop tick walks timers, pending, poll, check, and close in order, draining that phase's queue — and between every callback Node empties both microtask queues, nextTick first, then Promise jobs, before advancing.",
  },
  ru: {
    svgTitle: "Один тик libuv обходит timers, pending, poll, check и close в фиксированном порядке, опустошая очередь каждой фазы, а microtask'и nextTick и Promise опустошаются между каждым колбэком",
    headline: "ОДИН ТИК: ФАЗЫ В СТРОГОМ ПОРЯДКЕ",
    sub: "microtask'и врезаются между всем",
    phTimers: "timers",
    phTimersSub: "setTimeout",
    phPending: "pending",
    phPendingSub: "отложенные sys",
    phPoll: "poll",
    phPollSub: "ожидание I/O",
    phCheck: "check",
    phCheckSub: "setImmediate",
    phClose: "close",
    phCloseSub: "on(close)",
    microLabel: "между каждым колбэком и фазой",
    microLine1: "сначала опустошается nextTick, затем Promise",
    microLine2: "обе пусты, прежде чем loop продвинется",
    foot1: "nextTick > Promise > setTimeout / setImmediate / I-O",
    foot2: "рекурсивный nextTick голодит poll — I/O ждёт вечно",
    caption:
      "Каждый тик loop обходит timers, pending, poll, check и close по порядку, опустошая очередь своей фазы, — а между каждым колбэком Node опустошает обе очереди microtask'ов: сначала nextTick, затем задачи Promise, — прежде чем продвинуться.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="48" y="110" width="128" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="112" y="137" text-anchor="middle" font-size="12" fill="var(--ink)">{t.phTimers}</text>
    <text x="112" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.phTimersSub}</text>
    <line x1="178" y1="142" x2="190" y2="142" stroke="var(--muted)" stroke-width="2" />

    <rect x="192" y="110" width="128" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="256" y="137" text-anchor="middle" font-size="12" fill="var(--ink)">{t.phPending}</text>
    <text x="256" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.phPendingSub}</text>
    <line x1="322" y1="142" x2="334" y2="142" stroke="var(--muted)" stroke-width="2" />

    <rect x="336" y="110" width="128" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="137" text-anchor="middle" font-size="12" fill="var(--ink)">{t.phPoll}</text>
    <text x="400" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.phPollSub}</text>
    <line x1="466" y1="142" x2="478" y2="142" stroke="var(--muted)" stroke-width="2" />

    <rect x="480" y="110" width="128" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="544" y="137" text-anchor="middle" font-size="12" fill="var(--ink)">{t.phCheck}</text>
    <text x="544" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.phCheckSub}</text>
    <line x1="610" y1="142" x2="622" y2="142" stroke="var(--muted)" stroke-width="2" />

    <rect x="624" y="110" width="128" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="688" y="137" text-anchor="middle" font-size="12" fill="var(--ink)">{t.phClose}</text>
    <text x="688" y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.phCloseSub}</text>

    <text x="400" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.microLabel}</text>
    <rect x="48" y="214" width="704" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{t.microLine1}</text>
    <text x="400" y="259" text-anchor="middle" font-size="11" fill="var(--ink)">{t.microLine2}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
