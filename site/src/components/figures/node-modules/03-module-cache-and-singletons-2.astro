---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One resolved path is a genuine shared singleton, but a second install path forks it into two instances with split state and instanceof returning false",
    headline: "ONE PATH = SINGLETON · TWO PATHS = TWO INSTANCES",
    sub: "the cache knows file paths, not package names",
    leftHead: "ONE PATH",
    leftPath: "/srv/app/node_modules/bus.js",
    leftLine1: "one cache key",
    leftLine2: "evaluated once",
    leftLine3: "one shared EventEmitter",
    leftLine4: "instanceof → true",
    rightHead: "TWO PATHS",
    rightPath: "/…/plugin/node_modules/bus.js",
    rightLine1: "two cache keys",
    rightLine2: "two separate instances",
    rightLine3: "two event buses, split state",
    rightLine4: "instanceof → false · ~2× footprint",
    foot1: "same name, two paths — package identity is not module identity",
    foot2: "fix: npm dedupe · overrides · peerDependency → one path",
    caption:
      "One resolved path is a real shared singleton: one cache key, one EventEmitter, instanceof holds. A second install path forks it — two keys, two emitters, split state, instanceof silently false, and roughly double the footprint until dedupe collapses both keys into one.",
  },
  ru: {
    svgTitle: "Один разрешённый путь — настоящий общий синглтон, а второй путь установки раздваивает его на два экземпляра с расщеплённым состоянием и instanceof, возвращающим false",
    headline: "ОДИН ПУТЬ — СИНГЛТОН · ДВА ПУТИ — ДВА ЭКЗЕМПЛЯРА",
    sub: "кэш знает пути к файлам, а не имена пакетов",
    leftHead: "ОДИН ПУТЬ",
    leftPath: "/srv/app/node_modules/bus.js",
    leftLine1: "один ключ кэша",
    leftLine2: "выполнен один раз",
    leftLine3: "один общий EventEmitter",
    leftLine4: "instanceof → true",
    rightHead: "ДВА ПУТИ",
    rightPath: "/…/plugin/node_modules/bus.js",
    rightLine1: "два ключа кэша",
    rightLine2: "два отдельных экземпляра",
    rightLine3: "две шины событий, раскол состояния",
    rightLine4: "instanceof → false · ~2× след",
    foot1: "то же имя, два пути — пакет и модуль не одно и то же",
    foot2: "фикс: npm dedupe · overrides · peerDependency → один путь",
    caption:
      "Один разрешённый путь — настоящий общий синглтон: один ключ кэша, один EventEmitter, instanceof работает. Второй путь установки раздваивает его: два ключа, два эмиттера, расщеплённое состояние, instanceof тихо false и примерно двойной след, пока dedupe не схлопнет оба ключа в один.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="215" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftHead}</text>
    <rect x="60" y="112" width="310" height="188" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="215" y="142" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftPath}</text>
    <text x="215" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine1}</text>
    <text x="215" y="194" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine2}</text>
    <text x="215" y="220" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine3}</text>
    <text x="215" y="246" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine4}</text>
    <text x="215" y="276" text-anchor="middle" font-size="11" fill="var(--muted)">40 × require → 1 pool</text>

    <text x="585" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightHead}</text>
    <rect x="430" y="112" width="310" height="188" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="585" y="142" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightPath}</text>
    <text x="585" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine1}</text>
    <text x="585" y="194" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine2}</text>
    <text x="585" y="220" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine3}</text>
    <text x="585" y="246" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine4}</text>
    <text x="585" y="276" text-anchor="middle" font-size="11" fill="var(--muted)">npm ls / require.resolve → 2 paths</text>

    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="370" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
