---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "npm install re-solves ranges and may rewrite the lockfile; npm ci installs strictly from the lockfile, clean and deterministic",
    headline: "INSTALL RE-SOLVES, CI REPRODUCES",
    sub: "package.json declares intent, the lockfile pins reality",
    colA: "npm install",
    colB: "npm ci",
    a1: "re-solves package.json ranges",
    a2: "may rewrite the lockfile",
    a3: "patches node_modules in place",
    a4: "local dev, adding deps",
    b1: "installs strictly from the lock",
    b2: "never writes the lock",
    b3: "wipes node_modules, clean install",
    b4: "errors if lock drifted",
    b5: "CI, deploys, reproducible builds",
    foot1: "commit both files; npm install to change, npm ci to reproduce",
    foot2: "ci fails loudly on drift — that failure is a feature",
    caption:
      "npm install re-solves ranges and may rewrite the lockfile, patching node_modules in place; npm ci installs strictly from the lockfile, wipes node_modules for a clean install, and errors if the lock drifted — commit the lockfile and use npm ci in CI.",
  },
  ru: {
    svgTitle: "npm install заново решает диапазоны и может переписать lockfile; npm ci ставит строго из lockfile — чисто и детерминированно",
    headline: "INSTALL РЕШАЕТ ЗАНОВО, CI ВОСПРОИЗВОДИТ",
    sub: "package.json объявляет намерение, lockfile пинит реальность",
    colA: "npm install",
    colB: "npm ci",
    a1: "заново решает диапазоны package.json",
    a2: "может переписать lockfile",
    a3: "патчит node_modules на месте",
    a4: "локальная разработка, смена deps",
    b1: "ставит строго из lockfile",
    b2: "никогда не пишет lock",
    b3: "стирает node_modules, чистая установка",
    b4: "ошибка при дрейфе lock",
    b5: "CI, деплои, воспроизводимые сборки",
    foot1: "коммить оба файла; install — менять, ci — воспроизводить",
    foot2: "npm ci громко падает при дрейфе — и это фича",
    caption:
      "npm install заново решает диапазоны и может переписать lockfile, патча node_modules на месте; npm ci ставит строго из lockfile, стирает node_modules для чистой установки и падает с ошибкой при дрейфе lock — коммить lockfile и используй npm ci в CI.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="100" text-anchor="middle" font-size="14" fill="var(--ink)">{t.colA}</text>
    <rect x="40" y="118" width="340" height="210" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="64" y="152" font-size="11" fill="var(--ink)">{t.a1}</text>
    <text x="64" y="178" font-size="11" fill="var(--ink)">{t.a2}</text>
    <text x="64" y="204" font-size="11" fill="var(--ink)">{t.a3}</text>
    <text x="64" y="230" font-size="11" fill="var(--ink)">{t.a4}</text>

    <text x="590" y="100" text-anchor="middle" font-size="14" fill="var(--ink)">{t.colB}</text>
    <rect x="420" y="118" width="340" height="210" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="444" y="152" font-size="11" fill="var(--ink)">{t.b1}</text>
    <text x="444" y="178" font-size="11" fill="var(--ink)">{t.b2}</text>
    <text x="444" y="204" font-size="11" fill="var(--ink)">{t.b3}</text>
    <text x="444" y="230" font-size="11" fill="var(--ink)">{t.b4}</text>
    <text x="444" y="256" font-size="11" fill="var(--ink)">{t.b5}</text>

    <text x="400" y="366" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="390" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
