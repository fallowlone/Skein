---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Catchable SIGTERM and SIGINT handled with process.on against untouchable SIGKILL and SIGSTOP handled by the kernel itself",
    headline: "POLITE REQUEST vs UNSTOPPABLE KILL",
    sub: "orchestrators send signals; only some can be caught",
    colCatch: "catchable — handle it",
    sigTerm: "SIGTERM — please stop",
    sigTermSrc: "k8s / docker stop / systemd",
    sigInt: "SIGINT — Ctrl-C in dev",
    catchHow: "process.on(handler)",
    catchOut: "you shut down yourself",
    colKill: "untouchable — kernel only",
    sigKill: "SIGKILL (9) + SIGSTOP",
    killSrc: "kernel handles directly",
    killNo1: "no handler, no cleanup",
    killNo2: "no flush — the hammer",
    killOut: "finish BEFORE the deadline",
    foot: "treat SIGTERM and SIGINT identically",
    foot2: "polite SIGTERM first — unstoppable SIGKILL after the grace window",
    caption:
      "SIGTERM and SIGINT are catchable requests handled with process.on; SIGKILL and SIGSTOP are handled by the kernel itself — no handler, no cleanup — which is why shutdown has a deadline.",
  },
  ru: {
    svgTitle: "Перехватываемые SIGTERM и SIGINT через process.on против неприкасаемых SIGKILL и SIGSTOP, которые обрабатывает само ядро",
    headline: "ВЕЖЛИВАЯ ПРОСЬБА И НЕОСТАНОВИМЫЙ",
    sub: "оркестраторы шлют сигналы; ловятся лишь некоторые",
    colCatch: "перехватываемые",
    sigTerm: "SIGTERM — «пожалуйста, остановись»",
    sigTermSrc: "k8s / docker stop / systemd",
    sigInt: "SIGINT — Ctrl-C в dev",
    catchHow: "process.on(handler)",
    catchOut: "завершаетесь сами",
    colKill: "неприкасаемые — только ядро",
    sigKill: "SIGKILL (9) + SIGSTOP",
    killSrc: "ядро обрабатывает само",
    killNo1: "нет обработчика и очистки",
    killNo2: "нет сброса — молоток",
    killOut: "закончите ДО дедлайна",
    foot: "обрабатывайте SIGTERM и SIGINT одинаково",
    foot2: "сначала вежливый SIGTERM — после grace-окна неостановимый SIGKILL",
    caption:
      "SIGTERM и SIGINT — перехватываемые просьбы через process.on; SIGKILL и SIGSTOP обрабатывает само ядро — без обработчика и очистки, — поэтому у завершения есть дедлайн.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="104" text-anchor="middle" font-size="14" fill="var(--ink)">{t.colCatch}</text>
    <text x="590" y="104" text-anchor="middle" font-size="14" fill="var(--ink)">{t.colKill}</text>

    <rect x="40" y="120" width="340" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <rect x="420" y="120" width="340" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />

    <text x="210" y="154" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sigTerm}</text>
    <text x="590" y="154" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sigKill}</text>

    <text x="210" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sigTermSrc}</text>
    <text x="590" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.killSrc}</text>

    <text x="210" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sigInt}</text>
    <text x="590" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.killNo1}</text>

    <text x="210" y="256" text-anchor="middle" font-size="11" fill="var(--ink)">{t.catchHow}</text>
    <text x="590" y="256" text-anchor="middle" font-size="11" fill="var(--muted)">{t.killNo2}</text>

    <text x="210" y="290" text-anchor="middle" font-size="11" fill="var(--muted)">{t.catchOut}</text>
    <text x="590" y="290" text-anchor="middle" font-size="11" fill="var(--ink)">{t.killOut}</text>

    <text x="400" y="358" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    <text x="400" y="383" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
