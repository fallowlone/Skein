---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The same routes object through annotation, as, and satisfies: only satisfies both checks and keeps literal types",
    headline: "ONE VALUE, THREE TOOLS",
    sub: "same object checked against type Routes",
    value: '{ home: "/", profile: "/u/:id" }',
    opAnn: ": Routes",
    opAs: "as Routes",
    opSat: "satisfies Routes",
    resAnn: 'a.home: `/${string}`',
    resAnnSub: "checks, widens — literals lost",
    resAs: 'b.home: `/${string}`',
    resAsSub: "no real check — bugs slip",
    resSat: 'c.home: "/"',
    resSatSub: "checks, keeps — literals kept",
    foot: "satisfies: check + keep",
    caption:
      "The same routes object through three tools: the annotation checks but widens a.home to `/${string}`, as performs no real check so the bad value slips through, and satisfies validates while keeping c.home as the literal “/”.",
  },
  ru: {
    svgTitle: "Один и тот же объект маршрутов через аннотацию, as и satisfies: только satisfies и проверяет, и хранит литеральные типы",
    headline: "ТРИ ИНСТРУМЕНТА НА ОДНОМ ЗНАЧЕНИИ",
    sub: "один и тот же объект против типа Routes",
    value: '{ home: "/", profile: "/u/:id" }',
    opAnn: ": Routes",
    opAs: "as Routes",
    opSat: "satisfies Routes",
    resAnn: 'a.home: `/${string}`',
    resAnnSub: "расширение — литералы потеряны",
    resAs: 'b.home: `/${string}`',
    resAsSub: "нет проверки — баги проходят",
    resSat: 'c.home: "/"',
    resSatSub: "хранение — литералы сохранены",
    foot: "satisfies: проверка + сохранение",
    caption:
      "Один и тот же объект маршрутов через три инструмента: аннотация проверяет, но расширяет a.home до `/${string}`, as не делает реальной проверки, поэтому плохое значение проходит, а satisfies валидирует, сохраняя c.home как литерал «/».",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsFunctionsSatisfies-1">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="30" y="86" width="220" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="140" y="126" text-anchor="middle" font-size="11" fill="var(--ink)">{t.value}</text>

      <rect x="280" y="86" width="200" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="380" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.opAnn}</text>

      <rect x="510" y="86" width="260" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="640" y="116" text-anchor="middle" font-size="12" fill="var(--ink)">{t.resAnn}</text>
      <text x="640" y="142" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resAnnSub}</text>

      <line x1="250" y1="126" x2="272" y2="126" stroke="var(--muted)" stroke-width="2" />
      <polygon points="280,126 270,121 270,131" fill="var(--muted)" />
      <line x1="480" y1="126" x2="502" y2="126" stroke="var(--muted)" stroke-width="2" />
      <polygon points="510,126 500,121 500,131" fill="var(--muted)" />

      <rect x="30" y="186" width="220" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="140" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.value}</text>

      <rect x="280" y="186" width="200" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="380" y="226" text-anchor="middle" font-size="12" fill="var(--ink)">{t.opAs}</text>

      <rect x="510" y="186" width="260" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="640" y="216" text-anchor="middle" font-size="12" fill="var(--ink)">{t.resAs}</text>
      <text x="640" y="242" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resAsSub}</text>

      <line x1="250" y1="226" x2="272" y2="226" stroke="var(--muted)" stroke-width="2" />
      <polygon points="280,226 270,221 270,231" fill="var(--muted)" />
      <line x1="480" y1="226" x2="502" y2="226" stroke="var(--muted)" stroke-width="2" />
      <polygon points="510,226 500,221 500,231" fill="var(--muted)" />

      <rect x="30" y="286" width="220" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="140" y="326" text-anchor="middle" font-size="11" fill="var(--ink)">{t.value}</text>

      <rect x="280" y="286" width="200" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="380" y="326" text-anchor="middle" font-size="12" fill="var(--ink)">{t.opSat}</text>

      <rect x="510" y="286" width="260" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="640" y="316" text-anchor="middle" font-size="12" fill="var(--ink)">{t.resSat}</text>
      <text x="640" y="342" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resSatSub}</text>

      <line x1="250" y1="326" x2="272" y2="326" stroke="var(--muted)" stroke-width="2" />
      <polygon points="280,326 270,321 270,331" fill="var(--muted)" />
      <line x1="480" y1="326" x2="502" y2="326" stroke="var(--muted)" stroke-width="2" />
      <polygon points="510,326 500,321 500,331" fill="var(--muted)" />

      <text x="400" y="402" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
