---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Annotation types the click parameter contextually while satisfies checks after inference and leaves implicit any",
    headline: "THE TRAP: NO CONTEXTUAL TYPE",
    sub: "satisfies checks after inference, so it cannot seed parameters",
    leftTitle: "const h1: Handlers = { … }",
    leftCode: "onClick: (e) => e.clientX",
    leftFlow: "type flows inward",
    leftOut: "e: MouseEvent — ok",
    rightTitle: "const h2 = { … } satisfies Handlers",
    rightCode: "onClick: (e) => e.clientX",
    rightFlow: "checked after inference",
    rightOut: "implicit any — error",
    foot: "annotation drives inference; satisfies validates",
    caption:
      "An annotation flows the Handlers type inward so e is contextually typed as MouseEvent, while satisfies checks the already-inferred value outward and seeds nothing — e stays implicitly any and errors under noImplicitAny. Annotate when the target type must drive inference; satisfy when you want validation without losing precision.",
  },
  ru: {
    svgTitle: "Аннотация типизирует параметр клика контекстно, а satisfies проверяет после вывода и оставляет неявный any",
    headline: "ЛОВУШКА: НЕТ КОНТЕКСТНОГО ТИПА",
    sub: "satisfies проверяет после вывода, поэтому не засевает параметры",
    leftTitle: "const h1: Handlers = { … }",
    leftCode: "onClick: (e) => e.clientX",
    leftFlow: "тип протекает внутрь",
    leftOut: "e: MouseEvent — ok",
    rightTitle: "const h2 = { … } satisfies Handlers",
    rightCode: "onClick: (e) => e.clientX",
    rightFlow: "проверка после вывода",
    rightOut: "неявный any — ошибка",
    foot: "аннотация управляет выводом; satisfies валидирует",
    caption:
      "Аннотация протекает типом Handlers внутрь, поэтому e типизирован контекстно как MouseEvent, а satisfies проверяет уже выведенное значение наружу и ничего не засевает — e остаётся неявным any и ошибкой при noImplicitAny. Аннотируйте, когда целевой тип должен управлять выводом; берите satisfies, когда нужна валидация без потери точности.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsFunctionsSatisfies-3">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="40" y="86" width="340" height="180" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="210" y="118" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
      <text x="210" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftCode}</text>
      <text x="210" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftFlow}</text>
      <text x="210" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftOut}</text>

      <rect x="420" y="86" width="340" height="180" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="590" y="118" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
      <text x="590" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightCode}</text>
      <text x="590" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightFlow}</text>
      <text x="590" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightOut}</text>

      <line x1="70" y1="140" x2="70" y2="200" stroke="var(--muted)" stroke-width="2" />
      <polygon points="70,208 65,198 75,198" fill="var(--muted)" />
      <line x1="730" y1="200" x2="730" y2="140" stroke="var(--muted)" stroke-width="2" />
      <polygon points="730,132 725,142 735,142" fill="var(--muted)" />

      <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
