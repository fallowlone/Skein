<!-- TsFunctionsThis-3 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "This-based API design in three moves: this is Derived narrows the receiver as a guard, polymorphic this keeps fluent builders typed across subclasses, ThisType sets this inside object-literal method bags",
    headline: "ONE RECEIVER, THREE API TRICKS",
    sub: "guards narrow it, this returns it, ThisType<T> assembles it",
    f1Head: "this-guard",
    f1Code: "isDir(): this is DirNode",
    f1Effect: "narrows the receiver",
    f2Head: "polymorphic this",
    f2Code: "where(): this",
    f2Effect: "keeps chains typed",
    f3Head: "ThisType<T>",
    f3Code: "marker, no runtime",
    f3Effect: "this inside literals",
    arrow1: "narrows",
    arrow2: "chains",
    arrow3: "fills this",
    m1Code: "if (node.isDir()) …",
    m1Sub: "node: DirNode inside",
    m2Code: ".where().byEmail()",
    m2Sub: "still UserQuery",
    m3Code: "options + mixins",
    m3Sub: "this = whole object",
    note: "one fake parameter buys receiver safety; three tricks model real APIs",
    resultLine: "guard narrows · this chains · ThisType assembles",
    moral: "none of them exists at runtime",
    caption:
      "This-based API design in three moves: this is Derived narrows the receiver as a guard, polymorphic this keeps fluent builders typed across subclasses, and ThisType<T> sets this inside object-literal method bags — all erased, none at runtime.",
  },
  ru: {
    svgTitle: "This-дизайн API в трёх приёмах: this is Derived сужает получателя как гард, полиморфный this держит fluent-билдеры типизированными при наследовании, ThisType задаёт this внутри объектных литералов с наборами методов",
    headline: "ОДИН ПОЛУЧАТЕЛЬ — ТРИ ПРИЁМА API",
    sub: "гарды его сужают, this его возвращает, ThisType<T> его собирает",
    f1Head: "this-гард типа",
    f1Code: "isDir(): this is DirNode",
    f1Effect: "сужает получателя",
    f2Head: "полиморфный this",
    f2Code: "where(): this",
    f2Effect: "держит цепочки типизированными",
    f3Head: "ThisType<T>",
    f3Code: "маркер без рантайма",
    f3Effect: "this внутри литералов",
    arrow1: "сужает",
    arrow2: "цепочка",
    arrow3: "задаёт this",
    m1Code: "if (node.isDir()) …",
    m1Sub: "node: DirNode внутри",
    m2Code: ".where().byEmail()",
    m2Sub: "всё ещё UserQuery",
    m3Code: "options + миксины",
    m3Sub: "this — весь объект",
    note: "один фейковый параметр даёт безопасность получателя; три приёма моделируют реальные API",
    resultLine: "гард сужает · this продолжает цепь · ThisType собирает",
    moral: "ни одного из них нет в рантайме",
    caption:
      "This-дизайн API в трёх приёмах: this is Derived сужает получателя как гард, полиморфный this держит fluent-билдеры типизированными при наследовании, а ThisType<T> задаёт this внутри объектных литералов с наборами методов — всё стирается, ничего нет в рантайме.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsFunctionsThis-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="88" width="230" height="112" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="135" y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.f1Head}</text>
    <text x="135" y="144" text-anchor="middle" font-size="12" fill="var(--accent)">{t.f1Code}</text>
    <text x="135" y="170" text-anchor="middle" font-size="12" fill="var(--muted)">{t.f1Effect}</text>

    <rect x="285" y="88" width="230" height="112" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="400" y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.f2Head}</text>
    <text x="400" y="144" text-anchor="middle" font-size="12" fill="var(--accent)">{t.f2Code}</text>
    <text x="400" y="170" text-anchor="middle" font-size="12" fill="var(--muted)">{t.f2Effect}</text>

    <rect x="550" y="88" width="230" height="112" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="665" y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.f3Head}</text>
    <text x="665" y="144" text-anchor="middle" font-size="12" fill="var(--accent)">{t.f3Code}</text>
    <text x="665" y="170" text-anchor="middle" font-size="12" fill="var(--muted)">{t.f3Effect}</text>

    <line x1="135" y1="200" x2="135" y2="232" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsFunctionsThis-3)" />
    <text x="147" y="222" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrow1}</text>

    <line x1="400" y1="200" x2="400" y2="232" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsFunctionsThis-3)" />
    <text x="412" y="222" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrow2}</text>

    <line x1="665" y1="200" x2="665" y2="232" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsFunctionsThis-3)" />
    <text x="677" y="222" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrow3}</text>

    <rect x="20" y="232" width="230" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="135" y="258" text-anchor="middle" font-size="12" fill="var(--ink)">{t.m1Code}</text>
    <text x="135" y="278" text-anchor="middle" font-size="12" fill="var(--muted)">{t.m1Sub}</text>

    <rect x="285" y="232" width="230" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="258" text-anchor="middle" font-size="12" fill="var(--ink)">{t.m2Code}</text>
    <text x="400" y="278" text-anchor="middle" font-size="12" fill="var(--muted)">{t.m2Sub}</text>

    <rect x="550" y="232" width="230" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="665" y="258" text-anchor="middle" font-size="12" fill="var(--ink)">{t.m3Code}</text>
    <text x="665" y="278" text-anchor="middle" font-size="12" fill="var(--muted)">{t.m3Sub}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>

    <rect x="20" y="332" width="760" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="360" text-anchor="middle" font-size="15" fill="var(--accent)">{t.resultLine}</text>

    <text x="400" y="402" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
