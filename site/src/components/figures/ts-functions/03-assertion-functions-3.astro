---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "two assertion unsoundness traps: a missing asserts annotation narrows nothing, an unchecked body lies to the compiler",
    headline: "TWO TRAPS: SILENT void AND UNCHECKED BODY",
    sub: "the compiler checks the shape — never the truth",
    tagLeft: "trap 1 — annotation omitted",
    boxLeftTitle: "assertNum(x: unknown)",
    boxLeftLine1: "inferred return: void",
    boxLeftLine2: "x stays unknown — silent",
    boxLeftFoot: "mandatory, never inferred",
    tagRight: "trap 2 — body never checked",
    boxRightTitle: "brokenAssert: asserts x is string",
    boxRightLine1: "forgot to throw — does nothing",
    boxRightLine2: "compiler: string · runtime: crash",
    boxRightFoot: "taken on faith — a lie crashes",
    foot1: "keep assertions tiny and obviously-throwing, in a small audited core",
    foot2: "let validation libraries (Zod et al.) generate them — throw cannot drift from type",
    caption:
      "Omit : asserts … and the function is plain void that narrows nothing, silently; write a body that never throws and the compiler still believes the claim until it crashes at runtime.",
  },
  ru: {
    svgTitle: "две ловушки ненадёжности утверждений: пропущенная аннотация asserts ничего не сужает, непроверенное тело лжёт компилятору",
    headline: "ДВЕ ЛОВУШКИ: МОЛЧАЛИВЫЙ void И НЕПРОВЕРЕННОЕ ТЕЛО",
    sub: "компилятор проверяет форму — никогда истинность",
    tagLeft: "ловушка 1 — аннотация опущена",
    boxLeftTitle: "assertNum(x: unknown)",
    boxLeftLine1: "выведенный возврат: void",
    boxLeftLine2: "x остаётся unknown — молча",
    boxLeftFoot: "обязательна, никогда не выводится",
    tagRight: "ловушка 2 — тело не проверяется",
    boxRightTitle: "brokenAssert: asserts x is string",
    boxRightLine1: "забыли выбросить — ничего не делает",
    boxRightLine2: "компилятор: string · рантайм: краш",
    boxRightFoot: "на веру — ложь крашится",
    foot1: "держите утверждения крошечными и очевидно-выбрасывающими, в малом проверенном ядре",
    foot2: "генерируйте их библиотеками валидации (Zod и др.) — выброс не разъедется с типом",
    caption:
      "Опустите : asserts … — и функция станет обычным void, который молча ничего не сужает; напишите тело, которое не выбрасывает, — и компилятор всё равно поверит утверждению, пока оно не крашнется в рантайме.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsFunctionsAsserts-3" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftTitle}</text>
    <text x="205" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine1}</text>
    <text x="205" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine2}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxLeftFoot}</text>

    <line x1="400" y1="126" x2="400" y2="316" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 6" />

    <text x="595" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightTitle}</text>
    <text x="595" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine1}</text>
    <text x="595" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine2}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxRightFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
