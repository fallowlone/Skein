---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Overload resolution is top-down first-match: pick('a') binds to the first signature that accepts it, so a general signature above a specific one shadows it",
    headline: "FIRST MATCH WINS — ORDER IS LOAD-BEARING",
    sub: "the compiler walks overloads from the top and stops at the first that fits",
    tagLeft: "specific first — correct",
    tagRight: "general first — shadowed",
    left1: "pick(x: 'a'): 1",
    left2: "pick(x: string): 2",
    left3: "pick('a') binds 1",
    gapLeft1: "no match? try next",
    gapLeft2: "match — stop",
    right1: "pick(x: string): 2",
    right2: "pick(x: 'a'): 1 — dead",
    right3: "pick('a') binds 2",
    gapRight1: "matches at once",
    gapRight2: "never reached",
    foot1: "specific signatures must sit above general ones or they become unreachable",
    foot2: "no overload fits: the compiler reports No overload matches this call",
    caption:
      "The compiler tries overload signatures top-to-bottom and binds the first match: pick('a') resolves to 1 only when the literal overload sits above the general string one.",
  },
  ru: {
    svgTitle: "Разрешение перегрузок — первое совпадение сверху вниз: pick('a') связывается с первой подходящей сигнатурой, поэтому общая сигнатура над специфичной затеняет её",
    headline: "ПОБЕЖДАЕТ ПЕРВОЕ СОВПАДЕНИЕ — ПОРЯДОК РЕШАЕТ",
    sub: "компилятор идёт по перегрузкам сверху вниз и останавливается на первой подходящей",
    tagLeft: "специфичная выше — верно",
    tagRight: "общая выше — затенение",
    left1: "pick(x: 'a'): 1",
    left2: "pick(x: string): 2",
    left3: "pick('a') связывается с 1",
    gapLeft1: "не совпало? дальше",
    gapLeft2: "совпало — стоп",
    right1: "pick(x: string): 2",
    right2: "pick(x: 'a'): 1 — мертва",
    right3: "pick('a') связывается с 2",
    gapRight1: "совпало сразу",
    gapRight2: "недостижима",
    foot1: "специфичные сигнатуры ставьте выше общих, иначе они становятся недостижимыми",
    foot2: "ничего не подошло: компилятор сообщает No overload matches this call",
    caption:
      "Компилятор пробует сигнатуры перегрузки сверху вниз и связывает с первой подходящей: pick('a') разрешается в 1, только если литеральная перегрузка стоит над общей строковой.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="40" y="110" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="200" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="200" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapLeft1}</text>
    <rect x="40" y="205" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="200" y="241" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="200" y="283" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapLeft2}</text>
    <rect x="40" y="300" width="320" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="336" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left3}</text>

    <text x="600" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="440" y="110" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="600" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapRight1}</text>
    <rect x="440" y="205" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="8 5" />
    <text x="600" y="241" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="600" y="283" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapRight2}</text>
    <rect x="440" y="300" width="320" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="336" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right3}</text>

    <text x="400" y="388" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="410" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
