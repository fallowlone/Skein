---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "two assertion signatures: asserts condition and asserts x is string, both void-returning",
    headline: "TWO SHAPES, BOTH ASSERTS",
    sub: "void-returning function · return type asserts … (TypeScript 3.7)",
    tagLeft: "form 1 — asserts a condition",
    boxLeftTitle: "assert(cond, msg?)",
    boxLeftLine: "asserts condition",
    boxLeftLine2: "if (!condition) throw",
    boxLeftFoot: "condition true past the call",
    tagMid: "form 2 — asserts a type",
    boxMidTitle: "assertIsString(x)",
    boxMidLine: "asserts x is string",
    boxMidLine2: "typeof x !== string → throw",
    boxMidFoot: "x: string for the rest of scope",
    tagRight: "contract — return means held",
    boxRightTitle: "control-flow promise",
    boxRightLine1: "returns normally ⇒ held",
    boxRightLine2: "other exit ⇒ throw",
    boxRightFoot: "no branch needed after",
    foot1: "the annotation is never inferred — the compiler trusts the shape",
    foot2: "assertDefined(url): no branch, no ! — url is string below the call",
    caption:
      "Form 1 asserts a condition is true; form 2 asserts a value has a type. Both promise the compiler: if the call returns normally, the claim held — throwing is the only other exit.",
  },
  ru: {
    svgTitle: "две сигнатуры-утверждения: asserts condition и asserts x is string, обе возвращают void",
    headline: "ДВЕ ФОРМЫ, ОБЕ ЧЕРЕЗ ASSERTS",
    sub: "функция возвращает void · тип возврата asserts … (TypeScript 3.7)",
    tagLeft: "форма 1 — утверждает условие",
    boxLeftTitle: "assert(cond, msg?)",
    boxLeftLine: "asserts condition",
    boxLeftLine2: "if (!condition) throw",
    boxLeftFoot: "условие истинно дальше",
    tagMid: "форма 2 — утверждает тип",
    boxMidTitle: "assertIsString(x)",
    boxMidLine: "asserts x is string",
    boxMidLine2: "typeof x !== string → throw",
    boxMidFoot: "x: string на остаток области",
    tagRight: "контракт — возврат значит выполнено",
    boxRightTitle: "обещание потоку управления",
    boxRightLine1: "вернулась ⇒ выполнено",
    boxRightLine2: "другой выход ⇒ throw",
    boxRightFoot: "ветка после не нужна",
    foot1: "аннотация никогда не выводится — компилятор доверяет форме",
    foot2: "assertDefined(url): ни ветки, ни ! — ниже вызова url это string",
    caption:
      "Форма 1 утверждает, что условие истинно; форма 2 — что значение имеет тип. Обе обещают компилятору: если вызов вернулся нормально, утверждение выполнилось — выброс исключения единственный другой выход.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsFunctionsAsserts-2" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="145" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="40" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="145" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftTitle}</text>
    <text x="145" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine}</text>
    <text x="145" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine2}</text>
    <text x="145" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxLeftFoot}</text>

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagMid}</text>
    <rect x="295" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxMidTitle}</text>
    <text x="400" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxMidLine}</text>
    <text x="400" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxMidLine2}</text>
    <text x="400" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxMidFoot}</text>

    <text x="655" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="550" y="126" width="210" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="655" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightTitle}</text>
    <text x="655" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine1}</text>
    <text x="655" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine2}</text>
    <text x="655" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxRightFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
