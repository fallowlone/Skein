<!-- TsFunctionsThis-1 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The fake first parameter: describe(this: Card) type-checks the receiver at each call site, then the annotation is erased at emit",
    headline: "TYPED AT THE CALL, GONE AT EMIT",
    sub: "this: Card is a fake parameter — never passed, only checked",
    srcHead: "source",
    srcSub: "describe(this: Card): string",
    arrowErase: "erased",
    emitHead: "emitted JS",
    emitSub: "function describe() { … }",
    arrowCheck1: "checked",
    arrowCheck2: "checked",
    okHead: "describe.call(card)",
    okSub: "ok — receiver supplied",
    errHead: "describe()",
    errSub: "error — this: void not assignable",
    note: "one annotation guards every call site, then vanishes",
    resultLine: "this: T checks the receiver — then is erased at emit",
    moral: "never in the argument list, always at the call site",
    caption:
      "describe(this: Card) types the call-time receiver: describe.call(card) passes the check, a bare describe() fails it, and the emitted JavaScript contains no trace of the annotation.",
  },
  ru: {
    svgTitle: "Фейковый первый параметр: describe(this: Card) проверяет получателя в каждой точке вызова, затем аннотация стирается при эмите",
    headline: "ТИПИЗИРОВАН ПРИ ВЫЗОВЕ, СТЁРТ ПРИ ЭМИТЕ",
    sub: "this: Card — фейковый параметр: не передаётся, только проверяется",
    srcHead: "исходник",
    srcSub: "describe(this: Card): string",
    arrowErase: "стирается",
    emitHead: "эмит JS",
    emitSub: "function describe() { … }",
    arrowCheck1: "проверено",
    arrowCheck2: "проверено",
    okHead: "describe.call(card)",
    okSub: "ok — получатель подан",
    errHead: "describe()",
    errSub: "ошибка — this: void не присваиваем",
    note: "одна аннотация сторожит каждую точку вызова, затем исчезает",
    resultLine: "this: T проверяет получателя — затем стирается при эмите",
    moral: "никогда в списке аргументов, всегда в точке вызова",
    caption:
      "describe(this: Card) типизирует получателя на момент вызова: describe.call(card) проходит проверку, голый describe() её проваливает, а в сэмиттированном JavaScript от аннотации нет следа.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsFunctionsThis-1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="300" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="190" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.srcHead}</text>
    <text x="190" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.srcSub}</text>

    <line x1="340" y1="140" x2="460" y2="140" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsFunctionsThis-1)" />
    <text x="400" y="122" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowErase}</text>

    <rect x="460" y="100" width="300" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.emitHead}</text>
    <text x="610" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.emitSub}</text>

    <line x1="190" y1="180" x2="190" y2="210" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsFunctionsThis-1)" />
    <text x="202" y="202" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrowCheck1}</text>

    <line x1="590" y1="180" x2="590" y2="210" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsFunctionsThis-1)" />
    <text x="602" y="202" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrowCheck2}</text>

    <rect x="40" y="210" width="300" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="190" y="238" text-anchor="middle" font-size="13" fill="var(--ink)">{t.okHead}</text>
    <text x="190" y="260" text-anchor="middle" font-size="12" fill="var(--muted)">{t.okSub}</text>

    <rect x="460" y="210" width="300" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="610" y="238" text-anchor="middle" font-size="13" fill="var(--ink)">{t.errHead}</text>
    <text x="610" y="260" text-anchor="middle" font-size="12" fill="var(--muted)">{t.errSub}</text>

    <text x="400" y="310" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>

    <rect x="40" y="324" width="720" height="48" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="354" text-anchor="middle" font-size="15" fill="var(--accent)">{t.resultLine}</text>

    <text x="400" y="400" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
