---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Lost this: c.inc() is fine, but const f = c.inc detaches the method so f() fails the this-parameter check — fix with .bind or an arrow field",
    headline: "DETACH THE METHOD, LOSE THE RECEIVER",
    sub: "binding follows the call, not the definition",
    leftHead: "c.inc()",
    leftSub: "receiver is c",
    leftTag: "ok",
    arrowDetach: "detach",
    midHead: "const f = c.inc; f()",
    midSub: "this: void vs this: Counter",
    midTag: "error — binding lost",
    arrowFix1: "rebind",
    arrowFix2: "capture",
    fix1Head: "c.inc.bind(c)",
    fix1Sub: "rebind explicitly",
    fix2Head: "inc = () => { … }",
    fix2Sub: "captures the instance",
    note: "the compiler flags the unbound call before it crashes at runtime",
    resultLine: "this: void is not assignable to this: Counter",
    moral: "fix it with .bind(c) or an arrow-function field",
    caption:
      "c.inc() passes because the receiver is c, but the detached f() supplies this: void and fails the this-parameter check; rebind with .bind(c) or capture the instance with an arrow-function field.",
  },
  ru: {
    svgTitle: "Потерянный this: c.inc() в порядке, но const f = c.inc отделяет метод, и f() проваливает проверку this-параметра — фикс через .bind или стрелочное поле",
    headline: "ОТДЕЛИЛ МЕТОД — ПОТЕРЯЛ ПОЛУЧАТЕЛЯ",
    sub: "привязка следует за вызовом, а не за определением",
    leftHead: "c.inc()",
    leftSub: "получатель — c",
    leftTag: "ok",
    arrowDetach: "отделён",
    midHead: "const f = c.inc; f()",
    midSub: "this: void ≠ this: Counter",
    midTag: "ошибка — привязка потеряна",
    arrowFix1: ".bind",
    arrowFix2: "захват",
    fix1Head: "c.inc.bind(c)",
    fix1Sub: "переназначить явно",
    fix2Head: "inc = () => { … }",
    fix2Sub: "захватывает экземпляр",
    note: "компилятор помечает несвязанный вызов до краха в рантайме",
    resultLine: "this: void не присваиваем this: Counter",
    moral: "фикс — .bind(c) или стрелочное поле-функция",
    caption:
      "c.inc() проходит, потому что получатель — c, а отделённый f() подаёт this: void и проваливает проверку this-параметра; переназначьте через .bind(c) или захватите экземпляр стрелочным полем-функцией.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsFunctionsThis-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="100" width="200" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="130" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftHead}</text>
    <text x="130" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftSub}</text>
    <text x="130" y="180" text-anchor="middle" font-size="12" fill="var(--accent)">{t.leftTag}</text>

    <line x1="230" y1="150" x2="300" y2="150" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsFunctionsThis-2)" />
    <text x="265" y="132" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowDetach}</text>

    <rect x="300" y="100" width="200" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="130" text-anchor="middle" font-size="12" fill="var(--ink)">{t.midHead}</text>
    <text x="400" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.midSub}</text>
    <text x="400" y="180" text-anchor="middle" font-size="12" fill="var(--accent)">{t.midTag}</text>

    <line x1="500" y1="135" x2="570" y2="120" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsFunctionsThis-2)" />
    <text x="535" y="110" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowFix1}</text>

    <line x1="500" y1="165" x2="570" y2="190" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsFunctionsThis-2)" />
    <text x="535" y="200" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowFix2}</text>

    <rect x="570" y="85" width="200" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="670" y="113" text-anchor="middle" font-size="13" fill="var(--ink)">{t.fix1Head}</text>
    <text x="670" y="135" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fix1Sub}</text>

    <rect x="570" y="175" width="200" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="670" y="203" text-anchor="middle" font-size="13" fill="var(--ink)">{t.fix2Head}</text>
    <text x="670" y="225" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fix2Sub}</text>

    <text x="400" y="285" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>

    <rect x="30" y="300" width="740" height="55" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="334" text-anchor="middle" font-size="15" fill="var(--accent)">{t.resultLine}</text>

    <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
