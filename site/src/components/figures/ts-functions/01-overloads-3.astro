<!-- TsFunctionsOverloads-3 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Overloads versus generic versus conditional return: discrete irregular mappings take overloads, uniform mappings take one generic, rule-based mappings take a conditional return",
    headline: "THE MAPPING SHAPE PICKS THE TOOL",
    sub: "discrete + irregular: overloads — uniform: generic — rule-based: conditional return",
    tag1: "1 · discrete + irregular",
    box1line1: "createElement('a')",
    box1line2: "HTMLAnchorElement",
    box1line3: "overloads fit",
    tag2: "2 · uniform",
    box2line1: "wrap<T>(x: T): T[]",
    box2line2: "relates in/out once",
    box2line3: "takes unions free",
    tag3: "3 · rule-based on type",
    box3line1: "T extends string ? A : B",
    box3line2: "output follows a rule",
    box3line3: "composes, stays sound",
    foot1: "wrapO(u: string | number): No overload matches — a union fits no single overload",
    foot2: "wrap(u): (string | number)[] — the generic handles the union for free",
    caption:
      "Reach for overloads only for discrete, irregular input-to-output mappings; a uniform mapping wants one generic and a rule-based mapping wants a conditional return.",
  },
  ru: {
    svgTitle: "Перегрузки против дженерика против условного возврата: дискретные нерегулярные отображения берут перегрузки, однородные — один дженерик, по правилу над типом — условный возврат",
    headline: "ФОРМА ОТОБРАЖЕНИЯ ВЫБИРАЕТ ИНСТРУМЕНТ",
    sub: "дискретное + нерегулярное: перегрузки — однородное: дженерик — по правилу: условный возврат",
    tag1: "1 · дискретное + нерегулярное",
    box1line1: "createElement('a')",
    box1line2: "HTMLAnchorElement",
    box1line3: "перегрузки подходят",
    tag2: "2 · однородное",
    box2line1: "wrap<T>(x: T): T[]",
    box2line2: "связывает вход/выход раз",
    box2line3: "объединения даром",
    tag3: "3 · по правилу над типом",
    box3line1: "T extends string ? A : B",
    box3line2: "выход следует правилу",
    box3line3: "композируется, надёжен",
    foot1: "wrapO(u: string | number): No overload matches — объединение не подходит ни одной",
    foot2: "wrap(u): (string | number)[] — дженерик справляется с объединением даром",
    caption:
      "Беритесь за перегрузки только для дискретных нерегулярных отображений входа в выход; однородному нужен один дженерик, а по правилу над типом — условный возврат.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="142" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="32" y="120" width="220" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="142" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line1}</text>
    <text x="142" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line2}</text>
    <text x="142" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box1line3}</text>

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="290" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line1}</text>
    <text x="400" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line2}</text>
    <text x="400" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box2line3}</text>

    <text x="658" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="548" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="658" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line1}</text>
    <text x="658" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line2}</text>
    <text x="658" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box3line3}</text>

    <text x="400" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
