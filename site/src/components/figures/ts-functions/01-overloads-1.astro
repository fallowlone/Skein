---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Anatomy of an overload: two public call signatures over one hidden implementation signature that callers can never call",
    headline: "N SIGNATURES, ONE BODY — IMPL STAYS HIDDEN",
    sub: "call signatures are the public contract — the impl signature types only the body",
    tag1: "1 · public call signature",
    box1line1: "len(x: string): number",
    box1line2: "callers see it",
    box1line3: "callable",
    tag2: "2 · public call signature",
    box2line1: "len(x: unknown[]): number",
    box2line2: "callers see it",
    box2line3: "callable",
    tag3: "3 · impl signature — hidden",
    box3line1: "len(x: string | unknown[])",
    box3line2: "body checks against it",
    box3line3: "never callable",
    foot1: "len(123) fails: No overload matches this call — the impl is invisible to callers",
    foot2: "widen the impl to cover every overload, keep it narrower than callers may use",
    caption:
      "An overload is N public call signatures over one private implementation signature: callers can only call the overloads, the body type-checks against the impl.",
  },
  ru: {
    svgTitle: "Анатомия перегрузки: две публичные сигнатуры вызова над одной скрытой сигнатурой реализации, которую вызывающие никогда не вызывают",
    headline: "N СИГНАТУР, ОДНО ТЕЛО — РЕАЛИЗАЦИЯ СКРЫТА",
    sub: "сигнатуры вызова — публичный контракт, сигнатура реализации типизирует только тело",
    tag1: "1 · публичная сигнатура вызова",
    box1line1: "len(x: string): number",
    box1line2: "видят вызывающие",
    box1line3: "вызывается",
    tag2: "2 · публичная сигнатура вызова",
    box2line1: "len(x: unknown[]): number",
    box2line2: "видят вызывающие",
    box2line3: "вызывается",
    tag3: "3 · сигнатура реализации — скрыта",
    box3line1: "len(x: string | unknown[])",
    box3line2: "тело проверяется против неё",
    box3line3: "никогда не вызывается",
    foot1: "len(123) падает: No overload matches this call — реализация невидима вызывающим",
    foot2: "расширьте реализацию под каждую перегрузку, держите её уже, чем видят вызывающие",
    caption:
      "Перегрузка — это N публичных сигнатур вызова над одной приватной сигнатурой реализации: вызывающие вызывают только перегрузки, тело проверяется против реализации.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="142" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="32" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="142" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line1}</text>
    <text x="142" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1line2}</text>
    <text x="142" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box1line3}</text>

    <text x="400" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="290" y="120" width="220" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line1}</text>
    <text x="400" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2line2}</text>
    <text x="400" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box2line3}</text>

    <text x="658" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="548" y="120" width="220" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" stroke-dasharray="8 5" />
    <text x="658" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line1}</text>
    <text x="658" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3line2}</text>
    <text x="658" y="218" text-anchor="middle" font-size="12" fill="var(--accent)">{t.box3line3}</text>

    <text x="400" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
