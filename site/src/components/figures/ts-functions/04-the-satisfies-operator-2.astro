---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Palette checked against Record Color constraint: completeness enforced and tuple types kept precise",
    headline: "COMPLETENESS CHECKED, PRECISION KEPT",
    sub: "constraint validates shape, inferred type keeps tuples",
    constraintTitle: "Record<Color, [number, number, number]>",
    constraintSub: 'Color = "red" | "green" | "blue"',
    paletteTitle: "palette satisfies the constraint",
    paletteRow: "red / green / blue: [255, 0, 0] …",
    missTitle: "key dropped",
    missRow1: "Property 'blue' is missing",
    keepTitle: "palette.red",
    keepRow1: "[number, number, number]",
    foot: "constraint checks, inference keeps",
    caption:
      "The palette is checked against Record<Color, [number, number, number]>: dropping a key is a completeness error, while palette.red keeps its tuple type [number, number, number] instead of widening to number[] — the constraint validates, the inferred type preserves.",
  },
  ru: {
    svgTitle: "Палитра против ограничения Record Color: полнота проверяется, а типы-кортежи остаются точными",
    headline: "ПОЛНОТА ПРОВЕРЕНА, ТОЧНОСТЬ СОХРАНЕНА",
    sub: "ограничение валидирует форму, выведенный тип хранит кортежи",
    constraintTitle: "Record<Color, [number, number, number]>",
    constraintSub: 'Color = "red" | "green" | "blue"',
    paletteTitle: "palette проходит проверку ограничением",
    paletteRow: "red / green / blue: [255, 0, 0] …",
    missTitle: "ключ убран",
    missRow1: "Property 'blue' is missing",
    keepTitle: "palette.red",
    keepRow1: "[number, number, number]",
    foot: "ограничение проверяет, вывод хранит",
    caption:
      "Палитра проверяется против Record<Color, [number, number, number]>: убранный ключ — это ошибка полноты, а palette.red сохраняет свой тип-кортеж [number, number, number] вместо расширения до number[] — ограничение валидирует, выведенный тип сохраняет.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsFunctionsSatisfies-2">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="150" y="80" width="500" height="92" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="112" text-anchor="middle" font-size="12" fill="var(--ink)">{t.constraintTitle}</text>
      <text x="400" y="140" text-anchor="middle" font-size="12" fill="var(--muted)">{t.constraintSub}</text>

      <line x1="400" y1="172" x2="400" y2="198" stroke="var(--muted)" stroke-width="2" />
      <polygon points="400,206 395,196 405,196" fill="var(--muted)" />

      <rect x="150" y="216" width="500" height="84" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.paletteTitle}</text>
      <text x="400" y="274" text-anchor="middle" font-size="12" fill="var(--ink)">{t.paletteRow}</text>

      <line x1="265" y1="300" x2="265" y2="322" stroke="var(--muted)" stroke-width="2" />
      <polygon points="265,330 260,320 270,320" fill="var(--muted)" />
      <line x1="535" y1="300" x2="535" y2="322" stroke="var(--muted)" stroke-width="2" />
      <polygon points="535,330 530,320 540,320" fill="var(--muted)" />

      <rect x="40" y="338" width="330" height="46" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="205" y="357" text-anchor="middle" font-size="11" fill="var(--ink)">{t.missTitle}</text>
      <text x="205" y="375" text-anchor="middle" font-size="10" fill="var(--muted)">{t.missRow1}</text>

      <rect x="430" y="338" width="330" height="46" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="595" y="357" text-anchor="middle" font-size="11" fill="var(--ink)">{t.keepTitle}</text>
      <text x="595" y="375" text-anchor="middle" font-size="10" fill="var(--muted)">{t.keepRow1}</text>

      <text x="400" y="406" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
