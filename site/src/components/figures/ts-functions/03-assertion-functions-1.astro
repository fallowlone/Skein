---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "type predicate x is T versus assertion asserts x is T: branch-narrowing against scope-narrowing",
    headline: "PREDICATE vs ASSERTION: BRANCH vs SCOPE",
    sub: "x is T returns boolean · asserts x is T returns void",
    tagLeft: "1 — predicate: branch-narrowing",
    boxLeftTitle: "isStr(x): x is string",
    boxLeftLine1: "returns boolean",
    boxLeftLine2: "if (isStr(x)) { string }",
    boxLeftFoot: "outside the branch: unknown again",
    vs: "VS",
    tagRight: "2 — assertion: scope-narrowing",
    boxRightTitle: "assertIsString(x)",
    boxRightLine1: "asserts x is string · void",
    boxRightLine2: "throws on the false case",
    boxRightFoot: "after the call: string, no branch",
    foot1: "predicate = handle both cases · assertion = false case is a bug, fail loudly",
    foot2: "assertDefined(url): string | undefined becomes string for the rest of the function",
    caption:
      "A predicate returns a boolean and narrows only inside the truthy branch; an assertion returns void, throws on the false case, and narrows the rest of the scope after the call.",
  },
  ru: {
    svgTitle: "type-предикат x is T против утверждения asserts x is T: сужение ветки против сужения области",
    headline: "ПРЕДИКАТ ПРОТИВ УТВЕРЖДЕНИЯ: ВЕТКА ПРОТИВ ОБЛАСТИ",
    sub: "x is T возвращает boolean · asserts x is T возвращает void",
    tagLeft: "1 — предикат: сужение ветки",
    boxLeftTitle: "isStr(x): x is string",
    boxLeftLine1: "возвращает boolean",
    boxLeftLine2: "if (isStr(x)) { string }",
    boxLeftFoot: "вне ветки: снова unknown",
    vs: "VS",
    tagRight: "2 — утверждение: сужение области",
    boxRightTitle: "assertIsString(x)",
    boxRightLine1: "asserts x is string · void",
    boxRightLine2: "выбрасывает в ложном случае",
    boxRightFoot: "после вызова: string, без ветки",
    foot1: "предикат — обработать оба случая · утверждение — ложный случай это баг, упасть громко",
    foot2: "assertDefined(url): string | undefined становится string до конца функции",
    caption:
      "Предикат возвращает boolean и сужает только внутри истинной ветки; утверждение возвращает void, выбрасывает в ложном случае и сужает остаток области после вызова.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsFunctionsAsserts-1" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftTitle}</text>
    <text x="205" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine1}</text>
    <text x="205" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine2}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxLeftFoot}</text>

    <circle cx="400" cy="221" r="17" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="226" text-anchor="middle" font-size="12" fill="var(--ink)">{t.vs}</text>

    <text x="595" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightTitle}</text>
    <text x="595" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine1}</text>
    <text x="595" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine2}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxRightFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
