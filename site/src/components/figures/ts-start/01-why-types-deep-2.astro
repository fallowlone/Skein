---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A type annotation is a claim about every value at a position: totalCents rejects price instead of priceCents at compile time, so the bad call never runs",
    headline: "A TYPE ERROR IS A COUNTEREXAMPLE",
    sub: "found before your users find it",
    contractTag: "contract",
    contractLine: "totalCents(items: { priceCents })",
    goodTag: "good call",
    goodLine1: "totalCents([{ priceCents: 250 }])",
    goodLine2: "runs, returns 350",
    badTag: "bad call",
    badLine1: "totalCents([{ price: 100 }])",
    badLine2: "rejected: shape contradicts contract",
    foot1: "the bad call never runs — no test needed",
    foot2: "every shape mismatch is covered exhaustively",
    caption:
      "A type annotation is a claim about every value that will ever flow through a position, and the checker hands you the exact line where a wrong-shaped value can arrive — before it ever runs.",
  },
  ru: {
    svgTitle: "Аннотация типа — утверждение о каждом значении в позиции: totalCents отвергает price вместо priceCents на этапе компиляции, и плохой вызов никогда не выполняется",
    headline: "ОШИБКА ТИПА — ЭТО КОНТРПРИМЕР",
    sub: "найденный раньше ваших пользователей",
    contractTag: "контракт",
    contractLine: "totalCents(items: { priceCents })",
    goodTag: "хороший вызов",
    goodLine1: "totalCents([{ priceCents: 250 }])",
    goodLine2: "выполняется, вернёт 350",
    badTag: "плохой вызов",
    badLine1: "totalCents([{ price: 100 }])",
    badLine2: "отклонён: форма против контракта",
    foot1: "плохой вызов не выполнится — тест не нужен",
    foot2: "любое несовпадение формы покрыто",
    caption:
      "Аннотация типа — это утверждение о каждом значении, которое пройдёт через позицию, а проверяющий выдаёт точную строку, где может прийти значение неверной формы, — до того, как оно выполнится.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.contractTag}</text>
    <rect x="170" y="104" width="460" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.contractLine}</text>

    <text x="150" y="228" text-anchor="end" font-size="11" fill="var(--muted)">{t.goodTag}</text>
    <rect x="170" y="196" width="460" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.goodLine1}</text>
    <text x="400" y="248" text-anchor="middle" font-size="11" fill="var(--ink)">{t.goodLine2}</text>

    <text x="150" y="314" text-anchor="end" font-size="11" fill="var(--muted)">{t.badTag}</text>
    <rect x="170" y="282" width="460" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="310" text-anchor="middle" font-size="12" fill="var(--ink)">{t.badLine1}</text>
    <text x="400" y="334" text-anchor="middle" font-size="11" fill="var(--muted)">{t.badLine2}</text>

    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="402" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
