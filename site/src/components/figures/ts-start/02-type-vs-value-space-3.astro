---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Position decides the namespace: annotation positions consult the type table and expression positions consult the value table; a name missing from the consulted table raises the matching only-refers-to error, fixed by moving position or bridging with typeof",
    headline: "POSITION PICKS THE TABLE",
    sub: "same identifier, two tables — the error names the crossing",
    posType: "annotation position",
    posTypeLine1: "after : / extends / <…>",
    posTypeLine2: "consults the type table",
    posValue: "expression position",
    posValueLine1: "RHS of = / argument / return",
    posValueLine2: "consults the value table",
    err1Head: "'User' used as a value",
    err1Line1: "only refers to a type —",
    err1Line2: "type-table name, value slot",
    err1Fix: "fix: move to a type position",
    err2Head: "'handler' used as a type",
    err2Line1: "refers to a value —",
    err2Line2: "value-table name, type slot",
    err2Fix: "fix: typeof handler",
    foot1: "read the wording: it tells you which table came up empty",
    foot2: "match the position — or cross deliberately with typeof",
    caption:
      "Same identifier, two tables. The wording of the error (type used as value, or value used as type) tells you which table came up empty and which direction you crossed.",
  },
  ru: {
    svgTitle: "Позиция выбирает таблицу: позиции аннотации идут в таблицу типов, а позиции выражения — в таблицу значений; имя, отсутствующее в нужной таблице, поднимает свою ошибку only-refers-to, чинится переходом в позицию или мостом typeof",
    headline: "ПОЗИЦИЯ ВЫБИРАЕТ ТАБЛИЦУ",
    sub: "один идентификатор, две таблицы — ошибка называет пересечение",
    posType: "позиция аннотации",
    posTypeLine1: "после : / extends / <…>",
    posTypeLine2: "идёт в таблицу типов",
    posValue: "позиция выражения",
    posValueLine1: "правая часть = / аргумент",
    posValueLine2: "идёт в таблицу значений",
    err1Head: "«User» как значение",
    err1Line1: "только ссылается на тип —",
    err1Line2: "имя из типов, слот значения",
    err1Fix: "фикс: перейти в позицию типа",
    err2Head: "«handler» как тип",
    err2Line1: "ссылается на значение —",
    err2Line2: "имя из значений, слот типа",
    err2Fix: "фикс: typeof handler",
    foot1: "читайте формулировку: она говорит, какая таблица пуста",
    foot2: "подберите позицию — или смостите намеренно через typeof",
    caption:
      "Один идентификатор, две таблицы. Формулировка ошибки (тип как значение или значение как тип) говорит, какая таблица оказалась пустой и в какую сторону вы пересекли границу.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="104" text-anchor="middle" font-size="11" fill="var(--muted)">{t.posType}</text>
    <rect x="40" y="114" width="340" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="210" y="148" text-anchor="middle" font-size="12" fill="var(--ink)">{t.posTypeLine1}</text>
    <text x="210" y="172" text-anchor="middle" font-size="11" fill="var(--ink)">{t.posTypeLine2}</text>

    <text x="590" y="104" text-anchor="middle" font-size="11" fill="var(--muted)">{t.posValue}</text>
    <rect x="420" y="114" width="340" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="148" text-anchor="middle" font-size="12" fill="var(--ink)">{t.posValueLine1}</text>
    <text x="590" y="172" text-anchor="middle" font-size="11" fill="var(--ink)">{t.posValueLine2}</text>

    <line x1="210" y1="194" x2="210" y2="222" stroke="var(--muted)" stroke-width="2" />
    <polygon points="204,214 216,214 210,224" fill="var(--muted)" />
    <line x1="590" y1="194" x2="590" y2="222" stroke="var(--muted)" stroke-width="2" />
    <polygon points="584,214 596,214 590,224" fill="var(--muted)" />

    <text x="210" y="244" text-anchor="middle" font-size="11" fill="var(--muted)">{t.err1Head}</text>
    <rect x="40" y="254" width="340" height="90" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="210" y="284" text-anchor="middle" font-size="11" fill="var(--ink)">{t.err1Line1}</text>
    <text x="210" y="304" text-anchor="middle" font-size="11" fill="var(--ink)">{t.err1Line2}</text>
    <text x="210" y="326" text-anchor="middle" font-size="11" fill="var(--accent)">{t.err1Fix}</text>

    <text x="590" y="244" text-anchor="middle" font-size="11" fill="var(--muted)">{t.err2Head}</text>
    <rect x="420" y="254" width="340" height="90" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="590" y="284" text-anchor="middle" font-size="11" fill="var(--ink)">{t.err2Line1}</text>
    <text x="590" y="304" text-anchor="middle" font-size="11" fill="var(--ink)">{t.err2Line2}</text>
    <text x="590" y="326" text-anchor="middle" font-size="11" fill="var(--accent)">{t.err2Fix}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="396" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
