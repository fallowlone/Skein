---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "TypeScript declarations grouped by namespace membership: const, let and function live in value space only, type and interface live in type space only, and class, enum and namespace live in both",
    headline: "WHO LIVES WHERE",
    sub: "position decides which table the compiler consults",
    tagValue: "value space only",
    valueLine1: "const / let / function",
    valueLine2: "exists at runtime",
    valueLine3: "no type meaning",
    tagType: "type space only",
    typeLine1: "type / interface",
    typeLine2: "erased before runtime",
    typeLine3: "no value meaning",
    tagBoth: "BOTH spaces",
    bothLine1: "class / enum / namespace",
    bothLine2: "constructor + instance type",
    bothLine3: "survives to runtime",
    foot1: "type-only names vanish — no instanceof on an interface",
    foot2: "a class survives, so a class can be runtime-checked",
    caption:
      "Five declaration kinds collapse into three buckets — and the bucket decides whether the name survives to runtime, which is why an interface can't be instanceof-checked but a class can.",
  },
  ru: {
    svgTitle: "Объявления TypeScript по принадлежности к пространствам: const, let и function живут только в пространстве значений, type и interface — только в пространстве типов, а class, enum и namespace — в обоих",
    headline: "КТО ГДЕ ЖИВЁТ",
    sub: "позиция решает, к какой таблице идёт компилятор",
    tagValue: "только значения",
    valueLine1: "const / let / function",
    valueLine2: "есть в рантайме",
    valueLine3: "нет смысла в типах",
    tagType: "только типы",
    typeLine1: "type / interface",
    typeLine2: "стирается до рантайма",
    typeLine3: "нет смысла в значениях",
    tagBoth: "ОБА пространства",
    bothLine1: "class / enum / namespace",
    bothLine2: "конструктор + инстансный тип",
    bothLine3: "доживает до рантайма",
    foot1: "только-типовые исчезают — нет instanceof для interface",
    foot2: "class доживает, и его можно проверить в рантайме",
    caption:
      "Пять видов объявлений сворачиваются в три корзины — и корзина решает, доживёт ли имя до рантайма; поэтому interface нельзя проверить через instanceof, а class — можно.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagValue}</text>
    <rect x="40" y="108" width="220" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="150" y="142" text-anchor="middle" font-size="12" fill="var(--ink)">{t.valueLine1}</text>
    <text x="150" y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.valueLine2}</text>
    <text x="150" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.valueLine3}</text>
    <text x="150" y="234" text-anchor="middle" font-size="11" fill="var(--muted)">port</text>

    <text x="400" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagType}</text>
    <rect x="290" y="108" width="220" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="142" text-anchor="middle" font-size="12" fill="var(--ink)">{t.typeLine1}</text>
    <text x="400" y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.typeLine2}</text>
    <text x="400" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.typeLine3}</text>
    <text x="400" y="234" text-anchor="middle" font-size="11" fill="var(--muted)">Port</text>

    <text x="650" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagBoth}</text>
    <rect x="540" y="108" width="220" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="650" y="142" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bothLine1}</text>
    <text x="650" y="176" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bothLine2}</text>
    <text x="650" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bothLine3}</text>
    <text x="650" y="234" text-anchor="middle" font-size="11" fill="var(--muted)">Logger</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
