---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Refactoring one function signature across 23 call sites: plain JavaScript relies on grep by hand and a missed site crashes in production, while TypeScript turns every stale call site into a compile error at once",
    headline: "ONE SIGNATURE CHANGE, 23 CALL SITES",
    sub: "grep by hand vs whole-program check",
    leftTitle: "JavaScript: grep by hand",
    leftLine1: "22 sites fixed by hand",
    leftLine2: "1 missed site: silent",
    leftLine3: "props is undefined",
    leftFoot: "crash in production weeks later",
    rightTitle: "TypeScript: checker searches",
    rightLine1: "23 stale sites turn red",
    rightLine2: "Expected 2 arguments, got 1",
    rightLine3: "caught before the code runs",
    rightFoot: "incomplete refactor is a compile error",
    foot1: "the checker does the whole-program search",
    foot2: "you would otherwise do by hand and grep",
    caption:
      "Changing a contract turns the type checker into a whole-program search: every stale call site becomes a compile error at once, instead of a landmine you grep for by hand.",
  },
  ru: {
    svgTitle: "Рефакторинг одной сигнатуры по 23 местам вызова: чистый JavaScript правится вручную через grep и пропущенный вызов падает в проде, а TypeScript делает каждый устаревший вызов ошибкой компиляции разом",
    headline: "ОДНА СИГНАТУРА, 23 ВЫЗОВА",
    sub: "вручную через grep и поиск проверкой",
    leftTitle: "JavaScript: вручную через grep",
    leftLine1: "22 вызова исправлены вручную",
    leftLine2: "1 пропущен: тишина",
    leftLine3: "props равен undefined",
    leftFoot: "падение в проде недели спустя",
    rightTitle: "TypeScript: ищет проверяющий",
    rightLine1: "23 вызова красные разом",
    rightLine2: "нужно 2 аргумента, дан 1",
    rightLine3: "поймано до запуска кода",
    rightFoot: "недоделанный рефакторинг — ошибка",
    foot1: "проверяющий ищет по всей программе",
    foot2: "вместо ручного поиска через grep",
    caption:
      "Изменение контракта превращает проверку типов в поиск по всей программе: каждый устаревший вызов становится ошибкой компиляции разом, а не миной, которую ищешь руками через grep.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="104" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    <rect x="40" y="120" width="340" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="210" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine1}</text>
    <text x="210" y="182" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine2}</text>
    <text x="210" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine3}</text>
    <text x="210" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftFoot}</text>

    <text x="590" y="104" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    <rect x="420" y="120" width="340" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine1}</text>
    <text x="590" y="182" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine2}</text>
    <text x="590" y="212" text-anchor="middle" font-size="11" fill="var(--accent)">{t.rightLine3}</text>
    <text x="590" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightFoot}</text>

    <text x="400" y="326" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
