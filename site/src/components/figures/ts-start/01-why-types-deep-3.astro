---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Type erasure: the checker discharges the proof at build time and strips the types, so the emitted JavaScript carries no types and unchecked I/O data needs a runtime validator",
    headline: "TYPES ERASE BEFORE THE CODE RUNS",
    sub: "checked at build time, gone at runtime",
    stageA1: "input.ts",
    stageA2: "values + types",
    stageB1: "tsc checks",
    stageB2: "proof discharged",
    stageC1: "output.js",
    stageC2: "types stripped",
    ioHead: "at the boundary the proof ends",
    ioBox1: "I/O: fetch / JSON.parse",
    ioBox2: "typed any — unchecked",
    zodBox1: "runtime validator (zod)",
    zodBox2: "re-establishes contract",
    foot1: "types cannot validate runtime data",
    foot2: "an annotation is an assumption, not a guarantee",
    caption:
      "The checker discharges the proof at build time, then erases the types — so anything entering through an I/O boundary was never part of that proof and needs runtime validation.",
  },
  ru: {
    svgTitle: "Стирание типов: проверяющий закрывает доказательство на этапе сборки и вырезает типы, поэтому эмитированный JavaScript не несёт типов, а непроверенным данным нужен рантайм-валидатор",
    headline: "ТИПЫ СТИРАЮТСЯ ДО ЗАПУСКА КОДА",
    sub: "проверены при сборке, стёрты в рантайме",
    stageA1: "исходник .ts",
    stageA2: "значения + типы",
    stageB1: "проверка типов",
    stageB2: "доказательство закрыто",
    stageC1: "эмит .js",
    stageC2: "типы стёрты",
    ioHead: "на границе доказательство кончается",
    ioBox1: "I/O: fetch / parse",
    ioBox2: "тип any — без проверки",
    zodBox1: "рантайм-валидатор (zod)",
    zodBox2: "восстанавливает контракт",
    foot1: "типы не валидируют рантайм-данные",
    foot2: "аннотация — предположение, а не гарантия",
    caption:
      "Проверяющий закрывает доказательство на этапе сборки, затем стирает типы, — поэтому всё, что входит через границу ввода-вывода, никогда не было частью этого доказательства и нуждается в рантайм-валидации.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="104" width="210" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="135" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stageA1}</text>
    <text x="135" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stageA2}</text>
    <line x1="244" y1="137" x2="282" y2="137" stroke="var(--muted)" stroke-width="2" />
    <polygon points="282,131 282,143 292,137" fill="var(--muted)" />

    <rect x="296" y="104" width="210" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="401" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stageB1}</text>
    <text x="401" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stageB2}</text>
    <line x1="510" y1="137" x2="544" y2="137" stroke="var(--muted)" stroke-width="2" />
    <polygon points="544,131 544,143 554,137" fill="var(--muted)" />

    <rect x="558" y="104" width="212" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="664" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stageC1}</text>
    <text x="664" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.stageC2}</text>

    <text x="400" y="210" text-anchor="middle" font-size="12" fill="var(--muted)">{t.ioHead}</text>
    <rect x="90" y="226" width="280" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="230" y="254" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ioBox1}</text>
    <text x="230" y="276" text-anchor="middle" font-size="11" fill="var(--ink)">{t.ioBox2}</text>
    <line x1="374" y1="259" x2="412" y2="259" stroke="var(--muted)" stroke-width="2" />
    <polygon points="412,253 412,265 422,259" fill="var(--muted)" />

    <rect x="426" y="226" width="284" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="568" y="254" text-anchor="middle" font-size="12" fill="var(--ink)">{t.zodBox1}</text>
    <text x="568" y="276" text-anchor="middle" font-size="11" fill="var(--ink)">{t.zodBox2}</text>

    <text x="400" y="340" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="370" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
