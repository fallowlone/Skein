---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The two bridges: type-level typeof maps a value to its inferred type, and keyof maps an object type to the union of its keys; composed they give keyof typeof value",
    headline: "TWO BRIDGES, TWO DIRECTIONS",
    sub: "typeof crosses worlds, keyof stays inside type space",
    nodeValue: "value",
    valueLine1: "const config = { … }",
    valueLine2: "exists at runtime",
    bridgeTypeof: "typeof",
    bridgeTypeofSub: "value → type",
    nodeType: "type",
    typeLine1: "type Config = …",
    typeLine2: "{ host; port; tls }",
    bridgeKeyof: "keyof",
    bridgeKeyofSub: "type → type",
    nodeKeys: "keys",
    keysLine1: '"host" | "port" | "tls"',
    keysLine2: "union of key literals",
    warn1: "type-level typeof reads the inferred type — it runs nothing",
    warn2: 'runtime typeof x returns a string like "object" — a different world',
    foot1: "workhorse pattern: get<K extends keyof typeof config>(key: K)",
    foot2: "bridge the value, then extract its keys — no duplication",
    caption:
      "typeof bridges a value into its inferred object type and keyof maps that type to its key union — composed as keyof typeof value, the standard pattern for a typed get(key) constrained to the real keys.",
  },
  ru: {
    svgTitle: "Два моста: типовой typeof отображает значение в его выведенный тип, а keyof отображает объектный тип в объединение его ключей; вместе дают keyof typeof value",
    headline: "ДВА МОСТА, ДВА НАПРАВЛЕНИЯ",
    sub: "typeof пересекает миры, keyof остаётся внутри типов",
    nodeValue: "значение",
    valueLine1: "const config = { … }",
    valueLine2: "есть в рантайме",
    bridgeTypeof: "typeof",
    bridgeTypeofSub: "значение → тип",
    nodeType: "тип",
    typeLine1: "type Config = …",
    typeLine2: "{ host; port; tls }",
    bridgeKeyof: "keyof",
    bridgeKeyofSub: "тип → тип",
    nodeKeys: "ключи",
    keysLine1: '"host" | "port" | "tls"',
    keysLine2: "объединение ключей",
    warn1: "типовой typeof читает вывод — он ничего не выполняет",
    warn2: 'рантайм-typeof даёт строку вроде "object" — другой мир',
    foot1: "рабочая лошадка: get<K extends keyof typeof config>(key: K)",
    foot2: "смости значение, затем извлеки ключи — без дублирования",
    caption:
      "typeof мостит значение в его выведенный объектный тип, а keyof отображает этот тип в объединение ключей — вместе как keyof typeof value: стандартный приём для типизированного get(key), ограниченного реальными ключами.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="107" y="104" text-anchor="middle" font-size="11" fill="var(--muted)">{t.nodeValue}</text>
    <rect x="20" y="114" width="175" height="96" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="107" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.valueLine1}</text>
    <text x="107" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.valueLine2}</text>

    <line x1="195" y1="162" x2="305" y2="162" stroke="var(--accent)" stroke-width="2" />
    <polygon points="294,156 294,168 306,162" fill="var(--accent)" />
    <rect x="198" y="124" width="104" height="48" fill="var(--card)" />
    <text x="250" y="144" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bridgeTypeof}</text>
    <text x="250" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bridgeTypeofSub}</text>

    <text x="392" y="104" text-anchor="middle" font-size="11" fill="var(--muted)">{t.nodeType}</text>
    <rect x="305" y="114" width="175" height="96" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="392" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.typeLine1}</text>
    <text x="392" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.typeLine2}</text>

    <line x1="480" y1="162" x2="590" y2="162" stroke="var(--accent)" stroke-width="2" />
    <polygon points="579,156 579,168 591,162" fill="var(--accent)" />
    <rect x="483" y="124" width="104" height="48" fill="var(--card)" />
    <text x="535" y="144" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bridgeKeyof}</text>
    <text x="535" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bridgeKeyofSub}</text>

    <text x="685" y="104" text-anchor="middle" font-size="11" fill="var(--muted)">{t.nodeKeys}</text>
    <rect x="590" y="114" width="190" height="96" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="685" y="150" text-anchor="middle" font-size="11" fill="var(--ink)">{t.keysLine1}</text>
    <text x="685" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.keysLine2}</text>

    <text x="400" y="262" text-anchor="middle" font-size="12" fill="var(--ink)">{t.warn1}</text>
    <text x="400" y="288" text-anchor="middle" font-size="12" fill="var(--ink)">{t.warn2}</text>
    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="355" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
