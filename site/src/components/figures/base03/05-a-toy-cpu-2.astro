---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Two-byte instruction: byte zero bit fields and the four opcodes",
    headline: "TWO BYTES PER INSTRUCTION",
    subA: "the PC advances by",
    subB: "after each non-JUMP instruction",
    opcodeW: "opcode",
    regW: "register",
    unusedW: "unused",
    bitsW: "bits",
    bitW: "bit",
    byteW: "byte",
    byte1a: "memory address",
    unusedForAdd: "unused for",
    meanLoad: "load memory[addr] into Ra",
    meanStore: "store Ra into memory[addr]",
    meanJump: "set PC to addr",
    opNote: "movement · computation · control: four opcodes cover it all",
    capA: "Each instruction is",
    capB: "bytes: byte",
    capC: "holds opcode (bits",
    capD: "register select (bit",
    capE: "and five unused bits (bits",
    capF: "byte",
    capG: "is an address",
    capI: "Four opcodes:",
  },
  ru: {
    svgTitle: "Двухбайтовая инструкция: поля битов нулевого байта и четыре опкода",
    headline: "ДВА БАЙТА НА ИНСТРУКЦИЮ",
    subA: "СК продвигается на",
    subB: "после каждой не-JUMP инструкции",
    opcodeW: "опкод",
    regW: "регистр",
    unusedW: "не используется",
    bitsW: "биты",
    bitW: "бит",
    byteW: "байт",
    byte1a: "адрес памяти",
    unusedForAdd: "не используется для",
    meanLoad: "загрузить память[addr] в Ra",
    meanStore: "сохранить Ra в память[addr]",
    meanJump: "установить СК на addr",
    opNote: "перемещение · вычисление · управление: четыре опкода",
    capA: "Каждая инструкция занимает",
    capB: "байта: байт",
    capC: "содержит опкод (биты",
    capD: "выбор регистра (бит",
    capE: "и пять неиспользуемых бит (биты",
    capF: "байт",
    capG: "— адрес",
    capI: "Четыре опкода:",
  },
};

const t = dict[lang];

const bits0 = ["0", "0", "0", "0", "0", "0", "0", "0"];
const bitIdx = ["7", "6", "5", "4", "3", "2", "1", "0"];
const opcodes = ["00", "01", "10", "11"];
const mnems = ["LOAD", "STORE", "ADD", "JUMP"];
const addFormula = "R0 ← R0 + R1";
const meanings = [t.meanLoad, t.meanStore, addFormula, t.meanJump];
const rowY = [266, 296, 326, 356];
const rangeFull = "0–255";
const zeroHex = "0x00";
const loadEx = "LOAD R0, 200";
const eqHex00 = "= 0x00";
const addMn = "ADD";
const bits76 = "7–6";
const bit5 = "5";
const bits40 = "4–0";
const eqZero = "= 0";
const ZERO = "0";
const ONE = "1";
const TWO = "2";
const openP = "(";
const closeP = ")";
const period = ".";

const x0 = 150;
const cw = 56;
const step = 62;
const bitX = (i: number) => x0 + i * step;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.subA} {TWO} {t.subB}</text>

    <text x="209" y="82" text-anchor="middle" font-size="12" fill="var(--ink)">{t.opcodeW}</text>
    <text x="302" y="82" text-anchor="middle" font-size="12" fill="var(--ink)">{t.regW}</text>
    <text x="495" y="82" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unusedW} {eqZero}</text>
    <text x="209" y="99" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bitsW} {bits76}</text>
    <text x="302" y="99" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bitW} {bit5}</text>
    <text x="495" y="99" text-anchor="middle" font-size="11" fill="var(--muted)">{t.bitsW} {bits40}</text>

    <text x="140" y="135" text-anchor="end" font-size="12" fill="var(--ink)">{t.byteW} {ZERO}</text>
    {bits0.map((b, i) => (
      <g>
        <rect x={bitX(i)} y="105" width={cw} height="44" fill={i < 2 ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={bitX(i) + cw / 2} y="133" text-anchor="middle" font-size="14" fill={i < 2 ? "var(--card)" : "var(--ink)"}>{b}</text>
      </g>
    ))}
    {bitIdx.map((d, i) => (
      <text x={bitX(i) + cw / 2} y="166" text-anchor="middle" font-size="11" fill="var(--muted)">{d}</text>
    ))}

    <text x="650" y="122" font-size="12" fill="var(--ink)">{loadEx}</text>
    <text x="650" y="142" font-size="12" fill="var(--muted)">{t.byteW} {ZERO} {eqHex00}</text>

    <text x="140" y="215" text-anchor="end" font-size="12" fill="var(--ink)">{t.byteW} {ONE}</text>
    <rect x="150" y="192" width="490" height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="395" y="215" text-anchor="middle" font-size="13" fill="var(--ink)">{t.byte1a} {rangeFull}</text>
    <text x="395" y="250" text-anchor="middle" font-size="12" fill="var(--muted)">{zeroHex} {t.unusedForAdd} {addMn}</text>

    {opcodes.map((op, i) => (
      <g>
        <rect x="60" y={rowY[i]} width="46" height="24" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
        <text x="83" y={rowY[i] + 17} text-anchor="middle" font-size="13" fill="var(--card)">{op}</text>
        <text x="122" y={rowY[i] + 17} font-size="14" fill="var(--ink)">{mnems[i]}</text>
        <text x="230" y={rowY[i] + 17} font-size="12" fill="var(--ink)">{meanings[i]}</text>
      </g>
    ))}

    <text x="400" y="404" text-anchor="middle" font-size="13" fill="var(--muted)">{t.opNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.capA} {TWO} {t.capB} {ZERO} {t.capC} {bits76}{closeP}, {t.capD} {bit5}{closeP}, {t.capE} {bits40}{closeP}; {t.capF} {ONE} {t.capG} {rangeFull} {openP}{zeroHex} {t.unusedForAdd} {addMn}{closeP}{period} {t.capI} {opcodes[0]} {mnems[0]}, {opcodes[1]} {mnems[1]}, {opcodes[2]} {mnems[2]}, {opcodes[3]} {mnems[3]}{period} {t.subA} {TWO} {t.subB}{period}</figcaption>
</figure>
