---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The three instruction families: arithmetic and logic, memory, and control flow",
    headline: "THREE FAMILIES: COMPUTE · MOVE · JUMP",
    sub: "almost every instruction belongs to one of three families",
    fam1: "arithmetic + logic",
    fam2: "memory: LOAD + STORE",
    fam3: "control: JUMP + branch",
    ops1a: "ADD SUBTRACT MULTIPLY",
    ops1b: "AND OR NOT SHIFT",
    gloss1a: "inputs + output in registers",
    alu: "ALU",
    resWord: "the result",
    ops2: "LOAD · STORE",
    gloss2a: "registers ↔ memory",
    gloss2b: "read in · write back out",
    mem: "memory",
    onlyWay: "the only way in and out",
    ops3: "JUMP · branch",
    gloss3a: "decides what runs next",
    gloss3b: "sequential unless a jump",
    branchA: "jump to",
    branchB: "if result was zero",
    ifLoops: "if statements + loops",
    note: "compute a value · move it · decide what runs next",
    caption:
      "Almost every instruction is compute, move, or jump: arithmetic and logic instructions compute a result in registers via the ALU; LOAD and STORE move data between registers and memory — the only way in and out; JUMP and branches decide what runs next, overriding sequential execution, which is how if statements and loops work.",
  },
  ru: {
    svgTitle: "Три семейства инструкций: арифметика и логика, память и управление потоком",
    headline: "ТРИ СЕМЕЙСТВА: СЧИТАЙ · ДВИГАЙ · ПРЫГАЙ",
    sub: "почти каждая инструкция принадлежит одному из трёх семейств",
    fam1: "арифметика + логика",
    fam2: "память: LOAD + STORE",
    fam3: "управление: JUMP",
    ops1a: "ADD SUBTRACT MULTIPLY",
    ops1b: "AND OR NOT SHIFT",
    gloss1a: "входы и результат — в регистрах",
    alu: "АЛУ",
    resWord: "результат",
    ops2: "LOAD · STORE",
    gloss2a: "регистры ↔ память",
    gloss2b: "прочитал · записал обратно",
    mem: "память",
    onlyWay: "единственный путь туда-обратно",
    branchA: "прыжок на",
    branchB: "если результат — ноль",
    ops3: "JUMP · ветвление",
    gloss3a: "решает, что выполнять дальше",
    gloss3b: "по порядку, пока не прыжок",
    ifLoops: "операторы if и циклы",
    note: "вычислить · переместить · решить, что дальше",
    caption:
      "Почти каждая инструкция — это «считай», «двигай» или «прыгай»: арифметические и логические инструкции вычисляют результат в регистрах через АЛУ; LOAD и STORE перемещают данные между регистрами и памятью — это единственный путь туда-обратно; JUMP и ветвления решают, что выполнять дальше, переопределяя последовательное выполнение, — так работают операторы if и циклы.",
  },
};

const t = dict[lang];

const nums = ["1", "2", "3"];
const regs = "R0, R1";
const regMark = "R";
const jump = "JUMP";
const branchAddr = "80";
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="46" y="95" width="226" height="38" fill="var(--accent)" />
    <text x="159" y="119" text-anchor="middle" font-size="12" fill="var(--card)">{nums[0]} · {t.fam1}</text>
    <rect x="287" y="95" width="226" height="38" fill="var(--accent)" />
    <text x="400" y="119" text-anchor="middle" font-size="12" fill="var(--card)">{nums[1]} · {t.fam2}</text>
    <rect x="528" y="95" width="226" height="38" fill="var(--accent)" />
    <text x="641" y="119" text-anchor="middle" font-size="12" fill="var(--card)">{nums[2]} · {t.fam3}</text>

    <rect x="46" y="133" width="226" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x="287" y="133" width="226" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x="528" y="133" width="226" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />

    <text x="159" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ops1a}</text>
    <text x="159" y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ops1b}</text>
    <text x="159" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gloss1a}</text>
    <text x="159" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{regs}</text>
    <line x1="159" y1="246" x2="159" y2="254" stroke="var(--accent)" stroke-width="2" />
    <polygon points="153,254 165,254 159,262" fill="var(--accent)" />
    <rect x="104" y="262" width="110" height="30" fill="var(--accent)" />
    <text x="159" y="282" text-anchor="middle" font-size="13" fill="var(--card)">{t.alu}</text>
    <text x="159" y="314" text-anchor="middle" font-size="12" fill="var(--ink)">{t.resWord}</text>

    <text x="400" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ops2}</text>
    <text x="400" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gloss2a}</text>
    <text x="400" y="202" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gloss2b}</text>
    <rect x="320" y="250" width="56" height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="348" y="274" text-anchor="middle" font-size="13" fill="var(--ink)">{regMark}</text>
    <rect x="424" y="250" width="66" height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="457" y="274" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mem}</text>
    <line x1="376" y1="268" x2="424" y2="268" stroke="var(--accent)" stroke-width="2" />
    <polygon points="376,268 384,263 384,273" fill="var(--accent)" />
    <polygon points="424,268 416,263 416,273" fill="var(--accent)" />
    <text x="400" y="310" text-anchor="middle" font-size="11" fill="var(--muted)">{t.onlyWay}</text>

    <text x="641" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ops3}</text>
    <text x="641" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gloss3a}</text>
    <text x="641" y="202" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gloss3b}</text>
    <text x="641" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{jump}</text>
    <rect x="569" y="248" width="34" height="28" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x="624" y="248" width="34" height="28" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x="679" y="248" width="34" height="28" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <line x1="603" y1="262" x2="616" y2="262" stroke="var(--ink)" stroke-width="2" />
    <polygon points="616,257 616,267 624,262" fill="var(--ink)" />
    <line x1="658" y1="262" x2="671" y2="262" stroke="var(--ink)" stroke-width="2" />
    <polygon points="671,257 671,267 679,262" fill="var(--ink)" />
    <path d="M 586,248 C 586,232 696,232 696,240" fill="none" stroke="var(--accent)" stroke-width="2" />
    <polygon points="690,240 702,240 696,248" fill="var(--accent)" />
    <text x="641" y="296" text-anchor="middle" font-size="11" fill="var(--muted)">{t.branchA} {branchAddr} {t.branchB}</text>
    <text x="641" y="316" text-anchor="middle" font-size="11" fill="var(--muted)">{t.ifLoops}</text>

    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
