---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Fetch-decode-execute cycle: three stages in a closed loop",
    headline: "ONE LOOP: FETCH · DECODE · EXECUTE",
    sub: "fetch the bytes · decode the opcode · execute the action",
    stageNames: ["FETCH", "DECODE", "EXECUTE"],
    stageLines: [
      ["read bytes at address in PC", "bytes land in IR"],
      ["control unit reads opcode", "opcode → control signals"],
      ["ALU · memory · PC update", "depends on instruction"],
    ],
    repeat: "repeat — the loop never stops",
    note: "repeated billions of times per second",
    caption:
      "The CPU runs one loop: fetch reads the bytes at the PC address into the IR, decode turns the opcode into control signals, execute acts — then the PC advances and the loop repeats, billions of times per second.",
  },
  ru: {
    svgTitle: "Цикл выборки–декодирования–исполнения: три стадии в замкнутой петле",
    headline: "ОДИН ЦИКЛ: ВЫБОРКА · ДЕКОДИРОВАНИЕ · ИСПОЛНЕНИЕ",
    sub: "выбрать байты · декодировать опкод · исполнить действие",
    stageNames: ["ВЫБОРКА", "ДЕКОДИРОВАНИЕ", "ИСПОЛНЕНИЕ"],
    stageLines: [
      ["чтение байтов по адресу в СК", "байты попадают в РИ"],
      ["устройство управления", "читает опкод → сигналы"],
      ["АЛУ · память · запись в СК", "зависит от инструкции"],
    ],
    repeat: "повтор — цикл не останавливается",
    note: "повторяется миллиарды раз в секунду",
    caption:
      "CPU выполняет один цикл: выборка читает байты по адресу СК в РИ, декодирование превращает опкод в сигналы, исполнение действует — затем СК продвигается, и цикл повторяется миллиарды раз в секунду.",
  },
};

const t = dict[lang];

const boxW = 220;
const boxY = 100;
const boxH = 120;
const stages = [
  { n: "1", x: 25 },
  { n: "2", x: 290 },
  { n: "3", x: 555 },
];
const headers = stages.map((s, i) => `${s.n} · ${t.stageNames[i]}`);
const linkY = 160;
const links = [
  { x1: 245, x2: 290 },
  { x1: 510, x2: 555 },
];
const heads = links.map((l) => `${l.x2},${linkY} ${l.x2 - 12},${linkY - 6} ${l.x2 - 12},${linkY + 6}`);
const loopPath = "M 665 220 V 310 H 135 V 220";
const loopHead = "135,220 129,232 141,232";
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {stages.map((s, i) => (
      <g>
        <rect x={s.x} y={boxY} width={boxW} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={s.x + boxW / 2} y={boxY + 32} text-anchor="middle" font-size="16" fill="var(--ink)">{headers[i]}</text>
        <text x={s.x + boxW / 2} y={boxY + 58} text-anchor="middle" font-size="12" fill="var(--muted)">{t.stageLines[i][0]}</text>
        <text x={s.x + boxW / 2} y={boxY + 82} text-anchor="middle" font-size="12" fill="var(--muted)">{t.stageLines[i][1]}</text>
      </g>
    ))}

    {links.map((l, i) => (
      <g>
        <line x1={l.x1} y1={linkY} x2={l.x2 - 11} y2={linkY} stroke="var(--accent)" stroke-width="2" />
        <polygon points={heads[i]} fill="var(--accent)" />
      </g>
    ))}

    <path d={loopPath} fill="none" stroke="var(--accent)" stroke-width="2" />
    <polygon points={loopHead} fill="var(--accent)" />
    <text x="400" y="300" text-anchor="middle" font-size="13" fill="var(--ink)">{t.repeat}</text>

    <text x="400" y="385" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
