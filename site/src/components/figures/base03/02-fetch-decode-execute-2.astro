---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Fetch step: PC value travels the address bus, memory returns bytes into IR",
    headline: "FETCH: PC → MEMORY → IR",
    sub: "the CPU reads the instruction at the address in PC",
    boxes: [
      { h: "PC", s: "next address" },
      { h: "address bus", s: "CPU–memory wires" },
      { h: "memory", s: "returns bytes at address" },
      { h: "IR", s: "holds current instruction" },
    ],
    flow: ["PC value", "address", "bytes"],
    note: "after fetch, the instruction is inside the CPU",
    caption:
      "Fetch: the CPU puts the PC value onto the address bus, memory returns the bytes, and the bytes land in the instruction register. Memory is out until the next fetch.",
  },
  ru: {
    svgTitle: "Шаг выборки: значение СК идёт по шине адресов, память возвращает байты в РИ",
    headline: "ВЫБОРКА: СК → ПАМЯТЬ → РИ",
    sub: "CPU читает инструкцию по адресу из счётчика команд",
    boxes: [
      { h: "СК", s: "след. адрес" },
      { h: "шина адресов", s: "провода CPU–память" },
      { h: "память", s: "возвращает байты" },
      { h: "РИ", s: "текущая инструкция" },
    ],
    flow: ["значение СК", "адрес", "байты"],
    note: "после выборки инструкция — внутри CPU",
    caption:
      "Выборка: CPU помещает значение СК на шину адресов, память возвращает байты, и байты попадают в регистр инструкций. Дальше память не участвует до следующей выборки.",
  },
};

const t = dict[lang];

const pcVal = "100";
const instr = "LOAD R0, 200";
const memRow = `[100]  ${instr}`;
const boxY = 120;
const boxH = 130;
const boxes = [
  { x: 16, w: 150, value: pcVal },
  { x: 186, w: 150, value: pcVal },
  { x: 356, w: 220, value: memRow },
  { x: 596, w: 188, value: instr },
];
const arrowY = 185;
const labelY = 108;
const arrows = [
  { x1: 166, x2: 186 },
  { x1: 336, x2: 356 },
  { x1: 576, x2: 596 },
];
const heads = arrows.map((a) => `${a.x2},${arrowY} ${a.x2 - 8},${arrowY - 5} ${a.x2 - 8},${arrowY + 5}`);
const labelX = arrows.map((a) => (a.x1 + a.x2) / 2);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {boxes.map((b, i) => (
      <g>
        <rect x={b.x} y={boxY} width={b.w} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={b.x + b.w / 2} y={boxY + 30} text-anchor="middle" font-size="15" fill="var(--ink)">{t.boxes[i].h}</text>
        <text x={b.x + b.w / 2} y={boxY + 54} text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxes[i].s}</text>
        <text x={b.x + b.w / 2} y={boxY + 88} text-anchor="middle" font-size="14" fill="var(--ink)">{b.value}</text>
      </g>
    ))}

    {arrows.map((a, i) => (
      <g>
        <text x={labelX[i]} y={labelY} text-anchor="middle" font-size="11" fill="var(--muted)">{t.flow[i]}</text>
        <line x1={a.x1} y1={arrowY} x2={a.x2 - 7} y2={arrowY} stroke="var(--accent)" stroke-width="2" />
        <polygon points={heads[i]} fill="var(--accent)" />
      </g>
    ))}

    <text x="400" y="330" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
