---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Registers inside the CPU next to the ALU versus separate RAM chip",
    headline: "A REGISTER LIVES INSIDE THE CPU",
    sub: "each slot holds exactly one 64-bit (8-byte) value",
    cpu: "CPU",
    alu: "ALU",
    aluSub: "does the arithmetic",
    slotCap: "64-bit",
    cpuSpeed: "access: 1–2 cycles · a fraction of a ns",
    ram: "RAM",
    ramSub: "separate chip",
    ramTime: "50–100 ns",
    ramSlow: "100–300× slower",
    bus: "bus",
    note: "bring data close, work there, send it back",
    caption:
      "A register is a storage slot built into the CPU die, millimetres from the ALU: access takes 1–2 cycles. RAM is a separate chip reached over a bus at 50–100 ns — 100–300× slower.",
  },
  ru: {
    svgTitle: "Регистры внутри CPU рядом с АЛУ против отдельного чипа ОЗУ",
    headline: "РЕГИСТР — СЛОТ ВНУТРИ CPU",
    sub: "каждый слот хранит ровно одно 64-битное (8-байтовое) значение",
    cpu: "CPU",
    alu: "АЛУ",
    aluSub: "выполняет арифметику",
    slotCap: "64-бит",
    cpuSpeed: "доступ: 1–2 такта · доля наносекунды",
    ram: "ОЗУ",
    ramSub: "отдельный чип",
    ramTime: "50–100 нс",
    ramSlow: "в 100–300 раз дольше",
    bus: "шина",
    note: "доставить данные близко, работать там, вернуть результат",
    caption:
      "Регистр — слот на кристалле CPU, в миллиметрах от АЛУ: доступ за 1–2 такта. ОЗУ — отдельный чип за шиной, 50–100 нс — в 100–300 раз дольше.",
  },
};

const t = dict[lang];

const slots = ["R0", "R1", "R2", "R3"];
const slotRows = slots.map((name, i) => ({ name, y: 140 + i * 44 }));
const slotX = 270;
const slotW = 170;
const slotH = 38;
const arrowY = 180;
const busY = 225;
const cpuEdgeX = 470;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="430" height="250" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="60" y="118" font-size="14" fill="var(--ink)">{t.cpu}</text>

    <rect x="70" y="140" width="170" height="80" fill="var(--ink)" />
    <text x="155" y="176" text-anchor="middle" font-size="16" fill="var(--card)">{t.alu}</text>
    <text x="155" y="196" text-anchor="middle" font-size="10" fill="var(--card)">{t.aluSub}</text>

    {slotRows.map((s) => (
      <g>
        <rect x={slotX} y={s.y} width={slotW} height={slotH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={slotX + 16} y={s.y + 25} font-size="13" fill="var(--ink)">{s.name}</text>
        <text x={slotX + slotW - 14} y={s.y + 24} text-anchor="end" font-size="11" fill="var(--muted)">{t.slotCap}</text>
      </g>
    ))}

    <line x1={slotX} y1={arrowY} x2="248" y2={arrowY} stroke="var(--accent)" stroke-width="2" />
    <polygon points="248,174 248,186 240,180" fill="var(--accent)" />

    <text x="255" y="328" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cpuSpeed}</text>

    <rect x="560" y="140" width="180" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="650" y="168" text-anchor="middle" font-size="14" fill="var(--ink)">{t.ram}</text>
    <text x="650" y="192" text-anchor="middle" font-size="11" fill="var(--muted)">{t.ramSub}</text>
    <text x="650" y="218" text-anchor="middle" font-size="13" fill="var(--ink)">{t.ramTime}</text>
    <text x="650" y="242" text-anchor="middle" font-size="11" fill="var(--muted)">{t.ramSlow}</text>

    <line x1={cpuEdgeX} y1={busY} x2="552" y2={busY} stroke="var(--accent)" stroke-width="2" />
    <polygon points="552,219 552,231 560,225" fill="var(--accent)" />
    <text x="515" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bus}</text>

    <text x="400" y="386" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
