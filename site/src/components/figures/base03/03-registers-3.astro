---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Special-purpose registers and the program counter driving fetch",
    headline: "SPECIAL REGISTERS HAVE FIXED ROLES",
    sub: "fixed hardware roles — and the PC is a register too",
    badges: ["PC", "SP", "FLAGS", "IR"],
    roles: [
      "address of the next instruction",
      "address of the top of the call stack",
      "zero · carry · negative of the last operation",
      "holds the current instruction",
    ],
    pcLabel: "PC drives every fetch",
    pcNote: "updated automatically after every instruction — a JUMP writes a new value",
    caption:
      "PC holds the next instruction's address, SP the top of the call stack, flags the last outcome, IR the current instruction. The PC is a register like any other: 100 → 104 → 108 → 112 across three instructions.",
  },
  ru: {
    svgTitle: "Специальные регистры и счётчик команд, ведущий выборку",
    headline: "У СПЕЦИАЛЬНЫХ РЕГИСТРОВ ФИКСИРОВАННЫЕ РОЛИ",
    sub: "фиксированные роли — и СК тоже регистр",
    badges: ["СК", "SP", "ФЛАГИ", "РИ"],
    roles: [
      "адрес следующей инструкции",
      "адрес вершины стека вызовов",
      "нуль · перенос · знак прошлой операции",
      "хранит текущую инструкцию",
    ],
    pcLabel: "СК ведёт каждую выборку",
    pcNote: "обновляется автоматически после каждой инструкции",
    caption:
      "СК хранит адрес следующей инструкции, SP — вершину стека вызовов, флаги — итог прошлой операции, РИ — текущую инструкцию. СК — такой же регистр: 100 → 104 → 108 → 112 за три инструкции.",
  },
};

const t = dict[lang];

const rows = t.badges.map((badge, i) => ({ badge, role: t.roles[i], y: 96 + i * 44 }));
const badgeX = 60;
const badgeW = 110;
const badgeH = 36;
const roleX = 190;
const pcVals = ["100", "104", "108", "112"];
const pcY = 312;
const pcH = 36;
const pcMid = 330;
const nodes = pcVals.map((v, i) => ({ v, x: 215 + i * 100 }));
const nodeW = 70;
const links = [0, 1, 2].map((i) => ({ x1: 285 + i * 100, x2: 307 + i * 100, tip: 315 + i * 100 }));
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    {rows.map((r) => (
      <g>
        <rect x={badgeX} y={r.y} width={badgeW} height={badgeH} fill="var(--accent)" />
        <text x={badgeX + badgeW / 2} y={r.y + 24} text-anchor="middle" font-size="13" fill="var(--card)">{r.badge}</text>
        <text x={roleX} y={r.y + 24} font-size="12" fill="var(--ink)">{r.role}</text>
      </g>
    ))}

    <text x="60" y="300" font-size="13" fill="var(--ink)">{t.pcLabel}</text>

    {nodes.map((n) => (
      <g>
        <rect x={n.x} y={pcY} width={nodeW} height={pcH} fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={n.x + nodeW / 2} y={pcMid + 5} text-anchor="middle" font-size="13" fill="var(--ink)">{n.v}</text>
      </g>
    ))}
    {links.map((l) => (
      <g>
        <line x1={l.x1} y1={pcMid} x2={l.x2} y2={pcMid} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${l.x2},324 ${l.x2},336 ${l.tip},330`} fill="var(--accent)" />
      </g>
    ))}

    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.pcNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
