---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The instruction set as a contract between software and three CPU families: x86-64, ARM, RISC-V",
    headline: "THE INSTRUCTION SET IS THE CONTRACT",
    sub: "software is translated into the ISA · hardware executes the ISA",
    programLbl: "program in Python / C",
    isaBar: "instruction set (ISA) = the contract",
    devices: ["laptops + desktops", "phones + Apple Silicon", "embedded + research"],
    noRunA: "a program for",
    noRunB: "cannot run on",
    differ: "different families, different instruction sets",
    caption:
      "The instruction set (ISA) is the contract between software and hardware: programs in Python or C are translated into it before the CPU can run them. x86-64 powers laptops and desktops, ARM powers phones and Apple Silicon Macs, RISC-V is used in embedded systems and research — and a program for x86-64 cannot run on ARM.",
  },
  ru: {
    svgTitle: "Система команд как контракт между ПО и тремя семействами CPU: x86-64, ARM, RISC-V",
    headline: "СИСТЕМА КОМАНД — ЭТО КОНТРАКТ",
    sub: "ПО переводится в ISA · железо исполняет ISA",
    programLbl: "программа на Python / C",
    isaBar: "система команд (ISA) = контракт",
    devices: ["ноутбуки и ПК", "смартфоны и Apple Silicon", "встройка и исследования"],
    noRunA: "программа для",
    noRunB: "не запустится на",
    differ: "разные семейства — разные системы команд",
    caption:
      "Система команд (ISA) — это контракт между программным обеспечением и аппаратурой: программы на Python или C переводятся в неё, прежде чем CPU сможет их выполнить. x86-64 — в ноутбуках и настольных компьютерах, ARM — в смартфонах и Mac на Apple Silicon, RISC-V — во встроенных системах и исследованиях; программа для x86-64 не запустится на ARM.",
  },
};

const t = dict[lang];

const isaNames = ["x86-64", "ARM", "RISC-V"];
const boxX = (i: number) => 60 + i * 235;
const arrows = isaNames.map((_, i) => ({ cx: boxX(i) + 105, pts: `${boxX(i) + 99},212 ${boxX(i) + 111},212 ${boxX(i) + 105},222` }));
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="250" y="92" width="300" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="119" text-anchor="middle" font-size="13" fill="var(--ink)">{t.programLbl}</text>

    <line x1="400" y1="136" x2="400" y2="148" stroke="var(--accent)" stroke-width="2" />
    <polygon points="394,148 406,148 400,156" fill="var(--accent)" />

    <rect x="150" y="156" width="500" height="44" fill="var(--accent)" />
    <text x="400" y="183" text-anchor="middle" font-size="13" fill="var(--card)">{t.isaBar}</text>

    {arrows.map((a, i) => (
      <g>
        <line x1={a.cx} y1="200" x2={a.cx} y2="212" stroke="var(--accent)" stroke-width="2" />
        <polygon points={a.pts} fill="var(--accent)" />
        <rect x={boxX(i)} y="222" width="210" height="96" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={boxX(i) + 105} y="252" text-anchor="middle" font-size="16" fill="var(--ink)">{isaNames[i]}</text>
        <text x={boxX(i) + 105} y="280" text-anchor="middle" font-size="12" fill="var(--muted)">{t.devices[i]}</text>
      </g>
    ))}

    <text x="400" y="356" text-anchor="middle" font-size="13" fill="var(--ink)">{t.noRunA} {isaNames[0]} {t.noRunB} {isaNames[1]}</text>
    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--muted)">{t.differ}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
