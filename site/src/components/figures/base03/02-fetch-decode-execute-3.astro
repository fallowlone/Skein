---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "PC advance in two modes: forward by size by default, leap to target on JUMP",
    headline: "PC ADVANCE: TWO MODES",
    sub: "march forward by default, or leap to a target on JUMP",
    leftHead: "default: march forward",
    rightHead: "on JUMP: leap to target",
    fixedWord: "fixed,",
    bytesWord: "bytes each",
    varWord: "variable,",
    bytesMany: "bytes",
    leftNext: "points at the next one",
    setDuring: "set during execute",
    nextFrom: "next fetch comes from target",
    ifLoops: "this is how if and loops work",
    jumpWord: "JUMP",
    note: "the only two modes: forward by default, leap on command",
    caption:
      "After a non-jump instruction the PC advances by the instruction size; a JUMP sets the PC to its target instead. Sequential code marches forward; conditionals and loops leap.",
  },
  ru: {
    svgTitle: "Продвижение СК в двух режимах: вперёд на размер по умолчанию, прыжок к цели по JUMP",
    headline: "ПРОДВИЖЕНИЕ СК: ДВА РЕЖИМА",
    sub: "вперёд по умолчанию — или прыжок по команде JUMP",
    leftHead: "по умолчанию: движение вперёд",
    rightHead: "по JUMP: прыжок к цели",
    fixedWord: "фикс.,",
    bytesWord: "байта",
    varWord: "перемен.,",
    bytesMany: "байтов",
    leftNext: "указывает на следующую",
    setDuring: "задаётся на исполнении",
    nextFrom: "выборка — из адреса цели",
    ifLoops: "так работают if и циклы",
    jumpWord: "JUMP",
    note: "единственные два режима: вперёд — или прыжок по команде",
    caption:
      "После не-JUMP инструкции СК растёт на размер инструкции; JUMP ставит СК на адрес перехода. Последовательный код идёт вперёд; условия и циклы прыгают.",
  },
};

const t = dict[lang];

const pcName = lang === "en" ? "PC" : "СК";
const startAddr = "100";
const sizeVal = "4";
const nextAddr = "104";
const jumpTarget = "500";
const archA = "ARM";
const archX = "x86-64";
const rangeX = "1–15";
const defaultFormula = `${pcName} = ${startAddr} + ${sizeVal} = ${nextAddr}`;
const jumpFormula = `${pcName} = ${jumpTarget}`;
const sizeLineA = `${archA}: ${t.fixedWord} ${sizeVal} ${t.bytesWord}`;
const sizeLineX = `${archX}: ${t.varWord} ${rangeX} ${t.bytesMany}`;
const plusSize = `+${sizeVal}`;
const panels = [
  { x: 30, head: t.leftHead, formula: defaultFormula, chipX: 80 },
  { x: 420, head: t.rightHead, formula: jumpFormula, chipX: 470 },
];
const panelY = 100;
const panelH = 215;
const panelW = 350;
const chipW = 250;
const leftLines = [sizeLineA, sizeLineX, t.leftNext];
const rightLines = [t.setDuring, t.nextFrom, t.ifLoops];
const lineRows = [leftLines, rightLines];
const cellY = 262;
const cellH = 30;
const cellW = 64;
const minis = [
  { aX: 122, bX: 223, aVal: startAddr, bVal: nextAddr, ax2: 223, tag: plusSize },
  { aX: 512, bX: 613, aVal: pcName, bVal: jumpTarget, ax2: 613, tag: t.jumpWord },
];
const miniY = 277;
const miniHeads = minis.map((m) => `${m.ax2},${miniY} ${m.ax2 - 12},${miniY - 6} ${m.ax2 - 12},${miniY + 6}`);
const miniTagX = minis.map((m) => (m.aX + cellW + m.bX) / 2);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {panels.map((p, i) => (
      <g>
        <rect x={p.x} y={panelY} width={panelW} height={panelH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={p.x + panelW / 2} y={panelY + 30} text-anchor="middle" font-size="16" fill="var(--ink)">{p.head}</text>
        <rect x={p.chipX} y={panelY + 45} width={chipW} height={34} rx="6" fill="var(--accent)" />
        <text x={p.chipX + chipW / 2} y={panelY + 68} text-anchor="middle" font-size="15" fill="var(--card)">{p.formula}</text>
        {lineRows[i].map((ln, j) => (
          <text x={p.x + panelW / 2} y={panelY + 105 + j * 22} text-anchor="middle" font-size="12" fill="var(--muted)">{ln}</text>
        ))}
      </g>
    ))}

    {minis.map((m, i) => (
      <g>
        <rect x={m.aX} y={cellY} width={cellW} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={m.aX + cellW / 2} y={cellY + 21} text-anchor="middle" font-size="14" fill="var(--ink)">{m.aVal}</text>
        <rect x={m.bX} y={cellY} width={cellW} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={m.bX + cellW / 2} y={cellY + 21} text-anchor="middle" font-size="14" fill="var(--ink)">{m.bVal}</text>
        <line x1={m.aX + cellW} y1={miniY} x2={m.ax2 - 11} y2={miniY} stroke="var(--accent)" stroke-width="2" />
        <polygon points={miniHeads[i]} fill="var(--accent)" />
        <text x={miniTagX[i]} y={cellY + 46} text-anchor="middle" font-size="11" fill="var(--muted)">{m.tag}</text>
      </g>
    ))}

    <text x="400" y="375" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
