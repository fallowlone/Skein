---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "General-purpose register counts: x86-64, ARM and toy CPUs",
    headline: "GENERAL-PURPOSE REGISTERS: FEW BY DESIGN",
    sub: "no fixed meaning — any instruction uses any GPR for any value",
    toyArch: "toy CPUs · nand2tetris",
    toyBadge: "FEW",
    note1: "more live values than slots → spill to RAM",
    note2: "a 4-bit field names 16 registers · a 5-bit field names 32",
    caption:
      "x86-64 has 16 GPRs (RAX…R15); ARM has 31 (X0–X30); toy CPUs have a handful (R0–R3). More live values than slots forces a spill to RAM; a 4-bit field names 16 registers, a 5-bit field 32.",
  },
  ru: {
    svgTitle: "Число регистров общего назначения: x86-64, ARM и учебные CPU",
    headline: "РЕГИСТРЫ ОБЩЕГО НАЗНАЧЕНИЯ: ИХ МАЛО",
    sub: "нет фиксированного смысла — любая инструкция, любой РОН, любое значение",
    toyArch: "учебные CPU · nand2tetris",
    toyBadge: "МАЛО",
    note1: "живых значений больше, чем слотов → spill в память",
    note2: "4-битное поле называет 16 регистров · 5-битное — 32",
    caption:
      "У x86-64 — 16 РОН (RAX…R15); у ARM — 31 (X0–X30); у учебных CPU — несколько (R0–R3). Живых значений больше, чем слотов, — spill в память; 4-битное поле называет 16 регистров, 5-битное — 32.",
  },
};

const t = dict[lang];

const rows = [
  { arch: "x86-64", badge: "16", names: "RAX, RBX, RCX, RDX, RSI, RDI, RSP, RBP, R8–R15", y: 100 },
  { arch: "ARM (AArch64)", badge: "31", names: "X0 … X30", y: 180 },
  { arch: t.toyArch, badge: t.toyBadge, names: "R0, R1, R2, R3", y: 260 },
];
const rowH = 64;
const badgeX = 40;
const badgeW = 64;
const textX = 124;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sub}</text>

    {rows.map((r) => (
      <g>
        <rect x={badgeX} y={r.y} width={badgeW} height={rowH} fill="var(--accent)" />
        <text x={badgeX + badgeW / 2} y={r.y + 40} text-anchor="middle" font-size="18" fill="var(--card)">{r.badge}</text>
        <text x={textX} y={r.y + 26} font-size="14" fill="var(--ink)">{r.arch}</text>
        <text x={textX} y={r.y + 50} font-size="11" fill="var(--muted)">{r.names}</text>
      </g>
    ))}

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--ink)">{t.note1}</text>
    <text x="400" y="388" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
