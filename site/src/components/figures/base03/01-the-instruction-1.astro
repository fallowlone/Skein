---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Anatomy of the instruction LOAD R0, 100: opcode LOAD plus operands R0 and 100",
    headline: "AN INSTRUCTION = OPERATION + OPERANDS",
    sub: "the opcode says what to do · the operands say what to do it to",
    opLbl: "operation: what to do",
    opsLbl: "operands: what to do it to",
    opGloss: "read from memory",
    regGloss: "slot inside the CPU",
    addrGloss: "memory address",
    haltNote: "needs no operands",
    sumNote: "one opcode + the inputs it needs",
    caption:
      "LOAD R0, 100 splits into the operation LOAD (read from memory) and two operands: register R0, a fast slot inside the CPU, and memory address 100. Every instruction is one opcode plus the inputs it needs — except rare ones like HALT, which needs no operands.",
  },
  ru: {
    svgTitle: "Анатомия инструкции LOAD R0, 100: опкод LOAD плюс операнды R0 и 100",
    headline: "ИНСТРУКЦИЯ = ОПЕРАЦИЯ + ОПЕРАНДЫ",
    sub: "опкод говорит, что делать · операнды — над чем делать",
    opLbl: "операция: что делать",
    opsLbl: "операнды: над чем делать",
    opGloss: "прочитать из памяти",
    regGloss: "ячейка внутри CPU",
    addrGloss: "адрес памяти",
    haltNote: "— без операндов",
    sumNote: "один опкод + нужные ему входы",
    caption:
      "LOAD R0, 100 разбирается на операцию LOAD (прочитать из памяти) и два операнда: регистр R0 — быструю ячейку внутри CPU — и адрес памяти 100. Каждая инструкция — это один опкод плюс нужные ему входы, кроме редких вроде HALT, у которой операндов нет.",
  },
};

const t = dict[lang];

const opLoad = "LOAD";
const dst = "R0";
const addr = "100";
const halt = "HALT";
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="150" y="105" width="130" height="56" fill="var(--accent)" />
    <text x="215" y="140" text-anchor="middle" font-size="17" fill="var(--card)">{opLoad}</text>
    <rect x="345" y="105" width="110" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="140" text-anchor="middle" font-size="17" fill="var(--ink)">{dst}</text>
    <rect x="520" y="105" width="130" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="585" y="140" text-anchor="middle" font-size="17" fill="var(--ink)">{addr}</text>

    <text x="215" y="185" text-anchor="middle" font-size="12" fill="var(--ink)">{t.opLbl}</text>
    <text x="497" y="185" text-anchor="middle" font-size="12" fill="var(--ink)">{t.opsLbl}</text>

    <line x1="215" y1="161" x2="215" y2="207" stroke="var(--accent)" stroke-width="2" />
    <polygon points="209,207 221,207 215,215" fill="var(--accent)" />
    <line x1="400" y1="161" x2="400" y2="207" stroke="var(--accent)" stroke-width="2" />
    <polygon points="394,207 406,207 400,215" fill="var(--accent)" />
    <line x1="585" y1="161" x2="585" y2="207" stroke="var(--accent)" stroke-width="2" />
    <polygon points="579,207 591,207 585,215" fill="var(--accent)" />

    <rect x="130" y="215" width="170" height="88" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="215" y="248" text-anchor="middle" font-size="15" fill="var(--ink)">{opLoad}</text>
    <text x="215" y="274" text-anchor="middle" font-size="12" fill="var(--muted)">{t.opGloss}</text>

    <rect x="315" y="215" width="170" height="88" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="248" text-anchor="middle" font-size="15" fill="var(--ink)">{dst}</text>
    <text x="400" y="274" text-anchor="middle" font-size="12" fill="var(--muted)">{t.regGloss}</text>

    <rect x="500" y="215" width="170" height="88" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="585" y="248" text-anchor="middle" font-size="15" fill="var(--ink)">{addr}</text>
    <text x="585" y="274" text-anchor="middle" font-size="12" fill="var(--muted)">{t.addrGloss}</text>

    <text x="400" y="345" text-anchor="middle" font-size="13" fill="var(--ink)">{halt} {t.haltNote}</text>
    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sumNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
