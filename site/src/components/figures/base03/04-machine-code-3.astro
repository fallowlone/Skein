---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Stored program: one memory for program and data, new software means new bytes",
    headline: "ONE MEMORY FOR PROGRAM AND DATA",
    sub: "the stored-program concept · von Neumann, 1945, EDVAC",
    beforeTitle: "before 1945",
    before1: "rewire the machine",
    before2: "or load new punched cards",
    before3: "new task = new wiring",
    bridgeA: "von Neumann",
    bridgeB: "1945",
    afterTitle: "stored program",
    mem: ["program", "data"],
    after1: "new software = write new bytes",
    after2: "no hardware change",
    after3: "one machine runs any program",
    bottom: "program and data share the same memory",
    caption:
      "Before stored-program computers, a new task meant rewiring the machine or loading new punched cards. Von Neumann's 1945 insight: put the program in memory like data — new software is just new bytes, no hardware change, one machine runs any program.",
  },
  ru: {
    svgTitle: "Хранимая программа: одна память для программы и данных, новое ПО — новые байты",
    headline: "ОДНА ПАМЯТЬ ДЛЯ ПРОГРАММЫ И ДАННЫХ",
    sub: "концепция хранимой программы · фон Нейман, 1945, EDVAC",
    beforeTitle: "до 1945 года",
    before1: "перекоммутировать машину",
    before2: "или загрузить новые перфокарты",
    before3: "новая задача = новая коммутация",
    bridgeA: "фон Нейман",
    bridgeB: "1945",
    afterTitle: "хранимая программа",
    mem: ["программа", "данные"],
    after1: "новое ПО = записать новые байты",
    after2: "железо менять не нужно",
    after3: "одна машина выполняет любую программу",
    bottom: "программа и данные разделяют одну память",
    caption:
      "До компьютеров с хранимой программой новая задача означала перекоммутацию машины или загрузку новых перфокарт. Идея фон Неймана 1945 года: помести программу в память как данные — новое ПО это просто новые байты, железо менять не нужно, одна машина выполняет любую программу.",
  },
};

const t = dict[lang];

const leftX = 60;
const leftW = 260;
const rightX = 480;
const rightW = 260;
const panelY = 110;
const panelH = 200;
const arrowY = 210;
const arrowTipX = rightX;
const arrowBaseX = arrowTipX - 14;
const barX = rightX + 20;
const barW = rightW - 40;
const barY = 160;
const barH = 46;
const halves = [0, 1].map((k) => ({ k, x: barX + k * (barW / 2), w: barW / 2 }));
const afterLines = [t.after1, t.after2, t.after3];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x={leftX} y={panelY} width={leftW} height={panelH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={leftX + leftW / 2} y={panelY + 34} text-anchor="middle" font-family="var(--font-display)" font-size="16" fill="var(--ink)">{t.beforeTitle}</text>
    <text x={leftX + leftW / 2} y={panelY + 82} text-anchor="middle" font-size="12" fill="var(--ink)">{t.before1}</text>
    <text x={leftX + leftW / 2} y={panelY + 106} text-anchor="middle" font-size="12" fill="var(--ink)">{t.before2}</text>
    <text x={leftX + leftW / 2} y={panelY + 152} text-anchor="middle" font-size="12" fill="var(--muted)">{t.before3}</text>

    <line x1={leftX + leftW} y1={arrowY} x2={arrowBaseX} y2={arrowY} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${arrowBaseX},${arrowY - 8} ${arrowBaseX},${arrowY + 8} ${arrowTipX},${arrowY}`} fill="var(--accent)" />
    <text x={(leftX + leftW + rightX) / 2} y={arrowY - 16} text-anchor="middle" font-size="11" fill="var(--ink)">{t.bridgeA}</text>
    <text x={(leftX + leftW + rightX) / 2} y={arrowY + 30} text-anchor="middle" font-size="11" fill="var(--muted)">{t.bridgeB}</text>

    <rect x={rightX} y={panelY} width={rightW} height={panelH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={rightX + rightW / 2} y={panelY + 34} text-anchor="middle" font-family="var(--font-display)" font-size="16" fill="var(--ink)">{t.afterTitle}</text>

    {halves.map((h) => (
      <g>
        <rect x={h.x} y={barY} width={h.w} height={barH} fill={h.k === 0 ? "var(--accent)" : "var(--ink)"} stroke="var(--ink)" stroke-width="2" />
        <text x={h.x + h.w / 2} y={barY + 29} text-anchor="middle" font-size="12" fill="var(--card)">{t.mem[h.k]}</text>
      </g>
    ))}

    {afterLines.map((line, i) => (
      <text x={rightX + rightW / 2} y={barY + barH + 28 + i * 24} text-anchor="middle" font-size="11" fill="var(--ink)">{line}</text>
    ))}

    <text x="400" y="356" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bottom}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
