---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Memory map and four-cycle trace of the toy program that adds two inputs",
    inFourCycles: "in four cycles",
    traceSubA: "PC starts at",
    traceSubB: "· each cycle fetches two bytes",
    memTitle: "memory, initial state:",
    progWord: "program",
    dataHold: "hold the data",
    traceTitle: "four fetch–decode–execute cycles",
    cellW: "cell",
    endsHolding: "ends holding",
    regsBefore: "registers before:",
    cycleW: "cycle",
    memW: "memory",
    pcName: "PC",
    pcSweepL: "PC sweeps:",
    capA: "Addresses",
    capB: "hold the program bytes; cells",
    capC: "hold",
    capCycle: "Cycle",
  },
  ru: {
    svgTitle: "Карта памяти и трассировка четырёх циклов игрушечной программы, складывающей два входа",
    inFourCycles: "за четыре цикла",
    traceSubA: "СК начинается с",
    traceSubB: "· каждый цикл выбирает два байта",
    memTitle: "память, начальное состояние:",
    progWord: "программа",
    dataHold: "хранят данные",
    traceTitle: "четыре цикла выборки–декодирования–исполнения",
    cellW: "ячейка",
    endsHolding: "в конце хранит",
    regsBefore: "регистры до:",
    cycleW: "цикл",
    memW: "память",
    pcName: "СК",
    pcSweepL: "СК проходит:",
    capA: "Адреса",
    capB: "хранят байты программы; ячейки",
    capC: "хранят",
    capCycle: "Цикл",
  },
};

const t = dict[lang];

const progAddrs = ["0", "1", "2", "3", "4", "5", "6", "7"];
const progBytes = ["0x00", "0xC8", "0x20", "0xC9", "0x80", "0x00", "0x40", "0xCA"];
const dataAddrs3 = ["200", "201", "202"];
const dataVals = ["25", "17", "0 → 42"];
const progRange = "0–7";
const dataRange = "200–202";
const pcs = ["0", "2", "4", "6"];
const cyc = ["1", "2", "3", "4"];
const instrs = ["LOAD R0, 200", "LOAD R1, 201", "ADD R0, R1", "STORE 202, R0"];
const traceFormula = "25 + 17 = 42";
const pcSweep = "0 → 2 → 4 → 6 → 8";
const ZERO = "0";
const addr202 = "202";
const val42 = "42";
const val25 = "25";
const val17 = "17";
const r0e25 = "R0 = 25";
const r1e17 = "R1 = 17";
const r0e42 = "R0 = 42";
const results = ["R0 ← 25", "R1 ← 17", "R0 ← 42", `${t.memW}[${addr202}] ← ${val42}`];
const initState = `R0 = 0 · R1 = 0 · ${t.pcName} = 0`;
const rowY = [112, 172, 232, 292];
const flowFrom = [156, 216, 276];
const openP = "(";
const closeP = ")";
const period = ".";
const eq = "=";
const arrowR = "→";
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{traceFormula} {t.inFourCycles}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.traceSubA} {ZERO} {t.traceSubB}</text>

    <text x="40" y="100" font-size="12" fill="var(--ink)">{t.memTitle} {progRange} {t.progWord}</text>
    {progBytes.map((b, i) => (
      <g>
        <rect x={40 + (i % 4) * 82} y={112 + Math.floor(i / 4) * 48} width="74" height="42" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={40 + (i % 4) * 82 + 37} y={112 + Math.floor(i / 4) * 48 + 15} text-anchor="middle" font-size="10" fill="var(--muted)">{progAddrs[i]}</text>
        <text x={40 + (i % 4) * 82 + 37} y={112 + Math.floor(i / 4) * 48 + 33} text-anchor="middle" font-size="13" fill="var(--ink)">{b}</text>
      </g>
    ))}

    <text x="40" y="222" font-size="12" fill="var(--ink)">{dataRange} {t.dataHold}</text>
    {dataVals.map((v, i) => (
      <g>
        <rect x={40 + i * 108} y="230" width="100" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={40 + i * 108 + 50} y="246" text-anchor="middle" font-size="10" fill="var(--muted)">{dataAddrs3[i]}</text>
        <text x={40 + i * 108 + 50} y="265" text-anchor="middle" font-size="13" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="40" y="300" font-size="12" fill="var(--ink)">{t.cellW} {addr202} {t.endsHolding} {val42}</text>
    <text x="40" y="322" font-size="13" fill="var(--accent)">{traceFormula}</text>
    <text x="40" y="344" font-size="12" fill="var(--muted)">{t.regsBefore} {initState}</text>

    <text x="400" y="100" font-size="12" fill="var(--ink)">{t.traceTitle}</text>
    {pcs.map((pc, i) => (
      <g>
        <rect x="400" y={rowY[i]} width="370" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <rect x="410" y={rowY[i] + 10} width="38" height="24" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
        <text x="429" y={rowY[i] + 27} text-anchor="middle" font-size="13" fill="var(--card)">{pc}</text>
        <text x="458" y={rowY[i] + 20} font-size="12" fill="var(--ink)">{instrs[i]}</text>
        <text x="458" y={rowY[i] + 37} font-size="12" fill="var(--accent)">{results[i]}</text>
        <text x="760" y={rowY[i] + 27} text-anchor="end" font-size="11" fill="var(--muted)">{t.cycleW} {cyc[i]}</text>
      </g>
    ))}
    {flowFrom.map((fy) => (
      <g>
        <line x1="585" y1={fy} x2="585" y2={fy + 10} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`577,${fy + 10} 593,${fy + 10} 585,${fy + 16}`} fill="var(--accent)" />
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--ink)">{t.pcSweepL} {pcSweep}</text>
  </svg>
  <figcaption style="text-align: center;">{t.capA} {progRange} {t.capB} {dataRange} {t.capC} {val25}, {val17}, {ZERO}{period} {t.capCycle} {cyc[0]} {openP}{t.pcName}{eq}{pcs[0]}{closeP}: {instrs[0]} {arrowR} {r0e25}{period} {t.capCycle} {cyc[1]} {openP}{t.pcName}{eq}{pcs[1]}{closeP}: {instrs[1]} {arrowR} {r1e17}{period} {t.capCycle} {cyc[2]} {openP}{t.pcName}{eq}{pcs[2]}{closeP}: {instrs[2]} {arrowR} {r0e42}{period} {t.capCycle} {cyc[3]} {openP}{t.pcName}{eq}{pcs[3]}{closeP}: {instrs[3]} {arrowR} {t.cellW} {addr202} {eq} {val42}{period} {t.pcSweepL} {pcSweep}{period}</figcaption>
</figure>
