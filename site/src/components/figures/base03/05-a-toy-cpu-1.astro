---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Toy CPU anatomy: two registers, program counter, memory cells, and ALU",
    headline: "A CPU IN FOUR PARTS",
    sub: "registers · counter · memory · adder — the same anatomy as any real chip",
    pcName: "PC",
    pcLine1: "next instruction",
    pcLine2: "address to fetch",
    regLine1: "two registers",
    bitWord: "-bit",
    memName: "memory",
    cellsWord: "cells",
    progWord: "program",
    dataWord: "data",
    aluName: "ALU",
    aluLine1: "adds two values",
    fetchLabel: "next fetch address",
    bottomNote: "the same four parts live in every real processor",
    capA: "The toy CPU has four parts: two",
    capB: "-bit registers",
    capC: "a program counter holding the next instruction address,",
    capD: "memory cells",
    capE: "program,",
    capF: "data, and an ALU computing",
  },
  ru: {
    svgTitle: "Анатомия игрушечного CPU: два регистра, счётчик команд, ячейки памяти и АЛУ",
    headline: "CPU ИЗ ЧЕТЫРЁХ ЧАСТЕЙ",
    sub: "регистры · счётчик · память · сумматор — та же анатомия, что у настоящего чипа",
    pcName: "СК",
    pcLine1: "адрес следующей",
    pcLine2: "инструкции",
    regLine1: "два регистра",
    bitWord: "-бит",
    memName: "память",
    cellsWord: "ячеек",
    progWord: "программа",
    dataWord: "данные",
    aluName: "АЛУ",
    aluLine1: "складывает два значения",
    fetchLabel: "адрес следующей выборки",
    bottomNote: "те же четыре части — в каждом реальном процессоре",
    capA: "У игрушечного CPU четыре части: два",
    capB: "-битных регистра",
    capC: "счётчик команд с адресом следующей инструкции, память на",
    capD: "ячеек",
    capE: "программа,",
    capF: "данные, и АЛУ, вычисляющее",
  },
};

const t = dict[lang];

const eight = "8";
const regsTitle = "R0 · R1";
const rangeFull = "0–255";
const cellCount = "256";
const progRange = "0–7";
const dataAddrs = "200 · 201 · 202";
const dataRange = "200–202";
const addFormula = "R0 ← R0 + R1";
const loadStore = "LOAD · STORE";
const addMn = "ADD";
const openP = "(";
const closeP = ")";
const period = ".";
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="100" width="200" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="130" y="130" text-anchor="middle" font-size="16" fill="var(--ink)">{t.pcName}</text>
    <text x="130" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.pcLine1}</text>
    <text x="130" y="175" text-anchor="middle" font-size="12" fill="var(--muted)">{t.pcLine2}</text>

    <rect x="300" y="100" width="200" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="130" text-anchor="middle" font-size="16" fill="var(--ink)">{regsTitle}</text>
    <text x="400" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.regLine1}</text>
    <text x="400" y="175" text-anchor="middle" font-size="12" fill="var(--muted)">{eight}{t.bitWord} {rangeFull}</text>

    <rect x="570" y="100" width="200" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="670" y="130" text-anchor="middle" font-size="16" fill="var(--ink)">{t.aluName}</text>
    <text x="670" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.aluLine1}</text>
    <text x="670" y="178" text-anchor="middle" font-size="13" fill="var(--ink)">{addFormula}</text>

    <line x1="570" y1="140" x2="512" y2="140" stroke="var(--accent)" stroke-width="2" />
    <polygon points="512,133 512,147 500,140" fill="var(--accent)" />
    <text x="535" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{addMn}</text>

    <rect x="30" y="270" width="740" height="90" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="300" text-anchor="middle" font-size="14" fill="var(--ink)">{t.memName} {cellCount} {t.cellsWord}</text>
    <text x="400" y="325" text-anchor="middle" font-size="13" fill="var(--muted)">{progRange} {t.progWord} · {dataAddrs} {t.dataWord}</text>

    <line x1="130" y1="210" x2="130" y2="258" stroke="var(--accent)" stroke-width="2" />
    <polygon points="123,258 137,258 130,270" fill="var(--accent)" />
    <text x="142" y="245" font-size="12" fill="var(--ink)">{t.fetchLabel}</text>

    <line x1="400" y1="270" x2="400" y2="222" stroke="var(--accent)" stroke-width="2" />
    <polygon points="393,222 407,222 400,210" fill="var(--accent)" />
    <text x="412" y="245" font-size="12" fill="var(--ink)">{loadStore}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bottomNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.capA} {eight}{t.capB} {regsTitle} {openP}{rangeFull}{closeP}, {t.capC} {cellCount} {t.capD} {openP}{progRange} {t.capE} {dataRange} {t.capF} {addFormula}{period}</figcaption>
</figure>
