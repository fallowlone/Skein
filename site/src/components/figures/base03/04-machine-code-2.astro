---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Program counter points at address 100 as instruction, LOAD points at data",
    headline: "INSTRUCTIONS LIVE AT ORDINARY ADDRESSES",
    sub: "memory is one row of byte cells — program bytes sit in the same row",
    pcBox: "PC → 100",
    loadBox: "LOAD → 102",
    kinds: ["instruction", "data"],
    rule: "PC → cell = instruction · LOAD → cell = data",
    note: "cells do not “know” what they hold",
    caption:
      "Instructions sit in regular memory cells: address 100 and 104 hold instruction bytes, data bytes may sit between them. The context decides: if the program counter points at a cell it is an instruction, if a LOAD points at it the bytes are data.",
  },
  ru: {
    svgTitle: "Счётчик команд указывает на адрес 100 как на инструкцию, LOAD — на данные",
    headline: "ИНСТРУКЦИИ ЖИВУТ ПО ОБЫЧНЫМ АДРЕСАМ",
    sub: "память — один ряд байтовых ячеек, байты программы — в том же ряду",
    pcBox: "PC → 100",
    loadBox: "LOAD → 102",
    kinds: ["инструкция", "данные"],
    rule: "PC → ячейка = инструкция · LOAD → ячейка = данные",
    note: "ячейки не «знают», что хранят",
    caption:
      "Инструкции хранятся в обычных ячейках памяти: адреса 100 и 104 содержат байты инструкций, между ними могут лежать байты данных. Решает контекст: если на ячейку указывает счётчик команд — это инструкция, если указывает LOAD — байты интерпретируются как данные.",
  },
};

const t = dict[lang];

const addrs = ["100", "101", "102", "103", "104", "105"];
const kinds = [0, 0, 1, 1, 0, 0];
const mx0 = 92;
const mw = 96;
const mgap = 8;
const my = 206;
const mh = 64;
const memCells = addrs.map((a, i) => ({ a, x: mx0 + i * (mw + mgap), k: kinds[i] }));
const pcArrowX = mx0 + mw / 2;
const loadArrowX = mx0 + 2 * (mw + mgap) + mw / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x={pcArrowX - 75} y="76" width="150" height="44" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x={pcArrowX} y="103" text-anchor="middle" font-size="14" fill="var(--card)">{t.pcBox}</text>

    <rect x={loadArrowX - 75} y="76" width="150" height="44" fill="var(--ink)" stroke="var(--ink)" stroke-width="2" />
    <text x={loadArrowX} y="103" text-anchor="middle" font-size="14" fill="var(--card)">{t.loadBox}</text>

    <line x1={pcArrowX} y1="120" x2={pcArrowX} y2="194" stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${pcArrowX - 8},194 ${pcArrowX + 8},194 ${pcArrowX},${my}`} fill="var(--accent)" />

    <line x1={loadArrowX} y1="120" x2={loadArrowX} y2="194" stroke="var(--ink)" stroke-width="2" />
    <polygon points={`${loadArrowX - 8},194 ${loadArrowX + 8},194 ${loadArrowX},${my}`} fill="var(--ink)" />

    {memCells.map((c) => (
      <g>
        <rect x={c.x} y={my} width={mw} height={mh} fill="var(--card)" stroke={c.k === 0 ? "var(--ink)" : "var(--muted)"} stroke-width="2" />
        <text x={c.x + mw / 2} y={my + 24} text-anchor="middle" font-size="12" fill="var(--muted)">{c.a}</text>
        <text x={c.x + mw / 2} y={my + 48} text-anchor="middle" font-size="13" fill="var(--ink)">{t.kinds[c.k]}</text>
      </g>
    ))}

    <text x="400" y="318" text-anchor="middle" font-size="14" fill="var(--ink)">{t.rule}</text>
    <text x="400" y="346" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
