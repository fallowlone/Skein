---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "CPU reads value 25 from address 10 and writes value 55 to address 12, overwriting 0",
    headline: "READ BY ADDRESS · WRITE ADDRESS PLUS VALUE",
    sub: "address in → value out · no scanning",
    cpu: "CPU",
    cpuSub: "names the address",
    memory: "memory",
    readWord: "read",
    writeWord: "write",
    addressWord: "address",
    valueWord: "value",
    afterWord: "after",
    othersUnchanged: "others unchanged",
    caption:
      "To read, the CPU names address 10 and gets back 25; to write, it sends address 12 plus 55, overwriting 0. Addresses 10 and 11 stay unchanged — only the written cell changes, and the CPU never scans cells to find a value.",
  },
  ru: {
    svgTitle: "CPU читает значение 25 по адресу 10 и пишет значение 55 по адресу 12, затирая 0",
    headline: "ЧТЕНИЕ ПО АДРЕСУ · ЗАПИСЬ: АДРЕС И ЗНАЧЕНИЕ",
    sub: "адрес на входе → значение на выходе · без перебора",
    cpu: "CPU",
    cpuSub: "называет адрес",
    memory: "память",
    readWord: "чтение",
    writeWord: "запись",
    addressWord: "адрес",
    valueWord: "значение",
    afterWord: "после",
    othersUnchanged: "остальные не изменились",
    caption:
      "Чтобы прочитать, CPU называет адрес 10 и получает 25; чтобы записать, отправляет адрес 12 плюс 55, затирая 0. Адреса 10 и 11 не меняются — меняется только записанная ячейка, а CPU никогда не перебирает ячейки в поисках значения.",
  },
};

const t = dict[lang];

const rows = [
  { addr: "10", val: "25" },
  { addr: "11", val: "30" },
  { addr: "12", val: "0 → 55" },
];
const newVal = "55";

const cpuX = 60;
const cpuW = 150;
const cpuEdge = cpuX + cpuW;
const memX = 470;
const addrW = 80;
const valX = memX + addrW;
const valW = 150;
const rowH = 46;
const rowY = (i: number) => 130 + i * 60;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={memX + (addrW + valW) / 2} y="114" text-anchor="middle" font-size="13" fill="var(--ink)">{t.memory}</text>

    <rect x={cpuX} y="140" width={cpuW} height="140" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={cpuX + cpuW / 2} y="205" text-anchor="middle" font-family="var(--font-display)" font-size="26" fill="var(--ink)">{t.cpu}</text>
    <text x={cpuX + cpuW / 2} y="230" text-anchor="middle" font-size="12" fill="var(--muted)">{t.cpuSub}</text>

    {rows.map((r, i) => (
      <g>
        <rect x={memX} y={rowY(i)} width={addrW} height={rowH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={memX + addrW / 2} y={rowY(i) + 30} text-anchor="middle" font-size="15" fill="var(--ink)">{r.addr}</text>
        <rect x={valX} y={rowY(i)} width={valW} height={rowH} fill="var(--card)" stroke={i === 2 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 2 ? 3 : 2} />
        <text x={valX + valW / 2} y={rowY(i) + 30} text-anchor="middle" font-size="15" fill="var(--ink)">{r.val}</text>
      </g>
    ))}

    <line x1={cpuEdge} y1="146" x2={memX - 12} y2="146" stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${memX},146 ${memX - 12},139 ${memX - 12},153`} fill="var(--accent)" />
    <text x="340" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.readWord} · {t.addressWord} {rows[0].addr}</text>

    <line x1={memX} y1="166" x2={cpuEdge + 12} y2="166" stroke="var(--ink)" stroke-width="2" />
    <polygon points={`${cpuEdge},166 ${cpuEdge + 12},159 ${cpuEdge + 12},173`} fill="var(--ink)" />
    <text x="340" y="186" text-anchor="middle" font-size="12" fill="var(--ink)">{t.valueWord} {rows[0].val}</text>

    <line x1={cpuEdge} y1="273" x2={memX - 12} y2="273" stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${memX},273 ${memX - 12},266 ${memX - 12},280`} fill="var(--accent)" />
    <text x="340" y="295" text-anchor="middle" font-size="12" fill="var(--ink)">{t.writeWord} {rows[2].addr} ← {newVal}</text>

    <text x="400" y="350" text-anchor="middle" font-size="14" fill="var(--ink)">{t.afterWord}: {rows[2].addr} = {newVal} · {t.othersUnchanged}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
