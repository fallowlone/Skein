---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Heap object outlives the function: add returns and its frame is popped, the object stays",
    headline: "HEAP DATA OUTLIVES THE FUNCTION",
    sub: "heap data outlives the function; the stack frame does not",
    panelL: "main calls add",
    panelR: "add returns",
    stack: "stack",
    heap: "heap",
    frameMain: "main frame",
    frameAdd: "add frame",
    heapObj: "heap object",
    pointer: "pointer",
    popped: "add: popped",
    mgmt: "request: malloc / new · release: free / delete / garbage collector",
    note: "while main holds a pointer, the heap object lives on",
    caption:
      "While add runs, its frame points to a heap object; after add returns, the frame is popped but the object lives on while main holds a pointer. Heap blocks are requested with malloc/new and released with free/delete — or reclaimed by a garbage collector.",
  },
  ru: {
    svgTitle: "Объект кучи переживает функцию: add возвращается и её фрейм вытолкнут, а объект остаётся",
    headline: "ДАННЫЕ КУЧИ ПЕРЕЖИВАЮТ ФУНКЦИЮ",
    sub: "данные кучи переживают функцию; фрейм стека — нет",
    panelL: "main вызывает add",
    panelR: "add возвращается",
    stack: "стек",
    heap: "куча",
    frameMain: "фрейм main",
    frameAdd: "фрейм add",
    heapObj: "объект кучи",
    pointer: "указатель",
    popped: "add: вытолкнут",
    mgmt: "запрос: malloc / new · освобождение: free / delete / сборщик мусора",
    note: "пока main держит указатель — объект кучи живёт",
    caption:
      "Пока выполняется add, её фрейм указывает на объект кучи; после возврата add фрейм вытолкнут, но объект живёт, пока main держит указатель. Блоки кучи запрашиваются через malloc/new и освобождаются через free/delete — или возвращаются сборщиком мусора.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="78" width="340" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="1" />
    <text x="210" y="102" text-anchor="middle" font-size="13" fill="var(--ink)">{t.panelL}</text>
    <text x="120" y="124" text-anchor="middle" font-size="12" fill="var(--muted)">{t.stack}</text>
    <text x="300" y="124" text-anchor="middle" font-size="12" fill="var(--muted)">{t.heap}</text>
    <rect x="60" y="132" width="120" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="120" y="161" text-anchor="middle" font-size="13" fill="var(--ink)">{t.frameAdd}</text>
    <rect x="60" y="182" width="120" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="120" y="211" text-anchor="middle" font-size="13" fill="var(--ink)">{t.frameMain}</text>
    <rect x="240" y="132" width="120" height="96" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="300" y="184" text-anchor="middle" font-size="12" fill="var(--card)">{t.heapObj}</text>
    <line x1="180" y1="155" x2="232" y2="155" stroke="var(--accent)" stroke-width="2" />
    <polygon points="232,150 232,160 240,155" fill="var(--accent)" />
    <text x="210" y="146" text-anchor="middle" font-size="10" fill="var(--ink)">{t.pointer}</text>

    <rect x="420" y="78" width="340" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="1" />
    <text x="590" y="102" text-anchor="middle" font-size="13" fill="var(--ink)">{t.panelR}</text>
    <text x="500" y="124" text-anchor="middle" font-size="12" fill="var(--muted)">{t.stack}</text>
    <text x="680" y="124" text-anchor="middle" font-size="12" fill="var(--muted)">{t.heap}</text>
    <rect x="440" y="132" width="120" height="46" fill="none" stroke="var(--muted)" stroke-width="2" stroke-dasharray="5 4" />
    <text x="500" y="161" text-anchor="middle" font-size="10" fill="var(--muted)">{t.popped}</text>
    <rect x="440" y="182" width="120" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="500" y="211" text-anchor="middle" font-size="13" fill="var(--ink)">{t.frameMain}</text>
    <rect x="620" y="132" width="120" height="96" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="680" y="184" text-anchor="middle" font-size="12" fill="var(--card)">{t.heapObj}</text>
    <line x1="560" y1="205" x2="612" y2="205" stroke="var(--accent)" stroke-width="2" />
    <polygon points="612,200 612,210 620,205" fill="var(--accent)" />
    <text x="590" y="196" text-anchor="middle" font-size="10" fill="var(--ink)">{t.pointer}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mgmt}</text>
    <text x="400" y="366" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
