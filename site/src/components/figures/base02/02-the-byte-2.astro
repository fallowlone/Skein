---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Reading a byte value from bit weights: leftmost bit 7 is most significant, rightmost bit 0 least significant",
    bitUp: "BIT",
    msb: "MSB",
    lsb: "LSB",
    posA: "position k contributes",
    posB: "if that bit is",
    weightWord: "weight",
    contribWord: "contributes",
    asciiNote: 'is the ASCII code for the letter "A"',
    rangeA: "any value from",
    rangeB: "to",
    caption:
      'Byte 01000001: bit 7 (MSB) is leftmost, bit 0 (LSB) is rightmost, and position k contributes 2^k when that bit is 1 — bit 6 gives 64, bit 0 gives 1, total 64 + 1 = 65, the ASCII code for "A".',
  },
  ru: {
    svgTitle: "Чтение значения байта по весам битов: самый левый бит 7 — старший значащий, самый правый бит 0 — младший",
    bitUp: "БИТ",
    msb: "СЗБ",
    lsb: "МЗБ",
    posA: "позиция k вносит вклад",
    posB: "если этот бит равен",
    weightWord: "вес",
    contribWord: "вклад",
    asciiNote: "— это ASCII-код буквы «A»",
    rangeA: "любое значение от",
    rangeB: "до",
    caption:
      "Байт 01000001: бит 7 (СЗБ) самый левый, бит 0 (МЗБ) самый правый, и позиция k вносит вклад 2^k, если этот бит равен 1 — бит 6 даёт 64, бит 0 даёт 1, итого 64 + 1 = 65, ASCII-код буквы «A».",
  },
};

const t = dict[lang];

const n7 = "7";
const zero = "0";
const one = "1";
const n255 = "255";
const pow2k = "2^k";
const total65 = "64 + 1 = 65";
const bits = ["0", "1", "0", "0", "0", "0", "0", "1"];
const labels = ["b7", "b6", "b5", "b4", "b3", "b2", "b1", "b0"];
const weights = ["128", "64", "32", "16", "8", "4", "2", "1"];
const contribs = ["0", "64", "0", "0", "0", "0", "0", "1"];
const lit = bits.map((b) => b === "1");

const x0 = 102;
const cw = 64;
const step = 76;
const cellY = 128;
const ch = 48;
const cellX = (i: number) => x0 + i * step;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.bitUp} {n7} = {t.msb} · {t.bitUp} {zero} = {t.lsb}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.posA} {pow2k} {t.posB} {one}</text>

    {labels.map((l, i) => (
      <text x={cellX(i) + cw / 2} y="118" text-anchor="middle" font-size="12" fill="var(--muted)">{l}</text>
    ))}
    {bits.map((b, i) => (
      <g>
        <rect x={cellX(i)} y={cellY} width={cw} height={ch} fill={lit[i] ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y={cellY + 32} text-anchor="middle" font-size="16" fill={lit[i] ? "var(--card)" : "var(--ink)"}>{b}</text>
      </g>
    ))}

    <text x="94" y="204" text-anchor="end" font-size="12" fill="var(--ink)">{t.weightWord}</text>
    {weights.map((w, i) => (
      <text x={cellX(i) + cw / 2} y="204" text-anchor="middle" font-size="13" fill={lit[i] ? "var(--accent)" : "var(--muted)"}>{w}</text>
    ))}

    <text x="94" y="232" text-anchor="end" font-size="12" fill="var(--ink)">{t.contribWord}</text>
    {contribs.map((c, i) => (
      <text x={cellX(i) + cw / 2} y="232" text-anchor="middle" font-size="13" fill={lit[i] ? "var(--accent)" : "var(--muted)"}>{c}</text>
    ))}

    <text x="400" y="292" text-anchor="middle" font-size="16" fill="var(--ink)">{total65} {t.asciiNote}</text>
    <text x="400" y="348" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rangeA} {zero} {t.rangeB} {n255}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
