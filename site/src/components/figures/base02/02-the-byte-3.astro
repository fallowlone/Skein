---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Word size groups consecutive bytes for one CPU operation while memory stays byte-addressed",
    headline: "WORD = BYTES IN ONE OPERATION",
    sub: "memory is addressed one byte at a time · the CPU loads a word at once",
    wordColon: "-bit word:",
    bytes4: "bytes",
    bytes8: "bytes at once",
    addr: "addr",
    bitsWord: "bits",
    bytesF: "bytes",
    bitsPerByte: "bits/byte",
    bitsTotal: "bits",
    note: "addressing stays one byte at a time",
    caption:
      "A word is the group the CPU processes in one operation: a 32-bit word spans 4 bytes, a 64-bit word 8 bytes at once — 8 bytes × 8 bits/byte = 64 bits — yet memory is always addressed one byte at a time.",
  },
  ru: {
    svgTitle: "Размер слова группирует последовательные байты для одной операции CPU, а память остаётся байтово-адресуемой",
    headline: "СЛОВО = БАЙТЫ ЗА ОДНУ ОПЕРАЦИЮ",
    sub: "память адресуется побайтово · слово загружается за одно чтение",
    wordColon: "-битное слово:",
    bytes4: "байта",
    bytes8: "байтов сразу",
    addr: "адрес",
    bitsWord: "битов",
    bytesF: "байт",
    bitsPerByte: "битов/байт",
    bitsTotal: "бита",
    note: "адресация остаётся побайтовой",
    caption:
      "Слово — группа, которую CPU обрабатывает за одну операцию: 32-битное слово занимает 4 байта, 64-битное — 8 байтов сразу: 8 байт × 8 битов/байт = 64 бита — при этом память всегда адресуется побайтово.",
  },
};

const t = dict[lang];

const n4 = "4";
const n8 = "8";
const n32 = "32";
const n64 = "64";
const addrs = ["0", "1", "2", "3", "4", "5", "6", "7"];

const x0 = 102;
const cw = 64;
const step = 76;
const cellY = 200;
const ch = 52;
const cellX = (i: number) => x0 + i * step;
const right3 = x0 + 3 * step + cw;
const right7 = x0 + 7 * step + cw;
const mid3 = (x0 + right3) / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="102" text-anchor="middle" font-size="13" fill="var(--ink)">{n64}{t.wordColon} {n8} {t.bytes8}</text>
    <line x1={x0} y1="112" x2={right7} y2="112" stroke="var(--accent)" stroke-width="2" />
    <line x1={x0} y1="112" x2={x0} y2={cellY} stroke="var(--accent)" stroke-width="2" />
    <line x1={right7} y1="112" x2={right7} y2={cellY} stroke="var(--accent)" stroke-width="2" />

    <text x={mid3} y="150" text-anchor="middle" font-size="13" fill="var(--ink)">{n32}{t.wordColon} {n4} {t.bytes4}</text>
    <line x1={x0} y1="160" x2={right3} y2="160" stroke="var(--ink)" stroke-width="2" />
    <line x1={x0} y1="160" x2={x0} y2={cellY} stroke="var(--ink)" stroke-width="2" />
    <line x1={right3} y1="160" x2={right3} y2={cellY} stroke="var(--ink)" stroke-width="2" />

    {addrs.map((a, i) => (
      <g>
        <rect x={cellX(i)} y={cellY} width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y={cellY + 22} text-anchor="middle" font-size="12" fill="var(--ink)">{t.addr} {a}</text>
        <text x={cellX(i) + cw / 2} y={cellY + 41} text-anchor="middle" font-size="11" fill="var(--muted)">{n8} {t.bitsWord}</text>
      </g>
    ))}

    <text x="400" y="305" text-anchor="middle" font-size="14" fill="var(--ink)">{n8} {t.bytesF} × {n8} {t.bitsPerByte} = {n64} {t.bitsTotal}</text>
    <text x="400" y="355" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
