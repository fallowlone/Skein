---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Address space split into regions: stack near the top, heap near the bottom, same RAM",
    headline: "STACK ON TOP, HEAP AT THE BOTTOM",
    sub: "the OS divides the address space into named regions",
    stackRegion: "stack region",
    heapRegion: "heap region",
    nearTop: "near the top",
    nearBottom: "near the bottom",
    stack: "stack",
    heap: "heap",
    mid1: "middle",
    mid2: "barely used",
    note: "both are backed by the same RAM chips",
    caption:
      "The OS divides the address space into named regions: the stack sits near the top and the heap near the bottom, while the middle is barely used. Both are address ranges in the same RAM — they differ only in management and data lifetime.",
  },
  ru: {
    svgTitle: "Адресное пространство, разбитое на области: стек вверху, куча внизу, одна память",
    headline: "СТЕК ВВЕРХУ, КУЧА ВНИЗУ",
    sub: "ОС разбивает адресное пространство на именованные области",
    stackRegion: "область стека",
    heapRegion: "область кучи",
    nearTop: "в верхней части",
    nearBottom: "в нижней части",
    stack: "стек",
    heap: "куча",
    mid1: "середина",
    mid2: "почти не используется",
    note: "обе подкреплены теми же чипами оперативной памяти",
    caption:
      "ОС разбивает адресное пространство на именованные области: стек — в верхней части, куча — в нижней, а середина почти не используется. Обе области — диапазоны адресов в одной и той же ОЗУ и различаются только управлением и временем жизни данных.",
  },
};

const t = dict[lang];

const barX = 300;
const barW = 200;
const barCX = barX + barW / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x={barX} y="96" width={barW} height="60" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x={barCX} y="131" text-anchor="middle" font-size="15" fill="var(--card)">{t.stack}</text>
    <text x="284" y="131" text-anchor="end" font-size="13" fill="var(--ink)">{t.stackRegion}</text>
    <text x="516" y="131" text-anchor="start" font-size="13" fill="var(--ink)">{t.nearTop}</text>
    <line x1="288" y1="126" x2={barX} y2="126" stroke="var(--muted)" stroke-width="1" />
    <line x1={barX + barW} y1="126" x2="512" y2="126" stroke="var(--muted)" stroke-width="1" />

    <rect x={barX} y="156" width={barW} height="140" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={barCX} y="218" text-anchor="middle" font-size="13" fill="var(--muted)">{t.mid1}</text>
    <text x={barCX} y="240" text-anchor="middle" font-size="13" fill="var(--muted)">{t.mid2}</text>

    <rect x={barX} y="296" width={barW} height="60" fill="var(--ink)" stroke="var(--ink)" stroke-width="2" />
    <text x={barCX} y="331" text-anchor="middle" font-size="15" fill="var(--card)">{t.heap}</text>
    <text x="284" y="331" text-anchor="end" font-size="13" fill="var(--ink)">{t.heapRegion}</text>
    <text x="516" y="331" text-anchor="start" font-size="13" fill="var(--ink)">{t.nearBottom}</text>
    <line x1="288" y1="326" x2={barX} y2="326" stroke="var(--muted)" stroke-width="1" />
    <line x1={barX + barW} y1="326" x2="512" y2="326" stroke="var(--muted)" stroke-width="1" />

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
