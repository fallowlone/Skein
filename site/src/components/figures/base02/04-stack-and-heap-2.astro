---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Stack frames in LIFO order: main runs, main calls add, add returns",
    headline: "LIFO: LAST IN, FIRST OUT",
    sub: "the frame added last is always removed first",
    s1: "only main runs",
    s2: "main calls add",
    s3: "add returns",
    frameMain: "main frame",
    frameAdd: "add frame",
    top: "top",
    callL1: "call",
    callL2: "frame added",
    retL1: "return",
    retL2: "frame removed",
    note: "no frame survives longer than its function",
    caption:
      "main runs alone with one frame; when main calls add, the add frame is added on top; when add returns, its frame is removed and main is on top again. The last frame in is always the first out — no frame survives longer than its function.",
  },
  ru: {
    svgTitle: "Фреймы стека в порядке LIFO: выполняется main, main вызывает add, add возвращается",
    headline: "LIFO: ПОСЛЕДНИМ ВОШЁЛ — ПЕРВЫМ ВЫШЕЛ",
    sub: "последний добавленный фрейм всегда удаляется первым",
    s1: "выполняется только main",
    s2: "main вызывает add",
    s3: "add возвращается",
    frameMain: "фрейм main",
    frameAdd: "фрейм add",
    top: "вершина",
    callL1: "вызов",
    callL2: "фрейм добавлен",
    retL1: "возврат",
    retL2: "фрейм удалён",
    note: "ни один фрейм не пережил свою функцию",
    caption:
      "main выполняется одна с одним фреймом; когда main вызывает add, фрейм add добавляется поверх; когда add возвращается, её фрейм удаляется, и фрейм main снова на вершине. Последний вошедший фрейм всегда выходит первым — ни один фрейм не живёт дольше своей функции.",
  },
};

const t = dict[lang];

const frameW = 140;
const frameH = 52;
const baseY = 278;
const arrowY = 304;

const cols = [
  { x: 70, state: t.s1, frames: ["main"], top: 278 },
  { x: 330, state: t.s2, frames: ["main", "add"], top: 222 },
  { x: 590, state: t.s3, frames: ["main"], top: 278 },
];

const arrows = [
  { x1: 218, x2: 322, tip: 330, x: 270, l1: t.callL1, l2: t.callL2 },
  { x1: 478, x2: 582, tip: 590, x: 530, l1: t.retL1, l2: t.retL2 },
];

const frameName = (f: string) => (f === "add" ? t.frameAdd : t.frameMain);
const frameY = (j: number) => baseY - j * (frameH + 4);
const head = (cx: number, tipY: number) => `${cx - 5},${tipY - 3} ${cx + 5},${tipY - 3} ${cx},${tipY}`;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {cols.map((c) => (
      <g>
        <text x={c.x + frameW / 2} y="190" text-anchor="middle" font-size="13" fill="var(--ink)">{c.state}</text>
        {c.frames.map((f, j) => (
          <g>
            <rect x={c.x} y={frameY(j)} width={frameW} height={frameH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
            <text x={c.x + frameW / 2} y={frameY(j) + 32} text-anchor="middle" font-size="15" fill="var(--ink)">{frameName(f)}</text>
          </g>
        ))}
        <text x={c.x + frameW / 2} y={c.top - 12} text-anchor="middle" font-size="12" fill="var(--muted)">{t.top}</text>
        <line x1={c.x + frameW / 2} y1={c.top - 9} x2={c.x + frameW / 2} y2={c.top - 3} stroke="var(--accent)" stroke-width="2" />
        <polygon points={head(c.x + frameW / 2, c.top)} fill="var(--accent)" />
      </g>
    ))}

    {arrows.map((a) => (
      <g>
        <text x={a.x} y="258" text-anchor="middle" font-size="11" fill="var(--ink)">{a.l1}</text>
        <text x={a.x} y="276" text-anchor="middle" font-size="11" fill="var(--ink)">{a.l2}</text>
        <line x1={a.x1} y1={arrowY} x2={a.x2} y2={arrowY} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${a.x2},${arrowY - 6} ${a.x2},${arrowY + 6} ${a.tip},${arrowY}`} fill="var(--accent)" />
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
