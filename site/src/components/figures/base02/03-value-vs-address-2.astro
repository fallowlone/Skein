---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    headline: "A VALUE CAN ITSELF BE AN ADDRESS",
    sub: "a pointer: a cell whose content tells you where to look next",
    cellWord: "cell",
    cellWordAcc: "cell",
    addrWord: "address",
    pointsTo: "points to",
    usedAsAddress: "used as address",
    dataWord: "data",
    pointedTo: "the cell being pointed to",
    note: "The bits did not change; only the use changed.",
    svgA: "Cell A at address ",
    svgB: " holds ",
    svgC: " used as an address, pointing to cell B at address ",
    capA: "Cell A at address ",
    capB: " holds ",
    capC: ", which the program uses as an address: A points to cell B at address ",
    capD: ". Reading B through A is dereferencing — the bits never changed, only their use did.",
  },
  ru: {
    headline: "ЗНАЧЕНИЕ САМО МОЖЕТ БЫТЬ АДРЕСОМ",
    sub: "указатель: ячейка, содержимое которой говорит, куда смотреть дальше",
    cellWord: "ячейка",
    cellWordAcc: "ячейку",
    addrWord: "адрес",
    pointsTo: "указывает на",
    usedAsAddress: "использовано как адрес",
    dataWord: "данные",
    pointedTo: "ячейка, на которую он указывает",
    note: "Биты в ячейке не изменились; изменилось только использование.",
    svgA: "Ячейка A по адресу ",
    svgB: " хранит ",
    svgC: ", использованное как адрес и указывающее на ячейку B по адресу ",
    capA: "Ячейка A по адресу ",
    capB: " хранит ",
    capC: ", которое программа использует как адрес: A указывает на ячейку B по адресу ",
    capD: ". Чтение B через A — разыменование: биты не изменились, изменилось лишь их использование.",
  },
};

const t = dict[lang];

const aName = "A";
const bName = "B";
const aAddr = "5";
const aVal = "12";
const bAddr = "12";

const svgTitleEn = dict.en.svgA + aAddr + dict.en.svgB + aVal + dict.en.svgC + bAddr;
const svgTitleRu = dict.ru.svgA + aAddr + dict.ru.svgB + aVal + dict.ru.svgC + bAddr;
const caption = t.capA + aAddr + t.capB + aVal + t.capC + bAddr + t.capD;

const cellAX = 120;
const cellBX = 530;
const cw = 150;
const cellY = 165;
const cellH = 110;
const centerA = cellAX + cw / 2;
const centerB = cellBX + cw / 2;
const railY = 118;
const tipY = cellY;
const baseY = cellY - 12;
const arrowMid = (centerA + centerB) / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{svgTitleEn}</title>
    <title lang="ru">{svgTitleRu}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={arrowMid} y="104" text-anchor="middle" font-size="13" fill="var(--ink)">{t.cellWord} {aName} {t.pointsTo} {t.cellWordAcc} {bName}</text>
    <line x1={centerA} y1={cellY} x2={centerA} y2={railY} stroke="var(--accent)" stroke-width="2" />
    <line x1={centerA} y1={railY} x2={centerB} y2={railY} stroke="var(--accent)" stroke-width="2" />
    <line x1={centerB} y1={railY} x2={centerB} y2={baseY} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${centerB - 7},${baseY} ${centerB + 7},${baseY} ${centerB},${tipY}`} fill="var(--accent)" />

    <rect x={cellAX} y={cellY} width={cw} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={centerA} y="232" text-anchor="middle" font-size="30" fill="var(--ink)">{aVal}</text>
    <text x={centerA} y="300" text-anchor="middle" font-size="13" fill="var(--ink)">{t.cellWord} {aName} · {t.addrWord} {aAddr}</text>
    <text x={centerA} y="322" text-anchor="middle" font-size="13" fill="var(--accent)">{aVal} {t.usedAsAddress}</text>

    <rect x={cellBX} y={cellY} width={cw} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={centerB} y="230" text-anchor="middle" font-size="16" fill="var(--ink)">{t.dataWord}</text>
    <text x={centerB} y="300" text-anchor="middle" font-size="13" fill="var(--ink)">{t.cellWord} {bName} · {t.addrWord} {bAddr}</text>
    <text x={centerB} y="322" text-anchor="middle" font-size="13" fill="var(--muted)">{t.pointedTo}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{caption}</figcaption>
</figure>
