---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One cell at address 12 keeps its address while a write changes its value from 0 to 255",
    headline: "ADDRESS FIXED · VALUE CHANGES",
    sub: "address: which cell, fixed · value: what is inside, variable",
    before: "before",
    after: "after",
    addressWord: "address",
    writeWord: "write",
    gone: "is gone",
    unchanged: "unchanged",
    caption:
      "Writing a new value replaces the old one, which is gone with no record: the cell at address 12 holds 0 and then 255, while address 12 itself never changes. The address names the cell; only the value inside changes.",
  },
  ru: {
    svgTitle: "Ячейка по адресу 12 сохраняет адрес, а запись меняет её значение с 0 на 255",
    headline: "АДРЕС ФИКСИРОВАН · ЗНАЧЕНИЕ МЕНЯЕТСЯ",
    sub: "адрес: какая ячейка, фиксированный · значение: что внутри, изменяемое",
    before: "до",
    after: "после",
    addressWord: "адрес",
    writeWord: "запись",
    gone: "исчез",
    unchanged: "не изменился",
    caption:
      "Запись нового значения стирает старое без следа: ячейка по адресу 12 хранит 0, а затем 255, а сам адрес 12 не меняется никогда. Адрес называет ячейку; меняется только значение внутри.",
  },
};

const t = dict[lang];

const addr = "12";
const oldVal = "0";
const newVal = "255";

const leftX = 150;
const rightX = 530;
const cellW = 120;
const cellY = 175;
const cellH = 90;
const midY = 220;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={leftX + cellW / 2} y="140" text-anchor="middle" font-size="13" fill="var(--muted)">{t.before}</text>
    <text x={rightX + cellW / 2} y="140" text-anchor="middle" font-size="13" fill="var(--muted)">{t.after}</text>

    <text x={leftX + cellW / 2} y="163" text-anchor="middle" font-size="13" fill="var(--ink)">{t.addressWord} {addr}</text>
    <text x={rightX + cellW / 2} y="163" text-anchor="middle" font-size="13" fill="var(--ink)">{t.addressWord} {addr}</text>

    <rect x={leftX} y={cellY} width={cellW} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={leftX + cellW / 2} y={midY + 10} text-anchor="middle" font-size="30" fill="var(--ink)">{oldVal}</text>

    <rect x={rightX} y={cellY} width={cellW} height={cellH} fill="var(--accent)" stroke="var(--accent)" stroke-width="2" />
    <text x={rightX + cellW / 2} y={midY + 10} text-anchor="middle" font-size="30" fill="var(--card)">{newVal}</text>

    <line x1={leftX + cellW} y1={midY} x2={rightX - 12} y2={midY} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${rightX},${midY} ${rightX - 12},${midY - 7} ${rightX - 12},${midY + 7}`} fill="var(--accent)" />
    <text x="400" y={midY - 14} text-anchor="middle" font-size="13" fill="var(--ink)">{t.writeWord} {newVal}</text>

    <text x="400" y="325" text-anchor="middle" font-size="14" fill="var(--ink)">{oldVal} {t.gone} · {t.addressWord} {addr} {t.unchanged}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
