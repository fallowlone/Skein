---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Memory as a straight row of eight cells at addresses 0 to 7, each holding a value",
    headline: "MEMORY IS A ROW OF NUMBERED CELLS",
    sub: "address = which cell · value = what is inside",
    rowAddress: "address",
    rowValue: "value",
    firstCell: "first cell",
    readWord: "read",
    cellsWord: "cells",
    addressesWord: "addresses",
    caption:
      "Memory is a straight row of cells: eight cells have addresses 0 to 7, address 0 is the first cell, and each cell holds a value — reading address 3 returns 42. The address is the cell's number; the value is what sits inside.",
  },
  ru: {
    svgTitle: "Память как прямой ряд из восьми ячеек по адресам от 0 до 7, в каждой — значение",
    headline: "ПАМЯТЬ — РЯД ПРОНУМЕРОВАННЫХ ЯЧЕЕК",
    sub: "адрес — номер ячейки · значение — то, что в ней лежит",
    rowAddress: "адрес",
    rowValue: "значение",
    firstCell: "первая ячейка",
    readWord: "чтение",
    cellsWord: "ячеек",
    addressesWord: "адреса",
    caption:
      "Память — прямой ряд ячеек: восемь ячеек имеют адреса от 0 до 7, адрес 0 — первая ячейка, и каждая ячейка хранит значение — чтение адреса 3 возвращает 42. Адрес — номер ячейки; значение — то, что в ней лежит.",
  },
};

const t = dict[lang];

const addresses = ["0", "1", "2", "3", "4", "5", "6", "7"];
const values = ["17", "0", "255", "42", "8", "200", "1", "99"];
const cellCount = "8";
const firstAddr = "0";
const lastAddr = "7";
const readAddr = "3";
const readVal = "42";
const hi = 3;

const x0 = 110;
const cw = 66;
const step = 78;
const cellX = (i: number) => x0 + i * step;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="94" y="140" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowAddress}</text>
    <text x="94" y="188" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowValue}</text>
    {addresses.map((a, i) => (
      <g>
        <text x={cellX(i) + cw / 2} y="140" text-anchor="middle" font-size="14" fill={i === hi ? "var(--accent)" : "var(--ink)"}>{a}</text>
        <rect x={cellX(i)} y="152" width={cw} height="60" fill="var(--card)" stroke={i === hi ? "var(--accent)" : "var(--ink)"} stroke-width={i === hi ? 3 : 2} />
        <text x={cellX(i) + cw / 2} y="188" text-anchor="middle" font-size="15" fill="var(--ink)">{values[i]}</text>
      </g>
    ))}

    <line x1={x0} y1="226" x2={x0 + cw} y2="226" stroke="var(--accent)" stroke-width="3" />
    <text x={x0 + cw / 2} y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.firstCell} · {t.rowAddress} {firstAddr}</text>

    <text x="400" y="300" text-anchor="middle" font-size="14" fill="var(--ink)">{t.readWord} {readAddr} → {readVal}</text>
    <text x="400" y="330" text-anchor="middle" font-size="13" fill="var(--muted)">{cellCount} {t.cellsWord} → {t.addressesWord} {firstAddr}–{lastAddr}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
