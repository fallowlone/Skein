---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    headline: "VALUE VS. ADDRESS",
    sub: "address: fixed position number · value: bits that can change",
    addrWord: "address",
    fixedWord: "fixed",
    valueWord: "value",
    canChange: "can change",
    todayWord: "today",
    tomorrowWord: "tomorrow",
    note: "The address is how you find the cell. The value is what you find once you are there.",
    svgA: "Cell at address ",
    svgB: " holds ",
    svgC: " today and ",
    svgD: " tomorrow",
    capA: "A cell at address ",
    capB: " always keeps its address, but today it holds ",
    capC: " and tomorrow it may hold ",
    capD: ". The address finds the cell; the value is what you find there.",
  },
  ru: {
    headline: "ЗНАЧЕНИЕ И АДРЕС",
    sub: "адрес: фиксированный номер · значение: биты, которые могут меняться",
    addrWord: "адрес",
    fixedWord: "фиксированный",
    valueWord: "значение",
    canChange: "может меняться",
    todayWord: "сегодня",
    tomorrowWord: "завтра",
    note: "Адрес — это то, как ты находишь ячейку. Значение — то, что ты находишь, оказавшись там.",
    svgA: "Ячейка по адресу ",
    svgB: " хранит ",
    svgC: " сегодня и ",
    svgD: " завтра",
    capA: "Ячейка по адресу ",
    capB: " всегда сохраняет свой адрес, но сегодня хранит ",
    capC: ", а завтра — ",
    capD: ". Адрес находит ячейку; значение — то, что находишь там.",
  },
};

const t = dict[lang];

const addr = "12";
const todayVal = "255";
const tomorrowVal = "0";

const svgTitleEn = dict.en.svgA + addr + dict.en.svgB + todayVal + dict.en.svgC + tomorrowVal + dict.en.svgD;
const svgTitleRu = dict.ru.svgA + addr + dict.ru.svgB + todayVal + dict.ru.svgC + tomorrowVal + dict.ru.svgD;
const caption = t.capA + addr + t.capB + todayVal + t.capC + tomorrowVal + t.capD;

const cellAX = 150;
const cellBX = 470;
const cw = 140;
const cellY = 150;
const cellH = 110;
const midY = cellY + cellH / 2;
const centerA = cellAX + cw / 2;
const centerB = cellBX + cw / 2;
const arrowMid = (cellAX + cw + cellBX) / 2;
const tipX = cellBX;
const baseX = cellBX - 14;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{svgTitleEn}</title>
    <title lang="ru">{svgTitleRu}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={centerA} y="118" text-anchor="middle" font-size="14" fill="var(--ink)">{t.addrWord} {addr}</text>
    <text x={centerA} y="138" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fixedWord}</text>
    <rect x={cellAX} y={cellY} width={cw} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={centerA} y="218" text-anchor="middle" font-size="30" fill="var(--ink)">{todayVal}</text>
    <text x={centerA} y="292" text-anchor="middle" font-size="13" fill="var(--ink)">{t.todayWord}: {t.valueWord} {todayVal}</text>

    <text x={centerB} y="118" text-anchor="middle" font-size="14" fill="var(--ink)">{t.addrWord} {addr}</text>
    <text x={centerB} y="138" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fixedWord}</text>
    <rect x={cellBX} y={cellY} width={cw} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x={centerB} y="218" text-anchor="middle" font-size="30" fill="var(--ink)">{tomorrowVal}</text>
    <text x={centerB} y="292" text-anchor="middle" font-size="13" fill="var(--ink)">{t.tomorrowWord}: {t.valueWord} {tomorrowVal}</text>

    <line x1={cellAX + cw} y1={midY} x2={baseX} y2={midY} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${baseX},${midY - 7} ${baseX},${midY + 7} ${tipX},${midY}`} fill="var(--accent)" />
    <text x={arrowMid} y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.valueWord} {t.canChange}</text>

    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{caption}</figcaption>
</figure>
