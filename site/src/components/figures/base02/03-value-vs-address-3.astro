---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    headline: "DEREFERENCING: READ TWICE",
    sub: "read the pointer cell to get an address, then read that address to get the data",
    addrWord: "address",
    stepWord: "Step",
    readAddr: "Read address",
    usedAsAddress: "used as address",
    note: "The indirection costs one extra read.",
    svgA: "Cells holding ",
    svgB: ": read address ",
    svgC: " to get ",
    svgD: ", read address ",
    svgE: " to get ",
    capA: "Dereferencing takes two reads: first read address ",
    capB: " and get ",
    capC: ", then read address ",
    capD: " and get ",
    capE: " — the actual data. Indirection costs one extra read.",
  },
  ru: {
    headline: "РАЗЫМЕНОВАНИЕ: ДВА ЧТЕНИЯ",
    sub: "читаем ячейку-указатель, чтобы получить адрес, затем читаем этот адрес",
    addrWord: "адрес",
    stepWord: "Шаг",
    readAddr: "Чтение адреса",
    usedAsAddress: "использовано как адрес",
    note: "Косвенность стоит одного дополнительного чтения.",
    svgA: "Ячейки со значениями ",
    svgB: ": читаем адрес ",
    svgC: " — получаем ",
    svgD: ", читаем адрес ",
    svgE: " — получаем ",
    capA: "Разыменование требует два чтения: сначала читаем адрес ",
    capB: " и получаем ",
    capC: ", затем читаем адрес ",
    capD: " и получаем ",
    capE: " — реальные данные. Косвенность стоит одного дополнительного чтения.",
  },
};

const t = dict[lang];

const addrs = ["0", "1", "2", "3"];
const vals = ["3", "0", "0", "71"];
const steps = [
  { n: "1", addr: "0", val: "3" },
  { n: "2", addr: "3", val: "71" },
];
const jumpVal = "3";

const valsJoined = vals.join(", ");
const svgTitleEn =
  dict.en.svgA + valsJoined + dict.en.svgB + steps[0].addr + dict.en.svgC + steps[0].val + dict.en.svgD + steps[1].addr + dict.en.svgE + steps[1].val;
const svgTitleRu =
  dict.ru.svgA + valsJoined + dict.ru.svgB + steps[0].addr + dict.ru.svgC + steps[0].val + dict.ru.svgD + steps[1].addr + dict.ru.svgE + steps[1].val;
const caption =
  t.capA + steps[0].addr + t.capB + steps[0].val + t.capC + steps[1].addr + t.capD + steps[1].val + t.capE;

const x0 = 155;
const cw = 100;
const step = 130;
const cellY = 175;
const cellH = 70;
const cellX = (i: number) => x0 + i * step;
const centerX = (i: number) => x0 + i * step + cw / 2;
const railY = 118;
const baseY = cellY - 12;
const riseX = cellX(0) + cw;
const dropX = cellX(3);
const stepY = (i: number) => 280 + i * 25;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{svgTitleEn}</title>
    <title lang="ru">{svgTitleRu}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="102" text-anchor="middle" font-size="13" fill="var(--ink)">{jumpVal} {t.usedAsAddress}</text>
    <line x1={riseX} y1={cellY} x2={riseX} y2={railY} stroke="var(--accent)" stroke-width="2" />
    <line x1={riseX} y1={railY} x2={dropX} y2={railY} stroke="var(--accent)" stroke-width="2" />
    <line x1={dropX} y1={railY} x2={dropX} y2={baseY} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${dropX - 7},${baseY} ${dropX + 7},${baseY} ${dropX},${cellY}`} fill="var(--accent)" />

    {addrs.map((a, i) => (
      <g>
        <text x={centerX(i)} y="163" text-anchor="middle" font-size="14" fill="var(--ink)">{t.addrWord} {a}</text>
        <rect x={cellX(i)} y={cellY} width={cw} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={centerX(i)} y="218" text-anchor="middle" font-size="20" fill="var(--ink)">{vals[i]}</text>
      </g>
    ))}

    {steps.map((s, i) => (
      <text x="400" y={stepY(i)} text-anchor="middle" font-size="13" fill="var(--ink)">{t.stepWord} {s.n} — {t.readAddr} {s.addr} → {s.val}</text>
    ))}

    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{caption}</figcaption>
</figure>
