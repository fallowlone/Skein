---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One address names a full byte: eight bits returned together in one operation, 256 values from 0 to 255",
    headline: "ONE ADDRESS NAMES EIGHT BITS",
    byteIs: "a byte is exactly",
    bitsTogether: "bits — read together, written together, addressed together",
    address: "address",
    valuesWord: "distinct values",
    note: "you do not ask for the individual bits separately",
    caption:
      "A byte is exactly 8 bits treated as one unit: address 7 returns all 8 bits in one operation. With 2^8 = 256 patterns from 00000000 to 11111111 (0 to 255), the byte — not the bit — is the atom of memory.",
  },
  ru: {
    svgTitle: "Один адрес называет целый байт: восемь битов возвращаются вместе за одну операцию, 256 значений от 0 до 255",
    headline: "ОДИН АДРЕС НАЗЫВАЕТ ВОСЕМЬ БИТОВ",
    byteIs: "байт — это ровно",
    bitsTogether: "битов — читаются вместе, записываются вместе, адресуются вместе",
    address: "адрес",
    valuesWord: "различных значений",
    note: "биты по отдельности не запрашиваются",
    caption:
      "Байт — это ровно 8 битов как единое целое: адрес 7 возвращает все 8 битов за одну операцию. 2^8 = 256 паттернов от 00000000 до 11111111 (от 0 до 255) — атомом памяти является байт, а не бит.",
  },
};

const t = dict[lang];

const n8 = "8";
const n7 = "7";
const pow28 = "2^8 = 256";
const binRange = "00000000 … 11111111";
const decRange = "0 … 255";
const bits = ["0", "1", "0", "0", "0", "0", "0", "1"];
const labels = ["b7", "b6", "b5", "b4", "b3", "b2", "b1", "b0"];

const x0 = 150;
const cw = 58;
const ch = 44;
const cellY = 200;
const step = 68;
const midY = cellY + ch / 2;
const cellX = (i: number) => x0 + i * step;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.byteIs} {n8} {t.bitsTogether}</text>

    <rect x="20" y={cellY} width="104" height={ch} fill="var(--accent)" />
    <text x="72" y={midY + 5} text-anchor="middle" font-size="13" fill="var(--card)">{t.address} {n7}</text>

    <line x1="124" y1={midY} x2="140" y2={midY} stroke="var(--accent)" stroke-width="2" />
    <polygon points="140,215 140,229 150,222" fill="var(--accent)" />

    {labels.map((l, i) => (
      <text x={cellX(i) + cw / 2} y="190" text-anchor="middle" font-size="12" fill="var(--muted)">{l}</text>
    ))}
    {bits.map((b, i) => (
      <g>
        <rect x={cellX(i)} y={cellY} width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y={midY + 6} text-anchor="middle" font-size="15" fill="var(--ink)">{b}</text>
      </g>
    ))}

    <text x="400" y="305" text-anchor="middle" font-size="14" fill="var(--ink)">{pow28} {t.valuesWord} · {binRange} · {decRange}</text>
    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
