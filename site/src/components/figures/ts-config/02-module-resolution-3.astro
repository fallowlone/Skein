---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "paths aliases are checked but never emitted: tsc type-checks @/db and leaves the literal alias in the output, so plain node dist/index.js throws Cannot find module '@/db' until a bundler or loader rewrites it",
    headline: "CHECKED, NEVER EMITTED",
    sub: "tsc resolves paths for types, then leaves the alias in the JS",
    srcHead: '"@/db"',
    srcSub: "paths: @/* goes to src/*",
    tscHead: "tsc",
    tscSub: "type-checks, never rewrites",
    arrowCheck: "checks only",
    arrowKeep: "verbatim",
    arrowOut: "as-is",
    emitHead: '"@/db" in dist/index.js',
    emitSub: "literal alias left in output",
    runHead: "node dist/index.js",
    runSub: "throws Cannot find module",
    note: "dev server bundles it fine — plain node throws",
    resultLine: "a bundler or loader must rewrite it: resolve.alias, imports",
    moral: "align bundler and runtime aliases with tsconfig",
    caption:
      "tsc resolves the @/db paths alias for type-checking but never rewrites it, so the literal alias survives into dist/index.js and plain node throws Cannot find module — a bundler resolve.alias, a runtime loader, or package.json imports must rewrite it.",
  },
  ru: {
    svgTitle: "Алиасы paths проверяются, но не генерируются: tsc проверяет @/db для типов и оставляет литеральный алиас в выводе, так что голый node dist/index.js бросает Cannot find module '@/db', пока бандлер или загрузчик его не перепишет",
    headline: "ПРОВЕРЯЕТСЯ, НЕ ГЕНЕРИРУЕТСЯ",
    sub: "tsc разрешает paths для типов, но оставляет алиас в JS",
    srcHead: '"@/db"',
    srcSub: "paths: @/* ведёт в src/*",
    tscHead: "tsc",
    tscSub: "проверяет типы, не переписывает",
    arrowCheck: "только проверяет",
    arrowKeep: "дословно",
    arrowOut: "как есть",
    emitHead: '"@/db" в dist/index.js',
    emitSub: "литеральный алиас остался в выводе",
    runHead: "node dist/index.js",
    runSub: "бросает Cannot find module",
    note: "dev-сервер проходит — голый node бросает",
    resultLine: "бандлер или загрузчик должен переписать: resolve.alias, imports",
    moral: "согласуй алиасы бандлера и рантайма с tsconfig",
    caption:
      "tsc разрешает алиас paths @/db для проверки типов, но никогда его не переписывает, так что литеральный алиас доживает до dist/index.js, а голый node бросает Cannot find module — переписать его должны resolve.alias бандлера, загрузчик в рантайме или imports в package.json.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsConfigResolve-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="300" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="190" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.srcHead}</text>
    <text x="190" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.srcSub}</text>

    <line x1="340" y1="140" x2="460" y2="140" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsConfigResolve-3)" />
    <text x="400" y="122" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowCheck}</text>

    <rect x="460" y="100" width="300" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.tscHead}</text>
    <text x="610" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.tscSub}</text>

    <line x1="190" y1="180" x2="190" y2="210" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsConfigResolve-3)" />
    <text x="202" y="202" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrowKeep}</text>

    <line x1="610" y1="180" x2="610" y2="210" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsConfigResolve-3)" />
    <text x="622" y="202" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrowOut}</text>

    <rect x="40" y="210" width="300" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="190" y="238" text-anchor="middle" font-size="13" fill="var(--ink)">{t.emitHead}</text>
    <text x="190" y="260" text-anchor="middle" font-size="12" fill="var(--muted)">{t.emitSub}</text>

    <rect x="460" y="210" width="300" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="610" y="238" text-anchor="middle" font-size="13" fill="var(--ink)">{t.runHead}</text>
    <text x="610" y="260" text-anchor="middle" font-size="12" fill="var(--muted)">{t.runSub}</text>

    <text x="400" y="310" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>

    <rect x="40" y="324" width="720" height="48" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="354" text-anchor="middle" font-size="15" fill="var(--accent)">{t.resultLine}</text>

    <text x="400" y="400" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
