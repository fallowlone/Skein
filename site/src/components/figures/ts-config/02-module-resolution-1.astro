<!-- TsConfigResolve-1 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Two settings, two jobs: module decides the syntax TypeScript emits, moduleResolution decides the algorithm that turns an import specifier into a file — match both to the runtime with nodenext",
    headline: "TWO SETTINGS, TWO JOBS",
    sub: "module emits the syntax — moduleResolution finds the file",
    modHead: "module",
    modSub: "require/exports · import/export",
    resHead: "moduleResolution",
    resSub: "specifier becomes a file on disk",
    arrowEmit: "emits",
    arrowFind: "resolves",
    emitHead: "emitted syntax",
    emitSub: "CJS or ESM per package type",
    fileHead: "resolved file",
    fileSub: "exports + conditions matched",
    note: "mismatch the runtime and the editor passes code it rejects",
    resultLine: "module + moduleResolution: nodenext — resolve like Node runs",
    moral: "set module, let moduleResolution follow from it",
    caption:
      "module decides the syntax TypeScript emits while moduleResolution decides how a specifier becomes a file; matching both to the runtime with nodenext cures works-in-the-editor, ERR_MODULE_NOT_FOUND-at-runtime.",
  },
  ru: {
    svgTitle: "Две настройки, две задачи: module решает, какой синтаксис генерирует TypeScript, moduleResolution — по какому алгоритму спецификатор превращается в файл; подгони оба под рантайм через nodenext",
    headline: "ДВЕ НАСТРОЙКИ, ДВЕ ЗАДАЧИ",
    sub: "module генерирует синтаксис — moduleResolution находит файл",
    modHead: "module",
    modSub: "require/exports · import/export",
    resHead: "moduleResolution",
    resSub: "спецификатор становится файлом на диске",
    arrowEmit: "генерирует",
    arrowFind: "разрешает",
    emitHead: "генерируемый синтаксис",
    emitSub: "CJS или ESM по типу пакета",
    fileHead: "разрешённый файл",
    fileSub: "exports + условия сопоставлены",
    note: "разойдись с рантаймом — редактор пропустит код, который тот отвергнет",
    resultLine: "module + moduleResolution: nodenext — разрешай как работает Node",
    moral: "задай module, а moduleResolution пусть следует из него",
    caption:
      "module решает, какой синтаксис генерирует TypeScript, а moduleResolution — как спецификатор становится файлом; подгонка обоих под рантайм через nodenext лечит «работает в редакторе, ERR_MODULE_NOT_FOUND в рантайме».",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsConfigResolve-1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="300" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="190" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.modHead}</text>
    <text x="190" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.modSub}</text>

    <rect x="460" y="100" width="300" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="610" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.resHead}</text>
    <text x="610" y="155" text-anchor="middle" font-size="12" fill="var(--muted)">{t.resSub}</text>

    <line x1="190" y1="180" x2="190" y2="210" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsConfigResolve-1)" />
    <text x="202" y="202" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrowEmit}</text>

    <line x1="610" y1="180" x2="610" y2="210" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsConfigResolve-1)" />
    <text x="622" y="202" text-anchor="start" font-size="11" fill="var(--accent)">{t.arrowFind}</text>

    <rect x="40" y="210" width="300" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="190" y="238" text-anchor="middle" font-size="13" fill="var(--ink)">{t.emitHead}</text>
    <text x="190" y="260" text-anchor="middle" font-size="12" fill="var(--muted)">{t.emitSub}</text>

    <rect x="460" y="210" width="300" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="610" y="238" text-anchor="middle" font-size="13" fill="var(--ink)">{t.fileHead}</text>
    <text x="610" y="260" text-anchor="middle" font-size="12" fill="var(--muted)">{t.fileSub}</text>

    <text x="400" y="310" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>

    <rect x="40" y="324" width="720" height="48" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="354" text-anchor="middle" font-size="15" fill="var(--accent)">{t.resultLine}</text>

    <text x="400" y="400" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
