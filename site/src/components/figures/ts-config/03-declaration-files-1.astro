---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "module versus script: no import or export means global script, any import or export means local module",
    headline: "MODULE vs SCRIPT: WHERE DECLARATIONS LAND",
    sub: "no top-level import/export = script · any import/export = module",
    tagLeft: "1 — script: declarations are global",
    boxLeftTitle: "globals.d.ts — no import/export",
    boxLeftLine1: "declare const __APP_VERSION__: string",
    boxLeftLine2: "interface Window { dataLayer } merges",
    boxLeftFoot: "augment globals directly, no wrapper",
    vs: "VS",
    tagRight: "2 — module: declarations are local",
    boxRightTitle: "env.d.ts — has export {}",
    boxRightLine1: "declare global { interface Window }",
    boxRightLine2: "declare global is legal only in a module",
    boxRightFoot: "a stray import flips a script into a module",
    foot1: "wrong context = augmentation silently no-ops, the merge never applies",
    foot2: "fix: add export {} to force module · remove stray imports to keep script",
    caption:
      "A file with no top-level import or export is a script whose declarations are global; any import or export makes it a module whose declarations are local, so globals need a declare global wrapper — and a stray import silently breaks the merge.",
  },
  ru: {
    svgTitle: "модуль против скрипта: нет import или export — глобальный скрипт, есть import или export — локальный модуль",
    headline: "МОДУЛЬ ПРОТИВ СКРИПТА: КУДА ПОПАДАЮТ ОБЪЯВЛЕНИЯ",
    sub: "нет import/export верхнего уровня = скрипт · есть import/export = модуль",
    tagLeft: "1 — скрипт: объявления глобальны",
    boxLeftTitle: "globals.d.ts — нет import/export",
    boxLeftLine1: "declare const __APP_VERSION__: string",
    boxLeftLine2: "interface Window { dataLayer } сливается",
    boxLeftFoot: "аугментация глобалов напрямую, без обёртки",
    vs: "VS",
    tagRight: "2 — модуль: объявления локальны",
    boxRightTitle: "env.d.ts — есть export {}",
    boxRightLine1: "declare global { interface Window }",
    boxRightLine2: "declare global легален только в модуле",
    boxRightFoot: "случайный import переключает скрипт в модуль",
    foot1: "неверный контекст = аугментация молча даёт no-op, слияние не применяется",
    foot2: "фикс: добавь export {} для модуля · убери лишние импорты для скрипта",
    caption:
      "Файл без import/export верхнего уровня — это скрипт, чьи объявления глобальны; любой import/export делает его модулем с локальными объявлениями, поэтому глобалы требуют обёртки declare global — а случайный import молча ломает слияние.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsConfigDecl-1" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftTitle}</text>
    <text x="205" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine1}</text>
    <text x="205" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine2}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxLeftFoot}</text>

    <circle cx="400" cy="221" r="17" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="226" text-anchor="middle" font-size="12" fill="var(--ink)">{t.vs}</text>

    <text x="595" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightTitle}</text>
    <text x="595" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine1}</text>
    <text x="595" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine2}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxRightFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
