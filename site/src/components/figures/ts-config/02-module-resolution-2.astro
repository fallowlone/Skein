<!-- TsConfigResolve-2 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The dot-js rule under node16/nodenext: write ./parser.js to import parser.ts — TypeScript checks the source but emits the specifier untouched, so ./parser fails with TS2835 and ./parser.ts with TS5097",
    headline: "WRITE .JS, IMPORT .TS",
    sub: "the string you write is the string Node sees",
    writeHead: '"./parser.js"',
    writeSub: "you write — output extension",
    arrowCheck: "checks",
    srcHead: "parser.ts",
    srcSub: "checked source on disk",
    arrowKeep: "untouched",
    emitHead: '"./parser.js"',
    emitSub: "emitted as-is for Node",
    err1Head: '"./parser"',
    err1Sub: "TS2835 — extension required",
    err2Head: '"./parser.ts"',
    err2Sub: "TS5097 — cannot end in .ts",
    note: "TypeScript never rewrites import specifiers in emit",
    resultLine: "bundler drops the rule — it resolves extensionless",
    moral: "write the output extension, let the checker find the source",
    caption:
      "Under node16/nodenext you write ./parser.js to import parser.ts: TypeScript checks the source but leaves the specifier untouched for Node, ./parser fails with TS2835 and ./parser.ts with TS5097, while bundler mode drops the rule.",
  },
  ru: {
    svgTitle: "Правило .js при node16/nodenext: пиши ./parser.js, чтобы импортировать parser.ts — TypeScript проверяет исходник, но оставляет спецификатор нетронутым, так что ./parser падает с TS2835, а ./parser.ts — с TS5097",
    headline: "ПИШИ .JS, ИМПОРТИРУЙ .TS",
    sub: "строка, которую ты пишешь, — это строка, которую видит Node",
    writeHead: '"./parser.js"',
    writeSub: "расширение результата",
    arrowCheck: "проверяет",
    srcHead: "parser.ts",
    srcSub: "проверка по исходнику",
    arrowKeep: "нетронут",
    emitHead: '"./parser.js"',
    emitSub: "как есть для Node",
    err1Head: '"./parser"',
    err1Sub: "TS2835 — требуется расширение",
    err2Head: '"./parser.ts"',
    err2Sub: "TS5097 — нельзя оканчивать на .ts",
    note: "TypeScript никогда не переписывает спецификаторы импорта в emit",
    resultLine: "bundler убирает правило — разрешает без расширений",
    moral: "пиши расширение результата, а исходник пусть найдёт проверка",
    caption:
      "При node16/nodenext пиши ./parser.js, чтобы импортировать parser.ts: TypeScript проверяет исходник, но оставляет спецификатор нетронутым для Node, ./parser падает с TS2835, а ./parser.ts — с TS5097, а режим bundler убирает это правило.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsConfigResolve-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="92" width="200" height="86" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="130" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.writeHead}</text>
    <text x="130" y="147" text-anchor="middle" font-size="12" fill="var(--muted)">{t.writeSub}</text>

    <line x1="230" y1="135" x2="300" y2="135" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsConfigResolve-2)" />
    <text x="265" y="117" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowCheck}</text>

    <rect x="300" y="92" width="200" height="86" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.srcHead}</text>
    <text x="400" y="147" text-anchor="middle" font-size="12" fill="var(--muted)">{t.srcSub}</text>

    <line x1="500" y1="135" x2="570" y2="135" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsConfigResolve-2)" />
    <text x="535" y="117" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowKeep}</text>

    <rect x="570" y="92" width="200" height="86" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="670" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.emitHead}</text>
    <text x="670" y="147" text-anchor="middle" font-size="12" fill="var(--muted)">{t.emitSub}</text>

    <rect x="40" y="200" width="350" height="62" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="215" y="226" text-anchor="middle" font-size="13" fill="var(--ink)">{t.err1Head}</text>
    <text x="215" y="248" text-anchor="middle" font-size="12" fill="var(--muted)">{t.err1Sub}</text>

    <rect x="410" y="200" width="350" height="62" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="585" y="226" text-anchor="middle" font-size="13" fill="var(--ink)">{t.err2Head}</text>
    <text x="585" y="248" text-anchor="middle" font-size="12" fill="var(--muted)">{t.err2Sub}</text>

    <text x="400" y="286" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>

    <rect x="40" y="300" width="720" height="54" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="333" text-anchor="middle" font-size="15" fill="var(--accent)">{t.resultLine}</text>

    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.moral}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
