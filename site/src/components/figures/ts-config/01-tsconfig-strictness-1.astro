---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "strict is one switch wired to eight checks: strictNullChecks carries the weight and each flag stays individually overridable",
    headline: "ONE SWITCH, EIGHT CHECKS — EACH ONE OVERRIDABLE",
    sub: "strict: true sets the default for a family of flags — checking only, not emit",
    tagLeft: "the switch",
    left1: "strict: true",
    left2: "one switch",
    left3: "default for 8 flags",
    left4: "each overridable",
    left5: "checking only",
    tagMid: "the bundled eight",
    flag1: "strictNullChecks — load-bearing",
    flag2: "noImplicitAny",
    flag3: "strictFunctionTypes",
    flag4: "strictBindCallApply",
    flag5: "strictPropertyInitialization",
    flag6: "useUnknownInCatchVariables",
    flag7: "noImplicitThis",
    flag8: "alwaysStrict — emit only",
    tagRight: "the override pattern",
    right1: "migrate:",
    right2: "strict: true,",
    right3: "strictNullChecks: false",
    right4: "everything else",
    right5: "stays strict",
    foot: "all eight tighten checking, not emit — except alwaysStrict, which emits \"use strict\"",
    caption:
      "strict: true is a meta-flag: one default for eight checks, each individually overridable — checking only, never emit, except alwaysStrict.",
  },
  ru: {
    svgTitle: "strict — один переключатель на восемь проверок: strictNullChecks несёт нагрузку, и каждый флаг остаётся индивидуально переопределяемым",
    headline: "ОДИН ПЕРЕКЛЮЧАТЕЛЬ — ВОСЕМЬ ПРОВЕРОК",
    sub: "strict: true задаёт значение по умолчанию для семейства флагов — только проверка, не emit",
    tagLeft: "переключатель",
    left1: "strict: true",
    left2: "один переключатель",
    left3: "значение по умолчанию",
    left4: "для 8 флагов",
    left5: "только проверка",
    tagMid: "восемь из набора",
    flag1: "strictNullChecks — несёт нагрузку",
    flag2: "noImplicitAny",
    flag3: "strictFunctionTypes",
    flag4: "strictBindCallApply",
    flag5: "strictPropertyInitialization",
    flag6: "useUnknownInCatchVariables",
    flag7: "noImplicitThis",
    flag8: "alwaysStrict — только emit",
    tagRight: "паттерн переопределения",
    right1: "миграция:",
    right2: "strict: true,",
    right3: "strictNullChecks: false",
    right4: "всё остальное",
    right5: "остаётся строгим",
    foot: "все восемь ужесточают проверку, а не emit — кроме alwaysStrict, он добавляет \"use strict\"",
    caption:
      "strict: true — это мета-флаг: одно значение по умолчанию для восьми проверок, каждая переопределяема — только проверка, не emit, кроме alwaysStrict.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="137" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="210" height="264" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="137" y="170" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="137" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="137" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left3}</text>
    <text x="137" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left4}</text>
    <text x="137" y="274" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left5}</text>

    <text x="400" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagMid}</text>
    <rect x="270" y="116" width="260" height="26" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="133" text-anchor="middle" font-size="11" fill="var(--ink)">{t.flag1}</text>
    <rect x="270" y="150" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="167" text-anchor="middle" font-size="11" fill="var(--ink)">{t.flag2}</text>
    <rect x="270" y="184" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="201" text-anchor="middle" font-size="11" fill="var(--ink)">{t.flag3}</text>
    <rect x="270" y="218" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="235" text-anchor="middle" font-size="11" fill="var(--ink)">{t.flag4}</text>
    <rect x="270" y="252" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="269" text-anchor="middle" font-size="11" fill="var(--ink)">{t.flag5}</text>
    <rect x="270" y="286" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="303" text-anchor="middle" font-size="11" fill="var(--ink)">{t.flag6}</text>
    <rect x="270" y="320" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="337" text-anchor="middle" font-size="11" fill="var(--ink)">{t.flag7}</text>
    <rect x="270" y="354" width="260" height="26" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="371" text-anchor="middle" font-size="11" fill="var(--ink)">{t.flag8}</text>

    <text x="663" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="558" y="116" width="210" height="264" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="663" y="170" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="663" y="196" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="663" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right3}</text>
    <text x="663" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right4}</text>
    <text x="663" y="274" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right5}</text>

    <text x="400" y="406" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
