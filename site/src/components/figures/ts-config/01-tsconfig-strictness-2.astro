---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "strictNullChecks re-types every value: without it string silently includes null, with it null and undefined become their own types that must be narrowed",
    headline: "ONE FLAG RE-TYPES EVERY VALUE",
    sub: "off — string silently includes null; on — null and undefined become their own types",
    tagLeft: "off — loose default",
    left1: "string includes null",
    left2: "null slips through checks",
    left3: "the type system lies",
    left4: "unsound",
    gapTop: "flip the flag",
    gapBottom: "1,400-error wall",
    tagRight: "on — strictNullChecks",
    right1: "strictNullChecks: true",
    right2: "string | null — split",
    right3: "'el' is possibly 'null'",
    right4: "fix: if (el) ...",
    right5: "or: el?.addEventListener(...)",
    foot1: "the 1,400-error wall is every hidden lie revealed at once",
    foot2: "the biggest correctness win in the whole bundle",
    caption:
      "strictNullChecks splits null and undefined off every type: the loose default lets null slip through, the strict side forces explicit narrowing.",
  },
  ru: {
    svgTitle: "strictNullChecks перетипизирует каждое значение: без него string молча включает null, с ним null и undefined становятся собственными типами, которые надо сужать",
    headline: "ОДИН ФЛАГ ПЕРЕРЕТИПИЗИРУЕТ КАЖДОЕ ЗНАЧЕНИЕ",
    sub: "выкл — string молча включает null; вкл — null и undefined становятся собственными типами",
    tagLeft: "выкл — слабый дефолт",
    left1: "string включает null",
    left2: "null проходит сквозь проверки",
    left3: "система типов лжёт",
    left4: "несостоятельно (unsound)",
    gapTop: "включи флаг",
    gapBottom: "стена 1400 ошибок",
    tagRight: "вкл — strictNullChecks",
    right1: "strictNullChecks: true",
    right2: "string | null — разделены",
    right3: "'el' is possibly 'null'",
    right4: "фикс: if (el) ...",
    right5: "или: el?.addEventListener(...)",
    foot1: "стена из 1400 ошибок: каждое место, где типы лгали",
    foot2: "главный выигрыш по корректности во всём наборе",
    caption:
      "strictNullChecks отделяет null и undefined от каждого типа: слабый дефолт пропускает null сквозь проверки, строгая сторона требует явного сужения.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="182" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="300" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="182" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="182" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="182" y="219" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left3}</text>
    <text x="182" y="246" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left4}</text>

    <text x="400" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapTop}</text>
    <line x1="352" y1="216" x2="436" y2="216" stroke="var(--accent)" stroke-width="2" />
    <polygon points="436,206 458,216 436,226" fill="var(--accent)" />
    <text x="400" y="248" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapBottom}</text>

    <text x="618" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="468" y="116" width="300" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="618" y="158" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="618" y="184" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="618" y="210" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right3}</text>
    <text x="618" y="236" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right4}</text>
    <text x="618" y="262" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right5}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
