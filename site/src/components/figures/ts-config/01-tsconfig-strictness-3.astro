---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The two highest-value flags sit outside the strict bundle: noUncheckedIndexedAccess widens every index lookup with undefined, exactOptionalPropertyTypes keeps absent apart from undefined",
    headline: "THE BEST BUG-CATCHERS SIT OUTSIDE THE BUNDLE",
    sub: "noUncheckedIndexedAccess and exactOptionalPropertyTypes are opt-in — add them separately",
    tagLeft: "opt-in — index access",
    left1: "noUncheckedIndexedAccess",
    left2: "xs[0]: number | undefined",
    left3: "catches off-by-one,",
    left4: "missing-key, empty-array",
    left5: "loud — each hit a real bug",
    tagRight: "opt-in — optional keys",
    right1: "exactOptionalPropertyTypes",
    right2: "timeout?: absent,",
    right3: "not undefined",
    right4: "{ timeout: undefined } — Error",
    right5: "'in' / Object.keys stay honest",
    foot1: "outside the strict bundle — opt in separately",
    foot2: "migrate last: they surface the deepest latent bugs",
    caption:
      "The deepest bugs hide outside the bundle: noUncheckedIndexedAccess makes every index lookup nullable, exactOptionalPropertyTypes keeps absent apart from undefined.",
  },
  ru: {
    svgTitle: "Два самых ценных флага лежат вне набора strict: noUncheckedIndexedAccess расширяет каждый доступ по индексу через undefined, exactOptionalPropertyTypes разводит отсутствие и undefined",
    headline: "ЛУЧШИЕ ЛОВЦЫ БАГОВ — ВНЕ НАБОРА",
    sub: "noUncheckedIndexedAccess и exactOptionalPropertyTypes подключаются отдельно",
    tagLeft: "opt-in — доступ по индексу",
    left1: "noUncheckedIndexedAccess",
    left2: "xs[0]: number | undefined",
    left3: "ловит off-by-one,",
    left4: "отсутствующий ключ, пустой массив",
    left5: "громкий — жалобы про скрытые баги",
    tagRight: "opt-in — опциональные ключи",
    right1: "exactOptionalPropertyTypes",
    right2: "timeout?: может ОТСУТСТВОВАТЬ,",
    right3: "а не быть undefined",
    right4: "{ timeout: undefined } — Ошибка",
    right5: "'in' / Object.keys — честно",
    foot1: "вне набора strict — подключаются отдельно",
    foot2: "добавляй последними: обнажают самые глубокие скрытые баги",
    caption:
      "Самые глубокие баги прячутся вне набора: noUncheckedIndexedAccess делает каждый поиск по индексу nullable, exactOptionalPropertyTypes разводит отсутствие и undefined.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="207" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="32" y="116" width="350" height="196" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="207" y="158" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="207" y="184" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="207" y="210" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left3}</text>
    <text x="207" y="236" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left4}</text>
    <text x="207" y="262" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left5}</text>

    <text x="593" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="418" y="116" width="350" height="196" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="593" y="158" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="593" y="184" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="593" y="210" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right3}</text>
    <text x="593" y="236" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right4}</text>
    <text x="593" y="262" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right5}</text>

    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
