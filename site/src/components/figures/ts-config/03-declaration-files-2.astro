---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "ambient module declaration invents types for an untyped package versus module augmentation merging into a typed package",
    headline: "INVENT TYPES vs MERGE INTO TYPES",
    sub: 'declare module "pkg" fills the gap · re-open a module to merge members',
    tagLeft: "1 — ambient: untyped dependency (TS7016)",
    boxLeftTitle: 'declare module "legacy-chart"',
    boxLeftLine1: "export function render(el, opts): void",
    boxLeftLine2: 'declare module "*.svg": url string',
    boxLeftFoot: "invents the package public types",
    vs: "VS",
    tagRight: "2 — augmentation: typed module",
    boxRightTitle: 'declare module "express-serve-static-core"',
    boxRightLine1: "interface Request { user?: { id } }",
    boxRightLine2: "file must be a module: import or export {}",
    boxRightFoot: "MERGES with the original Request",
    foot1: "ambient invents what does not exist · augmentation merges into what exists",
    foot2: "globals instead: declare global { interface Window } — still needs module context",
    caption:
      "An ambient declare module invents types for an untyped dependency, including the wildcard form for asset imports; module augmentation re-opens an already-typed module from inside your own module so the re-declared interface merges with the original.",
  },
  ru: {
    svgTitle: "ambient-объявление модуля изобретает типы для нетипизированного пакета против module-аугментации, сливающейся с типизированным пакетом",
    headline: "ИЗОБРЕСТИ ТИПЫ ПРОТИВ СЛИЯНИЯ С ТИПАМИ",
    sub: 'declare module "pkg" закрывает пробел · переоткрой модуль, чтобы слить члены',
    tagLeft: "1 — ambient: нетипизированная зависимость (TS7016)",
    boxLeftTitle: 'declare module "legacy-chart"',
    boxLeftLine1: "export function render(el, opts): void",
    boxLeftLine2: 'declare module "*.svg": url string',
    boxLeftFoot: "изобретает публичные типы пакета",
    vs: "VS",
    tagRight: "2 — аугментация: типизированный модуль",
    boxRightTitle: 'declare module "express-serve-static-core"',
    boxRightLine1: "interface Request { user?: { id } }",
    boxRightLine2: "файл — модуль: import или export",
    boxRightFoot: "СЛИВАЕТСЯ с оригинальным Request",
    foot1: "ambient изобретает то, чего нет · аугментация сливается с тем, что есть",
    foot2: "для глобалов: declare global { interface Window } — контекст модуля всё равно нужен",
    caption:
      "Ambient-объявление declare module изобретает типы для нетипизированной зависимости, включая wildcard-форму для импортов ассетов; module-аугментация переоткрывает уже типизированный модуль изнутри своего модуля, чтобы переобъявленный интерфейс слился с оригиналом.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsConfigDecl-2" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftTitle}</text>
    <text x="205" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine1}</text>
    <text x="205" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine2}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxLeftFoot}</text>

    <circle cx="400" cy="221" r="17" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="226" text-anchor="middle" font-size="12" fill="var(--ink)">{t.vs}</text>

    <text x="595" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightTitle}</text>
    <text x="595" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine1}</text>
    <text x="595" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine2}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxRightFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
