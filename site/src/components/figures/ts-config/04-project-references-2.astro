---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "tsc minus b builds core then ui then web in dependency order and skips projects whose inputs hash unchanged against dot tsbuildinfo",
    headline: "DEPENDENCIES BUILD BEFORE DEPENDENTS",
    sub: "tsc -b sorts the graph; .tsbuildinfo skips unchanged projects",
    step1: "1 · core",
    step1sub: "no deps — builds first",
    step2: "2 · ui",
    step2sub: "after core",
    step3: "3 · web",
    step3sub: "after ui and core",
    cacheBar: ".tsbuildinfo: hash inputs vs cache",
    cacheSub: "unchanged goes to skip; changed .d.ts rebuilds dependents",
    editNote: "a one-line web edit rebuilds web only",
    foot: "tsc -b --verbose shows skipped vs rebuilt",
    caption:
      "Build mode sorts the reference graph and builds core, then ui, then web; each project's .tsbuildinfo hashes its inputs, so unchanged projects are skipped and a one-line web edit rebuilds only web.",
  },
  ru: {
    svgTitle: "tsc минус b собирает core, потом ui, потом web в порядке зависимостей и пропускает проекты, чей хеш входов не изменился против dot tsbuildinfo",
    headline: "ЗАВИСИМОСТИ СОБИРАЮТСЯ ПЕРЕД ЗАВИСЯЩИМИ",
    sub: "tsc -b сортирует граф; .tsbuildinfo пропускает неизменные проекты",
    step1: "1 · core",
    step1sub: "без зависимостей — первый",
    step2: "2 · ui",
    step2sub: "после core",
    step3: "3 · web",
    step3sub: "после ui и core",
    cacheBar: ".tsbuildinfo: хеш входов против кэша",
    cacheSub: "без изменений — пропуск; изменившийся .d.ts пересобирает зависящих",
    editNote: "правка одной строки в web пересобирает только web",
    foot: "tsc -b --verbose показывает пропущенные и пересобранные",
    caption:
      "Режим сборки сортирует граф ссылок и строит core, потом ui, потом web; .tsbuildinfo каждого проекта хеширует его входы, поэтому неизменные проекты пропускаются, а правка одной строки в web пересобирает только web.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsConfigRefs-2">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="30" y="96" width="220" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="140" y="134" text-anchor="middle" font-size="13" fill="var(--ink)">{t.step1}</text>
      <text x="140" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step1sub}</text>

      <line x1="252" y1="151" x2="280" y2="151" stroke="var(--muted)" stroke-width="2" />
      <polygon points="290,151 280,146 280,156" fill="var(--muted)" />

      <rect x="290" y="96" width="220" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="134" text-anchor="middle" font-size="13" fill="var(--ink)">{t.step2}</text>
      <text x="400" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step2sub}</text>

      <line x1="512" y1="151" x2="540" y2="151" stroke="var(--muted)" stroke-width="2" />
      <polygon points="550,151 540,146 540,156" fill="var(--muted)" />

      <rect x="550" y="96" width="220" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="660" y="134" text-anchor="middle" font-size="13" fill="var(--ink)">{t.step3}</text>
      <text x="660" y="160" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step3sub}</text>

      <rect x="30" y="246" width="740" height="84" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="280" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cacheBar}</text>
      <text x="400" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cacheSub}</text>

      <text x="400" y="364" text-anchor="middle" font-size="12" fill="var(--ink)">{t.editNote}</text>

      <text x="400" y="402" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
