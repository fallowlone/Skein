---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "declaration emit: exported symbols become the public d.ts surface, unexported internal types leak private paths",
    headline: "DECLARATION EMIT: THE PUBLIC TYPE SURFACE",
    sub: "declaration: true emits .d.ts · surface = your exported symbols",
    tagLeft: "1 — clean surface: export everything named",
    boxLeftTitle: "index.ts exports make(): Public",
    boxLeftLine1: "index.d.ts ships beside index.js",
    boxLeftLine2: "declarationMap jumps to real source",
    boxLeftFoot: "types field points consumers at dist",
    vs: "VS",
    tagRight: "2 — leak: public names unexported Internal",
    boxRightTitle: "make(): Internal, never exported",
    boxRightLine1: "TS4023 / TS4094: cannot be named",
    boxRightLine2: "d.ts points at src or private paths",
    boxRightFoot: "consumer cannot import, build breaks",
    foot1: "fix the leak: export Internal too, or inline its shape",
    foot2: 'pollution guard: compiler types: [] disables auto-inclusion of @types/*',
    caption:
      "Declaration emit ships your exported symbols as the public .d.ts surface with declarationMap wiring go-to-definition back to source; a public export referencing an unexported internal type leaks a private path the consumer cannot name, and stray @types globals are contained with types: [].",
  },
  ru: {
    svgTitle: "declaration emit: экспортированные символы становятся публичной поверхностью d.ts, неэкспортированные типы утекают приватными путями",
    headline: "DECLARATION EMIT: ПУБЛИЧНАЯ ПОВЕРХНОСТЬ ТИПОВ",
    sub: "declaration: true генерирует .d.ts · поверхность = твои экспорты",
    tagLeft: "1 — чистая поверхность: всё именованное экспортировано",
    boxLeftTitle: "index.ts экспортирует make(): Public",
    boxLeftLine1: "index.d.ts поставляется рядом с index.js",
    boxLeftLine2: "declarationMap прыгает в исходник",
    boxLeftFoot: "поле types указывает потребителям на dist",
    vs: "VS",
    tagRight: "2 — утечка: публичное ссылается на Internal",
    boxRightTitle: "make(): Internal, не экспортирован",
    boxRightLine1: "TS4023 / TS4094: cannot be named",
    boxRightLine2: ".d.ts указывает на src или приватные пути",
    boxRightFoot: "без импорта — сборка ломается",
    foot1: "фикс утечки: экспортируй Internal тоже или встрой его форму",
    foot2: "защита от загрязнения: types: [] отключает авто-включение @types/*",
    caption:
      "Declaration emit поставляет твои экспортированные символы как публичную поверхность .d.ts, а declarationMap связывает go-to-definition с исходником; публичный экспорт, ссылающийся на неэкспортированный внутренний тип, утекает приватным путём, который потребитель не может именовать, а лишние глобалы @types сдерживаются через types: [].",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsConfigDecl-3" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftTitle}</text>
    <text x="205" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine1}</text>
    <text x="205" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxLeftLine2}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxLeftFoot}</text>

    <circle cx="400" cy="221" r="17" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="226" text-anchor="middle" font-size="12" fill="var(--ink)">{t.vs}</text>

    <text x="595" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightTitle}</text>
    <text x="595" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine1}</text>
    <text x="595" y="224" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxRightLine2}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxRightFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
