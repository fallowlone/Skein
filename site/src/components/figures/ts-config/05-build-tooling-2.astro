<!-- TsConfigBuild-2 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "isolatedModules makes single-file transpilation safe: ambiguous type-only re-exports need export type, and const enums cannot be consumed across files",
    headline: "ISOLATEDMODULES — WHAT ONE FILE CANNOT DECIDE",
    sub: "no cross-file knowledge — erase or keep must be decidable in a single file",
    tagLeft: "ambiguous re-export — forbidden",
    left1: 'export { SomeType } from "./types";',
    gapLeft1: "type (erase) or value (keep)?",
    left2: 'export type { SomeType } from "./types";',
    gapLeft2: "unambiguous — erase it",
    left3: "explicit type modifier fixes it",
    tagRight: "const enum across files — forbidden",
    right1: 'import { Color } from "./enums";',
    gapRight1: "values live in another file",
    right2: "const c = Color.Red;",
    gapRight2: "cannot inline without cross-file info",
    right3: "no cross-file const enums",
    foot1: "isolatedModules changes no emit — it restricts what you may write",
    foot2: "write export type / import type so per-file transpile stays correct",
    caption:
      "A single-file transpiler cannot tell a type from a value across files: isolatedModules forbids ambiguous re-exports and cross-file const enums, forcing explicit export type.",
  },
  ru: {
    svgTitle: "isolatedModules делает однофайловую транспиляцию безопасной: неоднозначные type-only реэкспорты требуют export type, а const enum нельзя потреблять между файлами",
    headline: "ISOLATEDMODULES — ЧЕГО НЕ РЕШИТЬ В ОДНОМ ФАЙЛЕ",
    sub: "нет межфайлового знания — «стереть или оставить» решается в одном файле",
    tagLeft: "неоднозначный реэкспорт — запрещён",
    left1: 'export { SomeType } from "./types";',
    gapLeft1: "тип (стереть) или значение (оставить)?",
    left2: 'export type { SomeType } from "./types";',
    gapLeft2: "однозначно — стереть",
    left3: "фикс: явный модификатор type",
    tagRight: "const enum между файлами — запрещён",
    right1: 'import { Color } from "./enums";',
    gapRight1: "значения — в другом файле",
    right2: "const c = Color.Red;",
    gapRight2: "нельзя вшить без межфайловой информации",
    right3: "нет межфайловых const enum",
    foot1: "isolatedModules не меняет emit — он ограничивает то, что можно писать",
    foot2: "надо писать export type / import type — тогда вывод корректен",
    caption:
      "Однофайловый транспилятор не отличит тип от значения между файлами: isolatedModules запрещает неоднозначные реэкспорты и межфайловые const enum, требуя явный export type.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="40" y="110" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="200" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="200" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapLeft1}</text>
    <rect x="40" y="205" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="200" y="241" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="200" y="283" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapLeft2}</text>
    <rect x="40" y="300" width="320" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="336" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left3}</text>

    <text x="600" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="440" y="110" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="600" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapRight1}</text>
    <rect x="440" y="205" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="241" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="600" y="283" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapRight2}</text>
    <rect x="440" y="300" width="320" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="336" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right3}</text>

    <text x="400" y="388" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="410" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
