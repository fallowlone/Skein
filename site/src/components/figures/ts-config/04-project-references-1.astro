---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "packages/web references packages/core and packages/ui; each referenced project sets composite true, which forces declaration true",
    headline: "ONE PROJECT POINTS AT ITS DEPENDENCIES",
    sub: "web lists references; every referenced project must be composite",
    webPath: "packages/web/tsconfig.json",
    webRef: '"references": [ core, ui ]',
    corePath: "packages/core/tsconfig.json",
    coreComp: '"composite": true',
    coreDecl: '"declaration": true',
    coreSub: ".d.ts is the cross-project contract",
    uiPath: "packages/ui/tsconfig.json",
    uiComp: '"composite": true',
    uiSub: "referenced, so composite too",
    refLabel: "references",
    foot: "referenced = composite; declaration emits .d.ts + .tsbuildinfo",
    caption:
      "packages/web lists packages/core and packages/ui under references, and each referenced project sets composite: true, which forces declaration: true so dependents consume the emitted .d.ts instead of re-reading source.",
  },
  ru: {
    svgTitle: "packages/web ссылается на packages/core и packages/ui; каждый проект, на который ссылаются, задаёт composite true, который форсирует declaration true",
    headline: "ОДИН ПРОЕКТ УКАЗЫВАЕТ НА СВОИ ЗАВИСИМОСТИ",
    sub: "web перечисляет references; проект, на который ссылаются, должен быть composite",
    webPath: "packages/web/tsconfig.json",
    webRef: '"references": [ core, ui ]',
    corePath: "packages/core/tsconfig.json",
    coreComp: '"composite": true',
    coreDecl: '"declaration": true',
    coreSub: ".d.ts — межпроектный контракт типов",
    uiPath: "packages/ui/tsconfig.json",
    uiComp: '"composite": true',
    uiSub: "на него ссылаются, поэтому тоже composite",
    refLabel: "ссылки",
    foot: "на который ссылаются = composite; declaration генерирует .d.ts + .tsbuildinfo",
    caption:
      "packages/web перечисляет packages/core и packages/ui в references, и каждый проект, на который ссылаются, задаёт composite: true, который форсирует declaration: true, чтобы зависящие потребляли генерируемый .d.ts вместо перечитывания исходника.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsConfigRefs-1">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="240" y="84" width="320" height="86" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="118" text-anchor="middle" font-size="12" fill="var(--ink)">{t.webPath}</text>
      <text x="400" y="144" text-anchor="middle" font-size="12" fill="var(--ink)">{t.webRef}</text>

      <line x1="330" y1="172" x2="330" y2="220" stroke="var(--muted)" stroke-width="2" />
      <polygon points="330,230 325,220 335,220" fill="var(--muted)" />
      <text x="316" y="202" text-anchor="end" font-size="11" fill="var(--muted)">{t.refLabel}</text>

      <line x1="470" y1="172" x2="470" y2="220" stroke="var(--muted)" stroke-width="2" />
      <polygon points="470,230 465,220 475,220" fill="var(--muted)" />
      <text x="484" y="202" text-anchor="start" font-size="11" fill="var(--muted)">{t.refLabel}</text>

      <rect x="40" y="230" width="340" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="210" y="262" text-anchor="middle" font-size="12" fill="var(--ink)">{t.corePath}</text>
      <text x="210" y="288" text-anchor="middle" font-size="12" fill="var(--ink)">{t.coreComp}</text>
      <text x="210" y="314" text-anchor="middle" font-size="12" fill="var(--ink)">{t.coreDecl}</text>
      <text x="210" y="340" text-anchor="middle" font-size="11" fill="var(--muted)">{t.coreSub}</text>

      <rect x="420" y="230" width="340" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="590" y="270" text-anchor="middle" font-size="12" fill="var(--ink)">{t.uiPath}</text>
      <text x="590" y="296" text-anchor="middle" font-size="12" fill="var(--ink)">{t.uiComp}</text>
      <text x="590" y="322" text-anchor="middle" font-size="11" fill="var(--muted)">{t.uiSub}</text>

      <text x="400" y="402" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
