<!-- TsConfigBuild-1 -->
---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Transpile vs type-check: esbuild transpiles per file without checking so a type error ships, while tsc --noEmit checks the whole program as the CI gate and emits nothing",
    headline: "ONE SOURCE, TWO JOBS — TRANSPILE VS TYPE-CHECK",
    sub: "the bundler emits JS per file and never checks; tsc --noEmit checks and emits nothing",
    tagLeft: "esbuild / swc / babel — transpile",
    left1: "const total: number = someUserId;",
    gapLeft1: "per-file transpile — no check",
    left2: "annotation erased, not verified",
    gapLeft2: "10-100x faster — no program graph",
    left3: "emits JS — bug ships as NaN",
    tagRight: "tsc --noEmit — type-check",
    right1: "const total: number = someUserId;",
    gapRight1: "whole-program analysis",
    right2: "type error found — build fails",
    gapRight2: "slow — builds the program graph",
    right3: "emits nothing — the CI type gate",
    foot1: "bundlers strip types per file without checking them",
    foot2: "type safety exists only if tsc --noEmit runs as a separate gate",
    caption:
      "One source, two jobs: bundlers transpile fast but never verify types — tsc --noEmit is the separate gate that does.",
  },
  ru: {
    svgTitle: "Транспиляция против проверки типов: esbuild транспилирует пофайлово без проверки, поэтому ошибка типа уезжает в сборку, а tsc --noEmit проверяет всю программу как гейт CI и ничего не генерирует",
    headline: "ОДИН ИСХОДНИК, ДВЕ ЗАДАЧИ — ТРАНСПИЛЯЦИЯ И ПРОВЕРКА",
    sub: "бандлер генерирует JS пофайлово и не проверяет; tsc --noEmit проверяет и ничего не генерирует",
    tagLeft: "esbuild / swc / babel — транспиляция",
    left1: "const total: number = someUserId;",
    gapLeft1: "транспиляция по одному файлу — без проверки",
    left2: "аннотация удалена, а не проверена",
    gapLeft2: "в 10–100× быстрее — нет графа программы",
    left3: "генерирует JS — баг вылезет в production",
    tagRight: "tsc --noEmit — проверка типов",
    right1: "const total: number = someUserId;",
    gapRight1: "анализ всей программы",
    right2: "тип неверен — сборка падает",
    gapRight2: "медленно — строит граф всей программы",
    right3: "ничего не генерирует — CI-гейт типов",
    foot1: "бандлеры срезают типы пофайлово, не проверяя",
    foot2: "безопасность типов есть, лишь если tsc --noEmit идёт отдельным гейтом",
    caption:
      "Один исходник, две задачи: бандлеры быстро транспилируют, но не проверяют типы — это делает отдельный гейт tsc --noEmit.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="40" y="110" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="200" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left1}</text>
    <text x="200" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapLeft1}</text>
    <rect x="40" y="205" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="200" y="241" text-anchor="middle" font-size="12" fill="var(--ink)">{t.left2}</text>
    <text x="200" y="283" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapLeft2}</text>
    <rect x="40" y="300" width="320" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="336" text-anchor="middle" font-size="12" fill="var(--accent)">{t.left3}</text>

    <text x="600" y="92" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="440" y="110" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="146" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right1}</text>
    <text x="600" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapRight1}</text>
    <rect x="440" y="205" width="320" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="600" y="241" text-anchor="middle" font-size="12" fill="var(--ink)">{t.right2}</text>
    <text x="600" y="283" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gapRight2}</text>
    <rect x="440" y="300" width="320" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="336" text-anchor="middle" font-size="12" fill="var(--accent)">{t.right3}</text>

    <text x="400" y="388" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="410" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
