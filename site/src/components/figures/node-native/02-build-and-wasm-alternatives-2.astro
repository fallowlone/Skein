---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "How a native addon builds: node-gyp reads binding.gyp, generates platform build files, and invokes the host compiler; prebuildify shifts that work into a CI matrix ahead of publish",
    headline: "NODE-GYP BUILD AND THE PREBUILDIFY FLOW",
    sub: "binding.gyp in, .node binary out — users should never compile",
    step1: "binding.gyp",
    step1sub: "what to compile",
    step2: "node-gyp",
    step2sub: "build orchestrator",
    step3: "platform build files",
    step3sub: "Makefile / Xcode / MSVC",
    step4: "host compiler",
    step4sub: "GCC / Clang / MSVC",
    step5: ".node binary",
    step5sub: "loaded at runtime",
    ciHead: "BEFORE PUBLISH: CI MATRIX",
    ciBody1: "prebuildify --napi --strip on each platform/arch/libc",
    ciBody2: "binaries bundled into the published npm tarball",
    useHead: "AT INSTALL: PICK, DO NOT COMPILE",
    useBody1: "loader resolves the matching prebuild",
    useBody2: "no match: falls back to source compilation",
    foot: "one prebuild per platform serves all Node versions with Node-API",
    caption:
      "node-gyp reads binding.gyp, generates platform build files, and invokes the host compiler; prebuildify runs that work once per platform in CI and bundles the binaries, so install just picks the right file.",
  },
  ru: {
    svgTitle: "Как собирается нативный аддон: node-gyp читает binding.gyp, генерирует платформенные build-файлы и зовёт хостовый компилятор; prebuildify выносит работу в CI-матрицу до публикации",
    headline: "СБОРКА NODE-GYP И ПОТОК PREBUILDIFY",
    sub: "на входе binding.gyp, на выходе бинарник .node — без компиляции у пользователей",
    step1: "binding.gyp",
    step1sub: "что компилировать",
    step2: "node-gyp",
    step2sub: "оркестратор сборки",
    step3: "build-файлы платформы",
    step3sub: "Makefile / Xcode / MSVC",
    step4: "хостовый компилятор",
    step4sub: "GCC / Clang / MSVC",
    step5: "бинарник .node",
    step5sub: "загрузка в рантайме",
    ciHead: "ДО ПУБЛИКАЦИИ: CI-МАТРИЦА",
    ciBody1: "prebuildify --napi --strip под каждую платформу/арх/libc",
    ciBody2: "бинарники упакованы в публикуемый npm-тарбол",
    useHead: "ПРИ УСТАНОВКЕ: ВЫБРАТЬ, НЕ КОМПИЛИРОВАТЬ",
    useBody1: "загрузчик находит подходящий prebuild",
    useBody2: "нет совпадения: откат к компиляции из исходников",
    foot: "один prebuild на платформу обслуживает все версии Node с Node-API",
    caption:
      "node-gyp читает binding.gyp, генерирует платформенные build-файлы и зовёт хостовый компилятор; prebuildify выполняет эту работу один раз на платформу в CI и упаковывает бинарники, так что установка просто выбирает нужный файл.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="24" y="96" width="128" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="88" y="124" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step1}</text>
    <text x="88" y="146" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step1sub}</text>

    <text x="164" y="136" text-anchor="middle" font-size="14" fill="var(--muted)">→</text>

    <rect x="176" y="96" width="128" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="240" y="124" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step2}</text>
    <text x="240" y="146" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step2sub}</text>

    <text x="316" y="136" text-anchor="middle" font-size="14" fill="var(--muted)">→</text>

    <rect x="320" y="96" width="160" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="124" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step3}</text>
    <text x="400" y="146" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step3sub}</text>

    <text x="484" y="136" text-anchor="middle" font-size="14" fill="var(--muted)">→</text>

    <rect x="496" y="96" width="128" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="560" y="124" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step4}</text>
    <text x="560" y="146" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step4sub}</text>

    <text x="636" y="136" text-anchor="middle" font-size="14" fill="var(--muted)">→</text>

    <rect x="648" y="96" width="128" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="712" y="124" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step5}</text>
    <text x="712" y="146" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step5sub}</text>

    <rect x="24" y="200" width="368" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="208" y="226" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ciHead}</text>
    <text x="208" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.ciBody1}</text>
    <text x="208" y="282" text-anchor="middle" font-size="11" fill="var(--ink)">{t.ciBody2}</text>

    <rect x="408" y="200" width="368" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="592" y="226" text-anchor="middle" font-size="12" fill="var(--ink)">{t.useHead}</text>
    <text x="592" y="254" text-anchor="middle" font-size="11" fill="var(--ink)">{t.useBody1}</text>
    <text x="592" y="282" text-anchor="middle" font-size="11" fill="var(--ink)">{t.useBody2}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
