---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Raw V8 and NAN binaries rebuild every Node major while one Node-API binary loads everywhere, and a coarse one-call-per-buffer boundary beats a chatty one-call-per-pixel boundary that runs slower than JS",
    headline: "ONE BINARY SURVIVES, COARSE WINS",
    sub: "ABI decides rebuilds, shape decides speed",
    rowV8: "Raw V8 (v8.h)",
    rowNan: "NAN",
    rowNapi: "Node-API (napi_*)",
    outV8: "rebuild every major, segfault risk",
    outNan: "source portable, binary rebuilds",
    outNapi: "one binary loads everywhere",
    tagCoarse: "coarse",
    tagChatty: "chatty",
    coarseLine1: "one call per buffer",
    coarseLine2: "pays boundary tax once",
    chattyLine1: "one call per pixel x1M",
    chattyLine2: "slower than pure JS",
    foot1: "each crossing: handle scope + marshalling, opaque to JIT",
    caption:
      "Raw V8 binds to the unstable C++ ABI and NAN only smooths the source, so both rebuild every Node major — one Node-API binary loads everywhere. And each crossing pays handle-scope plus marshalling tax opaque to the JIT, so one coarse call per buffer wins while a million per-pixel calls run slower than pure JS.",
  },
  ru: {
    svgTitle: "Бинарники Raw V8 и NAN пересобираются под каждый мажор Node, а один бинарник Node-API грузится везде; грубая граница с одним вызовом на буфер побеждает болтливую с вызовом на пиксель, которая медленнее чистого JS",
    headline: "ОДИН БИНАРНИК ЖИВЁТ, ГРУБЫЙ ВЫИГРЫВАЕТ",
    sub: "ABI решает пересборки, форма — скорость",
    rowV8: "Raw V8 (v8.h)",
    rowNan: "NAN",
    rowNapi: "Node-API (napi_*)",
    outV8: "пересборка под каждый мажор, риск segfault",
    outNan: "исходник переносим, бинарник — нет",
    outNapi: "один бинарник грузится везде",
    tagCoarse: "грубая",
    tagChatty: "болтливая",
    coarseLine1: "один вызов на буфер",
    coarseLine2: "налог границы платится раз",
    chattyLine1: "вызов на пиксель x1M",
    chattyLine2: "медленнее чистого JS",
    foot1: "каждый переход: handle scope + маршалинг, непрозрачно для JIT",
    caption:
      "Raw V8 привязан к нестабильному C++ ABI, а NAN сглаживает только исходник, поэтому оба пересобираются под каждый мажор Node — а один бинарник Node-API грузится везде. И каждый переход платит налогом handle scope и маршалинга, непрозрачным для JIT, поэтому один грубый вызов на буфер выигрывает, а миллион вызовов на пиксель бегут медленнее чистого JS.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="122" text-anchor="end" font-size="11" fill="var(--muted)">{t.rowV8}</text>
    <rect x="220" y="100" width="330" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="540" y="125" text-anchor="end" font-size="11" fill="var(--ink)">{t.outV8}</text>

    <text x="200" y="172" text-anchor="end" font-size="11" fill="var(--muted)">{t.rowNan}</text>
    <rect x="220" y="150" width="330" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="540" y="175" text-anchor="end" font-size="11" fill="var(--ink)">{t.outNan}</text>

    <text x="200" y="222" text-anchor="end" font-size="11" fill="var(--muted)">{t.rowNapi}</text>
    <rect x="220" y="200" width="330" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="540" y="225" text-anchor="end" font-size="11" fill="var(--ink)">{t.outNapi}</text>

    <text x="150" y="300" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagCoarse}</text>
    <rect x="170" y="272" width="250" height="62" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="295" y="298" text-anchor="middle" font-size="12" fill="var(--ink)">{t.coarseLine1}</text>
    <text x="295" y="320" text-anchor="middle" font-size="11" fill="var(--ink)">{t.coarseLine2}</text>

    <text x="490" y="300" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagChatty}</text>
    <rect x="510" y="272" width="250" height="62" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="635" y="298" text-anchor="middle" font-size="12" fill="var(--ink)">{t.chattyLine1}</text>
    <text x="635" y="320" text-anchor="middle" font-size="11" fill="var(--ink)">{t.chattyLine2}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
