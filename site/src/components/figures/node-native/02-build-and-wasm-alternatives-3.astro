---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Alternatives to a native addon: WebAssembly as one portable sandboxed artifact, a child process for existing tools with crash isolation, or plain JavaScript with zero build risk",
    headline: "BEFORE YOU GO NATIVE: THREE EXITS",
    sub: "default to plain JS — escalate only on a proven need",
    wasmHead: "WebAssembly",
    wasmRow1: "one portable .wasm for every OS/arch",
    wasmRow2: "sandboxed; WASI grants syscalls",
    wasmRow3: "data crosses by memory copy",
    wasmRow4: "no arbitrary OS API access",
    wasmFit1: "fit: portable compute kernels",
    wasmFit2: "parsers, codecs, crypto",
    cpHead: "Child process",
    cpRow1: "spawn an existing native CLI",
    cpRow2: "crash kills only the child",
    cpRow3: "cost: IPC + deploy the binary",
    cpRow4: "process-per-call unless pooled",
    cpFit1: "fit: tool exists,",
    cpFit2: "isolation wins",
    cpNote: "child_process over stdio",
    jsNote1: "typed arrays,",
    jsNote2: "no allocs in hot loops",
    jsHead: "Plain JavaScript",
    jsRow1: "JIT is fast, often close enough",
    jsRow2: "zero install risk",
    jsRow3: "zero build matrix",
    jsRow4: "zero cross-platform variance",
    jsFit: "fit: default — prove native first",
    foot: "burden of proof is on going native, not on staying in JS",
    caption:
      "WebAssembly gives portable sandboxed compute with no install-time compiler, a child process reuses an existing tool with crash isolation, and plain JavaScript carries zero build risk — so the burden of proof is on going native.",
  },
  ru: {
    svgTitle: "Альтернативы нативному аддону: WebAssembly как единый переносимый песочничный артефакт, дочерний процесс для готовых инструментов с изоляцией и обычный JavaScript без риска сборки",
    headline: "ПРЕЖДЕ ЧЕМ УЙТИ В НАТИВ: ТРИ ВЫХОДА",
    sub: "дефолт — обычный JS, эскалация лишь по доказанной нужде",
    wasmHead: "WebAssembly",
    wasmRow1: "единый .wasm под каждую ОС/арх",
    wasmRow2: "песочница; WASI выдаёт syscalls",
    wasmRow3: "данные — копированием памяти",
    wasmRow4: "нет доступа к произвольному OS API",
    wasmFit1: "подходит: переносимые",
    wasmFit2: "ядра вычислений",
    cpHead: "Дочерний процесс",
    cpRow1: "запуск готового нативного CLI",
    cpRow2: "крэш убивает лишь дочерний процесс",
    cpRow3: "цена: IPC + деплой бинарника",
    cpRow4: "процесс-на-вызов без пулинга",
    cpFit1: "подходит: инструмент есть,",
    cpFit2: "важна изоляция",
    cpNote: "child_process через stdio",
    jsNote1: "типизированные массивы,",
    jsNote2: "без аллокаций в горячих циклах",
    jsHead: "Обычный JavaScript",
    jsRow1: "JIT быстр, часто хватает",
    jsRow2: "ноль риска установки",
    jsRow3: "ноль build-матрицы",
    jsRow4: "нулевая разнородность платформ",
    jsFit: "подходит: сначала докажи нужду",
    foot: "бремя доказательства — на уходе в натив, а не на оставании в JS",
    caption:
      "WebAssembly даёт переносимые песочничные вычисления без компилятора при установке, дочерний процесс переиспользует готовый инструмент с изоляцией при крэше, а обычный JavaScript несёт нулевой риск сборки — поэтому бремя доказательства на уходе в нативный код.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="24" y="84" width="240" height="250" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="144" y="110" text-anchor="middle" font-size="13" fill="var(--ink)">{t.wasmHead}</text>
    <text x="144" y="142" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wasmRow1}</text>
    <text x="144" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wasmRow2}</text>
    <text x="144" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wasmRow3}</text>
    <text x="144" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wasmRow4}</text>
    <text x="144" y="262" text-anchor="middle" font-size="11" fill="var(--muted)">{t.wasmFit1}</text>
    <text x="144" y="284" text-anchor="middle" font-size="11" fill="var(--muted)">{t.wasmFit2}</text>
    <text x="144" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">WebAssembly.instantiate</text>

    <rect x="280" y="84" width="240" height="250" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="110" text-anchor="middle" font-size="13" fill="var(--ink)">{t.cpHead}</text>
    <text x="400" y="142" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cpRow1}</text>
    <text x="400" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cpRow2}</text>
    <text x="400" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cpRow3}</text>
    <text x="400" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.cpRow4}</text>
    <text x="400" y="262" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cpFit1}</text>
    <text x="400" y="284" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cpFit2}</text>
    <text x="400" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cpNote}</text>

    <rect x="536" y="84" width="240" height="250" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="656" y="110" text-anchor="middle" font-size="13" fill="var(--ink)">{t.jsHead}</text>
    <text x="656" y="142" text-anchor="middle" font-size="11" fill="var(--ink)">{t.jsRow1}</text>
    <text x="656" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.jsRow2}</text>
    <text x="656" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.jsRow3}</text>
    <text x="656" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.jsRow4}</text>
    <text x="656" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.jsFit}</text>
    <text x="656" y="300" text-anchor="middle" font-size="11" fill="var(--muted)">{t.jsNote1}</text>
    <text x="656" y="322" text-anchor="middle" font-size="11" fill="var(--muted)">{t.jsNote2}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
