---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "N-API addon anatomy: JS numbers cross the boundary as opaque napi_value handles marshalled to C doubles and back, never touching V8 layouts",
    headline: "ADDON ANATOMY: OPAQUE HANDLES",
    sub: "values are copied across, never aliased",
    jsTitle: "JS: addon.add(2, 3)",
    jsLine: "napi_value handle",
    midTitle: "boundary: napi_env",
    midLine1: "marshal in: Number -> double",
    midLine2: "marshal out: double -> Number",
    natTitle: "C: double a + b",
    natLine: "no V8 layout seen",
    foot1: "opaque handle, never a V8 pointer",
    foot2: "napi_env is valid only for this call",
    caption:
      "A JS number crosses the addon boundary as an opaque napi_value handle marshalled to a C double and back — the binary never sees a V8 layout, and napi_env is valid only for the call it was handed to.",
  },
  ru: {
    svgTitle: "Анатомия аддона на Node-API: JS-числа пересекают границу непрозрачными хэндлами napi_value с маршалингом в C double и обратно, не касаясь раскладок V8",
    headline: "АДДОН: НЕПРОЗРАЧНЫЕ ХЭНДЛЫ",
    sub: "значения копируются через границу, не алиасятся",
    jsTitle: "JS: addon.add(2, 3)",
    jsLine: "хэндл napi_value",
    midTitle: "граница: napi_env",
    midLine1: "вход: Number -> double",
    midLine2: "выход: double -> Number",
    natTitle: "C: double a + b",
    natLine: "раскладки V8 не видно",
    foot1: "непрозрачный хэндл, не указатель V8",
    foot2: "napi_env действителен только в этом вызове",
    caption:
      "JS-число пересекает границу аддона непрозрачным хэндлом napi_value с маршалингом в C double и обратно — бинарник никогда не видит раскладку V8, а napi_env действителен только в рамках того вызова, которому передан.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="120" width="200" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="140" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.jsTitle}</text>
    <text x="140" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.jsLine}</text>
    <text x="140" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">addon.node</text>

    <line x1="240" y1="180" x2="280" y2="180" stroke="var(--muted)" stroke-width="2" />
    <polygon points="280,172 296,180 280,188" fill="var(--muted)" />

    <rect x="296" y="120" width="208" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.midTitle}</text>
    <text x="400" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.midLine1}</text>
    <text x="400" y="204" text-anchor="middle" font-size="11" fill="var(--ink)">{t.midLine2}</text>

    <line x1="504" y1="180" x2="544" y2="180" stroke="var(--muted)" stroke-width="2" />
    <polygon points="544,172 560,180 544,188" fill="var(--muted)" />

    <rect x="560" y="120" width="200" height="120" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="660" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.natTitle}</text>
    <text x="660" y="180" text-anchor="middle" font-size="11" fill="var(--ink)">{t.natLine}</text>
    <text x="660" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">NODE_API_MODULE</text>

    <text x="400" y="300" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="328" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
