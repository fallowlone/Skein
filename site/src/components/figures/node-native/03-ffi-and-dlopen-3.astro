---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The GC stops here: free what C mallocs, keep passed Buffers alive, allocate output parameters explicitly — a wrong type or freed pointer is a SIGSEGV no try-catch can save",
    headline: "THE GC STOPS HERE: THREE OWNERSHIP RULES",
    sub: "native memory is invisible to the collector",
    tag1: "rule 1",
    rule1a: "C malloc'd it? YOU free it",
    rule1b: "decode(ptr), then free(ptr)",
    tag2: "rule 2",
    rule2a: "passed a Buffer? keep it alive",
    rule2b: "GC must not collect or move it",
    tag3: "rule 3",
    rule3a: "output param? allocate first",
    rule3b: "koffi.alloc, pass pointer, decode",
    foot1: "'int' for a 64-bit handle truncates to 32 bits",
    foot2: "SIGSEGV kills the process — no try/catch saves you",
    caption:
      "The GC never frees C malloc and C cannot see the JS heap: free what C allocates, keep passed buffers referenced, allocate outputs explicitly — a wrong type or freed pointer is a SIGSEGV, not a catchable error.",
  },
  ru: {
    svgTitle: "GC сюда не видит: освобождай то, что malloc-нул C, держи переданные Buffer живыми, аллоцируй выходные параметры явно — неверный тип или освобождённый указатель это SIGSEGV, который не ловит try-catch",
    headline: "GC СЮДА НЕ ВИДИТ: ТРИ ПРАВИЛА ВЛАДЕНИЯ",
    sub: "нативная память невидима для сборщика",
    tag1: "правило 1",
    rule1a: "C malloc-нул? освобождаешь ТЫ",
    rule1b: "сначала decode, потом free",
    tag2: "правило 2",
    rule2a: "передал Buffer? держи ссылку",
    rule2b: "GC не должен собрать и сдвинуть",
    tag3: "правило 3",
    rule3a: "выходной параметр? сначала alloc",
    rule3b: "koffi.alloc, указатель, decode",
    foot1: "'int' вместо 64-битного хэндла режет до 32 бит",
    foot2: "SIGSEGV убивает процесс — try/catch не спасёт",
    caption:
      "GC никогда не вернёт malloc библиотеки, а C не видит JS-кучу: освобождай C-аллокации, держи переданные буферы под ссылкой, аллоцируй выходы явно — неверный тип или освобождённый указатель это SIGSEGV, а не ловимая ошибка.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="130" y="126" text-anchor="end" font-size="11" fill="var(--muted)">{t.tag1}</text>
    <rect x="150" y="94" width="560" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="430" y="120" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rule1a}</text>
    <text x="430" y="144" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rule1b}</text>

    <text x="130" y="206" text-anchor="end" font-size="11" fill="var(--muted)">{t.tag2}</text>
    <rect x="150" y="174" width="560" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="430" y="200" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rule2a}</text>
    <text x="430" y="224" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rule2b}</text>

    <text x="130" y="286" text-anchor="end" font-size="11" fill="var(--muted)">{t.tag3}</text>
    <rect x="150" y="254" width="560" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="430" y="280" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rule3a}</text>
    <text x="430" y="304" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rule3b}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="385" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
