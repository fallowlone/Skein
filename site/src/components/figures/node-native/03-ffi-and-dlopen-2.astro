---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "From dlopen to return: JavaScript declares the C prototype, libffi builds the call frame at runtime per the platform ABI, trampolines into the shared library, and marshals the return back",
    headline: "DLOPEN TO RETURN: HOW ONE FFI CALL RUNS",
    sub: "no compiler — libffi builds the frame at runtime",
    step1a: "koffi.load",
    step1b: ".so opened",
    step2a: "func('double…')",
    step2b: "declare prototype",
    step3a: "libffi frame",
    step3b: "args to ABI slots",
    step4a: "trampoline",
    step4b: "call, read return",
    foot1: "each call pays tens of ns over the C work",
    foot2: "sweet spot: coarse calls, not a hot loop",
    caption:
      "No compiler runs: libffi turns the runtime signature into a native call against the existing binary — the per-call trampoline plus marshalling suits coarse calls, not a hot loop.",
  },
  ru: {
    svgTitle: "От dlopen до возврата: JavaScript объявляет C-прототип, libffi строит кадр вызова в рантайме по ABI платформы, прыгает трамплином в разделяемую библиотеку и маршалит возврат обратно",
    headline: "ОТ DLOPEN ДО ВОЗВРАТА: КАК ИДЁТ FFI-ВЫЗОВ",
    sub: "без компилятора — libffi строит кадр в рантайме",
    step1a: "koffi.load",
    step1b: ".so открыта",
    step2a: "func('double…')",
    step2b: "объявляем прототип",
    step3a: "кадр libffi",
    step3b: "аргументы в слоты ABI",
    step4a: "трамплин",
    step4b: "вызов, чтение возврата",
    foot1: "каждый вызов платит десятки нс поверх работы C",
    foot2: "ниша: крупные вызовы, а не горячий цикл",
    caption:
      "Компилятор не запускается: libffi превращает рантайм-сигнатуру в нативный вызов против готового бинаря — трамплин и маршалинг на каждый вызов годятся крупным вызовам, а не горячему циклу.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="120" width="160" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="110" y="164" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step1a}</text>
    <text x="110" y="190" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step1b}</text>

    <text x="205" y="182" text-anchor="middle" font-size="14" fill="var(--muted)">→</text>

    <rect x="220" y="120" width="160" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="300" y="164" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step2a}</text>
    <text x="300" y="190" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step2b}</text>

    <text x="395" y="182" text-anchor="middle" font-size="14" fill="var(--muted)">→</text>

    <rect x="410" y="120" width="160" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="490" y="164" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step3a}</text>
    <text x="490" y="190" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step3b}</text>

    <text x="585" y="182" text-anchor="middle" font-size="14" fill="var(--muted)">→</text>

    <rect x="600" y="120" width="160" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="680" y="164" text-anchor="middle" font-size="12" fill="var(--ink)">{t.step4a}</text>
    <text x="680" y="190" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step4b}</text>

    <text x="400" y="300" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
