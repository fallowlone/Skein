---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "koffi versus ffi-napi: koffi ships prebuilt and maintained, while ffi-napi is itself a native addon that re-imports the node-gyp, prebuild and ABI build pain",
    headline: "KOFFI VS FFI-NAPI: WHO ESCAPES THE COMPILER",
    sub: "the binding choice for new FFI work",
    tagLeft: "pick",
    tagRight: "legacy",
    leftHead: "koffi — senior default",
    leftLine1: "prebuilt binaries, no node-gyp",
    leftLine2: "maintained, survives Node majors",
    leftLine3: "faster calls, structs + pointers",
    rightHead: "ffi-napi + ref-napi — legacy",
    rightLine1: "itself a native addon",
    rightLine2: "node-gyp / prebuild / ABI matrix",
    rightLine3: "breaks each Node major, unmaintained",
    foot1: "new work starts on koffi",
    foot2: "ffi-napi is migrate-off legacy",
    caption:
      "The split is about who escapes the compiler: koffi ships prebuilt and maintained; ffi-napi is itself an addon that re-imports the build pain FFI was meant to avoid.",
  },
  ru: {
    svgTitle: "koffi против ffi-napi: koffi поставляется prebuilt и поддерживается, а ffi-napi сам является нативным аддоном, заново втаскивающим боль сборки node-gyp, prebuild и ABI",
    headline: "KOFFI ПРОТИВ FFI-NAPI: КТО ИЗБЕГАЕТ КОМПИЛЯТОРА",
    sub: "выбор биндинга для новой FFI-работы",
    tagLeft: "бери",
    tagRight: "легаси",
    leftHead: "koffi — senior-дефолт",
    leftLine1: "prebuilt-бинари, без node-gyp",
    leftLine2: "поддерживается, переживает мажоры",
    leftLine3: "быстрее вызовы, структуры и указатели",
    rightHead: "ffi-napi + ref-napi — легаси",
    rightLine1: "сам нативный аддон",
    rightLine2: "матрица node-gyp / prebuild / ABI",
    rightLine3: "ломается в каждый мажор, без поддержки",
    foot1: "новую работу начинай на koffi",
    foot2: "с ffi-napi мигрируют",
    caption:
      "Разлом в том, кто избегает компилятора: koffi поставляется prebuilt и поддерживается; ffi-napi сам аддон, заново втаскивающий ту боль сборки, которую FFI должен был устранить.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="60" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="80" y="104" width="310" height="180" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="235" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftHead}</text>
    <text x="235" y="168" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine1}</text>
    <text x="235" y="204" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine2}</text>
    <text x="235" y="240" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine3}</text>

    <text x="450" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="470" y="104" width="310" height="180" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="625" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightHead}</text>
    <text x="625" y="168" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine1}</text>
    <text x="625" y="204" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine2}</text>
    <text x="625" y="240" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine3}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="355" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
