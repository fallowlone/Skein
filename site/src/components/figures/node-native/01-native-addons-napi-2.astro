---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Sync native call blocks the event loop for 200 milliseconds, while AsyncWorker splits into marshal on the main thread, Execute on a libuv thread with no napi_value, and OnOK back on the main thread",
    headline: "SYNC BLOCKS, ASYNC WORK MOVES",
    sub: "Execute never touches napi_value",
    tagSync: "sync",
    tagSplit: "split",
    syncLine1: "sync 200 ms on main thread",
    syncLine2: "loop frozen: requests + timers wait",
    ph1Title: "marshal inputs",
    ph1Line: "main thread",
    ph2Title: "Execute: heavy work",
    ph2Line: "libuv thread, no napi_value",
    ph3Title: "OnOK",
    ph3Line: "main thread",
    foot1: "slow work off-thread via AsyncWorker",
    foot2: "foreign thread calls back via thread-safe function",
    caption:
      "A synchronous 200 ms native call freezes the whole event loop, so slow work splits into an AsyncWorker: marshal inputs on the main thread, heavy Execute on a libuv thread touching no napi_value, then OnOK back on the main thread — and any foreign thread calls back only through a thread-safe function.",
  },
  ru: {
    svgTitle: "Синхронный нативный вызов блокирует событийный цикл на 200 миллисекунд, а AsyncWorker делится на маршалинг на главном потоке, Execute на потоке libuv без napi_value и OnOK обратно на главном потоке",
    headline: "СИНХРОН БЛОКИРУЕТ, WORKER УВОДИТ",
    sub: "Execute не трогает napi_value",
    tagSync: "синхрон",
    tagSplit: "разбивка",
    syncLine1: "синхронные 200 мс на главном потоке",
    syncLine2: "цикл стоит: запросы и таймеры ждут",
    ph1Title: "маршалинг входов",
    ph1Line: "главный поток",
    ph2Title: "Execute: тяжёлая работа",
    ph2Line: "поток libuv, без napi_value",
    ph3Title: "OnOK",
    ph3Line: "главный поток",
    foot1: "медленная работа — вне потока через AsyncWorker",
    foot2: "чужой поток зовёт назад через thread-safe function",
    caption:
      "Синхронный нативный вызов на 200 мс замораживает весь событийный цикл, поэтому медленная работа делится на AsyncWorker: маршалинг входов на главном потоке, тяжёлый Execute на потоке libuv без касания napi_value, затем OnOK обратно на главном потоке — а чужой поток зовёт назад только через thread-safe function.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagSync}</text>
    <rect x="170" y="104" width="460" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.syncLine1}</text>
    <text x="400" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.syncLine2}</text>

    <text x="150" y="246" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagSplit}</text>
    <rect x="170" y="214" width="180" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="260" y="242" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ph1Title}</text>
    <text x="260" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.ph1Line}</text>

    <line x1="350" y1="247" x2="370" y2="247" stroke="var(--muted)" stroke-width="2" />
    <polygon points="370,239 386,247 370,255" fill="var(--muted)" />

    <rect x="386" y="214" width="224" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="498" y="242" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ph2Title}</text>
    <text x="498" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.ph2Line}</text>

    <line x1="610" y1="247" x2="630" y2="247" stroke="var(--muted)" stroke-width="2" />
    <polygon points="630,239 646,247 630,255" fill="var(--muted)" />

    <rect x="646" y="214" width="114" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="703" y="242" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ph3Title}</text>
    <text x="703" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.ph3Line}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="355" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
