---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Installing a native addon by compiling from source versus shipping prebuilds: compile needs a toolchain on every machine, prebuilds move that cost into CI once",
    headline: "COMPILE AT INSTALL vs PREBUILDS",
    sub: "the toolchain cost, paid per machine or paid once in CI",
    leftHead: "COMPILE FROM SOURCE",
    leftRow1: "needs Python + C/C++ compiler",
    leftRow2: "needs matching Node headers",
    leftRow3: "minutes of build per install",
    leftRow4: "breaks: minimal Docker",
    leftRow5: "breaks: Alpine musl, Windows",
    rightHead: "SHIP PREBUILDS",
    rightRow1: "no compiler at install",
    rightRow2: ".node bundled in npm tarball",
    rightRow3: "install picks matching binary",
    rightRow4: "--napi: one per platform",
    rightRow5: "no match: falls back to compile",
    leftNote: "npm install = compile a C++ project",
    rightNote: "install = copy the right file",
    foot: "prebuilds move the toolchain from every user to your release pipeline",
    caption:
      "Compiling at install pays a toolchain cost on every machine; prebuilds move that cost into your CI once, and Node-API collapses the matrix to one binary per platform.",
  },
  ru: {
    svgTitle: "Установка нативного аддона компиляцией из исходников против готовых сборок: компиляция требует тулчейн на каждой машине, а сборки переносят цену в CI один раз",
    headline: "КОМПИЛЯЦИЯ ПРИ УСТАНОВКЕ vs СБОРКИ",
    sub: "цена тулчейна: на каждой машине или один раз в CI",
    leftHead: "КОМПИЛЯЦИЯ ИЗ ИСХОДНИКОВ",
    leftRow1: "нужны Python + C/C++-компилятор",
    leftRow2: "нужны заголовки Node",
    leftRow3: "минуты сборки на установку",
    leftRow4: "падает: минимальный Docker",
    leftRow5: "падает: Alpine musl, Windows",
    rightHead: "ГОТОВЫЕ СБОРКИ",
    rightRow1: "нет компилятора при установке",
    rightRow2: ".node вшиты в npm-тарбол",
    rightRow3: "установка выбирает свой бинарник",
    rightRow4: "--napi: одна сборка на платформу",
    rightRow5: "нет совпадения: откат к компиляции",
    leftNote: "npm install = компиляция C++-проекта",
    rightNote: "установка = копия нужного файла",
    foot: "сборки переносят тулчейн с пользователей на релизный пайплайн",
    caption:
      "Компиляция при установке требует тулчейн на каждой машине; готовые сборки переносят эту цену в твой CI один раз, а Node-API сжимает матрицу до одного бинарника на платформу.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="84" width="340" height="250" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="210" y="110" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftHead}</text>
    <text x="210" y="142" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftRow1}</text>
    <text x="210" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftRow2}</text>
    <text x="210" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftRow3}</text>
    <text x="210" y="238" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftRow4}</text>
    <text x="210" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftRow5}</text>
    <text x="210" y="308" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftNote}</text>

    <rect x="420" y="84" width="340" height="250" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="110" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightHead}</text>
    <text x="590" y="142" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightRow1}</text>
    <text x="590" y="170" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightRow2}</text>
    <text x="590" y="198" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightRow3}</text>
    <text x="590" y="238" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightRow4}</text>
    <text x="590" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightRow5}</text>
    <text x="590" y="308" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightNote}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
