---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Sharding tradeoff: 4 shards give about 4x CPU and IO but need 4 backups and 4 migration runs; 10 shards give 5 to 8x, never 10x",
    headline: "SHARDING: LINEAR-ISH GAIN, N× COST",
    sub: "one dataset, N machines, N-times the operations",
    lTitle: "ONE POSTGRES",
    lRows: ["all rows here", "1 CPU/IO ceiling", "1 backup, 1 migration"],
    rTitle: "4 SHARDS",
    rRows: ["rows by shard key", "~4× CPU/IO", "4 backups, 4× migrate"],
    barLine: "10 shards → ~5–8× throughput (not 10×)",
    barSub: "coordination overhead eats the theory",
    caption:
      "Four shards give about 4× the CPU/IO but demand 4 backups and 4 migration runs; ten shards yield about 5–8×, never the theoretical 10×. Capacity scales — and so does every operation.",
  },
  ru: {
    svgTitle: "Компромисс шардирования: 4 шарда дают ~4x CPU/IO, но требуют 4 бэкапа и 4 миграции; 10 шардов дают 5–8x, не 10x",
    headline: "ШАРДИРОВАНИЕ: РОСТ И ЦЕНА N×",
    sub: "один датасет, N машин, N× операций",
    lTitle: "ОДИН POSTGRES",
    lRows: ["все строки здесь", "1 потолок CPU/IO", "1 бэкап, 1 миграция"],
    rTitle: "4 ШАРДА",
    rRows: ["строки по ключу", "~4× CPU/IO", "4 бэкапа, 4× миграций"],
    barLine: "10 шардов → ~5–8× пропускной способности (не 10×)",
    barSub: "координация съедает теорию",
    caption:
      "Четыре шарда дают примерно 4× CPU/IO, но требуют 4 бэкапа и 4 запуска миграции; десять шардов дают около 5–8×, но никогда не теоретические 10×. Масштабируется мощность — и каждая операция вместе с ней.",
  },
};

const t = dict[lang];

const rowY = [150, 192, 234];
const rowH = 34;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbshard-tradeoff-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="110" width="300" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="190" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lTitle}</text>
    {t.lRows.map((r, i) => (
      <g>
        <rect x="60" y={rowY[i]} width="260" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="190" y={rowY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <line x1="348" y1="201" x2="452" y2="201" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbshard-tradeoff-arrow)" />

    <rect x="460" y="110" width="300" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="610" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rTitle}</text>
    {t.rRows.map((r, i) => (
      <g>
        <rect x="480" y={rowY[i]} width="260" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="610" y={rowY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <rect x="60" y="312" width="680" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="335" text-anchor="middle" font-size="12" fill="var(--ink)">{t.barLine}</text>
    <text x="400" y="357" text-anchor="middle" font-size="11" fill="var(--muted)">{t.barSub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
