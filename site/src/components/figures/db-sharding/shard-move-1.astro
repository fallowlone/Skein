---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Online shard move: create empty, copy at 10 to 100 MB per second, stream to lag zero, flick metadata with sub-second pause",
    headline: "ONLINE MOVE: STREAM, THEN FLICK",
    sub: "Citus 11.1 · logical replication",
    stT: ["1 · CREATE", "2 · COPY", "3 · STREAM", "4 · FLICK"],
    stV: ["empty shard", "10–100 MB/s", "lag → ~0", "sub-second"],
    stS: ["on target", "existing rows", "changes live", "metadata switch"],
    barLine: "bulk moves online · only the flick pauses writes",
    barSub: "crash mid-move? resume via pg_stat_subscription",
    caption:
      "Citus 11.1: create empty, copy at 10–100 MB/s, stream to lag near zero, then flick the metadata in under a second. Mid-move crash? Resume from pg_stat_subscription — never from backup.",
  },
  ru: {
    svgTitle: "Онлайн-переезд шарда: создать пустой, скопировать на 10–100 MB/s, достримить до нуля, переключить метаданные с паузой меньше секунды",
    headline: "ОНЛАЙН-ПЕРЕЕЗД: СТРИМ, ТОЛЧОК",
    sub: "Citus 11.1 · logical replication",
    stT: ["1 · СОЗДАТЬ", "2 · КОПИЯ", "3 · СТРИМ", "4 · ТОЛЧОК"],
    stV: ["пустой шард", "10–100 MB/s", "lag → ~0", "доли секунды"],
    stS: ["на целевом", "старые строки", "изменения live", "смена метаданных"],
    barLine: "масса едет онлайн · пишет стоп лишь на толчке",
    barSub: "сбой в пути? продолжи via pg_stat_subscription",
    caption:
      "Citus 11.1: создай пустой, скопируй на 10–100 MB/s, достримь до почти нуля, затем толкни метаданные меньше чем за секунду. Сбой посреди переезда? Продолжи с pg_stat_subscription — не с бэкапа.",
  },
};

const t = dict[lang];

const stX = [30, 220, 410, 600];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbshard-move-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    {t.stT.map((u, i) => (
      <g>
        <rect x={stX[i]} y="120" width="170" height="130" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={stX[i] + 85} y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{u}</text>
        <text x={stX[i] + 85} y="192" text-anchor="middle" font-size="12" fill="var(--accent)">{t.stV[i]}</text>
        <text x={stX[i] + 85} y="216" text-anchor="middle" font-size="11" fill="var(--muted)">{t.stS[i]}</text>
      </g>
    ))}

    <line x1="204" y1="185" x2="216" y2="185" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbshard-move-arrow)" />
    <line x1="394" y1="185" x2="406" y2="185" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbshard-move-arrow)" />
    <line x1="584" y1="185" x2="596" y2="185" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbshard-move-arrow)" />

    <rect x="40" y="290" width="720" height="64" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="315" text-anchor="middle" font-size="12" fill="var(--ink)">{t.barLine}</text>
    <text x="400" y="339" text-anchor="middle" font-size="11" fill="var(--muted)">{t.barSub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
