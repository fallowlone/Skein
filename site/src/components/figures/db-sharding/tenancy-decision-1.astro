---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Isolation ladder: RLS until one Postgres fills, row sharding to 50k tenants, schema to 3k, database per tenant to 500",
    headline: "STRONGER WALLS, FEWER TENANTS",
    sub: "each step toward isolation costs ~10× tenants",
    decN: ["RLS · ONE POSTGRES", "ROW-BASED SHARD", "SCHEMA PER TENANT", "DATABASE PER TENANT"],
    decC: ["until 1 PG fills", "~50,000 tenants", "~3,000 tenants", "~100–500 tenants"],
    footLine: "200 tenants + contract → database each",
    caption:
      "Isolation costs tenants about 10× per step: around 50,000 row-sharded, 3,000 schema-based, 100–500 database-per-tenant. 200 tenants with a contract? Give each a database.",
  },
  ru: {
    svgTitle: "Лестница изоляции: RLS пока хватает одного Postgres, шарды до 50k тенантов, схемы до 3k, база на тенанта до 500",
    headline: "КРЕПЧЕ СТЕНЫ — МЕНЬШЕ ТЕНАНТОВ",
    sub: "шаг к изоляции = ~10× меньше тенантов",
    decN: ["RLS · ОДИН POSTGRES", "ШАРД ПО СТРОКАМ", "СХЕМА НА ТЕНАНТА", "БАЗА НА ТЕНАНТА"],
    decC: ["пока хватает 1 PG", "~50,000 тенантов", "~3,000 тенантов", "~100–500 тенантов"],
    footLine: "200 тенантов + договор → база каждому",
    caption:
      "Изоляция стоит около 10× тенантов за шаг: примерно 50 000 на шардах по строкам, 3 000 на схемах, 100–500 на базах. 200 тенантов с договором? Каждому по базе.",
  },
};

const t = dict[lang];

const decY = [110, 168, 226, 284];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.decN.map((dd, i) => (
      <g>
        <rect x="40" y={decY[i]} width="720" height="50" fill="var(--card)" stroke={i === 3 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 3 ? 2.5 : 1.5} />
        <text x="62" y={decY[i] + 32} font-size="12" fill="var(--ink)">{dd}</text>
        <text x="738" y={decY[i] + 32} text-anchor="end" font-size="12" fill="var(--accent)">{t.decC[i]}</text>
      </g>
    ))}

    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.footLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
