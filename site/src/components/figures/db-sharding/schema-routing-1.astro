---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Citus 12 schema-based sharding: create schema acme, set search path, Citus places the schema on one worker",
    headline: "SCHEMA PER TENANT, ROUTED BY CITUS",
    sub: "Citus 12 · July 2023 · search_path does the routing",
    lTitle: "ONBOARD ACME",
    lRows: ["CREATE SCHEMA acme", "acme.orders, acme.users", "SET search_path TO acme"],
    rTitle: "CITUS PLACES SCHEMA",
    rRows: ["→ one worker", "joins inside = local", "DROP SCHEMA = offboard"],
    barLine: "no shared key column · ceiling: low thousands",
    barSub: "CREATE for onboard · DROP CASCADE for offboard",
    caption:
      "Citus 12 (July 2023): CREATE SCHEMA acme, SET search_path, and the schema lands on one worker — local joins with no shared key column, DROP SCHEMA offboards. Ceiling: low thousands of schemas.",
  },
  ru: {
    svgTitle: "Citus 12: схема на тенанта — создать схему acme, выставить search_path, Citus кладёт схему на один воркер",
    headline: "СХЕМА НА ТЕНАНТА ОТ CITUS",
    sub: "Citus 12 · июль 2023 · search_path рулит",
    lTitle: "ОНБОРДИНГ ACME",
    lRows: ["CREATE SCHEMA acme", "acme.orders, acme.users", "SET search_path TO acme"],
    rTitle: "CITUS КЛАДЁТ СХЕМУ",
    rRows: ["→ один воркер", "join внутри = локально", "DROP SCHEMA = уход"],
    barLine: "без общей key-колонки · потолок: тысячи",
    barSub: "CREATE for onboard · DROP CASCADE for offboard",
    caption:
      "Citus 12 (July 2023): CREATE SCHEMA acme, SET search_path — и схема лежит на одном воркере: локальные join без общей key-колонки, DROP SCHEMA отключает. Потолок: низкие тысячи схем.",
  },
};

const t = dict[lang];

const rowY = [152, 190, 228];
const rowH = 30;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbshard-schema-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="330" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="205" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lTitle}</text>
    {t.lRows.map((r, i) => (
      <g>
        <rect x="60" y={rowY[i]} width="290" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="205" y={rowY[i] + 21} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <line x1="378" y1="195" x2="422" y2="195" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbshard-schema-arrow)" />

    <rect x="430" y="100" width="330" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="595" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rTitle}</text>
    {t.rRows.map((r, i) => (
      <g>
        <rect x="450" y={rowY[i]} width="290" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="595" y={rowY[i] + 21} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <rect x="40" y="308" width="720" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="332" text-anchor="middle" font-size="12" fill="var(--ink)">{t.barLine}</text>
    <text x="400" y="354" text-anchor="middle" font-size="11" fill="var(--muted)">{t.barSub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
