---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Partitioning lives on one Postgres for pruning and instant DROP; sharding spreads writes over N instances for throughput",
    headline: "PRUNING HERE, THROUGHPUT THERE",
    sub: "partitioning = one machine · sharding = N machines",
    lTitle: "PARTITIONING · 1 PG",
    lRows: ["pruning: skip old parts", "DROP month = instant", "writes: same ceiling"],
    rTitle: "SHARDING · N PG",
    rRows: ["writes: ~N×", "past one machine", "joins: costly cross-shard"],
    barLine: "partitions since PG 10 · shards via Citus/app",
    caption:
      "Partitioning (PG 10+) prunes scans and drops months instantly on one machine; sharding (Citus or app routing) multiplies write throughput across N. Different problems, different tools.",
  },
  ru: {
    svgTitle: "Партиции живут на одном Postgres ради прунинга и мгновенного DROP; шарды разносят запись по N инстансам ради мощности",
    headline: "ПРУНИНГ ЗДЕСЬ, МОЩНОСТЬ ТАМ",
    sub: "партиции = одна машина · шарды = N машин",
    lTitle: "ПАРТИЦИИ · 1 PG",
    lRows: ["прунинг: пропуск частей", "DROP месяца = сразу", "запись: тот же потолок"],
    rTitle: "ШАРДЫ · N PG",
    rRows: ["запись: ~N×", "выше одной машины", "join: дорог меж шардами"],
    barLine: "партиции с PG 10 · шарды через Citus/app",
    caption:
      "Партиционирование (PG 10+) вырезает сканы и мгновенно дропает месяцы на одной машине; шардирование (Citus или роутинг в приложении) умножает запись на N. Разные задачи — разные инструменты.",
  },
};

const t = dict[lang];

const rowY = [158, 196, 234];
const rowH = 32;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="340" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="128" text-anchor="middle" font-size="13" fill="var(--ink)">{t.lTitle}</text>
    {t.lRows.map((r, i) => (
      <g>
        <rect x="60" y={rowY[i]} width="300" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="210" y={rowY[i] + 22} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <rect x="420" y="100" width="340" height="200" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="128" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rTitle}</text>
    {t.rRows.map((r, i) => (
      <g>
        <rect x="440" y={rowY[i]} width="300" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="590" y={rowY[i] + 22} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <rect x="60" y="318" width="680" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.barLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
