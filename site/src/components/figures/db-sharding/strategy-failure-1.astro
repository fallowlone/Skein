---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Sharding strategies: hash spreads by hash of key mod N, range owns key ranges, directory maps key to shard; each buys one failure",
    headline: "EVERY STRATEGY BUYS ONE FAILURE",
    sub: "match the strategy to the failure you can tolerate",
    names: ["HASH", "RANGE", "DIRECTORY"],
    mechs: ["hash(key) mod N", "key ranges per shard", "key → shard map"],
    wins: ["even on uniform keys", "time-series natural", "move = 1 row update"],
    risks: ["skew → hot shard", "hot tail on newest", "map is tier-1 infra"],
    footLine: "power-law tenants (100–1000× median) need isolation",
    footSub: "hash default · range for time · directory for outliers",
    caption:
      "Hash is the OLTP default but skews; range suits time-series but grows a hot tail; directory moves a tenant with one row update but makes the map tier-1. Pick the failure you can tolerate.",
  },
  ru: {
    svgTitle: "Стратегии шардирования: хеш по hash mod N, диапазоны ключей, карта ключ-шард; каждая покупает один отказ",
    headline: "КАЖДАЯ СТРАТЕГИЯ — ОДИН ОТКАЗ",
    sub: "выбирай отказ, который переживёшь",
    names: ["ХЕШ", "ДИАПАЗОН", "КАРТА"],
    mechs: ["hash(key) mod N", "диапазоны на шард", "key → shard map"],
    wins: ["ровно при ровных ключах", "ряды: удобно", "переезд = 1 строка"],
    risks: ["перекос → hot shard", "hot tail на новых", "карта — tier-1"],
    footLine: "тенанты 100–1000× от медианы требуют изоляции",
    footSub: "хеш по умолчанию · range для времени · карта для выбросов",
    caption:
      "Хеш — default для OLTP, но перекашивается; диапазон удобен для временных рядов, но растит hot tail; карта переносит тенанта одной строкой, но сама становится tier-1. Выбирай отказ, который переживёшь.",
  },
};

const t = dict[lang];

const colX = [40, 280, 520];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.names.map((nm, i) => (
      <g>
        <rect x={colX[i]} y="100" width="220" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={colX[i] + 110} y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{nm}</text>
        <rect x={colX[i] + 15} y="144" width="190" height="32" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={colX[i] + 110} y="166" text-anchor="middle" font-size="11" fill="var(--ink)">{t.mechs[i]}</text>
        <text x={colX[i] + 110} y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wins[i]}</text>
        <text x={colX[i] + 110} y="230" text-anchor="middle" font-size="11" fill="var(--accent)">{t.risks[i]}</text>
      </g>
    ))}

    <rect x="40" y="310" width="720" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="334" text-anchor="middle" font-size="12" fill="var(--ink)">{t.footLine}</text>
    <text x="400" y="356" text-anchor="middle" font-size="11" fill="var(--muted)">{t.footSub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
