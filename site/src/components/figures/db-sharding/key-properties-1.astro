---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four shard-key properties that must all hold: selective in 95 percent of queries, uniform, stable, available at routing time",
    headline: "FOUR PROPERTIES, ALL AT ONCE",
    sub: "miss one — keep looking for another key",
    titles: ["SELECTIVE", "UNIFORM", "STABLE", "ROUTABLE"],
    vals: ["95%+ queries", "even shards", "never changes", "in each request"],
    subs: ["else fan-out", "else hot shard", "else row move", "else full scan"],
    barLine: "tenant_id (B2B) · user_id (B2C) · region (geo)",
    barSub: "pass all four — or keep looking",
    caption:
      "A shard key must sit in 95%+ of queries, spread load evenly, never change, and arrive with every request. tenant_id, user_id, and region are the usual suspects — but each must pass all four.",
  },
  ru: {
    svgTitle: "Четыре свойства ключа шарда сразу: селективность в 95% запросов, равномерность, стабильность, наличие в запросе",
    headline: "ЧЕТЫРЕ СВОЙСТВА СРАЗУ",
    sub: "нет одного — ищи другой ключ",
    titles: ["СЕЛЕКТИВНЫЙ", "РАВНОМЕРНЫЙ", "СТАБИЛЬНЫЙ", "В ЗАПРОСЕ"],
    vals: ["95%+ запросов", "ровно по шардам", "не меняется", "в каждом запросе"],
    subs: ["иначе fan-out", "иначе hot shard", "иначе перенос", "иначе полный скан"],
    barLine: "tenant_id (B2B) · user_id (B2C) · region (geo)",
    barSub: "пройди все четыре — или ищи дальше",
    caption:
      "Ключ шарда обязан быть в 95%+ запросов, ровно распределять нагрузку, никогда не меняться и приходить с каждым запросом. tenant_id, user_id и region — обычные подозреваемые, но каждый обязан пройти все четыре.",
  },
};

const t = dict[lang];

const colX = [30, 220, 410, 600];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.titles.map((tt, i) => (
      <g>
        <rect x={colX[i]} y="110" width="170" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={colX[i] + 85} y="142" text-anchor="middle" font-size="12" fill="var(--ink)">{tt}</text>
        <text x={colX[i] + 85} y="202" text-anchor="middle" font-size="15" fill="var(--accent)">{t.vals[i]}</text>
        <text x={colX[i] + 85} y="230" text-anchor="middle" font-size="11" fill="var(--muted)">{t.subs[i]}</text>
      </g>
    ))}

    <rect x="60" y="302" width="680" height="58" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="327" text-anchor="middle" font-size="12" fill="var(--ink)">{t.barLine}</text>
    <text x="400" y="349" text-anchor="middle" font-size="11" fill="var(--muted)">{t.barSub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
