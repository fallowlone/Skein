---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four hot-shard signals: size skew over 1.5x, worker CPU over 70 percent for 5 minutes, tenant load over 5 percent, P99 over 3x median",
    headline: "FOUR SIGNALS BEFORE THE PAGE",
    sub: "skew and tenant load lead · CPU lags",
    sigN: ["shard size skew", "per-shard CPU", "per-tenant load", "customer P99"],
    sigT: ["max/median > 1.5×", "> 70% for 5 min", "> 5% of cluster", "> 3× median"],
    foot: "weekly trends pre-empt · CPU only reacts",
    caption:
      "Skew (max/median above 1.5×) and per-tenant load (above 5%) show weeks early; per-shard CPU (above 70% for 5 min) and P99 (above 3× median) arrive with the complaints. Trend the first two weekly.",
  },
  ru: {
    svgTitle: "Четыре сигнала hot shard: перекос размера свыше 1.5x, CPU свыше 70% 5 минут, тенант свыше 5%, P99 свыше 3x медианы",
    headline: "ЧЕТЫРЕ СИГНАЛА ДО АВАРИИ",
    sub: "перекос и тенант ведут · CPU отстаёт",
    sigN: ["перекос размера шарда", "CPU по шардам", "нагрузка тенанта", "P99 клиента"],
    sigT: ["max/median > 1.5×", "> 70% for 5 min", "> 5% of cluster", "> 3× median"],
    foot: "недельные тренды предупреждают · CPU лишь реагирует",
    caption:
      "Перекос (max/median выше 1.5×) и нагрузка тенанта (выше 5%) видны за недели; CPU шарда (выше 70% 5 минут) и P99 (выше 3× медианы) приходят вместе с жалобами. Первые два — в недельный тренд.",
  },
};

const t = dict[lang];

const sigY = [110, 168, 226, 284];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.sigN.map((sg, i) => (
      <g>
        <rect x="40" y={sigY[i]} width="720" height="50" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="62" y={sigY[i] + 32} font-size="12" fill="var(--ink)">{sg}</text>
        <text x="738" y={sigY[i] + 32} text-anchor="end" font-size="12" fill="var(--accent)">{t.sigT[i]}</text>
      </g>
    ))}

    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
