---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Tenant isolation: hot shard 102008 at 94 percent CPU with tenant 9821 holding 62 percent moves to a new shard with sub-second pause",
    headline: "ISOLATE THE OUTLIER TENANT",
    sub: "one tenant, one new shard — online",
    hTitle: "HOT SHARD · 94% CPU",
    hRows: ["shard 102008", "tenant 9821 · 62%", "rest idle near 18%"],
    rTitle: "AFTER ISOLATION",
    rRows: ["tenant 9821 → new shard", "old shard → median", "sub-second pause"],
    cmdLine: "isolate_tenant_to_new_shard('orders', 9821, 'CASCADE')",
    cmdSub: "copy 10–100 MB/s · sub-second cut-over",
    caption:
      "Tenant 9821 owns 62% of shard 102008 at 94% CPU: isolate_tenant_to_new_shard moves only that tenant online at 10–100 MB/s, pausing its writes under a second. The old shard falls back to median.",
  },
  ru: {
    svgTitle: "Изоляция тенанта: горячий шард 102008 при 94% CPU, тенант 9821 держит 62%, переезжает в новый шард с паузой меньше секунды",
    headline: "ИЗОЛИРУЙ ТЕНАНТА-ВЫБРОС",
    sub: "один тенант, один новый шард — онлайн",
    hTitle: "ГОРЯЧИЙ ШАРД · 94% CPU",
    hRows: ["шард 102008", "tenant 9821 · 62%", "остальные ~18% CPU"],
    rTitle: "ПОСЛЕ ИЗОЛЯЦИИ",
    rRows: ["tenant 9821 → новый шард", "старый шард → медиана", "пауза доли секунды"],
    cmdLine: "isolate_tenant_to_new_shard('orders', 9821, 'CASCADE')",
    cmdSub: "копия 10–100 MB/s · пауза доли секунды",
    caption:
      "Тенант 9821 владеет 62% шарда 102008 при 94% CPU: isolate_tenant_to_new_shard переносит только этого тенанта онлайн на 10–100 MB/s, ставя его запись на паузу меньше секунды. Старый шард падает к медиане.",
  },
};

const t = dict[lang];

const rowY = [162, 198, 234];
const rowH = 30;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbshard-isolate-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="300" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="190" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.hTitle}</text>
    {t.hRows.map((r, i) => (
      <g>
        <rect x="60" y={rowY[i]} width="260" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="190" y={rowY[i] + 21} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <line x1="348" y1="195" x2="452" y2="195" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbshard-isolate-arrow)" />

    <rect x="460" y="100" width="300" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="610" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rTitle}</text>
    {t.rRows.map((r, i) => (
      <g>
        <rect x="480" y={rowY[i]} width="260" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="610" y={rowY[i] + 21} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <rect x="40" y="308" width="720" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="332" text-anchor="middle" font-size="12" fill="var(--ink)">{t.cmdLine}</text>
    <text x="400" y="354" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cmdSub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
