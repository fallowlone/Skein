---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Citus topology: client talks to one coordinator holding map and plan; workers 0 to 2 hold shards 0-10, 11-21, 22-31",
    headline: "CITUS: ONE LOGICAL DATABASE",
    sub: "client sees one Postgres · data lives on workers",
    clientT: "client",
    coordT: "coordinator · map + plan",
    wNames: ["Worker 0", "Worker 1", "Worker 2"],
    wSubs: ["shards 0–10", "shards 11–21", "shards 22–31"],
    footLine: "32 shards · 3 workers · a new worker just takes shards",
    caption:
      "The client talks to one coordinator; 32 shards live on 3 workers. Adding a worker just re-takes whole shards — nothing is ever cut in half.",
  },
  ru: {
    svgTitle: "Топология Citus: клиент говорит с одним координатором; воркеры 0–2 держат шарды 0–10, 11–21, 22–31",
    headline: "CITUS: ОДНА ЛОГИЧЕСКАЯ БАЗА",
    sub: "клиент видит один Postgres · данные на воркерах",
    clientT: "клиент",
    coordT: "координатор · карта + план",
    wNames: ["Worker 0", "Worker 1", "Worker 2"],
    wSubs: ["shards 0–10", "shards 11–21", "shards 22–31"],
    footLine: "32 шарда · 3 воркера · новый просто забирает шарды",
    caption:
      "Клиент говорит с одним координатором; 32 шарда живут на 3 воркерах. Новый воркер просто забирает целые шарды — ничего никогда не режется пополам.",
  },
};

const t = dict[lang];

const wX = [40, 290, 540];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbshard-topo-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="300" y="96" width="200" height="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="122" text-anchor="middle" font-size="12" fill="var(--ink)">{t.clientT}</text>

    <line x1="400" y1="136" x2="400" y2="156" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbshard-topo-arrow)" />

    <rect x="250" y="162" width="300" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.coordT}</text>

    <line x1="350" y1="206" x2="152" y2="244" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbshard-topo-arrow)" />
    <line x1="400" y1="206" x2="400" y2="244" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbshard-topo-arrow)" />
    <line x1="450" y1="206" x2="648" y2="244" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbshard-topo-arrow)" />

    {t.wNames.map((ww, i) => (
      <g>
        <rect x={wX[i]} y="250" width="220" height="90" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={wX[i] + 110} y="282" text-anchor="middle" font-size="12" fill="var(--ink)">{ww}</text>
        <text x={wX[i] + 110} y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.wSubs[i]}</text>
      </g>
    ))}

    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.footLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
