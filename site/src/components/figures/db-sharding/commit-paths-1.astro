---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Single-shard writes commit in one round-trip; cross-shard writes prepare then commit in two trips and risk stuck prepared transactions",
    headline: "ONE SHARD COMMITS · TWO NEGOTIATE",
    sub: "co-location decides which path you pay",
    lTitle: "SINGLE SHARD · COMMIT",
    lRows: ["BEGIN → COMMIT", "1 round-trip", "no in-doubt risk"],
    rTitle: "CROSS-SHARD · 2PC",
    rRows: ["PREPARE → COMMIT", "2 round-trips", "locks held till commit"],
    barLine: "stuck? pg_prepared_xacts older than 5 min → alert",
    barSub: "prefer outbox/saga over 2PC",
    caption:
      "Co-located writes commit in one round-trip; cross-shard writes prepare then commit (2 trips) and can strand locks in pg_prepared_xacts. Alert past 5 minutes — or avoid 2PC with outbox/saga.",
  },
  ru: {
    svgTitle: "Запись в один шард коммитится за один раунд; кросс-шард сначала prepare, потом commit — два раунда и риск зависших транзакций",
    headline: "ОДИН ШАРД КОММИТИТ · ДВА ТОРГУЮТСЯ",
    sub: "colocation решает, какой путь оплатишь",
    lTitle: "ОДИН ШАРД · COMMIT",
    lRows: ["BEGIN → COMMIT", "1 round-trip", "без риска in-doubt"],
    rTitle: "МЕЖ ШАРДАМИ · 2PC",
    rRows: ["PREPARE → COMMIT", "2 round-trips", "локи висят до коммита"],
    barLine: "stuck? pg_prepared_xacts older than 5 min → alert",
    barSub: "лучше outbox/saga, чем 2PC",
    caption:
      "Colocate-запись коммитится за один раунд; кросс-шард сначала prepare, потом commit (2 раунда) и может повесить локи в pg_prepared_xacts. Алерт старше 5 минут — или избегай 2PC через outbox/saga.",
  },
};

const t = dict[lang];

const rowY = [150, 188, 226];
const rowH = 32;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="340" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lTitle}</text>
    {t.lRows.map((r, i) => (
      <g>
        <rect x="60" y={rowY[i]} width="300" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="210" y={rowY[i] + 22} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <rect x="420" y="100" width="340" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rTitle}</text>
    {t.rRows.map((r, i) => (
      <g>
        <rect x="440" y={rowY[i]} width="300" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="590" y={rowY[i] + 22} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}

    <rect x="40" y="308" width="720" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="332" text-anchor="middle" font-size="12" fill="var(--ink)">{t.barLine}</text>
    <text x="400" y="354" text-anchor="middle" font-size="11" fill="var(--muted)">{t.barSub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
