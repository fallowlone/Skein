---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Compose both: shard 0 holds tenants 1 to 500 and shard 1 holds 501 to 1000, each with events 2026-01 and 2026-02 month partitions",
    headline: "SHARD BY TENANT, PARTITION BY TIME",
    sub: "route by tenant_id · prune by created_at",
    s0t: "SHARD 0 · tenant 1–500",
    s1t: "SHARD 1 · tenant 501–1000",
    parts: ["events_2026_01", "events_2026_02"],
    qLine: "tenant_id = 42 AND created_at >= 2026-02-01 → 1 shard, 1 part",
    caption:
      "Shard by tenant_id across instances, partition by created_at inside each: tenant_id = 42 routes to one shard, the month filter prunes to one partition. Both wins, one query.",
  },
  ru: {
    svgTitle: "Композиция: шард 0 держит тенантов 1–500, шард 1 — 501–1000, в каждом месячные партиции events 2026-01 и 2026-02",
    headline: "ШАРД ПО ТЕНАНТУ, ЧАСТЬ ПО ВРЕМЕНИ",
    sub: "маршрут по tenant_id · прунинг по created_at",
    s0t: "ШАРД 0 · tenant 1–500",
    s1t: "ШАРД 1 · tenant 501–1000",
    parts: ["events_2026_01", "events_2026_02"],
    qLine: "tenant_id = 42 AND created_at >= 2026-02-01 → 1 shard, 1 part",
    caption:
      "Шардируй по tenant_id между инстансами, партиционируй по created_at внутри каждого: tenant_id = 42 ведёт в один шард, фильтр по месяцу вырезает одну партицию. Обе победы — один запрос.",
  },
};

const t = dict[lang];

const partX = [150, 430];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="110" width="720" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="138" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s0t}</text>
    {t.parts.map((pp, i) => (
      <g>
        <rect x={partX[i]} y="152" width="220" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={partX[i] + 110} y="180" text-anchor="middle" font-size="12" fill="var(--ink)">{pp}</text>
      </g>
    ))}

    <rect x="40" y="232" width="720" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="260" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s1t}</text>
    {t.parts.map((pp, i) => (
      <g>
        <rect x={partX[i]} y="274" width="220" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={partX[i] + 110} y="302" text-anchor="middle" font-size="12" fill="var(--ink)">{pp}</text>
      </g>
    ))}

    <rect x="40" y="356" width="720" height="48" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="386" text-anchor="middle" font-size="11" fill="var(--ink)">{t.qLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
