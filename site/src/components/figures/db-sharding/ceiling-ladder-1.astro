---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Single-Postgres ceiling: cache-hit 95 to 99 percent, 10 to 50k TPS of WAL-bound writes, 1 to 10 TB in RAM, then the last-resort ladder",
    headline: "THE SINGLE-POSTGRES CEILING",
    sub: "three hard limits — then the last-resort ladder",
    p1t: "RAM · WORKING SET",
    p1v: "hit-rate 95–99%",
    p1s: "below → disk",
    p2t: "WRITES · PRIMARY",
    p2v: "10–50k TPS",
    p2s: "WAL owns the CPU",
    p3t: "STORAGE · 1–10 TB",
    p3v: "RAM-sized cap",
    p3s: "biggest machines",
    ladLine: "indexes → cache → replicas → scale up → shard (last)",
    ladSub: "sharding is the last resort",
    caption:
      "One Postgres hits three ceilings — cache-hit below 95–99%, about 10–50k TPS of WAL-bound writes, about 1–10 TB in RAM. Climb indexes, cache, replicas, and scale-up first; sharding is the last rung.",
  },
  ru: {
    svgTitle: "Потолок одного Postgres: hit-rate 95–99%, 10–50k TPS записи, 1–10 ТБ в RAM — затем лестница последнего средства",
    headline: "ПОТОЛОК ОДНОГО POSTGRES",
    sub: "три жёстких предела — затем лестница последнего средства",
    p1t: "RAM · РАБОЧИЙ НАБОР",
    p1v: "hit-rate 95–99%",
    p1s: "ниже → диск",
    p2t: "ЗАПИСЬ · PRIMARY",
    p2v: "10–50k TPS",
    p2s: "WAL владеет CPU",
    p3t: "ХРАНЕНИЕ · 1–10 TB",
    p3v: "потолок в RAM",
    p3s: "топ-инстансы",
    ladLine: "индексы → кеш → реплики → масштаб → шардинг",
    ladSub: "шардирование — последнее средство",
    caption:
      "Один Postgres упирается в три потолка — hit-rate ниже 95–99%, около 10–50k TPS записи, около 1–10 ТБ в RAM. Сначала индексы, кеш, реплики и масштаб вверх; шардирование — последняя ступень.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="220" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="150" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.p1t}</text>
    <text x="150" y="202" text-anchor="middle" font-size="15" fill="var(--accent)">{t.p1v}</text>
    <text x="150" y="232" text-anchor="middle" font-size="11" fill="var(--muted)">{t.p1s}</text>

    <rect x="290" y="100" width="220" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.p2t}</text>
    <text x="400" y="202" text-anchor="middle" font-size="15" fill="var(--accent)">{t.p2v}</text>
    <text x="400" y="232" text-anchor="middle" font-size="11" fill="var(--muted)">{t.p2s}</text>

    <rect x="540" y="100" width="220" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="650" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.p3t}</text>
    <text x="650" y="202" text-anchor="middle" font-size="15" fill="var(--accent)">{t.p3v}</text>
    <text x="650" y="232" text-anchor="middle" font-size="11" fill="var(--muted)">{t.p3s}</text>

    <rect x="40" y="292" width="720" height="64" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="318" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ladLine}</text>
    <text x="400" y="340" text-anchor="middle" font-size="11" fill="var(--muted)">{t.ladSub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
