---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three Citus table types: distributed on workers by key, reference copied to every worker, local on coordinator only",
    headline: "THREE TABLE TYPES, THREE HOMES",
    sub: "wrong category = silent fan-out",
    names: ["DISTRIBUTED", "REFERENCE", "LOCAL"],
    lives: ["workers · by key", "copy on every worker", "coordinator only"],
    uses: ["orders, users, …", "plans, feature_flags", "tenants, meta"],
    joins: ["local if co-located", "always local read", "no join to workers"],
    footLine: "reference writes go 2PC to all copies",
    caption:
      "Distributed tables ride the shard key, reference tables copy small lookups everywhere, local tables stay on the coordinator. Miscategorize one table and its joins silently fan out.",
  },
  ru: {
    svgTitle: "Три типа таблиц Citus: распределённые по ключу, справочники копией везде, локальные только на координаторе",
    headline: "ТРИ ТИПА ТАБЛИЦ, ТРИ ДОМА",
    sub: "не та категория = тихий fan-out",
    names: ["РАСПРЕДЕЛЁННЫЕ", "СПРАВОЧНИКИ", "ЛОКАЛЬНЫЕ"],
    lives: ["воркеры · по ключу", "копия на каждом воркере", "только координатор"],
    uses: ["orders, users, …", "plans, feature_flags", "tenants, meta"],
    joins: ["локально при colocate", "чтение всегда локально", "нет join к воркерам"],
    footLine: "запись reference — 2PC по всем копиям",
    caption:
      "Распределённые таблицы едут на ключе шарда, справочники лежат копией везде, локальные живут на координаторе. Ошибись категорией одной таблицы — и её join тихо расползутся по всем шардам.",
  },
};

const t = dict[lang];

const colX = [40, 280, 520];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.names.map((nm, i) => (
      <g>
        <rect x={colX[i]} y="100" width="220" height="210" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={colX[i] + 110} y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{nm}</text>
        <text x={colX[i] + 110} y="158" text-anchor="middle" font-size="11" fill="var(--muted)">{t.lives[i]}</text>
        <rect x={colX[i] + 15} y="174" width="190" height="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x={colX[i] + 110} y="197" text-anchor="middle" font-size="11" fill="var(--ink)">{t.uses[i]}</text>
        <text x={colX[i] + 110} y="246" text-anchor="middle" font-size="11" fill="var(--accent)">{t.joins[i]}</text>
      </g>
    ))}

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.footLine}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
