---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Nested loop O(n squared) collapses to a single O(n) pass; sorted input required",
    headline: "ONE RULE REPLACES THE INNER LOOP",
    sub: "a move rule on two pointers visits each cell once",
    leftTitle: "nested loop",
    leftLine1: "for each i, check all j > i",
    leftCost: "O(n²)",
    rightTitle: "two pointers",
    rightLine1: "each position visited once",
    rightCost: "O(n)",
    warn: "⚠ opposite-ends two-sum is only sound on sorted input",
    warnSub: "unsorted → the move rule misses pairs · sort first, or reach for hashing",
    caption:
      "Takeaway: a move rule on two converging pointers visits each cell once — O(n) — because no pair is ever revisited. But opposite-ends two-sum is only sound on sorted input: without sorting the rule misses pairs, so sort first or reach for hashing.",
  },
  ru: {
    svgTitle: "Вложенный цикл O(n²) сворачивается в один проход O(n); нужен отсортированный вход",
    headline: "ПРАВИЛО ЗАМЕНЯЕТ ВНУТРЕННИЙ ЦИКЛ",
    sub: "правило движения двух указателей посещает каждую ячейку раз",
    leftTitle: "вложенный цикл",
    leftLine1: "для каждого i проверь все j > i",
    leftCost: "O(n²)",
    rightTitle: "два указателя",
    rightLine1: "каждую позицию посещают раз",
    rightCost: "O(n)",
    warn: "⚠ two-sum с концов корректен только на отсортированном входе",
    warnSub: "без сортировки правило пропускает пары · сначала сортируй или бери хеширование",
    caption:
      "Вывод: правило движения двух сходящихся указателей посещает каждую ячейку раз — O(n), — потому что ни одна пара не повторяется. Но two-sum с концов корректен только на отсортированном входе: без сортировки правило пропускает пары, поэтому сначала сортируй или бери хеширование.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="90" y="100" width="270" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="225" y="132" text-anchor="middle" font-size="15" fill="var(--ink)">{t.leftTitle}</text>
    <text x="225" y="162" text-anchor="middle" font-size="12.5" fill="var(--muted)">{t.leftLine1}</text>
    <text x="225" y="228" text-anchor="middle" font-size="44" fill="var(--muted)">{t.leftCost}</text>

    <line x1="380" y1="185" x2="418" y2="185" stroke="var(--ink)" stroke-width="2" />
    <polygon points="418,177 434,185 418,193" fill="var(--ink)" />

    <rect x="454" y="100" width="270" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="3" />
    <text x="589" y="132" text-anchor="middle" font-size="15" fill="var(--ink)">{t.rightTitle}</text>
    <text x="589" y="162" text-anchor="middle" font-size="12.5" fill="var(--muted)">{t.rightLine1}</text>
    <text x="589" y="228" text-anchor="middle" font-size="44" fill="var(--ink)">{t.rightCost}</text>

    <rect x="60" y="300" width="680" height="88" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="8 5" />
    <text x="400" y="332" text-anchor="middle" font-size="14" fill="var(--ink)">{t.warn}</text>
    <text x="400" y="360" text-anchor="middle" font-size="12.5" fill="var(--muted)">{t.warnSub}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
