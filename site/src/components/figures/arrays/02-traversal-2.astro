---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The five traversal shapes, each doing one full pass",
    headline: "THE FIVE SHAPES — ONE PASS EACH",
    sub: "accumulate · find · transform · test · early exit",
    rows: [
      { name: "1 · accumulate", detail: "sum, product, count", badge: "1 pass" },
      { name: "2 · find", detail: "first match, max, min", badge: "1 pass" },
      { name: "3 · transform", detail: "build a new array", badge: "1 pass" },
      { name: "4 · test", detail: "any / every? → true/false", badge: "1 pass" },
      { name: "5 · early exit", detail: "stop when known — rides inside any", badge: "cuts best case" },
    ],
    note: "patterns 1–4 each do one full pass · pattern 5 sits inside any of them",
    caption:
      "The five traversal shapes: accumulate, find, transform, and test each do one full pass over the array, and early exit rides inside any of them — stopping the scan as soon as the answer is known. Together they cover almost every array problem.",
  },
  ru: {
    svgTitle: "Пять приёмов обхода, у каждого один полный проход",
    headline: "ПЯТЬ ФОРМ — У КАЖДОЙ ОДИН ПРОХОД",
    sub: "накопление · поиск · преобразование · проверка · ранний выход",
    rows: [
      { name: "1 · накопление", detail: "сумма, произведение, счёт", badge: "1 проход" },
      { name: "2 · поиск", detail: "первое совпадение, макс., мин.", badge: "1 проход" },
      { name: "3 · преобразование", detail: "строй новый массив", badge: "1 проход" },
      { name: "4 · проверка", detail: "есть ли / все ли? → true/false", badge: "1 проход" },
      { name: "5 · ранний выход", detail: "стоп, когда известно", badge: "режет лучший случай" },
    ],
    note: "приёмы 1–4 — по одному полному проходу · приём 5 встраивается в любой",
    caption:
      "Пять приёмов обхода: накопление, поиск, преобразование и проверка делают по одному полному проходу по массиву, а ранний выход живёт внутри любого из них — останавливая скан, как только ответ известен. Вместе они закрывают почти любую задачу с массивами.",
  },
};

const t = dict[lang];

const rowX = 40;
const rowW = 720;
const rowH = 44;
const rowGap = 8;
const rowY = (k: number) => 100 + k * (rowH + rowGap);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.rows.map((r, k) => (
      <g>
        <rect x={rowX} y={rowY(k)} width={rowW} height={rowH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={rowX + 16} y={rowY(k) + 28} font-size="14" fill="var(--ink)">{r.name}</text>
        <text x={rowX + 300} y={rowY(k) + 28} font-size="12" fill="var(--muted)">{r.detail}</text>
        <text x={rowX + rowW - 16} y={rowY(k) + 28} text-anchor="end" font-size="12" fill="var(--accent)">{r.badge}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
