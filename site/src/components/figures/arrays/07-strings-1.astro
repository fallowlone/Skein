---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "String racecar as seven indexed read-only cells with O(1) access",
    headline: "A STRING IS AN ARRAY OF CHARACTERS",
    sub: "contiguous · zero-based · read-only",
    indices: "index",
    write: "s[1] = overwrites nothing — immutable ✗",
    read: "s[5] reads in O(1) ✓",
    len: "s.length = 7",
    left: "left = 0",
    right: "right = 6",
    note: "s[0] is the first character · traversal works like an array",
    caption:
      "A string is contiguous read-only cells: s[0] is 'r', s.length is 7, any index reads in O(1). Because the cells are immutable, s[1] cannot be overwritten — and that read-only rule is what makes every += rebuild the whole string.",
  },
  ru: {
    svgTitle: "Строка racecar как семь пронумерованных ячеек только для чтения с доступом O(1)",
    headline: "СТРОКА — ЭТО МАССИВ СИМВОЛОВ",
    sub: "подряд · индексы с нуля · только чтение",
    indices: "индекс",
    write: "s[1] = ничего не перезапишет — неизменяема ✗",
    read: "s[5] читается за O(1) ✓",
    len: "s.length = 7",
    left: "left = 0",
    right: "right = 6",
    note: "s[0] — первый символ · обход как в массиве",
    caption:
      "Строка — подряд идущие ячейки только для чтения: s[0] это 'r', s.length равно 7, любой индекс читается за O(1). Ячейки неизменяемы, поэтому s[1] не перезаписать — и это правило чтения делает каждый += перестройкой всей строки.",
  },
};

const t = dict[lang];

const cells = ["r", "a", "c", "e", "c", "a", "r"];
const cellW = 76;
const cellH = 76;
const startX = 134;
const cellY = 150;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="96" y="120" text-anchor="middle" font-size="13" fill="var(--muted)">{t.indices}</text>
    {cells.map((_, i) => (
      <text x={startX + i * cellW + cellW / 2} y="120" text-anchor="middle" font-size="13" fill="var(--muted)">{i}</text>
    ))}

    {cells.map((c, i) => (
      <g>
        <rect x={startX + i * cellW + 4} y={cellY} width={cellW - 8} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={startX + i * cellW + cellW / 2} y={cellY + 49} text-anchor="middle" font-size="28" fill="var(--ink)">{c}</text>
      </g>
    ))}

    <rect x={startX + 1 * cellW + 4} y={cellY} width={cellW - 8} height={cellH} fill="none" stroke="var(--accent)" stroke-width="3" stroke-dasharray="7 5" />
    <rect x={startX + 5 * cellW + 4} y={cellY} width={cellW - 8} height={cellH} fill="none" stroke="var(--accent)" stroke-width="3" />

    <text x={startX + 0 * cellW + cellW / 2} y={cellY + cellH + 30} text-anchor="middle" font-size="13" fill="var(--accent)">{t.left}</text>
    <text x={startX + 6 * cellW + cellW / 2} y={cellY + cellH + 30} text-anchor="middle" font-size="13" fill="var(--accent)">{t.right}</text>

    <text x="400" y="300" text-anchor="middle" font-size="14" fill="var(--ink)">{t.write}</text>
    <text x="400" y="328" text-anchor="middle" font-size="14" fill="var(--ink)">{t.read}</text>
    <text x="400" y="356" text-anchor="middle" font-size="14" fill="var(--ink)">{t.len}</text>

    <text x="400" y="394" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
