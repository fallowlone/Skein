---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Opposite-ends two-sum trace on sorted array 1, 3, 5, 7, 9 with target 12",
    headline: "THE SUM DECIDES WHO MOVES",
    sub: "sorted · target 12 · array [1, 3, 5, 7, 9]",
    left: "left",
    right: "right",
    step1: "step 1 · left = 0, right = 4",
    eq1: "1 + 9 = 10 < 12 → left++",
    step2: "step 2 · left = 1, right = 4",
    eq2: "3 + 9 = 12 = target ✓ · pair (1, 4)",
    note: "the gap only shrinks — each cell visited once · O(n)",
    caption:
      "Opposite-ends rule on [1, 3, 5, 7, 9] with target 12: too small moves left++, too big would move right−−, equal ends the hunt. The pair locks at indices (1, 4) in a single pass — the move rule does the work of the inner loop.",
  },
  ru: {
    svgTitle: "Трассировка two-sum с концов на массиве 1, 3, 5, 7, 9 с целью 12",
    headline: "СУММА РЕШАЕТ, КТО ДВИЖЕТСЯ",
    sub: "отсортирован · цель 12 · массив [1, 3, 5, 7, 9]",
    left: "left",
    right: "right",
    step1: "шаг 1 · left = 0, right = 4",
    eq1: "1 + 9 = 10 < 12 → left++",
    step2: "шаг 2 · left = 1, right = 4",
    eq2: "3 + 9 = 12 = цель ✓ · пара (1, 4)",
    note: "зазор только сужается — каждая ячейка раз · O(n)",
    caption:
      "Правило концов на [1, 3, 5, 7, 9] с целью 12: мало — идёт left++, много — шёл бы right−−, равно — охота окончена. Пара фиксируется на индексах (1, 4) за один проход — правило движения делает работу внутреннего цикла.",
  },
};

const t = dict[lang];

const cells = ["1", "3", "5", "7", "9"];
const cellW = 80;
const gap = 8;
const totalW = cells.length * cellW + (cells.length - 1) * gap;
const startX = (800 - totalW) / 2;
const cellH = 48;

function cellX(i: number) {
  return startX + i * (cellW + gap);
}
function cellCX(i: number) {
  return cellX(i) + cellW / 2;
}

const row1Y = 114;
const row2Y = 252;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="98" text-anchor="middle" font-size="13" fill="var(--muted)">{t.step1}</text>
    {cells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={row1Y} width={cellW} height={cellH} fill="var(--card)" stroke={i === 0 || i === 4 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 0 || i === 4 ? 3 : 2} />
        <text x={cellCX(i)} y={row1Y + 32} text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x={cellCX(0)} y={row1Y + 72} text-anchor="middle" font-size="13" fill="var(--ink)">↑ {t.left}</text>
    <text x={cellCX(4)} y={row1Y + 72} text-anchor="middle" font-size="13" fill="var(--ink)">↑ {t.right}</text>
    <text x="400" y={row1Y + 104} text-anchor="middle" font-size="15" fill="var(--ink)">{t.eq1}</text>

    <text x="400" y={row2Y - 14} text-anchor="middle" font-size="13" fill="var(--muted)">{t.step2}</text>
    {cells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={row2Y} width={cellW} height={cellH} fill="var(--card)" stroke={i === 1 || i === 4 ? "var(--accent)" : "var(--ink)"} stroke-width={i === 1 || i === 4 ? 3 : 2} />
        <text x={cellCX(i)} y={row2Y + 32} text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x={cellCX(1)} y={row2Y + 72} text-anchor="middle" font-size="13" fill="var(--ink)">↑ {t.left}</text>
    <text x={cellCX(4)} y={row2Y + 72} text-anchor="middle" font-size="13" fill="var(--ink)">↑ {t.right}</text>
    <text x="400" y={row2Y + 104} text-anchor="middle" font-size="15" fill="var(--ink)">{t.eq2}</text>

    <text x="400" y="398" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
