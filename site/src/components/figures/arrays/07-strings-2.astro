---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Copy triangle: each += iteration copies everything accumulated so far, work 1 through 5",
    headline: "EVERY += RECOPYIES THE PAST",
    sub: "iteration i copies i−1 chars · work = i",
    iter: "iter",
    copy: "copy",
    total: "total 1+2+3+4+5 = 15 copies → O(n²)",
    scale: "10,000 appends ≈ 50 million copies",
    note: "each += builds a whole new string",
    caption:
      "The trap: because strings are immutable, each += allocates a new string and copies everything so far — iteration 3 copies 2 chars for work 3, and five iterations already cost 1+2+3+4+5 = 15 copies, the triangle that grows into O(n²).",
  },
  ru: {
    svgTitle: "Треугольник копий: каждая итерация += копирует всё накопленное, работа от 1 до 5",
    headline: "КАЖДЫЙ += ПЕРЕКОПИРУЕТ ПРОШЛОЕ",
    sub: "итерация i копирует i−1 символов · работа = i",
    iter: "итер",
    copy: "копия",
    total: "итого 1+2+3+4+5 = 15 копий → O(n²)",
    scale: "10 000 добавлений ≈ 50 млн копий",
    note: "каждый += строит целую новую строку",
    caption:
      "Ловушка: строки неизменяемы, поэтому каждый += выделяет новую строку и копирует всё прошлое — итерация 3 копирует 2 символа при работе 3, а пять итераций уже стоят 1+2+3+4+5 = 15 копий: треугольник, что вырастает в O(n²).",
  },
};

const t = dict[lang];

const bars = [1, 2, 3, 4, 5];
const barW = 70;
const gap = 30;
const baseY = 290;
const unitH = 30;
const startX = 165;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {bars.map((w, i) => (
      <g>
        <text x={startX + i * (barW + gap) + barW / 2} y={baseY - w * unitH - 10} text-anchor="middle" font-size="14" fill="var(--ink)">{w}</text>
        <rect
          x={startX + i * (barW + gap)}
          y={baseY - w * unitH}
          width={barW}
          height={w * unitH}
          fill="var(--card)"
          stroke="var(--ink)"
          stroke-width="2"
        />
        <text x={startX + i * (barW + gap) + barW / 2} y={baseY + 24} text-anchor="middle" font-size="13" fill="var(--ink)">{t.iter} {w}</text>
        <text x={startX + i * (barW + gap) + barW / 2} y={baseY + 44} text-anchor="middle" font-size="12" fill="var(--muted)">{t.copy} {w - 1}</text>
      </g>
    ))}
    <line x1="130" y1={baseY} x2="670" y2={baseY} stroke="var(--ink)" stroke-width="2" />

    <text x="400" y="366" text-anchor="middle" font-size="14" fill="var(--accent)">{t.total}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.scale} · {t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
