---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Tradeoff: naive O(n times q) versus prefix sums O(n plus q)",
    headline: "PAY ONCE, QUERY FOREVER",
    sub: "O(n×q) → O(n+q) · static data only",
    leftTitle: "naive: traverse each query",
    rightTitle: "prefix sums: precompute once",
    setup: "setup",
    perQuery: "per query",
    total: "total",
    example: "q = 1000, n = 100: 100,000 operations → 1,100 operations · nearly 100× faster",
    note: "many queries on a static array",
    caption:
      "The trade: O(n) time plus O(n) space once turns q queries from O(n×q) into O(n+q) — at q = 1000, n = 100 that is 1,100 operations instead of 100,000. Static data only: changing the array forces an O(n) rebuild.",
  },
  ru: {
    svgTitle: "Обмен: наивный O(n умножить на q) против префиксных сумм O(n плюс q)",
    headline: "ЗАПЛАТИ РАЗ, ЗАПРАШИВАЙ ВЕЧНО",
    sub: "O(n×q) → O(n+q) · только статика",
    leftTitle: "наивный: проход каждого запроса",
    rightTitle: "префиксные суммы: предвычисли раз",
    setup: "подготовка",
    perQuery: "за запрос",
    total: "итого",
    example: "q = 1000, n = 100: 100 000 операций → 1 100 операций · почти 100× быстрее",
    note: "много запросов на статический массив",
    caption:
      "Обмен: O(n) времени плюс O(n) памяти раз превращают q запросов из O(n×q) в O(n+q) — при q = 1000, n = 100 это 1 100 операций вместо 100 000. Только статика: изменение массива требует пересборки за O(n).",
  },
};

const t = dict[lang];

const leftRows = [
  `${t.setup}: O(1)`,
  `${t.perQuery}: O(n)`,
  `${t.total}: O(n × q)`,
];
const rightRows = [
  `${t.setup}: O(n)`,
  `${t.perQuery}: O(1)`,
  `${t.total}: O(n + q)`,
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="ps3-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="96" width="310" height="180" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="215" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTitle}</text>
    {leftRows.map((row, i) => (
      <text x="215" y={160 + i * 32} text-anchor="middle" font-size="14" fill={i === 2 ? "var(--ink)" : "var(--muted)"}>{row}</text>
    ))}

    <line x1="378" y1="186" x2="414" y2="186" stroke="var(--accent)" stroke-width="2" marker-end="url(#ps3-arrow)" />

    <rect x="430" y="96" width="310" height="180" rx="8" fill="var(--card)" stroke="var(--accent)" stroke-width="3" />
    <text x="585" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTitle}</text>
    {rightRows.map((row, i) => (
      <text x="585" y={160 + i * 32} text-anchor="middle" font-size="14" fill={i === 2 ? "var(--ink)" : "var(--muted)"}>{row}</text>
    ))}

    <text x="400" y="322" text-anchor="middle" font-size="13" fill="var(--ink)">{t.example}</text>
    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
