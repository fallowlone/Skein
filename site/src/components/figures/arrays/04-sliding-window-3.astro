---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Why O(n): left and right pointers move forward at most n times each, O(1) update per step",
    headline: "ONLY FORWARD: left AND right MOVE ≤ n TIMES",
    sub: "naive O(n²) recompute → sliding O(n)",
    leftLane: "left",
    rightLane: "right",
    laneNote: "≤ n moves",
    neverBack: "never backward",
    total: "each element added + removed at most once · 2n moves · O(1) per step",
    bottom: "O(n) + O(n) = O(n)",
    caption:
      "Why O(n): left and right never move backward, at most n moves each — 2n moves total with an O(1) update per step. The window carries its sum and updates it per slide, so the whole pass is O(n) instead of O(n²) recompute.",
  },
  ru: {
    svgTitle: "Почему O(n): указатели left и right идут только вперёд максимум n раз каждый, обновление O(1) за шаг",
    headline: "ТОЛЬКО ВПЕРЁД: left И right — ДО n ДВИЖЕНИЙ",
    sub: "наивный O(n²) пересчёт → скольжение O(n)",
    leftLane: "left",
    rightLane: "right",
    laneNote: "≤ n движений",
    neverBack: "назад — никогда",
    total: "каждый элемент добавлен + убран максимум раз · 2n движений · O(1) за шаг",
    bottom: "O(n) + O(n) = O(n)",
    caption:
      "Почему O(n): left и right никогда не идут назад, максимум n движений каждый — итого 2n движений с обновлением за O(1) за шаг. Окно несёт свою сумму и обновляет её на сдвиге, так что весь проход — O(n) вместо O(n²) пересчёта.",
  },
};

const t = dict[lang];

const dotX = (i: number) => 200 + i * 76;
const leftY = 148;
const rightY = 238;
const dots = [0, 1, 2, 3, 4, 5];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="23" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <!-- left lane -->
    <text x="120" y={leftY + 5} text-anchor="middle" font-size="14" fill="var(--ink)">{t.leftLane}</text>
    {dots.map((i) => (
      <g>
        {i < 5 && (
          <line
            x1={dotX(i) + 16}
            y1={leftY}
            x2={dotX(i + 1) - 16}
            y2={leftY}
            stroke="var(--ink)"
            stroke-width="2"
          />
        )}
        <circle cx={dotX(i)} cy={leftY} r="14" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={dotX(i)} y={leftY + 5} text-anchor="middle" font-size="12" fill="var(--ink)">{i}</text>
      </g>
    ))}
    <text x={dotX(5) + 16} y={leftY - 18} font-size="12" fill="var(--muted)">→</text>
    <text x="688" y={leftY + 5} text-anchor="middle" font-size="12" fill="var(--muted)">{t.laneNote}</text>

    <!-- right lane -->
    <text x="120" y={rightY + 5} text-anchor="middle" font-size="14" fill="var(--ink)">{t.rightLane}</text>
    {dots.map((i) => (
      <g>
        {i < 5 && (
          <line
            x1={dotX(i) + 16}
            y1={rightY}
            x2={dotX(i + 1) - 16}
            y2={rightY}
            stroke="var(--ink)"
            stroke-width="2"
          />
        )}
        <circle cx={dotX(i)} cy={rightY} r="14" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={dotX(i)} y={rightY + 5} text-anchor="middle" font-size="12" fill="var(--ink)">{i}</text>
      </g>
    ))}
    <text x={dotX(5) + 16} y={rightY - 18} font-size="12" fill="var(--muted)">→</text>
    <text x="688" y={rightY + 5} text-anchor="middle" font-size="12" fill="var(--muted)">{t.laneNote}</text>

    <!-- never backward: crossed-out back arrow -->
    <g>
      <line x1="330" y1="300" x2="390" y2="300" stroke="var(--muted)" stroke-width="2" />
      <text x="318" y="305" text-anchor="middle" font-size="14" fill="var(--muted)">←</text>
      <line x1="318" y1="286" x2="398" y2="314" stroke="var(--muted)" stroke-width="2" />
      <text x="410" y="305" font-size="13" fill="var(--muted)">{t.neverBack}</text>
    </g>

    <text x="400" y="348" text-anchor="middle" font-size="13" fill="var(--muted)">{t.total}</text>
    <text x="400" y="388" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--ink)">{t.bottom}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
