---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Inserting 25 at index 2 into 10, 20, 30, 40 shifts 30 and 40 one slot right",
    headline: "MIDDLE INSERT SHIFTS THE TAIL · O(n)",
    sub: "insert 25 at index 2 in [10, 20, 30, 40]",
    before: "before",
    after: "after",
    newVal: "25",
    shift: "shift →",
    note: "shifted 2 elements · O(n)",
    caption:
      "The price: inserting 25 at index 2 shifts every later cell (30, 40) one slot right — 2 elements moved. The tail behind the insert point is O(n) work.",
  },
  ru: {
    svgTitle: "Вставка 25 на индекс 2 в 10, 20, 30, 40 сдвигает 30 и 40 на слот вправо",
    headline: "ВСТАВКА В СЕРЕДИНУ СДВИГАЕТ ХВОСТ · O(n)",
    sub: "вставляем 25 на индекс 2 в [10, 20, 30, 40]",
    before: "до",
    after: "после",
    newVal: "25",
    shift: "сдвиг →",
    note: "сдвинуто 2 элемента · O(n)",
    caption:
      "Цена: вставка 25 на индекс 2 сдвигает каждую позднюю ячейку (30, 40) на слот вправо — сдвинуто 2 элемента. Хвост за точкой вставки — это O(n) работы.",
  },
};

const t = dict[lang];

const before = [
  { v: "10", i: "0", x: 170 },
  { v: "20", i: "1", x: 262 },
  { v: "30", i: "2", x: 354 },
  { v: "40", i: "3", x: 446 },
];
const after = [
  { v: "10", i: "0", x: 170, fresh: false },
  { v: "20", i: "1", x: 262, fresh: false },
  { v: "25", i: "2", x: 354, fresh: true },
  { v: "30", i: "3", x: 446, fresh: false },
  { v: "40", i: "4", x: 538, fresh: false },
];
const CW = 86;
const CH = 56;
const R1 = 116;
const R2 = 248;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="351" y="90" text-anchor="middle" font-size="16" fill="var(--accent)">{t.newVal}</text>
    <text x="351" y="110" text-anchor="middle" font-size="16" fill="var(--accent)">↓</text>
    <text x="397" y="102" text-anchor="middle" font-size="18" fill="var(--accent)">→</text>
    <text x="489" y="102" text-anchor="middle" font-size="18" fill="var(--accent)">→</text>
    <text x="610" y="106" text-anchor="middle" font-size="13" fill="var(--muted)">{t.shift}</text>

    <text x="80" y={R1 + 34} text-anchor="middle" font-size="14" fill="var(--ink)">{t.before}</text>
    {before.map((c) => (
      <g>
        <rect x={c.x} y={R1} width={CW} height={CH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={c.x + CW / 2} y={R1 + 37} text-anchor="middle" font-size="22" fill="var(--ink)">{c.v}</text>
        <text x={c.x + CW / 2} y={R1 + CH + 22} text-anchor="middle" font-size="12" fill="var(--muted)">{c.i}</text>
      </g>
    ))}

    <text x="80" y={R2 + 34} text-anchor="middle" font-size="14" fill="var(--ink)">{t.after}</text>
    {after.map((c) => (
      <g>
        <rect
          x={c.x}
          y={R2}
          width={CW}
          height={CH}
          fill="var(--card)"
          stroke={c.fresh ? "var(--accent)" : "var(--ink)"}
          stroke-width={c.fresh ? 3 : 2}
        />
        <text x={c.x + CW / 2} y={R2 + 37} text-anchor="middle" font-size="22" fill="var(--ink)">{c.v}</text>
        <text x={c.x + CW / 2} y={R2 + CH + 22} text-anchor="middle" font-size="12" fill="var(--muted)">{c.i}</text>
      </g>
    ))}

    <text x="400" y="372" text-anchor="middle" font-size="14" fill="var(--accent)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
