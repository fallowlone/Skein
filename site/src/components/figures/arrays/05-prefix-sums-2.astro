---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Query step: sum(1..3) equals prefix[4] minus prefix[1], 11 minus 2 equals 9",
    headline: "QUERY: ONE SUBTRACTION, O(1)",
    sub: "sum(i, j) = prefix[j+1] − prefix[i]",
    span: "i = 1 … j + 1 = 4",
    equation: "sum(1..3) = prefix[4] − prefix[1] = 11 − 2 = 9 ✓",
    check: "= arr[1] + arr[2] + arr[3] = 5 + 1 + 3 = 9",
    note: "one subtraction per query — O(1) forever",
    caption:
      "Then every range sum is one O(1) subtraction of two banked cells: sum(1..3) = prefix[4] − prefix[1] = 11 − 2 = 9, which is 5 + 1 + 3. The bracket snaps onto the two endpoint cells and never traverses the range.",
  },
  ru: {
    svgTitle: "Шаг запроса: sum(1..3) равно prefix[4] минус prefix[1], 11 минус 2 равно 9",
    headline: "ЗАПРОС: ОДНО ВЫЧИТАНИЕ, O(1)",
    sub: "sum(i, j) = prefix[j+1] − prefix[i]",
    span: "i = 1 … j + 1 = 4",
    equation: "sum(1..3) = prefix[4] − prefix[1] = 11 − 2 = 9 ✓",
    check: "= arr[1] + arr[2] + arr[3] = 5 + 1 + 3 = 9",
    note: "одно вычитание на запрос — O(1) вечно",
    caption:
      "Дальше каждая сумма диапазона — одно вычитание двух накопленных ячеек за O(1): sum(1..3) = prefix[4] − prefix[1] = 11 − 2 = 9, то есть 5 + 1 + 3. Рамка встаёт на две граничные ячейки и никогда не проходит диапазон.",
  },
};

const t = dict[lang];

const prefix = ["0", "2", "7", "8", "11", "15"];
const x0 = 104;
const cellW = 92;
const cellH = 60;
const step = 100;
const cx = (i: number) => x0 + i * step + cellW / 2;
const hi = [1, 4];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="100" text-anchor="middle" font-size="13" fill="var(--accent)">{t.span}</text>
    <line x1={cx(1)} y1="114" x2={cx(4)} y2="114" stroke="var(--accent)" stroke-width="2" />
    <line x1={cx(1)} y1="114" x2={cx(1)} y2="130" stroke="var(--accent)" stroke-width="2" />
    <line x1={cx(4)} y1="114" x2={cx(4)} y2="130" stroke="var(--accent)" stroke-width="2" />

    <text x="92" y="186" text-anchor="end" font-size="14" fill="var(--ink)">prefix</text>
    {prefix.map((v, i) => (
      <g>
        <rect
          x={x0 + i * step}
          y="150"
          width={cellW}
          height={cellH}
          fill="var(--card)"
          stroke={hi.includes(i) ? "var(--accent)" : "var(--ink)"}
          stroke-width={hi.includes(i) ? 3 : 2}
        />
        <text x={cx(i)} y="188" text-anchor="middle" font-size="17" fill="var(--ink)">{v}</text>
        <text x={cx(i)} y="234" text-anchor="middle" font-size="12" fill="var(--muted)">{i}</text>
      </g>
    ))}

    <text x="400" y="300" text-anchor="middle" font-size="15" fill="var(--ink)">{t.equation}</text>
    <text x="400" y="332" text-anchor="middle" font-size="13" fill="var(--muted)">{t.check}</text>
    <text x="400" y="384" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
