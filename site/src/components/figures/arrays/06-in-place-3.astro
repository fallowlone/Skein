---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Reversing five cells by swapping opposite ends inward",
    headline: "REVERSE BY SWAPPING ENDS",
    sub: "left and right move inward · [1, 2, 3, 4, 5] → [5, 4, 3, 2, 1]",
    swapLabel: "swap",
    leftLabel: "left = 1",
    rightLabel: "right = 3",
    midNote: "after swapping ends: [5, 2, 3, 4, 1]",
    finalLabel: "final",
    finalNote: "reversed in place · O(1) space",
    priceA: "in-place O(1) · destroys input",
    priceB: "new array O(n) · input safe",
    caption:
      "Two-pointer reversal swaps arr[0] with arr[4], then arr[1] with arr[3], until left meets right — [1, 2, 3, 4, 5] becomes [5, 4, 3, 2, 1] with only two pointers of extra space. The price of O(1): the input is overwritten, so if the original still matters, copy it first and pay O(n).",
  },
  ru: {
    svgTitle: "Разворот пяти ячеек свопом противоположных концов внутрь",
    headline: "РАЗВОРОТ СВОПОМ КОНЦОВ",
    sub: "left и right движутся внутрь · [1, 2, 3, 4, 5] → [5, 4, 3, 2, 1]",
    swapLabel: "своп",
    leftLabel: "left = 1",
    rightLabel: "right = 3",
    midNote: "после свопа концов: [5, 2, 3, 4, 1]",
    finalLabel: "финал",
    finalNote: "развёрнут на месте · O(1) памяти",
    priceA: "на месте O(1) · ввод уничтожен",
    priceB: "новый массив O(n) · ввод цел",
    caption:
      "Разворот двумя указателями: своп arr[0] с arr[4], потом arr[1] с arr[3], пока left не встретит right — [1, 2, 3, 4, 5] становится [5, 4, 3, 2, 1] ценой лишь двух указателей доп. памяти. Цена O(1): ввод перезаписывается, так что если оригинал ещё нужен — сначала скопируй и заплати O(n).",
  },
};

const t = dict[lang];

const mid = ["5", "2", "3", "4", "1"];
const done = ["5", "4", "3", "2", "1"];
const cellW = 60;
const laneX = (800 - mid.length * cellW) / 2;
const rowY = 96;
const leftCX = laneX + 1 * cellW + cellW / 2;
const rightCX = laneX + 3 * cellW + cellW / 2;
const row2Y = 236;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="88" text-anchor="middle" font-size="12" fill="var(--accent)">{t.swapLabel}</text>
    {mid.map((v, k) => (
      <g>
        <rect x={laneX + k * cellW} y={rowY} width={cellW} height="54" fill="var(--card)" stroke={(k === 1 || k === 3) ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={laneX + k * cellW + cellW / 2} y={rowY + 36} text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <line x1={leftCX} y1={rowY + 68} x2={leftCX} y2={rowY + 88} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${leftCX},${rowY + 64} ${leftCX - 6},${rowY + 76} ${leftCX + 6},${rowY + 76}`} fill="var(--accent)" />
    <line x1={rightCX} y1={rowY + 68} x2={rightCX} y2={rowY + 88} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${rightCX},${rowY + 64} ${rightCX - 6},${rowY + 76} ${rightCX + 6},${rowY + 76}`} fill="var(--accent)" />
    <text x={leftCX} y={rowY + 106} text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLabel}</text>
    <text x={rightCX} y={rowY + 106} text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLabel}</text>
    <text x="400" y={rowY + 124} text-anchor="middle" font-size="12" fill="var(--muted)">{t.midNote}</text>

    <text x={laneX - 16} y={row2Y + 36} text-anchor="end" font-size="13" fill="var(--muted)">{t.finalLabel}</text>
    {done.map((v, k) => (
      <g>
        <rect x={laneX + k * cellW} y={row2Y} width={cellW} height="54" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={laneX + k * cellW + cellW / 2} y={row2Y + 36} text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="400" y={row2Y + 78} text-anchor="middle" font-size="12" fill="var(--muted)">{t.finalNote}</text>

    <rect x="60" y="336" width="320" height="44" fill="none" stroke="var(--accent)" stroke-width="2" />
    <text x="220" y="363" text-anchor="middle" font-size="13" fill="var(--ink)">{t.priceA}</text>
    <rect x="420" y="336" width="320" height="44" fill="none" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 4" />
    <text x="580" y="363" text-anchor="middle" font-size="13" fill="var(--ink)">{t.priceB}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
