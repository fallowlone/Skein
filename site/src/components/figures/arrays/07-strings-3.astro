---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The fix: push pieces into an array at O(1) each, then one join pass at O(n); plus character codes",
    headline: "COLLECT, THEN JOIN ONCE",
    sub: "push is O(1) amortized · one join pass is O(n)",
    push: "push O(1)",
    join: 'join("") O(n)',
    total: "total O(n) ✓",
    codes: "'a' = 97 · 'b' = 98 · … · 'z' = 122",
    cmp: "'a' < 'b' compares codes: 97 < 98",
    note: "compare characters with < or > → compares their codes",
    caption:
      "The fix: push each piece into an array at O(1) amortized, then a single join('') pass builds the final string in O(n) — total O(n), not O(n²). And characters carry ordered codes ('a' = 97 through 'z' = 122), so comparing characters compares their codes.",
  },
  ru: {
    svgTitle: "Фикс: складывай куски в массив по O(1), затем один проход join за O(n); плюс коды символов",
    headline: "СОБЕРИ, ПОТОМ СКЛЕЙ РАЗ",
    sub: "push — O(1) амортизировано · один проход join — O(n)",
    push: "push O(1)",
    join: 'join("") O(n)',
    total: "итого O(n) ✓",
    codes: "'a' = 97 · 'b' = 98 · … · 'z' = 122",
    cmp: "'a' < 'b' сравнивает коды: 97 < 98",
    note: "сравнение символов через < или > → сравнение их кодов",
    caption:
      "Фикс: складывай каждый кусок в массив по O(1) амортизировано, затем один проход join('') строит финальную строку за O(n) — итого O(n), а не O(n²). А символы несут упорядоченные коды ('a' = 97 до 'z' = 122), поэтому сравнение символов сравнивает их коды.",
  },
};

const t = dict[lang];

const pieces = ["x", "x", "x", "x", "x"];
const boxW = 56;
const boxH = 52;
const rowY = 110;
const rowX = 110;
const step = 66;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={rowX + (5 * step - 10) / 2} y="94" text-anchor="middle" font-size="13" fill="var(--accent)">{t.push}</text>
    {pieces.map((p, i) => (
      <g>
        <rect x={rowX + i * step} y={rowY} width={boxW} height={boxH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={rowX + i * step + boxW / 2} y={rowY + 35} text-anchor="middle" font-size="20" fill="var(--ink)">{p}</text>
      </g>
    ))}

    <line x1={rowX + 5 * step + 4} y1={rowY + boxH / 2} x2="548" y2={rowY + boxH / 2} stroke="var(--accent)" stroke-width="2" />
    <polygon points="548,128 548,144 562,136" fill="var(--accent)" />
    <text x="505" y="118" text-anchor="middle" font-size="12" fill="var(--accent)">{t.join}</text>

    <rect x="566" y={rowY} width="124" height={boxH} fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="628" y={rowY + 35} text-anchor="middle" font-size="20" fill="var(--ink)">xxxxx</text>

    <text x="400" y="206" text-anchor="middle" font-size="15" fill="var(--ink)">{t.total}</text>

    <line x1="80" y1="230" x2="720" y2="230" stroke="var(--muted)" stroke-width="1" stroke-dasharray="6 5" />

    <rect x="150" y="262" width="500" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="297" text-anchor="middle" font-size="17" fill="var(--ink)">{t.codes}</text>

    <text x="400" y="348" text-anchor="middle" font-size="14" fill="var(--ink)">{t.cmp}</text>
    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
