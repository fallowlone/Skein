---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Early exit: searching for 5 in a four-cell array stops at index 2",
    headline: "EARLY EXIT — BEST CASE, NOT BIG-O",
    sub: "searching for 5 in [1, 7, 5, 3] · stop the moment the answer is known",
    target: "target = 5",
    retLabel: "▼ return",
    verdicts: ["1 ≠ 5 · next", "7 ≠ 5 · next", "5 = 5 · return 2", "never checked"],
    best: "best: found at index 0 → 1 step → O(1)",
    worst: "worst: not found, all n checked → n steps → O(n)",
    bigo: "Big-O: still O(n) — we analyze the worst case",
    note: "visited only 3 of 4 cells — index 3 skipped",
    caption:
      "Early exit stops the walk as soon as the answer is known: here 5 is found at index 2, so index 3 is never checked. The best case drops to one step — O(1) — but Big-O still counts the worst case, the target missing after n checks, so the bound stays O(n).",
  },
  ru: {
    svgTitle: "Ранний выход: поиск 5 в массиве из четырёх ячеек останавливается на индексе 2",
    headline: "РАННИЙ ВЫХОД — ЛУЧШИЙ СЛУЧАЙ, НЕ BIG-O",
    sub: "ищем 5 в [1, 7, 5, 3] · стоп, как только ответ известен",
    target: "цель = 5",
    retLabel: "▼ верни",
    verdicts: ["1 ≠ 5 · дальше", "7 ≠ 5 · дальше", "5 = 5 · верни 2", "не проверяли"],
    best: "лучший: найдено на индексе 0 → 1 шаг → O(1)",
    worst: "худший: не найдено, все n проверены → n шагов → O(n)",
    bigo: "Big-O: всё ещё O(n) — анализируем худший случай",
    note: "посетили только 3 ячейки из 4 — индекс 3 пропущен",
    caption:
      "Ранний выход останавливает проход, как только ответ известен: здесь 5 найдена на индексе 2, и индекс 3 уже не проверяется. Лучший случай падает до одного шага — O(1), — но Big-O считает худший случай, когда цели нет после n проверок, так что граница остаётся O(n).",
  },
};

const t = dict[lang];

const cells = ["1", "7", "5", "3"];
const cellW = 96;
const cellGap = 14;
const laneW = cells.length * cellW + (cells.length - 1) * cellGap;
const laneX = (800 - laneW) / 2;
const laneY = 108;
const cellH = 66;

const cellX = (k: number) => laneX + k * (cellW + cellGap);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={laneX} y="96" font-size="13" fill="var(--accent)">{t.target}</text>
    {cells.map((v, k) => (
      <g>
        <rect
          x={cellX(k)}
          y={laneY}
          width={cellW}
          height={cellH}
          fill={k === 2 ? "var(--card)" : "none"}
          stroke={k === 3 ? "var(--muted)" : "var(--ink)"}
          stroke-width="2"
          stroke-dasharray={k === 3 ? "6 4" : "none"}
        />
        <text x={cellX(k) + cellW / 2} y={laneY + 40} text-anchor="middle" font-size="20" fill={k === 3 ? "var(--muted)" : "var(--ink)"}>{v}</text>
        <text x={cellX(k) + cellW / 2} y={laneY + cellH + 22} text-anchor="middle" font-size="12" fill="var(--muted)">i={k}</text>
        <text x={cellX(k) + cellW / 2} y={laneY + cellH + 42} text-anchor="middle" font-size="11" fill={k === 2 ? "var(--accent)" : "var(--muted)"}>{t.verdicts[k]}</text>
      </g>
    ))}
    <text x={cellX(2) + cellW / 2} y={laneY - 14} text-anchor="middle" font-size="12" fill="var(--accent)">{t.retLabel}</text>

    <g font-size="14">
      <rect x="72" y="262" width="12" height="12" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="94" y="273" fill="var(--ink)">{t.best}</text>
      <rect x="72" y="292" width="12" height="12" fill="none" stroke="var(--ink)" stroke-width="2" />
      <text x="94" y="303" fill="var(--ink)">{t.worst}</text>
      <rect x="72" y="322" width="12" height="12" fill="var(--accent)" stroke="var(--accent)" stroke-width="2" />
      <text x="94" y="333" fill="var(--ink)">{t.bigo}</text>
    </g>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
