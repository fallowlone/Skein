---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Variable window on [2,3,1,2,4,3] with target 7: grows to sum 8, then settles on best [4,3] length 2",
    headline: "VARIABLE WINDOW: right GROWS, left SHRINKS",
    sub: "arr = [2, 3, 1, 2, 4, 3] · target = 7",
    row1: "grow right → 3 · sum = 8 ≥ 7 · len 4 → shrink left",
    row2: "best: [4, 3] · sum = 7 ≥ 7 · len 2 ✓",
    bestTag: "best",
    note: "grow until valid, shrink until minimal — left never moves back",
    caption:
      "Variable-size window, target 7: right grows to index 3 (sum 8, len 4) so left shrinks; after growing and shrinking again the pass settles on [4, 3] with sum 7 at length 2 — the smallest valid window.",
  },
  ru: {
    svgTitle: "Плавающее окно на [2,3,1,2,4,3] с целью 7: растёт до суммы 8, затем встаёт на лучшее [4,3] длины 2",
    headline: "ПЛАВАЮЩЕЕ ОКНО: right РАСТИТ, left СЖИМАЕТ",
    sub: "arr = [2, 3, 1, 2, 4, 3] · цель = 7",
    row1: "растим right → 3 · sum = 8 ≥ 7 · len 4 → сжать left",
    row2: "лучшее: [4, 3] · sum = 7 ≥ 7 · len 2 ✓",
    bestTag: "лучшее",
    note: "расти пока не годно, сжимай пока минимально — left назад не идёт",
    caption:
      "Окно переменного размера, цель 7: right растёт к индексу 3 (сумма 8, длина 4), и left сжимает; после нового роста и сжатия проход встаёт на [4, 3] с суммой 7 при длине 2 — наименьшее годное окно.",
  },
};

const t = dict[lang];

const cells = ["2", "3", "1", "2", "4", "3"];
const cellW = 76;
const cellGap = 8;
const startX = 148;
const row1Y = 118;
const row2Y = 238;
const cellH = 48;

const cellX = (i: number) => startX + i * (cellW + cellGap);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="23" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <!-- Row 1: grown window [2,3,1,2], sum 8, len 4 -> shrink -->
    <text x="400" y="102" text-anchor="middle" font-size="13" fill="var(--ink)">{t.row1}</text>
    {cells.map((v, i) => (
      <g>
        <rect
          x={cellX(i)}
          y={row1Y}
          width={cellW}
          height={cellH}
          fill={i <= 3 ? "var(--accent)" : "var(--card)"}
          stroke="var(--ink)"
          stroke-width="2"
        />
        <text x={cellX(i) + cellW / 2} y={row1Y + 31} text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x={cellX(0) + cellW / 2} y={row1Y + cellH + 24} text-anchor="middle" font-size="12" fill="var(--muted)">left</text>
    <text x={cellX(3) + cellW / 2} y={row1Y + cellH + 24} text-anchor="middle" font-size="12" fill="var(--muted)">right</text>

    <!-- Row 2: best window [4,3], sum 7, len 2 -->
    <text x="400" y="222" text-anchor="middle" font-size="13" fill="var(--ink)">{t.row2}</text>
    {cells.map((v, i) => (
      <g>
        <rect
          x={cellX(i)}
          y={row2Y}
          width={cellW}
          height={cellH}
          fill={i >= 4 ? "var(--accent)" : "var(--card)"}
          stroke={i >= 4 ? "var(--ink)" : "var(--muted)"}
          stroke-width="2"
        />
        <text x={cellX(i) + cellW / 2} y={row2Y + 31} text-anchor="middle" font-size="16" fill={i >= 4 ? "var(--ink)" : "var(--muted)"}>{v}</text>
      </g>
    ))}
    <text x={cellX(4) + cellW / 2} y={row2Y + cellH + 24} text-anchor="middle" font-size="12" fill="var(--muted)">left</text>
    <text x={cellX(5) + cellW / 2} y={row2Y + cellH + 24} text-anchor="middle" font-size="12" fill="var(--muted)">right</text>
    <text x={cellX(5) + cellW + 12} y={row2Y + 30} font-size="12" fill="var(--muted)">{t.bestTag}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
