---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Traversal lane of six cells; the index i advances while the accumulator grows",
    headline: "ONE PASS: i WALKS 0 → n−1",
    sub: "each cell visited exactly once · acc folds every visit",
    row1State: "i=2 · acc=27 · visited 3/6",
    row2State: "i=5 · acc=108 · full pass O(n)",
    note: "n cells, n visits — one pass, O(n)",
    caption:
      "Traversal is one pass: the index i walks from 0 to n−1 and touches each of the n cells exactly once, so the walk costs n steps — O(n). Above, the bracket swallows cells 4, 8, 15 and the accumulator holds 27; at the end all six cells are folded into acc=108.",
  },
  ru: {
    svgTitle: "Лента обхода из шести ячеек; индекс i движется, а аккумулятор растёт",
    headline: "ОДИН ПРОХОД: i ИДЁТ 0 → n−1",
    sub: "каждая ячейка ровно раз · acc сворачивает визиты",
    row1State: "i=2 · acc=27 · посещены 3/6",
    row2State: "i=5 · acc=108 · полный проход O(n)",
    note: "n ячеек, n визитов — один проход, O(n)",
    caption:
      "Обход — это один проход: индекс i идёт от 0 до n−1 и заходит в каждую из n ячеек ровно раз, поэтому проход стоит n шагов — O(n). Выше рамка поглотила ячейки 4, 8, 15, и аккумулятор держит 27; в конце все шесть ячеек свёрнуты в acc=108.",
  },
};

const t = dict[lang];

const cells = ["4", "8", "15", "16", "23", "42"];
const cellW = 80;
const cellGap = 12;
const laneW = cells.length * cellW + (cells.length - 1) * cellGap;
const laneX = (800 - laneW) / 2;
const cellH = 60;
const row1Y = 116;
const row2Y = 248;

const cellX = (k: number) => laneX + k * (cellW + cellGap);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="100" text-anchor="middle" font-size="13" fill="var(--accent)">{t.row1State}</text>
    {cells.map((v, k) => (
      <g>
        <rect x={cellX(k)} y={row1Y} width={cellW} height={cellH} fill={k <= 2 ? "var(--card)" : "none"} stroke={k === 2 ? "var(--accent)" : "var(--ink)"} stroke-width={k === 2 ? 3 : 2} />
        <text x={cellX(k) + cellW / 2} y={row1Y + 38} text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
        <text x={cellX(k) + cellW / 2} y={row1Y + cellH + 22} text-anchor="middle" font-size="12" fill="var(--muted)">{k}</text>
      </g>
    ))}
    <rect x={laneX - 8} y={row1Y - 8} width={3 * cellW + 2 * cellGap + 16} height={cellH + 16} fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 4" />

    <text x="400" y="232" text-anchor="middle" font-size="13" fill="var(--accent)">{t.row2State}</text>
    {cells.map((v, k) => (
      <g>
        <rect x={cellX(k)} y={row2Y} width={cellW} height={cellH} fill="var(--card)" stroke={k === 5 ? "var(--accent)" : "var(--ink)"} stroke-width={k === 5 ? 3 : 2} />
        <text x={cellX(k) + cellW / 2} y={row2Y + 38} text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
        <text x={cellX(k) + cellW / 2} y={row2Y + cellH + 22} text-anchor="middle" font-size="12" fill="var(--muted)">{k}</text>
      </g>
    ))}
    <rect x={laneX - 8} y={row2Y - 8} width={laneW + 16} height={cellH + 16} fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 4" />

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
