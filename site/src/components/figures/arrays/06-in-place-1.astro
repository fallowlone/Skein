---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Naive versus in-place removal of zeros from seven cells",
    headline: "NAIVE BUILDS · IN-PLACE OVERWRITES",
    sub: "same input [1, 0, 2, 0, 3, 0, 4] · same result [1, 2, 3, 4]",
    inputLabel: "input",
    naiveTitle: "naive: new array",
    naiveCells: "result grows by push",
    naiveNote: "extra space O(n)",
    inplaceTitle: "in-place: same cells",
    inplaceCells: "cells overwritten in place",
    inplaceNote: "extra space O(1)",
    bottom: "same logical result — one allocates, the other overwrites",
    caption:
      "Naive filtering pushes keepers into a new result array (O(n) extra space); in-place filtering overwrites the input's own cells with a write pointer (O(1) extra space). Both turn [1, 0, 2, 0, 3, 0, 4] into [1, 2, 3, 4] — but only the naive version keeps the original.",
  },
  ru: {
    svgTitle: "Наивное и на-месте удаление нулей из семи ячеек",
    headline: "НАИВНО СТРОИТ · НА МЕСТЕ ПЕРЕЗАПИСЫВАЕТ",
    sub: "тот же ввод [1, 0, 2, 0, 3, 0, 4] · тот же результат [1, 2, 3, 4]",
    inputLabel: "ввод",
    naiveTitle: "наивно: новый массив",
    naiveCells: "result растёт через push",
    naiveNote: "доп. память O(n)",
    inplaceTitle: "на месте: те же ячейки",
    inplaceCells: "ячейки перезаписаны на месте",
    inplaceNote: "доп. память O(1)",
    bottom: "тот же логический результат — один выделяет, другой перезаписывает",
    caption:
      "Наивная фильтрация кладёт годные push в новый массив result (O(n) доп. памяти); фильтрация на месте перезаписывает собственные ячейки ввода указателем write (O(1) доп. памяти). Оба превращают [1, 0, 2, 0, 3, 0, 4] в [1, 2, 3, 4] — но только наивный сохраняет оригинал.",
  },
};

const t = dict[lang];

const input = ["1", "0", "2", "0", "3", "0", "4"];
const kept = ["1", "2", "3", "4"];
const cellW = 56;
const laneX = (800 - input.length * cellW) / 2;
const laneY = 108;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={laneX - 16} y={laneY + 34} text-anchor="end" font-size="13" fill="var(--muted)">{t.inputLabel}</text>
    {input.map((v, k) => (
      <g>
        <rect x={laneX + k * cellW} y={laneY} width={cellW} height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={laneX + k * cellW + cellW / 2} y={laneY + 34} text-anchor="middle" font-size="16" fill={v === "0" ? "var(--muted)" : "var(--ink)"}>{v}</text>
      </g>
    ))}

    <rect x="60" y="200" width="320" height="140" fill="none" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 4" />
    <text x="220" y="228" text-anchor="middle" font-size="14" fill="var(--ink)">{t.naiveTitle}</text>
    {kept.map((v, k) => (
      <g>
        <rect x={100 + k * 52} y="244" width="52" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
        <text x={100 + k * 52 + 26} y="272" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="220" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.naiveCells}</text>
    <text x="220" y="328" text-anchor="middle" font-size="13" fill="var(--ink)">{t.naiveNote}</text>

    <rect x="420" y="200" width="320" height="140" fill="none" stroke="var(--accent)" stroke-width="2" />
    <text x="580" y="228" text-anchor="middle" font-size="14" fill="var(--ink)">{t.inplaceTitle}</text>
    {kept.map((v, k) => (
      <g>
        <rect x={460 + k * 52} y="244" width="52" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={460 + k * 52 + 26} y="272" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="580" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.inplaceCells}</text>
    <text x="580" y="328" text-anchor="middle" font-size="13" fill="var(--ink)">{t.inplaceNote}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bottom}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
