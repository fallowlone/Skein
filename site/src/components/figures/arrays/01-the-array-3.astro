---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Array cost table: get and set O(1), search, insert, delete O(n), append O(1) amortized",
    headline: "EVERY OPERATION'S PRICE, FROM ONE FACT",
    sub: "read/write O(1) · search O(n) · insert/delete O(n) · append O(1) amortized",
    note: "contiguity = O(1) read, O(n) middle write",
    caption:
      "Takeaway: contiguity buys O(1) reads and writes by index and charges O(n) for search and middle writes; append is O(1) amortized. Choose arrays for read-heavy tasks.",
    rows: [
      { op: "Get element", ex: "arr[5]", cost: "O(1)" },
      { op: "Set element", ex: "arr[5] = 99", cost: "O(1)" },
      { op: "Search for value", ex: "search(arr, 99)", cost: "O(n)" },
      { op: "Insert at index i", ex: "insertAt(arr, 2, 50)", cost: "O(n)" },
      { op: "Delete at index i", ex: "deleteAt(arr, 2)", cost: "O(n)" },
      { op: "Append (push)", ex: "arr.push(99)", cost: "O(1) amortized" },
    ],
  },
  ru: {
    svgTitle: "Таблица цен массива: чтение и запись O(1), поиск, вставка, удаление O(n), добавление O(1) амортизировано",
    headline: "ЦЕНА КАЖДОЙ ОПЕРАЦИИ — ИЗ ОДНОГО ФАКТА",
    sub: "чтение/запись O(1) · поиск O(n) · вставка/удаление O(n) · append O(1) амортизировано",
    note: "вплотную = чтение O(1), запись в середину O(n)",
    caption:
      "Вывод: вплотную даёт чтение и запись по индексу за O(1) и берёт O(n) за поиск и запись в середину; добавление в конец — O(1) амортизировано. Выбери массивы для операций, где много чтения.",
    rows: [
      { op: "Получить элемент", ex: "arr[5]", cost: "O(1)" },
      { op: "Установить элемент", ex: "arr[5] = 99", cost: "O(1)" },
      { op: "Поиск значения", ex: "search(arr, 99)", cost: "O(n)" },
      { op: "Вставить на индекс i", ex: "insertAt(arr, 2, 50)", cost: "O(n)" },
      { op: "Удалить на индексе i", ex: "deleteAt(arr, 2)", cost: "O(n)" },
      { op: "Добавить в конец (push)", ex: "arr.push(99)", cost: "O(1) амортизировано" },
    ],
  },
};

const t = dict[lang];

const RY = 88;
const RH = 47;
const RBH = 41;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.rows.map((r, k) => (
      <g>
        <rect x="60" y={RY + k * RH} width="680" height={RBH} fill="var(--card)" stroke="var(--muted)" stroke-width="1" />
        <text x="84" y={RY + k * RH + 27} font-size="14" fill="var(--ink)">{r.op}</text>
        <text x="408" y={RY + k * RH + 27} text-anchor="middle" font-size="13" fill="var(--muted)">{r.ex}</text>
        <text x="716" y={RY + k * RH + 27} text-anchor="end" font-size="14" fill="var(--accent)">{r.cost}</text>
      </g>
    ))}

    <text x="400" y="398" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
