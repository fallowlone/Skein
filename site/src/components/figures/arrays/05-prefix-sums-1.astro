---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Build step: array [2, 5, 1, 3, 4] becomes prefix lane [0, 2, 7, 8, 11, 15]",
    headline: "BUILD ONCE: RUNNING TOTAL IN EVERY CELL",
    sub: "prefix[k] = sum of first k · length n+1, not n",
    anchor: "anchor",
    equation: "prefix[3] = prefix[2] + arr[2] = 7 + 1 = 8",
    note: "O(n) build · prefix[0] = 0 is the anchor",
    caption:
      "Precompute once in O(n): prefix[k] banks the sum of the first k elements, so the lane [0, 2, 7, 8, 11, 15] is the running total of [2, 5, 1, 3, 4]. Length n+1, not n — the leading prefix[0] = 0 anchor means no edge cases.",
  },
  ru: {
    svgTitle: "Шаг построения: массив [2, 5, 1, 3, 4] становится лентой префиксов [0, 2, 7, 8, 11, 15]",
    headline: "СОБЕРИ РАЗ: ТЕКУЩАЯ СУММА В КАЖДОЙ ЯЧЕЙКЕ",
    sub: "prefix[k] = сумма первых k · длина n+1, а не n",
    anchor: "якорь",
    equation: "prefix[3] = prefix[2] + arr[2] = 7 + 1 = 8",
    note: "сборка O(n) · prefix[0] = 0 — якорь ленты",
    caption:
      "Предвычисли раз за O(n): prefix[k] копит сумму первых k элементов, и лента [0, 2, 7, 8, 11, 15] — накопленная сумма [2, 5, 1, 3, 4]. Длина n+1, а не n — ведущий якорь prefix[0] = 0 значит: без краевых случаев.",
  },
};

const t = dict[lang];

const arr = ["2", "5", "1", "3", "4"];
const prefix = ["0", "2", "7", "8", "11", "15"];
const arrX0 = 204;
const preX0 = 164;
const cellW = 72;
const cellH = 50;
const step = 80;
const arrX = (i: number) => arrX0 + i * step;
const preX = (i: number) => preX0 + i * step;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="ps1-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="192" y="142" text-anchor="end" font-size="14" fill="var(--ink)">arr</text>
    {arr.map((v, i) => (
      <g>
        <text x={arrX(i) + cellW / 2} y="100" text-anchor="middle" font-size="12" fill="var(--muted)">{i}</text>
        <rect x={arrX(i)} y="110" width={cellW} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={arrX(i) + cellW / 2} y="142" text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="152" y="262" text-anchor="end" font-size="14" fill="var(--ink)">prefix</text>
    {prefix.map((v, i) => (
      <g>
        <rect
          x={preX(i)}
          y="230"
          width={cellW}
          height={cellH}
          fill="var(--card)"
          stroke={i === 0 ? "var(--accent)" : "var(--ink)"}
          stroke-width={i === 0 ? 3 : 2}
        />
        <text x={preX(i) + cellW / 2} y="262" text-anchor="middle" font-size="16" fill="var(--ink)">{v}</text>
        <text x={preX(i) + cellW / 2} y="302" text-anchor="middle" font-size="12" fill="var(--muted)">{i}</text>
      </g>
    ))}

    <text x={preX(0) + cellW / 2} y="202" text-anchor="middle" font-size="12" fill="var(--accent)">{t.anchor}</text>
    <line
      x1={arrX(2) + cellW / 2}
      y1="162"
      x2={preX(3) + cellW / 2 - 8}
      y2="226"
      stroke="var(--accent)"
      stroke-width="2"
      stroke-dasharray="6 4"
      marker-end="url(#ps1-arrow)"
    />
    <text x="424" y="200" text-anchor="middle" font-size="16" fill="var(--accent)">+</text>

    <text x="400" y="346" text-anchor="middle" font-size="15" fill="var(--ink)">{t.equation}</text>
    <text x="400" y="390" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
