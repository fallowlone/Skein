---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Same-direction remove-duplicates trace: fast scouts ahead, slow records unique values",
    headline: "FAST SCOUTS · SLOW RECORDS",
    sub: "remove duplicates in place · start [1, 1, 2, 2, 3]",
    slow: "slow",
    fast: "fast",
    start: "start · slow = 0, fast = 1",
    mid: "fast scans ahead · copies each new value back to slow",
    end: "done · slow = 2 · return slow + 1 = 3",
    unique: "unique: [1, 2, 3]",
    note: "one pass, no backtracking · O(n) time, O(1) space",
    caption:
      "Same-direction shape on [1, 1, 2, 2, 3]: fast runs ahead while slow marks the recorded uniques, copying each discovery back in place. The loop ends with slow = 2, returning length 3 — again one pass, never O(n²).",
  },
  ru: {
    svgTitle: "Трассировка удаления дубликатов: fast разведывает вперёд, slow записывает уникальные",
    headline: "FAST РАЗВЕДЫВАЕТ · SLOW ЗАПИСЫВАЕТ",
    sub: "убрать дубликаты на месте · старт [1, 1, 2, 2, 3]",
    slow: "slow",
    fast: "fast",
    start: "старт · slow = 0, fast = 1",
    mid: "fast сканирует вперёд · копирует новое назад в slow",
    end: "готово · slow = 2 · возврат slow + 1 = 3",
    unique: "уникальные: [1, 2, 3]",
    note: "один проход, без возврата назад · O(n) время, O(1) память",
    caption:
      "Форма одного направления на [1, 1, 2, 2, 3]: fast бежит вперёд, пока slow отмечает записанные уникальные, копируя каждую находку на месте. Цикл кончается при slow = 2, возвращая длину 3 — опять один проход, не O(n²).",
  },
};

const t = dict[lang];

const startCells = ["1", "1", "2", "2", "3"];
const endCells = ["1", "2", "3", "2", "3"];
const cellW = 80;
const gap = 8;
const totalW = startCells.length * cellW + (startCells.length - 1) * gap;
const startX = (800 - totalW) / 2;
const cellH = 48;

function cellX(i: number) {
  return startX + i * (cellW + gap);
}
function cellCX(i: number) {
  return cellX(i) + cellW / 2;
}

const row1Y = 114;
const row2Y = 262;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="98" text-anchor="middle" font-size="13" fill="var(--muted)">{t.start}</text>
    {startCells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={row1Y} width={cellW} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellCX(i)} y={row1Y + 32} text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x={cellCX(0)} y={row1Y + 72} text-anchor="middle" font-size="13" fill="var(--ink)">↑ {t.slow}</text>
    <text x={cellCX(1)} y={row1Y + 72} text-anchor="middle" font-size="13" fill="var(--ink)">↑ {t.fast}</text>

    <text x="400" y="228" text-anchor="middle" font-size="14" fill="var(--ink)">{t.mid}</text>

    <text x="400" y={row2Y - 14} text-anchor="middle" font-size="13" fill="var(--muted)">{t.end}</text>
    {endCells.map((v, i) => (
      <g>
        <rect x={cellX(i)} y={row2Y} width={cellW} height={cellH} fill="var(--card)" stroke={i < 3 ? "var(--accent)" : "var(--ink)"} stroke-width={i < 3 ? 3 : 2} />
        <text x={cellCX(i)} y={row2Y + 32} text-anchor="middle" font-size="18" fill={i < 3 ? "var(--ink)" : "var(--muted)"}>{v}</text>
      </g>
    ))}
    <text x={cellCX(2)} y={row2Y + 72} text-anchor="middle" font-size="13" fill="var(--ink)">↑ {t.slow}</text>
    <text x="400" y={row2Y + 76} text-anchor="middle" font-size="13" fill="var(--muted)" dx="150">{t.unique}</text>

    <text x="400" y="398" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
