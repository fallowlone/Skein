---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Fixed window k=3 on [1,4,2,10,2,3,1,0,20]: window [1,4,2] sums to 7, then slides to sum 16",
    headline: "FIXED WINDOW k=3: DROP LEFT, ADD RIGHT",
    sub: "arr = [1, 4, 2, 10, 2, 3, 1, 0, 20]",
    row1: "first window [1, 4, 2] · sum = 7",
    row2: "right = 3 · sum = 7 − 1 + 10 = 16",
    remove: "−1 out",
    add: "+10 in",
    note: "one slide = one subtraction + one addition · O(1)",
    caption:
      "Fixed-size window, k = 3: the first window [1, 4, 2] sums to 7, then one slide removes arr[0] = 1 and adds arr[3] = 10 for sum 16. The window keeps length k and carries its sum forward — never recomputed.",
  },
  ru: {
    svgTitle: "Фиксированное окно k=3 на [1,4,2,10,2,3,1,0,20]: окно [1,4,2] даёт 7, затем сдвиг даёт 16",
    headline: "ФИКС. ОКНО k=3: УБЕРИ СЛЕВА, ДОБАВЬ СПРАВА",
    sub: "arr = [1, 4, 2, 10, 2, 3, 1, 0, 20]",
    row1: "первое окно [1, 4, 2] · сумма = 7",
    row2: "right = 3 · сумма = 7 − 1 + 10 = 16",
    remove: "−1 уходит",
    add: "+10 входит",
    note: "один сдвиг = одно вычитание + одно сложение · O(1)",
    caption:
      "Окно фиксированного размера, k = 3: первое окно [1, 4, 2] даёт сумму 7, затем один сдвиг убирает arr[0] = 1 и добавляет arr[3] = 10 — сумма 16. Окно держит длину k и несёт свою сумму вперёд — без пересчёта.",
  },
};

const t = dict[lang];

const cells = ["1", "4", "2", "10", "2", "3", "1", "0", "20"];
const cellW = 60;
const cellGap = 6;
const startX = 101;
const row1Y = 118;
const row2Y = 238;
const cellH = 46;

const cellX = (i: number) => startX + i * (cellW + cellGap);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="23" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <!-- Row 1: first window [1,4,2] -->
    <text x="400" y="102" text-anchor="middle" font-size="13" fill="var(--ink)">{t.row1}</text>
    {cells.map((v, i) => (
      <g>
        <rect
          x={cellX(i)}
          y={row1Y}
          width={cellW}
          height={cellH}
          fill={i < 3 ? "var(--accent)" : "var(--card)"}
          stroke="var(--ink)"
          stroke-width="2"
        />
        <text x={cellX(i) + cellW / 2} y={row1Y + 30} text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x={cellX(0) + cellW / 2} y={row1Y + cellH + 24} text-anchor="middle" font-size="12" fill="var(--muted)">left</text>
    <text x={cellX(2) + cellW / 2} y={row1Y + cellH + 24} text-anchor="middle" font-size="12" fill="var(--muted)">right</text>

    <!-- Row 2: slid window [4,2,10] -->
    <text x="400" y="222" text-anchor="middle" font-size="13" fill="var(--ink)">{t.row2}</text>
    {cells.map((v, i) => (
      <g>
        <rect
          x={cellX(i)}
          y={row2Y}
          width={cellW}
          height={cellH}
          fill={i >= 1 && i <= 3 ? "var(--accent)" : "var(--card)"}
          stroke={i === 0 ? "var(--muted)" : "var(--ink)"}
          stroke-width="2"
          stroke-dasharray={i === 0 ? "5 4" : "none"}
        />
        <text x={cellX(i) + cellW / 2} y={row2Y + 30} text-anchor="middle" font-size="15" fill={i === 0 ? "var(--muted)" : "var(--ink)"}>{v}</text>
      </g>
    ))}
    <text x={cellX(0) + cellW / 2} y={row2Y - 10} text-anchor="middle" font-size="12" fill="var(--muted)">{t.remove}</text>
    <text x={cellX(3) + cellW / 2} y={row2Y + cellH + 24} text-anchor="middle" font-size="12" fill="var(--muted)">{t.add}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
