---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Write pointer at 3 while scan reads cell 5 during zero removal",
    headline: "SCAN READS · WRITE RECORDS",
    sub: "removing 0 from [1, 0, 2, 0, 3, 0, 4] · mid-trace snapshot",
    keptLabel: "kept [1, 2, 3]",
    writeLabel: "write = 3",
    writeNote: "next keeper lands here",
    scanLabel: "scan i = 5 · skip",
    scanNote: "arr[5] = 0, write holds",
    bottom: "i reads every cell · write advances only on keepers",
    caption:
      "Mid-trace of the write-pointer compaction: scan has kept [1, 2, 3] so write = 3, and scan i = 5 reads a 0, so it is skipped and write holds. A write pointer that only advances on keepers rearranges the array inside its own cells — O(1) extra space, original gone.",
  },
  ru: {
    svgTitle: "Указатель write на 3, пока scan читает ячейку 5 при удалении нулей",
    headline: "SCAN ЧИТАЕТ · WRITE ЗАПИСЫВАЕТ",
    sub: "убираем 0 из [1, 0, 2, 0, 3, 0, 4] · снимок посреди трассировки",
    keptLabel: "годные [1, 2, 3]",
    writeLabel: "write = 3",
    writeNote: "следующий годный встанет сюда",
    scanLabel: "scan i = 5 · пропуск",
    scanNote: "arr[5] = 0, write стоит",
    bottom: "i читает каждую ячейку · write движется только на годных",
    caption:
      "Снимок посреди сжатия указателем записи: scan сохранил [1, 2, 3], значит write = 3, а scan i = 5 читает 0 — пропуск, write стоит. Указатель write, что движется только на годных, переставляет массив в его же ячейках — O(1) доп. памяти, оригинал потерян.",
  },
};

const t = dict[lang];

const cells = ["1", "2", "3", "0", "3", "0", "4"];
const cellW = 64;
const laneX = (800 - cells.length * cellW) / 2;
const laneY = 158;
const writeCX = laneX + 3 * cellW + cellW / 2;
const scanCX = laneX + 5 * cellW + cellW / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="272" y="112" text-anchor="middle" font-size="13" fill="var(--ink)">{t.keptLabel}</text>
    <line x1={laneX} y1="122" x2={laneX + 3 * cellW} y2="122" stroke="var(--accent)" stroke-width="2" />
    <line x1={laneX} y1="122" x2={laneX} y2="132" stroke="var(--accent)" stroke-width="2" />
    <line x1={laneX + 3 * cellW} y1="122" x2={laneX + 3 * cellW} y2="132" stroke="var(--accent)" stroke-width="2" />

    <text x={scanCX} y="96" text-anchor="middle" font-size="13" fill="var(--ink)">{t.scanLabel}</text>
    <text x={scanCX} y="114" text-anchor="middle" font-size="12" fill="var(--muted)">{t.scanNote}</text>
    <line x1={scanCX} y1={laneY - 10} x2={scanCX} y2={laneY - 34} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${scanCX},${laneY - 6} ${scanCX - 6},${laneY - 18} ${scanCX + 6},${laneY - 18}`} fill="var(--accent)" />

    {cells.map((v, k) => (
      <g>
        <rect x={laneX + k * cellW} y={laneY} width={cellW} height="60" fill="var(--card)" stroke={k < 3 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={laneX + k * cellW + cellW / 2} y={laneY + 39} text-anchor="middle" font-size="17" fill={v === "0" ? "var(--muted)" : "var(--ink)"}>{v}</text>
      </g>
    ))}
    {cells.map((_, k) => (
      <text x={laneX + k * cellW + cellW / 2} y={laneY + 78} text-anchor="middle" font-size="11" fill="var(--muted)">{k}</text>
    ))}

    <line x1={writeCX} y1={laneY + 96} x2={writeCX} y2={laneY + 122} stroke="var(--accent)" stroke-width="2" />
    <polygon points={`${writeCX},${laneY + 92} ${writeCX - 6},${laneY + 104} ${writeCX + 6},${laneY + 104}`} fill="var(--accent)" />
    <text x={writeCX} y={laneY + 142} text-anchor="middle" font-size="13" fill="var(--ink)">{t.writeLabel}</text>
    <text x={writeCX} y={laneY + 160} text-anchor="middle" font-size="12" fill="var(--muted)">{t.writeNote}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bottom}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
