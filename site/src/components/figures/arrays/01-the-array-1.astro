---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Five contiguous array cells 10 to 50 with addresses 1000 to 1016 and address math",
    headline: "CONTIGUOUS CELLS: ADDRESS MATH IS O(1)",
    sub: "base 1000 · cell 4 bytes · no gaps",
    idx: "index",
    formula: "addr(i) = base + i × 4",
    ex2: "addr(2) = 1000 + 2×4 = 1008 · O(1)",
    ex4: "addr(4) = 1000 + 4×4 = 1016 · O(1)",
    note: "jump straight to index 2 — no scan",
    caption:
      "The contract: equal cells with no gaps — addr(i) = base + i × size. One multiply-and-add jumps straight to any element (here addr(2) = 1008), so reads are O(1) with no scan.",
  },
  ru: {
    svgTitle: "Пять ячеек массива вплотную от 10 до 50 с адресами 1000–1016 и адресной арифметикой",
    headline: "ЯЧЕЙКИ ВПЛОТНУЮ: АДРЕС СЧИТАЕТСЯ ЗА O(1)",
    sub: "base 1000 · ячейка 4 байта · без зазоров",
    idx: "индекс",
    formula: "addr(i) = base + i × 4",
    ex2: "addr(2) = 1000 + 2×4 = 1008 · O(1)",
    ex4: "addr(4) = 1000 + 4×4 = 1016 · O(1)",
    note: "прыжок сразу к индексу 2 — без сканирования",
    caption:
      "Контракт: равные ячейки без зазоров — addr(i) = base + i × size. Одно умножение со сложением прыгает к любому элементу (здесь addr(2) = 1008), поэтому чтение — O(1) без сканирования.",
  },
};

const t = dict[lang];

const cells = [
  { v: "10", i: "0", a: "1000", x: 109 },
  { v: "20", i: "1", a: "1004", x: 227 },
  { v: "30", i: "2", a: "1008", x: 345 },
  { v: "40", i: "3", a: "1012", x: 463 },
  { v: "50", i: "4", a: "1016", x: 581 },
];
const CW = 110;
const CY = 110;
const CH = 80;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {cells.map((c) => (
      <g>
        <text x={c.x + CW / 2} y="100" text-anchor="middle" font-size="12" fill="var(--muted)">{t.idx} {c.i}</text>
        <rect
          x={c.x}
          y={CY}
          width={CW}
          height={CH}
          fill="var(--card)"
          stroke={c.i === "2" ? "var(--accent)" : "var(--ink)"}
          stroke-width={c.i === "2" ? 3 : 2}
        />
        <text x={c.x + CW / 2} y={CY + 52} text-anchor="middle" font-size="28" fill="var(--ink)">{c.v}</text>
        <text x={c.x + CW / 2} y={CY + CH + 26} text-anchor="middle" font-size="13" fill={c.i === "2" ? "var(--accent)" : "var(--muted)"}>{c.a}</text>
      </g>
    ))}

    <text x="400" y="268" text-anchor="middle" font-size="18" fill="var(--ink)">{t.formula}</text>
    <text x="400" y="298" text-anchor="middle" font-size="15" fill="var(--accent)">{t.ex2}</text>
    <text x="400" y="324" text-anchor="middle" font-size="15" fill="var(--muted)">{t.ex4}</text>
    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
