---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Two-pointer merge of sorted halves 1-3-5 and 2-4-6 into 1-2-3-4-5-6",
    headline: "WALK BOTH HALVES ONCE: TWO POINTERS",
    sub: "compare the fronts, take the smaller",
    left: "left",
    right: "right",
    result: "result",
    compare: "compare",
    cmp: "3 < 4",
    take: "take 3",
    formula: "left.length + right.length = O(n)",
    caption:
      "The merge step walks both sorted halves once with two pointers: compare the fronts, take the smaller. Total steps = left.length + right.length = O(n).",
  },
  ru: {
    svgTitle: "Слияние двумя указателями отсортированных половин 1-3-5 и 2-4-6 в 1-2-3-4-5-6",
    headline: "ПРОЙДИ ОБЕ ПОЛОВИНЫ ОДИН РАЗ",
    sub: "сравни начала, бери меньший",
    left: "левая",
    right: "правая",
    result: "результат",
    compare: "сравни",
    cmp: "3 < 4",
    take: "возьми 3",
    formula: "длина левой + длина правой = O(n)",
    caption:
      "Шаг слияния проходит обе отсортированные половины один раз двумя указателями: сравни начала, бери меньший. Всего шагов = длина левой + длина правой = O(n).",
  },
};

const t = dict[lang];

const leftVals = ["1", "3", "5"];
const rightVals = ["2", "4", "6"];
const resultVals = ["1", "2", "", "", "", ""];
const halfX = [288, 368, 448];
const resultX = [178, 254, 330, 406, 482, 558];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <!-- Left half -->
    <text x="260" y="135" text-anchor="end" font-size="13" fill="var(--ink)">{t.left}</text>
    {halfX.map((x, k) => (
      <g>
        <rect x={x} y="110" width="64" height="40" fill={k === 1 ? "var(--card)" : "none"} stroke="var(--ink)" stroke-width="2" />
        <text x={x + 32} y="137" text-anchor="middle" font-size="16" fill="var(--ink)">{leftVals[k]}</text>
      </g>
    ))}
    <!-- Pointer i at 3 -->
    <polygon points="400,154 393,167 407,167" fill="var(--accent)" />
    <text x="400" y="186" text-anchor="middle" font-size="13" fill="var(--accent)">i</text>

    <!-- Right half -->
    <text x="260" y="229" text-anchor="end" font-size="13" fill="var(--ink)">{t.right}</text>
    {halfX.map((x, k) => (
      <g>
        <rect x={x} y="204" width="64" height="40" fill={k === 1 ? "var(--card)" : "none"} stroke="var(--ink)" stroke-width="2" />
        <text x={x + 32} y="231" text-anchor="middle" font-size="16" fill="var(--ink)">{rightVals[k]}</text>
      </g>
    ))}
    <!-- Pointer j at 4 -->
    <polygon points="400,248 393,261 407,261" fill="var(--accent)" />
    <text x="400" y="280" text-anchor="middle" font-size="13" fill="var(--accent)">j</text>

    <!-- Compare box -->
    <rect x="570" y="110" width="170" height="96" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="655" y="134" text-anchor="middle" font-size="12" fill="var(--muted)">{t.compare}</text>
    <text x="655" y="160" text-anchor="middle" font-size="18" fill="var(--ink)">{t.cmp}</text>
    <text x="655" y="188" text-anchor="middle" font-size="14" fill="var(--accent)">→ {t.take}</text>

    <!-- Result so far -->
    <text x="150" y="324" text-anchor="end" font-size="13" fill="var(--ink)">{t.result}</text>
    {resultX.map((x, k) => (
      <g>
        <rect x={x} y="299" width="64" height="40" fill={resultVals[k] === "" ? "none" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={x + 32} y="326" text-anchor="middle" font-size="16" fill="var(--ink)">{resultVals[k]}</text>
      </g>
    ))}

    <text x="400" y="388" text-anchor="middle" font-size="14" fill="var(--muted)">{t.formula}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
