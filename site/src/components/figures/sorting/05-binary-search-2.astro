---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Sorted array where binary search works versus unsorted array where it fails",
    headline: "SORTED IS THE CONTRACT",
    sub: "no order, no search · every discard assumes the order",
    sortedTitle: "sorted ✓ · binary search works",
    sortedNote: "arr[mid] < target ⇒ target is on the right ✓",
    unsortedTitle: "unsorted ✗ · binary search fails",
    unsortedNote: "order broken ⇒ that inference is false ✗",
    note: "sort once O(n log n) → every search O(log n)",
    caption:
      "Sorted is the contract: every discard assumes arr[mid] < target means go right. On unsorted data that inference is false and the answer is wrong — no order, no search.",
  },
  ru: {
    svgTitle: "Отсортированный массив, где бинарный поиск работает, и неотсортированный, где он ломается",
    headline: "СОРТИРОВКА — ЭТО КОНТРАКТ",
    sub: "нет порядка — нет поиска · каждый отброс опирается на порядок",
    sortedTitle: "отсортировано ✓ · бинарный поиск работает",
    sortedNote: "arr[mid] < цели ⇒ цель справа ✓",
    unsortedTitle: "не отсортировано ✗ · бинарный поиск сломается",
    unsortedNote: "порядок сломан ⇒ этот вывод ложен ✗",
    note: "один раз O(n log n) → каждый поиск O(log n)",
    caption:
      "Отсортированность — это контракт: каждый отброс предполагает, что arr[mid] < цели означает идти вправо. На неотсортированных данных этот вывод ложен и ответ неверен — нет порядка, нет поиска.",
  },
};

const t = dict[lang];

const sorted = ["1", "3", "5", "7", "9", "11"];
const unsorted = ["3", "1", "7", "5", "11", "9"];
const cellW = 64;
const cellGap = 10;
const cellX0 = 183;
const cellH = 48;
const sortedTop = 128;
const unsortedTop = 260;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="112" text-anchor="middle" font-size="14" fill="var(--ink)">{t.sortedTitle}</text>
    {sorted.map((v, i) => (
        <g>
          <rect x={cellX0 + i * (cellW + cellGap)} y={sortedTop} width={cellW} height={cellH} rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
          <text x={cellX0 + i * (cellW + cellGap) + cellW / 2} y={sortedTop + 31} text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
        </g>
    ))}
    <text x="400" y="204" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sortedNote}</text>

    <text x="400" y="244" text-anchor="middle" font-size="14" fill="var(--ink)">{t.unsortedTitle}</text>
    {unsorted.map((v, i) => (
        <g>
          <rect x={cellX0 + i * (cellW + cellGap)} y={unsortedTop} width={cellW} height={cellH} rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
          <text x={cellX0 + i * (cellW + cellGap) + cellW / 2} y={unsortedTop + 31} text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
        </g>
    ))}
    <text x="400" y="336" text-anchor="middle" font-size="13" fill="var(--muted)">{t.unsortedNote}</text>

    <text x="400" y="390" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
