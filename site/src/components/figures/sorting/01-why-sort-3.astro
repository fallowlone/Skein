---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Sorted neighbor scan finds duplicates; median at index n over 2",
    headline: "DUPLICATES: SORT ONCE, SCAN NEIGHBORS",
    sub: "sort O(n log n) once · neighbor scan O(n)",
    rowUnsorted: "unsorted · O(n²)",
    rowSorted: "sorted · O(n)",
    sortLabel: "sort · O(n log n)",
    match: "arr[2]=5 vs arr[3]=5 — match ✓",
    median: "median at index n/2: O(1) direct access",
    many: "many queries on the same data → sort first ✓",
    single: "a single search is cheaper linear → don't sort",
    caption:
      "After sorting [5, 2, 5, 8, 1] → [1, 2, 5, 5, 8], the duplicate sits in adjacent cells and the median sits at index n/2. But reuse wins: sort first only when you query the same data again and again — a single search is cheaper linear.",
  },
  ru: {
    svgTitle: "Скан соседей находит дубликаты; медиана на индексе n пополам",
    headline: "ДУБЛИКАТЫ: ОТСОРТИРУЙ, СКАНИРУЙ СОСЕДЕЙ",
    sub: "сортировка O(n log n) один раз · скан соседей O(n)",
    rowUnsorted: "несортированный · O(n²)",
    rowSorted: "отсортированный · O(n)",
    sortLabel: "sort · O(n log n)",
    match: "arr[2]=5 vs arr[3]=5 — совпадение ✓",
    median: "медиана на индексе n/2: O(1) прямой доступ",
    many: "много запросов на одних данных → сортируй сначала ✓",
    single: "один поиск дешевле линейно → не сортируй",
    caption:
      "После сортировки [5, 2, 5, 8, 1] → [1, 2, 5, 5, 8] дубликат стоит в соседних ячейках, а медиана — на индексе n/2. Но выигрывает переиспользование: сортируй сначала, только когда опрашиваешь те же данные снова и снова, — один поиск дешевле линейно.",
  },
};

const t = dict[lang];

const before = ["5", "2", "5", "8", "1"];
const after = ["1", "2", "5", "5", "8"];
const pair = [2, 3];

const x0 = 330;
const cw = 54;
const ch = 46;
const step = 64;
const cellX = (i: number) => x0 + i * step;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="312" y="123" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowUnsorted}</text>
    {before.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="95" width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="123" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <line x1="485" y1="147" x2="485" y2="165" stroke="var(--accent)" stroke-width="2" />
    <polygon points="478,165 492,165 485,174" fill="var(--accent)" />
    <text x="497" y="164" font-size="12" fill="var(--ink)">{t.sortLabel}</text>

    <text x="312" y="203" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowSorted}</text>
    {after.map((v, i) => (
      <g>
        <rect
          x={cellX(i)}
          y="175"
          width={cw}
          height={ch}
          fill="var(--card)"
          stroke={pair.includes(i) ? "var(--accent)" : "var(--ink)"}
          stroke-width={pair.includes(i) ? 3 : 2}
        />
        <text x={cellX(i) + cw / 2} y="203" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="485" y="250" text-anchor="middle" font-size="13" fill="var(--ink)">{t.match}</text>
    <text x="400" y="294" text-anchor="middle" font-size="14" fill="var(--ink)">{t.median}</text>
    <text x="400" y="338" text-anchor="middle" font-size="14" fill="var(--ink)">{t.many}</text>
    <text x="400" y="368" text-anchor="middle" font-size="14" fill="var(--muted)">{t.single}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
