---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Merge sort cost: log n levels of O(n) work each, O(n) space, stable",
    headline: "LOG N LEVELS × O(N) PER LEVEL",
    sub: "always O(n log n) — never O(n²)",
    levelsTitle: "LEVELS",
    halve: "n → n/2 → n/4 → … → 1",
    logLevels: "log n levels",
    sixteen: "16 → 8 → 4 → 2 → 1",
    four: "= 4 halvings",
    workTitle: "WORK PER LEVEL",
    eachLevel: "O(n) every level",
    halves: "O(n/2) + O(n/2) = O(n)",
    quarters: "O(n/4) × 4 = O(n)",
    eachOnce: "each element once",
    spaceTitle: "SPACE + STABLE",
    fresh: "fresh array: O(n)",
    notInPlace: "not in-place",
    ties: "ties → left first",
    stable: "stable ✓",
    total: "log n × O(n) = O(n log n)",
    cases: "best = average = worst = O(n log n)",
    caption:
      "Halving gives log n levels of O(n) work each, so merge sort is O(n log n) in the best, average, and worst case. Ties break left-first (stable), but the merged result needs a fresh array: O(n) space, not in-place.",
  },
  ru: {
    svgTitle: "Цена сортировки слиянием: log n уровней работы по O(n), O(n) памяти, стабильно",
    headline: "LOG N УРОВНЕЙ × O(N) НА УРОВЕНЬ",
    sub: "всегда O(n log n) — никогда O(n²)",
    levelsTitle: "УРОВНИ",
    halve: "n → n/2 → n/4 → … → 1",
    logLevels: "log n уровней",
    sixteen: "16 → 8 → 4 → 2 → 1",
    four: "= 4 деления",
    workTitle: "РАБОТА НА УРОВЕНЬ",
    eachLevel: "O(n) каждый уровень",
    halves: "O(n/2) + O(n/2) = O(n)",
    quarters: "O(n/4) × 4 = O(n)",
    eachOnce: "каждый элемент — раз",
    spaceTitle: "ПАМЯТЬ + СТАБИЛЬНОСТЬ",
    fresh: "новый массив: O(n)",
    notInPlace: "не на месте",
    ties: "ничьи → влево первым",
    stable: "стабильно ✓",
    total: "log n × O(n) = O(n log n)",
    cases: "лучший = средний = худший = O(n log n)",
    caption:
      "Деление пополам даёт log n уровней работы по O(n), поэтому сортировка слиянием — O(n log n) в лучшем, среднем и худшем случае. Ничьи решаются влево первым (стабильно), но результат требует свежего массива: O(n) памяти, не на месте.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <!-- Levels panel -->
    <rect x="50" y="95" width="220" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="160" y="122" text-anchor="middle" font-size="12" fill="var(--ink)">{t.levelsTitle}</text>
    <text x="160" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.halve}</text>
    <text x="160" y="178" text-anchor="middle" font-size="12" fill="var(--muted)">{t.logLevels}</text>
    <text x="160" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sixteen}</text>
    <text x="160" y="238" text-anchor="middle" font-size="12" fill="var(--muted)">{t.four}</text>

    <!-- Work panel -->
    <rect x="290" y="95" width="220" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="122" text-anchor="middle" font-size="12" fill="var(--ink)">{t.workTitle}</text>
    <text x="400" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.eachLevel}</text>
    <text x="400" y="178" text-anchor="middle" font-size="12" fill="var(--muted)">{t.halves}</text>
    <text x="400" y="204" text-anchor="middle" font-size="12" fill="var(--muted)">{t.quarters}</text>
    <text x="400" y="238" text-anchor="middle" font-size="12" fill="var(--muted)">{t.eachOnce}</text>

    <!-- Space + stability panel -->
    <rect x="530" y="95" width="220" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="640" y="122" text-anchor="middle" font-size="12" fill="var(--ink)">{t.spaceTitle}</text>
    <text x="640" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fresh}</text>
    <text x="640" y="178" text-anchor="middle" font-size="12" fill="var(--muted)">{t.notInPlace}</text>
    <text x="640" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.ties}</text>
    <text x="640" y="238" text-anchor="middle" font-size="12" fill="var(--muted)">{t.stable}</text>

    <text x="400" y="330" text-anchor="middle" font-size="17" fill="var(--accent)">{t.total}</text>
    <text x="400" y="360" text-anchor="middle" font-size="13" fill="var(--muted)">{t.cases}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
