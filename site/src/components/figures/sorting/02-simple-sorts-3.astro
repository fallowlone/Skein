---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Selection, insertion, and bubble sort: worst case, best case, adaptivity, space",
    headline: "ALL THREE: O(n²) WORST CASE, O(1) SPACE",
    sub: "insertion is adaptive: O(n) on sorted input",
    colWorst: "worst",
    colBest: "best",
    colAdapt: "adaptive?",
    colSpace: "space",
    algos: ["selection", "insertion", "bubble"],
    worst: "O(n²)",
    best: ["O(n²)", "O(n)", "O(n)"],
    space: "O(1)",
    adapt: ["no", "yes", "yes*"],
    footnote: "* with optimization: a pass with no swaps means sorted",
    inplace: "all three: in-place, O(1)",
    caption:
      "All three sorts are O(n²) worst case and O(1) space, but only insertion and bubble adapt: on sorted input the while loop never runs — n checks, zero shifts — while selection still scans the whole suffix.",
  },
  ru: {
    svgTitle: "Выбор, вставка и пузырёк: худший и лучший случаи, адаптивность, память",
    headline: "ВСЕ ТРИ: O(n²) ХУДШИЙ СЛУЧАЙ, O(1) ПАМЯТЬ",
    sub: "вставка адаптивна: O(n) на отсортированном входе",
    colWorst: "худший",
    colBest: "лучший",
    colAdapt: "адаптивна?",
    colSpace: "память",
    algos: ["выбор", "вставка", "пузырёк"],
    worst: "O(n²)",
    best: ["O(n²)", "O(n)", "O(n)"],
    space: "O(1)",
    adapt: ["нет", "да", "да*"],
    footnote: "* с оптимизацией: проход без обменов — отсортировано",
    inplace: "все три: на месте, O(1)",
    caption:
      "Все три сортировки O(n²) в худшем и O(1) памяти, но адаптируются только вставка и пузырёк: на отсортированном входе цикл while не запускается — n проверок, ноль сдвигов — а выбор всё равно сканирует весь суффикс.",
  },
};

const t = dict[lang];

const headerY = 122;
const rows = [178, 243, 308];
const lines = [146, 211, 276, 341];
const colWorst = 345;
const colBest = 470;
const colAdapt = 605;
const colSpace = 725;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <g font-size="13" fill="var(--muted)">
      <text x={colWorst} y={headerY} text-anchor="middle">{t.colWorst}</text>
      <text x={colBest} y={headerY} text-anchor="middle">{t.colBest}</text>
      <text x={colAdapt} y={headerY} text-anchor="middle">{t.colAdapt}</text>
      <text x={colSpace} y={headerY} text-anchor="middle">{t.colSpace}</text>
    </g>

    {lines.map((y, i) => (
      <line x1="45" y1={y} x2="755" y2={y} stroke={i === 0 ? "var(--ink)" : "var(--muted)"} stroke-width={i === 0 ? 2 : 1} />
    ))}

    <rect x="45" y="219" width="710" height="49" rx="10" fill="none" stroke="var(--accent)" stroke-width="2" />

    {rows.map((y, i) => (
      <g font-size="15">
        <text x="60" y={y} fill="var(--ink)">{t.algos[i]}</text>
        <text x={colWorst} y={y} text-anchor="middle" fill="var(--ink)">{t.worst}</text>
        <text x={colBest} y={y} text-anchor="middle" fill="var(--ink)">{t.best[i]}</text>
        <text x={colAdapt} y={y} text-anchor="middle" fill="var(--ink)">{t.adapt[i]}</text>
        <text x={colSpace} y={y} text-anchor="middle" fill="var(--ink)">{t.space}</text>
      </g>
    ))}

    <text x="60" y="382" font-size="12" fill="var(--muted)">{t.footnote}</text>
    <text x="740" y="382" text-anchor="end" font-size="12" fill="var(--muted)">{t.inplace}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
