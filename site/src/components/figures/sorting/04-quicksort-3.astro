---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Extreme pivot chain: n levels of unbalanced partitions give O(n squared)",
    headline: "EXTREME PIVOT: n LEVELS → O(n²)",
    sub: "sorted input + naive pivot: one element per level",
    empty: "empty",
    shrink: "n, n-1, n-2, …",
    total: "total: n + (n-1) + … + 1",
    cost: "= n(n+1)/2 = O(n²)",
    fix: "fix: random pivot or median-of-three",
    caption:
      "An always-min-or-max pivot gives n levels of O(n): sorted input plus a naive pivot is the classic O(n²) trap — use a random pivot or median-of-three.",
  },
  ru: {
    svgTitle: "Цепочка крайних стержней: n уровней несбалансированных разделов дают O(n в квадрате)",
    headline: "КРАЙНИЙ СТЕРЖЕНЬ: n УРОВНЕЙ → O(n²)",
    sub: "отсортированный вход + наивный стержень: один элемент на уровень",
    empty: "пусто",
    shrink: "n, n-1, n-2, …",
    total: "итого: n + (n-1) + … + 1",
    cost: "= n(n+1)/2 = O(n²)",
    fix: "бери случайный или median-of-three",
    caption:
      "Стержень всегда минимум или максимум даёт n уровней по O(n): отсортированный вход плюс наивный стержень — классическая ловушка O(n²), бери случайный или median-of-three.",
  },
};

const t = dict[lang];

const chainX = 220;
const boxW = 96;
const boxH = 38;
const chainY = [132, 204, 276, 348];
const chainLabels = ["n", "n-1", "n-2", "… 1"];
const stubX = 92;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={stubX} y="102" text-anchor="middle" font-size="12" fill="var(--muted)">{t.empty}</text>
    {chainY.map((y, i) => (
      <g>
        <line
          x1={chainX - boxW / 2}
          y1={y}
          x2={stubX + 16}
          y2={y}
          stroke="var(--muted)"
          stroke-width="2"
          stroke-dasharray="5 4"
        />
        <circle cx={stubX} cy={y} r="14" fill="none" stroke="var(--muted)" stroke-width="2" stroke-dasharray="5 4" />
        <text x={stubX} y={y + 5} text-anchor="middle" font-size="13" fill="var(--muted)">∅</text>
        <rect
          x={chainX - boxW / 2}
          y={y - boxH / 2}
          width={boxW}
          height={boxH}
          fill="var(--card)"
          stroke="var(--ink)"
          stroke-width="2"
        />
        <text x={chainX} y={y + 5} text-anchor="middle" font-size="14" fill="var(--ink)">{chainLabels[i]}</text>
      </g>
    ))}
    {chainY.slice(0, 3).map((y) => (
      <g>
        <line x1={chainX} y1={y + boxH / 2 + 2} x2={chainX} y2={y + 72 - boxH / 2 - 4} stroke="var(--ink)" stroke-width="2" />
        <polygon points={`${chainX},${y + 72 - boxH / 2 - 2} ${chainX - 7},${y + 72 - boxH / 2 - 14} ${chainX + 7},${y + 72 - boxH / 2 - 14}`} fill="var(--ink)" />
      </g>
    ))}

    <line x1="340" y1="96" x2="340" y2="384" stroke="var(--muted)" stroke-width="1" />

    <text x="380" y="150" font-size="15" fill="var(--muted)">{t.shrink}</text>
    <text x="380" y="208" font-size="15" fill="var(--ink)">{t.total}</text>
    <text x="380" y="240" font-size="15" fill="var(--ink)">{t.cost}</text>
    <line x1="380" y1="272" x2="740" y2="272" stroke="var(--muted)" stroke-width="1" />
    <text x="380" y="312" font-size="15" fill="var(--accent)">{t.fix}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
