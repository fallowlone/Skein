---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Balanced partitions halve the work each level: log n levels of O(n)",
    headline: "BALANCED SPLITS: log n LEVELS × O(n)",
    sub: "pivot near the middle halves the work each level",
    level: "level",
    perLevel: "O(n)",
    total: "log n levels × O(n) = O(n log n)",
    caption:
      "A pivot near the middle halves the work each level: log n levels × O(n) = O(n log n) average.",
  },
  ru: {
    svgTitle: "Сбалансированные разделы вдвое уменьшают работу: log n уровней по O(n)",
    headline: "СБАЛАНСИРОВАННЫЕ РАЗДЕЛЫ: log n УРОВНЕЙ × O(n)",
    sub: "стержень у середины вдвое уменьшает работу на каждом уровне",
    level: "уровень",
    perLevel: "O(n)",
    total: "log n уровней × O(n) = O(n log n)",
    caption:
      "Стержень у середины вдвое уменьшает работу на каждом уровне: log n уровней × O(n) = O(n log n) в среднем.",
  },
};

const t = dict[lang];

const boxW = 64;
const boxH = 38;
const rows = [
  { y: 118, centers: [400], labels: ["n"] },
  { y: 206, centers: [280, 520], labels: ["n/2", "n/2"] },
  { y: 294, centers: [200, 360, 440, 600], labels: ["n/4", "n/4", "n/4", "n/4"] },
];
const edges: Array<[[number, number], [number, number]]> = [
  [[400, 118], [280, 206]],
  [[400, 118], [520, 206]],
  [[280, 206], [200, 294]],
  [[280, 206], [360, 294]],
  [[520, 206], [440, 294]],
  [[520, 206], [600, 294]],
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {edges.map(([[x1, y1], [x2, y2]]) => (
      <line
        x1={x1}
        y1={y1 + boxH / 2}
        x2={x2}
        y2={y2 - boxH / 2}
        stroke="var(--ink)"
        stroke-width="2"
      />
    ))}

    {rows.map((row, r) => (
      <g>
        <text x="72" y={row.y + 5} text-anchor="middle" font-size="13" fill="var(--muted)">{t.level} {r + 1}</text>
        {row.centers.map((x, i) => (
          <g>
            <rect
              x={x - boxW / 2}
              y={row.y - boxH / 2}
              width={boxW}
              height={boxH}
              fill="var(--card)"
              stroke="var(--ink)"
              stroke-width="2"
            />
            <text x={x} y={row.y + 5} text-anchor="middle" font-size="14" fill="var(--ink)">{row.labels[i]}</text>
          </g>
        ))}
        <text x="728" y={row.y + 5} text-anchor="middle" font-size="13" fill="var(--muted)">{t.perLevel}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="14" fill="var(--ink)">{t.total}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
