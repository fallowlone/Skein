---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Linear search versus binary search on one million elements",
    headline: "1 MILLION ELEMENTS: LINEAR VS BINARY",
    sub: "linear search O(n) · binary search O(log n)",
    rowLinear: "linear O(n)",
    rowBinary: "binary O(log n)",
    barLinear: "~500,000 comparisons (average)",
    barBinary: "~20 comparisons",
    speedup: "25,000× SPEEDUP",
    note: "cut the search space in half each step",
    caption:
      "On 1 million elements, linear search averages ~500,000 comparisons while binary search needs ~20 — a 25,000× speedup. Takeaway: one O(n log n) sort turns every later search into O(log n).",
  },
  ru: {
    svgTitle: "Линейный поиск против бинарного на миллионе элементов",
    headline: "1 МИЛЛИОН ЭЛЕМЕНТОВ: ЛИНЕЙНЫЙ И БИНАРНЫЙ",
    sub: "линейный поиск O(n) · бинарный поиск O(log n)",
    rowLinear: "линейный O(n)",
    rowBinary: "бинарный O(log n)",
    barLinear: "~500 000 сравнений (в среднем)",
    barBinary: "~20 сравнений",
    speedup: "УСКОРЕНИЕ В 25 000 РАЗ",
    note: "режь пространство поиска пополам каждый шаг",
    caption:
      "На 1 миллионе элементов линейный поиск делает ~500 000 сравнений в среднем, а бинарный — ~20: ускорение в 25 000 раз. Вывод: один sort за O(n log n) превращает каждый следующий поиск в O(log n).",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="215" y="155" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowLinear}</text>
    <rect x="235" y="124" width="500" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="485" y="156" text-anchor="middle" font-size="14" fill="var(--ink)">{t.barLinear}</text>

    <text x="215" y="245" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowBinary}</text>
    <rect x="235" y="214" width="22" height="52" fill="var(--accent)" stroke="var(--accent)" stroke-width="2" />
    <text x="270" y="246" font-size="14" fill="var(--ink)">{t.barBinary}</text>

    <text x="400" y="340" text-anchor="middle" font-family="var(--font-display)" font-size="30" fill="var(--accent)">{t.speedup}</text>
    <text x="400" y="382" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
