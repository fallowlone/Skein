---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Halving trace of the capacity bracket from [10, 55] down to the answer [15, 15]",
    headline: "BRACKET THE FLIP, THEN HALVE",
    sub: "each mid asks canShipInDays and keeps the half holding the flip",
    colBracket: "bracket",
    colSpace: "answer space 10 → 55",
    colCheck: "mid check",
    answer: "lo=15=hi · answer 15 ★",
    rule: "feasible → hi = mid (smaller may work) · infeasible → lo = mid + 1",
    caption:
      "The range is lo < hi: a feasible mid keeps hi = mid since a smaller answer may work; an infeasible mid sets lo = mid + 1. They meet exactly on the flip at 15.",
  },
  ru: {
    svgTitle: "Трассировка сужения отрезка грузоподъёмности от [10, 55] до ответа [15, 15]",
    headline: "ЗАЖМИ ПЕРЕКЛЮЧЕНИЕ, ПОТОМ ДЕЛИ",
    sub: "каждый mid спрашивает canShipInDays и оставляет половину с переключением",
    colBracket: "отрезок",
    colSpace: "пространство ответов 10 → 55",
    colCheck: "проверка mid",
    answer: "lo=15=hi · ответ 15 ★",
    rule: "выполнимо → hi = mid (может сработать меньше) · невыполнимо → lo = mid + 1",
    caption:
      "Диапазон — это lo < hi: выполнимый mid оставляет hi = mid, ведь меньший ответ может сработать; невыполнимый ставит lo = mid + 1. Они встречаются ровно на переходе — 15.",
  },
};

const t = dict[lang];

const trackX0 = 180;
const trackX1 = 520;
const pos = (v: number) => trackX0 + ((v - 10) * (trackX1 - trackX0)) / 45;

const rows = [
  { lo: 10, hi: 55, mid: 32, note: "mid=32 · 2 ≤ 5 ✓ · hi=32" },
  { lo: 10, hi: 32, mid: 21, note: "mid=21 · 3 ≤ 5 ✓ · hi=21" },
  { lo: 10, hi: 21, mid: 15, note: "mid=15 · 5 ≤ 5 ✓ · hi=15" },
  { lo: 10, hi: 15, mid: 12, note: "mid=12 · 6 > 5 ✗ · lo=13" },
  { lo: 13, hi: 15, mid: 14, note: "mid=14 · 6 > 5 ✗ · lo=15" },
];
const rowY0 = 122;
const rowStep = 40;
const answerY = rowY0 + 5 * rowStep;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="60" y="94" font-size="12" fill="var(--muted)">{t.colBracket}</text>
    <text x="350" y="94" text-anchor="middle" font-size="12" fill="var(--muted)">{t.colSpace}</text>
    <text x="545" y="94" font-size="12" fill="var(--muted)">{t.colCheck}</text>

    {rows.map((r, i) => (
      <g>
        <text x="60" y={rowY0 + i * rowStep + 5} font-size="14" fill="var(--ink)">[{r.lo}, {r.hi}]</text>
        <line x1={trackX0} y1={rowY0 + i * rowStep} x2={trackX1} y2={rowY0 + i * rowStep} stroke="var(--muted)" stroke-width="1" />
        <line x1={pos(r.lo)} y1={rowY0 + i * rowStep} x2={pos(r.hi)} y2={rowY0 + i * rowStep} stroke="var(--ink)" stroke-width="5" stroke-linecap="round" />
        <line x1={pos(r.mid)} y1={rowY0 + i * rowStep - 9} x2={pos(r.mid)} y2={rowY0 + i * rowStep + 9} stroke="var(--accent)" stroke-width="2" />
        <text x="545" y={rowY0 + i * rowStep + 4} font-size="12" fill="var(--ink)">{r.note}</text>
      </g>
    ))}
    <g>
      <text x="60" y={answerY + 5} font-size="14" fill="var(--ink)">[15, 15]</text>
      <line x1={trackX0} y1={answerY} x2={trackX1} y2={answerY} stroke="var(--muted)" stroke-width="1" />
      <circle cx={pos(15)} cy={answerY} r="7" fill="var(--accent)" />
      <text x="545" y={answerY + 4} font-size="12" fill="var(--accent)">{t.answer}</text>
    </g>

    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rule}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
