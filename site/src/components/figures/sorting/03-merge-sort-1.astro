---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Merge sort on four elements: divide down to singletons, merge back up sorted",
    headline: "DIVIDE DOWN, MERGE UP",
    sub: "split in half to singletons, merge pairs back up",
    divide: "divide",
    merge: "merge",
    mid: "mid = 2",
    single: "len ≤ 1: sorted",
    note: "singletons merge pairwise back up",
    caption:
      "Divide and conquer on [38, 27, 43, 3]: split in half down to singletons — already sorted — then merge pairs back up to [3, 27, 38, 43]. Every level touches all n elements once.",
  },
  ru: {
    svgTitle: "Сортировка слиянием на четырёх элементах: раздели вниз до одиночек, слей вверх",
    headline: "РАЗДЕЛИ ВНИЗ, ОБЪЕДИНИ ВВЕРХ",
    sub: "дели пополам до одиночек, сливай пары вверх",
    divide: "раздели",
    merge: "слияние",
    mid: "mid = 2",
    single: "размер ≤ 1: готов",
    note: "одиночки сливаются попарно вверх",
    caption:
      "Раздели и властвуй на [38, 27, 43, 3]: дели пополам до одиночек — они уже отсортированы — потом сливай пары обратно вверх до [3, 27, 38, 43]. Каждый уровень трогает все n элементов один раз.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <!-- Row 1: full array -->
    <rect x="250" y="95" width="300" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="116" text-anchor="middle" font-size="14" fill="var(--ink)">[38, 27, 43, 3]</text>

    <!-- Row 2: halves -->
    <rect x="170" y="145" width="180" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="260" y="166" text-anchor="middle" font-size="14" fill="var(--ink)">[38, 27]</text>
    <rect x="450" y="145" width="180" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="540" y="166" text-anchor="middle" font-size="14" fill="var(--ink)">[43, 3]</text>

    <!-- Row 3: singletons -->
    <rect x="150" y="195" width="110" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="205" y="216" text-anchor="middle" font-size="14" fill="var(--ink)">[38]</text>
    <rect x="280" y="195" width="110" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="335" y="216" text-anchor="middle" font-size="14" fill="var(--ink)">[27]</text>
    <rect x="410" y="195" width="110" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="465" y="216" text-anchor="middle" font-size="14" fill="var(--ink)">[43]</text>
    <rect x="540" y="195" width="110" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="595" y="216" text-anchor="middle" font-size="14" fill="var(--ink)">[3]</text>

    <!-- Row 4: merged pairs -->
    <rect x="170" y="255" width="180" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="260" y="276" text-anchor="middle" font-size="14" fill="var(--ink)">[27, 38]</text>
    <rect x="450" y="255" width="180" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="540" y="276" text-anchor="middle" font-size="14" fill="var(--ink)">[3, 43]</text>

    <!-- Row 5: fully sorted -->
    <rect x="250" y="315" width="300" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="336" text-anchor="middle" font-size="14" fill="var(--ink)">[3, 27, 38, 43]</text>

    <!-- Divide connectors -->
    <line x1="330" y1="125" x2="260" y2="145" stroke="var(--ink)" stroke-width="2" />
    <line x1="470" y1="125" x2="540" y2="145" stroke="var(--ink)" stroke-width="2" />
    <line x1="215" y1="175" x2="205" y2="195" stroke="var(--ink)" stroke-width="2" />
    <line x1="305" y1="175" x2="335" y2="195" stroke="var(--ink)" stroke-width="2" />
    <line x1="495" y1="175" x2="465" y2="195" stroke="var(--ink)" stroke-width="2" />
    <line x1="585" y1="175" x2="595" y2="195" stroke="var(--ink)" stroke-width="2" />

    <!-- Merge connectors -->
    <line x1="205" y1="225" x2="215" y2="255" stroke="var(--accent)" stroke-width="2" />
    <line x1="335" y1="225" x2="305" y2="255" stroke="var(--accent)" stroke-width="2" />
    <line x1="465" y1="225" x2="495" y2="255" stroke="var(--accent)" stroke-width="2" />
    <line x1="595" y1="225" x2="585" y2="255" stroke="var(--accent)" stroke-width="2" />
    <line x1="260" y1="285" x2="330" y2="315" stroke="var(--accent)" stroke-width="2" />
    <line x1="540" y1="285" x2="470" y2="315" stroke="var(--accent)" stroke-width="2" />

    <!-- Side labels -->
    <text x="60" y="140" text-anchor="middle" font-size="12" fill="var(--muted)">{t.divide}</text>
    <text x="60" y="190" text-anchor="middle" font-size="12" fill="var(--muted)">{t.divide}</text>
    <text x="60" y="248" text-anchor="middle" font-size="12" fill="var(--muted)">{t.merge}</text>
    <text x="60" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.merge}</text>
    <text x="705" y="140" text-anchor="middle" font-size="12" fill="var(--muted)">{t.mid}</text>
    <text x="705" y="190" text-anchor="middle" font-size="12" fill="var(--muted)">{t.single}</text>

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
