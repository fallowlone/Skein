---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Insertion sort on 5, 3, 4, 1: the sorted prefix grows one key per pass",
    headline: "INSERTION SORT ON [5, 3, 4, 1]: PREFIX GROWS",
    sub: "each pass: shift larger elements right, drop the key in",
    rows: ["start", "key 3", "key 4", "key 1"],
    annos: ["prefix [5]", "1 comparison", "2 comparisons", "3 comparisons · 6 total"],
    legPrefix: "sorted prefix",
    legUnsorted: "unsorted",
    legKey: "key",
    caption:
      "Insertion sort grows a sorted prefix one key per pass — on [5, 3, 4, 1] key 3 shifts 5 right, key 4 shifts 5 right, then key 1 shifts 3, 4, 5 right: O(n²) worst case, O(n) when the input is already sorted.",
  },
  ru: {
    svgTitle: "Сортировка вставкой на 5, 3, 4, 1: префикс растёт по ключу за проход",
    headline: "ВСТАВКА НА [5, 3, 4, 1]: ПРЕФИКС РАСТЁТ",
    sub: "каждый проход: сдвинь большие вправо, вставь ключ",
    rows: ["начало", "ключ 3", "ключ 4", "ключ 1"],
    annos: ["префикс [5]", "1 сравнение", "2 сравнения", "3 сравнения · всего 6"],
    legPrefix: "префикс",
    legUnsorted: "неотсортированное",
    legKey: "ключ",
    caption:
      "Вставка растит отсортированный префикс по ключу за проход — на [5, 3, 4, 1] ключ 3 сдвигает 5 вправо, ключ 4 сдвигает 5 вправо, потом ключ 1 сдвигает 3, 4, 5 вправо: O(n²) в худшем, O(n) когда вход уже отсортирован.",
  },
};

const t = dict[lang];

const grid = [
  { values: ["5", "3", "4", "1"], prefix: 1, key: 1 },
  { values: ["3", "5", "4", "1"], prefix: 2, key: 2 },
  { values: ["3", "4", "5", "1"], prefix: 3, key: 3 },
  { values: ["1", "3", "4", "5"], prefix: 4, key: -1 },
];

// Cell geometry: 4 cells of 56px + 10px gaps, starting at x=273.
const cellX = [273, 339, 405, 471];
const rowTop = [100, 165, 230, 295];
const cellW = 56;
const cellH = 50;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {grid.map((row, r) => (
      <g>
        <text x="255" y={rowTop[r] + 33} text-anchor="end" font-size="14" fill="var(--ink)">{t.rows[r]}</text>
        {row.values.map((v, c) => (
          <g>
            <rect
              x={cellX[c]}
              y={rowTop[r]}
              width={cellW}
              height={cellH}
              rx="8"
              fill={c < row.prefix ? "var(--accent)" : "var(--card)"}
              stroke={c === row.key ? "var(--ink)" : c < row.prefix ? "var(--accent)" : "var(--muted)"}
              stroke-width={c === row.key ? 3 : 2}
            />
            <text
              x={cellX[c] + cellW / 2}
              y={rowTop[r] + 34}
              text-anchor="middle"
              font-size="20"
              fill={c < row.prefix ? "var(--card)" : "var(--ink)"}
            >{v}</text>
          </g>
        ))}
        <text x="545" y={rowTop[r] + 33} font-size="13" fill="var(--muted)">{t.annos[r]}</text>
      </g>
    ))}

    <g font-size="13" fill="var(--muted)">
      <rect x="150" y="366" width="14" height="14" rx="3" fill="var(--accent)" />
      <text x="170" y="378">{t.legPrefix}</text>
      <rect x="330" y="366" width="14" height="14" rx="3" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="350" y="378">{t.legUnsorted}</text>
      <rect x="560" y="366" width="14" height="14" rx="3" fill="var(--card)" stroke="var(--ink)" stroke-width="3" />
      <text x="580" y="378">{t.legKey}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
