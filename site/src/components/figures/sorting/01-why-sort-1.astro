---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Unsorted array sorted into ascending and descending order",
    headline: "SORTED: EACH ELEMENT ≤ NEXT",
    sub: "ascending: each ≤ next · descending: each ≥ next",
    rowUnsorted: "unsorted",
    rowAscending: "ascending",
    rowDescending: "descending",
    sortLabel: "sort · O(n log n)",
    note: "the order is fixed — you can rely on it",
    caption:
      "Sorted means each element ≤ next: [3, 1, 4, 1, 5, 9, 2, 6] becomes [1, 1, 2, 3, 4, 5, 6, 9] ascending or [9, 6, 5, 4, 3, 2, 1, 1] descending. That fixed order is the structure one O(n log n) sort buys for every later query.",
  },
  ru: {
    svgTitle: "Несортированный массив, отсортированный по возрастанию и по убыванию",
    headline: "ОТСОРТИРОВАНО: КАЖДЫЙ ЭЛЕМЕНТ ≤ СЛЕДУЮЩЕГО",
    sub: "по возрастанию: каждый ≤ следующего · по убыванию: каждый ≥ следующего",
    rowUnsorted: "несортированный",
    rowAscending: "по возрастанию",
    rowDescending: "по убыванию",
    sortLabel: "sort · O(n log n)",
    note: "порядок зафиксирован — на него можно полагаться",
    caption:
      "Отсортировано — значит каждый элемент ≤ следующего: [3, 1, 4, 1, 5, 9, 2, 6] становится [1, 1, 2, 3, 4, 5, 6, 9] по возрастанию или [9, 6, 5, 4, 3, 2, 1, 1] по убыванию. Этот зафиксированный порядок — структура, которую один sort за O(n log n) покупает для каждого следующего запроса.",
  },
};

const t = dict[lang];

const unsorted = ["3", "1", "4", "1", "5", "9", "2", "6"];
const ascending = ["1", "1", "2", "3", "4", "5", "6", "9"];
const descending = ["9", "6", "5", "4", "3", "2", "1", "1"];
const gaps = [0, 1, 2, 3, 4, 5, 6];

const x0 = 270;
const cw = 52;
const ch = 48;
const step = 64;
const cellX = (i: number) => x0 + i * step;
const gapX = (i: number) => x0 + i * step + cw + 6;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="252" y="145" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowUnsorted}</text>
    {unsorted.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="116" width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="145" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <line x1="520" y1="170" x2="520" y2="194" stroke="var(--accent)" stroke-width="2" />
    <polygon points="513,194 527,194 520,204" fill="var(--accent)" />
    <text x="532" y="190" font-size="12" fill="var(--ink)">{t.sortLabel}</text>

    <text x="252" y="235" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowAscending}</text>
    {ascending.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="206" width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="235" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {gaps.map((i) => (
      <text x={gapX(i)} y="235" text-anchor="middle" font-size="12" fill="var(--muted)">≤</text>
    ))}

    <text x="252" y="325" text-anchor="end" font-size="13" fill="var(--ink)">{t.rowDescending}</text>
    {descending.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="296" width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="325" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {gaps.map((i) => (
      <text x={gapX(i)} y="325" text-anchor="middle" font-size="12" fill="var(--muted)">≥</text>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
