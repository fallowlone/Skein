---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Binary search for 13 in sorted 1, 3, 5, 7, 9, 11, 13: range shrinks 7 to 3 to 1 in 3 probes",
    headline: "CHECK MID, THROW AWAY HALF, REPEAT",
    sub: "target 13 in sorted [1, 3, 5, 7, 9, 11, 13]",
    step1: "step 1",
    step2: "step 2",
    step3: "step 3",
    range7: "range 7",
    probe1: "mid 7<13 → lo=4",
    range3: "range 3",
    probe2: "mid 11<13 → lo=6",
    found: "found ✓",
    ret: "return 6",
    lohi: "lo = hi = mid",
    note: "7 → 3 → 1 candidates in 3 probes · O(log n)",
    caption:
      "Binary search keeps bounds [lo, hi], checks the middle, and discards the half that cannot hold the target. Here 7 candidates collapse to 1 in 3 probes — O(log n) on sorted data.",
  },
  ru: {
    svgTitle: "Бинарный поиск 13 в отсортированном 1, 3, 5, 7, 9, 11, 13: диапазон сжимается 7 до 3 до 1 за 3 опроса",
    headline: "ПРОВЕРЬ MID, ВЫБРОСЬ ПОЛОВИНУ, ПОВТОРИ",
    sub: "цель 13 в отсортированном [1, 3, 5, 7, 9, 11, 13]",
    step1: "шаг 1",
    step2: "шаг 2",
    step3: "шаг 3",
    range7: "диапазон 7",
    probe1: "mid 7<13 → lo=4",
    range3: "диапазон 3",
    probe2: "mid 11<13 → lo=6",
    found: "найдено ✓",
    ret: "верни 6",
    lohi: "lo = hi = mid",
    note: "7 → 3 → 1 кандидат за 3 опроса · O(log n)",
    caption:
      "Бинарный поиск держит границы [lo, hi], проверяет середину и отбрасывает половину, где цели быть не может. Здесь 7 кандидатов схлопываются в один за 3 опроса — O(log n) на отсортированных данных.",
  },
};

const t = dict[lang];

const cells = ["1", "3", "5", "7", "9", "11", "★13"];
const cellW = 54;
const cellGap = 8;
const cellX0 = 200;
const cellH = 44;
// Live index ranges per row: [0,6] -> [4,6] -> [6,6]; mid index per row.
const rows = [
  { top: 100, lo: 0, hi: 6, mid: 3 },
  { top: 190, lo: 4, hi: 6, mid: 5 },
  { top: 280, lo: 6, hi: 6, mid: 6 },
];
const cx = (i: number) => cellX0 + i * (cellW + cellGap) + cellW / 2;
// Precomputed tiles: block-body callbacks inside markup are not supported by the Astro compiler.
const tiles = rows.map((r) =>
  cells.map((v, i) => {
    const live = i >= r.lo && i <= r.hi;
    const hot = i === r.mid;
    return {
      v,
      x: cellX0 + i * (cellW + cellGap),
      top: r.top,
      live,
      stroke: hot ? "var(--accent)" : live ? "var(--ink)" : "var(--muted)",
      sw: hot ? 3 : 2,
    };
  })
);
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="188" y="129" text-anchor="end" font-size="13" fill="var(--muted)">{t.step1}</text>
    <text x="188" y="219" text-anchor="end" font-size="13" fill="var(--muted)">{t.step2}</text>
    <text x="188" y="309" text-anchor="end" font-size="13" fill="var(--muted)">{t.step3}</text>

    {tiles.map((row) => (
      <g>
        {row.map((c) => (
            <g>
              <rect
                x={c.x}
                y={c.top}
                width={cellW}
                height={cellH}
                rx="6"
                fill={c.live ? "var(--card)" : "none"}
                stroke={c.stroke}
                stroke-width={c.sw}
                stroke-dasharray={c.live ? "none" : "5 4"}
              />
              <text
                x={c.x + cellW / 2}
                y={c.top + 29}
                text-anchor="middle"
                font-size="14"
                fill={c.live ? "var(--ink)" : "var(--muted)"}
              >{c.v}</text>
            </g>
        ))}
      </g>
    ))}

    <text x={cx(0)} y="162" text-anchor="middle" font-size="12" fill="var(--muted)">lo</text>
    <text x={cx(3)} y="162" text-anchor="middle" font-size="12" fill="var(--ink)">mid</text>
    <text x={cx(6)} y="162" text-anchor="middle" font-size="12" fill="var(--muted)">hi</text>

    <text x={cx(4)} y="252" text-anchor="middle" font-size="12" fill="var(--muted)">lo</text>
    <text x={cx(5)} y="252" text-anchor="middle" font-size="12" fill="var(--ink)">mid</text>
    <text x={cx(6)} y="252" text-anchor="middle" font-size="12" fill="var(--muted)">hi</text>

    <text x={cx(6)} y="342" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lohi}</text>

    <text x="644" y="118" font-size="12" fill="var(--muted)">{t.range7}</text>
    <text x="644" y="136" font-size="12" fill="var(--ink)">{t.probe1}</text>
    <text x="644" y="208" font-size="12" fill="var(--muted)">{t.range3}</text>
    <text x="644" y="226" font-size="12" fill="var(--ink)">{t.probe2}</text>
    <text x="644" y="298" font-size="12" fill="var(--ink)">{t.found}</text>
    <text x="644" y="316" font-size="12" fill="var(--muted)">{t.ret}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
