---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Monotone feasibility strip for ship capacity: infeasible below 15, feasible at 15 and above",
    headline: "MONOTONE FLIP AT 15",
    sub: "below 15 infeasible · at 15 and above feasible",
    leftZone: "infeasible · below 15",
    rightZone: "feasible · 15 and above",
    no: "false",
    yes: "true",
    flip: "flip at 15",
    pattern: "false … false │ true … true — flips once, then stays true",
    context: "weights 1..10 · 5 days · range [10, 55] = 45 candidates",
    bounds: "lo = heaviest package = 10 · hi = sum of weights = 55",
    caption:
      "Monotone or nothing: below 15 infeasible, at 15 and above feasible — once feasible(x) flips to true it stays true. Without a single flip the halves carry no information and binary search lies.",
  },
  ru: {
    svgTitle: "Монотонная полоса выполнимости грузоподъёмности: ниже 15 невыполнимо, на 15 и выше выполнимо",
    headline: "МОНОТОННЫЙ ПЕРЕХОД НА 15",
    sub: "ниже 15 невыполнимо · на 15 и выше выполнимо",
    leftZone: "невыполнимо · ниже 15",
    rightZone: "выполнимо · 15 и выше",
    no: "ложь",
    yes: "истина",
    flip: "переключение на 15",
    pattern: "ложь … ложь │ истина … истина — переход один, дальше истина",
    context: "веса 1..10 · 5 дней · диапазон [10, 55] = 45 кандидатов",
    bounds: "lo = самый тяжёлый пакет = 10 · hi = сумма весов = 55",
    caption:
      "Монотонно или никак: ниже 15 невыполнимо, на 15 и выше выполнимо — раз выполнимо(x) переключилось на истину, оно остаётся истиной. Без одного перехода половины не несут информации, и бинарный поиск врёт.",
  },
};

const t = dict[lang];

const cells = [
  { v: "10", ok: false },
  { v: "12", ok: false },
  { v: "14", ok: false },
  { v: "15 ★", ok: true, answer: true },
  { v: "21", ok: true },
  { v: "32", ok: true },
  { v: "55", ok: true },
];
const cellW = 92;
const cellGap = 8;
const cellX0 = 54;
const cellY = 112;
const cellH = 84;
const boundaryX = cellX0 + 3 * (cellW + cellGap) - cellGap / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="100" text-anchor="middle" font-size="13" fill="var(--muted)">{t.leftZone}</text>
    <text x="550" y="100" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rightZone}</text>

    {cells.map((c, i) => (
      <g>
        <rect
          x={cellX0 + i * (cellW + cellGap)}
          y={cellY}
          width={cellW}
          height={cellH}
          fill="var(--card)"
          stroke={c.answer ? "var(--accent)" : "var(--ink)"}
          stroke-width={c.answer ? 3 : 2}
        />
        <text x={cellX0 + i * (cellW + cellGap) + cellW / 2} y={cellY + 36} text-anchor="middle" font-size="18" fill={c.answer ? "var(--accent)" : "var(--ink)"}>{c.v}</text>
        <text x={cellX0 + i * (cellW + cellGap) + cellW / 2} y={cellY + 64} text-anchor="middle" font-size="12" fill="var(--muted)">{c.ok ? t.yes : t.no}</text>
      </g>
    ))}
    <line x1={boundaryX} y1={cellY - 6} x2={boundaryX} y2={cellY + cellH + 6} stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 4" />
    <text x={boundaryX} y={cellY + cellH + 32} text-anchor="middle" font-size="13" fill="var(--accent)">{t.flip}</text>

    <text x="400" y="282" text-anchor="middle" font-size="14" fill="var(--ink)">{t.pattern}</text>
    <text x="400" y="320" text-anchor="middle" font-size="13" fill="var(--muted)">{t.context}</text>
    <text x="400" y="356" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bounds}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
