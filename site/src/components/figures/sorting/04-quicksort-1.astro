---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One partition on 3, 7, 2, 9, 5, 1, 6 parks pivot 5 in its final slot",
    headline: "PIVOT 5 PARKS IN ITS FINAL SLOT",
    sub: "one O(n) partition: smaller left, larger right",
    before: "before",
    pivotTag: "pivot 5",
    after: "after",
    smaller: "smaller < 5",
    pivotFinal: "pivot final",
    larger: "larger > 5",
    note: "left [3,2,1] · right [7,9,6] — recurse both sides",
    caption:
      "One O(n) partition on [3, 7, 2, 9, 5, 1, 6] parks pivot 5 in its final slot — smaller values left, larger right — splitting the sort into two independent subproblems, [3, 2, 1] and [7, 9, 6].",
  },
  ru: {
    svgTitle: "Один проход partition на 3, 7, 2, 9, 5, 1, 6 ставит стержень 5 в финальный слот",
    headline: "СТЕРЖЕНЬ 5 ВСТАЁТ В ФИНАЛЬНЫЙ СЛОТ",
    sub: "один проход partition за O(n): меньшие слева, большие справа",
    before: "до",
    pivotTag: "стержень 5",
    after: "после",
    smaller: "меньше < 5",
    pivotFinal: "стержень финально",
    larger: "больше > 5",
    note: "слева [3,2,1] · справа [7,9,6] — рекурсия в обе стороны",
    caption:
      "Один проход partition за O(n) на [3, 7, 2, 9, 5, 1, 6] паркует стержень 5 в финальный слот — меньшие слева, большие справа — раскалывая сортировку на две независимые подзадачи, [3, 2, 1] и [7, 9, 6].",
  },
};

const t = dict[lang];

const before = ["3", "7", "2", "9", "5", "1", "6"];
const after = ["3", "2", "1", "5", "7", "9", "6"];
const beforePivot = 4;
const afterPivot = 3;

const cellW = 80;
const cellH = 54;
const gap = 8;
const startX = 96;
const row1Y = 132;
const row2Y = 258;

const cx = (i: number) => startX + i * (cellW + gap) + cellW / 2;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={startX} y={row1Y - 14} font-size="13" fill="var(--muted)">{t.before}</text>
    <text x={cx(beforePivot)} y={row1Y - 14} text-anchor="middle" font-size="13" fill="var(--accent)">{t.pivotTag}</text>
    {before.map((v, i) => (
      <g>
        <rect
          x={startX + i * (cellW + gap)}
          y={row1Y}
          width={cellW}
          height={cellH}
          fill="var(--card)"
          stroke={i === beforePivot ? "var(--accent)" : "var(--ink)"}
          stroke-width={i === beforePivot ? 3 : 2}
        />
        <text x={cx(i)} y={row1Y + 36} text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <line x1="400" y1={row1Y + cellH + 8} x2="400" y2={row2Y - 12} stroke="var(--muted)" stroke-width="2" />
    <polygon points="400,244 392,230 408,230" fill="var(--muted)" />

    <text x={startX} y={row2Y - 14} font-size="13" fill="var(--muted)">{t.after}</text>
    {after.map((v, i) => (
      <g>
        <rect
          x={startX + i * (cellW + gap)}
          y={row2Y}
          width={cellW}
          height={cellH}
          fill="var(--card)"
          stroke={i === afterPivot ? "var(--accent)" : "var(--ink)"}
          stroke-width={i === afterPivot ? 3 : 2}
        />
        <text x={cx(i)} y={row2Y + 36} text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="224" y={row2Y + cellH + 28} text-anchor="middle" font-size="13" fill="var(--muted)">{t.smaller}</text>
    <text x={cx(afterPivot)} y={row2Y + cellH + 28} text-anchor="middle" font-size="13" fill="var(--accent)">{t.pivotFinal}</text>
    <text x="576" y={row2Y + cellH + 28} text-anchor="middle" font-size="13" fill="var(--muted)">{t.larger}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
