---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Boundary updates lo equals mid plus 1 and hi equals mid minus 1; reusing mid loops forever",
    headline: "SHRINK OR LOOP FOREVER",
    sub: "drop mid itself: lo = mid + 1 · hi = mid - 1",
    checkTag: "check arr[mid] vs target",
    leftCond: "arr[mid] < target",
    leftUpdate: "lo = mid + 1 · go right",
    leftDrop: "(mid itself is dropped)",
    rightCond: "arr[mid] > target",
    rightUpdate: "hi = mid - 1 · go left",
    rightDrop: "(mid itself is dropped)",
    warn1: "✗ lo = mid reuses mid — the range never shrinks",
    warn2: "same mid checked forever → infinite loop",
    note: "loop while lo <= hi · lo > hi means not found → return -1",
    caption:
      "Drop mid itself: lo = mid + 1 and hi = mid - 1 shrink the range every step. Reuse mid and the range never shrinks — the loop checks the same mid forever.",
  },
  ru: {
    svgTitle: "Обновление границ lo равно mid плюс 1 и hi равно mid минус 1; переиспользование mid даёт вечный цикл",
    headline: "СЖИМАЙСЯ ИЛИ ЦИКЛИСЬ ВЕЧНО",
    sub: "выбрось сам mid: lo = mid + 1 · hi = mid - 1",
    checkTag: "сверь arr[mid] с целью",
    leftCond: "arr[mid] < цели",
    leftUpdate: "lo = mid + 1 · иди вправо",
    leftDrop: "(сам mid выброшен)",
    rightCond: "arr[mid] > цели",
    rightUpdate: "hi = mid - 1 · иди влево",
    rightDrop: "(сам mid выброшен)",
    warn1: "✗ lo = mid переиспользует mid — диапазон не сжимается",
    warn2: "тот же mid проверяется вечно → бесконечный цикл",
    note: "цикл пока lo <= hi · lo > hi значит не найдено → верни -1",
    caption:
      "Выбрось сам mid: lo = mid + 1 и hi = mid - 1 сжимают диапазон на каждом шаге. Переиспользуй mid — и диапазон не сожмётся: цикл вечно проверяет тот же mid.",
  },
};

const t = dict[lang];

const strip = ["lo", "…", "mid", "…", "hi"];
const cellW = 64;
const cellGap = 10;
const cellX0 = 220;
const stripTop = 92;
const stripH = 48;
const stripCx = cellX0 + 2 * (cellW + cellGap) + cellW / 2;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {strip.map((v, i) => (
        <g>
          <rect
            x={cellX0 + i * (cellW + cellGap)}
            y={stripTop}
            width={cellW}
            height={stripH}
            rx="6"
            fill="var(--card)"
            stroke={v === "mid" ? "var(--accent)" : "var(--ink)"}
            stroke-width={v === "mid" ? 3 : 2}
          />
          <text x={cellX0 + i * (cellW + cellGap) + cellW / 2} y={stripTop + 31} text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
        </g>
    ))}
    <text x={stripCx} y="160" text-anchor="middle" font-size="12" fill="var(--muted)">{t.checkTag}</text>

    <rect x="60" y="178" width="310" height="94" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="215" y="204" text-anchor="middle" font-size="13" fill="var(--muted)">{t.leftCond}</text>
    <text x="215" y="232" text-anchor="middle" font-size="15" fill="var(--ink)">{t.leftUpdate}</text>
    <text x="215" y="254" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftDrop}</text>

    <rect x="430" y="178" width="310" height="94" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="585" y="204" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rightCond}</text>
    <text x="585" y="232" text-anchor="middle" font-size="15" fill="var(--ink)">{t.rightUpdate}</text>
    <text x="585" y="254" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightDrop}</text>

    <rect x="60" y="290" width="680" height="56" rx="8" fill="none" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="313" text-anchor="middle" font-size="13" fill="var(--ink)">{t.warn1}</text>
    <text x="400" y="333" text-anchor="middle" font-size="13" fill="var(--muted)">{t.warn2}</text>

    <text x="400" y="384" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
