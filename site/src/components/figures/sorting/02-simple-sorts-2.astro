---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Pass costs 1, 2, 3 add up to 6: the sum behind O of n squared",
    headline: "PASS k COSTS k — TOTAL 1+2+3 = 6",
    sub: "on [5, 3, 4, 1] comparisons climb 1, 2, 3",
    passes: ["pass 1", "pass 2", "pass 3"],
    keys: ["key 3", "key 4", "key 1"],
    formula: "1 + 2 + … + (n−1) = n(n−1)/2 = O(n²)",
    note: "the prefix lengthens, the bill grows",
    caption:
      "Nested-loop math: pass k costs k comparisons, so the passes cost 1+2+…+(n−1) = n(n−1)/2 = O(n²). The prefix lengthens, the bill grows.",
  },
  ru: {
    svgTitle: "Стоимость проходов 1, 2, 3 даёт 6: сумма за O от n в квадрате",
    headline: "ПРОХОД k СТОИТ k — ВСЕГО 1+2+3 = 6",
    sub: "на [5, 3, 4, 1] сравнения растут 1, 2, 3",
    passes: ["проход 1", "проход 2", "проход 3"],
    keys: ["ключ 3", "ключ 4", "ключ 1"],
    formula: "1 + 2 + … + (n−1) = n(n−1)/2 = O(n²)",
    note: "префикс длиннеет, счёт растёт",
    caption:
      "Математика циклов: проход k стоит k сравнений, так что проходы стоят 1+2+…+(n−1) = n(n−1)/2 = O(n²). Префикс длиннеет, счёт растёт.",
  },
};

const t = dict[lang];

// Bars: costs 1, 2, 3 at 110px per unit, starting at x=220.
const bars = [
  { top: 104, cost: 1 },
  { top: 168, cost: 2 },
  { top: 232, cost: 3 },
];
const barX = 220;
const barH = 40;
const unit = 110;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {bars.map((b, i) => (
      <g>
        <text x="200" y={b.top + 27} text-anchor="end" font-size="14" fill="var(--ink)">{t.passes[i]}</text>
        <rect x={barX} y={b.top} width={b.cost * unit} height={barH} rx="8" fill="var(--accent)" />
        <text x={barX + b.cost * unit - 18} y={b.top + 28} text-anchor="middle" font-size="18" fill="var(--card)">{b.cost}</text>
        <text x={barX + b.cost * unit + 16} y={b.top + 27} font-size="13" fill="var(--muted)">{t.keys[i]}</text>
      </g>
    ))}

    <rect x="120" y="296" width="560" height="56" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="332" text-anchor="middle" font-size="19" fill="var(--ink)">{t.formula}</text>

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
