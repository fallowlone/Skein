---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Cost comparison: brute force 450 operations versus binary search 60 operations",
    headline: "O(n · range) BRUTE → O(n log range)",
    sub: "weights 1..10 · 5 days · range [10, 55] = 45 candidates",
    brute: "brute force",
    smart: "binary search",
    bruteOps: "45 × 10 = 450 operations",
    smartOps: "6 × 10 = 60 operations",
    bruteChecks: "45 feasibility checks",
    smartChecks: "≈6 checks · log₂(55) ≈ 6",
    scale: "sum = 1,000,000 → log₂ ≈ 20 checks · speedup 50,000×",
    space: "space O(1): only lo, hi, mid",
    caption:
      "Takeaway: binary search on the answer brackets a monotone feasible/infeasible flip — O(log range) feasibility checks find the smallest working value, here 15, in 60 operations instead of 450.",
  },
  ru: {
    svgTitle: "Сравнение стоимости: перебор 450 операций против бинарного поиска 60 операций",
    headline: "O(n · диапазон) ПЕРЕБОР → O(n log диапазона)",
    sub: "веса 1..10 · 5 дней · диапазон [10, 55] = 45 кандидатов",
    brute: "грубая сила",
    smart: "бинарный поиск",
    bruteOps: "45 × 10 = 450 операций",
    smartOps: "6 × 10 = 60 операций",
    bruteChecks: "45 проверок выполнимости",
    smartChecks: "≈6 проверок · log₂(55) ≈ 6",
    scale: "сумма = 1 000 000 → log₂ ≈ 20 проверок · ускорение в 50 000 раз",
    space: "память O(1): только lo, hi, mid",
    caption:
      "Вывод: бинарный поиск по ответу зажимает монотонное переключение выполнимо/невыполнимо — O(log диапазона) проверок находят наименьшее рабочее значение, здесь 15, за 60 операций вместо 450.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="215" y="104" text-anchor="middle" font-size="14" fill="var(--ink)">{t.brute}</text>
    <text x="585" y="104" text-anchor="middle" font-size="14" fill="var(--ink)">{t.smart}</text>

    <rect x="75" y="120" width="280" height="30" fill="var(--muted)" />
    <rect x="445" y="120" width="37" height="30" fill="var(--accent)" />

    <text x="215" y="178" text-anchor="middle" font-size="13" fill="var(--ink)">{t.bruteOps}</text>
    <text x="585" y="178" text-anchor="middle" font-size="13" fill="var(--ink)">{t.smartOps}</text>
    <text x="215" y="202" text-anchor="middle" font-size="12" fill="var(--muted)">{t.bruteChecks}</text>
    <text x="585" y="202" text-anchor="middle" font-size="12" fill="var(--muted)">{t.smartChecks}</text>

    <line x1="120" y1="232" x2="680" y2="232" stroke="var(--muted)" stroke-width="1" />

    <text x="400" y="272" text-anchor="middle" font-size="14" fill="var(--ink)">{t.scale}</text>
    <text x="400" y="310" text-anchor="middle" font-size="13" fill="var(--muted)">{t.space}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
