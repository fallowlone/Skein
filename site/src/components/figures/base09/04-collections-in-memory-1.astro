---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A cell holds a small value directly or a reference to a larger thing",
    headline: "A CELL HOLDS A VALUE OR A REFERENCE",
    sub: "values fit · references point",
    leftCol: "value cell",
    leftBox: "cell holds 42",
    leftNote: "number fits directly",
    rightCol: "reference cell",
    rightBox: "cell holds 7100",
    objLine1: "object lives at 7100",
    objLine2: "age sits inside it",
    foot1: "a number fits directly in the cell",
    foot2: "an object does not fit — the cell holds its address",
    caption:
      "A cell holds either a small fixed-size value directly, like the number 42, or a reference: the cell holding 7100 stores only the address of an object that lives elsewhere, with its age field inside it.",
  },
  ru: {
    svgTitle: "Ячейка хранит маленькое значение прямо или ссылку на большую вещь",
    headline: "ЯЧЕЙКА ХРАНИТ ЗНАЧЕНИЕ ИЛИ ССЫЛКУ",
    sub: "значения помещаются · ссылки указывают",
    leftCol: "ячейка-значение",
    leftBox: "ячейка хранит 42",
    leftNote: "число помещается прямо",
    rightCol: "ячейка-ссылка",
    rightBox: "ячейка хранит 7100",
    objLine1: "объект живёт: 7100",
    objLine2: "поле age внутри него",
    foot1: "число помещается прямо в ячейку",
    foot2: "объект не помещается — ячейка хранит его адрес",
    caption:
      "Ячейка хранит либо маленькое значение фиксированного размера прямо, как число 42, либо ссылку: ячейка со значением 7100 хранит лишь адрес объекта, который живёт в другом месте, а поле age — внутри него.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftCol}</text>
    <text x="600" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightCol}</text>

    <rect x="90" y="120" width="220" height="64" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="200" y="157" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftBox}</text>
    <text x="200" y="216" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftNote}</text>

    <rect x="490" y="120" width="220" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="600" y="157" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightBox}</text>

    <line x1="600" y1="184" x2="600" y2="232" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="600,236 594,226 606,226" fill="var(--accent)" />

    <rect x="480" y="236" width="240" height="70" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="600" y="265" text-anchor="middle" font-size="12" fill="var(--ink)">{t.objLine1}</text>
    <text x="600" y="287" text-anchor="middle" font-size="11" fill="var(--muted)">{t.objLine2}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
