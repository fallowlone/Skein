---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const cells = [
  { idx: "users[0]", ref: "ref 7000", addr: "1000" },
  { idx: "users[1]", ref: "ref 7100", addr: "1004" },
  { idx: "users[2]", ref: "ref 7200", addr: "1008" },
];

const objs = [
  { tag: "A", addr: "7000" },
  { tag: "B", addr: "7100" },
  { tag: "C", addr: "7200" },
];

const cellX = [115, 315, 515];
const cellCX = [200, 400, 585];
const objX = [110, 310, 495];

const dict = {
  en: {
    svgTitle: "Reading users[1].age takes two hops: arithmetic into the array, then follow the reference",
    headline: "TWO HOPS TO users[1].age",
    sub: "users: base 1000 · one ref per cell · 4 bytes each",
    formula: "1000 + 1 × 4 = 1004",
    hop1: "hop 1",
    hop2: "hop 2: follow 7100",
    at: "cell at",
    objWord: "object",
    readHere: "read age here",
    foot1: "hop 1: arithmetic to 1004, read the ref 7100",
    foot2: "hop 2: follow 7100 out to object B, read age",
    caption:
      "An array of objects is two layers: the contiguous block at base 1000 holds only references, so users[1].age takes two hops — address arithmetic to cell 1004 to read the reference 7100, then following it out to object B to read age.",
  },
  ru: {
    svgTitle: "Чтение users[1].age — два прыжка: арифметика в массив, затем следование по ссылке",
    headline: "ДВА ПРЫЖКА ДО users[1].age",
    sub: "users: база 1000 · ссылка в ячейке · 4 байта",
    formula: "1000 + 1 × 4 = 1004",
    hop1: "прыжок 1",
    hop2: "прыжок 2: идём по 7100",
    at: "ячейка",
    objWord: "объект",
    readHere: "age читаем здесь",
    foot1: "прыжок 1: арифметика на 1004, читаем ссылку 7100",
    foot2: "прыжок 2: идём по 7100 наружу к объекту B, читаем age",
    caption:
      "Массив объектов — это два слоя: непрерывный блок с базой 1000 хранит лишь ссылки, поэтому users[1].age — это два прыжка: адресная арифметика в ячейку 1004, чтобы прочитать ссылку 7100, затем следование по ней наружу к объекту B, чтобы прочитать age.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="104" text-anchor="middle" font-size="12" fill="var(--ink)">{t.formula}</text>
    <text x="412" y="130" font-size="11" fill="var(--muted)">{t.hop1}</text>
    <line x1="400" y1="112" x2="400" y2="136" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="400,140 394,130 406,130" fill="var(--accent)" />

    {cells.map((c, i) => (
      i === 1 ? <g /> : (
      <g>
        <text x={cellCX[i]} y="128" text-anchor="middle" font-size="11" fill="var(--muted)">{c.idx}</text>
      </g>
      )
    ))}

    {cells.map((c, i) => (
      <g>
        <rect x={cellX[i]} y="140" width="170" height="64" fill="var(--card)" stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={cellCX[i]} y="167" text-anchor="middle" font-size="13" fill="var(--ink)">{c.ref}</text>
        <text x={cellCX[i]} y="189" text-anchor="middle" font-size="11" fill="var(--muted)">{t.at} {c.addr}</text>
      </g>
    ))}

    {cellCX.map((cx, i) => (
      <g>
        <line x1={cx} y1="204" x2={cx} y2="248" stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width="1.6" />
        <polygon points={`${cx},252 ${cx - 6},242 ${cx + 6},242`} fill={i === 1 ? "var(--accent)" : "var(--ink)"} />
      </g>
    ))}

    <text x="412" y="232" font-size="11" fill="var(--muted)">{t.hop2}</text>

    {objs.map((o, i) => (
      <g>
        <rect x={objX[i]} y="252" width="180" height="56" fill="var(--card)" stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={objX[i] + 90} y="285" text-anchor="middle" font-size="12" fill="var(--ink)">{t.objWord} {o.tag} · {o.addr}</text>
      </g>
    ))}

    <text x="400" y="330" text-anchor="middle" font-size="11" fill="var(--muted)">{t.readHere}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
