---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Address of element i is base address plus index times element size: scores[3] is 1012",
    headline: "ADDRESS = BASE + INDEX × SIZE",
    sub: "scores[3]: base 1000, 4 bytes each",
    boxTop: ["base", "offset = 3 × 4", "address"],
    boxVal: ["1000", "12", "1012"],
    work: "one multiply, one add, one read",
    foot1: "scores[0]: 1000 + 0 = 1000 — exactly the base",
    foot2: "length and other elements never enter the formula",
    caption:
      "Reading scores[3] is a one-shot address calculation: offset 3 × 4 = 12, address 1000 + 12 = 1012 — one multiply, one add, one read. The array length and the other elements never enter the formula.",
  },
  ru: {
    svgTitle: "Адрес элемента i — это базовый адрес плюс индекс на размер элемента: scores[3] — это 1012",
    headline: "АДРЕС = БАЗА + ИНДЕКС × РАЗМЕР",
    sub: "scores[3]: база 1000, по 4 байта",
    boxTop: ["база", "смещение = 3 × 4", "адрес"],
    boxVal: ["1000", "12", "1012"],
    work: "одно умножение, одно сложение, одно чтение",
    foot1: "scores[0]: 1000 + 0 = 1000 — точно база",
    foot2: "длины массива и других элементов в формуле нет",
    caption:
      "Чтение scores[3] — это одноразовое вычисление адреса: смещение 3 × 4 = 12, адрес 1000 + 12 = 1012 — одно умножение, одно сложение, одно чтение. Длина массива и другие элементы в формулу не входят.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.boxTop.map((top, i) => (
      <g>
        <rect x={60 + i * 240} y="140" width="200" height="84" fill="var(--card)" stroke={i === 2 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={160 + i * 240} y="168" text-anchor="middle" font-size="11" fill="var(--muted)">{top}</text>
        <text x={160 + i * 240} y="200" text-anchor="middle" font-size="20" fill="var(--ink)">{t.boxVal[i]}</text>
      </g>
    ))}

    <line x1="260" y1="182" x2="296" y2="182" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="300,182 292,177 292,187" fill="var(--accent)" />
    <text x="280" y="170" text-anchor="middle" font-size="16" fill="var(--accent)">+</text>

    <line x1="500" y1="182" x2="536" y2="182" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="540,182 532,177 532,187" fill="var(--accent)" />
    <text x="520" y="170" text-anchor="middle" font-size="16" fill="var(--accent)">=</text>

    <text x="400" y="276" text-anchor="middle" font-size="13" fill="var(--ink)">{t.work}</text>

    <text x="400" y="355" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="379" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
