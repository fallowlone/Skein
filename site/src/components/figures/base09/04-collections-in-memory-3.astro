---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Nested data is a graph of cells: some hold values, some hold references",
    headline: "NESTED DATA IS A GRAPH OF CELLS",
    sub: "objects point at objects point at arrays",
    entry: "entry → A",
    aName: "name: 'ana'",
    aNext: "next: → B",
    bName: "name: 'bo'",
    bNext: "next: → A",
    cycle: "B points back to A",
    foot1: "some cells hold values, some hold references",
    foot2: "hold one entry reference — walk hop by hop",
    caption:
      "Nested data is a graph of cells: the entry reference leads to object A, whose name field holds a plain value while its next field references object B — and B points back to A. Holding the structure means holding one reference into this graph.",
  },
  ru: {
    svgTitle: "Вложенные данные — граф ячеек: одни хранят значения, другие — ссылки",
    headline: "ВЛОЖЕННЫЕ ДАННЫЕ — ГРАФ ЯЧЕЕК",
    sub: "объекты указывают на объекты, те — на массивы",
    entry: "вход → A",
    aName: "name: 'ana'",
    aNext: "next: → B",
    bName: "name: 'bo'",
    bNext: "next: → A",
    cycle: "B указывает назад на A",
    foot1: "одни ячейки хранят значения, другие — ссылки",
    foot2: "держи одну входную ссылку — иди прыжок за прыжком",
    caption:
      "Вложенные данные — это граф ячеек: входная ссылка ведёт к объекту A, чьё поле name хранит простое значение, а поле next ссылается на объект B, — а B указывает назад на A. Держать структуру — значит держать одну ссылку в этот граф.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="182" width="150" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="115" y="216" text-anchor="middle" font-size="13" fill="var(--ink)">{t.entry}</text>

    <line x1="190" y1="195" x2="246" y2="195" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="250,195 240,189 240,201" fill="var(--accent)" />

    <rect x="250" y="150" width="220" height="120" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <line x1="250" y1="210" x2="470" y2="210" stroke="var(--ink)" stroke-width="1" />
    <rect x="250" y="211" width="5" height="58" fill="var(--accent)" />
    <text x="265" y="186" font-size="12" fill="var(--ink)">{t.aName}</text>
    <text x="265" y="247" font-size="12" fill="var(--ink)">{t.aNext}</text>

    <line x1="470" y1="240" x2="546" y2="240" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="550,240 540,234 540,246" fill="var(--accent)" />

    <rect x="550" y="150" width="210" height="120" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <line x1="550" y1="210" x2="760" y2="210" stroke="var(--ink)" stroke-width="1" />
    <rect x="550" y="211" width="5" height="58" fill="var(--accent)" />
    <text x="565" y="186" font-size="12" fill="var(--ink)">{t.bName}</text>
    <text x="565" y="247" font-size="12" fill="var(--ink)">{t.bNext}</text>

    <line x1="655" y1="270" x2="655" y2="320" stroke="var(--accent)" stroke-width="1.6" />
    <line x1="655" y1="320" x2="360" y2="320" stroke="var(--accent)" stroke-width="1.6" />
    <line x1="360" y1="320" x2="360" y2="274" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="360,270 354,280 366,280" fill="var(--accent)" />
    <text x="507" y="310" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cycle}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
