---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Lookup user.age finds the slot labelled age and reads 30",
    headline: "LOOKUP FINDS THE SLOT BY ITS KEY",
    sub: "user.age → find label age → read 30",
    lookupLabel: "lookup",
    byName: "by name",
    findAge: "find age",
    objName: "user",
    keys: ["name", "age", "active"],
    values: ['"Mara"', "30", "true"],
    readLabel: "read",
    readsLabel: "reads",
    resultSub: "a holds 30",
    foot1: "the key is the address into the object",
    foot2: "find the label age, read 30 — reached by name",
    caption:
      "Reading a field uses its key: user.age finds the slot in user labelled age and reads its value, 30. The key is the address into the object — the value is reached by name, never by position.",
  },
  ru: {
    svgTitle: "Поиск user.age находит слот с меткой age и читает 30",
    headline: "ПОИСК НАХОДИТ СЛОТ ПО КЛЮЧУ",
    sub: "user.age → найти метку age → прочитать 30",
    lookupLabel: "поиск",
    byName: "по имени",
    findAge: "найти age",
    objName: "user",
    keys: ["name", "age", "active"],
    values: ['"Mara"', "30", "true"],
    readLabel: "читать",
    readsLabel: "читает",
    resultSub: "a хранит 30",
    foot1: "ключ и есть адрес внутрь объекта",
    foot2: "найти метку age, прочитать 30 — по имени",
    caption:
      "Чтение поля использует его ключ: user.age находит в user слот с меткой age и читает его значение, 30. Ключ и есть адрес внутрь объекта — значение достигается по имени, а не по позиции.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="115" y="145" text-anchor="middle" font-size="11" fill="var(--muted)">{t.lookupLabel}</text>
    <rect x="40" y="160" width="150" height="70" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="115" y="191" text-anchor="middle" font-size="14" fill="var(--ink)">user.age</text>
    <text x="115" y="213" text-anchor="middle" font-size="11" fill="var(--muted)">{t.byName}</text>

    <text x="230" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.findAge}</text>
    <line x1="190" y1="200" x2="262" y2="200" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="270,200 262,195 262,205" fill="var(--accent)" />

    <text x="400" y="95" text-anchor="middle" font-size="13" fill="var(--accent)">{t.objName}</text>
    {t.keys.map((k, i) => (
      <g>
        <rect x="270" y={110 + i * 65} width="120" height="50" fill="var(--card)" stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x="330" y={141 + i * 65} text-anchor="middle" font-size="13" fill="var(--ink)">{k}</text>
        <rect x="390" y={110 + i * 65} width="140" height="50" fill="var(--card)" stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x="460" y={141 + i * 65} text-anchor="middle" font-size="13" fill="var(--ink)">{t.values[i]}</text>
      </g>
    ))}

    <text x="565" y="188" text-anchor="middle" font-size="11" fill="var(--muted)">{t.readLabel}</text>
    <line x1="530" y1="200" x2="592" y2="200" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="600,200 592,195 592,205" fill="var(--accent)" />

    <text x="670" y="145" text-anchor="middle" font-size="11" fill="var(--muted)">{t.readsLabel}</text>
    <rect x="600" y="160" width="140" height="70" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="670" y="191" text-anchor="middle" font-size="16" fill="var(--ink)">30</text>
    <text x="670" y="213" text-anchor="middle" font-size="11" fill="var(--muted)">{t.resultSub}</text>

    <text x="400" y="348" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
