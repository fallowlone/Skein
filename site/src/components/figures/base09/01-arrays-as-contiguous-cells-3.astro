---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Array elements are not scattered: one block of consecutive addresses, and the name refers to its start",
    headline: "ONE BLOCK, NOT SCATTERED CELLS",
    sub: "the name scores refers to the start of the block",
    mythTag: "not an array",
    mythNote: "scattered · separate places",
    arrayTag: "array",
    arrayNote: "one block · consecutive addresses",
    nameTag: "scores",
    startTag: "start · 1000",
    foot1: "elements occupy one block — the name is where it begins",
    foot2: "no gaps, no separate locations",
    caption:
      "Array elements are not scattered across memory: they occupy one block of consecutive addresses, and the name scores refers to that block — to where it begins, address 1000.",
  },
  ru: {
    svgTitle: "Элементы массива не разбросаны: один блок последовательных адресов, а имя указывает на его начало",
    headline: "ОДИН БЛОК, А НЕ РАЗБРОС ЯЧЕЕК",
    sub: "имя scores указывает на начало блока",
    mythTag: "не массив",
    mythNote: "разброс · отдельные места",
    arrayTag: "массив",
    arrayNote: "один блок · адреса подряд",
    nameTag: "scores",
    startTag: "начало · 1000",
    foot1: "элементы занимают один блок — имя там, где он начинается",
    foot2: "без разрывов и отдельных мест",
    caption:
      "Элементы массива не разбросаны по памяти: они занимают один блок последовательных адресов, а имя scores ссылается на этот блок — на то, где он начинается, адрес 1000.",
  },
};

const t = dict[lang];

const mythAddrs = ["1000", "2048", "3096"];
const addrs = ["1000", "1004", "1008", "1012", "1016"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="130" y="132" text-anchor="middle" font-size="11" fill="var(--muted)">{t.mythTag}</text>
    <text x="130" y="150" text-anchor="middle" font-size="11" fill="var(--muted)">{t.mythNote}</text>

    {mythAddrs.map((a, i) => (
      <g>
        <rect x={240 + i * 160} y="112" width="100" height="54" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" stroke-dasharray="6 4" />
        <text x={290 + i * 160} y="133" text-anchor="middle" font-size="13" fill="var(--muted)">?</text>
        <text x={290 + i * 160} y="153" text-anchor="middle" font-size="11" fill="var(--muted)">{a}</text>
      </g>
    ))}

    <text x="130" y="252" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrayTag}</text>
    <text x="130" y="270" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrayNote}</text>

    {addrs.map((a, i) => (
      <g>
        <rect x={240 + i * 96} y="222" width="96" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={288 + i * 96} y="262" text-anchor="middle" font-size="12" fill="var(--ink)">{a}</text>
      </g>
    ))}

    <rect x="60" y="308" width="140" height="34" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="130" y="331" text-anchor="middle" font-size="14" fill="var(--ink)">{t.nameTag}</text>
    <line x1="200" y1="325" x2="240" y2="286" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="240,286 231,287 235,294" fill="var(--accent)" />
    <text x="252" y="330" text-anchor="start" font-size="11" fill="var(--muted)">{t.startTag}</text>

    <text x="560" y="322" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="560" y="346" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
