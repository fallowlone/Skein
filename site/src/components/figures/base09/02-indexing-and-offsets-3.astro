---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Array access is constant time: reaching arr[9999] costs the same as reaching arr[0]",
    headline: "SAME WORK FOR EVERY INDEX",
    sub: "arr[0] costs what arr[9999] costs",
    cards: [
      "arr[0] → one multiply, one add, one read",
      "arr[9999] → one multiply, one add, one read",
    ],
    noWalk: "no walk 0 → 1 → 2 … → i",
    verdict: "constant time",
    foot1: "work never grows with the index or the array size",
    foot2: "valid only because cells are equal-size and gapless",
    caption:
      "Array access is constant time: reaching arr[9999] takes the same one multiply, one add, and one read as reaching arr[0]. The program never walks from the start — the formula jumps straight to the address, which works only because the cells are equal-size and contiguous.",
  },
  ru: {
    svgTitle: "Доступ к массиву — константное время: достичь arr[9999] стоит столько же, сколько arr[0]",
    headline: "ОДНА И ТА ЖЕ РАБОТА ДЛЯ ЛЮБОГО ИНДЕКСА",
    sub: "arr[0] стоит столько же, сколько arr[9999]",
    cards: [
      "arr[0] → одно умножение, одно сложение, одно чтение",
      "arr[9999] → одно умножение, одно сложение, одно чтение",
    ],
    noWalk: "никакого отсчёта 0, 1, 2 … до i",
    verdict: "константное время",
    foot1: "работа не растёт с индексом и не растёт с размером массива",
    foot2: "верно, лишь пока ячейки одинаковы и без разрывов",
    caption:
      "Доступ к массиву — константное время: достижение arr[9999] занимает те же одно умножение, одно сложение и одно чтение, что и достижение arr[0]. Программа никогда не идёт от начала — формула прыгает прямо к адресу, что работает лишь потому, что ячейки одинакового размера и непрерывны.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.cards.map((c, i) => (
      <g>
        <rect x="140" y={100 + i * 90} width="520" height="64" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="400" y={139 + i * 90} text-anchor="middle" font-size="14" fill="var(--ink)">{c}</text>
      </g>
    ))}

    <text x="400" y="183" text-anchor="middle" font-size="22" fill="var(--accent)">=</text>

    <text x="400" y="290" text-anchor="middle" font-size="13" fill="var(--muted)" text-decoration="line-through">{t.noWalk}</text>
    <text x="400" y="320" text-anchor="middle" font-size="15" fill="var(--accent)">{t.verdict}</text>

    <text x="400" y="355" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="379" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
