---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One type means one size: five number cells, each 4 bytes",
    headline: "ONE TYPE, ONE SIZE",
    sub: "every element a number → every cell 4 bytes",
    typeBox: "same type",
    typeName: "number",
    uniformTag: "identical cells — element size",
    cellSize: "4 bytes",
    foot1: "equal-size cells form a regular grid",
    foot2: "N elements × S bytes = one block of N × S bytes",
    caption:
      "One type means one size: because every element of scores is a number, every cell is 4 bytes — five identical cells forming a regular grid, so an array of N elements of size S is one block of N × S bytes.",
  },
  ru: {
    svgTitle: "Один тип — один размер: пять числовых ячеек, каждая 4 байта",
    headline: "ОДИН ТИП — ОДИН РАЗМЕР",
    sub: "каждый элемент число → каждая ячейка 4 байта",
    typeBox: "один тип",
    typeName: "number",
    uniformTag: "одинаковые ячейки — размер элемента",
    cellSize: "4 байта",
    foot1: "ячейки одного размера образуют регулярную сетку",
    foot2: "N элементов × S байтов = один блок N × S байтов",
    caption:
      "Один тип — один размер: поскольку каждый элемент scores — число, каждая ячейка 4 байта — пять одинаковых ячеек образуют регулярную сетку, поэтому массив из N элементов размером S — один блок из N × S байтов.",
  },
};

const t = dict[lang];

const values = ["90", "80", "70", "60", "50"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="508" y="108" text-anchor="middle" font-size="11" fill="var(--muted)">{t.uniformTag}</text>

    <rect x="56" y="150" width="170" height="96" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="141" y="184" text-anchor="middle" font-size="11" fill="var(--muted)">{t.typeBox}</text>
    <text x="141" y="216" text-anchor="middle" font-size="20" fill="var(--ink)">{t.typeName}</text>

    <line x1="226" y1="198" x2="285" y2="198" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="289,198 281,193 281,203" fill="var(--accent)" />

    {values.map((v, i) => (
      <g>
        <rect x={289 + i * 88} y="150" width="80" height="96" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={329 + i * 88} y="188" text-anchor="middle" font-size="18" fill="var(--ink)">{v}</text>
        <text x={329 + i * 88} y="220" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cellSize}</text>
      </g>
    ))}

    <text x="400" y="300" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="324" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
