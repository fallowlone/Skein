---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "An object is a set of key-value pairs: each key labels a slot holding a value",
    headline: "AN OBJECT IS KEY-VALUE PAIRS",
    sub: '{ name: "Mara", age: 30 } — two fields',
    objName: "user",
    keyCol: "key · the label",
    valCol: "value · the data",
    keys: ["name", "age", "active"],
    values: ['"Mara"', "30", "true"],
    pair: "key-value pair",
    foot1: "each key names a slot; the slot holds the value",
    foot2: "a field = a key + its value",
    caption:
      'An object is a set of named fields: each key (name, age, active) labels a slot, and the slot holds the value ("Mara", 30, true). A key paired with its value is a key-value pair.',
  },
  ru: {
    svgTitle: "Объект — набор пар ключ-значение: каждый ключ метит слот со значением",
    headline: "ОБЪЕКТ — ПАРЫ КЛЮЧ-ЗНАЧЕНИЕ",
    sub: '{ name: "Mara", age: 30 } — два поля',
    objName: "user",
    keyCol: "ключ · метка",
    valCol: "значение · данные",
    keys: ["name", "age", "active"],
    values: ['"Mara"', "30", "true"],
    pair: "пара ключ-значение",
    foot1: "каждый ключ называет слот; слот хранит значение",
    foot2: "поле = ключ + его значение",
    caption:
      'Объект — это набор именованных полей: каждый ключ (name, age, active) метит слот, а слот хранит значение ("Mara", 30, true). Ключ в паре со своим значением — это пара ключ-значение.',
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="340" y="92" text-anchor="middle" font-size="13" fill="var(--accent)">{t.objName}</text>
    <text x="180" y="114" text-anchor="middle" font-size="11" fill="var(--muted)">{t.keyCol}</text>
    <text x="500" y="114" text-anchor="middle" font-size="11" fill="var(--muted)">{t.valCol}</text>

    {t.keys.map((k, i) => (
      <g>
        <rect x="90" y={124 + i * 62} width="180" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="180" y={153 + i * 62} text-anchor="middle" font-size="13" fill="var(--ink)">{k}</text>
        <line x1="270" y1={147 + i * 62} x2="402" y2={147 + i * 62} stroke="var(--accent)" stroke-width="1.6" />
        <polygon points="410,147 402,142 402,152" transform={`translate(0 ${i * 62})`} fill="var(--accent)" />
        <rect x="410" y={124 + i * 62} width="180" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="500" y={153 + i * 62} text-anchor="middle" font-size="13" fill="var(--ink)">{t.values[i]}</text>
      </g>
    ))}

    <line x1="602" y1="124" x2="610" y2="124" stroke="var(--muted)" stroke-width="1.4" />
    <line x1="610" y1="124" x2="610" y2="294" stroke="var(--muted)" stroke-width="1.4" />
    <line x1="602" y1="294" x2="610" y2="294" stroke="var(--muted)" stroke-width="1.4" />
    <text x="622" y="213" font-size="11" fill="var(--muted)">{t.pair}</text>

    <text x="400" y="348" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
