---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Index counts elements, offset counts bytes: offset equals index times element size",
    headline: "INDEX COUNTS ELEMENTS, OFFSET COUNTS BYTES",
    sub: "element size 4 bytes · base 1000",
    baseTag: "base 1000",
    cells: [
      { idx: "i = 0", off: "offset 0", addr: "addr 1000" },
      { idx: "i = 1", off: "offset 4", addr: "addr 1004" },
      { idx: "i = 2", off: "offset 8", addr: "addr 1008" },
      { idx: "i = 3", off: "offset 12", addr: "addr 1012" },
    ],
    formula: "offset = index × element_size",
    example: "size 4: i = 2 → 2 × 4 = 8 bytes past base",
    foot1: "offset of index i is i element-sizes in bytes",
    foot2: "index 0 → offset 0 → exactly the base",
    caption:
      "The index counts elements from the start while the offset counts bytes past the base address: with 4-byte elements at base 1000, index 2 has offset 8 and address 1008, and index 0 has offset 0, placing it exactly at the base.",
  },
  ru: {
    svgTitle: "Индекс считает элементы, смещение считает байты: смещение равно индексу на размер элемента",
    headline: "ИНДЕКС — ЭЛЕМЕНТЫ, СМЕЩЕНИЕ — БАЙТЫ",
    sub: "размер элемента 4 байта · база 1000",
    baseTag: "база 1000",
    cells: [
      { idx: "i = 0", off: "смещение 0", addr: "адрес 1000" },
      { idx: "i = 1", off: "смещение 4", addr: "адрес 1004" },
      { idx: "i = 2", off: "смещение 8", addr: "адрес 1008" },
      { idx: "i = 3", off: "смещение 12", addr: "адрес 1012" },
    ],
    formula: "смещение = индекс × размер_элемента",
    example: "размер 4: i = 2 → 2 × 4 = 8 байтов за базой",
    foot1: "смещение индекса i — это i размеров элемента",
    foot2: "индекс 0 → смещение 0 → точно база",
    caption:
      "Индекс считает элементы от начала, а смещение считает байты за базовым адресом: при элементах по 4 байта и базе 1000 у индекса 2 смещение 8 и адрес 1008, а у индекса 0 смещение 0, что помещает его точно на базу.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="154" y="106" text-anchor="middle" font-size="11" fill="var(--accent)">{t.baseTag}</text>
    <line x1="154" y1="112" x2="154" y2="120" stroke="var(--accent)" stroke-width="1.6" />

    {t.cells.map((c, i) => (
      <g>
        <rect x={79 + i * 164} y="120" width="150" height="96" fill="var(--card)" stroke={i === 0 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={154 + i * 164} y="150" text-anchor="middle" font-size="14" fill="var(--ink)">{c.idx}</text>
        <text x={154 + i * 164} y="174" text-anchor="middle" font-size="11" fill="var(--ink)">{c.off}</text>
        <text x={154 + i * 164} y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{c.addr}</text>
      </g>
    ))}

    <text x="400" y="272" text-anchor="middle" font-size="16" fill="var(--accent)">{t.formula}</text>
    <text x="400" y="300" text-anchor="middle" font-size="13" fill="var(--muted)">{t.example}</text>

    <text x="400" y="355" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="379" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
