---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "An array is five equal cells back-to-back: scores 90, 80, 70, 60, 50 at addresses 1000 to 1016",
    headline: "AN ARRAY IS ONE SOLID STRIP",
    sub: "scores [90, 80, 70, 60, 50] · 5 elements · 4 bytes each",
    elemTag: "element",
    blockTag: "one solid 20-byte block · 1000–1019",
    foot1: "cells back-to-back, no gaps — contiguous memory",
    foot2: "5 elements × 4 bytes = 20 bytes",
    caption:
      "An array is one solid strip: five equal cells placed directly back-to-back hold 90, 80, 70, 60, 50 at addresses 1000, 1004, 1008, 1012, 1016 — one unbroken 20-byte block with no gaps.",
  },
  ru: {
    svgTitle: "Массив — пять равных ячеек вплотную: scores 90, 80, 70, 60, 50 по адресам с 1000 по 1016",
    headline: "МАССИВ — ОДНА ЦЕЛЬНАЯ ПОЛОСА",
    sub: "scores [90, 80, 70, 60, 50] · 5 элементов · по 4 байта",
    elemTag: "элемент",
    blockTag: "один цельный блок 20 байтов · 1000–1019",
    foot1: "ячейки вплотную, без разрывов — непрерывная память",
    foot2: "5 элементов × 4 байта = 20 байтов",
    caption:
      "Массив — одна цельная полоса: пять равных ячеек, лежащих прямо вплотную, хранят 90, 80, 70, 60, 50 по адресам 1000, 1004, 1008, 1012, 1016 — один непрерывный блок в 20 байтов без разрывов.",
  },
};

const t = dict[lang];

const values = ["90", "80", "70", "60", "50"];
const addrs = ["1000", "1004", "1008", "1012", "1016"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {values.map((v, i) => (
      <g>
        <text x={168 + i * 116} y="108" text-anchor="middle" font-size="11" fill="var(--muted)">{t.elemTag} {i}</text>
        <rect x={113 + i * 116} y="122" width="110" height="96" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={168 + i * 116} y="167" text-anchor="middle" font-size="22" fill="var(--ink)">{v}</text>
        <text x={168 + i * 116} y="200" text-anchor="middle" font-size="11" fill="var(--muted)">{addrs[i]}</text>
      </g>
    ))}

    <line x1="113" y1="252" x2="113" y2="264" stroke="var(--accent)" stroke-width="1.6" />
    <line x1="113" y1="264" x2="687" y2="264" stroke="var(--accent)" stroke-width="1.6" />
    <line x1="687" y1="252" x2="687" y2="264" stroke="var(--accent)" stroke-width="1.6" />
    <text x="400" y="290" text-anchor="middle" font-size="12" fill="var(--ink)">{t.blockTag}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
