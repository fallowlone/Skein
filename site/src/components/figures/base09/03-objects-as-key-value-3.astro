---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Array reaches by numeric position, object reaches by name",
    headline: "POSITION VERSUS NAME",
    sub: "nums[1] counts · user.age names",
    arrTitle: "array",
    arrSub: "by position: nums[1]",
    indices: ["0", "1", "2"],
    elems: ["10", "20", "30"],
    arrReads: "reads 20",
    objTitle: "object",
    objSub: "by name: user.age",
    keys: ["name", "age"],
    values: ['"Mara"', "30"],
    objReads: "reads 30",
    foot1: "nums[1] computes an offset · user.age matches a label",
    foot2: "{ a: 1, b: 2 } and { b: 2, a: 1 } are the same object",
    caption:
      "The core contrast: an array reaches a value by numeric position (nums[1] is the element at index 1, value 20), while an object reaches a value by name (user.age is the field labelled age, value 30). Field order does not matter — { a: 1, b: 2 } and { b: 2, a: 1 } are the same object.",
  },
  ru: {
    svgTitle: "Массив достигает по числовой позиции, объект — по имени",
    headline: "ПОЗИЦИЯ ПРОТИВ ИМЕНИ",
    sub: "nums[1] считает · user.age называет",
    arrTitle: "массив",
    arrSub: "по позиции: nums[1]",
    indices: ["0", "1", "2"],
    elems: ["10", "20", "30"],
    arrReads: "читает 20",
    objTitle: "объект",
    objSub: "по имени: user.age",
    keys: ["name", "age"],
    values: ['"Mara"', "30"],
    objReads: "читает 30",
    foot1: "nums[1] вычисляет смещение · user.age сопоставляет метку",
    foot2: "{ a: 1, b: 2 } и { b: 2, a: 1 } — один и тот же объект",
    caption:
      "Ключевой контраст: массив достигает значения по числовой позиции (nums[1] — элемент с индексом 1, значение 20), а объект достигает значения по имени (user.age — поле с меткой age, значение 30). Порядок полей не имеет значения — { a: 1, b: 2 } и { b: 2, a: 1 } — один и тот же объект.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="195" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.arrTitle}</text>
    <text x="195" y="120" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrSub}</text>

    {t.elems.map((e, i) => (
      <g>
        <text x={95 + i * 100} y="142" text-anchor="middle" font-size="11" fill="var(--muted)">{t.indices[i]}</text>
        <rect x={50 + i * 100} y="150" width="90" height="54" fill="var(--card)" stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={95 + i * 100} y="184" text-anchor="middle" font-size="13" fill="var(--ink)">{e}</text>
      </g>
    ))}

    <line x1="195" y1="204" x2="195" y2="234" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="195,242 190,234 200,234" fill="var(--accent)" />
    <text x="195" y="262" text-anchor="middle" font-size="12" fill="var(--ink)">{t.arrReads}</text>

    <line x1="400" y1="90" x2="400" y2="290" stroke="var(--muted)" stroke-width="1" stroke-dasharray="4 3" />

    <text x="600" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.objTitle}</text>
    <text x="600" y="120" text-anchor="middle" font-size="11" fill="var(--muted)">{t.objSub}</text>

    {t.keys.map((k, i) => (
      <g>
        <rect x="450" y={140 + i * 60} width="90" height="46" fill="var(--card)" stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x="495" y={169 + i * 60} text-anchor="middle" font-size="13" fill="var(--ink)">{k}</text>
        <line x1="540" y1={163 + i * 60} x2="556" y2={163 + i * 60} stroke="var(--accent)" stroke-width="1.6" />
        <polygon points="560,163 552,158 552,168" transform={`translate(0 ${i * 60})`} fill="var(--accent)" />
        <rect x="560" y={140 + i * 60} width="120" height="46" fill="var(--card)" stroke={i === 1 ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x="620" y={169 + i * 60} text-anchor="middle" font-size="13" fill="var(--ink)">{t.values[i]}</text>
      </g>
    ))}

    <line x1="620" y1="246" x2="620" y2="256" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="620,264 615,256 625,256" fill="var(--accent)" />
    <text x="620" y="284" text-anchor="middle" font-size="12" fill="var(--ink)">{t.objReads}</text>

    <text x="400" y="348" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
