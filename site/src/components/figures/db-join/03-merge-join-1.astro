---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Merge Join: two inputs sorted by id walk forward in lockstep with pointers, emitting 4 where both keys meet",
    headline: "MERGE JOIN: WALK IN LOCKSTEP",
    sub: "both sides sorted — pointers advance together",
    sortBadge: "sorted by id",
    keysA: ["1", "4", "7", "12"],
    keysB: ["2", "4", "9", "15"],
    outLine: "out: 4",
    outMore: "···",
    foot: "sort cost + merge cost · range joins welcome",
    caption:
      "Merge Join walks two sorted inputs forward in lockstep and emits a row wherever the keys meet — no hash table, no per-row lookups. It wins when both sides already arrive sorted.",
  },
  ru: {
    svgTitle: "Слияние: два отсортированных по id входа идут указателями в ногу, выдавая 4 там, где ключи встретились",
    headline: "СЛИЯНИЕ: ШАГ В НОГУ",
    sub: "обе стороны отсортированы — указатели идут парой",
    sortBadge: "сортировка по id",
    keysA: ["1", "4", "7", "12"],
    keysB: ["2", "4", "9", "15"],
    outLine: "выход: 4",
    outMore: "···",
    foot: "сортировка + слияние · range-join можно",
    caption:
      "Слияние идёт по двум отсортированным входам в ногу и выдаёт строку там, где ключи встретились — без хеш-таблицы и поисков на строку. Выигрывает, когда обе стороны уже отсортированы.",
  },
};

const t = dict[lang];

const cellY = [120, 164, 208, 252];
const cellH = 42;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbj-mj-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="185" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">A · {t.sortBadge}</text>
    <rect x="110" y="110" width="150" height="210" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    {t.keysA.map((k, i) => (
      <g>
        <rect x="130" y={cellY[i]} width="110" height={cellH} fill={k === "4" ? "var(--paper)" : "var(--card)"} stroke={k === "4" ? "var(--accent)" : "var(--ink)"} stroke-width={k === "4" ? 2.5 : 1.5} />
        <text x="185" y={cellY[i] + 28} text-anchor="middle" font-size="16" fill="var(--ink)">{k}</text>
      </g>
    ))}
    <polygon points="98,176 98,194 110,185" fill="var(--accent)" />

    <text x="615" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">B · {t.sortBadge}</text>
    <rect x="540" y="110" width="150" height="210" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    {t.keysB.map((k, i) => (
      <g>
        <rect x="560" y={cellY[i]} width="110" height={cellH} fill={k === "4" ? "var(--paper)" : "var(--card)"} stroke={k === "4" ? "var(--accent)" : "var(--ink)"} stroke-width={k === "4" ? 2.5 : 1.5} />
        <text x="615" y={cellY[i] + 28} text-anchor="middle" font-size="16" fill="var(--ink)">{k}</text>
      </g>
    ))}
    <polygon points="702,176 702,194 690,185" fill="var(--accent)" />

    <line x1="282" y1="185" x2="318" y2="262" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbj-mj-arrow)" />
    <line x1="518" y1="185" x2="482" y2="262" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbj-mj-arrow)" />

    <rect x="320" y="250" width="160" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="274" text-anchor="middle" font-size="15" fill="var(--ink)">{t.outLine}</text>
    <text x="400" y="296" text-anchor="middle" font-size="13" fill="var(--muted)">{t.outMore}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
