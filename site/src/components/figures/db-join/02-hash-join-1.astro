---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Hash Join: the smaller build side is hashed into buckets, then each probe row lands in its bucket; spilling past work_mem shows Batches 64",
    headline: "HASH JOIN: BUILD, THEN PROBE",
    sub: "smaller side builds the table · larger side probes it",
    buildTitle: "BUILD · smaller",
    buildKeys: ["k = 7", "k = 3", "k = 9"],
    hashNote: "k → bucket",
    buckets: ["A", "B", "C"],
    bucketKeys: ["k = 3", "k = 7", "k = 9"],
    probeTitle: "PROBE · larger",
    probeKeys: ["k = 3", "k = 7"],
    barLine1: "equi-joins only — equal keys land in one bucket",
    barLine2: "table bigger than work_mem spills to disk: Batches: 64",
    caption:
      "Hash Join hashes the smaller build side into buckets, then probes each bucket with rows from the larger side — equal keys always meet. It only supports equi-joins, and spills to disk in batches when the table exceeds work_mem.",
  },
  ru: {
    svgTitle: "Хеш-соединение: меньшая сторона хешируется в бакеты, затем каждая строка зондирования попадает в свой бакет; переполнение work_mem даёт Batches 64",
    headline: "ХЕШ-СОЕДИНЕНИЕ: ПОСТРОИТЬ → ЗОНДИРОВАТЬ",
    sub: "меньшая сторона строит таблицу · большая её зондирует",
    buildTitle: "СТРОИМ · меньше",
    buildKeys: ["k = 7", "k = 3", "k = 9"],
    hashNote: "k → бакет",
    buckets: ["A", "B", "C"],
    bucketKeys: ["k = 3", "k = 7", "k = 9"],
    probeTitle: "ЗОНДИРУЕМ · больше",
    probeKeys: ["k = 3", "k = 7"],
    barLine1: "только equi-join — равные ключи в одном бакете",
    barLine2: "таблица больше work_mem → сброс на диск: Batches: 64",
    caption:
      "Хеш-соединение хеширует меньшую сторону в бакеты, затем зондирует каждый бакет строками большей стороны — равные ключи всегда встречаются. Работает только для equi-join, а при переполнении work_mem сбрасывается на диск партиями.",
  },
};

const t = dict[lang];

const buildY = [150, 192, 234];
const probeY = [150, 192];
const bucketX = [300, 395, 490];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbj-hj-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="30" y="110" width="160" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="110" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.buildTitle}</text>
    {t.buildKeys.map((k, i) => (
      <g>
        <rect x="50" y={buildY[i]} width="120" height="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="110" y={buildY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">{k}</text>
      </g>
    ))}

    <line x1="190" y1="167" x2="210" y2="196" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbj-hj-arrow)" />
    <line x1="190" y1="209" x2="208" y2="213" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbj-hj-arrow)" />
    <line x1="190" y1="251" x2="210" y2="232" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbj-hj-arrow)" />

    <circle cx="240" cy="215" r="32" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="240" y="220" text-anchor="middle" font-size="12" fill="var(--ink)">hash()</text>
    <text x="240" y="268" text-anchor="middle" font-size="11" fill="var(--muted)">{t.hashNote}</text>

    {t.buckets.map((b, i) => (
      <g>
        <rect x={bucketX[i]} y="130" width="85" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={bucketX[i] + 42} y="154" text-anchor="middle" font-size="12" fill="var(--muted)">{b}</text>
        <rect x={bucketX[i] + 12} y="176" width="61" height="30" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x={bucketX[i] + 42} y="196" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bucketKeys[i]}</text>
      </g>
    ))}

    <rect x="600" y="110" width="170" height="190" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="685" y="136" text-anchor="middle" font-size="12" fill="var(--ink)">{t.probeTitle}</text>
    {t.probeKeys.map((k, i) => (
      <g>
        <rect x="620" y={probeY[i]} width="130" height="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="685" y={probeY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">{k}</text>
      </g>
    ))}

    <path d="M 598 167 L 575 100 H 342 V 130" fill="none" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbj-hj-arrow)" />
    <path d="M 598 209 L 595 118 H 437 V 130" fill="none" stroke="var(--accent)" stroke-width="2" marker-end="url(#dbj-hj-arrow)" />

    <rect x="60" y="322" width="680" height="54" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--ink)">{t.barLine1}</text>
    <text x="400" y="366" text-anchor="middle" font-size="12" fill="var(--muted)">{t.barLine2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
