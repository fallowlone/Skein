---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Nested Loop: each of the outer rows fires one inner index lookup, so 520,000 outer rows mean 520,000 lookups",
    headline: "NESTED LOOP: ONE ROW, ONE LOOKUP",
    sub: "each outer row fires one inner index lookup",
    outerTitle: "OUTER · orders",
    outerRows: ["row 1", "row 2", "row 3"],
    outerMore: "···",
    estLine: "estimate: 50 rows",
    actLine: "actual: 520,000 rows",
    lookupNote: "each outer row fires exactly one inner lookup",
    innerTitle: "INNER · customers_pkey",
    root: "root",
    leaf: "leaf",
    loopsLine: "inner loops = 520,000",
    loopsSub: "10,400× more work than planned",
    foot: "cost = outer_rows × inner_cost",
    caption:
      "Nested Loop runs the inner lookup once per outer row: with 520,000 real outer rows instead of the estimated 50, the index scan runs 520,000 times — cost is outer_rows × inner_cost.",
  },
  ru: {
    svgTitle: "Вложенный цикл: каждая внешняя строка запускает один поиск во внутреннем индексе — 520 000 внешних строк дают 520 000 поисков",
    headline: "ВЛОЖЕННЫЙ ЦИКЛ: СТРОКА → ПОИСК",
    sub: "каждая внешняя строка — один поиск во внутреннем индексе",
    outerTitle: "ВНЕШНЯЯ · orders",
    outerRows: ["строка 1", "строка 2", "строка 3"],
    outerMore: "···",
    estLine: "оценка: 50 строк",
    actLine: "факт: 520 000 строк",
    lookupNote: "каждая внешняя строка — ровно один поиск",
    innerTitle: "ВНУТРЕННЯЯ · customers_pkey",
    root: "корень",
    leaf: "лист",
    loopsLine: "loops = 520 000",
    loopsSub: "в 10 400 раз больше работы",
    foot: "цена = outer_rows × inner_cost",
    caption:
      "Вложенный цикл выполняет внутренний поиск раз на каждую внешнюю строку: при 520 000 реальных строк вместо оценочных 50 поиск по индексу выполняется 520 000 раз — цена равна outer_rows × inner_cost.",
  },
};

const t = dict[lang];

const rowY = [140, 182, 224];
const rowH = 34;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="dbj-nl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--accent)" />
      </marker>
    </defs>

    <rect x="40" y="100" width="240" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="160" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.outerTitle}</text>
    {t.outerRows.map((r, i) => (
      <g>
        <rect x="60" y={rowY[i]} width="200" height={rowH} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="160" y={rowY[i] + 23} text-anchor="middle" font-size="12" fill="var(--ink)">{r}</text>
      </g>
    ))}
    <text x="160" y="284" text-anchor="middle" font-size="16" fill="var(--muted)">{t.outerMore}</text>
    <text x="160" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">{t.estLine}</text>
    <text x="160" y="323" text-anchor="middle" font-size="12" fill="var(--accent)">{t.actLine}</text>

    {rowY.map((y) => (
      <line x1="280" y1={y + rowH / 2} x2="372" y2={y + rowH / 2} stroke="var(--accent)" stroke-width="2" marker-end="url(#dbj-nl-arrow)" />
    ))}
    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.lookupNote}</text>

    <rect x="380" y="100" width="380" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="570" y="126" text-anchor="middle" font-size="13" fill="var(--ink)">{t.innerTitle}</text>
    <rect x="520" y="146" width="100" height="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="570" y="168" text-anchor="middle" font-size="12" fill="var(--ink)">{t.root}</text>
    <line x1="570" y1="180" x2="515" y2="216" stroke="var(--ink)" stroke-width="1.5" />
    <line x1="570" y1="180" x2="625" y2="216" stroke="var(--ink)" stroke-width="1.5" />
    <rect x="460" y="216" width="110" height="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="515" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leaf}</text>
    <rect x="570" y="216" width="110" height="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="625" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leaf}</text>

    <rect x="420" y="264" width="300" height="52" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" />
    <text x="570" y="286" text-anchor="middle" font-size="15" fill="var(--accent)">{t.loopsLine}</text>
    <text x="570" y="306" text-anchor="middle" font-size="11" fill="var(--muted)">{t.loopsSub}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
