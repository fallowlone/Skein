---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "N-Queens n=8: brute force C(64,8) is about 4 billion placements, pruning cuts it to 92 solutions",
    headline: "PRUNING CUTS THE SEARCH SPACE",
    sub: "without pruning O(c^d) · binary strings O(2^n) · space O(d)",
    rowBrute: "brute force C(64, 8)",
    rowPruned: "pruned",
    bruteVal: "≈ 4,000,000,000 placements",
    prunedVal: "92 solutions",
    formula: "time: c choices × d levels = c^d nodes · stack depth d",
    note: "pruning skips whole subtrees — that skip is the entire win",
    caption:
      "N-Queens with n=8: brute force tries all C(64, 8) ≈ 4 billion placements. Backtracking with pruning skips branches where queens attack each other, cutting billions down to 92 solutions. Without pruning you visit c^d nodes; the call stack stays O(d) deep.",
  },
  ru: {
    svgTitle: "Расстановка королев n=8: brute force C(64,8) — около 4 миллиардов расстановок, отсечение режет до 92 решений",
    headline: "ОТСЕЧЕНИЕ РЕЖЕТ ПРОСТРАНСТВО ПОИСКА",
    sub: "без отсечения O(c^d) · бинарные строки O(2^n) · память O(d)",
    rowBrute: "brute force C(64, 8)",
    rowPruned: "с отсечением",
    bruteVal: "≈ 4 000 000 000 расстановок",
    prunedVal: "92 решения",
    formula: "время: c выборов × d уровней = c^d узлов · глубина стека d",
    note: "отсечение пропускает целые поддеревья — этот пропуск и есть выигрыш",
    caption:
      "Расстановка королев при n=8: brute force пробует все C(64, 8) ≈ 4 миллиарда расстановок. Backtracking с отсечением пропускает ветви, где королевы атакуют друг друга, срезая миллиарды до 92 решений. Без отсечения ты посещаешь c^d узлов; стек вызовов остаётся глубиной O(d).",
  },
};

const t = dict[lang];

const bars = [
  { label: t.rowBrute, value: t.bruteVal, y: 116, w: 300, hot: true },
  { label: t.rowPruned, value: t.prunedVal, y: 216, w: 28, hot: false },
];

const bx = 180;
const bh = 44;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {bars.map((b) => (
      <g>
        <text x={bx - 12} y={b.y + 28} text-anchor="end" font-size="13" fill="var(--ink)">{b.label}</text>
        <rect x={bx} y={b.y} width={b.w} height={bh} fill={b.hot ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={bx + b.w + 12} y={b.y + 28} font-size="13" fill="var(--ink)">{b.value}</text>
      </g>
    ))}

    <text x="400" y="316" text-anchor="middle" font-size="13" fill="var(--ink)">{t.formula}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
