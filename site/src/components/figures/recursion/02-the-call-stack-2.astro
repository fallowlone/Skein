---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "factorial of 4 pushes four frames then pops them with values 1, 2, 6, 24",
    headline: "factorial(4): PUSH DOWN, POP BACK",
    sub: "way down: push [n=4] [n=3] [n=2] [n=1] · way back: pop 1, 2, 6, 24",
    colStack: "stack at deepest point",
    colReturns: "returns pop in reverse",
    deepest: "depth 4 = n",
    base: "base case: return 1",
    empty: "stack empty",
    down: "calls push",
    up: "returns pop",
    pops: ["factorial(1) → 1", "2 × 1 = 2 → pop", "3 × 2 = 6 → pop", "4 × 6 = 24 → pop"],
    caption:
      "factorial(4) pushes [n=4], [n=3], [n=2], [n=1]: four live frames at the deepest point, depth 4 = n. The base case returns 1, then frames pop in reverse: 2 × 1 = 2, 3 × 2 = 6, 4 × 6 = 24, and the stack is empty.",
  },
  ru: {
    svgTitle: "factorial(4) заталкивает четыре кадра, потом выталкивает их со значениями 1, 2, 6, 24",
    headline: "factorial(4): PUSH ВНИЗ, POP НАЗАД",
    sub: "вниз: push [n=4] [n=3] [n=2] [n=1] · назад: pop 1, 2, 6, 24",
    colStack: "стек в самой глубокой точке",
    colReturns: "возвраты выталкиваются наоборот",
    deepest: "глубина 4 = n",
    base: "базовый случай: возврат 1",
    empty: "стек пуст",
    down: "вызовы заталкивают",
    up: "возвраты выталкивают",
    pops: ["factorial(1) → 1", "2 × 1 = 2 → pop", "3 × 2 = 6 → pop", "4 × 6 = 24 → pop"],
    caption:
      "factorial(4) заталкивает [n=4], [n=3], [n=2], [n=1]: четыре живых кадра в самой глубокой точке, глубина 4 = n. Базовый случай возвращает 1, потом кадры выталкиваются в обратном порядке: 2 × 1 = 2, 3 × 2 = 6, 4 × 6 = 24, и стек пуст.",
  },
};

const t = dict[lang];

const frames = ["factorial(4) [n=4]", "factorial(3) [n=3]", "factorial(2) [n=2]", "factorial(1) [n=1]"];
const pops = t.pops;

const rowY = (i: number) => 104 + i * 56;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="110" y="92" font-size="13" fill="var(--ink)">{t.colStack}</text>
    {frames.map((v, i) => (
      <g>
        <rect x="110" y={rowY(i)} width="250" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="235" y={rowY(i) + 29} text-anchor="middle" font-size="13" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="440" y="92" font-size="13" fill="var(--ink)">{t.colReturns}</text>
    {pops.map((v, i) => (
      <g>
        <rect x="440" y={rowY(i)} width="250" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="565" y={rowY(i) + 29} text-anchor="middle" font-size="13" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <line x1="372" y1="120" x2="372" y2="300" stroke="var(--accent)" stroke-width="2" />
    <polygon points="365,300 379,300 372,312" fill="var(--accent)" />
    <line x1="428" y1="300" x2="428" y2="120" stroke="var(--accent)" stroke-width="2" />
    <polygon points="421,120 435,120 428,108" fill="var(--accent)" />

    <text x="235" y="352" text-anchor="middle" font-size="13" fill="var(--muted)">{t.down}</text>
    <text x="565" y="352" text-anchor="middle" font-size="13" fill="var(--muted)">{t.up}</text>
    <text x="400" y="378" text-anchor="middle" font-size="14" fill="var(--ink)">{t.deepest}</text>
    <text x="400" y="400" text-anchor="middle" font-size="13" fill="var(--muted)">{t.base}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
