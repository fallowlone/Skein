---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Six permutations of 1, 2, 3 choose 2 collapse into three combinations",
    headline: "ORDER COUNTS VS ORDER IGNORED",
    sub: "{1, 2, 3} choose 2 · C(n,k) = P(n,k) / k!",
    colPerms: "permutations · 6",
    colCombs: "combinations · 3",
    note: "{1,2} and {2,1} are one combination, two permutations",
    caption:
      "Permutations of {1,2,3} choose 2 count order: (1,2), (1,3), (2,1), (2,3), (3,1), (3,2) — 6 total. Combinations ignore order: {1,2}, {1,3}, {2,3} — 3 total. Each pair of reversed orderings collapses into one set, so C(n,k) = P(n,k) / k! divides out the k! orderings inside the chosen set.",
  },
  ru: {
    svgTitle: "Шесть перестановок из 1, 2, 3 выбрать 2 схлопываются в три комбинации",
    headline: "ПОРЯДОК ВАЖЕН ИЛИ НЕТ",
    sub: "{1, 2, 3} выбрать 2 · C(n,k) = P(n,k) / k!",
    colPerms: "перестановки · 6",
    colCombs: "комбинации · 3",
    note: "{1,2} и {2,1} — одна комбинация, две перестановки",
    caption:
      "Перестановки из {1,2,3} выбрать 2 считают порядок: (1,2), (1,3), (2,1), (2,3), (3,1), (3,2) — всего 6. Комбинации игнорируют порядок: {1,2}, {1,3}, {2,3} — всего 3. Каждая пара обратных упорядочений схлопывается в одно множество, так C(n,k) = P(n,k) / k! делит на k! упорядочений внутри выбранного набора.",
  },
};

const t = dict[lang];

const pairs = [
  { a: "(1, 2)", b: "(2, 1)", c: "{1, 2}", y: 130 },
  { a: "(1, 3)", b: "(3, 1)", c: "{1, 3}", y: 210 },
  { a: "(2, 3)", b: "(3, 2)", c: "{2, 3}", y: 290 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="100" text-anchor="middle" font-size="14" fill="var(--ink)">{t.colPerms}</text>
    <text x="590" y="100" text-anchor="middle" font-size="14" fill="var(--ink)">{t.colCombs}</text>

    {pairs.map((p) => (
      <g>
        <rect x="90" y={p.y} width="100" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="140" y={p.y + 28} text-anchor="middle" font-size="14" fill="var(--ink)">{p.a}</text>
      </g>
    ))}

    {pairs.map((p) => (
      <g>
        <rect x="210" y={p.y} width="100" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="260" y={p.y + 28} text-anchor="middle" font-size="14" fill="var(--ink)">{p.b}</text>
      </g>
    ))}

    {pairs.map((p) => (
      <g>
        <line x1="330" y1={p.y + 22} x2="500" y2={p.y + 22} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`500,${p.y + 15} 500,${p.y + 29} 512,${p.y + 22}`} fill="var(--accent)" />
      </g>
    ))}

    {pairs.map((p) => (
      <g>
        <rect x="520" y={p.y} width="140" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x="590" y={p.y + 28} text-anchor="middle" font-size="14" fill="var(--ink)">{p.c}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
