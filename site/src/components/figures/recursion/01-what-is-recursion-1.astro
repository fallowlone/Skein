---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Factorial split into base case and recursive case",
    headline: "TWO MANDATORY PARTS",
    sub: "factorial(n) = base case stops · recursive case shrinks and calls itself",
    signature: "function factorial(n) {",
    baseLabel: "BASE CASE",
    baseComment: "// stop here",
    baseNote1: "answers directly",
    baseNote2: "no recursion",
    basePromise: "guarantees termination",
    recLabel: "RECURSIVE CASE",
    recComment: "// shrink and call yourself",
    recNote1: "smaller input: n - 1",
    recNote2: "builds on smaller answer",
    recPromise: "guarantees progress",
    warning: "break either and the function never returns",
    caption:
      "Every recursive function needs two parts: the base case (if n ≤ 1, return 1) answers directly with no recursion and guarantees termination; the recursive case (return n × factorial(n − 1)) shrinks the input and builds on the smaller answer, guaranteeing progress toward the base. Break either, and the function never returns.",
  },
  ru: {
    svgTitle: "Факториал: базовый случай и рекурсивный случай",
    headline: "ДВЕ ОБЯЗАТЕЛЬНЫЕ ЧАСТИ",
    sub: "factorial(n) = базовый случай останавливается · рекурсивный сжимает и вызывает себя",
    signature: "function factorial(n) {",
    baseLabel: "БАЗОВЫЙ СЛУЧАЙ",
    baseComment: "// остановиться здесь",
    baseNote1: "отвечает сразу",
    baseNote2: "без рекурсии",
    basePromise: "гарантирует остановку",
    recLabel: "РЕКУРСИВНЫЙ СЛУЧАЙ",
    recComment: "// сжать и вызвать себя",
    recNote1: "меньший вход: n - 1",
    recNote2: "строится на меньшем ответе",
    recPromise: "гарантирует прогресс",
    warning: "нарушь любую — функция никогда не вернётся",
    caption:
      "Каждой рекурсивной функции нужны две части: базовый случай (если n ≤ 1, вернуть 1) отвечает сразу без рекурсии и гарантирует остановку; рекурсивный случай (вернуть n × factorial(n − 1)) сжимает вход и строится на меньшем ответе, гарантируя прогресс к базе. Нарушь любую — функция никогда не вернётся.",
  },
};

const t = dict[lang];

const baseCode = ["if (n <= 1) {", "  return 1;", "}"];
const recCode = ["return n * factorial(n - 1);", "}"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="92" text-anchor="middle" font-size="14" fill="var(--ink)">{t.signature}</text>

    <rect x="60" y="110" width="320" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="80" y="138" font-family="var(--font-display)" font-size="16" fill="var(--accent)">{t.baseLabel}</text>
    <text x="80" y="162" font-size="12" fill="var(--muted)">{t.baseComment}</text>
    {baseCode.map((line, i) => (
      <text x="80" y={184 + i * 22} font-size="13" fill="var(--ink)">{line}</text>
    ))}
    <line x1="80" y1="262" x2="360" y2="262" stroke="var(--muted)" stroke-width="1" />
    <text x="80" y="286" font-size="12" fill="var(--muted)">{t.baseNote1}</text>
    <text x="80" y="306" font-size="12" fill="var(--muted)">{t.baseNote2}</text>
    <text x="80" y="328" font-size="12" fill="var(--ink)">{t.basePromise}</text>

    <rect x="420" y="110" width="320" height="230" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="440" y="138" font-family="var(--font-display)" font-size="16" fill="var(--accent)">{t.recLabel}</text>
    <text x="440" y="162" font-size="12" fill="var(--muted)">{t.recComment}</text>
    {recCode.map((line, i) => (
      <text x="440" y={184 + i * 22} font-size="13" fill="var(--ink)">{line}</text>
    ))}
    <line x1="440" y1="262" x2="720" y2="262" stroke="var(--muted)" stroke-width="1" />
    <text x="440" y="286" font-size="12" fill="var(--muted)">{t.recNote1}</text>
    <text x="440" y="306" font-size="12" fill="var(--muted)">{t.recNote2}</text>
    <text x="440" y="328" font-size="12" fill="var(--ink)">{t.recPromise}</text>

    <text x="400" y="380" text-anchor="middle" font-size="13" fill="var(--ink)">{t.warning}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
