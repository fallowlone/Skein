---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Forward-only start index tree for choose 2 of 1, 2, 3, 4 with six leaves",
    headline: "START ONLY MOVES FORWARD",
    sub: "choose 2 of {1, 2, 3, 4} · 6 leaves · loop from start, never 0",
    pick: "pick",
    pruned: "pruned: nothing after",
    note: "no {2,1} is ever explored — each set is reached exactly once",
    caption:
      "The start index only advances: pick 1 and only 2, 3, 4 remain ({1,2}, {1,3}, {1,4}); pick 2 and only 3, 4 remain ({2,3}, {2,4}); pick 3 and only 4 remains ({3,4}); pick 4 and nothing is left, so the branch prunes. Six leaves, exactly C(4,2) = 6, with no duplicate like {2,1}.",
  },
  ru: {
    svgTitle: "Дерево стартового индекса только вперёд для выбрать 2 из 1, 2, 3, 4 с шестью листьями",
    headline: "СТАРТ ДВИЖЕТСЯ ТОЛЬКО ВПЕРЁД",
    sub: "выбери 2 из {1, 2, 3, 4} · 6 листьев · цикл со start, никогда с 0",
    pick: "взять",
    pruned: "отсечено: после ничего",
    note: "{2,1} никогда не исследуется — каждый набор достигается ровно раз",
    caption:
      "Стартовый индекс только растёт: возьми 1 — остаются только 2, 3, 4 ({1,2}, {1,3}, {1,4}); возьми 2 — остаются только 3, 4 ({2,3}, {2,4}); возьми 3 — остаётся только 4 ({3,4}); возьми 4 — ничего не осталось, ветвь отсекается. Шесть листьев, ровно C(4,2) = 6, без дубликата вроде {2,1}.",
  },
};

const t = dict[lang];

const picks = [
  { v: "1", start: 1, cx: 140 },
  { v: "2", start: 2, cx: 330 },
  { v: "3", start: 3, cx: 520 },
  { v: "4", start: 4, cx: 680 },
];

const leaves = [
  { label: "{1,2}", cx: 65, parent: 140 },
  { label: "{1,3}", cx: 140, parent: 140 },
  { label: "{1,4}", cx: 215, parent: 140 },
  { label: "{2,3}", cx: 292, parent: 330 },
  { label: "{2,4}", cx: 367, parent: 330 },
  { label: "{3,4}", cx: 520, parent: 520 },
];

const rootX = 400;
const rootBottom = 112;
const pickTop = 165;
const pickBottom = 209;
const leafTop = 280;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="340" y="76" width="120" height="36" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="100" text-anchor="middle" font-size="14" fill="var(--ink)">start=0</text>

    {picks.map((p) => (
      <line x1={rootX} y1={rootBottom} x2={p.cx} y2={pickTop} stroke="var(--ink)" stroke-width="1.5" />
    ))}

    {picks.map((p) => (
      <g>
        <rect x={p.cx - 55} y="165" width="110" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={p.cx} y="184" text-anchor="middle" font-size="13" fill="var(--ink)">{t.pick} {p.v}</text>
        <text x={p.cx} y="202" text-anchor="middle" font-size="12" fill="var(--muted)">start={p.start}</text>
      </g>
    ))}

    {leaves.map((l) => (
      <line x1={l.parent} y1={pickBottom} x2={l.cx} y2={leafTop} stroke="var(--ink)" stroke-width="1.5" />
    ))}
    <line x1="680" y1={pickBottom} x2="680" y2={leafTop} stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="5 4" />

    {leaves.map((l) => (
      <g>
        <rect x={l.cx - 35} y="280" width="70" height="34" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={l.cx} y="302" text-anchor="middle" font-size="13" fill="var(--ink)">{l.label}</text>
      </g>
    ))}

    <rect x="595" y="280" width="170" height="34" fill="var(--card)" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" />
    <text x="680" y="302" text-anchor="middle" font-size="12" fill="var(--muted)">{t.pruned}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
