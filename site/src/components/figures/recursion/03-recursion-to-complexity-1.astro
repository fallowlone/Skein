---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Recursion tree of factorial 4 as a straight chain of 5 nodes",
    headline: "FACTORIAL(4): A STRAIGHT LINE OF 5 NODES",
    sub: "branching factor b = 1 · depth d = n · each node does O(1) work",
    baseTag: "[base case]",
    perLevel: "1 node per level",
    total: "5 nodes × O(1) = O(n) time",
    caption:
      "The recursion tree of factorial(4) is a straight line: factorial(4) → factorial(3) → factorial(2) → factorial(1) → factorial(0) [base case]. Branching factor b = 1, depth d = n, 5 nodes each doing O(1) work (one multiplication), so time is O(n).",
  },
  ru: {
    svgTitle: "Дерево рекурсии factorial 4 как прямая цепочка из 5 узлов",
    headline: "FACTORIAL(4): ПРЯМАЯ ЛИНИЯ ИЗ 5 УЗЛОВ",
    sub: "branching factor b = 1 · глубина d = n · каждый узел делает O(1) работы",
    baseTag: "[базовый случай]",
    perLevel: "1 узел на уровень",
    total: "5 узлов × O(1) = O(n) времени",
    caption:
      "Дерево рекурсии factorial(4) — прямая линия: factorial(4) → factorial(3) → factorial(2) → factorial(1) → factorial(0) [базовый случай]. Branching factor b = 1, глубина d = n, 5 узлов, каждый делает O(1) работы (одно умножение), значит время — O(n).",
  },
};

const t = dict[lang];

const nodes = [
  { label: "factorial(4)", y: 96, base: false },
  { label: "factorial(3)", y: 148, base: false },
  { label: "factorial(2)", y: 200, base: false },
  { label: "factorial(1)", y: 252, base: false },
  { label: "factorial(0)", y: 304, base: true },
];

const nodeW = 220;
const nodeH = 32;
const nodeX = 400 - nodeW / 2;
const arrows = [0, 1, 2, 3].map((i) => ({
  x: 400,
  y1: nodes[i].y + nodeH + 1,
  y2: nodes[i + 1].y - 3,
}));
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {nodes.map((n) => (
      <g>
        <rect x={nodeX} y={n.y} width={nodeW} height={nodeH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="400" y={n.y + 22} text-anchor="middle" font-size="14" fill="var(--ink)">{n.label}</text>
      </g>
    ))}
    <text x={nodeX + nodeW + 12} y={nodes[4].y + 22} font-size="12" fill="var(--muted)">{t.baseTag}</text>

    {arrows.map((a) => (
      <g>
        <line x1={a.x} y1={a.y1} x2={a.x} y2={a.y2} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`${a.x - 6},${a.y2} ${a.x + 6},${a.y2} ${a.x},${a.y2 + 8}`} fill="var(--accent)" />
      </g>
    ))}

    <text x={nodeX - 16} y="232" text-anchor="end" font-size="13" fill="var(--muted)">{t.perLevel}</text>

    <text x="400" y="392" text-anchor="middle" font-size="15" fill="var(--ink)">{t.total}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
