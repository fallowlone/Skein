---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Pruned decision tree: a,a violates the constraint and is cut, a,b is a solution, b,a is a solution, b,b is cut",
    headline: "PRUNE THE MOMENT IT BREAKS",
    sub: "check is_valid() before recursing · 2 solutions, 2 pruned",
    dead: "violates · prune ✗",
    live: "valid leaf ✓",
    note: "dead ends stop: the whole subtree is skipped",
    caption:
      "From the empty partial solution pick a or b and extend once more: a,a violates the constraint so its subtree is pruned — back up and try a,b, a valid leaf. On the right b,a works and b,b is cut: 2 solution leaves, 2 pruned branches.",
  },
  ru: {
    svgTitle: "Отсечённое дерево решений: a,a нарушает ограничение и срезано, a,b — решение, b,a — решение, b,b срезано",
    headline: "ОТСЕКАЙ В МОМЕНТ ПОЛОМКИ",
    sub: "проверяй is_valid() до рекурсии · 2 решения, 2 отсечения",
    dead: "нарушает · отсечь ✗",
    live: "валидный лист ✓",
    note: "тупики останавливают: целое поддерево пропущено",
    caption:
      "Из пустого частичного решения выбери a или b и продли ещё раз: a,a нарушает ограничение, и его поддерево отсекается — отступи и попробуй a,b, валидный лист. Справа b,a годится, а b,b срезано: 2 листа-решения, 2 отсечённые ветви.",
  },
};

const t = dict[lang];

const edges = [
  { x1: 400, y1: 128, x2: 220, y2: 186 },
  { x1: 400, y1: 128, x2: 580, y2: 186 },
  { x1: 220, y1: 228, x2: 120, y2: 288, cut: true },
  { x1: 220, y1: 228, x2: 320, y2: 288, cut: false },
  { x1: 580, y1: 228, x2: 480, y2: 288, cut: false },
  { x1: 580, y1: 228, x2: 680, y2: 288, cut: true },
];

const inner = [
  { x: 400, y: 92, label: "[ ]" },
  { x: 220, y: 192, label: "a" },
  { x: 580, y: 192, label: "b" },
];

const leaves = [
  { x: 120, label: "a,a", dead: true },
  { x: 320, label: "a,b", dead: false },
  { x: 480, label: "b,a", dead: false },
  { x: 680, label: "b,b", dead: true },
];

const nw = 64;
const nh = 36;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke={e.cut ? "var(--accent)" : "var(--muted)"} stroke-width="2" stroke-dasharray={e.cut ? "6 4" : "none"} />
    ))}

    {inner.map((n) => (
      <g>
        <rect x={n.x - nw / 2} y={n.y} width={nw} height={nh} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 23} text-anchor="middle" font-size="14" fill="var(--ink)">{n.label}</text>
      </g>
    ))}

    {leaves.map((l) => (
      <g>
        <rect x={l.x - nw / 2} y="294" width={nw} height={nh} fill="var(--card)" stroke={l.dead ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={l.x} y="317" text-anchor="middle" font-size="14" fill="var(--ink)">{l.label}</text>
        <text x={l.x} y="348" text-anchor="middle" font-size="11" fill={l.dead ? "var(--accent)" : "var(--muted)"}>{l.dead ? t.dead : t.live}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
