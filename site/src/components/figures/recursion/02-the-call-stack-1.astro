---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One stack frame holds three things; foo bar baz stack has depth 3",
    headline: "A FRAME HOLDS THREE THINGS",
    sub: "parameters · local variables · return address",
    frameTitle: "stack frame",
    rowParams: "parameters",
    rowLocals: "local variables",
    rowReturn: "return address",
    stackTitle: "call stack · LIFO",
    top: "top · next to run",
    push: "push on call",
    pop: "pop on return",
    depth: "depth = 3",
    foo: "foo()",
    bar: "bar()",
    baz: "baz() → 42",
    note: "baz returns 42 → its frame pops first",
    caption:
      "Every call pushes a frame holding parameters, local variables, and the return address. foo() calls bar() calls baz(), so at step 3 the stack is [foo, bar, baz] with depth 3 and baz on top; baz returns 42 and its frame pops first.",
  },
  ru: {
    svgTitle: "Один кадр стека держит три вещи; стек foo bar baz имеет глубину 3",
    headline: "КАДР ДЕРЖИТ ТРИ ВЕЩИ",
    sub: "параметры · локальные переменные · адрес возврата",
    frameTitle: "кадр стека",
    rowParams: "параметры",
    rowLocals: "локальные переменные",
    rowReturn: "адрес возврата",
    stackTitle: "стек вызовов · LIFO",
    top: "вершина · следующий",
    push: "push на вызове",
    pop: "pop на возврате",
    depth: "глубина = 3",
    foo: "foo()",
    bar: "bar()",
    baz: "baz() → 42",
    note: "baz возвращает 42 → её кадр выталкивается первым",
    caption:
      "Каждый вызов заталкивает кадр с параметрами, локальными переменными и адресом возврата. foo() вызывает bar(), тот — baz(), поэтому на шаге 3 стек — [foo, bar, baz] с глубиной 3 и baz на вершине; baz возвращает 42 и её кадр выталкивается первым.",
  },
};

const t = dict[lang];

const frameRows = [t.rowParams, t.rowLocals, t.rowReturn];
const stackFrames = [t.baz, t.bar, t.foo];

const fy = (i: number) => 128 + i * 62;
const sy = (i: number) => 128 + i * 62;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="110" y="108" font-size="13" fill="var(--ink)">{t.frameTitle}</text>
    {frameRows.map((v, i) => (
      <g>
        <rect x="110" y={fy(i)} width="250" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="235" y={fy(i) + 32} text-anchor="middle" font-size="13" fill="var(--ink)">{v}</text>
      </g>
    ))}

    <text x="430" y="108" font-size="13" fill="var(--ink)">{t.stackTitle}</text>
    {stackFrames.map((v, i) => (
      <g>
        <rect x="430" y={sy(i)} width="220" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="540" y={sy(i) + 32} text-anchor="middle" font-size="14" fill="var(--ink)">{v}</text>
      </g>
    ))}
    <text x="656" y="160" font-size="12" fill="var(--accent)">{t.top}</text>
    <line x1="656" y1="154" x2="650" y2="154" stroke="var(--accent)" stroke-width="2" />

    <text x="110" y="342" font-size="13" fill="var(--ink)">{t.push}</text>
    <line x1="240" y1="338" x2="300" y2="338" stroke="var(--accent)" stroke-width="2" />
    <polygon points="300,331 300,345 312,338" fill="var(--accent)" />
    <text x="430" y="342" font-size="13" fill="var(--ink)">{t.pop}</text>
    <line x1="620" y1="338" x2="570" y2="338" stroke="var(--accent)" stroke-width="2" />
    <polygon points="570,331 570,345 558,338" fill="var(--accent)" />

    <text x="540" y="372" text-anchor="middle" font-size="14" fill="var(--ink)">{t.depth}</text>
    <text x="400" y="400" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
