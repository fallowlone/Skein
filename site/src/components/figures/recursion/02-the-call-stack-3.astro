---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Finite stack of 1 to 8 megabytes overflows at depth one million",
    headline: "THE STACK IS FINITE: OVERFLOW",
    sub: "stack 1–8 MB · each frame ~100–500 bytes",
    safe: "safe: depth 10,000–80,000",
    overflow: "overflow: depth 1,000,000",
    err: "Maximum call stack size exceeded",
    rec: "factorial(n): O(n) stack space",
    iter: "iterative loop: O(1) stack space",
    n1000: "factorial(1000) → 1000 frames pile up",
    deep: "deepRecursion(1000000) → overflow",
    limit: "depth × frame size ≤ stack size",
    caption:
      "The stack holds 1–8 MB and each frame costs ~100–500 bytes, so depth 10,000–80,000 is usually safe but 1,000,000 is not: deepRecursion(1000000) crashes with “Maximum call stack size exceeded”. factorial(n) needs O(n) stack space — factorial(1000) piles up 1000 frames — while an iterative loop uses O(1).",
  },
  ru: {
    svgTitle: "Конечный стек 1–8 мегабайт переполняется на глубине миллион",
    headline: "СТЕК КОНЕЧЕН: ПЕРЕПОЛНЕНИЕ",
    sub: "стек 1–8 МБ · каждый кадр ~100–500 байт",
    safe: "безопасно: глубина 10,000–80,000",
    overflow: "переполнение: глубина 1,000,000",
    err: "Maximum call stack size exceeded",
    rec: "factorial(n): O(n) памяти стека",
    iter: "цикл без рекурсии: O(1) памяти стека",
    n1000: "factorial(1000) → 1000 кадров копятся",
    deep: "deepRecursion(1000000) → переполнение",
    limit: "глубина × размер кадра ≤ размер стека",
    caption:
      "Стек держит 1–8 МБ, каждый кадр стоит ~100–500 байт, поэтому глубина 10,000–80,000 обычно безопасна, а 1,000,000 — нет: deepRecursion(1000000) падает с «Maximum call stack size exceeded». factorial(n) требует O(n) памяти стека — factorial(1000) копит 1000 кадров — а цикл без рекурсии использует O(1).",
  },
};

const t = dict[lang];

const bars = [
  { label: t.safe, frac: 0.45, accent: false },
  { label: t.overflow, frac: 1.0, accent: true },
];

const barY = (i: number) => 116 + i * 74;
const bx0 = 120;
const bw = 560;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {bars.map((b, i) => (
      <g>
        <text x={bx0} y={barY(i) - 8} font-size="13" fill="var(--ink)">{b.label}</text>
        <rect x={bx0} y={barY(i)} width={bw} height="34" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <rect x={bx0} y={barY(i)} width={bw * b.frac} height="34" fill={b.accent ? "var(--accent)" : "var(--muted)"} opacity="0.55" />
      </g>
    ))}

    <text x="400" y="292" text-anchor="middle" font-size="13" fill="var(--accent)">{t.err}</text>
    <text x="400" y="316" text-anchor="middle" font-size="13" fill="var(--ink)">{t.deep}</text>
    <text x="400" y="340" text-anchor="middle" font-size="13" fill="var(--ink)">{t.n1000}</text>
    <text x="400" y="364" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rec} · {t.iter}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.limit}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
