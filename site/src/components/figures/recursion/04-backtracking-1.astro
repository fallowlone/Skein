---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Decision tree for generateBinaryStrings(2): root branches 0 and 1, leaves 00, 01, 10, 11",
    headline: "BINARY STRINGS, n = 2: CHOOSE 0 OR 1, GO DEEP",
    sub: "choose · explore · undo — depth-first walk of all partial solutions",
    choose0: "choose 0",
    choose1: "choose 1",
    print: "print",
    note: "visit order: 00 → 01 → 10 → 11 · 2² = 4 leaves",
    caption:
      "generateBinaryStrings(2) builds a decision tree: from the empty string choose 0 or 1, then choose again. Depth-first order prints 00, 01, 10, 11 — all 2² = 4 leaves, each visited exactly once.",
  },
  ru: {
    svgTitle: "Дерево решений generateBinaryStrings(2): корень ветвится на 0 и 1, листья 00, 01, 10, 11",
    headline: "БИНАРНЫЕ СТРОКИ, n = 2: ВЫБЕРИ 0 ИЛИ 1, ИДИ ВГЛУБЬ",
    sub: "выбери · исследуй · отмени — поход в глубину по всем частичным решениям",
    choose0: "выбери 0",
    choose1: "выбери 1",
    print: "выведи",
    note: "порядок обхода: 00 → 01 → 10 → 11 · 2² = 4 листа",
    caption:
      "generateBinaryStrings(2) строит дерево решений: из пустой строки выбери 0 или 1, затем выбери снова. Порядок в глубину выводит 00, 01, 10, 11 — все 2² = 4 листа, каждый посещён ровно один раз.",
  },
};

const t = dict[lang];

const edges = [
  { x1: 400, y1: 128, x2: 220, y2: 186, label: dict[lang].choose0, lx: 288, ly: 162 },
  { x1: 400, y1: 128, x2: 580, y2: 186, label: dict[lang].choose1, lx: 512, ly: 162 },
  { x1: 220, y1: 228, x2: 110, y2: 288, label: dict[lang].choose0, lx: 143, ly: 262 },
  { x1: 220, y1: 228, x2: 330, y2: 288, label: dict[lang].choose1, lx: 297, ly: 262 },
  { x1: 580, y1: 228, x2: 470, y2: 288, label: dict[lang].choose0, lx: 503, ly: 262 },
  { x1: 580, y1: 228, x2: 690, y2: 288, label: dict[lang].choose1, lx: 657, ly: 262 },
];

const inner = [
  { x: 400, y: 92, w: 64, label: '""' },
  { x: 220, y: 192, w: 64, label: '"0"' },
  { x: 580, y: 192, w: 64, label: '"1"' },
];

const leaves = [
  { x: 110, label: '"00"', order: "1" },
  { x: 330, label: '"01"', order: "2" },
  { x: 470, label: '"10"', order: "3" },
  { x: 690, label: '"11"', order: "4" },
];

const nw = 64;
const nh = 36;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {edges.map((e) => (
      <g>
        <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--muted)" stroke-width="2" />
        <text x={e.lx} y={e.ly} text-anchor="middle" font-size="11" fill="var(--muted)">{e.label}</text>
      </g>
    ))}

    {inner.map((n) => (
      <g>
        <rect x={n.x - n.w / 2} y={n.y} width={n.w} height={nh} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 23} text-anchor="middle" font-size="14" fill="var(--ink)">{n.label}</text>
      </g>
    ))}

    {leaves.map((l) => (
      <g>
        <rect x={l.x - nw / 2} y="294" width={nw} height={nh} fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={l.x} y="317" text-anchor="middle" font-size="14" fill="var(--ink)">{l.label}</text>
        <text x={l.x} y="348" text-anchor="middle" font-size="11" fill="var(--accent)">{t.print} · {l.order}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
