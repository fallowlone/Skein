---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Subsets versus permutations: same choose-explore-undo template, different choice logic and output sizes",
    headline: "SAME TEMPLATE, DIFFERENT CHOICES",
    sub: "both use choose → explore → undo · the choice logic differs",
    colSubsets: "SUBSETS",
    colPerms: "PERMUTATIONS",
    rowChoice: "choice",
    rowBranch: "branching",
    rowDepth: "depth",
    rowLeaves: "leaves",
    rowTime: "time",
    rowSpace: "space",
    subsetsChoice: "include / exclude",
    permsChoice: "which unused next",
    subsetsBranch: "2 per node",
    permsBranch: "n, n−1, n−2…",
    depth: "n",
    subsetsLeaves: "2ⁿ",
    permsLeaves: "n!",
    subsetsTime: "O(n × 2ⁿ)",
    permsTime: "O(n × n!)",
    space: "O(n)",
    scale: "n = 20 → ~1M subsets · n = 10 → 3.6M perms · n = 12 → 479M perms",
    floor: "you cannot beat the output size — each answer must be written",
    caption:
      "Subsets choose include/exclude (2 branches per node, 2ⁿ leaves, O(n × 2ⁿ) time); permutations choose which unused item goes next (n, n−1… branches, n! leaves, O(n × n!) time). Both recurse to depth n with O(n) stack. The output itself is that large: n = 20 gives ~1M subsets; n = 10 gives 3.6M and n = 12 gives 479M permutations.",
  },
  ru: {
    svgTitle: "Подмножества против перестановок: один шаблон выбрать-исследовать-отменить, разная логика выбора и размеры вывода",
    headline: "ОДИН ШАБЛОН, РАЗНЫЕ ВЫБОРЫ",
    sub: "обе используют выбрать → исследовать → отменить · логика выбора отличается",
    colSubsets: "ПОДМНОЖЕСТВА",
    colPerms: "ПЕРЕСТАНОВКИ",
    rowChoice: "выбор",
    rowBranch: "ветвление",
    rowDepth: "глубина",
    rowLeaves: "листья",
    rowTime: "время",
    rowSpace: "память",
    subsetsChoice: "включить / исключить",
    permsChoice: "какой дальше",
    subsetsBranch: "2 на узел",
    permsBranch: "n, n−1, n−2…",
    depth: "n",
    subsetsLeaves: "2ⁿ",
    permsLeaves: "n!",
    subsetsTime: "O(n × 2ⁿ)",
    permsTime: "O(n × n!)",
    space: "O(n)",
    scale: "n = 20 → ~1M подмножеств · n = 10 → 3,6M перест. · n = 12 → 479M перест.",
    floor: "размер вывода не побить — каждый ответ надо выписать",
    caption:
      "Подмножества выбирают включить/исключить (2 ветвления на узел, 2ⁿ листьев, O(n × 2ⁿ) времени); перестановки выбирают, какой неиспользованный элемент идёт дальше (ветвления n, n−1…, n! листьев, O(n × n!) времени). Обе рекурсируют на глубину n со стеком O(n). Сам вывод такой большой: n = 20 даёт ~1M подмножеств; n = 10 даёт 3,6M, а n = 12 — 479M перестановок.",
  },
};

const t = dict[lang];

const rows = [
  { label: t.rowChoice, left: t.subsetsChoice, right: t.permsChoice },
  { label: t.rowBranch, left: t.subsetsBranch, right: t.permsBranch },
  { label: t.rowDepth, left: t.depth, right: t.depth },
  { label: t.rowLeaves, left: t.subsetsLeaves, right: t.permsLeaves },
  { label: t.rowTime, left: t.subsetsTime, right: t.permsTime },
  { label: t.rowSpace, left: t.space, right: t.space },
];

const y0 = 128;
const rh = 34;
const rowY = (i: number) => y0 + i * rh;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="280" y="104" text-anchor="middle" font-size="15" fill="var(--accent)">{t.colSubsets}</text>
    <text x="580" y="104" text-anchor="middle" font-size="15" fill="var(--accent)">{t.colPerms}</text>

    {rows.map((r, i) => (
      <g>
        <text x="120" y={rowY(i) + 10} text-anchor="end" font-size="13" fill="var(--muted)">{r.label}</text>
        <rect x="140" y={rowY(i) - 12} width="280" height="28" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="280" y={rowY(i) + 8} text-anchor="middle" font-size="13" fill="var(--ink)">{r.left}</text>
        <rect x="440" y={rowY(i) - 12} width="280" height="28" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="580" y={rowY(i) + 8} text-anchor="middle" font-size="13" fill="var(--ink)">{r.right}</text>
      </g>
    ))}

    <text x="400" y="356" text-anchor="middle" font-size="13" fill="var(--ink)">{t.scale}</text>
    <text x="400" y="384" text-anchor="middle" font-size="13" fill="var(--muted)">{t.floor}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
