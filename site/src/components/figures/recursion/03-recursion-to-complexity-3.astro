---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Complexity comparison of factorial and naive fibonacci with time and space",
    headline: "TIME = NODES × WORK · SPACE = DEPTH",
    sub: "general formula: time = O(b^d) × work per node · b = branching factor, d = depth",
    colFn: "function",
    colB: "b",
    colD: "d",
    colNodes: "nodes",
    colWork: "work/node",
    colTime: "time",
    factPunch: "factorial(100) ≈ 100 calls · instant",
    fibPunch: "fibonacci(100) ≈ 2¹⁰⁰ ≈ 10³⁰ calls · universe age ≈ 10¹⁰ s",
    spaceNote: "stack space = depth = O(n) for both — time is the bottleneck, not the stack",
    caption:
      "factorial: b = 1, d = n, n nodes × O(1) = O(n) time; naive fibonacci: b = 2, d = n, ≈2ⁿ nodes × O(1) = O(2ⁿ) time. factorial(100) needs ~100 calls (instant) but fibonacci(100) needs ~2¹⁰⁰ ≈ 10³⁰ calls while the universe is only ~10¹⁰ seconds old. Stack space is O(n) for both — time is the bottleneck.",
  },
  ru: {
    svgTitle: "Сравнение сложности factorial и наивного fibonacci: время и память",
    headline: "ВРЕМЯ = УЗЛЫ × РАБОТА · ПАМЯТЬ = ГЛУБИНА",
    sub: "общая формула: время = O(b^d) × работа на узел · b = branching factor, d = глубина",
    colFn: "функция",
    colB: "b",
    colD: "d",
    colNodes: "узлы",
    colWork: "работа/узел",
    colTime: "время",
    factPunch: "factorial(100) ≈ 100 вызовов · мгновенно",
    fibPunch: "fibonacci(100) ≈ 2¹⁰⁰ ≈ 10³⁰ вызовов · возраст вселенной ≈ 10¹⁰ с",
    spaceNote: "память стека = глубина = O(n) для обоих — узкое место время, не стек",
    caption:
      "factorial: b = 1, d = n, n узлов × O(1) = O(n) времени; наивный fibonacci: b = 2, d = n, ≈2ⁿ узлов × O(1) = O(2ⁿ) времени. factorial(100) нужны ~100 вызовов (мгновенно), а fibonacci(100) — ~2¹⁰⁰ ≈ 10³⁰ вызовов, когда возраст вселенной лишь ~10¹⁰ секунд. Память стека O(n) для обоих — узкое место время.",
  },
};

const t = dict[lang];

const cols = [170, 330, 420, 520, 630, 720];
const header = [t.colFn, t.colB, t.colD, t.colNodes, t.colWork, t.colTime];
const rows = [
  { y: 140, cells: ["factorial(n)", "1", "n", "n", "O(1)", "O(n)"], hi: false },
  { y: 200, cells: ["fibonacci(n)", "2", "n", "≈2ⁿ", "O(1)", "O(2ⁿ)"], hi: true },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {header.map((h, i) => (
      <text x={cols[i]} y="112" text-anchor="middle" font-size="13" fill="var(--muted)">{h}</text>
    ))}
    <line x1="60" y1="122" x2="760" y2="122" stroke="var(--ink)" stroke-width="2" />

    {rows.map((r) => (
      <g>
        <rect x="60" y={r.y - 26} width="700" height="44" fill={r.hi ? "var(--card)" : "none"} stroke={r.hi ? "var(--accent)" : "var(--ink)"} stroke-width={r.hi ? 2 : 1} />
        {r.cells.map((c, i) => (
          <text x={cols[i]} y={r.y + 2} text-anchor="middle" font-size={i === 0 ? 13 : 15} fill={r.hi && i === 5 ? "var(--accent)" : "var(--ink)"}>{c}</text>
        ))}
      </g>
    ))}

    <line x1="60" y1="268" x2="760" y2="268" stroke="var(--ink)" stroke-width="1" />
    <text x="400" y="300" text-anchor="middle" font-size="14" fill="var(--ink)">{t.factPunch}</text>
    <text x="400" y="328" text-anchor="middle" font-size="14" fill="var(--accent)">{t.fibPunch}</text>
    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.spaceNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
