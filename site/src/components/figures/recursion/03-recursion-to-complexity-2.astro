---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Binary recursion tree of fibonacci 5 doubling 1, 2, 4 nodes per level",
    headline: "FIB(5): EVERY LEVEL DOUBLES — 1, 2, 4",
    sub: "branching factor b = 2 · depth d = n · each node does O(1) work",
    level0: "L0 · 1",
    level1: "L1 · 2",
    level2: "L2 · 4",
    total: "total ≈ 1 + 2 + 4 + 8 + … + 2ⁿ ≈ O(2ⁿ)",
    caption:
      "The recursion tree of fib(5): root fib(5) splits into fib(4) + fib(3); level 2 holds fib(3), fib(2), fib(2), fib(1). Node counts double per level — 1, 2, 4, 8, … 2ⁿ — so total nodes ≈ 1 + 2 + 4 + … + 2ⁿ ≈ O(2ⁿ), each doing O(1) work (one addition).",
  },
  ru: {
    svgTitle: "Бинарное дерево рекурсии fibonacci 5: уровни двоятся 1, 2, 4 узла",
    headline: "FIB(5): КАЖДЫЙ УРОВЕНЬ ДВОИТСЯ — 1, 2, 4",
    sub: "branching factor b = 2 · глубина d = n · каждый узел делает O(1) работы",
    level0: "L0 · 1",
    level1: "L1 · 2",
    level2: "L2 · 4",
    total: "всего ≈ 1 + 2 + 4 + 8 + … + 2ⁿ ≈ O(2ⁿ)",
    caption:
      "Дерево рекурсии fib(5): корень fib(5) расщепляется на fib(4) + fib(3); на уровне 2 — fib(3), fib(2), fib(2), fib(1). Число узлов двоится на уровень — 1, 2, 4, 8, … 2ⁿ — значит всего узлов ≈ 1 + 2 + 4 + … + 2ⁿ ≈ O(2ⁿ), каждый делает O(1) работы (одно сложение).",
  },
};

const t = dict[lang];

const nodeW = 108;
const nodeH = 32;
const levels = [
  { y: 96, cxs: [400], labels: ["fib(5)"] },
  { y: 190, cxs: [250, 550], labels: ["fib(4)", "fib(3)"] },
  { y: 284, cxs: [150, 280, 520, 670], labels: ["fib(3)", "fib(2)", "fib(2)", "fib(1)"] },
];
const levelTags = [t.level0, t.level1, t.level2];

const rects = levels.flatMap((lv) =>
  lv.cxs.map((cx, i) => ({ x: cx - nodeW / 2, y: lv.y, cx, label: lv.labels[i] }))
);
const edges = [
  { x1: 400, y1: 96 + nodeH, x2: 250, y2: 190 },
  { x1: 400, y1: 96 + nodeH, x2: 550, y2: 190 },
  { x1: 250, y1: 190 + nodeH, x2: 150, y2: 284 },
  { x1: 250, y1: 190 + nodeH, x2: 280, y2: 284 },
  { x1: 550, y1: 190 + nodeH, x2: 520, y2: 284 },
  { x1: 550, y1: 190 + nodeH, x2: 670, y2: 284 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
    ))}

    {rects.map((r) => (
      <g>
        <rect x={r.x} y={r.y} width={nodeW} height={nodeH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={r.cx} y={r.y + 22} text-anchor="middle" font-size="14" fill="var(--ink)">{r.label}</text>
      </g>
    ))}

    {levels.map((lv, i) => (
      <text x="18" y={lv.y + 22} font-size="12" fill="var(--accent)">{levelTags[i]}</text>
    ))}

    <text x="400" y="366" text-anchor="middle" font-size="15" fill="var(--ink)">{t.total}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
