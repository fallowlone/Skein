---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Include-exclude decision tree for {1, 2, 3}: three levels, eight subset leaves",
    headline: "SUBSETS: 3 LEVELS → 8 LEAVES",
    sub: "one binary choice per element · include left, exclude right · 2³ = 8",
    level1: "decide 1",
    level2: "decide 2",
    level3: "decide 3",
    leafRow: "8 leaves = the power set, each once",
    caption:
      "Each of the 3 elements is included (left) or excluded (right): three levels of two-way branching grow 2³ = 8 leaves — {1,2,3}, {1,2}, {1,3}, {1}, {2,3}, {2}, {3}, {}. Depth n, branching 2 per node, 2ⁿ leaves.",
  },
  ru: {
    svgTitle: "Дерево решений включить-исключить для {1, 2, 3}: три уровня, восемь листьев-подмножеств",
    headline: "ПОДМНОЖЕСТВА: 3 УРОВНЯ → 8 ЛИСТЬЕВ",
    sub: "один бинарный выбор на элемент · включить налево, исключить направо · 2³ = 8",
    level1: "решаем 1",
    level2: "решаем 2",
    level3: "решаем 3",
    leafRow: "8 листьев = степенное множество, каждый по разу",
    caption:
      "Каждый из 3 элементов включается (налево) или исключается (направо): три уровня двойного ветвления растят 2³ = 8 листьев — {1,2,3}, {1,2}, {1,3}, {1}, {2,3}, {2}, {3}, {}. Глубина n, ветвление 2 на узел, 2ⁿ листьев.",
  },
};

const t = dict[lang];

interface Node {
  x: number;
  y: number;
  label: string;
  leaf: boolean;
}

const nodes: Node[] = [
  { x: 400, y: 100, label: "{}", leaf: false },
  { x: 250, y: 168, label: "{1}", leaf: false },
  { x: 550, y: 168, label: "{}", leaf: false },
  { x: 175, y: 236, label: "{1,2}", leaf: false },
  { x: 325, y: 236, label: "{1}", leaf: false },
  { x: 475, y: 236, label: "{2}", leaf: false },
  { x: 625, y: 236, label: "{}", leaf: false },
  { x: 113, y: 312, label: "{1,2,3}", leaf: true },
  { x: 206, y: 312, label: "{1,2}", leaf: true },
  { x: 294, y: 312, label: "{1,3}", leaf: true },
  { x: 382, y: 312, label: "{1}", leaf: true },
  { x: 470, y: 312, label: "{2,3}", leaf: true },
  { x: 558, y: 312, label: "{2}", leaf: true },
  { x: 646, y: 312, label: "{3}", leaf: true },
  { x: 724, y: 312, label: "{}", leaf: true },
];

interface Edge {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  lx: number;
  ly: number;
  tag: string;
}

const edges: Edge[] = [
  { x1: 400, y1: 100, x2: 250, y2: 168, lx: 312, ly: 128, tag: "+1" },
  { x1: 400, y1: 100, x2: 550, y2: 168, lx: 488, ly: 128, tag: "−1" },
  { x1: 250, y1: 168, x2: 175, y2: 236, lx: 200, ly: 198, tag: "+2" },
  { x1: 250, y1: 168, x2: 325, y2: 236, lx: 300, ly: 198, tag: "−2" },
  { x1: 550, y1: 168, x2: 475, y2: 236, lx: 500, ly: 198, tag: "+2" },
  { x1: 550, y1: 168, x2: 625, y2: 236, lx: 600, ly: 198, tag: "−2" },
  { x1: 175, y1: 236, x2: 113, y2: 312, lx: 132, ly: 272, tag: "+3" },
  { x1: 175, y1: 236, x2: 206, y2: 312, lx: 201, ly: 272, tag: "−3" },
  { x1: 325, y1: 236, x2: 294, y2: 312, lx: 299, ly: 272, tag: "+3" },
  { x1: 325, y1: 236, x2: 382, y2: 312, lx: 364, ly: 272, tag: "−3" },
  { x1: 475, y1: 236, x2: 470, y2: 312, lx: 462, ly: 272, tag: "+3" },
  { x1: 475, y1: 236, x2: 558, y2: 312, lx: 527, ly: 272, tag: "−3" },
  { x1: 625, y1: 236, x2: 646, y2: 312, lx: 625, ly: 272, tag: "+3" },
  { x1: 625, y1: 236, x2: 724, y2: 312, lx: 685, ly: 272, tag: "−3" },
];

const levels = [
  { y: 168, label: t.level1 },
  { y: 236, label: t.level2 },
  { y: 312, label: t.level3 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {levels.map((l) => (
      <text x="10" y={l.y + 5} font-size="11" fill="var(--muted)">{l.label}</text>
    ))}

    {edges.map((e) => (
      <g>
        <line x1={e.x1} y1={e.y1 + 14} x2={e.x2} y2={e.y2 - 14} stroke="var(--muted)" stroke-width="1.5" />
        <text x={e.lx} y={e.ly} text-anchor="middle" font-size="11" fill="var(--accent)">{e.tag}</text>
      </g>
    ))}

    {nodes.map((n) => (
      <g>
        <rect x={n.x - 40} y={n.y - 15} width="80" height="30" rx="6" fill={n.leaf ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width={n.leaf ? 0 : 2} opacity={n.leaf ? 0.22 : 1} />
        <rect x={n.x - 40} y={n.y - 15} width="80" height="30" rx="6" fill="none" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="13" fill="var(--ink)">{n.label}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.leafRow}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
