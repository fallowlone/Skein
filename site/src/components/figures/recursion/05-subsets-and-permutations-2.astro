---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Permutation choice tree for {1, 2, 3}: branching 3, then 2, then 1, giving six orderings",
    headline: "PERMUTATIONS: 3 × 2 × 1 = 6",
    sub: "at each step pick which unused item goes next · 3! = 6",
    branch3: "3 choices",
    branch2: "2 choices",
    branch1: "1 choice",
    leafRow: "6 leaves = every ordering, each once",
    caption:
      "Position 0 has 3 choices for which item goes first, position 1 has 2 remaining, position 2 has 1: 3 × 2 × 1 = 3! = 6 leaves — 123, 132, 213, 231, 312, 321. Depth n, branching n, n−1, n−2…, n! leaves.",
  },
  ru: {
    svgTitle: "Дерево выбора перестановок для {1, 2, 3}: ветвление 3, потом 2, потом 1 — шесть упорядочений",
    headline: "ПЕРЕСТАНОВКИ: 3 × 2 × 1 = 6",
    sub: "на каждом шаге выбери, какой неиспользованный элемент идёт дальше · 3! = 6",
    branch3: "3 выбора",
    branch2: "2 выбора",
    branch1: "1 выбор",
    leafRow: "6 листьев = каждое упорядочение, каждое по разу",
    caption:
      "У позиции 0 есть 3 выбора, какой элемент идёт первым, у позиции 1 — 2 оставшихся, у позиции 2 — 1: 3 × 2 × 1 = 3! = 6 листьев — 123, 132, 213, 231, 312, 321. Глубина n, ветвление n, n−1, n−2…, n! листьев.",
  },
};

const t = dict[lang];

interface Node {
  x: number;
  y: number;
  label: string;
  leaf: boolean;
}

const nodes: Node[] = [
  { x: 400, y: 96, label: "[]", leaf: false },
  { x: 200, y: 166, label: "[1]", leaf: false },
  { x: 400, y: 166, label: "[2]", leaf: false },
  { x: 600, y: 166, label: "[3]", leaf: false },
  { x: 140, y: 244, label: "[1,2]", leaf: false },
  { x: 270, y: 244, label: "[1,3]", leaf: false },
  { x: 360, y: 244, label: "[2,1]", leaf: false },
  { x: 470, y: 244, label: "[2,3]", leaf: false },
  { x: 560, y: 244, label: "[3,1]", leaf: false },
  { x: 680, y: 244, label: "[3,2]", leaf: false },
  { x: 140, y: 326, label: "123", leaf: true },
  { x: 270, y: 326, label: "132", leaf: true },
  { x: 360, y: 326, label: "213", leaf: true },
  { x: 470, y: 326, label: "231", leaf: true },
  { x: 560, y: 326, label: "312", leaf: true },
  { x: 680, y: 326, label: "321", leaf: true },
];

interface Edge {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
}

const edges: Edge[] = [
  { x1: 400, y1: 96, x2: 200, y2: 166 },
  { x1: 400, y1: 96, x2: 400, y2: 166 },
  { x1: 400, y1: 96, x2: 600, y2: 166 },
  { x1: 200, y1: 166, x2: 140, y2: 244 },
  { x1: 200, y1: 166, x2: 270, y2: 244 },
  { x1: 400, y1: 166, x2: 360, y2: 244 },
  { x1: 400, y1: 166, x2: 470, y2: 244 },
  { x1: 600, y1: 166, x2: 560, y2: 244 },
  { x1: 600, y1: 166, x2: 680, y2: 244 },
  { x1: 140, y1: 244, x2: 140, y2: 326 },
  { x1: 270, y1: 244, x2: 270, y2: 326 },
  { x1: 360, y1: 244, x2: 360, y2: 326 },
  { x1: 470, y1: 244, x2: 470, y2: 326 },
  { x1: 560, y1: 244, x2: 560, y2: 326 },
  { x1: 680, y1: 244, x2: 680, y2: 326 },
];

const branches = [
  { y: 136, label: t.branch3 },
  { y: 210, label: t.branch2 },
  { y: 290, label: t.branch1 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1 + 14} x2={e.x2} y2={e.y2 - 14} stroke="var(--muted)" stroke-width="1.5" />
    ))}

    {branches.map((b) => (
      <text x="772" y={b.y} text-anchor="end" font-size="11" fill="var(--accent)">{b.label}</text>
    ))}

    {nodes.map((n) => (
      <g>
        <rect x={n.x - (n.leaf ? 36 : 42)} y={n.y - 15} width={n.leaf ? 72 : 84} height="30" rx="6" fill={n.leaf ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" opacity={n.leaf ? 0.22 : 1} />
        <rect x={n.x - (n.leaf ? 36 : 42)} y={n.y - 15} width={n.leaf ? 72 : 84} height="30" rx="6" fill="none" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="13" fill="var(--ink)">{n.label}</text>
      </g>
    ))}

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.leafRow}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
