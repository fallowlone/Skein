---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Backtracking template recap table and the pruning rule for combinations",
    headline: "ONE TEMPLATE, THREE CHOICE LOGICS",
    sub: "choose-explore-undo · the difference is loop logic and base case",
    colProblem: "problem",
    colLoop: "loop start",
    colBase: "base case",
    colCount: "outputs",
    rowSubsets: "subsets",
    rowPerms: "permutations",
    rowCombs: "combinations",
    loopSubsets: "depth-based",
    loopPerms: "0 (always)",
    loopCombs: "start index",
    pruneLabel: "prune when k is unreachable",
    pruneCode: "remaining = len(arr) − start · if current + remaining < k → return",
    caption:
      "Subsets branch include/exclude per element (depth-based, depth == n, 2^n outputs); permutations ask which unused item goes next (loop from 0, size == n, n! outputs); combinations include/skip in order (loop from start, size == k, C(n,k) outputs). The pruning rule stops a branch the moment current size plus remaining items cannot reach k.",
  },
  ru: {
    svgTitle: "Резюме таблицы шаблона backtracking и правило отсечения для комбинаций",
    headline: "ОДИН ШАБЛОН, ТРИ ЛОГИКИ ВЫБОРА",
    sub: "choose-explore-undo · разница в логике цикла и базовом случае",
    colProblem: "задача",
    colLoop: "начало цикла",
    colBase: "базовый случай",
    colCount: "выходы",
    rowSubsets: "подмножества",
    rowPerms: "перестановки",
    rowCombs: "комбинации",
    loopSubsets: "по глубине",
    loopPerms: "0 (всегда)",
    loopCombs: "индекс start",
    pruneLabel: "отсекай, когда k недостижимо",
    pruneCode: "remaining = len(arr) − start · if current + remaining < k → return",
    caption:
      "Подмножества ветвятся включить/исключить на элемент (по глубине, depth == n, 2^n выходов); перестановки спрашивают какой неиспользованный дальше (цикл с 0, size == n, n! выходов); комбинации включают/пропускают в порядке (цикл со start, size == k, C(n,k) выходов). Правило отсечения останавливает ветвь в момент, когда текущий размер плюс остаток не могут достичь k.",
  },
};

const t = dict[lang];

const rows = [
  { problem: t.rowSubsets, loop: t.loopSubsets, base: "depth == n", count: "2^n", y: 150 },
  { problem: t.rowPerms, loop: t.loopPerms, base: "size == n", count: "n!", y: 210 },
  { problem: t.rowCombs, loop: t.loopCombs, base: "size == k", count: "C(n,k)", y: 270 },
];

const cols = [60, 250, 440, 610];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="60" y="112" font-size="12" fill="var(--muted)">{t.colProblem}</text>
    <text x="250" y="112" font-size="12" fill="var(--muted)">{t.colLoop}</text>
    <text x="440" y="112" font-size="12" fill="var(--muted)">{t.colBase}</text>
    <text x="610" y="112" font-size="12" fill="var(--muted)">{t.colCount}</text>
    <line x1="48" y1="122" x2="752" y2="122" stroke="var(--ink)" stroke-width="1.5" />

    {rows.map((r) => (
      <text x="60" y={r.y} font-size="14" fill="var(--ink)">{r.problem}</text>
    ))}
    {rows.map((r) => (
      <text x="250" y={r.y} font-size="14" fill="var(--ink)">{r.loop}</text>
    ))}
    {rows.map((r) => (
      <text x="440" y={r.y} font-size="14" fill="var(--ink)">{r.base}</text>
    ))}
    {rows.map((r) => (
      <text x="610" y={r.y} font-size="14" fill="var(--accent)">{r.count}</text>
    ))}

    {cols.map((x) => (
      <line x1={x - 12} y1="132" x2={x - 12} y2="300" stroke="var(--muted)" stroke-width="1" opacity="0.4" />
    ))}
    <line x1="48" y1="300" x2="752" y2="300" stroke="var(--ink)" stroke-width="1.5" />

    <rect x="48" y="322" width="704" height="62" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.pruneLabel}</text>
    <text x="400" y="368" text-anchor="middle" font-size="14" fill="var(--ink)">{t.pruneCode}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
