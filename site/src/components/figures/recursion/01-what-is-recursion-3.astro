---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Factorial by iteration versus recursion with time and space costs",
    headline: "RECURSION VS ITERATION",
    sub: "same problem, same O(n) time — different space",
    iterLabel: "ITERATION",
    iterTime: "time O(n)",
    iterSpace: "space O(1)",
    iterNote: "no call stack",
    recLabel: "RECURSION",
    recTime: "time O(n)",
    recSpace: "space O(n)",
    recNote: "n calls on the stack",
    verdict: "recursion trades space for clarity on self-similar problems",
    caption:
      "Factorial by loop (result = 1; for i from 2 to 4: result = result × i) costs O(n) time and O(1) space — no call stack. Factorial by recursion costs O(n) time and O(n) space, one stack frame per call from n down to 1. Recursion trades space for clarity when the problem breaks into smaller copies of itself: trees, graphs, permutations, divide-and-conquer.",
  },
  ru: {
    svgTitle: "Факториал итерацией и рекурсией: время и память",
    headline: "РЕКУРСИЯ ПРОТИВ ИТЕРАЦИИ",
    sub: "та же задача, то же O(n) времени — разная память",
    iterLabel: "ИТЕРАЦИЯ",
    iterTime: "время O(n)",
    iterSpace: "память O(1)",
    iterNote: "без стека вызовов",
    recLabel: "РЕКУРСИЯ",
    recTime: "время O(n)",
    recSpace: "память O(n)",
    recNote: "n вызовов на стеке",
    verdict: "рекурсия меняет память на ясность для самоподобных задач",
    caption:
      "Факториал циклом (result = 1; for i от 2 до 4: result = result × i) стоит O(n) времени и O(1) памяти — без стека вызовов. Факториал рекурсией стоит O(n) времени и O(n) памяти, один кадр стека на вызов от n вниз до 1. Рекурсия меняет память на ясность, когда задача разбивается на меньшие копии самой себя: деревья, графы, перестановки, разделяй-и-властвуй.",
  },
};

const t = dict[lang];

const iterCode = ["result = 1", "for i from 2 to 4:", "  result = result × i", "return result"];
const recCode = ["if (n <= 1) return 1;", "return n * factorial(n - 1);"];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="86" width="320" height="252" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="80" y="114" font-family="var(--font-display)" font-size="16" fill="var(--accent)">{t.iterLabel}</text>
    {iterCode.map((line, i) => (
      <text x="80" y={140 + i * 24} font-size="13" fill="var(--ink)">{line}</text>
    ))}
    <line x1="80" y1="248" x2="360" y2="248" stroke="var(--muted)" stroke-width="1" />
    <text x="80" y="272" font-size="13" fill="var(--ink)">{t.iterTime}</text>
    <text x="80" y="294" font-size="13" fill="var(--ink)">{t.iterSpace}</text>
    <text x="80" y="318" font-size="12" fill="var(--muted)">{t.iterNote}</text>

    <rect x="420" y="86" width="320" height="252" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="440" y="114" font-family="var(--font-display)" font-size="16" fill="var(--accent)">{t.recLabel}</text>
    {recCode.map((line, i) => (
      <text x="440" y={140 + i * 24} font-size="13" fill="var(--ink)">{line}</text>
    ))}
    <rect x="440" y="196" width="120" height="30" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="500" y="217" text-anchor="middle" font-size="12" fill="var(--ink)">n … 3 · 2 · 1</text>
    <line x1="440" y1="248" x2="720" y2="248" stroke="var(--muted)" stroke-width="1" />
    <text x="440" y="272" font-size="13" fill="var(--ink)">{t.recTime}</text>
    <text x="440" y="294" font-size="13" fill="var(--ink)">{t.recSpace}</text>
    <text x="440" y="318" font-size="12" fill="var(--muted)">{t.recNote}</text>

    <text x="400" y="380" text-anchor="middle" font-size="13" fill="var(--ink)">{t.verdict}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
