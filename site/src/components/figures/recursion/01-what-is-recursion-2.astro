---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Trace of factorial 4: shrink down to the base case, combine up",
    headline: "SHRINK DOWN, COMBINE UP",
    sub: "trace factorial(4): each call shrinks toward 1, then answers combine on return",
    shrinkLabel: "shrink ↓",
    combineLabel: "↑ combine",
    baseTag: "BASE",
    rows: [
      { call: "factorial(4)", need: "need 4 × factorial(3)", ret: "return 4 × 6 = 24" },
      { call: "factorial(3)", need: "need 3 × factorial(2)", ret: "return 3 × 2 = 6" },
      { call: "factorial(2)", need: "need 2 × factorial(1)", ret: "return 2 × 1 = 2" },
      { call: "factorial(1)", need: "stop: no further call", ret: "return 1" },
    ],
    note: "the chain unwinds: 1 → 2 × 1 = 2 → 3 × 2 = 6 → 4 × 6 = 24",
    caption:
      "Tracing factorial(4): factorial(4) needs 4 × factorial(3), factorial(3) needs 3 × factorial(2), factorial(2) needs 2 × factorial(1), and factorial(1) hits the base case and returns 1. Then the chain unwinds: 2 × 1 = 2, 3 × 2 = 6, 4 × 6 = 24.",
  },
  ru: {
    svgTitle: "Трассировка factorial 4: сжатие к базе и комбинирование на возврате",
    headline: "СЖАТИЕ ВНИЗ, КОМБИНИРОВАНИЕ ВВЕРХ",
    sub: "трассировка factorial(4): каждый вызов сжимается к 1, потом ответы комбинируются",
    shrinkLabel: "сжатие ↓",
    combineLabel: "↑ подъём",
    baseTag: "БАЗА",
    rows: [
      { call: "factorial(4)", need: "нужно 4 × factorial(3)", ret: "return 4 × 6 = 24" },
      { call: "factorial(3)", need: "нужно 3 × factorial(2)", ret: "return 3 × 2 = 6" },
      { call: "factorial(2)", need: "нужно 2 × factorial(1)", ret: "return 2 × 1 = 2" },
      { call: "factorial(1)", need: "стоп: дальше вызовов нет", ret: "return 1" },
    ],
    note: "цепь разворачивается: 1 → 2 × 1 = 2 → 3 × 2 = 6 → 4 × 6 = 24",
    caption:
      "Трассировка factorial(4): factorial(4) нужно 4 × factorial(3), factorial(3) нужно 3 × factorial(2), factorial(2) нужно 2 × factorial(1), а factorial(1) попадает в базовый случай и возвращает 1. Потом цепь разворачивается: 2 × 1 = 2, 3 × 2 = 6, 4 × 6 = 24.",
  },
};

const t = dict[lang];

const rowY = (i: number) => 96 + i * 70;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="80" y="84" text-anchor="middle" font-size="12" fill="var(--accent)">{t.shrinkLabel}</text>
    <text x="720" y="84" text-anchor="middle" font-size="12" fill="var(--accent)">{t.combineLabel}</text>

    {t.rows.map((r, i) => (
      <g>
        <rect x="290" y={rowY(i)} width="220" height="52" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="400" y={rowY(i) + 30} text-anchor="middle" font-size="15" fill="var(--ink)">{r.call}</text>
        <text x="278" y={rowY(i) + 30} text-anchor="end" font-size="12" fill="var(--muted)">{r.need}</text>
        <text x="522" y={rowY(i) + 30} text-anchor="start" font-size="12" fill="var(--muted)">{r.ret}</text>
      </g>
    ))}

    <line x1="80" y1="100" x2="80" y2="300" stroke="var(--accent)" stroke-width="2" />
    <polygon points="72,300 88,300 80,312" fill="var(--accent)" />
    <line x1="720" y1="306" x2="720" y2="106" stroke="var(--accent)" stroke-width="2" />
    <polygon points="712,106 728,106 720,94" fill="var(--accent)" />

    <text x="400" y={rowY(3) + 66} text-anchor="middle" font-size="12" fill="var(--accent)">{t.baseTag}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--ink)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
