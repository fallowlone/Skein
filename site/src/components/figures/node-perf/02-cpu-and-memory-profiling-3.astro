---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three-snapshot leak hunt: baseline, exercise the path, snapshot twice more, compare to find the only-growing constructor, then sort by retained size and follow the retainer path",
    headline: "THREE SNAPSHOTS — FIND THE ONLY-GROWER",
    sub: "baseline → load → snapshot → repeat",
    snap1a: "snap-1 — baseline",
    snap1b: "after warm-up",
    snap2a: "snap-2 — after load",
    snap2b: "times: 5000",
    snap3a: "snap-3 — repeat",
    snap3b: "times: 5000",
    push: "exercise ×5000",
    compareBox: "Comparison — Objects allocated between snapshots",
    sortBox: "sort by retained size",
    retainerBox: "follow retainer path → Map",
    foot: "cut the reference — LRU eviction / removeListener",
    caption:
      "Take three heap snapshots around the exercised path, use the comparison view to find the only-growing constructor, then sort by retained size and follow the retainer path to the cache.",
  },
  ru: {
    svgTitle: "Охота на утечку тремя снимками: базис, нагрузить путь, снять ещё дважды, сравнить и найти только растущего, затем сортировать по retained size и идти по retainer path",
    headline: "ТРИ СНИМКА — НАЙДИ ТОЛЬКО РАСТУЩЕГО",
    sub: "базис → нагрузка → снимок → повтор",
    snap1a: "snap-1 — базис",
    snap1b: "после прогрева",
    snap2a: "snap-2 — после нагрузки",
    snap2b: "times: 5000",
    snap3a: "snap-3 — повтор",
    snap3b: "times: 5000",
    push: "нагрузи ×5000",
    compareBox: "Comparison — Objects allocated between snapshots",
    sortBox: "сортируй по retained size",
    retainerBox: "иди по retainer path → Map",
    foot: "обрежь ссылку — LRU-вытеснение / removeListener",
    caption:
      "Сними три heap-снимка вокруг нагруженного пути, видом сравнения найди только растущий конструктор, затем сортируй по retained size и иди по retainer path к кэшу.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="np6" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="50" y="96" width="180" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="140" y="119" text-anchor="middle" font-size="11" fill="var(--ink)">{t.snap1a}</text>
    <text x="140" y="139" text-anchor="middle" font-size="11" fill="var(--ink)">{t.snap1b}</text>
    <line x1="236" y1="124" x2="304" y2="124" stroke="var(--muted)" stroke-width="2" marker-end="url(#np6)" />
    <text x="270" y="84" text-anchor="middle" font-size="11" fill="var(--muted)">{t.push}</text>
    <rect x="310" y="96" width="180" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="119" text-anchor="middle" font-size="11" fill="var(--ink)">{t.snap2a}</text>
    <text x="400" y="139" text-anchor="middle" font-size="11" fill="var(--ink)">{t.snap2b}</text>
    <line x1="496" y1="124" x2="564" y2="124" stroke="var(--muted)" stroke-width="2" marker-end="url(#np6)" />
    <text x="530" y="84" text-anchor="middle" font-size="11" fill="var(--muted)">{t.push}</text>
    <rect x="570" y="96" width="180" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="660" y="119" text-anchor="middle" font-size="11" fill="var(--ink)">{t.snap3a}</text>
    <text x="660" y="139" text-anchor="middle" font-size="11" fill="var(--ink)">{t.snap3b}</text>

    <line x1="400" y1="158" x2="400" y2="182" stroke="var(--muted)" stroke-width="2" marker-end="url(#np6)" />
    <rect x="200" y="188" width="400" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="219" text-anchor="middle" font-size="11" fill="var(--ink)">{t.compareBox}</text>

    <line x1="300" y1="246" x2="300" y2="266" stroke="var(--muted)" stroke-width="2" marker-end="url(#np6)" />
    <line x1="500" y1="246" x2="500" y2="266" stroke="var(--muted)" stroke-width="2" marker-end="url(#np6)" />
    <rect x="90" y="272" width="250" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="215" y="305" text-anchor="middle" font-size="11" fill="var(--ink)">{t.sortBox}</text>
    <rect x="460" y="272" width="250" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="585" y="305" text-anchor="middle" font-size="11" fill="var(--ink)">{t.retainerBox}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
