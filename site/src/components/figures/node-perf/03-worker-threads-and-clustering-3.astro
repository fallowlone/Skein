---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "I/O-bound work needs nothing, CPU work with shared in-process data wants a worker_threads pool sized to the cores, and a stateless network server wants cluster or replicas",
    headline: "MATCH THE TOOL TO THE BOTTLENECK",
    sub: "CPU, I/O, or server?",
    question1: "What limits",
    question2: "your scale?",
    box1a: "I/O-bound",
    box1b: "do nothing",
    box1c: "loop never blocks",
    box2a: "CPU + shared data",
    box2b: "worker_threads pool",
    box2c: "size ≈ availableParallelism()",
    box3a: "stateless server",
    box3b: "cluster or replicas",
    box3c: "state moves outward",
    foot: "pure I/O needs neither — pool the CPU, replicate the server",
    caption:
      "I/O-bound work needs nothing because the loop never blocks, CPU work with shared in-process data wants a worker_threads pool sized to the cores and never one worker per request, and a stateless network server wants cluster or replicas with state in a shared store.",
  },
  ru: {
    svgTitle: "I/O-bound работе не нужно ничего, CPU-работе с общими данными в процессе нужен пул worker_threads размером по числу ядер, а stateless-серверу — cluster или реплики",
    headline: "ПОДБЕРИ ИНСТРУМЕНТ ПОД УЗКОЕ МЕСТО",
    sub: "CPU, I/O или сервер?",
    question1: "Что ограничивает",
    question2: "масштаб?",
    box1a: "I/O-bound",
    box1b: "не делай ничего",
    box1c: "loop не блокируется",
    box2a: "CPU + общие данные",
    box2b: "пул worker_threads",
    box2c: "размер ≈ availableParallelism()",
    box3a: "stateless-сервер",
    box3b: "cluster или реплики",
    box3c: "состояние — вовне",
    foot: "чистому I/O не нужно ничего — CPU запули, сервер масштабируй",
    caption:
      "I/O-bound работе не нужно ничего, потому что loop не блокируется, CPU-работе с общими данными в процессе нужен пул worker_threads размером по числу ядер, а не воркер на запрос, а stateless-серверу — cluster или реплики с состоянием в общем хранилище.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="np9a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <polygon points="400,78 520,125 400,172 280,125" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="118" text-anchor="middle" font-size="12" fill="var(--ink)">{t.question1}</text>
    <text x="400" y="138" text-anchor="middle" font-size="12" fill="var(--ink)">{t.question2}</text>

    <line x1="330" y1="165" x2="140" y2="234" stroke="var(--muted)" stroke-width="2" marker-end="url(#np9a)" />
    <line x1="400" y1="182" x2="395" y2="234" stroke="var(--muted)" stroke-width="2" marker-end="url(#np9a)" />
    <line x1="470" y1="165" x2="650" y2="234" stroke="var(--muted)" stroke-width="2" marker-end="url(#np9a)" />

    <rect x="30" y="240" width="200" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="130" y="274" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1a}</text>
    <text x="130" y="296" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1b}</text>
    <text x="130" y="318" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1c}</text>
    <rect x="255" y="240" width="250" height="100" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="380" y="274" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2a}</text>
    <text x="380" y="296" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2b}</text>
    <text x="380" y="318" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2c}</text>
    <rect x="530" y="240" width="230" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="645" y="274" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3a}</text>
    <text x="645" y="296" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3b}</text>
    <text x="645" y="318" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3c}</text>

    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
