---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Monitoring signals: unrelated routes spiking together means read p99 with monitorEventLoopDelay, a slow hot-path operation means mark and measure, overload means shed load with 503",
    headline: "WHAT TO ALERT ON",
    sub: "symptom → metric → tool",
    lane1: "signal 1",
    lane2: "signal 2",
    lane3: "signal 3",
    s1a: "unrelated routes",
    s1b: "spike together",
    m1a: "p99 / max loop lag",
    m1b: "(not the mean)",
    tool1: "monitorEventLoopDelay",
    s2a: "one slow op",
    s2b: "on the hot path",
    m2a: "marked span",
    m2b: "duration",
    tool2a: "mark / measure",
    tool2b: "+ observer",
    s3a: "service overloaded,",
    s3b: "tail exploding",
    m3a: "live lag",
    m3b: "vs threshold",
    tool3a: "toobusy-js",
    tool3b: "shed load: 503",
    foot1: "sub-ms p99 is healthy — tens to hundreds of ms users feel",
    foot2: "past the threshold, reject new work with 503",
    caption:
      "Unrelated routes spiking together calls for p99/max loop lag via monitorEventLoopDelay; one slow hot-path operation calls for mark/measure with an observer; overload calls for shedding load with 503 past a lag threshold.",
  },
  ru: {
    svgTitle: "Сигналы мониторинга: не связанные маршруты прыгают вместе — читай p99 через monitorEventLoopDelay, медленная операция на горячем пути — mark и measure, перегрузка — сбрасывай нагрузку с 503",
    headline: "НА ЧТО АЛЕРТИТЬСЯ",
    sub: "симптом → метрика → инструмент",
    lane1: "сигнал 1",
    lane2: "сигнал 2",
    lane3: "сигнал 3",
    s1a: "не связанные маршруты",
    s1b: "прыгают вместе",
    m1a: "p99 / max задержки",
    m1b: "(не среднее)",
    tool1: "monitorEventLoopDelay",
    s2a: "одна операция медленна",
    s2b: "на горячем пути",
    m2a: "длительность",
    m2b: "размеченного спана",
    tool2a: "mark / measure",
    tool2b: "+ observer",
    s3a: "сервис перегружен,",
    s3b: "хвост взрывается",
    m3a: "живая задержка",
    m3b: "vs порога",
    tool3a: "toobusy-js",
    tool3b: "сброс нагрузки: 503",
    foot1: "субмиллисекундный p99 — здоровье, десятки-сотни мс чувствуют пользователи",
    foot2: "за порогом отклоняй новую работу с 503",
    caption:
      "Не связанные маршруты прыгают вместе — читай p99/max задержки через monitorEventLoopDelay; одна медленная операция на горячем пути — mark/measure с observer; перегрузка — сбрасывай нагрузку с 503 за порогом задержки.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="np3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="126" text-anchor="end" font-size="11" fill="var(--muted)">{t.lane1}</text>
    <rect x="180" y="92" width="190" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="275" y="116" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s1a}</text>
    <text x="275" y="136" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s1b}</text>
    <line x1="374" y1="122" x2="390" y2="122" stroke="var(--muted)" stroke-width="2" marker-end="url(#np3)" />
    <rect x="394" y="92" width="190" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="489" y="116" text-anchor="middle" font-size="11" fill="var(--ink)">{t.m1a}</text>
    <text x="489" y="136" text-anchor="middle" font-size="11" fill="var(--ink)">{t.m1b}</text>
    <line x1="588" y1="122" x2="604" y2="122" stroke="var(--muted)" stroke-width="2" marker-end="url(#np3)" />
    <rect x="608" y="92" width="172" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="694" y="126" text-anchor="middle" font-size="10" fill="var(--ink)">{t.tool1}</text>

    <text x="150" y="216" text-anchor="end" font-size="11" fill="var(--muted)">{t.lane2}</text>
    <rect x="180" y="182" width="190" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="275" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s2a}</text>
    <text x="275" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s2b}</text>
    <line x1="374" y1="212" x2="390" y2="212" stroke="var(--muted)" stroke-width="2" marker-end="url(#np3)" />
    <rect x="394" y="182" width="190" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="489" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.m2a}</text>
    <text x="489" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.m2b}</text>
    <line x1="588" y1="212" x2="604" y2="212" stroke="var(--muted)" stroke-width="2" marker-end="url(#np3)" />
    <rect x="608" y="182" width="172" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="694" y="206" text-anchor="middle" font-size="11" fill="var(--ink)">{t.tool2a}</text>
    <text x="694" y="226" text-anchor="middle" font-size="11" fill="var(--ink)">{t.tool2b}</text>

    <text x="150" y="306" text-anchor="end" font-size="11" fill="var(--muted)">{t.lane3}</text>
    <rect x="180" y="272" width="190" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="275" y="296" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s3a}</text>
    <text x="275" y="316" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s3b}</text>
    <line x1="374" y1="302" x2="390" y2="302" stroke="var(--muted)" stroke-width="2" marker-end="url(#np3)" />
    <rect x="394" y="272" width="190" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="489" y="296" text-anchor="middle" font-size="11" fill="var(--ink)">{t.m3a}</text>
    <text x="489" y="316" text-anchor="middle" font-size="11" fill="var(--ink)">{t.m3b}</text>
    <line x1="588" y1="302" x2="604" y2="302" stroke="var(--muted)" stroke-width="2" marker-end="url(#np3)" />
    <rect x="608" y="272" width="172" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="694" y="296" text-anchor="middle" font-size="11" fill="var(--ink)">{t.tool3a}</text>
    <text x="694" y="316" text-anchor="middle" font-size="11" fill="var(--ink)">{t.tool3b}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="396" text-anchor="middle" font-size="12" fill="var(--accent)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
