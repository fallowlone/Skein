---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Healthy heap sawtooths down after a full Mark-Sweep, while a leaking heap staircases from 1850 to 1845 MB and never drops",
    headline: "SAWTOOTH vs STAIRCASE",
    sub: "does old space drop after a full GC?",
    panelLeft: "sawtooth — healthy",
    panelRight: "staircase — leak",
    leftLine: "drops after Mark-Sweep",
    rightLine: "1850 → 1845 MB — barely drops",
    verdictLeft: "raise --max-old-space-size",
    verdictRight: "take three snapshots",
    foot: "watch --trace-gc: Mark-Sweep 1850.2 → 1844.9 MB",
    caption:
      "A healthy heap sawtooths down after a full GC, so raise the heap limit; a leaking heap staircases from 1850 to 1845 MB, so take three snapshots.",
  },
  ru: {
    svgTitle: "Здоровая куча пилит вниз после полного Mark-Sweep, а текущая лестничит с 1850 до 1845 МБ и никогда не падает",
    headline: "«ПИЛА» vs «ЛЕСТНИЦА»",
    sub: "падает ли old space после полного GC?",
    panelLeft: "«пила» — здоровый",
    panelRight: "«лестница» — утечка",
    leftLine: "резко падает после Mark-Sweep",
    rightLine: "1850 → 1845 МБ — почти не падает",
    verdictLeft: "подними --max-old-space-size",
    verdictRight: "сними три снимка",
    foot: "смотри --trace-gc: Mark-Sweep 1850.2 → 1844.9 МБ",
    caption:
      "Здоровая куча пилит вниз после полного GC — подними лимит кучи; текущая куча лестничит с 1850 до 1845 МБ — снимай три снимка.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="np5" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="220" y="80" text-anchor="middle" font-size="12" fill="var(--muted)">{t.panelLeft}</text>
    <rect x="60" y="100" width="320" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <polyline points="90,230 140,230 140,150 190,150 190,230 240,230 240,150 290,150 290,230 350,230" fill="none" stroke="var(--accent)" stroke-width="2" />
    <text x="220" y="252" text-anchor="middle" font-size="11" fill="var(--ink)">{t.leftLine}</text>

    <text x="580" y="80" text-anchor="middle" font-size="12" fill="var(--muted)">{t.panelRight}</text>
    <rect x="420" y="100" width="320" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <polyline points="450,215 510,215 510,195 570,195 570,178 630,178 630,162 700,162" fill="none" stroke="var(--muted)" stroke-width="2" />
    <line x1="630" y1="188" x2="630" y2="212" stroke="var(--muted)" stroke-width="2" marker-end="url(#np5)" />
    <text x="580" y="245" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightLine}</text>

    <text x="220" y="305" text-anchor="middle" font-size="12" fill="var(--accent)">{t.verdictLeft}</text>
    <text x="580" y="305" text-anchor="middle" font-size="12" fill="var(--ink)">{t.verdictRight}</text>

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
