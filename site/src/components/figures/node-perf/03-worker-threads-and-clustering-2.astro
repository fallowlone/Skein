---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Every postMessage payload is structured-cloned at a cost proportional to size, while the transfer list moves an ArrayBuffer zero-copy and SharedArrayBuffer needs no clone at all",
    headline: "POSTMESSAGE COPIES — TRANSFER SHARES",
    sub: "what a message costs",
    laneClone: "postMessage",
    laneTransfer: "transfer list",
    laneShared: "shared",
    sender: "parent",
    receiver: "worker",
    cloneNote: "clone: copies 50 MB",
    fateClone: "costly if large",
    transferNote: "zero-copy",
    transferCode: "postMessage({ ab }, [ab])",
    fateTransfer: "ab detached here",
    threadA: "thread A",
    threadB: "thread B",
    sharedBox: "SharedArrayBuffer + Atomics — no clone",
    fateShared: "no copy",
    caption:
      "Every postMessage payload is structured-cloned at a cost proportional to size — sending 50 MB copies 50 MB — while the transfer list moves an ArrayBuffer zero-copy and SharedArrayBuffer needs no clone at all.",
  },
  ru: {
    svgTitle: "Каждая полезная нагрузка postMessage структурно клонируется с ценой пропорционально размеру, а transfer-лист переносит ArrayBuffer zero-copy, и SharedArrayBuffer вообще не требует клонирования",
    headline: "POSTMESSAGE КОПИРУЕТ — TRANSFER ДЕЛИТСЯ",
    sub: "сколько стоит сообщение",
    laneClone: "postMessage",
    laneTransfer: "transfer-лист",
    laneShared: "общая память",
    sender: "родитель",
    receiver: "воркер",
    cloneNote: "клон: копия 50 МБ",
    fateClone: "дорого для больших",
    transferNote: "zero-copy",
    transferCode: "postMessage({ ab }, [ab])",
    fateTransfer: "ab здесь detached",
    threadA: "поток A",
    threadB: "поток B",
    sharedBox: "SharedArrayBuffer + Atomics — без клонирования",
    fateShared: "без копии",
    caption:
      "Каждая полезная нагрузка postMessage структурно клонируется с ценой пропорционально размеру — отправка 50 МБ копирует 50 МБ, — а transfer-лист переносит ArrayBuffer zero-copy, и SharedArrayBuffer вообще не требует клонирования.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="np8a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="160" y="152" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneClone}</text>
    <rect x="180" y="116" width="110" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="235" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.sender}</text>
    <text x="400" y="132" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cloneNote}</text>
    <line x1="296" y1="148" x2="504" y2="148" stroke="var(--muted)" stroke-width="2" marker-end="url(#np8a)" />
    <rect x="510" y="116" width="140" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="580" y="152" text-anchor="middle" font-size="11" fill="var(--ink)">{t.receiver}</text>
    <text x="790" y="152" text-anchor="end" font-size="11" fill="var(--accent)">{t.fateClone}</text>

    <text x="160" y="247" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneTransfer}</text>
    <rect x="180" y="211" width="110" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="235" y="247" text-anchor="middle" font-size="11" fill="var(--ink)">{t.sender}</text>
    <text x="400" y="227" text-anchor="middle" font-size="11" fill="var(--muted)">{t.transferNote}</text>
    <line x1="296" y1="243" x2="504" y2="243" stroke="var(--muted)" stroke-width="2" marker-end="url(#np8a)" />
    <text x="400" y="264" text-anchor="middle" font-size="11" fill="var(--ink)">{t.transferCode}</text>
    <rect x="510" y="211" width="140" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="580" y="247" text-anchor="middle" font-size="11" fill="var(--ink)">{t.receiver}</text>
    <text x="670" y="247" font-size="11" fill="var(--ink)">{t.fateTransfer}</text>

    <text x="160" y="329" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneShared}</text>
    <rect x="220" y="302" width="120" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="280" y="329" text-anchor="middle" font-size="11" fill="var(--ink)">{t.threadA}</text>
    <rect x="500" y="302" width="120" height="44" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="560" y="329" text-anchor="middle" font-size="11" fill="var(--ink)">{t.threadB}</text>
    <line x1="280" y1="350" x2="280" y2="360" stroke="var(--muted)" stroke-width="2" marker-end="url(#np8a)" />
    <line x1="560" y1="350" x2="560" y2="360" stroke="var(--muted)" stroke-width="2" marker-end="url(#np8a)" />
    <rect x="180" y="366" width="460" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="410" y="391" text-anchor="middle" font-size="11" fill="var(--ink)">{t.sharedBox}</text>
    <text x="662" y="391" font-size="11" fill="var(--accent)">{t.fateShared}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
