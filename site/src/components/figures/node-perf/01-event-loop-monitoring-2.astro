---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Event loop phases timers, pending, poll, check, close, and the blocking calls that stall them: gzipSync, pbkdf2Sync, JSON parse, readFileSync",
    headline: "LOOP PHASES + BLOCKERS",
    sub: "lag accrues wherever a callback overstays",
    timersSub1: "setTimeout /",
    timersSub2: "setInterval",
    pendingSub1: "deferred",
    pendingSub2: "system callbacks",
    pollSub: "I/O + waiting",
    checkSub: "setImmediate",
    closeSub: "socket close",
    block1a: "zlib.gzipSync",
    block1b: "~250 ms of CPU",
    block2a: "crypto.pbkdf2Sync",
    block2b: "sync, holds thread",
    block3a: "JSON.parse, 5 MB",
    block3b: "sync, holds thread",
    block4a: "fs.readFileSync",
    block4b: "cold disk",
    foot1: "one 250 ms block adds up to 250 ms to a chunk of 200 in-flight requests",
    foot2: "recursive nextTick starves I/O — poll never runs again",
    caption:
      "The loop drains fixed phases — timers, pending, poll, check, close — and lag accrues wherever a callback overstays: one 250 ms synchronous block stalls every queued callback, and a recursive nextTick starves I/O entirely.",
  },
  ru: {
    svgTitle: "Фазы event loop timers, pending, poll, check, close и блокирующие вызовы, что их стопорят: gzipSync, pbkdf2Sync, JSON parse, readFileSync",
    headline: "ФАЗЫ LOOP + БЛОКИРОВКИ",
    sub: "задержка копится везде, где колбэк засиделся",
    timersSub1: "setTimeout /",
    timersSub2: "setInterval",
    pendingSub1: "отложенные",
    pendingSub2: "системные",
    pollSub: "I/O + ожидание",
    checkSub: "setImmediate",
    closeSub: "socket close",
    block1a: "zlib.gzipSync",
    block1b: "~250 мс чистого CPU",
    block2a: "crypto.pbkdf2Sync",
    block2b: "sync, держит поток",
    block3a: "JSON.parse, 5 МБ",
    block3b: "sync, держит поток",
    block4a: "fs.readFileSync",
    block4b: "холодный диск",
    foot1: "один блок 250 мс добавляет до 250 мс куску из 200 запросов в полёте",
    foot2: "рекурсивный nextTick морит I/O — poll больше никогда не бежит",
    caption:
      "Loop сливает фиксированные фазы — timers, pending, poll, check, close — а задержка копится везде, где колбэк засиделся: один синхронный блок на 250 мс стопорит все колбэки в очереди, а рекурсивный nextTick полностью морит I/O.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="np2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="26" y="100" width="132" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="92" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">timers</text>
    <text x="92" y="144" text-anchor="middle" font-size="10" fill="var(--ink)">{t.timersSub1}</text>
    <text x="92" y="158" text-anchor="middle" font-size="10" fill="var(--ink)">{t.timersSub2}</text>
    <line x1="160" y1="132" x2="176" y2="132" stroke="var(--muted)" stroke-width="2" marker-end="url(#np2)" />

    <rect x="178" y="100" width="132" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="244" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">pending</text>
    <text x="244" y="144" text-anchor="middle" font-size="10" fill="var(--ink)">{t.pendingSub1}</text>
    <text x="244" y="158" text-anchor="middle" font-size="10" fill="var(--ink)">{t.pendingSub2}</text>
    <line x1="312" y1="132" x2="328" y2="132" stroke="var(--muted)" stroke-width="2" marker-end="url(#np2)" />

    <rect x="330" y="100" width="132" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="396" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">poll</text>
    <text x="396" y="150" text-anchor="middle" font-size="10" fill="var(--ink)">{t.pollSub}</text>
    <line x1="464" y1="132" x2="480" y2="132" stroke="var(--muted)" stroke-width="2" marker-end="url(#np2)" />

    <rect x="482" y="100" width="132" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="548" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">check</text>
    <text x="548" y="150" text-anchor="middle" font-size="10" fill="var(--ink)">{t.checkSub}</text>
    <line x1="616" y1="132" x2="632" y2="132" stroke="var(--muted)" stroke-width="2" marker-end="url(#np2)" />

    <rect x="634" y="100" width="132" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="700" y="126" text-anchor="middle" font-size="12" fill="var(--ink)">close</text>
    <text x="700" y="150" text-anchor="middle" font-size="10" fill="var(--ink)">{t.closeSub}</text>

    <rect x="40" y="220" width="170" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="125" y="246" text-anchor="middle" font-size="11" fill="var(--ink)">{t.block1a}</text>
    <text x="125" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.block1b}</text>

    <rect x="225" y="220" width="170" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="310" y="246" text-anchor="middle" font-size="11" fill="var(--ink)">{t.block2a}</text>
    <text x="310" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.block2b}</text>

    <rect x="410" y="220" width="170" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="495" y="246" text-anchor="middle" font-size="11" fill="var(--ink)">{t.block3a}</text>
    <text x="495" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.block3b}</text>

    <rect x="595" y="220" width="170" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="680" y="246" text-anchor="middle" font-size="11" fill="var(--ink)">{t.block4a}</text>
    <text x="680" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.block4b}</text>

    <text x="400" y="335" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
