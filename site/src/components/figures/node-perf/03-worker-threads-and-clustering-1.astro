---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "worker_threads are threads in one process sharing bytes via SharedArrayBuffer, while cluster forks separate processes with isolated memory sharing only one listen socket",
    headline: "SHARED MEMORY vs SHARED SOCKET",
    sub: "worker_threads against cluster",
    laneThreads: "worker_threads",
    thread: "thread",
    sharedStrip: "SharedArrayBuffer + Atomics — shared bytes",
    fateThreads: "memory shared",
    laneCluster: "cluster",
    primary1: "primary",
    primary2: "forks N",
    worker1: "worker",
    worker2: "own memory",
    socket: "shared listen socket",
    fateCluster: "memory not shared — external store",
    foot: "threads share bytes — processes share only a socket",
    caption:
      "worker_threads are threads in one process that share bytes via SharedArrayBuffer, while cluster forks separate processes with isolated memory that share only one listen socket.",
  },
  ru: {
    svgTitle: "worker_threads — это потоки в одном процессе, делящие байты через SharedArrayBuffer, а cluster форкает отдельные процессы с изолированной памятью, делящие только один слушающий сокет",
    headline: "ОБЩАЯ ПАМЯТЬ vs ОБЩИЙ СОКЕТ",
    sub: "worker_threads против cluster",
    laneThreads: "worker_threads",
    thread: "поток",
    sharedStrip: "SharedArrayBuffer + Atomics — общие байты",
    fateThreads: "память общая",
    laneCluster: "cluster",
    primary1: "главный",
    primary2: "форкает N",
    worker1: "воркер",
    worker2: "своя память",
    socket: "общий слушающий сокет",
    fateCluster: "память не делится — внешнее хранилище",
    foot: "потоки делят байты — процессы делят только сокет",
    caption:
      "worker_threads — это потоки в одном процессе, делящие байты через SharedArrayBuffer, а cluster форкает отдельные процессы с изолированной памятью, делящие только один слушающий сокет.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="np7a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="170" y="152" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneThreads}</text>
    <rect x="190" y="92" width="440" height="112" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <rect x="205" y="106" width="125" height="46" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="267" y="134" text-anchor="middle" font-size="11" fill="var(--ink)">{t.thread}</text>
    <rect x="342" y="106" width="125" height="46" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="404" y="134" text-anchor="middle" font-size="11" fill="var(--ink)">{t.thread}</text>
    <rect x="479" y="106" width="125" height="46" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="541" y="134" text-anchor="middle" font-size="11" fill="var(--ink)">{t.thread}</text>
    <rect x="205" y="162" width="399" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="404" y="182" text-anchor="middle" font-size="11" fill="var(--ink)">{t.sharedStrip}</text>
    <text x="652" y="152" font-size="11" fill="var(--accent)">{t.fateThreads}</text>

    <text x="400" y="226" text-anchor="middle" font-size="11" fill="var(--muted)">{t.socket}</text>
    <text x="170" y="286" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneCluster}</text>
    <rect x="190" y="250" width="140" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="260" y="276" text-anchor="middle" font-size="11" fill="var(--ink)">{t.primary1}</text>
    <text x="260" y="298" text-anchor="middle" font-size="11" fill="var(--ink)">{t.primary2}</text>
    <line x1="336" y1="282" x2="360" y2="282" stroke="var(--muted)" stroke-width="2" marker-end="url(#np7a)" />
    <rect x="366" y="250" width="118" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="425" y="276" text-anchor="middle" font-size="11" fill="var(--ink)">{t.worker1}</text>
    <text x="425" y="298" text-anchor="middle" font-size="11" fill="var(--ink)">{t.worker2}</text>
    <rect x="496" y="250" width="118" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="555" y="276" text-anchor="middle" font-size="11" fill="var(--ink)">{t.worker1}</text>
    <text x="555" y="298" text-anchor="middle" font-size="11" fill="var(--ink)">{t.worker2}</text>
    <rect x="626" y="250" width="118" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="685" y="276" text-anchor="middle" font-size="11" fill="var(--ink)">{t.worker1}</text>
    <text x="685" y="298" text-anchor="middle" font-size="11" fill="var(--ink)">{t.worker2}</text>
    <text x="555" y="340" text-anchor="middle" font-size="11" fill="var(--muted)">{t.fateCluster}</text>

    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
