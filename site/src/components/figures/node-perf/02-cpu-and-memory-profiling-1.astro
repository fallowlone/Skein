---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "CPU flame graph: width equals self time, so the wide JSON.parse frame eating 40 percent is the hot path and depth is only call nesting",
    headline: "WIDTH = SELF TIME — CHASE THE WIDE FRAME",
    sub: "flame graph: each box is a stack frame",
    laneRoot: "depth 0",
    laneHot: "hot — 40%",
    laneDeep: "depth",
    rootBar: "server.js — request handler",
    fatFrame: "JSON.parse — 40% self time",
    regexFrame: "regex — narrow",
    restFrame: "other",
    deepA: "parseChunk",
    deepB: "reviver",
    deepC: "match",
    widthTag: "width = self time",
    foot1: "depth = call nesting — ignore it, chase width",
    foot2: "node --cpu-prof → .cpuprofile → Performance tab",
    caption:
      "A CPU flame graph reads by width: width is self time, so the wide JSON.parse frame at 40 percent is the hot path and depth is only call nesting.",
  },
  ru: {
    svgTitle: "Flame-граф CPU: ширина равна self time, поэтому широкий кадр JSON.parse на 40 процентов — горячий путь, а глубина — лишь вложенность вызовов",
    headline: "ШИРИНА = SELF TIME — ГОНИСЬ ЗА ШИРОКИМ КАДРОМ",
    sub: "flame-граф: каждый прямоугольник — кадр стека",
    laneRoot: "глубина 0",
    laneHot: "горячий — 40%",
    laneDeep: "глубже",
    rootBar: "server.js — обработчик запроса",
    fatFrame: "JSON.parse — 40% self time",
    regexFrame: "regex — узкий",
    restFrame: "прочее",
    deepA: "parseChunk",
    deepB: "reviver",
    deepC: "match",
    widthTag: "ширина = self time",
    foot1: "глубина — лишь вложенность вызовов: гонись за шириной",
    foot2: "node --cpu-prof → .cpuprofile → вкладка Performance",
    caption:
      "Flame-граф CPU читается по ширине: ширина — это self time, поэтому широкий кадр JSON.parse на 40 процентов — горячий путь, а глубина — лишь вложенность вызовов.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="np4" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="160" y="121" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneRoot}</text>
    <rect x="185" y="92" width="470" height="48" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="420" y="121" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rootBar}</text>

    <text x="160" y="181" text-anchor="end" font-size="11" fill="var(--accent)">{t.laneHot}</text>
    <rect x="185" y="152" width="240" height="48" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="305" y="181" text-anchor="middle" font-size="11" fill="var(--ink)">{t.fatFrame}</text>
    <rect x="431" y="152" width="130" height="48" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="496" y="181" text-anchor="middle" font-size="11" fill="var(--ink)">{t.regexFrame}</text>
    <rect x="567" y="152" width="88" height="48" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="611" y="181" text-anchor="middle" font-size="11" fill="var(--ink)">{t.restFrame}</text>

    <text x="160" y="241" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneDeep}</text>
    <rect x="185" y="212" width="140" height="48" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="255" y="241" text-anchor="middle" font-size="11" fill="var(--ink)">{t.deepA}</text>
    <rect x="331" y="212" width="94" height="48" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="378" y="241" text-anchor="middle" font-size="11" fill="var(--ink)">{t.deepB}</text>
    <rect x="431" y="212" width="130" height="48" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="496" y="241" text-anchor="middle" font-size="11" fill="var(--ink)">{t.deepC}</text>

    <line x1="185" y1="292" x2="425" y2="292" stroke="var(--muted)" stroke-width="2" marker-start="url(#np4)" marker-end="url(#np4)" />
    <text x="305" y="314" text-anchor="middle" font-size="12" fill="var(--accent)">{t.widthTag}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="376" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
