---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Same measurement window: mean event-loop lag about 2 ms looks healthy, but p99 from the nanosecond histogram shows a 400 ms tail",
    headline: "MEAN HIDES THE TAIL",
    sub: "same window, histogram in nanoseconds",
    meanNum: "mean ≈ 2 ms",
    meanBar: "thousands of near-zero samples",
    meanVerdict: "looks healthy — and lies",
    tailNum: "p99 ≈ 400 ms",
    tailBar: "a few 300 ms blocks per minute",
    tailVerdict: "the tail users actually feel",
    resolution: "resolution 10 ms · all values in nanoseconds",
    alert: "alert on p99 / max, not the mean",
    caption:
      "Same window, two stories: the mean averages thousands of near-zero samples down to about 2 ms, while p99 from the nanosecond histogram exposes the 400 ms tail. Alert on the tail, not the mean.",
  },
  ru: {
    svgTitle: "Одно и то же окно измерения: среднее задержки event loop около 2 мс выглядит здоровым, а p99 с наносекундной гистограммы показывает хвост в 400 мс",
    headline: "СРЕДНЕЕ ПРЯЧЕТ ХВОСТ",
    sub: "то же окно, гистограмма в наносекундах",
    meanNum: "среднее ≈ 2 мс",
    meanBar: "тысячи семплов около нуля",
    meanVerdict: "выглядит здоровым — и врёт",
    tailNum: "p99 ≈ 400 мс",
    tailBar: "горстка блоков по 300 мс в минуту",
    tailVerdict: "хвост, что чувствуют пользователи",
    resolution: "resolution 10 мс · все значения в наносекундах",
    alert: "алертись по p99 / max, а не по среднему",
    caption:
      "Одно окно, две истории: среднее усредняет тысячи семплов около нуля до примерно 2 мс, а p99 с наносекундной гистограммы вскрывает хвост в 400 мс. Алертись по хвосту, а не по среднему.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="95" width="300" height="175" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="210" y="130" text-anchor="middle" font-size="18" fill="var(--ink)">{t.meanNum}</text>
    <rect x="120" y="150" width="60" height="16" fill="var(--muted)" />
    <text x="210" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.meanBar}</text>
    <text x="210" y="222" text-anchor="middle" font-size="11" fill="var(--muted)">{t.meanVerdict}</text>

    <rect x="440" y="95" width="300" height="175" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="130" text-anchor="middle" font-size="18" fill="var(--ink)">{t.tailNum}</text>
    <rect x="480" y="150" width="220" height="16" fill="var(--accent)" />
    <text x="590" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.tailBar}</text>
    <text x="590" y="222" text-anchor="middle" font-size="11" fill="var(--ink)">{t.tailVerdict}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.resolution}</text>
    <text x="400" y="350" text-anchor="middle" font-size="13" fill="var(--accent)">{t.alert}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
