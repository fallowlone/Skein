---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "unknown becomes useful only once narrowed with typeof, in, or a guard; an exhausted switch narrows to never so assertNever turns a forgotten case into a compile error",
    headline: "NARROW FIRST, THEN USE",
    sub: "unknown proves its shape; never guards the default",
    tagNarrow: "narrow",
    tagExhaust: "exhaust",
    stepUnknown: "unknown",
    stepGuard: "typeof / in / guard",
    stepUse: "use: checked ✓",
    switchLine: "switch (s.kind)",
    assertLine: "default: assertNever(s)",
    newCase: "new case = error ✗",
    catchLine: "catch (e): unknown",
    foot1: "unknown at the boundary, never in the default",
    foot2: "a forgotten case becomes a compile error",
    caption:
      "unknown stays locked until typeof, in, or a guard proves its shape; an exhausted switch narrows to never, so assertNever turns a forgotten case into a compile error.",
  },
  ru: {
    svgTitle: "unknown полезен лишь после сужения через typeof, in или защитник; исчерпанный switch сужается до never, и assertNever превращает забытый случай в ошибку компиляции",
    headline: "СНАЧАЛА СУЗИТЬ, ПОТОМ ИСПОЛЬЗОВАТЬ",
    sub: "unknown доказывает форму",
    tagNarrow: "сужение",
    tagExhaust: "исчерпание",
    stepUnknown: "unknown",
    stepGuard: "typeof / in / защитник",
    stepUse: "доступ: проверен ✓",
    switchLine: "switch (s.kind)",
    assertLine: "default: assertNever(s)",
    newCase: "новый случай = ошибка ✗",
    catchLine: "catch (e): unknown",
    foot1: "unknown — на границе",
    foot2: "забытый случай — ошибка компиляции",
    caption:
      "unknown закрыт, пока typeof, in или защитник не докажут форму; исчерпанный switch сужается до never, и assertNever превращает забытый случай в ошибку компиляции.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="112" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagNarrow}</text>
    <rect x="40" y="126" width="200" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="140" y="163" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stepUnknown}</text>
    <text x="275" y="163" text-anchor="middle" font-size="12" fill="var(--muted)">→</text>
    <rect x="300" y="126" width="220" height="64" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="410" y="163" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stepGuard}</text>
    <text x="550" y="163" text-anchor="middle" font-size="12" fill="var(--muted)">→</text>
    <rect x="570" y="126" width="190" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="665" y="163" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stepUse}</text>

    <text x="400" y="236" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagExhaust}</text>
    <rect x="40" y="250" width="220" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="150" y="285" text-anchor="middle" font-size="12" fill="var(--ink)">{t.switchLine}</text>
    <rect x="290" y="250" width="250" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="415" y="285" text-anchor="middle" font-size="12" fill="var(--ink)">{t.assertLine}</text>
    <text x="655" y="285" text-anchor="middle" font-size="12" fill="var(--ink)">{t.newCase}</text>

    <text x="150" y="348" text-anchor="middle" font-size="11" fill="var(--muted)">{t.catchLine}</text>
    <text x="500" y="348" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="500" y="373" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
