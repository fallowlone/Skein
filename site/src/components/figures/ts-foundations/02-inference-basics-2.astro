---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Leaving an exported return type inferred raised tsc check time from 9.4s to 16.1s; one explicit return annotation restored it to 9.6s",
    headline: "ANNOTATE BOUNDARIES, INFER INTERIORS",
    sub: "tsc --noEmit on a 900-file repo",
    tagBase: "baseline",
    baseVal: "9.4s",
    tagInfer: "inferred return",
    inferVal: "16.1s",
    inferNote: "30-member conditional type",
    tagPinned: "explicit return",
    pinnedVal: "9.6s",
    pinnedNote: "one hand-written annotation",
    foot1: "an exported return left inferred doubled check time",
    foot2: "one pinned return type restored the baseline",
    caption:
      "Leaving an over-clever exported return inferred nearly doubled the type-check from 9.4s to 16.1s; one hand-written return annotation restored the baseline at 9.6s.",
  },
  ru: {
    svgTitle: "Выведенный тип возврата поднял проверку tsc с 9.4с до 16.1с; одна явная аннотация вернула её к 9.6с",
    headline: "ГРАНИЦЫ — ВРУЧНУЮ, ТЕЛО — ВЫВОДОМ",
    sub: "tsc --noEmit на репозитории из 900 файлов",
    tagBase: "база",
    baseVal: "9.4с",
    tagInfer: "выведенный возврат",
    inferVal: "16.1с",
    inferNote: "условный тип из 30 членов",
    tagPinned: "явный возврат",
    pinnedVal: "9.6с",
    pinnedNote: "одна аннотация руками",
    foot1: "выведенный возврат удвоил проверку",
    foot2: "одна аннотация вернула базу",
    caption:
      "Слишком умный выведенный возврат поднял проверку типов с 9.4с до 16.1с; одна написанная руками аннотация возврата вернула базовый уровень 9.6с.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="230" y="134" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagBase}</text>
    <rect x="250" y="108" width="245" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="505" y="134" text-anchor="start" font-size="12" fill="var(--ink)">{t.baseVal}</text>

    <text x="230" y="224" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagInfer}</text>
    <rect x="250" y="198" width="420" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="680" y="224" text-anchor="start" font-size="12" fill="var(--ink)">{t.inferVal}</text>
    <text x="250" y="258" text-anchor="start" font-size="11" fill="var(--muted)">{t.inferNote}</text>

    <text x="230" y="314" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagPinned}</text>
    <rect x="250" y="288" width="250" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="510" y="314" text-anchor="start" font-size="12" fill="var(--ink)">{t.pinnedVal}</text>
    <text x="250" y="348" text-anchor="start" font-size="11" fill="var(--muted)">{t.pinnedNote}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
