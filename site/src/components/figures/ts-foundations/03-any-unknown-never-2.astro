---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "never is the bottom type: assignable out to every type, with nothing assignable in; impossible intersections collapse to never",
    headline: "NEVER: THE BOTTOM TYPE",
    sub: "assignable out to all; nothing assignable in",
    tagTop: "top",
    tagMid: "middle",
    tagBot: "bottom",
    topBox: "unknown",
    midBox: "string",
    botBox: "never",
    outOk: "never → string ✓",
    inNo: "string → never ✗",
    impossible: "string & number = never",
    foot1: "never is the empty set: no values",
    foot2: "fail() and loop() return never",
    caption:
      "never sits at the bottom of the lattice: assignable out to every type, with nothing assignable in — impossible intersections like string and number collapse to never.",
  },
  ru: {
    svgTitle: "never — нижний тип: совместим наружу со всем, внутрь — ничто; невозможные пересечения схлопываются в never",
    headline: "NEVER — НИЖНИЙ ТИП",
    sub: "наружу — со всем, внутрь — ничто",
    tagTop: "верх",
    tagMid: "середина",
    tagBot: "низ",
    topBox: "unknown",
    midBox: "string",
    botBox: "never",
    outOk: "never → string ✓",
    inNo: "string → never ✗",
    impossible: "string & number = never",
    foot1: "never — пустое множество",
    foot2: "fail() и loop() возвращают never",
    caption:
      "never — внизу решётки: совместим наружу со всем, внутрь — ничто; невозможные пересечения вроде string и number схлопываются в never.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="220" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagTop}</text>
    <rect x="240" y="104" width="260" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="370" y="139" text-anchor="middle" font-size="12" fill="var(--ink)">{t.topBox}</text>

    <text x="220" y="216" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagMid}</text>
    <rect x="240" y="184" width="260" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="370" y="219" text-anchor="middle" font-size="12" fill="var(--ink)">{t.midBox}</text>

    <text x="220" y="296" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagBot}</text>
    <rect x="240" y="264" width="260" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="370" y="299" text-anchor="middle" font-size="12" fill="var(--ink)">{t.botBox}</text>

    <text x="620" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outOk}</text>
    <text x="620" y="192" text-anchor="middle" font-size="12" fill="var(--ink)">{t.inNo}</text>
    <text x="620" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{t.impossible}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="387" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
