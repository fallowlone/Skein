---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "any allows assignment in both directions with checking off; unknown accepts anything in but allows nothing out until narrowed",
    headline: "ANY: OPEN BOTH WAYS",
    sub: "unknown: in open, out locked until narrowed",
    tagAny: "any",
    tagUnknown: "unknown",
    anyIn: "string → any ✓",
    anyOut: "any → number ✓",
    anyConta: "u.profile → any",
    anyFoot: "checking: OFF",
    unIn: "string → unknown ✓",
    unOut: "unknown → number ✗",
    unRule: "narrow first: typeof / in",
    unFoot: "checking: ON",
    foot1: "any flows into number with no error — checking disabled",
    foot2: "unknown blocks until you prove the shape",
    caption:
      "any is assignable both to and from everything, so it flows into number unchecked; unknown accepts everything in but nothing out until narrowed.",
  },
  ru: {
    svgTitle: "any совместим в обе стороны без проверки; unknown всё принимает внутрь, но ничего не выпускает наружу до сужения",
    headline: "ANY ОТКРЫТ В ОБЕ СТОРОНЫ",
    sub: "вход открыт, выход закрыт",
    tagAny: "any",
    tagUnknown: "unknown",
    anyIn: "string → any ✓",
    anyOut: "any → number ✓",
    anyConta: "u.profile → any",
    anyFoot: "проверка: ВЫКЛ",
    unIn: "string → unknown ✓",
    unOut: "unknown → number ✗",
    unRule: "сначала сузить: typeof",
    unFoot: "проверка: ВКЛ",
    foot1: "any втекает в number без ошибки",
    foot2: "unknown ждёт доказательства формы",
    caption:
      "any совместим и с, и из всего, поэтому втекает в number без проверки; unknown всё принимает внутрь, но ничего не выпускает до сужения.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="112" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagAny}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.anyIn}</text>
    <text x="205" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.anyOut}</text>
    <text x="205" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.anyConta}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.anyFoot}</text>

    <text x="595" y="112" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagUnknown}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unIn}</text>
    <text x="595" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unOut}</text>
    <text x="595" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unRule}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.unFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
