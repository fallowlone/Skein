---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Structural versus nominal typing: Point and Vector2D both have x and y, so a nominal checker rejects the mismatched name while TypeScript accepts the matching shape",
    headline: "NAMES DON'T MATTER, MEMBERS DO",
    sub: "Point vs Vector2D, both { x, y }",
    leftTitle: "Nominal language",
    leftLine1: "Point { x, y }",
    leftLine2: "Vector2D { x, y }",
    leftVerdict: "rejected: name differs",
    rightTitle: "TypeScript (structural)",
    rightLine1: "length(v) compiles",
    rightLine2: "Vector2D has x and y",
    rightVerdict: "accepted: shape fits",
    foot1: "no extends, no import, no adapter",
    foot2: "same shape, two answers",
    caption:
      "Point and Vector2D share the members x and y with no extends relation; a nominal language rejects the mismatched name, while TypeScript accepts any value whose shape satisfies the target.",
  },
  ru: {
    svgTitle: "Структурная и номинальная типизация: у Point и Vector2D есть x и y, поэтому номинальный проверщик отклоняет чужое имя, а TypeScript принимает годную форму",
    headline: "ИМЕНА НЕ ВАЖНЫ, ВАЖНЫ ЧЛЕНЫ",
    sub: "Point и Vector2D, оба { x, y }",
    leftTitle: "Номинальный язык",
    leftLine1: "Point { x, y }",
    leftLine2: "Vector2D { x, y }",
    leftVerdict: "отклонено: имя другое",
    rightTitle: "TypeScript (структурный)",
    rightLine1: "length(v) компилируется",
    rightLine2: "у Vector2D есть x и y",
    rightVerdict: "принято: форма годна",
    foot1: "без extends, импорта, адаптера",
    foot2: "форма одна, ответы разные",
    caption:
      "Point и Vector2D имеют члены x и y без связи через extends; номинальный язык отклоняет чужое имя, а TypeScript принимает любое значение, чья форма удовлетворяет цели.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="340" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="210" y="120" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    <text x="210" y="158" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftLine1}</text>
    <text x="210" y="184" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftLine2}</text>
    <text x="210" y="226" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftVerdict}</text>
    <text x="210" y="256" text-anchor="middle" font-size="11" fill="var(--muted)">Point != Vector2D</text>

    <rect x="420" y="90" width="340" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="120" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    <text x="590" y="158" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightLine1}</text>
    <text x="590" y="184" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightLine2}</text>
    <text x="590" y="226" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightVerdict}</text>
    <text x="590" y="256" text-anchor="middle" font-size="11" fill="var(--muted)">x, y present</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
