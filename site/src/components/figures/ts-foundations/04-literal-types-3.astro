---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "As const does three things at once: marks every property readonly, prevents widening so literals are kept, and turns array literals into tuples",
    headline: "AS CONST DOES THREE THINGS",
    sub: "compile time only — zero runtime cost",
    box1Title: "readonly",
    box1Sub: "every property",
    box2Title: "no widening",
    box2Sub: "keeps literals",
    box3Title: "tuples, not arrays",
    box3Sub: "readonly tuple",
    foot1: 'methods: string[] → readonly ["GET", "POST"]',
    foot2: "config-as-types: one value, data and type",
    caption:
      'As const does three things at once — readonly properties, no widening, tuples instead of arrays — so methods goes from string[] to readonly ["GET", "POST"]: one config value as both data and type.',
  },
  ru: {
    svgTitle: "As const делает сразу три вещи: помечает каждое свойство readonly, не даёт расширения и превращает литералы массивов в кортежи",
    headline: "AS CONST: ТРИ ЭФФЕКТА",
    sub: "только компиляция — ноль цены",
    box1Title: "readonly",
    box1Sub: "каждое свойство",
    box2Title: "без расширения",
    box2Sub: "хранит литералы",
    box3Title: "кортежи, не массивы",
    box3Sub: "readonly-кортеж",
    foot1: 'methods: string[] → readonly ["GET", "POST"]',
    foot2: "единый источник истины",
    caption:
      'As const делает сразу три вещи — readonly-свойства, без расширения, кортежи вместо массивов — и methods из string[] становится readonly ["GET", "POST"]: конфиг-как-типы из единого источника истины.',
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="50" y="110" width="220" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="160" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box1Title}</text>
    <text x="160" y="188" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Sub}</text>

    <rect x="290" y="110" width="220" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box2Title}</text>
    <text x="400" y="188" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Sub}</text>

    <rect x="530" y="110" width="220" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="640" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.box3Title}</text>
    <text x="640" y="188" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Sub}</text>

    <text x="400" y="300" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="328" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
