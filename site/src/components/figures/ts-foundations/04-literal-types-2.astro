---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Runtime JavaScript shipped per construct: a literal union ships 0 bytes because it erases, while a numeric enum emits roughly 150 to 400 bytes of reverse-mapped object code",
    headline: "ZERO BYTES VS ~400 BYTES",
    sub: "runtime JS shipped per construct",
    tagUnion: '"GET" | "POST"',
    tagEnum: "enum",
    unionValue: "0 bytes — erased",
    enumValue: "≈ 150–400 bytes",
    foot1: "~30 such enums ≈ single-digit KB",
    foot2: "dead weight as const never pays",
    caption:
      "A literal union erases to nothing; each numeric enum costs ~150–400 bytes — across ~30 status/role/method enums, that is single-digit KB of dead weight as const never pays.",
  },
  ru: {
    svgTitle: "Отгружаемый рантайм-JavaScript на конструкцию: объединение литералов отгружает 0 байт, ибо стирается, а числовой enum испускает примерно 150–400 байт кода с обратным отображением",
    headline: "0 БАЙТ ПРОТИВ ~400 БАЙТ",
    sub: "рантайм-JS на конструкцию",
    tagUnion: '"GET" | "POST"',
    tagEnum: "enum",
    unionValue: "0 байт — стирается",
    enumValue: "≈ 150–400 байт",
    foot1: "~30 enum — однозначные КБ",
    foot2: "мёртвого веса без as const",
    caption:
      "Объединение литералов стирается в ничто; каждый числовой enum стоит ~150–400 байт — на ~30 enum статусов/ролей/методов это однозначные килобайты мёртвого веса, которые as const не платит.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="160" y="146" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagUnion}</text>
    <rect x="180" y="118" width="10" height="50" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="214" y="148" font-size="12" fill="var(--ink)">{t.unionValue}</text>

    <text x="160" y="246" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagEnum}</text>
    <rect x="180" y="214" width="440" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.enumValue}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
