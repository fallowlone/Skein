---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "let widens a string literal to string, while const keeps the literal type",
    headline: "LET WIDENS, CONST KEEPS",
    sub: "inference from the initializer",
    tagLet: "let",
    letLine1: 'let a = "hello"',
    letLine2: "inferred: string",
    letLine3: "mutable, so it widens",
    tagConst: "const",
    constLine1: 'const b = "hello"',
    constLine2: 'inferred: "hello"',
    constLine3: "immutable, so it keeps",
    foot1: 'let n = 3 is number; const n = 3 is 3',
    foot2: "the keyword decides: widen or keep",
    caption:
      'A let binding widens "hello" to string because it can be reassigned; a const binding keeps the literal "hello" because it cannot change.',
  },
  ru: {
    svgTitle: "let расширяет строковый литерал до string, а const сохраняет литеральный тип",
    headline: "LET РАСШИРЯЕТ, CONST ХРАНИТ",
    sub: "вывод из инициализатора",
    tagLet: "let",
    letLine1: 'let a = "hello"',
    letLine2: "вывод: string",
    letLine3: "изменяем — расширяется",
    tagConst: "const",
    constLine1: 'const b = "hello"',
    constLine2: 'вывод: "hello"',
    constLine3: "неизменяем — хранится",
    foot1: "let n = 3 это number; const n = 3 это 3",
    foot2: "ключевое слово решает: расширить",
    caption:
      'Связывание let расширяет "hello" до string, потому что его можно переприсвоить; связывание const сохраняет литерал "hello", потому что измениться оно не может.',
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="215" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLet}</text>
    <rect x="60" y="110" width="310" height="120" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="215" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.letLine1}</text>
    <text x="215" y="178" text-anchor="middle" font-size="12" fill="var(--accent)">{t.letLine2}</text>
    <text x="215" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.letLine3}</text>

    <text x="585" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagConst}</text>
    <rect x="430" y="110" width="310" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="585" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.constLine1}</text>
    <text x="585" y="178" text-anchor="middle" font-size="12" fill="var(--accent)">{t.constLine2}</text>
    <text x="585" y="204" text-anchor="middle" font-size="11" fill="var(--muted)">{t.constLine3}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
