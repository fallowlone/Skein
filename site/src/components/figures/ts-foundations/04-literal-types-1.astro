---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The widening fork: let widens GET to string, const keeps the literal GET, and object properties widen unless marked as const",
    headline: "ONE VALUE, TWO INFERRED TYPES",
    sub: "the slot decides: widen or keep",
    tagLeft: "let — mutable",
    tagRight: "const — frozen",
    leftLine1: 'let m = "GET"',
    leftLine2: "→ string · widened",
    rightLine1: 'const m2 = "GET"',
    rightLine2: '→ "GET" · kept',
    foot1: '{ method: "GET" } → { method: string }',
    foot2: "fix: as const or annotate to the union",
    caption:
      'Same value, two outcomes: a mutable slot widens "GET" to string, while const keeps the literal "GET". Object properties widen too — fix with as const or an annotation to the union.',
  },
  ru: {
    svgTitle: "Развилка расширения: let расширяет GET до string, const хранит литерал GET, а свойства объекта расширяются без as const",
    headline: "ОДНО ЗНАЧЕНИЕ, ДВА ТИПА",
    sub: "решает слот: расширить или хранить",
    tagLeft: "let — изменяемо",
    tagRight: "const — заморожено",
    leftLine1: 'let m = "GET"',
    leftLine2: "→ string · расширено",
    rightLine1: 'const m2 = "GET"',
    rightLine2: '→ "GET" · сохранён',
    foot1: '{ method: "GET" } → { method: string }',
    foot2: "лекарство: as const / аннотация",
    caption:
      'Одно значение, два исхода: изменяемый слот расширяет "GET" до string, а const хранит литерал "GET". Свойства объекта тоже расширяются — лекарство: as const или аннотация к объединению.',
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="60" y="120" width="300" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="210" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine1}</text>
    <text x="210" y="193" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine2}</text>

    <text x="590" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="440" y="120" width="300" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine1}</text>
    <text x="590" y="193" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine2}</text>

    <text x="400" y="300" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="328" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
