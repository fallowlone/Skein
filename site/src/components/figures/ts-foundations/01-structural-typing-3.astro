---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Excess-property check: a fresh object literal with a widht typo errors at the call site, but the same object through a variable passes because freshness is lost",
    headline: "FRESH LITERALS GET ONE STRICT CHECK",
    sub: "freshness evaporates through a variable",
    tagFresh: "fresh",
    freshLine1: "configure({ ... widht: 10 })",
    freshLine2: "error: unknown property",
    freshVerdict: "typo caught at the call site",
    tagVar: "variable",
    varLine1: "const opts = { ... };",
    varLine2: "configure(opts) — passes",
    varVerdict: "no error: freshness lost",
    foot1: "a typo-catching heuristic, not a soundness rule",
    foot2: "extra members are fine once freshness is gone",
    caption:
      "A fresh literal with a widht typo fails the excess-property check at the call site, while the same object passed through a variable compiles — freshness is lost, so only structural compatibility is checked.",
  },
  ru: {
    svgTitle: "Проверка лишних свойств: свежий литерал с опечаткой widht даёт ошибку на месте вызова, а тот же объект через переменную проходит, потому что свежесть утеряна",
    headline: "СВЕЖИЙ ЛИТЕРАЛ — СТРОГАЯ ПРОВЕРКА",
    sub: "свежесть испаряется через переменную",
    tagFresh: "свежий",
    freshLine1: "configure({ ... widht: 10 })",
    freshLine2: "ошибка: лишнее свойство",
    freshVerdict: "опечатка поймана на месте",
    tagVar: "переменная",
    varLine1: "const opts = { ... };",
    varLine2: "configure(opts) — проходит",
    varVerdict: "ошибки нет: свежесть утеряна",
    foot1: "эвристика-ловец опечаток, не правило",
    foot2: "лишнее нормально без свежести",
    caption:
      "Свежий литерал с опечаткой widht не проходит проверку лишних свойств на месте вызова, а тот же объект через переменную компилируется — свежесть утеряна, и проверяется лишь структурная совместимость.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="136" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagFresh}</text>
    <rect x="170" y="104" width="460" height="92" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="134" text-anchor="middle" font-size="12" fill="var(--ink)">{t.freshLine1}</text>
    <text x="400" y="160" text-anchor="middle" font-size="11" fill="var(--ink)">{t.freshLine2}</text>
    <text x="400" y="184" text-anchor="middle" font-size="11" fill="var(--muted)">{t.freshVerdict}</text>

    <text x="150" y="252" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagVar}</text>
    <rect x="170" y="218" width="460" height="92" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.varLine1}</text>
    <text x="400" y="274" text-anchor="middle" font-size="11" fill="var(--ink)">{t.varLine2}</text>
    <text x="400" y="298" text-anchor="middle" font-size="11" fill="var(--muted)">{t.varVerdict}</text>

    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="370" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
