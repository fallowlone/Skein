---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Object properties widen even under const; as const keeps literals as readonly; array literals get a best-common-type union",
    headline: "PROPERTIES WIDEN; AS CONST KEEPS",
    sub: "literal facts the lesson states",
    tagObj: "object",
    objLine1: '{ mode: "dark" }',
    objLine2: "inferred: string",
    objLine3: "property is mutable",
    tagFix: "fix",
    fixLine1: "as const",
    fixLine2: 'readonly "dark"',
    fixLine3: "literal is kept",
    tagArr: "array",
    arrLine1: '[1, "two", 3]',
    arrLine2: "(string | number)[]",
    arrLine3: "best common type",
    foot1: "const freezes the reference, not the members",
    foot2: "contextual callbacks need no annotations",
    caption:
      "Object properties widen to string even under const because they stay mutable; as const keeps each literal as readonly; a mixed array literal gets the union (string | number)[].",
  },
  ru: {
    svgTitle: "Свойства объекта расширяются даже под const; as const хранит литералы как readonly; литерал массива получает наилучший общий тип",
    headline: "СВОЙСТВА РАСШИРЯЮТСЯ; AS CONST ХРАНИТ",
    sub: "литеральные факты урока",
    tagObj: "объект",
    objLine1: '{ mode: "dark" }',
    objLine2: "вывод: string",
    objLine3: "свойство изменяемо",
    tagFix: "лекарство",
    fixLine1: "as const",
    fixLine2: 'readonly "dark"',
    fixLine3: "литерал сохранён",
    tagArr: "массив",
    arrLine1: '[1, "two", 3]',
    arrLine2: "(string | number)[]",
    arrLine3: "общий тип элементов",
    foot1: "const хранит ссылку, а не члены",
    foot2: "встроенным колбэкам аннотации не нужны",
    caption:
      "Свойства объекта расширяются до string даже под const, потому что остаются изменяемыми; as const хранит каждый литерал как readonly; смешанный литерал массива получает объединение (string | number)[].",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagObj}</text>
    <rect x="40" y="110" width="220" height="140" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="150" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.objLine1}</text>
    <text x="150" y="180" text-anchor="middle" font-size="12" fill="var(--accent)">{t.objLine2}</text>
    <text x="150" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.objLine3}</text>

    <text x="400" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagFix}</text>
    <rect x="290" y="110" width="220" height="140" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fixLine1}</text>
    <text x="400" y="180" text-anchor="middle" font-size="12" fill="var(--accent)">{t.fixLine2}</text>
    <text x="400" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.fixLine3}</text>

    <text x="650" y="96" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagArr}</text>
    <rect x="540" y="110" width="220" height="140" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="650" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.arrLine1}</text>
    <text x="650" y="180" text-anchor="middle" font-size="12" fill="var(--accent)">{t.arrLine2}</text>
    <text x="650" y="208" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrLine3}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="345" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
