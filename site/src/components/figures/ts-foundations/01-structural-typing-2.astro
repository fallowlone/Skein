---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Branding tradeoff: a branded id catches swapped ids at compile time and adds under 100ms to a 7.2 second typecheck, but costs about 40 boundary casts, so reserve it for ids, money, and validated input",
    headline: "BRANDING: NOMINAL SAFETY ON PURPOSE",
    sub: "string & { __brand } catches swapped ids",
    leftTitle: "Branded id",
    leftLine1: "catches swapped ids",
    leftLine2: "under 100ms on ~7.2s",
    leftLine3: "~40 boundary casts",
    leftVerdict: "for ids, money, input",
    rightTitle: "Plain string",
    rightLine1: "boundaries frictionless",
    rightLine2: "typecheck unchanged",
    rightLine3: "swapped ids compile",
    rightVerdict: "silent bug, no error",
    foot1: "runtime cost is noise — casts are the price",
    foot2: "brand only where a swap is an incident",
    caption:
      "A branded id catches swapped ids at compile time and adds under 100ms to a ~7.2s typecheck, but costs ~40 boundary casts — so reserve it for ids, money, and validated input, and leave plain strings elsewhere.",
  },
  ru: {
    svgTitle: "Компромисс брендирования: брендированный id ловит подмену на этапе компиляции и добавляет менее 100мс к проверке ~7.2с, но стоит ~40 граничных приведений — берегите его для id, денег и проверенного ввода",
    headline: "БРЕНД: НОМИНАЛЬНОСТЬ НАМЕРЕННО",
    sub: "string & { __brand } ловит подмену id",
    leftTitle: "Брендированный id",
    leftLine1: "ловит подмену id",
    leftLine2: "менее 100мс к ~7.2с",
    leftLine3: "~40 граничных приведений",
    leftVerdict: "для id, денег, ввода",
    rightTitle: "Обычная строка",
    rightLine1: "границы без трения",
    rightLine2: "проверка без изменений",
    rightLine3: "подмена компилируется",
    rightVerdict: "тихий баг, без ошибки",
    foot1: "цена рантайма — шум, цена — приведения",
    foot2: "бренд — где подмена инцидент",
    caption:
      "Брендированный id ловит подмену на этапе компиляции и добавляет менее 100мс к проверке типов ~7.2с, но стоит ~40 граничных приведений — берегите его для id, денег и проверенного ввода, а в остальном оставляйте обычные строки.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="340" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="120" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    <text x="210" y="154" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftLine1}</text>
    <text x="210" y="180" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftLine2}</text>
    <text x="210" y="206" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftLine3}</text>
    <text x="210" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftVerdict}</text>

    <rect x="420" y="90" width="340" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="590" y="120" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    <text x="590" y="154" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightLine1}</text>
    <text x="590" y="180" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightLine2}</text>
    <text x="590" y="206" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightLine3}</text>
    <text x="590" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightVerdict}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
