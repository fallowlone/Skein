---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Express is a linear middleware chain with baseline throughput; Fastify uses plugins and lifecycle hooks and serves about twice the requests per second on a simple JSON route — while a real request spends 40 ms in Postgres and 0.2 ms in the framework",
    headline: "CHAIN VS PLUGINS, ~2X VS BASELINE",
    sub: "tiny JSON route; real requests are DB-bound",
    expressTitle: "Express: linear chain",
    expressL1: "(req, res, next) + next()",
    expressL2: "validation: bring your own",
    expressL3: "serialize: JSON.stringify",
    fastifyTitle: "Fastify: plugins + hooks",
    fastifyL1: "onRequest … preHandler",
    fastifyL2: "validation: built-in JSON Schema",
    fastifyL3: "serialize: fast-json-stringify",
    barHead: "throughput on a simple JSON route",
    expressBar: "Express",
    expressVal: "baseline",
    fastifyBar: "Fastify",
    fastifyVal: "~2x",
    foot1: "framework ≈ 0.2 ms of a ≈ 40 ms request (Postgres)",
    foot2: "a 5–40 ms DB round-trip dwarfs the framework — p99 stays put",
    caption:
      "Express chains (req, res, next) middleware while Fastify routes through encapsulated plugins and lifecycle hooks; Fastify serves roughly twice the requests/sec on a tiny JSON route, but a real request spends about 40 ms in Postgres and 0.2 ms in the framework, so the database — not the framework — sets p99.",
  },
  ru: {
    svgTitle: "Express — линейная цепочка middleware с базовым throughput; Fastify — плагины и хуки жизненного цикла, примерно вдвое больше запросов в секунду на простом JSON-роуте, — а реальный запрос тратит 40 мс в Postgres и 0.2 мс во фреймворке",
    headline: "ЦЕПОЧКА ПРОТИВ ПЛАГИНОВ, ~2X ПРОТИВ БАЗОВОГО",
    sub: "крошечный JSON-роут; реальные запросы упираются в БД",
    expressTitle: "Express: линейная цепочка",
    expressL1: "(req, res, next) + next()",
    expressL2: "валидация: своя (zod/joi)",
    expressL3: "сериализация: JSON.stringify",
    fastifyTitle: "Fastify: плагины + хуки",
    fastifyL1: "onRequest … preHandler",
    fastifyL2: "валидация: встроенный JSON Schema",
    fastifyL3: "сериализация: fast-json-stringify",
    barHead: "throughput на простом JSON-роуте",
    expressBar: "Express",
    expressVal: "базовый",
    fastifyBar: "Fastify",
    fastifyVal: "~2x",
    foot1: "фреймворк ≈ 0.2 мс из ≈ 40 мс запроса (Postgres)",
    foot2: "round-trip к БД 5–40 мс затмевает фреймворк — p99 стоит",
    caption:
      "Express — линейная цепочка middleware (req, res, next), Fastify — инкапсулированные плагины и хуки жизненного цикла; на крошечном JSON-роуте Fastify отдаёт примерно вдвое больше запросов в секунду, но реальный запрос тратит около 40 мс в Postgres и 0.2 мс во фреймворке — p99 задаёт база, а не фреймворк.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="330" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="205" y="118" text-anchor="middle" font-size="12" fill="var(--ink)">{t.expressTitle}</text>
    <text x="205" y="142" text-anchor="middle" font-size="11" fill="var(--ink)">{t.expressL1}</text>
    <text x="205" y="164" text-anchor="middle" font-size="11" fill="var(--ink)">{t.expressL2}</text>
    <text x="205" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.expressL3}</text>

    <rect x="430" y="90" width="330" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="118" text-anchor="middle" font-size="12" fill="var(--ink)">{t.fastifyTitle}</text>
    <text x="595" y="142" text-anchor="middle" font-size="11" fill="var(--ink)">{t.fastifyL1}</text>
    <text x="595" y="164" text-anchor="middle" font-size="11" fill="var(--ink)">{t.fastifyL2}</text>
    <text x="595" y="186" text-anchor="middle" font-size="11" fill="var(--ink)">{t.fastifyL3}</text>

    <text x="400" y="262" text-anchor="middle" font-size="12" fill="var(--muted)">{t.barHead}</text>

    <text x="210" y="297" text-anchor="end" font-size="11" fill="var(--muted)">{t.expressBar}</text>
    <rect x="230" y="284" width="140" height="18" fill="var(--muted)" />
    <text x="390" y="297" text-anchor="start" font-size="11" fill="var(--muted)">{t.expressVal}</text>

    <text x="210" y="323" text-anchor="end" font-size="11" fill="var(--muted)">{t.fastifyBar}</text>
    <rect x="230" y="310" width="280" height="18" fill="var(--accent)" />
    <text x="530" y="323" text-anchor="start" font-size="11" fill="var(--accent)">{t.fastifyVal}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--ink)">{t.foot1}</text>
    <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
