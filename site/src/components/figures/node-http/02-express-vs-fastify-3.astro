---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Choose Fastify for a high-RPS schema-validated JSON API, Express for ecosystem breadth and team familiarity, and either when the database sets p99; Express 4 async handlers need try-catch plus next(err) while Express 5 and Fastify forward rejections automatically",
    headline: "PICK BY THE BOTTLENECK, NOT THE BENCHMARK",
    sub: "new public JSON API — decide from the conditions",
    c1: "high-RPS + strict validation",
    o1t: "Fastify: request + response schemas",
    o1b: "compiled serializer, fields stripped",
    c2: "ecosystem + team familiarity",
    o2t: "Express: largest ecosystem",
    o2b: "assemble zod/joi yourself",
    c3: "CRUD bound by the database",
    o3t: "either — the DB sets p99",
    o3b: "5–40 ms dwarfs the framework",
    foot: "Express 4: wrap every async handler — try/catch + next(err); Express 5 and Fastify forward automatically",
    caption:
      "Pick Fastify for a high-RPS, response-heavy JSON API with strict validation and response-field safety; pick Express for ecosystem breadth and team familiarity; when a 5–40 ms database round-trip dominates, either works — and on Express 4 every async handler still needs try/catch plus next(err).",
  },
  ru: {
    svgTitle: "Выбирай Fastify для high-RPS JSON API со schema-валидацией, Express ради широты экосистемы и знакомства команды, а любой — когда p99 задаёт база; async-обработчики Express 4 нуждаются в try-catch плюс next(err), а Express 5 и Fastify форвардят reject автоматически",
    headline: "ВЫБИРАЙ ПО УЗКОМУ МЕСТУ, А НЕ ПО БЕНЧМАРКУ",
    sub: "новый публичный JSON API — иди от условий",
    c1: "high-RPS + строгая валидация",
    o1t: "Fastify: схемы запроса и ответа",
    o1b: "скомпилированный сериализатор, поля вырезаются",
    c2: "экосистема + знакомство команды",
    o2t: "Express: крупнейшая экосистема",
    o2b: "zod/joi собираешь сам",
    c3: "CRUD, привязанный к базе",
    o3t: "любой — p99 задаёт БД",
    o3b: "5–40 мс затмевают фреймворк",
    foot: "Express 4: оборачивай каждый async-обработчик — try/catch + next(err); Express 5 и Fastify форвардят сами",
    caption:
      "Выбирай Fastify для high-RPS, тяжёлого по ответам JSON API со строгой валидацией и безопасностью полей ответа; выбирай Express ради широты экосистемы и знакомства команды; когда доминирует round-trip к базе на 5–40 мс — подойдёт любой, а на Express 4 каждый async-обработчик по-прежнему нуждается в try/catch плюс next(err).",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <defs>
      <marker id="nh6-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 z" fill="var(--muted)" />
      </marker>
    </defs>
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="300" y="141" text-anchor="end" font-size="11" fill="var(--muted)">{t.c1}</text>
    <line x1="308" y1="137" x2="332" y2="137" stroke="var(--muted)" stroke-width="2" marker-end="url(#nh6-arrow)" />
    <rect x="340" y="110" width="410" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="545" y="132" text-anchor="middle" font-size="12" fill="var(--ink)">{t.o1t}</text>
    <text x="545" y="153" text-anchor="middle" font-size="11" fill="var(--ink)">{t.o1b}</text>

    <text x="300" y="221" text-anchor="end" font-size="11" fill="var(--muted)">{t.c2}</text>
    <line x1="308" y1="217" x2="332" y2="217" stroke="var(--muted)" stroke-width="2" marker-end="url(#nh6-arrow)" />
    <rect x="340" y="190" width="410" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="545" y="212" text-anchor="middle" font-size="12" fill="var(--ink)">{t.o2t}</text>
    <text x="545" y="233" text-anchor="middle" font-size="11" fill="var(--ink)">{t.o2b}</text>

    <text x="300" y="301" text-anchor="end" font-size="11" fill="var(--muted)">{t.c3}</text>
    <line x1="308" y1="297" x2="332" y2="297" stroke="var(--muted)" stroke-width="2" marker-end="url(#nh6-arrow)" />
    <rect x="340" y="270" width="410" height="56" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="545" y="292" text-anchor="middle" font-size="12" fill="var(--ink)">{t.o3t}</text>
    <text x="545" y="313" text-anchor="middle" font-size="11" fill="var(--ink)">{t.o3b}</text>

    <text x="400" y="368" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
