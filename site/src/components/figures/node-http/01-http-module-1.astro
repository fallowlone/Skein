---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "req is a Readable stream of the request body, res is a Writable response stream with backpressure through the drain event",
    headline: "REQ IS READABLE, RES IS WRITABLE",
    sub: "stream the body, honour backpressure",
    boxA1: "client: http.request",
    boxA2: "req.end() sends it",
    boxB1: "req: IncomingMessage",
    boxB2: "Readable — stream the chunks",
    boxC1: "res: ServerResponse",
    boxC2: "writeHead / write / end",
    flow: "headers arrive first, body arrives as chunks",
    boxD1: "write() → false means buffer full",
    boxD2: "stop, wait for 'drain'",
    boxE1: "pipeline(source, res)",
    boxE2: "backpressure end to end",
    drainNote: "drain first, then write on",
    foot: "no req.body — consume the stream or the socket stalls",
    caption:
      "req is an IncomingMessage Readable whose body exists only as stream chunks — there is no auto-parsed req.body — while res is a ServerResponse Writable driven with writeHead, write and end. When write() returns false, stop and wait for drain, or pipeline a source stream into res.",
  },
  ru: {
    svgTitle: "req — это Readable-поток тела запроса, res — Writable-поток ответа с backpressure через событие drain",
    headline: "REQ — READABLE, RES — WRITABLE",
    sub: "стримь тело, уважай backpressure",
    boxA1: "client: http.request",
    boxA2: "req.end() отправляет",
    boxB1: "req: IncomingMessage",
    boxB2: "Readable — стримь чанки",
    boxC1: "res: ServerResponse",
    boxC2: "writeHead / write / end",
    flow: "заголовки — сразу, тело — чанками",
    boxD1: "write() → false: буфер полон",
    boxD2: "остановись, жди 'drain'",
    boxE1: "pipeline(source, res)",
    boxE2: "backpressure из конца в конец",
    drainNote: "сначала drain, потом пиши",
    foot: "нет req.body — потреби поток, иначе сокет встанет",
    caption:
      "req — это IncomingMessage-Readable, чьё тело существует только как чанки потока, — никакого авто-разобранного req.body нет, — а res — это Writable-ServerResponse через writeHead, write и end. Когда write() вернул false, остановись и жди drain или pipeline-ни поток-источник в res.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="88" text-anchor="middle" font-size="12" fill="var(--muted)">{t.flow}</text>

    <rect x="16" y="110" width="224" height="84" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="128" y="144" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxA1}</text>
    <text x="128" y="168" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxA2}</text>

    <rect x="264" y="110" width="272" height="84" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="144" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxB1}</text>
    <text x="400" y="168" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxB2}</text>

    <rect x="560" y="110" width="224" height="84" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="672" y="144" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxC1}</text>
    <text x="672" y="168" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxC2}</text>

    <line x1="240" y1="152" x2="264" y2="152" stroke="var(--ink)" stroke-width="2" />
    <polygon points="264,146 274,152 264,158" fill="var(--ink)" />
    <line x1="536" y1="152" x2="560" y2="152" stroke="var(--ink)" stroke-width="2" />
    <polygon points="560,146 570,152 560,158" fill="var(--ink)" />

    <line x1="400" y1="194" x2="400" y2="250" stroke="var(--ink)" stroke-width="2" />
    <polygon points="394,250 400,260 406,250" fill="var(--ink)" />
    <text x="420" y="228" font-size="11" fill="var(--muted)">{t.drainNote}</text>

    <rect x="16" y="250" width="376" height="90" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="204" y="286" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxD1}</text>
    <text x="204" y="310" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxD2}</text>

    <rect x="408" y="250" width="376" height="90" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="596" y="286" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boxE1}</text>
    <text x="596" y="310" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boxE2}</text>

    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--accent)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
