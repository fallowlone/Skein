---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Shutdown budget: a 9-second in-flight report export must finish under the 10-second hard exit timeout, which must sit under the 30-second terminationGracePeriodSeconds before the untrappable SIGKILL",
    headline: "DRAIN BEFORE YOU EXIT",
    sub: "SIGTERM → readiness → close → resources → exit",
    row1: "9s report export",
    row2: "10s hard exit",
    row3: "30s grace period",
    fit1: "finishes under 10s",
    fit2: "sits under 30s",
    kill: "SIGKILL",
    step1: "1. readiness → false",
    step2: "2. server.close() drains",
    step3: "3. pool.end()",
    step4: "4. timeout 10s → exit(1)",
    foot: "nesting: 9s inside 10s inside 30s",
    caption:
      "The 9-second in-flight export must finish under the 10-second hard exit timeout, which must sit comfortably under the 30-second terminationGracePeriodSeconds before the untrappable SIGKILL.",
  },
  ru: {
    svgTitle: "Бюджет остановки: 9-секундный экспорт отчёта в полёте обязан завершиться внутри 10-секундного жёсткого таймаута выхода, который должен сидеть внутри 30-секундного terminationGracePeriodSeconds до неперехватываемого SIGKILL",
    headline: "СЛЕЙ, ПОТОМ ВЫХОДИ",
    sub: "SIGTERM → readiness → close → ресурсы → exit",
    row1: "9с экспорт отчёта",
    row2: "10с жёсткий выход",
    row3: "30с grace-период",
    fit1: "завершается внутри 10с",
    fit2: "сидит внутри 30с",
    kill: "SIGKILL",
    step1: "1. readiness → не готов",
    step2: "2. server.close() сливает",
    step3: "3. pool.end()",
    step4: "4. таймаут 10с → exit(1)",
    foot: "вложенность: 9с внутри 10с внутри 30с",
    caption:
      "Дедлайны вложены: самый долгий запрос в полёте (9с) обязан завершиться внутри жёсткого таймаута выхода (10с), который должен с запасом сидеть внутри 30-секундного дедлайна SIGKILL, который не перехватить.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nh9-step" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="165" y="128" text-anchor="end" font-size="11" fill="var(--muted)">{t.row1}</text>
    <rect x="190" y="108" width="135" height="30" fill="var(--muted)" />
    <text x="350" y="128" text-anchor="start" font-size="11" fill="var(--muted)">{t.fit1}</text>

    <text x="165" y="178" text-anchor="end" font-size="11" fill="var(--muted)">{t.row2}</text>
    <rect x="190" y="158" width="150" height="30" fill="var(--accent)" />
    <text x="365" y="178" text-anchor="start" font-size="11" fill="var(--muted)">{t.fit2}</text>

    <text x="165" y="228" text-anchor="end" font-size="11" fill="var(--muted)">{t.row3}</text>
    <rect x="190" y="208" width="450" height="30" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="665" y="228" text-anchor="start" font-size="11" fill="var(--accent)">{t.kill}</text>

    <line x1="196" y1="292" x2="224" y2="292" stroke="var(--muted)" stroke-width="2" marker-end="url(#nh9-step)" />
    <line x1="396" y1="292" x2="424" y2="292" stroke="var(--muted)" stroke-width="2" marker-end="url(#nh9-step)" />
    <line x1="576" y1="292" x2="604" y2="292" stroke="var(--muted)" stroke-width="2" marker-end="url(#nh9-step)" />
    <text x="110" y="312" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step1}</text>
    <text x="310" y="312" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step2}</text>
    <text x="500" y="312" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step3}</text>
    <text x="690" y="312" text-anchor="middle" font-size="11" fill="var(--ink)">{t.step4}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
