---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Ordered middleware pipeline: logger, body parser, authenticate, route, 404 catch-all, then the 4-argument error boundary; next() advances, next(err) jumps to the boundary",
    headline: "ORDER IS BEHAVIOUR",
    sub: "registration order decides what runs",
    s1: "1. logger — every request",
    s2: "2. express.json() — before routes",
    s3: "3. authenticate — fills req.user",
    s4: "4. GET /orders/:id — route",
    s5: "5. notFound — 404 catch-all",
    s6: "6. errorHandler — 4 args, LAST",
    nextLab: "next() advances",
    errLab: "next(err) to boundary",
    foot: "parse before route · auth before protected route · error handler LAST",
    caption:
      "Each (req, res, next) calls next() to advance or next(err) to jump straight to the single 4-argument error boundary registered last.",
  },
  ru: {
    svgTitle: "Упорядоченный конвейер middleware: logger, парсер тела, authenticate, маршрут, перехватчик 404, затем 4-арг граница ошибок; next() продвигает, next(err) прыгает к границе",
    headline: "ПОРЯДОК — ЭТО ПОВЕДЕНИЕ",
    sub: "порядок регистрации решает, что бежит",
    s1: "1. logger — каждый запрос",
    s2: "2. express.json() — до маршрутов",
    s3: "3. authenticate — наполняет req.user",
    s4: "4. GET /orders/:id — маршрут",
    s5: "5. notFound — перехватчик 404",
    s6: "6. errorHandler — 4 арг., ПОСЛЕДНИЙ",
    nextLab: "next() продвигает",
    errLab: "next(err) к границе",
    foot: "парсинг до маршрута · auth до защищённого · ошибки — ПОСЛЕДНИЕ",
    caption:
      "Каждый (req, res, next) зовёт next(), чтобы продвинуться, или next(err), чтобы прыгнуть прямо к единой 4-арг границе ошибок, зарегистрированной последней.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nh7-solid" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--muted)" />
      </marker>
      <marker id="nh7-err" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--accent)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <line x1="190" y1="109" x2="190" y2="262" stroke="var(--muted)" stroke-width="2" marker-end="url(#nh7-solid)" />
    <text x="175" y="192" text-anchor="end" font-size="11" fill="var(--muted)">{t.nextLab}</text>

    <rect x="230" y="92" width="340" height="34" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="114" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s1}</text>

    <rect x="230" y="132" width="340" height="34" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="154" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s2}</text>

    <rect x="230" y="172" width="340" height="34" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="194" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s3}</text>

    <rect x="230" y="212" width="340" height="34" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="234" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s4}</text>

    <rect x="230" y="252" width="340" height="34" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="274" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s5}</text>

    <rect x="230" y="296" width="340" height="34" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="318" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s6}</text>

    <path d="M 570 229 C 640 238 640 296 570 308" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="7 5" marker-end="url(#nh7-err)" />
    <text x="788" y="270" text-anchor="end" font-size="11" fill="var(--accent)">{t.errLab}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
