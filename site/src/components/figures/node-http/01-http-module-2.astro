---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Agent pools sockets with keep-alive on by default since Node 19: reuse skips a TCP and TLS handshake, maxSockets caps concurrency",
    headline: "REUSE THE SOCKET, CAP THE POOL",
    sub: "keep-alive since Node 19 · maxSockets default Infinity",
    agent1: "Agent: socket pool per host",
    agent2: "keepAlive reuses live sockets",
    lane1: "reuse",
    lane2: "fresh",
    lane3: "pool full",
    bar1: "same host — no new handshake (~1 RTT + TLS saved)",
    bar2a: "TCP+TLS",
    bar2b: "transfer on a new socket",
    queue: "maxSockets hit → requests wait",
    foot: "always drain the response — even pooled",
    caption:
      "The Agent pools sockets per host and reuses live ones via keep-alive, skipping roughly one TCP handshake RTT plus the TLS handshake per request. maxSockets defaults to Infinity, so an unbounded fan-out opens thousands of sockets — set a sane cap — and every response must still be drained or the pooled socket stays pinned.",
  },
  ru: {
    svgTitle: "Agent пулит сокеты с keep-alive по умолчанию с Node 19: реюз пропускает TCP- и TLS-хендшейк, maxSockets ограничивает параллелизм",
    headline: "ПЕРЕИСПОЛЬЗУЙ СОКЕТ, ОГРАНИЧЬ ПУЛ",
    sub: "keep-alive с Node 19 · maxSockets дефолт Infinity",
    agent1: "Agent: пул сокетов на хост",
    agent2: "keepAlive реюзит живые сокеты",
    lane1: "реюз",
    lane2: "новый",
    lane3: "пул полон",
    bar1: "тот же хост — без хендшейка (~1 RTT + TLS в плюс)",
    bar2a: "TCP+TLS",
    bar2b: "передача по новому сокету",
    queue: "maxSockets упёрся → запросы ждут",
    foot: "сливай ответ всегда — даже пуловый",
    caption:
      "Agent пулит сокеты на хост и реюзит живые через keep-alive, пропуская примерно один RTT TCP-хендшейка плюс TLS-хендшейк на запрос. maxSockets дефолт Infinity, так что неограниченный fan-out открывает тысячи сокетов, — ставь разумный предел, — и каждый ответ всё равно надо слить, иначе пуловый сокет останется занят.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="190" y="88" width="420" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="113" text-anchor="middle" font-size="12" fill="var(--ink)">{t.agent1}</text>
    <text x="400" y="135" text-anchor="middle" font-size="11" fill="var(--ink)">{t.agent2}</text>

    <text x="186" y="211" text-anchor="end" font-size="11" fill="var(--muted)">{t.lane1}</text>
    <rect x="210" y="196" width="560" height="22" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="490" y="212" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bar1}</text>

    <text x="186" y="277" text-anchor="end" font-size="11" fill="var(--muted)">{t.lane2}</text>
    <rect x="210" y="262" width="130" height="22" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="275" y="278" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bar2a}</text>
    <rect x="340" y="262" width="430" height="22" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="555" y="278" text-anchor="middle" font-size="11" fill="var(--ink)">{t.bar2b}</text>

    <text x="186" y="343" text-anchor="end" font-size="11" fill="var(--muted)">{t.lane3}</text>
    <rect x="210" y="328" width="56" height="22" fill="var(--accent)" />
    <rect x="280" y="328" width="56" height="22" fill="var(--accent)" />
    <rect x="350" y="328" width="56" height="22" fill="var(--accent)" />
    <text x="430" y="344" font-size="11" fill="var(--ink)">{t.queue}</text>

    <text x="400" y="388" text-anchor="middle" font-size="12" fill="var(--accent)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
