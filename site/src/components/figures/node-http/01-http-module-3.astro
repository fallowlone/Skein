---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Node http server timeout defaults: requestTimeout 300 seconds for the whole request, headersTimeout 60 seconds for headers, keepAliveTimeout 5 seconds idle, server.timeout 0 disabled",
    headline: "TIMEOUTS RAW HTTP OMITS",
    sub: "windows span two orders of magnitude",
    row1: "server.requestTimeout",
    row2: "server.headersTimeout",
    row3: "server.keepAliveTimeout",
    row4: "server.timeout",
    val1: "300 s — whole request",
    val2: "60 s — headers",
    val3: "5 s — idle socket",
    val4: "0 (disabled)",
    asym: "headersTimeout = min(requestTimeout, 60000)",
    foot: "Slowloris drips bytes — timeouts reclaim the socket",
    caption:
      "Under defaults a slow client can hold a socket for the full 300 s requestTimeout, headers must land within 60 s, and an idle keep-alive socket closes after just 5 s — while the per-socket server.timeout is off (0). Tighten requestTimeout on a public server.",
  },
  ru: {
    svgTitle: "Дефолты таймаутов Node http-сервера: requestTimeout 300 секунд на весь запрос, headersTimeout 60 секунд на заголовки, keepAliveTimeout 5 секунд простоя, server.timeout 0 отключён",
    headline: "ТАЙМАУТЫ, КОТОРЫХ НЕТ В СЫРОМ HTTP",
    sub: "окна различаются на два порядка",
    row1: "server.requestTimeout",
    row2: "server.headersTimeout",
    row3: "server.keepAliveTimeout",
    row4: "server.timeout",
    val1: "300 с — весь запрос",
    val2: "60 с — заголовки",
    val3: "5 с — простой сокета",
    val4: "0 (отключён)",
    asym: "headersTimeout = min(requestTimeout, 60000)",
    foot: "Slowloris капает байтами — таймауты отбирают сокет",
    caption:
      "По умолчанию медленный клиент может держать сокет все 300 с requestTimeout, заголовки обязаны прийти за 60 с, а простаивающий keep-alive-сокет закрывается всего через 5 с — при этом server.timeout на сокет выключен (0). На публичном сервере ужми requestTimeout.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="250" y="131" text-anchor="end" font-size="11" fill="var(--muted)">{t.row1}</text>
    <rect x="270" y="110" width="340" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="634" y="131" font-size="11" fill="var(--ink)">{t.val1}</text>

    <text x="250" y="191" text-anchor="end" font-size="11" fill="var(--muted)">{t.row2}</text>
    <rect x="270" y="170" width="140" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="434" y="191" font-size="11" fill="var(--ink)">{t.val2}</text>

    <text x="250" y="251" text-anchor="end" font-size="11" fill="var(--muted)">{t.row3}</text>
    <rect x="270" y="230" width="60" height="30" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="354" y="251" font-size="11" fill="var(--ink)">{t.val3}</text>

    <text x="250" y="311" text-anchor="end" font-size="11" fill="var(--muted)">{t.row4}</text>
    <rect x="270" y="290" width="120" height="30" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="414" y="311" font-size="11" fill="var(--ink)">{t.val4}</text>

    <text x="400" y="358" text-anchor="middle" font-size="11" fill="var(--ink)">{t.asym}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--accent)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
