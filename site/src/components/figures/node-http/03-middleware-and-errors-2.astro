---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One 4-argument error boundary maps typed errors to statuses; a sync throw is caught but an Express 4 async rejection escapes to unhandledRejection unless forwarded with next(err)",
    headline: "ONE BOUNDARY, FOUR ARGS",
    sub: "arity is the signal · client view vs operator view",
    panelTitle: "errorHandler",
    panelSig: "(err, req, res, next)",
    panelArity: "fn.length === 4",
    map1: "ValidationError → 400",
    map2: "NotFoundError → 404",
    map3: "else → 500 · safe body",
    viewA: "client: code + message",
    viewB: "operators: stack + cause",
    syncHead: "sync throw → caught",
    syncSub: "routed to boundary",
    asyncHead: "async reject · Express 4",
    asyncMid: "never awaited → escapes",
    asyncFix: "fix: next(err) / wrap(fn)",
    escapeLab: "hangs · unhandledRejection",
    trap: "Express 4 never awaits your handler",
    foot2: "Express 5 forwards rejects automatically · Express 4: wrap every async",
    caption:
      "A sync throw is caught and routed to the single 4-argument boundary, but an Express 4 async rejection is never awaited, so it escapes to unhandledRejection and hangs — forward it with next(err) or a wrapper.",
  },
  ru: {
    svgTitle: "Одна 4-арг граница ошибок мапит типы ошибок в статусы; sync-throw ловится, а async-reject в Express 4 ускользает в unhandledRejection, если не прокинуть через next(err)",
    headline: "ОДНА ГРАНИЦА, ЧЕТЫРЕ АРГУМЕНТА",
    sub: "арность — это сигнал · взгляд клиента vs взгляд оператора",
    panelTitle: "errorHandler",
    panelSig: "(err, req, res, next)",
    panelArity: "fn.length === 4",
    map1: "ValidationError → 400",
    map2: "NotFoundError → 404",
    map3: "иначе → 500 · безопасное тело",
    viewA: "клиент: код и сообщение",
    viewB: "операторы: стек и cause",
    syncHead: "sync-throw → ловится",
    syncSub: "идёт к границе",
    asyncHead: "async-reject · Express 4",
    asyncMid: "не await-ится → ускользает",
    asyncFix: "фикс: next(err) / wrap(fn)",
    escapeLab: "висит · unhandledRejection",
    trap: "Express 4 не await-ит твой обработчик",
    foot2: "Express 5 прокидывает reject сам · Express 4: оборачивай каждый async",
    caption:
      "Sync-throw ловится и направляется к единой 4-арг границе, а async-reject в Express 4 никогда не await-ится, поэтому ускользает в unhandledRejection и вешает запрос — прокидывай через next(err) или обёртку.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="nh8-solid" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--accent)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="95" width="320" height="210" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="200" y="124" text-anchor="middle" font-size="15" fill="var(--ink)">{t.panelTitle}</text>
    <text x="200" y="147" text-anchor="middle" font-size="12" fill="var(--ink)">{t.panelSig}</text>
    <text x="200" y="168" text-anchor="middle" font-size="11" fill="var(--accent)">{t.panelArity}</text>
    <text x="200" y="200" text-anchor="middle" font-size="11" fill="var(--ink)">{t.map1}</text>
    <text x="200" y="222" text-anchor="middle" font-size="11" fill="var(--ink)">{t.map2}</text>
    <text x="200" y="244" text-anchor="middle" font-size="11" fill="var(--ink)">{t.map3}</text>
    <text x="200" y="270" text-anchor="middle" font-size="11" fill="var(--muted)">{t.viewA}</text>
    <text x="200" y="290" text-anchor="middle" font-size="11" fill="var(--muted)">{t.viewB}</text>

    <rect x="420" y="95" width="340" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="590" y="124" text-anchor="middle" font-size="12" fill="var(--ink)">{t.syncHead}</text>
    <text x="590" y="147" text-anchor="middle" font-size="11" fill="var(--ink)">{t.syncSub}</text>

    <rect x="420" y="195" width="340" height="110" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="590" y="222" text-anchor="middle" font-size="12" fill="var(--ink)">{t.asyncHead}</text>
    <text x="590" y="244" text-anchor="middle" font-size="11" fill="var(--ink)">{t.asyncMid}</text>
    <text x="590" y="266" text-anchor="middle" font-size="11" fill="var(--ink)">{t.asyncFix}</text>
    <text x="590" y="288" text-anchor="middle" font-size="11" fill="var(--muted)">{t.escapeLab}</text>

    <line x1="420" y1="135" x2="368" y2="135" stroke="var(--accent)" stroke-width="2" marker-end="url(#nh8-solid)" />
    <line x1="420" y1="250" x2="372" y2="250" stroke="var(--muted)" stroke-width="2" stroke-dasharray="5 4" />

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--accent)">{t.trap}</text>
    <text x="400" y="386" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
