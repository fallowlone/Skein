---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Abstraction is a deal: you write add(a, b) and get the sum while the body, instructions, and steps stay hidden",
    headline: "A NAME STANDS IN FOR THE DETAIL",
    sub: "the deal: give up the detail, get a short stable name",
    tagVisible: "visible",
    tagHidden: "hidden",
    boxA1: "you write: add(a, b)",
    boxA2: "you get: the sum",
    boxBTitle: "the hidden how",
    boxBBody: "function body · instructions · steps",
    foot1: "after the deal you think about the name, not the machinery",
    foot2: "name in place of detail — that substitution is abstraction",
    caption:
      "Abstraction is a deal: you write add(a, b) and get the sum while the body, instructions, and steps stay hidden — after the deal you think about the name, not the machinery.",
  },
  ru: {
    svgTitle: "Абстракция — это сделка: ты пишешь add(a, b) и получаешь сумму, а тело, инструкции и шаги остаются скрытыми",
    headline: "ИМЯ ЗАМЕНЯЕТ СОБОЙ ДЕТАЛЬ",
    sub: "сделка: откажись от детали, получи короткое имя",
    tagVisible: "видимо",
    tagHidden: "скрыто",
    boxA1: "ты пишешь: add(a, b)",
    boxA2: "ты получаешь: сумму",
    boxBTitle: "скрытое как",
    boxBBody: "тело функции · инструкции · шаги",
    foot1: "после сделки ты думаешь об имени, а не о механизме",
    foot2: "имя вместо детали — эта замена и есть абстракция",
    caption:
      "Абстракция — это сделка: ты пишешь add(a, b) и получаешь сумму, а тело, инструкции и шаги остаются скрытыми — после сделки ты думаешь об имени, а не о механизме.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b10-1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="214" y="138" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagVisible}</text>
    <rect x="230" y="100" width="340" height="65" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="128" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxA1}</text>
    <text x="400" y="150" text-anchor="middle" font-size="13" fill="var(--ink)">{t.boxA2}</text>

    <line x1="400" y1="165" x2="400" y2="200" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b10-1)" />

    <text x="214" y="245" text-anchor="end" font-size="11" fill="var(--muted)">{t.tagHidden}</text>
    <rect x="230" y="200" width="340" height="80" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="228" text-anchor="middle" font-size="12" fill="var(--muted)">{t.boxBTitle}</text>
    <text x="400" y="255" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boxBBody}</text>

    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
