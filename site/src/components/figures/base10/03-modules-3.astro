---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "In one flat space two definitions of format collide, but reached as dateModule.format and currencyModule.format they are different names",
    headline: "ONE NAME PER MODULE — NO COLLISION",
    sub: "flat space: collision · modules: no clash",
    flatTag: "one flat space",
    flatLeft: "format · dates",
    flatRight: "format · currency",
    collideNote: "✗ collision — the second overwrites the first",
    modLeft: "module dates",
    modRight: "module currency",
    via: "reached as",
    leftVia: "dateModule.format",
    rightVia: "currencyModule.format",
    foot1: "✓ different names — no clash",
    foot2: "the module name in front keeps them apart",
    caption:
      "In one flat space two definitions of format collide and the second overwrites the first; reached as dateModule.format and currencyModule.format they are different names, so identical short names do not clash.",
  },
  ru: {
    svgTitle: "В одном плоском пространстве два определения format сталкиваются, но достигаемые как dateModule.format и currencyModule.format — это разные имена",
    headline: "ОДНО ИМЯ НА МОДУЛЬ — БЕЗ СТОЛКНОВЕНИЙ",
    sub: "плоское пространство: столкновение · модули: раздельно",
    flatTag: "одно плоское пространство",
    flatLeft: "format · даты",
    flatRight: "format · валюта",
    collideNote: "✗ столкновение — второе перезаписывает первое",
    modLeft: "модуль дат",
    modRight: "модуль валют",
    via: "достигается как",
    leftVia: "dateModule.format",
    rightVia: "currencyModule.format",
    foot1: "✓ разные имена — не конфликтуют",
    foot2: "имя модуля впереди держит их раздельно",
    caption:
      "В одном плоском пространстве два определения format сталкиваются, и второе перезаписывает первое; достигаемые как dateModule.format и currencyModule.format, они — разные имена, поэтому одинаковые короткие имена не конфликтуют.",
  },
};

const t = dict[lang];

const modules = [
  { x: 80, title: t.modLeft, via: t.leftVia },
  { x: 440, title: t.modRight, via: t.rightVia },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="150" y="84" width="500" height="76" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="106" text-anchor="middle" font-size="11" fill="var(--muted)">{t.flatTag}</text>
    <text x="295" y="140" text-anchor="middle" font-size="13" fill="var(--ink)">{t.flatLeft}</text>
    <text x="400" y="141" text-anchor="middle" font-size="18" fill="var(--ink)">✗</text>
    <text x="505" y="140" text-anchor="middle" font-size="13" fill="var(--ink)">{t.flatRight}</text>

    <text x="400" y="184" text-anchor="middle" font-size="11" fill="var(--muted)">{t.collideNote}</text>

    {modules.map((m) => (
      <g>
        <rect x={m.x} y="204" width="280" height="104" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={m.x + 140} y="228" text-anchor="middle" font-size="11" fill="var(--muted)">{m.title}</text>
        <text x={m.x + 140} y="260" text-anchor="middle" font-size="20" fill="var(--ink)">format</text>
        <text x={m.x + 140} y="288" text-anchor="middle" font-size="11" fill="var(--muted)">{t.via} {m.via}</text>
      </g>
    ))}

    <text x="400" y="342" text-anchor="middle" font-size="12" fill="var(--ink)">{t.foot1}</text>
    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
