---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Call counter.increment(): counter becomes this inside the method and this.count moves the field from 0 to 1",
    headline: "LEFT OF THE DOT BECOMES THIS",
    sub: "counter.increment() → this = counter → count 0 → 1",
    tag1: "caller calls",
    main1a: "counter.",
    main1b: "increment()",
    note1: "names a method",
    tag2: "inside the method",
    main2: "this = counter",
    note2: "left of the dot",
    tag3: "own field",
    main3: "count: 0 → 1",
    note3: "reads 0, writes 1",
    arrow1: "becomes this",
    arrow2: "reads, writes",
    foot1: "this refers to the object the method was called on",
    foot2: "this.count: the count field of the object I belong to",
    caption:
      "Calling counter.increment() makes counter become this inside the method, so this.count reads 0 and writes 1 into that same object's own count field.",
  },
  ru: {
    svgTitle: "Вызов counter.increment(): counter становится this внутри метода, и this.count двигает поле от 0 к 1",
    headline: "СЛЕВА ОТ ТОЧКИ — СТАНОВИТСЯ THIS",
    sub: "counter.increment() → this = counter → count 0 → 1",
    tag1: "вызов",
    main1a: "counter.",
    main1b: "increment()",
    note1: "называет метод",
    tag2: "внутри метода",
    main2: "this = counter",
    note2: "слева от точки",
    tag3: "своё поле",
    main3: "count: 0 → 1",
    note3: "читает 0, записывает 1",
    arrow1: "становится this",
    arrow2: "читает, пишет",
    foot1: "this ссылается на объект, на котором метод был вызван",
    foot2: "this.count — поле count объекта, которому я принадлежу",
    caption:
      "Вызов counter.increment() делает counter значением this внутри метода, поэтому this.count читает 0 и записывает 1 в собственное поле count того же объекта.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="50" y="100" width="160" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="130" y="130" text-anchor="middle" font-size="10" fill="var(--muted)">{t.tag1}</text>
    <text x="130" y="172" text-anchor="middle" font-size="13" fill="var(--ink)">{t.main1a}</text>
    <text x="130" y="194" text-anchor="middle" font-size="13" fill="var(--ink)">{t.main1b}</text>
    <text x="130" y="236" text-anchor="middle" font-size="10" fill="var(--muted)">{t.note1}</text>

    <rect x="315" y="100" width="160" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="395" y="130" text-anchor="middle" font-size="10" fill="var(--muted)">{t.tag2}</text>
    <text x="395" y="183" text-anchor="middle" font-size="12" fill="var(--ink)">{t.main2}</text>
    <text x="395" y="236" text-anchor="middle" font-size="10" fill="var(--muted)">{t.note2}</text>

    <rect x="580" y="100" width="160" height="170" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="660" y="130" text-anchor="middle" font-size="10" fill="var(--muted)">{t.tag3}</text>
    <text x="660" y="183" text-anchor="middle" font-size="13" fill="var(--ink)">{t.main3}</text>
    <text x="660" y="236" text-anchor="middle" font-size="10" fill="var(--muted)">{t.note3}</text>

    <line x1="210" y1="183" x2="307" y2="183" stroke="var(--accent)" stroke-width="1.6" />
    <path d="M 315 183 L 307 179 L 307 187 Z" fill="var(--accent)" />
    <text x="262" y="168" text-anchor="middle" font-size="10" fill="var(--accent)">{t.arrow1}</text>

    <line x1="475" y1="183" x2="572" y2="183" stroke="var(--accent)" stroke-width="1.6" />
    <path d="M 580 183 L 572 179 L 572 187 Z" fill="var(--accent)" />
    <text x="527" y="168" text-anchor="middle" font-size="10" fill="var(--accent)">{t.arrow2}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="358" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
