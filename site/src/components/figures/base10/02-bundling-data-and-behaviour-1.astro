---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Counter object with two kinds of field: data field count holding 0 and method fields increment and value holding functions",
    headline: "TWO KINDS OF FIELD",
    sub: "counter: 3 fields — count, increment, value",
    dataHead: "data fields — hold state",
    dataRow: "count = 0",
    dataNote: "a number — the object's state",
    methHead: "method fields — hold functions",
    methRow1: "increment()",
    methRow2: "value()",
    methNote: "read or change that state",
    bracket: "one named unit: counter",
    foot1: "a field can hold a function — not just a number",
    foot2: "1 data field + 2 method fields = the bundle",
    caption:
      "The counter object has two kinds of field: the data field count holds the number 0, while the method fields increment and value hold functions that read or change that state.",
  },
  ru: {
    svgTitle: "Объект counter с двумя родами полей: поле данных count хранит 0, а поля-методы increment и value хранят функции",
    headline: "ДВА РОДА ПОЛЕЙ",
    sub: "counter: 3 поля — count, increment, value",
    dataHead: "поля данных — хранят состояние",
    dataRow: "count = 0",
    dataNote: "число — состояние объекта",
    methHead: "поля-методы — хранят функции",
    methRow1: "increment()",
    methRow2: "value()",
    methNote: "читают или меняют состояние",
    bracket: "одна именованная единица: counter",
    foot1: "поле может хранить функцию, а не только число",
    foot2: "1 поле данных + 2 поля-метода = связка",
    caption:
      "У объекта counter два рода полей: поле данных count хранит число 0, а поля-методы increment и value хранят функции, которые читают или меняют это состояние.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="80" y="90" width="300" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="230" y="120" text-anchor="middle" font-size="11" fill="var(--muted)">{t.dataHead}</text>
    <line x1="100" y1="136" x2="360" y2="136" stroke="var(--muted)" stroke-width="1" />
    <text x="230" y="188" text-anchor="middle" font-size="20" fill="var(--ink)">{t.dataRow}</text>
    <text x="230" y="232" text-anchor="middle" font-size="11" fill="var(--muted)">{t.dataNote}</text>

    <rect x="420" y="90" width="300" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="570" y="120" text-anchor="middle" font-size="11" fill="var(--muted)">{t.methHead}</text>
    <line x1="440" y1="136" x2="700" y2="136" stroke="var(--accent)" stroke-width="1" />
    <text x="570" y="176" text-anchor="middle" font-size="15" fill="var(--ink)">{t.methRow1}</text>
    <text x="570" y="206" text-anchor="middle" font-size="15" fill="var(--ink)">{t.methRow2}</text>
    <text x="570" y="244" text-anchor="middle" font-size="11" fill="var(--muted)">{t.methNote}</text>

    <line x1="80" y1="296" x2="80" y2="304" stroke="var(--accent)" stroke-width="1.6" />
    <line x1="80" y1="304" x2="720" y2="304" stroke="var(--accent)" stroke-width="1.6" />
    <line x1="720" y1="296" x2="720" y2="304" stroke="var(--accent)" stroke-width="1.6" />
    <text x="400" y="326" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bracket}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="380" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
