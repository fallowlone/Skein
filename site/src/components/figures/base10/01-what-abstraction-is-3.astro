---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "You hold one name add in your head while the machine still runs hundreds of instructions and every gate still switches",
    headline: "ONE NAME INSTEAD OF HUNDREDS",
    sub: "use add while thinking only about the interface",
    topName: "add",
    topNote: "1 thing in your head",
    hides: "hides",
    bottomTitle: "the machine still runs every instruction",
    moreTag: "+ hundreds more",
    gatesNote: "every gate still switches",
    foot1: "one thing to think about instead of hundreds",
    foot2: "hidden from your attention, not from the machine",
    caption:
      "Abstraction cuts the chain: once add works, you hold one name in your head while the machine still runs hundreds of instructions and every gate still switches — hidden from your attention, not from the machine.",
  },
  ru: {
    svgTitle: "Ты держишь в уме одно имя add, а машина по-прежнему выполняет сотни инструкций и каждый вентиль переключается",
    headline: "ОДНО ИМЯ ВМЕСТО СОТЕН",
    sub: "пользуйся add, думая только об интерфейсе",
    topName: "add",
    topNote: "1 вещь в твоей голове",
    hides: "скрывает",
    bottomTitle: "машина выполняет каждую инструкцию",
    moreTag: "+ сотни таких же",
    gatesNote: "каждый вентиль переключается",
    foot1: "одна вещь для осмысления вместо сотен",
    foot2: "скрыто от твоего внимания, а не от машины",
    caption:
      "Абстракция разрывает цепь: как только add работает, ты держишь в уме одно имя, а машина по-прежнему выполняет сотни инструкций и каждый вентиль переключается — скрыто от твоего внимания, а не от машины.",
  },
};

const t = dict[lang];

const cells = [0, 1, 2, 3, 4];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b10-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="200" y="100" width="400" height="65" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="132" text-anchor="middle" font-size="26" fill="var(--ink)">{t.topName}</text>
    <text x="400" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.topNote}</text>

    <line x1="400" y1="165" x2="400" y2="195" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b10-3)" />
    <text x="412" y="185" font-size="11" fill="var(--muted)">{t.hides}</text>

    <rect x="200" y="195" width="400" height="105" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="218" text-anchor="middle" font-size="12" fill="var(--muted)">{t.bottomTitle}</text>
    {cells.map((i) => (
      <rect x={230 + i * 50} y="232" width="40" height="28" fill="var(--card)" stroke="var(--muted)" stroke-width="1.4" />
    ))}
    <text x="480" y="250" font-size="11" fill="var(--muted)">{t.moreTag}</text>
    <text x="400" y="285" text-anchor="middle" font-size="11" fill="var(--muted)">{t.gatesNote}</text>

    <text x="400" y="335" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
