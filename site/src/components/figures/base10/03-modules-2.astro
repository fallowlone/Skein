---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The boundary gives two guarantees: outside code cannot touch private state, and renaming a private name breaks zero outside lines",
    headline: "THE BOUNDARY DOES REAL PROTECTIVE WORK",
    sub: "two failures become impossible",
    panelA: "outside cannot touch private state",
    outBox: "outside",
    outWant: "read? write?",
    counter: "counter",
    counterOk: "≥ 0 ✓",
    resA1: "the count stays safe",
    resA2: "only its own code can change it",
    resA3: "changed from exactly 1 place",
    panelB: "a rename breaks 0 outside lines",
    rename: "TABLE → LOOKUP",
    renameSub: "rename inside",
    outZero: "0 lines change",
    resB1: "nothing outside depends on it",
    resB2: "only exports are a commitment",
    resB3: "rewrite internals freely",
    foot1: "fixed interface, replaceable implementation",
    foot2: "the boundary turns a hope into a guarantee",
    caption:
      "The boundary makes two failures impossible: outside code cannot read or overwrite private state, and renaming a private name breaks zero outside lines — only exported names are a commitment.",
  },
  ru: {
    svgTitle: "Граница даёт две гарантии: внешний код не может тронуть приватное состояние, а переименование приватного имени ломает ноль внешних строк",
    headline: "ГРАНИЦА ДЕЛАЕТ ЗАЩИТНУЮ РАБОТУ",
    sub: "два сбоя становятся невозможными",
    panelA: "снаружи приватное не тронуть",
    outBox: "снаружи",
    outWant: "читать? писать?",
    counter: "счётчик",
    counterOk: "≥ 0 ✓",
    resA1: "счётчик в безопасности",
    resA2: "изменить может лишь свой код",
    resA3: "меняется ровно из 1 места",
    panelB: "переименование: 0 строк снаружи",
    rename: "TABLE → LOOKUP",
    renameSub: "переименование внутри",
    outZero: "0 строк меняется",
    resB1: "снаружи ничто не зависит",
    resB2: "обязательство — только экспорты",
    resB3: "переписывай внутренности свободно",
    foot1: "неизменный интерфейс, заменяемая реализация",
    foot2: "граница превращает надежду в гарантию",
    caption:
      "Граница делает два сбоя невозможными: внешний код не может прочитать или перезаписать приватное состояние, а переименование приватного имени ломает ноль внешних строк — обязательство только экспортированные имена.",
  },
};

const t = dict[lang];

const resultsA = [t.resA1, t.resA2, t.resA3];
const resultsB = [t.resB1, t.resB2, t.resB3];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="80" width="340" height="250" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="210" y="106" text-anchor="middle" font-size="12" fill="var(--ink)">{t.panelA}</text>

    <rect x="60" y="150" width="120" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="1" />
    <text x="120" y="176" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outBox}</text>
    <text x="120" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.outWant}</text>

    <line x1="180" y1="180" x2="259" y2="180" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#mod2-ink)" />
    <text x="220" y="172" text-anchor="middle" font-size="14" fill="var(--ink)">✗</text>

    <rect x="260" y="150" width="100" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="1" />
    <text x="310" y="176" text-anchor="middle" font-size="12" fill="var(--ink)">{t.counter}</text>
    <text x="310" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.counterOk}</text>

    {resultsA.map((r, i) => (
      <text x="210" y={250 + i * 24} text-anchor="middle" font-size="11" fill="var(--muted)">{r}</text>
    ))}

    <rect x="420" y="80" width="340" height="250" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="590" y="106" text-anchor="middle" font-size="12" fill="var(--ink)">{t.panelB}</text>

    <rect x="440" y="150" width="140" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="1" />
    <text x="510" y="176" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rename}</text>
    <text x="510" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.renameSub}</text>

    <line x1="580" y1="180" x2="619" y2="180" stroke="var(--ink)" stroke-width="1.5" marker-end="url(#mod2-ink)" />
    <text x="600" y="172" text-anchor="middle" font-size="14" fill="var(--ink)">✓</text>

    <rect x="620" y="150" width="120" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="1" />
    <text x="680" y="176" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outBox}</text>
    <text x="680" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.outZero}</text>

    {resultsB.map((r, i) => (
      <text x="590" y={250 + i * 24} text-anchor="middle" font-size="11" fill="var(--muted)">{r}</text>
    ))}

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>

    <defs>
      <marker id="mod2-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--ink)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
