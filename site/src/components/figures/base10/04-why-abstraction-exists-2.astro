---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four-layer stack of the track: constructs on top, then language, machine code, gates at the bottom; you reason at the top",
    headline: "THE TRACK WAS ONE LAYER STACK",
    sub: "4 layers · you reason at the top",
    layers: ["constructs: values … modules", "a programming language", "machine code", "gates: on / off"],
    units: ["Units 05–10", "Unit 04", "Units 03–04", "Unit 01"],
    rightTop: "you reason here",
    rightBot1: "still runs —",
    rightBot2: "not in your head",
    foot1: "each rung: use it, stop re-deriving it",
    caption:
      "The track as a four-layer stack: gates, machine code, a programming language, constructs — you reason at the top layer while the three below keep running out of mind.",
  },
  ru: {
    svgTitle: "Стек трека из четырёх слоёв: конструкции сверху, затем язык, машинный код, вентили внизу; ты рассуждаешь наверху",
    headline: "ТРЕК БЫЛ ОДНИМ СТЕКОМ СЛОЁВ",
    sub: "4 слоя · ты рассуждаешь наверху",
    layers: ["конструкции: значения … модули", "язык программирования", "машинный код", "вентили: вкл / выкл"],
    units: ["разделы 05–10", "раздел 04", "разделы 03–04", "раздел 01"],
    rightTop: "ты рассуждаешь здесь",
    rightBot1: "выполняются —",
    rightBot2: "не в твоей голове",
    foot1: "каждая ступень: пользуйся, не выводи заново",
    caption:
      "Трек как стек из четырёх слоёв: вентили, машинный код, язык программирования, конструкции — ты рассуждаешь на верхнем слое, пока три нижних выполняются вне внимания.",
  },
};

const t = dict[lang];

const ys = [100, 168, 236, 304];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.layers.map((label, i) => (
      <g>
        <text x="140" y={ys[i] + 32} text-anchor="end" font-size="11" fill="var(--muted)">{t.units[i]}</text>
        <rect
          x="150"
          y={ys[i]}
          width="300"
          height="56"
          fill="var(--card)"
          stroke={i === 0 ? "var(--accent)" : "var(--muted)"}
          stroke-width={i === 0 ? 2 : 1.6}
        />
        <text x="300" y={ys[i] + 35} text-anchor="middle" font-size="12" fill="var(--ink)">{label}</text>
      </g>
    ))}

    <line x1="450" y1="128" x2="486" y2="128" stroke="var(--accent)" stroke-width="1.6" />
    <text x="494" y="132" font-size="12" fill="var(--accent)">{t.rightTop}</text>

    <line x1="486" y1="196" x2="486" y2="332" stroke="var(--muted)" stroke-width="1.6" />
    <line x1="450" y1="196" x2="486" y2="196" stroke="var(--muted)" stroke-width="1.6" />
    <line x1="450" y1="264" x2="486" y2="264" stroke="var(--muted)" stroke-width="1.6" />
    <line x1="450" y1="332" x2="486" y2="332" stroke="var(--muted)" stroke-width="1.6" />
    <text x="494" y="258" font-size="11" fill="var(--muted)">{t.rightBot1}</text>
    <text x="494" y="274" font-size="11" fill="var(--muted)">{t.rightBot2}</text>

    <text x="400" y="388" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
