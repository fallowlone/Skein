---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Encapsulation: the caller reaches only the methods increment and value while the field count stays hidden and moves from 0 to 2",
    headline: "CALL METHODS, NEVER TOUCH FIELDS",
    sub: "counter.increment() twice, then value() → 2",
    callerTag: "caller",
    callerMain: "methods only",
    callerNote: "names 0 data fields",
    ifHead: "interface — methods you can call",
    ifRow1: "increment()",
    ifRow2: "value()",
    ifNote: "2 methods exposed",
    implHead: "implementation — field layout hidden",
    implRow: "count = 0 → 2",
    implNote: "1 field hidden",
    arrowCall: "calls",
    arrowNever: "never",
    foot1: "callers name only methods — never the field count",
    foot2: "rename count tomorrow — no caller changes",
    caption:
      "The bundle exposes its methods as the interface and hides the field layout as the implementation: the caller writes counter.increment() and counter.value() and never names count, so renaming count changes no caller.",
  },
  ru: {
    svgTitle: "Инкапсуляция: вызывающая сторона достигает только методов increment и value, а поле count скрыто и движется от 0 к 2",
    headline: "ВЫЗЫВАЙ МЕТОДЫ, НЕ ТРОГАЙ ПОЛЯ",
    sub: "counter.increment() дважды, затем value() → 2",
    callerTag: "вызывающая сторона",
    callerMain: "только методы",
    callerNote: "называет 0 полей",
    ifHead: "интерфейс — методы, что можно вызвать",
    ifRow1: "increment()",
    ifRow2: "value()",
    ifNote: "2 метода открыты",
    implHead: "реализация — устройство полей скрыто",
    implRow: "count = 0 → 2",
    implNote: "1 поле скрыто",
    arrowCall: "вызывает",
    arrowNever: "никогда",
    foot1: "вызывающая сторона называет только методы",
    foot2: "переименуй count — вызывающие не изменятся",
    caption:
      "Связка предоставляет методы как интерфейс и скрывает устройство полей как реализацию: вызывающая сторона пишет counter.increment() и counter.value() и никогда не называет count, поэтому переименование count не меняет ни одну вызывающую сторону.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="50" y="130" width="150" height="120" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="125" y="158" text-anchor="middle" font-size="10" fill="var(--muted)">{t.callerTag}</text>
    <text x="125" y="195" text-anchor="middle" font-size="12" fill="var(--ink)">{t.callerMain}</text>
    <text x="125" y="222" text-anchor="middle" font-size="10" fill="var(--muted)">{t.callerNote}</text>

    <rect x="280" y="90" width="440" height="230" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="500" y="118" text-anchor="middle" font-size="11" fill="var(--accent)">{t.ifHead}</text>
    <text x="500" y="150" text-anchor="middle" font-size="13" fill="var(--ink)">{t.ifRow1}</text>
    <text x="500" y="176" text-anchor="middle" font-size="13" fill="var(--ink)">{t.ifRow2}</text>
    <text x="500" y="199" text-anchor="middle" font-size="10" fill="var(--muted)">{t.ifNote}</text>
    <line x1="280" y1="212" x2="720" y2="212" stroke="var(--muted)" stroke-width="1" stroke-dasharray="4 3" />
    <text x="500" y="240" text-anchor="middle" font-size="11" fill="var(--muted)">{t.implHead}</text>
    <text x="500" y="274" text-anchor="middle" font-size="14" fill="var(--ink)">{t.implRow}</text>
    <text x="500" y="300" text-anchor="middle" font-size="10" fill="var(--muted)">{t.implNote}</text>

    <line x1="200" y1="155" x2="272" y2="155" stroke="var(--accent)" stroke-width="1.6" />
    <path d="M 280 155 L 272 151 L 272 159 Z" fill="var(--accent)" />
    <text x="240" y="143" text-anchor="middle" font-size="10" fill="var(--accent)">{t.arrowCall}</text>

    <line x1="200" y1="225" x2="270" y2="260" stroke="var(--muted)" stroke-width="1.4" />
    <path d="M 280 265 L 269 259 L 270 269 Z" fill="var(--muted)" />
    <line x1="234" y1="238" x2="246" y2="250" stroke="var(--accent)" stroke-width="2" />
    <line x1="246" y1="238" x2="234" y2="250" stroke="var(--accent)" stroke-width="2" />
    <text x="240" y="272" text-anchor="middle" font-size="10" fill="var(--muted)">{t.arrowNever}</text>

    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="378" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
