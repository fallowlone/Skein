---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The function half has two sides: the interface is three facts, the local variable, division order, and CPU instruction stay hidden",
    headline: "TWO SIDES OF ONE ABSTRACTION",
    sub: "half(10) → 5 · three facts on the surface, machinery underneath",
    ifaceTitle: "INTERFACE — what you use",
    ifaceRows: ["1 · name: half", "2 · takes one number", "3 · returns n / 2"],
    hides: "hides",
    implTitle: "IMPLEMENTATION — hidden how",
    implRows: ["· local variable result", "· division happens before return", "· the CPU divide instruction"],
    foot1: "fixed interface, replaceable implementation",
    foot2: "rename result — the caller half(10) never changes",
    caption:
      "The function half has two sides: the interface is three facts (the name half, one number in, half of it out), while the local variable, the division order, and the CPU instruction stay hidden — the implementation can move while the interface holds.",
  },
  ru: {
    svgTitle: "У функции half две стороны: интерфейс — это три факта, а переменная, порядок деления и инструкция CPU скрыты",
    headline: "ДВЕ СТОРОНЫ ОДНОЙ АБСТРАКЦИИ",
    sub: "half(10) → 5 · три факта на поверхности, механизм под ней",
    ifaceTitle: "ИНТЕРФЕЙС — чем ты пользуешься",
    ifaceRows: ["1 · имя: half", "2 · принимает одно число", "3 · возвращает n / 2"],
    hides: "скрывает",
    implTitle: "РЕАЛИЗАЦИЯ — скрытое как",
    implRows: ["· переменная result", "· деление перед возвратом", "· инструкция деления CPU"],
    foot1: "неизменный интерфейс, заменяемая реализация",
    foot2: "переименуй result — вызов half(10) не изменится",
    caption:
      "У функции half две стороны: интерфейс — это три факта (имя half, одно число на вход, его половина на выход), а локальная переменная, порядок деления и инструкция CPU скрыты — реализация может меняться, пока интерфейс держится.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="arr-b10-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="170" y="90" width="460" height="98" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="195" y="113" font-size="12" fill="var(--ink)">{t.ifaceTitle}</text>
    {t.ifaceRows.map((r, i) => (
      <text x="195" y={136 + i * 20} font-size="11" fill="var(--ink)">{r}</text>
    ))}

    <line x1="400" y1="188" x2="400" y2="212" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-b10-2)" />
    <text x="412" y="206" font-size="11" fill="var(--muted)">{t.hides}</text>

    <rect x="170" y="212" width="460" height="90" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="195" y="235" font-size="12" fill="var(--muted)">{t.implTitle}</text>
    {t.implRows.map((r, i) => (
      <text x="195" y={256 + i * 19} font-size="11" fill="var(--muted)">{r}</text>
    ))}

    <text x="400" y="335" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
