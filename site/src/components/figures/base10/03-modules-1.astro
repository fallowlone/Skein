---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The text-format module holds four names; only format is exported and crosses the boundary, while TABLE, pad and trim stay private inside",
    headline: "THE BOUNDARY LETS ONE NAME OUT, KEEPS THREE IN",
    sub: "module text-format · 4 definitions · 1 export",
    moduleTag: "module text-format",
    exportRow: "export format(s)",
    privateTag: "private",
    crosses: "crosses ✓",
    outside1: "outside code",
    outside2: "uses format only",
    staysIn: "stays inside",
    foot1: "1 export crosses · 3 names stay private",
    foot2: "outside code names format and nothing else",
    caption:
      "The text-format module holds TABLE, pad, trim and format, but only format is exported: outside code reaches format through the boundary and cannot name the three private names.",
  },
  ru: {
    svgTitle: "Модуль text-format хранит четыре имени; экспортирована только format и пересекает границу, а TABLE, pad и trim остаются приватными внутри",
    headline: "ГРАНИЦА ВЫПУСКАЕТ ОДНО ИМЯ, ДЕРЖИТ ТРИ",
    sub: "модуль text-format · 4 определения · 1 экспорт",
    moduleTag: "модуль text-format",
    exportRow: "export format(s)",
    privateTag: "приватное",
    crosses: "выходит ✓",
    outside1: "внешний код",
    outside2: "только format",
    staysIn: "остаётся внутри",
    foot1: "1 экспорт выходит · 3 имени приватны",
    foot2: "внешний код называет format и больше ничего",
    caption:
      "Модуль text-format хранит TABLE, pad, trim и format, но экспортирована только format: внешний код достигает format через границу и не может назвать три приватных имени.",
  },
};

const t = dict[lang];

const privates = [
  { name: "pad(s)", y: 178 },
  { name: "TABLE", y: 232 },
  { name: "trim(s)", y: 286 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <path d="M400,128 V88 H60 V348 H400 V164" fill="none" stroke="var(--ink)" stroke-width="2" />
    <text x="80" y="112" font-size="12" fill="var(--muted)">{t.moduleTag}</text>

    <rect x="80" y="124" width="250" height="44" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="92" y="151" font-size="12" fill="var(--ink)">{t.exportRow}</text>

    {privates.map((p) => (
      <g>
        <rect x="80" y={p.y} width="250" height="44" fill="var(--card)" stroke="var(--ink)" stroke-width="1" />
        <text x="92" y={p.y + 27} font-size="12" fill="var(--ink)">{p.name} · {t.privateTag}</text>
        <line x1="330" y1={p.y + 22} x2="399" y2={p.y + 22} stroke="var(--ink)" stroke-width="1.5" marker-end="url(#mod1-ink)" />
        <text x="364" y={p.y + 13} text-anchor="middle" font-size="14" fill="var(--ink)">✗</text>
        <text x="410" y={p.y + 26} font-size="11" fill="var(--muted)">{t.staysIn}</text>
      </g>
    ))}

    <line x1="330" y1="146" x2="551" y2="146" stroke="var(--accent)" stroke-width="2" marker-end="url(#mod1-acc)" />
    <text x="441" y="136" text-anchor="middle" font-size="11" fill="var(--accent)">{t.crosses}</text>

    <rect x="552" y="106" width="188" height="80" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="646" y="139" text-anchor="middle" font-size="12" fill="var(--ink)">{t.outside1}</text>
    <text x="646" y="161" text-anchor="middle" font-size="11" fill="var(--muted)">{t.outside2}</text>

    <text x="400" y="374" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="394" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>

    <defs>
      <marker id="mod1-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
      </marker>
      <marker id="mod1-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--ink)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
