---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Leaky abstraction: a working call hides stack frames, a failing recursive call surfaces them with a stack overflow",
    headline: "WHEN IT FAILS, THE LAYER BELOW SURFACES",
    sub: "leaky: the layer below shows through",
    leftTitle: "while it works",
    rightTitle: "when it fails",
    leftTop: "f() runs, returns",
    leftHidden: "stack frames — hidden",
    leftNote: "you ignore the stack",
    rightTop: "f() calls itself…",
    rightHidden: "the stack surfaces!",
    leakLabel: "stack overflow",
    rightNote: "you must know the stack",
    foot1: "law: all non-trivial abstractions leak",
    foot2: "saves working time, not learning time",
    caption:
      "A leaky abstraction: while f() works you ignore the stack, but runaway recursion overflows it and the hidden layer surfaces — all non-trivial abstractions leak.",
  },
  ru: {
    svgTitle: "Протекающая абстракция: работающий вызов скрывает кадры стека, падающий рекурсивный вызов проявляет их переполнением стека",
    headline: "КОГДА ПАДАЕТ — ВЫХОДИТ НА ПОВЕРХНОСТЬ",
    sub: "протечка: слой снизу проступает",
    leftTitle: "пока всё работает",
    rightTitle: "когда слой падает",
    leftTop: "f() выполняется, возвращается",
    leftHidden: "кадры стека — скрыты",
    leftNote: "ты игнорируешь стек",
    rightTop: "f() вызывает себя…",
    rightHidden: "стек выходит наружу!",
    leakLabel: "переполнение стека",
    rightNote: "ты должен знать стек",
    foot1: "закон: все нетривиальные абстракции протекают",
    foot2: "экономит время работы, а не изучения",
    caption:
      "Протекающая абстракция: пока f() работает, ты игнорируешь стек, но неуправляемая рекурсия переполняет его, и скрытый слой выходит на поверхность, — все нетривиальные абстракции протекают.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <line x1="400" y1="100" x2="400" y2="300" stroke="var(--muted)" stroke-width="1" />

    <text x="210" y="112" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftTitle}</text>
    <rect x="90" y="130" width="240" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="210" y="161" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTop}</text>
    <line x1="210" y1="182" x2="210" y2="210" stroke="var(--muted)" stroke-width="1.6" />
    <rect x="90" y="210" width="240" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" stroke-dasharray="5 4" />
    <text x="210" y="245" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftHidden}</text>
    <text x="210" y="294" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftNote}</text>

    <text x="590" y="112" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightTitle}</text>
    <rect x="470" y="130" width="240" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="590" y="161" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTop}</text>
    <line x1="590" y1="210" x2="590" y2="182" stroke="var(--accent)" stroke-width="2" />
    <polygon points="590,182 583,194 597,194" fill="var(--accent)" />
    <text x="578" y="200" text-anchor="end" font-size="11" fill="var(--accent)">{t.leakLabel}</text>
    <rect x="470" y="210" width="240" height="60" fill="var(--card)" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" />
    <text x="590" y="245" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rightHidden}</text>
    <text x="590" y="294" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightNote}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
