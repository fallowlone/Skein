---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Complexity funnel: billions of gate switches per second shrink through abstraction to one line of code held in mind",
    headline: "ABSTRACTION SHRINKS WHAT YOU HOLD",
    sub: "complexity = things you must hold in mind at once",
    leftBig: "billions",
    leftSmall1: "of gate switches",
    leftSmall2: "per second",
    rightCode: "one line of code",
    rightSmall: "you hold this in mind",
    arrowLabel: "abstraction shrinks",
    foot1: "billions of gates still switch — you just don't think about them",
    foot2: "without it, programming would be physically impossible",
    caption:
      "Complexity is what you must hold in mind: billions of gate switches per second shrink to one line of code — the gates still switch, you just stop thinking about them.",
  },
  ru: {
    svgTitle: "Воронка сложности: миллиарды переключений вентилей в секунду через абстракцию сжимаются до одной строки кода в уме",
    headline: "АБСТРАКЦИЯ СЖИМАЕТ ТО, ЧТО В УМЕ",
    sub: "сложность = что нужно держать в уме сразу",
    leftBig: "миллиарды",
    leftSmall1: "переключений вентилей",
    leftSmall2: "в секунду",
    rightCode: "одна строка кода",
    rightSmall: "это — в твоей голове",
    arrowLabel: "абстракция сжимает",
    foot1: "миллиарды вентилей переключаются — ты о них не думаешь",
    foot2: "без неё программирование было бы физически невозможно",
    caption:
      "Сложность — это то, что нужно держать в уме: миллиарды переключений вентилей в секунду сжимаются до одной строки кода — вентили по-прежнему переключаются, ты просто перестаёшь о них думать.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="150" width="260" height="120" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="190" y="196" text-anchor="middle" font-size="22" fill="var(--ink)">{t.leftBig}</text>
    <text x="190" y="219" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftSmall1}</text>
    <text x="190" y="237" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftSmall2}</text>

    <text x="400" y="192" text-anchor="middle" font-size="11" fill="var(--accent)">{t.arrowLabel}</text>
    <line x1="320" y1="210" x2="480" y2="210" stroke="var(--accent)" stroke-width="2" />
    <polygon points="480,210 466,202 466,218" fill="var(--accent)" />

    <rect x="480" y="150" width="260" height="120" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="610" y="198" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightCode}</text>
    <text x="610" y="224" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightSmall}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
