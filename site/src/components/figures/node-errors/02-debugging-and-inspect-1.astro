---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Inspector attach flow: node with inspect-brk opens a WebSocket on 127.0.0.1:9229, DevTools attaches, and execution pauses on a breakpoint",
    headline: "ATTACH, THEN PAUSE",
    sub: "the process is the server, the debugger is the client",
    step1: "1 · launch",
    step2: "2 · socket",
    step3: "3 · attach",
    box1a: "node --inspect-brk app.js",
    box1b: "breaks before line 1",
    box2a: "ws://127.0.0.1:9229",
    box2b: "waits for debugger",
    box3a: "chrome://inspect",
    box3b: "DevTools / VS Code",
    box3c: "pause on breakpoint",
    lineA: "--inspect: code runs now — can miss a fast boot crash",
    lineB: "--inspect-brk: frozen before line 1 — the bug cannot outrun attach",
    foot: "127.0.0.1:9229 — localhost only",
    caption:
      "node --inspect starts the V8 Inspector WebSocket on 127.0.0.1:9229 and DevTools attaches to it; --inspect-brk freezes before the first line so a startup bug cannot outrun the attach.",
  },
  ru: {
    svgTitle: "Подключение инспектора: node с inspect-brk открывает WebSocket на 127.0.0.1:9229, DevTools цепляется, и выполнение встаёт на брейкпоинте",
    headline: "ПОДЦЕПИСЬ, ПОТОМ ПАУЗА",
    sub: "процесс — сервер, отладчик — клиент",
    step1: "1 · запуск",
    step2: "2 · сокет",
    step3: "3 · подцеп",
    box1a: "node --inspect-brk app.js",
    box1b: "ломает до первой строки",
    box2a: "ws://127.0.0.1:9229",
    box2b: "ждёт отладчик",
    box3a: "chrome://inspect",
    box3b: "DevTools / VS Code",
    box3c: "пауза на брейкпоинте",
    lineA: "--inspect: код бежит сразу — может упустить падение",
    lineB: "--inspect-brk: замер до строки 1 — баг не убежит от подцепа",
    foot: "127.0.0.1:9229 — только localhost",
    caption:
      "node --inspect поднимает WebSocket V8 Inspector на 127.0.0.1:9229, и DevTools цепляется к нему; --inspect-brk замораживает до первой строки, так что баг старта не успевает убежать от подключения.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="135" y="86" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step1}</text>
    <text x="400" y="86" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step2}</text>
    <text x="665" y="86" text-anchor="middle" font-size="11" fill="var(--muted)">{t.step3}</text>

    <rect x="30" y="110" width="210" height="84" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="135" y="142" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1a}</text>
    <text x="135" y="166" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1b}</text>

    <rect x="295" y="110" width="210" height="84" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="142" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2a}</text>
    <text x="400" y="166" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2b}</text>

    <rect x="560" y="110" width="210" height="84" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="665" y="134" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3a}</text>
    <text x="665" y="156" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3b}</text>
    <text x="665" y="178" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3c}</text>

    <line x1="248" y1="152" x2="287" y2="152" stroke="var(--muted)" stroke-width="2" />
    <polygon points="287,146 299,152 287,158" fill="var(--muted)" />
    <line x1="513" y1="152" x2="552" y2="152" stroke="var(--muted)" stroke-width="2" />
    <polygon points="552,146 564,152 552,158" fill="var(--muted)" />

    <text x="400" y="252" text-anchor="middle" font-size="12" fill="var(--muted)">{t.lineA}</text>
    <text x="400" y="280" text-anchor="middle" font-size="12" fill="var(--muted)">{t.lineB}</text>
    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--ink)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
