---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Breakpoint tradeoff: a conditional breakpoint pauses only on match, a logpoint prints without halting, and console.log always formats and writes",
    headline: "SIGNAL WITHOUT THE NOISE",
    sub: "pause only where it matters",
    row1a: "conditional breakpoint: userId === 42",
    row1b: "pauses only on match · targeted signal",
    row2a: "logpoint — prints the expression, no halt",
    row2b: "values without a pause · lighter still",
    row3a: "console.log — prints on every request",
    row3b: "always formats + writes · pollutes logs",
    foot: "match the tool to the moment",
    caption:
      "A conditional breakpoint pauses only on the failing case, a logpoint prints without halting, and console.log formats and writes on every request — targeted signal beats always-on noise.",
  },
  ru: {
    svgTitle: "Компромисс брейкпоинтов: условный брейкпоинт встаёт только на совпадении, logpoint печатает без остановки, а console.log всегда форматирует и пишет",
    headline: "СИГНАЛ БЕЗ ШУМА",
    sub: "пауза только там, где важно",
    row1a: "условный брейкпоинт: userId === 42",
    row1b: "пауза только на совпадении · точечный сигнал",
    row2a: "logpoint — печатает выражение без паузы",
    row2b: "значения без остановки · ещё легче",
    row3a: "console.log — печатает на каждый запрос",
    row3b: "всегда форматирует + пишет · засоряет логи",
    foot: "подбирай инструмент под момент",
    caption:
      "Условный брейкпоинт встаёт только на падающем случае, logpoint печатает без остановки, а console.log форматирует и пишет на каждый запрос — точечный сигнал бьёт вечный шум.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="106" width="720" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="132" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row1a}</text>
    <text x="400" y="156" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row1b}</text>

    <rect x="40" y="192" width="720" height="66" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="218" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row2a}</text>
    <text x="400" y="242" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row2b}</text>

    <rect x="40" y="278" width="720" height="66" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="400" y="304" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row3a}</text>
    <text x="400" y="328" text-anchor="middle" font-size="11" fill="var(--ink)">{t.row3b}</text>

    <text x="400" y="384" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
