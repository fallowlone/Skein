---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "AsyncLocalStorage carries one store across every await to the deep logger, while a module-level global is overwritten by the next concurrent request",
    headline: "ONE STORE PER ASYNC TREE",
    sub: "per-context store that survives await — a global cannot",
    laneGood: "ALS: same id, no args",
    laneBad: "global: wrong id",
    boundary: "boundary: als.run(store)",
    boundaryLine: "once per request",
    mid: "across await / callbacks",
    midLine: "timers, promises",
    deep: "deep logger",
    deepLine: "getStore() → same id",
    glob: "module-level global",
    globLine: "let currentTraceId",
    clash: "request B overwrites",
    clashLine: "while A awaits I/O",
    broken: "A logs with B's id",
    brokenLine: "traces cross-contaminate",
    foot: "one store per async call tree — concurrent requests stay isolated",
    caption:
      "AsyncLocalStorage keeps a separate store per async call tree: als.run opens it at the request boundary and the deep logger reads the same id via getStore() with no argument plumbing, while a shared global is overwritten by the next concurrent request.",
  },
  ru: {
    svgTitle: "AsyncLocalStorage несёт один store сквозь каждый await до глубокого логгера, а глобал уровня модуля перезаписывается следующим конкурентным запросом",
    headline: "ОДИН STORE НА ASYNC-ДЕРЕВО",
    sub: "store на контекст переживает await — а глобал нет",
    laneGood: "ALS: тот же id, без аргументов",
    laneBad: "глобал: чужой id",
    boundary: "граница: als.run(store)",
    boundaryLine: "один раз на запрос",
    mid: "сквозь await / колбэки",
    midLine: "таймеры, промисы",
    deep: "глубокий логгер",
    deepLine: "getStore() → тот же id",
    glob: "переменная уровня модуля",
    globLine: "let currentTraceId",
    clash: "запрос B перезаписывает",
    clashLine: "пока A ждёт I/O",
    broken: "лог A с id запроса B",
    brokenLine: "трассы перемешаны",
    foot: "один store на async-дерево — запросы изолированы",
    caption:
      "AsyncLocalStorage держит отдельный store на каждое async-дерево вызовов: als.run открывает его на границе запроса, а глубокий логгер читает тот же id через getStore() без проброса аргументов, тогда как общий глобал перезаписывается следующим конкурентным запросом.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="30" y="90" font-size="11" fill="var(--muted)">{t.laneGood}</text>
    <rect x="30" y="110" width="220" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="140" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boundary}</text>
    <text x="140" y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.boundaryLine}</text>

    <rect x="290" y="110" width="220" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mid}</text>
    <text x="400" y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.midLine}</text>

    <rect x="550" y="110" width="220" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="660" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.deep}</text>
    <text x="660" y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.deepLine}</text>

    <line x1="250" y1="146" x2="290" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="290,140 290,152 300,146" fill="var(--muted)" />
    <line x1="510" y1="146" x2="550" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="550,140 550,152 560,146" fill="var(--muted)" />

    <text x="30" y="224" font-size="11" fill="var(--muted)">{t.laneBad}</text>
    <rect x="30" y="244" width="220" height="68" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="140" y="272" text-anchor="middle" font-size="12" fill="var(--ink)">{t.glob}</text>
    <text x="140" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.globLine}</text>

    <rect x="290" y="244" width="220" height="68" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="272" text-anchor="middle" font-size="12" fill="var(--ink)">{t.clash}</text>
    <text x="400" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.clashLine}</text>

    <rect x="550" y="244" width="220" height="68" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="660" y="272" text-anchor="middle" font-size="12" fill="var(--ink)">{t.broken}</text>
    <text x="660" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.brokenLine}</text>

    <line x1="250" y1="278" x2="290" y2="278" stroke="var(--muted)" stroke-width="2" />
    <polygon points="290,272 290,284 300,278" fill="var(--muted)" />
    <line x1="510" y1="278" x2="550" y2="278" stroke="var(--muted)" stroke-width="2" />
    <polygon points="550,272 550,284 560,278" fill="var(--muted)" />

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
