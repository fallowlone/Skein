---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "diagnostics_channel: a producer publishes a named message on a channel, and a subscriber receives it synchronously — free when nobody subscribes",
    headline: "CHANNEL PUB/SUB, NO PATCHING",
    sub: "diagnostics_channel: in-process bus for core / undici / http",
    producer: "producer: DB wrapper",
    producerLine: 'channel("app:db:query")',
    bus: "named channel",
    busLine: "publish(msg) → sync",
    sub2: "subscriber: tracing",
    subLine: "subscribe(fn)",
    guard: "guard: hasSubscribers",
    guardLine: "no listeners → skip build",
    foot1: "publish with no subscribers is essentially free",
    foot2: "subscriber must be fast and must not throw",
    caption:
      "diagnostics_channel is an in-process pub/sub bus: the producer publishes named messages, subscribers receive them synchronously, and a hasSubscribers guard makes an unobserved publish essentially free.",
  },
  ru: {
    svgTitle: "diagnostics_channel: продюсер публикует именованное сообщение в канал, а подписчик получает его синхронно — без подписчиков бесплатно",
    headline: "КАНАЛ PUB/SUB БЕЗ ПАТЧИНГА",
    sub: "diagnostics_channel: in-process шина для core / undici / http",
    producer: "продюсер: обёртка БД",
    producerLine: 'channel("app:db:query")',
    bus: "именованный канал",
    busLine: "publish(msg) → синхронно",
    sub2: "подписчик: трейсинг",
    subLine: "subscribe(fn)",
    guard: "ограждение: hasSubscribers",
    guardLine: "нет слушателей → пропуск",
    foot1: "ненаблюдаемый publish по сути бесплатен",
    foot2: "подписчик обязан быть быстрым и не бросать",
    caption:
      "diagnostics_channel — это in-process шина pub/sub: продюсер публикует именованные сообщения, подписчики получают их синхронно, а ограждение hasSubscribers делает ненаблюдаемый publish по сути бесплатным.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="110" width="220" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="140" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.producer}</text>
    <text x="140" y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.producerLine}</text>

    <rect x="290" y="110" width="220" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.bus}</text>
    <text x="400" y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.busLine}</text>

    <rect x="550" y="110" width="220" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="660" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sub2}</text>
    <text x="660" y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.subLine}</text>

    <line x1="250" y1="146" x2="290" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="290,140 290,152 300,146" fill="var(--muted)" />
    <line x1="510" y1="146" x2="550" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="550,140 550,152 560,146" fill="var(--muted)" />

    <rect x="290" y="240" width="220" height="68" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="268" text-anchor="middle" font-size="12" fill="var(--ink)">{t.guard}</text>
    <text x="400" y="290" text-anchor="middle" font-size="11" fill="var(--ink)">{t.guardLine}</text>

    <line x1="400" y1="182" x2="400" y2="240" stroke="var(--muted)" stroke-width="2" stroke-dasharray="5 4" />
    <polygon points="394,240 406,240 400,250" fill="var(--muted)" />

    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="375" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
