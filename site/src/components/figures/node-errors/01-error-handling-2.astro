---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Three call styles, three failure channels: sync throw caught by try-catch, rejected promise caught by await or catch, error-first callback checked first — plus the EventEmitter error event that crashes without a listener",
    headline: "THREE STYLES, THREE CATCHES",
    sub: "failure travels bound to the call style",
    colSync: "Synchronous",
    colAsync: "Promise / async",
    colCb: "Callback (older core APIs)",
    failSync: "throw err",
    failAsync: "rejected promise",
    failCb: "cb(err, data) — err is arg 1",
    catchSync: "try/catch (same tick)",
    catchAsync1: "await in try/catch,",
    catchAsync2: "or .catch()",
    catchCb1: "check if (err) first,",
    catchCb2: "then return",
    emitLine1: "EventEmitter 'error' with no listener",
    emitLine2: "throw → uncaughtException → crashes process",
    caption:
      "Each call style has its own failure channel — sync throw goes to try/catch in the same tick, a rejected promise to await or .catch, an error-first callback to a first-line if (err) check — and an EventEmitter 'error' with no listener throws and crashes the process.",
  },
  ru: {
    svgTitle: "Три стиля вызова — три канала сбоя: синхронный throw ловится try-catch, зареджекченный промис — через await или catch, error-first колбэк — проверкой первым делом, а событие error у EventEmitter без слушателя роняет процесс",
    headline: "ТРИ СТИЛЯ — ТРИ ПОИМКИ",
    sub: "сбой движется привязанным к стилю вызова",
    colSync: "Синхронный",
    colAsync: "Promise / async",
    colCb: "Callback (старые core API)",
    failSync: "throw err",
    failAsync: "зареджекченный promise",
    failCb: "cb(err, data): err — арг. 1",
    catchSync: "try/catch (тот же tick)",
    catchAsync1: "await в try/catch,",
    catchAsync2: "или .catch()",
    catchCb1: "проверь if (err)",
    catchCb2: "на первой строке, return",
    emitLine1: "EventEmitter: событие 'error' без слушателя",
    emitLine2: "throw → uncaughtException → роняет процесс",
    caption:
      "У каждого стиля вызова свой канал сбоя — синхронный throw идёт в try/catch в том же tick, зареджекченный промис — в await или .catch, error-first колбэк — в проверку if (err) на первой строке, а событие 'error' у EventEmitter без слушателя бросает ошибку и роняет процесс.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="eh2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="140" y="94" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colSync}</text>
    <text x="390" y="94" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colAsync}</text>
    <text x="640" y="94" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colCb}</text>

    <rect x="30" y="118" width="220" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="140" y="149" text-anchor="middle" font-size="12" fill="var(--ink)">{t.failSync}</text>
    <rect x="280" y="118" width="220" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="390" y="149" text-anchor="middle" font-size="11" fill="var(--ink)">{t.failAsync}</text>
    <rect x="530" y="118" width="220" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="640" y="149" text-anchor="middle" font-size="11" fill="var(--ink)">{t.failCb}</text>

    <line x1="140" y1="176" x2="140" y2="192" stroke="var(--muted)" stroke-width="2" marker-end="url(#eh2)" />
    <line x1="390" y1="176" x2="390" y2="192" stroke="var(--muted)" stroke-width="2" marker-end="url(#eh2)" />
    <line x1="640" y1="176" x2="640" y2="192" stroke="var(--muted)" stroke-width="2" marker-end="url(#eh2)" />

    <rect x="30" y="198" width="220" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="140" y="233" text-anchor="middle" font-size="11" fill="var(--ink)">{t.catchSync}</text>
    <rect x="280" y="198" width="220" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="390" y="224" text-anchor="middle" font-size="11" fill="var(--ink)">{t.catchAsync1}</text>
    <text x="390" y="244" text-anchor="middle" font-size="11" fill="var(--ink)">{t.catchAsync2}</text>
    <rect x="530" y="198" width="220" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="640" y="224" text-anchor="middle" font-size="11" fill="var(--ink)">{t.catchCb1}</text>
    <text x="640" y="244" text-anchor="middle" font-size="11" fill="var(--ink)">{t.catchCb2}</text>

    <rect x="100" y="300" width="600" height="64" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="326" text-anchor="middle" font-size="11" fill="var(--ink)">{t.emitLine1}</text>
    <text x="400" y="348" text-anchor="middle" font-size="11" fill="var(--ink)">{t.emitLine2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
