---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Stack-frame inspection: call stack with three frames, scopes and watch list with a Console evaluated in the paused frame, and source maps remapping dist back to src",
    headline: "PAUSED? READ THE FRAME",
    sub: "stack, scopes, and the source you actually wrote",
    colStack: "call stack",
    frame1: "server.js:42 · paused",
    frame2: "handler()",
    frame3: "query()",
    colScope: "scopes / watch",
    scope1: "locals: userId = 42",
    scope2: "watch: total",
    scope3: "Console in frame scope",
    colMaps: "source maps",
    maps1: "--enable-source-maps",
    maps2: "dist/app.js → src/app.ts",
    maps3: "stacks map back to .ts",
    foot: "debugger; pauses if attached, no-op otherwise",
    caption:
      "Once paused you read the call stack, the scopes and watch list, and a Console evaluated in the paused frame; with --enable-source-maps stacks and breakpoints map back to your .ts instead of dist.",
  },
  ru: {
    svgTitle: "Осмотр фрейма стека: стек вызовов из трёх фреймов, области видимости и список watch с Console в области остановленного фрейма, и source maps, перемапливающие dist обратно в src",
    headline: "ВСТАЛ НА ПАУЗУ? ЧИТАЙ ФРЕЙМ",
    sub: "стек, области и исходник, который ты писал",
    colStack: "стек вызовов",
    frame1: "server.js:42 · пауза",
    frame2: "handler()",
    frame3: "query()",
    colScope: "области / watch",
    scope1: "локальные: userId = 42",
    scope2: "watch: total",
    scope3: "Console в области фрейма",
    colMaps: "source maps",
    maps1: "--enable-source-maps",
    maps2: "dist/app.js → src/app.ts",
    maps3: "стеки мапятся в .ts",
    foot: "debugger; — пауза, если подцеплен, иначе no-op",
    caption:
      "После паузы ты читаешь стек вызовов, области видимости и список watch и Console, вычисляемый в области остановленного фрейма; с --enable-source-maps стеки и брейкпоинты мапятся обратно в твой .ts вместо dist.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="30" y="110" width="220" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="140" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colStack}</text>
    <line x1="50" y1="154" x2="230" y2="154" stroke="var(--muted)" stroke-width="1" />
    <text x="140" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.frame1}</text>
    <text x="140" y="216" text-anchor="middle" font-size="11" fill="var(--ink)">{t.frame2}</text>
    <text x="140" y="248" text-anchor="middle" font-size="11" fill="var(--ink)">{t.frame3}</text>

    <rect x="290" y="110" width="210" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="395" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colScope}</text>
    <line x1="310" y1="154" x2="480" y2="154" stroke="var(--muted)" stroke-width="1" />
    <text x="395" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.scope1}</text>
    <text x="395" y="216" text-anchor="middle" font-size="11" fill="var(--ink)">{t.scope2}</text>
    <text x="395" y="248" text-anchor="middle" font-size="11" fill="var(--ink)">{t.scope3}</text>

    <rect x="540" y="110" width="230" height="200" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="655" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.colMaps}</text>
    <line x1="560" y1="154" x2="750" y2="154" stroke="var(--muted)" stroke-width="1" />
    <text x="655" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.maps1}</text>
    <text x="655" y="216" text-anchor="middle" font-size="11" fill="var(--ink)">{t.maps2}</text>
    <text x="655" y="248" text-anchor="middle" font-size="11" fill="var(--ink)">{t.maps3}</text>

    <line x1="258" y1="210" x2="282" y2="210" stroke="var(--muted)" stroke-width="2" />
    <polygon points="282,204 294,210 282,216" fill="var(--muted)" />
    <line x1="508" y1="210" x2="532" y2="210" stroke="var(--muted)" stroke-width="2" />
    <polygon points="532,204 544,210 532,216" fill="var(--muted)" />

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--ink)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
