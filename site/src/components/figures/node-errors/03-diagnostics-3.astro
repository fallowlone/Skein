---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Graceful shutdown on SIGTERM runs stop accepting, drain, close dependencies, exit — and --cpu-prof writes a profile on exit for DevTools",
    headline: "DRAIN BEFORE SIGKILL",
    sub: "graceful shutdown on SIGTERM — profile on demand",
    laneShutdown: "SIGTERM → exit(0)",
    laneProf: "--cpu-prof → DevTools",
    s1: "stop accepting",
    s1Line: "server.close()",
    s2: "drain in-flight",
    s2Line: "let work finish",
    s3: "close dependencies",
    s3Line: "db.end(), flush",
    s4: "exit(0) before SIGKILL",
    s4Line: "beat the deadline",
    p1: "--cpu-prof / --heap-prof",
    p1Line: "launch flag",
    p2: ".cpuprofile on exit",
    p2Line: "--diagnostic-dir",
    p3: "open in DevTools",
    p3Line: "Performance / Memory",
    foot: "SIGINT is Ctrl-C; SIGUSR1 opens the inspector",
    caption:
      "Handle SIGTERM by stopping new work, draining in-flight requests, closing dependencies, and calling process.exit(0) before the orchestrator's SIGKILL deadline — and profile on demand with --cpu-prof, opening the written profile in DevTools.",
  },
  ru: {
    svgTitle: "Graceful shutdown по SIGTERM идёт как перестать принимать, слить, закрыть зависимости, выйти — а --cpu-prof пишет профиль на выходе для DevTools",
    headline: "СЛИТЬ ДО SIGKILL",
    sub: "graceful shutdown по SIGTERM — профилирование по запросу",
    laneShutdown: "SIGTERM → exit(0)",
    laneProf: "--cpu-prof → DevTools",
    s1: "не принимать",
    s1Line: "server.close()",
    s2: "слить в полёте",
    s2Line: "дать завершиться",
    s3: "закрыть зависимости",
    s3Line: "db.end(), сбросить",
    s4: "exit(0) до SIGKILL",
    s4Line: "успеть до дедлайна",
    p1: "--cpu-prof / --heap-prof",
    p1Line: "флаг запуска",
    p2: ".cpuprofile на выходе",
    p2Line: "--diagnostic-dir",
    p3: "открыть в DevTools",
    p3Line: "Performance / Memory",
    foot: "SIGINT — это Ctrl-C; SIGUSR1 открывает инспектор",
    caption:
      "Обрабатывай SIGTERM так: перестань принимать новую работу, слей запросы в полёте, закрой зависимости и вызови process.exit(0) до дедлайна SIGKILL оркестратора — а профилируй по запросу через --cpu-prof, открывая записанный профиль в DevTools.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="20" y="90" font-size="11" fill="var(--muted)">{t.laneShutdown}</text>
    <rect x="20" y="110" width="178" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="109" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s1}</text>
    <text x="109" y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s1Line}</text>

    <rect x="214" y="110" width="178" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="303" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s2}</text>
    <text x="303" y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s2Line}</text>

    <rect x="408" y="110" width="178" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="497" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s3}</text>
    <text x="497" y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s3Line}</text>

    <rect x="602" y="110" width="178" height="72" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="691" y="140" text-anchor="middle" font-size="12" fill="var(--ink)">{t.s4}</text>
    <text x="691" y="162" text-anchor="middle" font-size="11" fill="var(--ink)">{t.s4Line}</text>

    <line x1="198" y1="146" x2="214" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="214,140 214,152 224,146" fill="var(--muted)" />
    <line x1="392" y1="146" x2="408" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="408,140 408,152 418,146" fill="var(--muted)" />
    <line x1="586" y1="146" x2="602" y2="146" stroke="var(--muted)" stroke-width="2" />
    <polygon points="602,140 602,152 612,146" fill="var(--muted)" />

    <text x="30" y="224" font-size="11" fill="var(--muted)">{t.laneProf}</text>
    <rect x="30" y="244" width="230" height="68" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="145" y="272" text-anchor="middle" font-size="12" fill="var(--ink)">{t.p1}</text>
    <text x="145" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.p1Line}</text>

    <rect x="285" y="244" width="230" height="68" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="272" text-anchor="middle" font-size="12" fill="var(--ink)">{t.p2}</text>
    <text x="400" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.p2Line}</text>

    <rect x="540" y="244" width="230" height="68" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="655" y="272" text-anchor="middle" font-size="12" fill="var(--ink)">{t.p3}</text>
    <text x="655" y="294" text-anchor="middle" font-size="11" fill="var(--ink)">{t.p3Line}</text>

    <line x1="260" y1="278" x2="285" y2="278" stroke="var(--muted)" stroke-width="2" />
    <polygon points="285,272 285,284 295,278" fill="var(--muted)" />
    <line x1="515" y1="278" x2="540" y2="278" stroke="var(--muted)" stroke-width="2" />
    <polygon points="540,272 540,284 550,278" fill="var(--muted)" />

    <text x="400" y="360" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
