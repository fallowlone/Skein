---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A low-level error is wrapped in a typed error with cause, handled at a boundary, and anything that escapes hits the process net which logs and exits for a supervisor restart",
    headline: "WRAP WITH CAUSE, CRASH CLEAN",
    sub: "add context without losing the stack",
    lowCode: "ENOENT",
    lowSub: "original stack",
    wrapName: "ConfigError",
    wrapCause: "{ cause: err }",
    edgeName: "boundary: catch",
    edgeSub: "respond or retry",
    netName: "log + process.exit(1)",
    netSub: "supervisor restarts",
    labCatch: "catch",
    labRethrow: "re-throw",
    labEscape: "escapes",
    rejLine1: "unhandledRejection — no .catch or await",
    rejLine2: "default since Node 15: print + exit(1)",
    foot: "process net: record and exit — never resume serving",
    caption:
      "Catch to add context with a typed error chained via { cause }, handle it at a boundary, and let anything that escapes hit the process net — which logs and exits so a supervisor restarts a clean process.",
  },
  ru: {
    svgTitle: "Низкоуровневая ошибка оборачивается в типизированную через cause, обрабатывается на границе, а всё ускользнувшее попадает в сеть процесса, которая логирует и выходит для перезапуска супервизором",
    headline: "ОБОРАЧИВАЙ ЧЕРЕЗ CAUSE, ПАДАЙ ЧИСТО",
    sub: "добавляй контекст без потери стека",
    lowCode: "ENOENT",
    lowSub: "исходный стек",
    wrapName: "ConfigError",
    wrapCause: "{ cause: err }",
    edgeName: "граница: catch",
    edgeSub: "ответ или ретрай",
    netName: "log + process.exit(1)",
    netSub: "супервизор: рестарт",
    labCatch: "ловит",
    labRethrow: "переброс",
    labEscape: "ускользнуло",
    rejLine1: "unhandledRejection — нет .catch и await",
    rejLine2: "дефолт с Node 15: печать + exit(1)",
    foot: "сеть процесса: зафиксируй и выйди — НЕ продолжай обслуживать",
    caption:
      "Лови, чтобы добавить контекст типизированной ошибкой через { cause }, обрабатывай на границе, а всё ускользнувшее пускай в сеть процесса — она залогирует и выйдет, чтобы супервизор перезапустил чистый процесс.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="eh3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="20" y="104" width="150" height="68" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="95" y="131" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lowCode}</text>
    <text x="95" y="153" text-anchor="middle" font-size="11" fill="var(--ink)">{t.lowSub}</text>
    <line x1="176" y1="138" x2="194" y2="138" stroke="var(--muted)" stroke-width="2" marker-end="url(#eh3)" />
    <rect x="200" y="104" width="170" height="68" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="285" y="131" text-anchor="middle" font-size="12" fill="var(--ink)">{t.wrapName}</text>
    <text x="285" y="153" text-anchor="middle" font-size="11" fill="var(--ink)">{t.wrapCause}</text>
    <line x1="376" y1="138" x2="394" y2="138" stroke="var(--muted)" stroke-width="2" marker-end="url(#eh3)" />
    <rect x="400" y="104" width="170" height="68" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="485" y="131" text-anchor="middle" font-size="11" fill="var(--ink)">{t.edgeName}</text>
    <text x="485" y="153" text-anchor="middle" font-size="11" fill="var(--ink)">{t.edgeSub}</text>
    <line x1="576" y1="138" x2="594" y2="138" stroke="var(--muted)" stroke-width="2" marker-end="url(#eh3)" />
    <rect x="600" y="104" width="180" height="68" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="690" y="131" text-anchor="middle" font-size="11" fill="var(--ink)">{t.netName}</text>
    <text x="690" y="153" text-anchor="middle" font-size="11" fill="var(--ink)">{t.netSub}</text>

    <text x="185" y="204" text-anchor="middle" font-size="10" fill="var(--muted)">{t.labCatch}</text>
    <text x="385" y="204" text-anchor="middle" font-size="10" fill="var(--muted)">{t.labRethrow}</text>
    <text x="585" y="204" text-anchor="middle" font-size="10" fill="var(--muted)">{t.labEscape}</text>

    <rect x="190" y="246" width="420" height="72" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="400" y="274" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rejLine1}</text>
    <text x="400" y="298" text-anchor="middle" font-size="11" fill="var(--ink)">{t.rejLine2}</text>

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
