---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Synchronous throw is caught by try/catch in the same tick, but a throw in an async callback escapes to uncaughtException and an unawaited rejection is never observed",
    headline: "SYNC THROW vs ASYNC REJECTION",
    sub: "match the catch to the call style",
    laneSync: "sync path",
    laneTrap1: "async trap 1",
    laneTrap2: "async trap 2",
    syncThrow: "throw err",
    syncCatch: "try/catch — same tick",
    syncFate: "caught",
    trapThrow: "throw in setTimeout callback",
    trapGone: "try already returned",
    trapFate: "uncaughtException",
    asyncCall: "async call, no await/.catch",
    asyncMiss: "rejection never observed",
    asyncFate1: "unhandledRejection",
    asyncFate2: "exit 1",
    foot: "await everything you depend on — a rejection becomes a catchable throw",
    caption:
      "try/catch only catches a synchronous throw in the same tick — a throw in an async callback escapes to uncaughtException, and an unawaited rejection is never observed by try.",
  },
  ru: {
    svgTitle: "Синхронный throw ловится try/catch в том же tick, а throw из асинхронного колбэка ускользает в uncaughtException, и незаавейченный reject остаётся неувиденным",
    headline: "СИНХРОННЫЙ THROW vs АСИНХРОННЫЙ REJECT",
    sub: "подбирай catch под стиль вызова",
    laneSync: "синхронно",
    laneTrap1: "ловушка 1",
    laneTrap2: "ловушка 2",
    syncThrow: "throw err",
    syncCatch: "try/catch — тот же tick",
    syncFate: "поймано",
    trapThrow: "throw в колбэке setTimeout",
    trapGone: "try уже завершился",
    trapFate: "uncaughtException",
    asyncCall: "async-вызов без await/.catch",
    asyncMiss: "reject try не увидит",
    asyncFate1: "unhandledRejection",
    asyncFate2: "exit 1",
    foot: "await-ай всё, от чего зависишь, — reject станет ловимым throw",
    caption:
      "try/catch ловит только синхронный throw в том же tick — throw из асинхронного колбэка ускользает в uncaughtException, а reject без await try не увидит.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="eh1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="150" y="125" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneSync}</text>
    <rect x="180" y="92" width="150" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="255" y="125" text-anchor="middle" font-size="12" fill="var(--ink)">{t.syncThrow}</text>
    <line x1="336" y1="120" x2="359" y2="120" stroke="var(--muted)" stroke-width="2" marker-end="url(#eh1)" />
    <rect x="365" y="92" width="200" height="56" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="465" y="125" text-anchor="middle" font-size="11" fill="var(--ink)">{t.syncCatch}</text>
    <text x="590" y="125" font-size="11" fill="var(--accent)">{t.syncFate}</text>

    <text x="150" y="216" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneTrap1}</text>
    <rect x="180" y="182" width="215" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="287" y="216" text-anchor="middle" font-size="11" fill="var(--ink)">{t.trapThrow}</text>
    <line x1="401" y1="212" x2="419" y2="212" stroke="var(--muted)" stroke-width="2" marker-end="url(#eh1)" />
    <rect x="425" y="182" width="175" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="512" y="216" text-anchor="middle" font-size="11" fill="var(--ink)">{t.trapGone}</text>
    <text x="625" y="216" font-size="11" fill="var(--ink)">{t.trapFate}</text>

    <text x="150" y="306" text-anchor="end" font-size="11" fill="var(--muted)">{t.laneTrap2}</text>
    <rect x="180" y="272" width="215" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="287" y="306" text-anchor="middle" font-size="11" fill="var(--ink)">{t.asyncCall}</text>
    <line x1="401" y1="302" x2="419" y2="302" stroke="var(--muted)" stroke-width="2" marker-end="url(#eh1)" />
    <rect x="425" y="272" width="195" height="60" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="522" y="306" text-anchor="middle" font-size="11" fill="var(--ink)">{t.asyncMiss}</text>
    <text x="645" y="300" font-size="11" fill="var(--ink)">{t.asyncFate1}</text>
    <text x="645" y="318" font-size="11" fill="var(--muted)">{t.asyncFate2}</text>

    <text x="400" y="382" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
