---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Assignment x = 7: evaluate the right side, then store",
    headline: "ASSIGNMENT IS A STORE",
    sub: "x = 7 · evaluate RHS, then write",
    before: "before",
    after: "after",
    name: "x",
    code: "x = 7",
    rhs: "evaluate RHS → 7",
    store: "store",
    old5: "old 5 gone",
    foot1: "replaces, not appends",
    foot2: "the name x never moves",
    caption:
      "Assignment x = 7 is a store operation: the right-hand side evaluates to 7, then 7 is written into the cell bound to x, replacing 5. The old value is gone — assignment replaces, it does not append. The name x never moves.",
  },
  ru: {
    svgTitle: "Присваивание x = 7: вычислить правую часть, затем записать",
    headline: "ПРИСВАИВАНИЕ — ЭТО ЗАПИСЬ",
    sub: "x = 7 · сначала вычислить, потом записать",
    before: "до",
    after: "после",
    name: "x",
    code: "x = 7",
    rhs: "вычислить RHS → 7",
    store: "запись",
    old5: "старое 5 исчезло",
    foot1: "заменяет, а не добавляет",
    foot2: "имя x никуда не двигается",
    caption:
      "Присваивание x = 7 — операция записи: правая часть вычисляется до 7, затем 7 записывается в ячейку, привязанную к x, заменяя 5. Старое значение исчезает — присваивание заменяет, а не добавляет. Имя x никуда не двигается.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="140" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.before}</text>
    <text x="140" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.name}</text>
    <rect x="90" y="140" width="100" height="80" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="140" y="192" text-anchor="middle" font-size="28" fill="var(--ink)">5</text>

    <text x="400" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.code}</text>
    <text x="400" y="155" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rhs}</text>
    <line x1="190" y1="180" x2="608" y2="180" stroke="var(--accent)" stroke-width="1.6" stroke-dasharray="6 4" />
    <polygon points="600,175 600,185 610,180" fill="var(--accent)" />
    <text x="400" y="207" text-anchor="middle" font-size="11" fill="var(--muted)">{t.store}</text>

    <text x="660" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.after}</text>
    <text x="660" y="130" text-anchor="middle" font-size="13" fill="var(--ink)">{t.name}</text>
    <rect x="610" y="140" width="100" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="660" y="192" text-anchor="middle" font-size="28" fill="var(--ink)">7</text>

    <text x="590" y="264" text-anchor="middle" font-size="16" fill="var(--muted)">5</text>
    <line x1="580" y1="252" x2="600" y2="272" stroke="var(--muted)" stroke-width="1.5" />
    <line x1="600" y1="252" x2="580" y2="272" stroke="var(--muted)" stroke-width="1.5" />
    <text x="668" y="264" text-anchor="middle" font-size="11" fill="var(--muted)">{t.old5}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
