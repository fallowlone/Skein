---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Name score bound to memory cell 1042 holding value 0",
    headline: "A VARIABLE IS A NAMED CELL",
    sub: "name score bound to cell 1042",
    nameTag: "name",
    binding: "binding",
    midLabel: "cell 1042",
    ghostL: "cell 1041",
    ghostR: "cell 1043",
    foot1: "the name never sits in the cell — only the value does",
    foot2: "the runtime looks up score → address 1042",
    caption:
      "A variable pairs a name with a memory cell: the name score is bound to cell 1042, which holds the value 0. The binding — the link between name and cell — is kept by the runtime. Neighbouring cells 1041 and 1043 are unrelated, and the name itself never sits inside the cell.",
  },
  ru: {
    svgTitle: "Имя score привязано к ячейке памяти 1042 со значением 0",
    headline: "ПЕРЕМЕННАЯ — ИМЕНОВАННАЯ ЯЧЕЙКА",
    sub: "имя score привязано к ячейке 1042",
    nameTag: "имя",
    binding: "привязка",
    midLabel: "ячейка 1042",
    ghostL: "ячейка 1041",
    ghostR: "ячейка 1043",
    foot1: "имя никогда не лежит в ячейке — только значение",
    foot2: "среда выполнения ищет score → адрес 1042",
    caption:
      "Переменная соединяет имя и ячейку памяти: имя score привязано к ячейке 1042, в которой хранится значение 0. Привязку — связь имени и ячейки — поддерживает среда выполнения. Соседние ячейки 1041 и 1043 не связаны с ней, а само имя никогда не лежит внутри ячейки.",
  },
};

const t = dict[lang];

const ghosts = [
  { x: 180, label: t.ghostL },
  { x: 500, label: t.ghostR },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="80" text-anchor="middle" font-size="11" fill="var(--muted)">{t.nameTag}</text>
    <rect x="340" y="88" width="120" height="40" fill="var(--accent)" />
    <text x="400" y="115" text-anchor="middle" font-size="16" fill="var(--card)">score</text>

    <line x1="400" y1="128" x2="400" y2="170" stroke="var(--ink)" stroke-width="2" />
    <polygon points="400,170 394,160 406,160" fill="var(--ink)" />
    <text x="414" y="152" font-size="11" fill="var(--muted)">{t.binding}</text>

    {ghosts.map((g) => (
      <g>
        <rect x={g.x} y="170" width="120" height="90" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 4" />
        <text x={g.x + 60} y="218" text-anchor="middle" font-size="28" fill="var(--muted)">?</text>
        <text x={g.x + 60} y="247" text-anchor="middle" font-size="11" fill="var(--muted)">{g.label}</text>
      </g>
    ))}

    <rect x="340" y="170" width="120" height="90" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="220" text-anchor="middle" font-size="30" fill="var(--ink)">0</text>
    <text x="400" y="247" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midLabel}</text>

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="348" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
