---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "score = score + 5 at score 10: read, evaluate, write",
    headline: "RHS FIRST, WRITE SECOND",
    sub: "score = score + 5 · score holds 10",
    s1t: "read score",
    s1d: "→ 10",
    s2t: "eval 10 + 5",
    s2d: "= 15",
    s3t: "write 15 to cell",
    s3d: "addr 1042",
    s4t: "score = 15",
    s4d: "old 10 gone",
    bind: "score → 1042 · unchanged",
    foot1: "RHS fully evaluates before any write",
    foot2: "same cell, same name, new value",
    caption:
      "score = score + 5 with score at 10: read 10, evaluate 10 + 5 = 15, write 15 back into the same cell at addr 1042. The old 10 is gone; the binding score→1042 never moves.",
  },
  ru: {
    svgTitle: "score = score + 5 при score 10: прочитать, вычислить, записать",
    headline: "СНАЧАЛА RHS, ПОТОМ ЗАПИСЬ",
    sub: "score = score + 5 · score хранит 10",
    s1t: "чтение score",
    s1d: "→ 10",
    s2t: "вычислить 10 + 5",
    s2d: "= 15",
    s3t: "запись 15 в ячейку",
    s3d: "адрес 1042",
    s4t: "score = 15",
    s4d: "10 исчезло",
    bind: "score → 1042 · не меняется",
    foot1: "правая часть вычисляется до любой записи",
    foot2: "та же ячейка, то же имя, новое значение",
    caption:
      "score = score + 5 при score равном 10: читаем 10, вычисляем 10 + 5 = 15, записываем 15 обратно в ту же ячейку по адресу 1042. Старое 10 исчезло; привязка score→1042 не двигается.",
  },
};

const t = dict[lang];

const stages = [
  { n: "1", title: t.s1t, detail: t.s1d, hot: false },
  { n: "2", title: t.s2t, detail: t.s2d, hot: false },
  { n: "3", title: t.s3t, detail: t.s3d, hot: false },
  { n: "4", title: t.s4t, detail: t.s4d, hot: true },
];

const boxW = 160;
const boxX = (i: number) => 26 + i * 196;
const arrowIdx = [0, 1, 2];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {stages.map((s, i) => (
      <g>
        <rect x={boxX(i)} y="110" width={boxW} height="110" fill={s.hot ? "var(--accent)" : "var(--card)"} stroke={s.hot ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={boxX(i) + boxW / 2} y="132" text-anchor="middle" font-size="11" fill={s.hot ? "var(--card)" : "var(--muted)"}>{s.n}</text>
        <text x={boxX(i) + boxW / 2} y="162" text-anchor="middle" font-size="12" fill={s.hot ? "var(--card)" : "var(--ink)"}>{s.title}</text>
        <text x={boxX(i) + boxW / 2} y="196" text-anchor="middle" font-size="16" fill={s.hot ? "var(--card)" : "var(--ink)"}>{s.detail}</text>
      </g>
    ))}

    {arrowIdx.map((i) => (
      <g>
        <line x1={boxX(i) + boxW} y1="165" x2={boxX(i + 1) - 2} y2="165" stroke="var(--accent)" stroke-width="1.6" />
        <polygon points={`${boxX(i + 1) - 10},160 ${boxX(i + 1) - 10},170 ${boxX(i + 1)},165`} fill="var(--accent)" />
      </g>
    ))}

    <rect x="230" y="256" width="340" height="40" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
    <text x="400" y="282" text-anchor="middle" font-size="13" fill="var(--ink)">{t.bind}</text>

    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
