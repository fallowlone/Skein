---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Copying 42 makes two independent cells; copying ref 5000 makes two arrows to one heap object",
    headline: "WHAT SITS IN THE CELL?",
    sub: "primitive: value copied · object: reference copied",
    leftHead: "copy the value",
    rightHead: "copy the reference",
    codeL: "let b = a;",
    noteL: "two independent boxes",
    codeR: "let q = p;",
    noteR: "two arrows, one object",
    heapTag: "heap",
    addrTag: "addr 5000",
    foot1: "a = 99 never touches b — each cell owns its 42",
    foot2: "q.x = 99 is visible as p.x — one shared object",
    caption:
      "What sits in the cell: for the primitive 42 the value bits are copied, so a and b are independent boxes and a = 99 never touches b. For the object { x: 1 } only the reference 5000 is copied, so p and q are two arrows, one object on the heap — q.x = 99 is visible as p.x.",
  },
  ru: {
    svgTitle: "Копия 42 даёт две независимые ячейки; копия ref 5000 даёт две стрелки на один объект в куче",
    headline: "ЧТО ХРАНИТСЯ В ЯЧЕЙКЕ?",
    sub: "примитив: копия значения · объект: копия ссылки",
    leftHead: "копия значения",
    rightHead: "копия ссылки",
    codeL: "let b = a;",
    noteL: "две независимые ячейки",
    codeR: "let q = p;",
    noteR: "две стрелки, один объект",
    heapTag: "куча",
    addrTag: "адрес 5000",
    foot1: "b не затронута — у неё своя копия",
    foot2: "q.x = 99 видно как p.x — объект один",
    caption:
      "Что хранится в ячейке: для примитива 42 копируются биты значения, поэтому a и b — независимые ячейки, и a = 99 не затрагивает b. Для объекта { x: 1 } копируется только ссылка 5000, поэтому p и q — две стрелки, один объект в куче: q.x = 99 видно как p.x.",
  },
};

const t = dict[lang];

const primCells = [
  { name: "a", y: 110 },
  { name: "b", y: 190 },
];

const refCells = [
  { name: "p", y: 110, arrowTo: 158 },
  { name: "q", y: 190, arrowTo: 208 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="145" y="95" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftHead}</text>
    <text x="595" y="95" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightHead}</text>

    {primCells.map((c) => (
      <g>
        <rect x="60" y={c.y} width="170" height="58" rx="7" fill="var(--card)" stroke="var(--accent)" stroke-width="1.6" />
        <text x="72" y={c.y + 22} font-size="12" fill="var(--muted)">{c.name}</text>
        <text x="145" y={c.y + 40} text-anchor="middle" font-size="18" fill="var(--ink)">42</text>
      </g>
    ))}

    <text x="145" y="280" text-anchor="middle" font-size="11" fill="var(--muted)">{t.codeL}</text>
    <text x="145" y="302" text-anchor="middle" font-size="11" fill="var(--muted)">{t.noteL}</text>

    <line x1="400" y1="90" x2="400" y2="315" stroke="var(--muted)" stroke-width="0.8" stroke-dasharray="4 4" />

    {refCells.map((c) => (
      <g>
        <rect x="440" y={c.y} width="140" height="58" rx="7" fill="var(--card)" stroke="var(--ink)" stroke-width="1.2" />
        <text x="452" y={c.y + 22} font-size="12" fill="var(--muted)">{c.name}</text>
        <text x="510" y={c.y + 38} text-anchor="middle" font-size="13" fill="var(--ink)">ref 5000</text>
        <line x1="580" y1={c.y + 29} x2="620" y2={c.arrowTo} stroke="var(--accent)" stroke-width="1.6" marker-end="url(#rv1-arrow)" />
      </g>
    ))}

    <rect x="620" y="130" width="130" height="98" rx="7" fill="var(--card)" stroke="var(--accent)" stroke-width="1.6" />
    <text x="685" y="154" text-anchor="middle" font-size="11" fill="var(--muted)">{t.heapTag}</text>
    <text x="685" y="178" text-anchor="middle" font-size="12" fill="var(--ink)">{"{ x: 1 }"}</text>
    <text x="685" y="198" text-anchor="middle" font-size="10" fill="var(--muted)">{t.addrTag}</text>

    <text x="510" y="280" text-anchor="middle" font-size="11" fill="var(--muted)">{t.codeR}</text>
    <text x="595" y="302" text-anchor="middle" font-size="11" fill="var(--muted)">{t.noteR}</text>

    <text x="400" y="332" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="358" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>

    <defs>
      <marker id="rv1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
