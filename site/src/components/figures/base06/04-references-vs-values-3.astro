---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "const obj holds reference 5000: rebinding throws TypeError, but obj.val = 20 is allowed",
    headline: "CONST SEALS THE BINDING",
    sub: "the cell keeps its reference · the object is not frozen",
    leftHead: "rebind fails: TypeError",
    rightHead: "mutate: OK",
    addrTag: "addr 5000",
    elseName: "somethingElse",
    codeL: "obj = { val: 20 };  ✗",
    codeR: "obj.val = 20;  ✓",
    foot1: "const guards the cell's reference",
    foot2: "not the object's contents",
    caption:
      "const obj = { val: 10 } seals the binding: the cell always holds reference 5000, so obj = { val: 20 } throws a TypeError. But the object itself is not frozen — obj.val = 20 mutates the property in place, which is allowed.",
  },
  ru: {
    svgTitle: "const obj хранит ссылку 5000: перепривязка даёт TypeError, а obj.val = 20 допустимо",
    headline: "CONST ЗАПЕЧАТЫВАЕТ ПРИВЯЗКУ",
    sub: "ссылка в ячейке та же · объект не заморожен",
    leftHead: "перепривязка: TypeError",
    rightHead: "мутация: OK",
    addrTag: "адрес 5000",
    elseName: "другойОбъект",
    codeL: "obj = { val: 20 };  ✗",
    codeR: "obj.val = 20;  ✓",
    foot1: "const охраняет ссылку в ячейке",
    foot2: "а не содержимое объекта",
    caption:
      "const obj = { val: 10 } запечатывает привязку: ячейка всегда хранит ссылку 5000, поэтому obj = { val: 20 } даёт TypeError. Но сам объект не заморожен — obj.val = 20 мутирует свойство на месте, что допустимо.",
  },
};

const t = dict[lang];

const objCells = [
  { x: 40, cx: 105 },
  { x: 440, cx: 505 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="190" y="95" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftHead}</text>
    <text x="595" y="95" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightHead}</text>

    {objCells.map((c) => (
      <g>
        <rect x={c.x} y="140" width="130" height="60" rx="7" fill="var(--card)" stroke="var(--ink)" stroke-width="1.2" />
        <text x={c.x + 12} y="162" font-size="12" fill="var(--muted)">obj</text>
        <text x={c.cx} y="188" text-anchor="middle" font-size="13" fill="var(--ink)">5000</text>
      </g>
    ))}

    <rect x="210" y="120" width="130" height="60" rx="7" fill="var(--card)" stroke="var(--accent)" stroke-width="1.6" />
    <text x="275" y="145" text-anchor="middle" font-size="12" fill="var(--ink)">{"{ val: 10 }"}</text>
    <text x="275" y="164" text-anchor="middle" font-size="10" fill="var(--muted)">{t.addrTag}</text>

    <rect x="210" y="210" width="130" height="60" rx="7" fill="var(--card)" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="5 4" />
    <text x="275" y="235" text-anchor="middle" font-size="12" fill="var(--ink)">{"{ val: 20 }"}</text>
    <text x="275" y="254" text-anchor="middle" font-size="10" fill="var(--muted)">{t.elseName}</text>

    <line x1="170" y1="160" x2="210" y2="150" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#rv3-arrow)" />
    <line x1="170" y1="182" x2="210" y2="240" stroke="var(--muted)" stroke-width="1.4" stroke-dasharray="5 4" marker-end="url(#rv3-muted)" />
    <rect x="180" y="200" width="20" height="20" fill="var(--card)" />
    <text x="190" y="215" text-anchor="middle" font-size="13" fill="var(--ink)">✗</text>

    <text x="190" y="300" text-anchor="middle" font-size="11" fill="var(--muted)">{t.codeL}</text>

    <line x1="400" y1="90" x2="400" y2="315" stroke="var(--muted)" stroke-width="0.8" stroke-dasharray="4 4" />

    <rect x="610" y="140" width="140" height="60" rx="7" fill="var(--card)" stroke="var(--accent)" stroke-width="1.6" />
    <text x="680" y="165" text-anchor="middle" font-size="12" fill="var(--ink)">{"{ val: 20 }"}</text>
    <text x="680" y="184" text-anchor="middle" font-size="10" fill="var(--muted)">{t.addrTag}</text>

    <line x1="570" y1="170" x2="610" y2="170" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#rv3-arrow)" />

    <text x="595" y="300" text-anchor="middle" font-size="11" fill="var(--muted)">{t.codeR}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>

    <defs>
      <marker id="rv3-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
      </marker>
      <marker id="rv3-muted" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
