---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Aliasing: p and q hold reference 5000 to one heap object, so q.x = 99 reads back as p.x = 99",
    headline: "ALIASING: TWO NAMES, ONE OBJECT",
    sub: "p and q hold the same reference 5000",
    beforeHead: "p = { x: 1 } · q = p",
    afterHead: "p.x is 99",
    heapTag: "heap",
    addrTag: "addr 5000",
    traceCode: "let q = p;  q.x = 99;",
    foot1: "follow reference 5000 — the object says x = 99",
    foot2: "console.log(p.x) → 99",
    caption:
      "Aliasing in three steps: p = { x: 1 } creates the object at heap address 5000, q = p copies the reference so both names hold 5000, and q.x = 99 mutates the single shared object — following the reference from p gives x = 99.",
  },
  ru: {
    svgTitle: "Алиасинг: p и q хранят ссылку 5000 на один объект в куче, поэтому q.x = 99 читается как p.x = 99",
    headline: "АЛИАСИНГ: ДВА ИМЕНИ, ОДИН ОБЪЕКТ",
    sub: "p и q хранят ссылку 5000",
    beforeHead: "p = { x: 1 } · q = p",
    afterHead: "p.x равен 99",
    heapTag: "куча",
    addrTag: "адрес 5000",
    traceCode: "let q = p;  q.x = 99;",
    foot1: "следуем по ссылке 5000 — объект: x = 99",
    foot2: "console.log(p.x) → 99",
    caption:
      "Алиасинг в трёх шагах: p = { x: 1 } создаёт объект в куче по адресу 5000, q = p копирует ссылку, и оба имени хранят 5000, а q.x = 99 мутирует единственный общий объект — следуя по ссылке от p, получаем x = 99.",
  },
};

const t = dict[lang];

const leftCells = [
  { name: "p", y: 120, arrowTo: 160 },
  { name: "q", y: 190, arrowTo: 202 },
];

const rightCells = [
  { name: "p", y: 120, arrowTo: 160 },
  { name: "q", y: 190, arrowTo: 202 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="95" text-anchor="middle" font-size="11" fill="var(--muted)">{t.beforeHead}</text>
    <text x="600" y="95" text-anchor="middle" font-size="11" fill="var(--muted)">{t.afterHead}</text>

    <rect x="40" y="105" width="320" height="150" rx="7" fill="none" stroke="var(--ink)" stroke-width="1.2" />
    <rect x="440" y="105" width="320" height="150" rx="7" fill="none" stroke="var(--ink)" stroke-width="1.2" />

    {leftCells.map((c) => (
      <g>
        <rect x="60" y={c.y} width="120" height="52" rx="7" fill="var(--card)" stroke="var(--ink)" stroke-width="1.2" />
        <text x="72" y={c.y + 22} font-size="12" fill="var(--muted)">{c.name}</text>
        <text x="120" y={c.y + 38} text-anchor="middle" font-size="13" fill="var(--ink)">5000</text>
        <line x1="180" y1={c.y + 26} x2="220" y2={c.arrowTo} stroke="var(--accent)" stroke-width="1.6" marker-end="url(#rv2-arrow)" />
      </g>
    ))}

    <rect x="220" y="140" width="120" height="82" rx="7" fill="var(--card)" stroke="var(--ink)" stroke-width="1.2" />
    <text x="280" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.heapTag}</text>
    <text x="280" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{"{ x: 1 }"}</text>
    <text x="280" y="206" text-anchor="middle" font-size="10" fill="var(--muted)">{t.addrTag}</text>

    <text x="400" y="158" text-anchor="middle" font-size="11" fill="var(--ink)">q.x = 99;</text>
    <line x1="360" y1="180" x2="440" y2="180" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#rv2-arrow)" />

    {rightCells.map((c) => (
      <g>
        <rect x="465" y={c.y} width="120" height="52" rx="7" fill="var(--card)" stroke="var(--ink)" stroke-width="1.2" />
        <text x="477" y={c.y + 22} font-size="12" fill="var(--muted)">{c.name}</text>
        <text x="525" y={c.y + 38} text-anchor="middle" font-size="13" fill="var(--ink)">5000</text>
        <line x1="585" y1={c.y + 26} x2="625" y2={c.arrowTo} stroke="var(--accent)" stroke-width="1.6" marker-end="url(#rv2-arrow)" />
      </g>
    ))}

    <rect x="625" y="140" width="115" height="82" rx="7" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="682" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.heapTag}</text>
    <text x="682" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{"{ x: 99 }"}</text>
    <text x="682" y="206" text-anchor="middle" font-size="10" fill="var(--muted)">{t.addrTag}</text>

    <text x="400" y="288" text-anchor="middle" font-size="11" fill="var(--muted)">{t.traceCode}</text>
    <text x="400" y="322" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>

    <defs>
      <marker id="rv2-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
      </marker>
    </defs>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
