---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "let allows re-assignment, const seals the binding",
    headline: "LET REWRITES · CONST SEALS",
    sub: "first write vs re-assignment",
    letLabel: "let x = 0;",
    reassign: "x = 42",
    allowed: "rewrite allowed",
    unchanged: "binding unchanged",
    constLabel: "const y = 10;",
    blocked: "y = 20",
    typeErr: "TypeError",
    sealed: "binding sealed",
    foot1: "const y = 10 → one store, then sealed",
    foot2: "second write → TypeError: Assignment to constant variable.",
    caption:
      "let x = 0 allows re-assignment: x = 42 overwrites the cell while the binding stays unchanged. const y = 10 seals the binding after the first store — a second write throws TypeError.",
  },
  ru: {
    svgTitle: "let допускает переприсваивание, const запечатывает привязку",
    headline: "LET ПЕРЕЗАПИСЫВАЕТ · CONST ЗАПЕЧАТЫВАЕТ",
    sub: "первая запись и переприсваивание",
    letLabel: "let x = 0;",
    reassign: "x = 42",
    allowed: "перезапись разрешена",
    unchanged: "привязка не меняется",
    constLabel: "const y = 10;",
    blocked: "y = 20",
    typeErr: "TypeError",
    sealed: "привязка запечатана",
    foot1: "const y = 10 → одна запись, затем запечатано",
    foot2: "вторая запись → TypeError: привязка запечатана",
    caption:
      "let x = 0 допускает переприсваивание: x = 42 перезаписывает ячейку, привязка не меняется. const y = 10 запечатывает привязку после первой записи — вторая запись выбрасывает TypeError.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="200" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.letLabel}</text>
    <rect x="60" y="120" width="110" height="80" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="115" y="172" text-anchor="middle" font-size="28" fill="var(--ink)">0</text>
    <text x="200" y="142" text-anchor="middle" font-size="11" fill="var(--muted)">{t.reassign}</text>
    <line x1="170" y1="160" x2="228" y2="160" stroke="var(--accent)" stroke-width="1.6" />
    <polygon points="220,155 220,165 230,160" fill="var(--accent)" />
    <rect x="230" y="120" width="110" height="80" fill="var(--card)" stroke="var(--accent)" stroke-width="2.5" />
    <text x="285" y="172" text-anchor="middle" font-size="28" fill="var(--ink)">42</text>
    <text x="200" y="252" text-anchor="middle" font-size="12" fill="var(--ink)">{t.allowed}</text>
    <text x="200" y="280" text-anchor="middle" font-size="12" fill="var(--muted)">{t.unchanged}</text>

    <line x1="400" y1="84" x2="400" y2="312" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="6 4" />

    <text x="600" y="100" text-anchor="middle" font-size="13" fill="var(--ink)">{t.constLabel}</text>
    <rect x="545" y="120" width="110" height="80" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="600" y="172" text-anchor="middle" font-size="28" fill="var(--ink)">10</text>
    <text x="560" y="252" text-anchor="middle" font-size="13" fill="var(--ink)">{t.blocked}</text>
    <line x1="604" y1="240" x2="626" y2="262" stroke="var(--accent)" stroke-width="2.5" />
    <line x1="626" y1="240" x2="604" y2="262" stroke="var(--accent)" stroke-width="2.5" />
    <text x="600" y="282" text-anchor="middle" font-size="12" fill="var(--accent)">{t.typeErr}</text>
    <text x="600" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.sealed}</text>

    <text x="400" y="344" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="370" text-anchor="middle" font-size="11" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
