---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Stateless computation returns the same sum twice; stateful score depends on history",
    headline: "STATEFUL VS STATELESS",
    sub: "call twice with the same inputs — same answer, or history?",
    leftTag: "STATELESS · stateless",
    leftRow1: "two numbers → their sum",
    leftRow2: "call again → the same sum",
    leftFoot: "depends only on inputs",
    rightTag: "STATEFUL · stateful",
    rightRow1: "score = 10",
    rightRow2: "score = score + 5",
    rightRow3: "score = 15",
    rightFoot: "depends on what happened before",
    foot1: "stateless: easier to test · stateful: more powerful",
    foot2: "the boundary between them is a core design skill",
    caption:
      "A stateless computation takes two numbers and returns their sum: called twice with the same inputs, it gives the same answer — it depends only on its inputs and changes no cell. A stateful program stores values across steps: score reads 10, then score = score + 5 mutates the cell, and it reads 15. Its behaviour depends on what happened before.",
  },
  ru: {
    svgTitle: "Вычисление без состояния дважды возвращает ту же сумму; score с состоянием зависит от истории",
    headline: "С СОСТОЯНИЕМ И БЕЗ СОСТОЯНИЯ",
    sub: "дважды те же аргументы — тот же ли результат?",
    leftTag: "БЕЗ СОСТОЯНИЯ · stateless",
    leftRow1: "два числа → их сумма",
    leftRow2: "повторный вызов → та же сумма",
    leftFoot: "зависит только от входных данных",
    rightTag: "С СОСТОЯНИЕМ · stateful",
    rightRow1: "score = 10",
    rightRow2: "score = score + 5",
    rightRow3: "score = 15",
    rightFoot: "зависит от того, что было раньше",
    foot1: "без состояния: легче тестировать · с состоянием: мощнее",
    foot2: "различать их — фундаментальный навык",
    caption:
      "Вычисление без состояния принимает два числа и возвращает их сумму: при двух вызовах с теми же аргументами оно даёт тот же ответ — оно зависит только от входных данных и не меняет ни одной ячейки. Программа с состоянием хранит значения между шагами: score показывает 10, затем score = score + 5 мутирует ячейку, и она показывает 15. Её поведение зависит от того, что произошло раньше.",
  },
};

const t = dict[lang];

const leftRows = [t.leftRow1, t.leftRow2];
const rightRows = [t.rightRow1, t.rightRow2, t.rightRow3];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="340" height="195" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x="420" y="100" width="340" height="195" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />

    <text x="210" y="134" text-anchor="middle" font-size="14" fill="var(--ink)">{t.leftTag}</text>
    <text x="590" y="134" text-anchor="middle" font-size="14" fill="var(--ink)">{t.rightTag}</text>
    <line x1="64" y1="148" x2="356" y2="148" stroke="var(--muted)" stroke-width="1" />
    <line x1="444" y1="148" x2="736" y2="148" stroke="var(--muted)" stroke-width="1" />

    {leftRows.map((row, i) => (
      <text x="210" y={186 + i * 36} text-anchor="middle" font-size="12" fill="var(--ink)">{row}</text>
    ))}

    <rect x="444" y="190" width="292" height="32" fill="var(--accent)" />
    {rightRows.map((row, i) => (
      <text x="590" y={180 + i * 30} text-anchor="middle" font-size="12" fill={i === 1 ? "var(--card)" : "var(--ink)"}>{row}</text>
    ))}

    <text x="210" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftFoot}</text>
    <text x="590" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightFoot}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="357" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
