---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "State snapshot at time T and one millisecond later: score moves from 10 to 15",
    headline: "STATE IS THE CURRENT SNAPSHOT",
    sub: "score=10, lives=3, isGameOver=false at time T",
    leftTag: "at time T",
    rightTag: "1 ms later",
    arrowNote: "one assignment",
    changedNote: "score 10 → 15",
    foot1: "the photograph moves: score 10 → 15",
    foot2: "state is always about now",
    caption:
      "State is a photograph of all cells at one moment: at time T the snapshot reads score = 10, lives = 3, isGameOver = false. One millisecond later, after one assignment, the photograph looks different — score = 15. State is always about now: the current snapshot, not the history.",
  },
  ru: {
    svgTitle: "Снимок состояния в момент T и миллисекунду спустя: score меняется с 10 на 15",
    headline: "СОСТОЯНИЕ — ТЕКУЩИЙ СНИМОК",
    sub: "score=10, lives=3, isGameOver=false в момент T",
    leftTag: "в момент T",
    rightTag: "миллисекунду спустя",
    arrowNote: "одно присваивание",
    changedNote: "score 10 → 15",
    foot1: "снимок движется: score 10 → 15",
    foot2: "состояние — всегда про сейчас",
    caption:
      "Состояние — фотография всех ячеек в один момент: в момент T снимок показывает score = 10, lives = 3, isGameOver = false. Миллисекунду спустя, после одного присваивания, фотография выглядит иначе — score = 15. Состояние — всегда про сейчас: текущий снимок, а не история.",
  },
};

const t = dict[lang];

const leftRows = ["score = 10", "lives = 3", "isGameOver = false"];
const rightRows = ["score = 15", "lives = 3", "isGameOver = false"];

const rowY = (i: number) => 158 + i * 48;
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="b06f1-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink)" />
      </marker>
    </defs>

    <text x="195" y="98" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftTag}</text>
    <text x="605" y="98" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightTag}</text>

    <rect x="60" y="110" width="270" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x="470" y="110" width="270" height="170" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x="478" y="130" width="254" height="36" fill="var(--accent)" />

    {leftRows.map((row, i) => (
      <text x="195" y={rowY(i)} text-anchor="middle" font-size="13" fill="var(--ink)">{row}</text>
    ))}

    {rightRows.map((row, i) => (
      <text x="605" y={rowY(i)} text-anchor="middle" font-size="13" fill={i === 0 ? "var(--card)" : "var(--ink)"}>{row}</text>
    ))}

    <line x1="330" y1="196" x2="470" y2="196" stroke="var(--ink)" stroke-width="2" marker-end="url(#b06f1-arrow)" />
    <text x="400" y="182" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrowNote}</text>
    <text x="400" y="238" text-anchor="middle" font-size="11" fill="var(--accent)">{t.changedNote}</text>

    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
