---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Mutation rewrites the score cell from 10 to 15 at the same address",
    headline: "MUTATION CHANGES THE CELL IN PLACE",
    sub: "score = score + 5 · address unchanged, contents differ",
    beforeTag: "BEFORE",
    afterTag: "AFTER",
    beforeVal: "score = 10",
    afterVal: "score = 15",
    beforeAddr: "the cell at its address",
    afterAddr: "same cell · same address",
    arrowNote: "score = score + 5",
    goneNote: "old value: gone",
    foot1: "no new cell is created · nothing is copied",
    foot2: "the old value is gone, overwritten in place",
    caption:
      "Mutation is an in-place change: the assignment score = score + 5 rewrites the existing score cell from 10 to 15. The cell exists at the same address before and after — only its contents changed. No new cell is created and nothing is copied; the old value is gone, overwritten in the same physical location.",
  },
  ru: {
    svgTitle: "Мутация перезаписывает ячейку score с 10 на 15 по тому же адресу",
    headline: "МУТАЦИЯ МЕНЯЕТ ЯЧЕЙКУ НА МЕСТЕ",
    sub: "score = score + 5 · адрес не изменился, содержимое — другое",
    beforeTag: "ДО",
    afterTag: "ПОСЛЕ",
    beforeVal: "score = 10",
    afterVal: "score = 15",
    beforeAddr: "ячейка по своему адресу",
    afterAddr: "та же ячейка · тот же адрес",
    arrowNote: "score = score + 5",
    goneNote: "старое: исчезло",
    foot1: "не создаёт новую ячейку · не копирует данные",
    foot2: "старое значение исчезло · перезаписано на месте",
    caption:
      "Мутация — изменение на месте: присваивание score = score + 5 перезаписывает существующую ячейку score с 10 на 15. Ячейка существует по тому же адресу до и после — изменилось только её содержимое. Новая ячейка не создаётся, ничего не копируется; старое значение исчезло, перезаписанное в том же физическом месте.",
  },
};

const t = dict[lang];

const panels = [
  { x: 60, tag: t.beforeTag, val: t.beforeVal, addr: t.beforeAddr, accent: false },
  { x: 480, tag: t.afterTag, val: t.afterVal, addr: t.afterAddr, accent: true },
];
---
<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <defs>
      <marker id="b06f2-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink)" />
      </marker>
    </defs>

    {panels.map((p) => (
      <g>
        <rect x={p.x} y="120" width="260" height="160" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={p.x + 130} y="152" text-anchor="middle" font-size="12" fill="var(--muted)">{p.tag}</text>
        <rect x={p.x + 24} y="168" width="212" height="48" fill={p.accent ? "var(--accent)" : "none"} stroke={p.accent ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={p.x + 130} y="199" text-anchor="middle" font-size="18" fill={p.accent ? "var(--card)" : "var(--ink)"}>{p.val}</text>
        <text x={p.x + 130} y="254" text-anchor="middle" font-size="11" fill="var(--muted)">{p.addr}</text>
      </g>
    ))}

    <line x1="320" y1="200" x2="480" y2="200" stroke="var(--ink)" stroke-width="2" marker-end="url(#b06f2-arrow)" />
    <text x="400" y="184" text-anchor="middle" font-size="11" fill="var(--ink)">{t.arrowNote}</text>
    <text x="400" y="238" text-anchor="middle" font-size="11" fill="var(--muted)">{t.goneNote}</text>

    <text x="400" y="325" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
