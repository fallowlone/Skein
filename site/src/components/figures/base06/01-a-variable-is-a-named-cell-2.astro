---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Declaring let score = 0: reserve cell 1042, bind the name, write 0",
    headline: "DECLARE: RESERVE · BIND · WRITE",
    sub: "declaration in three steps",
    code: "let score = 0;",
    p1t: "① RESERVE",
    p1l: "find free cell 1042",
    p1s: "free",
    p2t: "② BIND",
    p2l: "record score → 1042",
    p2c: "score → 1042",
    p3t: "③ WRITE",
    p3l: "cell 1042 = 0",
    foot1: "after this the name is live",
    foot2: "without step 3 the cell holds garbage",
    caption:
      "Declaring let score = 0 takes three steps: the runtime finds a free cell at address 1042, records the binding score → 1042 in its table, and writes the initial value 0 into the cell. Step 2 is what makes the name meaningful; without step 3 the cell would hold garbage from previous use.",
  },
  ru: {
    svgTitle: "Объявление let score = 0: резерв ячейки 1042, привязка имени, запись 0",
    headline: "ОБЪЯВЛЕНИЕ: РЕЗЕРВ · ПРИВЯЗКА · ЗАПИСЬ",
    sub: "объявление за три шага",
    code: "let score = 0;",
    p1t: "① РЕЗЕРВ",
    p1l: "найти свободную 1042",
    p1s: "свободна",
    p2t: "② ПРИВЯЗКА",
    p2l: "записать score → 1042",
    p2c: "score → 1042",
    p3t: "③ ЗАПИСЬ",
    p3l: "ячейка 1042 = 0",
    foot1: "после этого имя живёт",
    foot2: "без шага 3 в ячейке — мусор",
    caption:
      "Объявление let score = 0 проходит в три шага: среда выполнения находит свободную ячейку по адресу 1042, записывает привязку score → 1042 в свою таблицу и кладёт начальное значение 0 в ячейку. Шаг 2 делает имя осмысленным; без шага 3 ячейка содержала бы мусор от предыдущего использования.",
  },
};

const t = dict[lang];

const panels = [
  { x: 40, title: t.p1t, line: t.p1l },
  { x: 290, title: t.p2t, line: t.p2l },
  { x: 540, title: t.p3t, line: t.p3l },
];

const links = [
  { x1: 260, x2: 290 },
  { x1: 510, x2: 540 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>
    <text x="400" y="84" text-anchor="middle" font-size="14" fill="var(--ink)">{t.code}</text>

    {panels.map((p) => (
      <g>
        <rect x={p.x} y="100" width="220" height="180" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={p.x + 110} y="128" text-anchor="middle" font-size="13" fill="var(--ink)">{p.title}</text>
        <text x={p.x + 110} y="262" text-anchor="middle" font-size="11" fill="var(--muted)">{p.line}</text>
      </g>
    ))}

    <rect x="100" y="145" width="100" height="70" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 4" />
    <text x="150" y="174" text-anchor="middle" font-size="14" fill="var(--ink)">1042</text>
    <text x="150" y="196" text-anchor="middle" font-size="11" fill="var(--muted)">{t.p1s}</text>

    <rect x="350" y="145" width="100" height="70" fill="var(--accent)" />
    <text x="400" y="187" text-anchor="middle" font-size="12" fill="var(--card)">{t.p2c}</text>

    <rect x="600" y="145" width="100" height="70" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="650" y="194" text-anchor="middle" font-size="30" fill="var(--ink)">0</text>

    {links.map((l) => (
      <g>
        <line x1={l.x1} y1="180" x2={l.x2} y2="180" stroke="var(--ink)" stroke-width="2" />
        <polygon points={`${l.x2},180 ${l.x2 - 9},175 ${l.x2 - 9},185`} fill="var(--ink)" />
      </g>
    ))}

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
