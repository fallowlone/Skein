---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Name score stays bound to cell 1042 while its value changes from 0 to 42",
    headline: "THE NAME STAYS · THE VALUE CHANGES",
    sub: "score → 1042 · first 0, then 42",
    nameTag: "name — fixed",
    midArrow: "value changes",
    before: "before",
    after: "after",
    cellLabel: "cell 1042",
    foot1: "same name score · same cell 1042",
    foot2: "name ≠ value: the label vs the contents",
    caption:
      "The name and the value are different things: after let score = 0, a later computation may leave 42 in cell 1042 while the name score still refers to the same cell. The label is fixed once declared and only the contents change — score never becomes 42, the cell simply holds 42.",
  },
  ru: {
    svgTitle: "Имя score остаётся привязанным к ячейке 1042, а значение меняется с 0 на 42",
    headline: "ИМЯ НЕ МЕНЯЕТСЯ · ЗНАЧЕНИЕ МЕНЯЕТСЯ",
    sub: "score → 1042 · сначала 0, потом 42",
    nameTag: "имя — неизменно",
    midArrow: "значение меняется",
    before: "было",
    after: "стало",
    cellLabel: "ячейка 1042",
    foot1: "то же имя score · та же ячейка 1042",
    foot2: "имя ≠ значение: метка и содержимое",
    caption:
      "Имя и значение — разные вещи: после let score = 0 позднее вычисление может оставить 42 в ячейке 1042, а имя score по-прежнему ссылается на ту же ячейку. Метка фиксирована с момента объявления и меняется только содержимое — score никогда не становится 42, ячейка просто хранит 42.",
  },
};

const t = dict[lang];

const states = [
  { x: 220, value: "0", tag: t.before, tagX: 280 },
  { x: 460, value: "42", tag: t.after, tagX: 520 },
];

const spokes = [
  { x1: 360, x2: 280, head: "280,170 291,169 287,162" },
  { x1: 440, x2: 520, head: "520,170 509,169 513,162" },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="80" text-anchor="middle" font-size="11" fill="var(--muted)">{t.nameTag}</text>
    <rect x="340" y="88" width="120" height="40" fill="var(--accent)" />
    <text x="400" y="115" text-anchor="middle" font-size="16" fill="var(--card)">score</text>

    {spokes.map((s) => (
      <g>
        <line x1={s.x1} y1="128" x2={s.x2} y2="170" stroke="var(--ink)" stroke-width="2" />
        <polygon points={s.head} fill="var(--ink)" />
      </g>
    ))}

    {states.map((s) => (
      <g>
        <text x={s.tagX} y="80" text-anchor="middle" font-size="11" fill="var(--muted)">{s.tag}</text>
        <rect x={s.x} y="170" width="120" height="90" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={s.x + 60} y="220" text-anchor="middle" font-size="30" fill="var(--ink)">{s.value}</text>
        <text x={s.x + 60} y="247" text-anchor="middle" font-size="11" fill="var(--muted)">{t.cellLabel}</text>
      </g>
    ))}

    <text x="400" y="206" text-anchor="middle" font-size="11" fill="var(--muted)">{t.midArrow}</text>
    <line x1="340" y1="218" x2="460" y2="218" stroke="var(--ink)" stroke-width="2" />
    <polygon points="460,218 451,213 451,223" fill="var(--ink)" />

    <text x="400" y="320" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="348" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
