---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Tree DP: each node returns height up while a side variable tracks the diameter",
    headline: "RETURN ↑ HEIGHT · SIDE TRACKS DIAMETER",
    sub: "one pass, two outputs: heights flow up, the answer accumulates on the side",
    hLabel: "h",
    returnTitle: "RETURN ↑ — height to parent",
    returnFormula: "h = 1 + max(lh, rh)",
    returnConv: "leaf 0 · null −1",
    sideTitle: "SIDE — maxDiameter so far",
    sideFormula: "lh + rh + 2 through each node",
    sideFinal: "final answer: 3",
    note: "postorder: every child reports before its parent folds",
    caption:
      "Tree DP on root 1 with children 2, 3 and leaves 4, 5 under 2: leaves seed h=0, node 2 folds 1 + max(0,0) = 1, leaf 3 seeds 0, root 1 folds 1 + max(1,0) = 2. Each node returns its height up while maxDiameter tracks the longest path on the side — final answer 3.",
  },
  ru: {
    svgTitle: "DP на дереве: каждый узел возвращает высоту вверх, а боковая переменная копит диаметр",
    headline: "ВОЗВРАТ ↑ ВЫСОТА · СБОКУ ДИАМЕТР",
    sub: "один проход, два выхода: высоты текут вверх, ответ копится сбоку",
    hLabel: "h",
    returnTitle: "ВОЗВРАТ ↑ — высота родителю",
    returnFormula: "h = 1 + max(lh, rh)",
    returnConv: "лист 0 · null −1",
    sideTitle: "СБОКУ — maxDiameter пока",
    sideFormula: "lh + rh + 2 через каждый узел",
    sideFinal: "финальный ответ: 3",
    note: "постпорядок: каждый ребёнок отчитывается раньше родителя",
    caption:
      "DP на дереве с корнем 1, детьми 2, 3 и листьями 4, 5 под двойкой: листья задают h=0, узел 2 сворачивает 1 + max(0,0) = 1, лист 3 задаёт 0, корень 1 сворачивает 1 + max(1,0) = 2. Каждый узел возвращает высоту вверх, а maxDiameter копит самый длинный путь сбоку — финальный ответ 3.",
  },
};

const t = dict[lang];

const nodes = [
  { id: "1", x: 150, y: 150, h: "2" },
  { id: "2", x: 75, y: 250, h: "1" },
  { id: "3", x: 225, y: 250, h: "0" },
  { id: "4", x: 38, y: 345, h: "0" },
  { id: "5", x: 112, y: 345, h: "0" },
];

const edges = [
  { x1: 150, y1: 150, x2: 75, y2: 250 },
  { x1: 150, y1: 150, x2: 225, y2: 250 },
  { x1: 75, y1: 250, x2: 38, y2: 345 },
  { x1: 75, y1: 250, x2: 112, y2: 345 },
];

const r = 21;
const shrink = (x1: number, y1: number, x2: number, y2: number) => {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const len = Math.sqrt(dx * dx + dy * dy);
  const ux = dx / len;
  const uy = dy / len;
  return { x1: x1 + ux * r, y1: y1 + uy * r, x2: x2 - ux * (r + 6), y2: y2 - uy * (r + 6) };
};
const segs = edges.map((e) => shrink(e.x1, e.y1, e.x2, e.y2));
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {segs.map((s) => (
      <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="var(--ink)" stroke-width="2" />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r={r} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="15" fill="var(--ink)">{n.id}</text>
        <text x={n.x} y={n.y + r + 16} text-anchor="middle" font-size="13" fill="var(--accent)">{t.hLabel}={n.h}</text>
      </g>
    ))}

    <rect x="300" y="110" width="460" height="110" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="322" y="140" font-size="14" fill="var(--ink)">{t.returnTitle}</text>
    <text x="322" y="168" font-size="14" fill="var(--accent)">{t.returnFormula}</text>
    <text x="322" y="196" font-size="13" fill="var(--muted)">{t.returnConv}</text>

    <rect x="300" y="236" width="460" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="322" y="266" font-size="14" fill="var(--ink)">{t.sideTitle}</text>
    <text x="322" y="294" font-size="14" fill="var(--accent)">{t.sideFormula}</text>
    <text x="322" y="322" font-size="13" fill="var(--muted)">{t.sideFinal}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
