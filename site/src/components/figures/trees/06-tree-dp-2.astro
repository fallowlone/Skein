---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Diameter through each node: leaf rows give 0, node 2 gives 2, root 1 gives 3",
    headline: "DIAMETER THROUGH EACH NODE = lh + rh + 2",
    sub: "leaves 4, 5, 3 score 0 · node 2 scores 2 · root 1 scores 3",
    colNode: "node",
    colLh: "lh",
    colRh: "rh",
    colCalc: "lh + rh + 2",
    colD: "d",
    pathLabel: "longest: 4 → 2 → 1 → 3 = 3 edges · maxDiameter = 3",
    note: "the longest path may not pass through the root — check every node",
    caption:
      "Diameter trace on the five-node tree: nodes 4, 5, 3 give −1 + −1 + 2 = 0; node 2 gives 0 + 0 + 2 = 2 (path 4 → 2 → 5); root 1 gives 1 + 0 + 2 = 3 (path 4 → 2 → 1 → 3). Longest path in the tree: 3 edges.",
  },
  ru: {
    svgTitle: "Диаметр через каждый узел: листья дают 0, узел 2 даёт 2, корень 1 даёт 3",
    headline: "ДИАМЕТР ЧЕРЕЗ КАЖДЫЙ УЗЕЛ = lh + rh + 2",
    sub: "листья 4, 5, 3 дают 0 · узел 2 даёт 2 · корень 1 даёт 3",
    colNode: "узел",
    colLh: "lh",
    colRh: "rh",
    colCalc: "lh + rh + 2",
    colD: "d",
    pathLabel: "длиннейший: 4 → 2 → 1 → 3 = 3 ребра · maxDiameter = 3",
    note: "длиннейший путь может не идти через корень — проверяй каждый узел",
    caption:
      "Трассировка диаметра на дереве из пяти узлов: узлы 4, 5, 3 дают −1 + −1 + 2 = 0; узел 2 даёт 0 + 0 + 2 = 2 (путь 4 → 2 → 5); корень 1 даёт 1 + 0 + 2 = 3 (путь 4 → 2 → 1 → 3). Самый длинный путь в дереве: 3 ребра.",
  },
};

const t = dict[lang];

const rows = [
  { n: "4", lh: "−1", rh: "−1", calc: "−1 + −1 + 2", d: "0", hot: false },
  { n: "5", lh: "−1", rh: "−1", calc: "−1 + −1 + 2", d: "0", hot: false },
  { n: "3", lh: "−1", rh: "−1", calc: "−1 + −1 + 2", d: "0", hot: false },
  { n: "2", lh: "0", rh: "0", calc: "0 + 0 + 2", d: "2", hot: false },
  { n: "1", lh: "1", rh: "0", calc: "1 + 0 + 2", d: "3", hot: true },
];

const y0 = 108;
const rh = 42;
const rowY = (i: number) => y0 + i * rh;
const colN = 210;
const colLh = 300;
const colRh = 380;
const colCalc = 520;
const colD = 660;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x={colN} y={y0 - 12} text-anchor="middle" font-size="13" fill="var(--muted)">{t.colNode}</text>
    <text x={colLh} y={y0 - 12} text-anchor="middle" font-size="13" fill="var(--muted)">{t.colLh}</text>
    <text x={colRh} y={y0 - 12} text-anchor="middle" font-size="13" fill="var(--muted)">{t.colRh}</text>
    <text x={colCalc} y={y0 - 12} text-anchor="middle" font-size="13" fill="var(--muted)">{t.colCalc}</text>
    <text x={colD} y={y0 - 12} text-anchor="middle" font-size="13" fill="var(--muted)">{t.colD}</text>

    {rows.map((r, i) => (
      <g>
        <rect x="140" y={rowY(i)} width="580" height={rh - 8} fill="var(--card)" stroke={r.hot ? "var(--accent)" : "var(--ink)"} stroke-width={r.hot ? 3 : 1.5} />
        <text x={colN} y={rowY(i) + 24} text-anchor="middle" font-size="15" fill="var(--ink)">{r.n}</text>
        <text x={colLh} y={rowY(i) + 24} text-anchor="middle" font-size="15" fill="var(--ink)">{r.lh}</text>
        <text x={colRh} y={rowY(i) + 24} text-anchor="middle" font-size="15" fill="var(--ink)">{r.rh}</text>
        <text x={colCalc} y={rowY(i) + 24} text-anchor="middle" font-size="15" fill="var(--ink)">{r.calc}</text>
        <text x={colD} y={rowY(i) + 24} text-anchor="middle" font-size="15" fill={r.hot ? "var(--accent)" : "var(--ink)"}>{r.d}</text>
      </g>
    ))}

    <text x="400" y="352" text-anchor="middle" font-size="14" fill="var(--accent)">{t.pathLabel}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
