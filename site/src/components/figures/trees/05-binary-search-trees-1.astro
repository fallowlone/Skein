---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Binary search tree with root 5 showing the ordering invariant",
    headline: "BST PROPERTY: LEFT < NODE < RIGHT",
    sub: "every left-subtree value < node · every right-subtree value > node",
    leftTag: "left subtree {1, 3, 4} < 5",
    rightTag: "right subtree {7, 8, 9} > 5",
    node3Tag: "node 3: {1} < 3 < {4}",
    note: "both subtrees are BSTs too — the property applies recursively",
    caption:
      "The BST ordering invariant: node 5 holds left subtree {1, 3, 4} (all < 5) and right subtree {7, 8, 9} (all > 5); node 3 holds {1} below and {4} above. Both subtrees are BSTs themselves.",
  },
  ru: {
    svgTitle: "Двоичное дерево поиска с корнем 5 и свойством порядка",
    headline: "СВОЙСТВО BST: ЛЕВОЕ < УЗЕЛ < ПРАВОЕ",
    sub: "каждое значение левого поддерева < узла · каждое значение правого > узла",
    leftTag: "левое поддерево {1, 3, 4} < 5",
    rightTag: "правое поддерево {7, 8, 9} > 5",
    node3Tag: "узел 3: {1} < 3 < {4}",
    note: "оба поддерева — тоже BST: свойство применяется рекурсивно",
    caption:
      "Свойство порядка BST: узел 5 держит левое поддерево {1, 3, 4} (все < 5) и правое поддерево {7, 8, 9} (все > 5); узел 3 держит {1} ниже и {4} выше. Оба поддерева сами являются BST.",
  },
};

const t = dict[lang];

const nodes = [
  { v: "5", x: 400, y: 112, hi: true },
  { v: "3", x: 280, y: 196, hi: false },
  { v: "8", x: 520, y: 196, hi: false },
  { v: "1", x: 200, y: 280, hi: false },
  { v: "4", x: 360, y: 280, hi: false },
  { v: "7", x: 460, y: 280, hi: false },
  { v: "9", x: 600, y: 280, hi: false },
];

const edges = [
  { x1: 400, y1: 112, x2: 280, y2: 196 },
  { x1: 400, y1: 112, x2: 520, y2: 196 },
  { x1: 280, y1: 196, x2: 200, y2: 280 },
  { x1: 280, y1: 196, x2: 360, y2: 280 },
  { x1: 520, y1: 196, x2: 460, y2: 280 },
  { x1: 520, y1: 196, x2: 600, y2: 280 },
];

const r = 24;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="150" y="150" width="210" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 4" rx="10" />
    <rect x="440" y="150" width="210" height="170" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 4" rx="10" />

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r={r} fill={n.hi ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="16" fill={n.hi ? "var(--card)" : "var(--ink)"}>{n.v}</text>
      </g>
    ))}

    <text x="255" y="342" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftTag}</text>
    <text x="545" y="342" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightTag}</text>
    <text x="400" y="368" text-anchor="middle" font-size="12" fill="var(--ink)">{t.node3Tag}</text>
    <text x="400" y="396" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
