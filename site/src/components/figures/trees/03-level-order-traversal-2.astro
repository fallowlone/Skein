---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Queue states during basic level-order traversal of the tree 1-2-3-4",
    headline: "THE QUEUE NEVER SKIPS AHEAD",
    sub: "children join the back — the current level drains first",
    step1: "visit 1 · enqueue 2, 3",
    step2: "visit 2 · enqueue 4",
    step3: "visit 3 · no children",
    step4: "visit 4 · queue empty",
    queueLabel: "queue",
    caption:
      "Trace of the basic loop: visit 1 leaves queue [2, 3]; visit 2 leaves [3, 4]; visit 3 leaves [4]; visit 4 leaves []. Order: 1, 2, 3, 4.",
  },
  ru: {
    svgTitle: "Состояния очереди при базовом поуровневом обходе дерева 1-2-3-4",
    headline: "ОЧЕРЕДЬ НЕ ПЕРЕПРЫГИВАЕТ",
    sub: "дети встают в конец — текущий уровень осушается первым",
    step1: "посещаем 1 · в очередь 2, 3",
    step2: "посещаем 2 · в очередь 4",
    step3: "посещаем 3 · детей нет",
    step4: "посещаем 4 · очередь пуста",
    queueLabel: "очередь",
    caption:
      "Трассировка базового цикла: посещение 1 оставляет очередь [2, 3]; посещение 2 оставляет [3, 4]; посещение 3 оставляет [4]; посещение 4 оставляет []. Порядок: 1, 2, 3, 4.",
  },
};

const t = dict[lang];

const rows = [
  { caption: t.step1, queue: ["2", "3"] },
  { caption: t.step2, queue: ["3", "4"] },
  { caption: t.step3, queue: ["4"] },
  { caption: t.step4, queue: [] as string[] },
];

const rowY = (i: number) => 100 + i * 76;
const cellX = (j: number) => 480 + j * 64;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="480" y="86" font-size="12" fill="var(--muted)">{t.queueLabel} →</text>

    {rows.map((r, i) => (
      <g>
        <text x="80" y={rowY(i) + 30} font-size="13" fill="var(--ink)">{r.caption}</text>
        {r.queue.map((v, j) => (
          <g>
            <rect x={cellX(j)} y={rowY(i)} width="52" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
            <text x={cellX(j) + 26} y={rowY(i) + 30} text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
          </g>
        ))}
      </g>
    ))}
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
