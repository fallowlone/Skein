---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Level-size snapshots group nodes into levels: [1], [2, 3], [4]",
    headline: "LEVELSIZE = ONE LEVEL PER BATCH",
    sub: "snapshot queue.length at each layer start",
    sizeLabel: "levelSize",
    levelLabel: "level done",
    resultLabel: "result",
    result: "[[1], [2, 3], [4]]",
    caption:
      "By-level variant: levelSize 1 finishes level [1]; levelSize 2 finishes [2, 3]; levelSize 1 finishes [4]. Result: [[1], [2, 3], [4]].",
  },
  ru: {
    svgTitle: "Снимки размера уровня группируют узлы по уровням: [1], [2, 3], [4]",
    headline: "LEVELSIZE = ОДИН УРОВЕНЬ ЗА ПАРТИЮ",
    sub: "снимок queue.length в начале каждого слоя",
    sizeLabel: "levelSize",
    levelLabel: "уровень готов",
    resultLabel: "результат",
    result: "[[1], [2, 3], [4]]",
    caption:
      "Вариант «по уровням»: levelSize 1 закрывает уровень [1]; levelSize 2 закрывает [2, 3]; levelSize 1 закрывает [4]. Результат: [[1], [2, 3], [4]].",
  },
};

const t = dict[lang];

const batches = [
  { size: "1", level: "[1]" },
  { size: "2", level: "[2, 3]" },
  { size: "1", level: "[4]" },
];

const rowY = (i: number) => 110 + i * 70;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="180" y="96" font-size="12" fill="var(--muted)">{t.sizeLabel}</text>
    <text x="420" y="96" font-size="12" fill="var(--muted)">{t.levelLabel}</text>

    {batches.map((b, i) => (
      <g>
        <rect x="160" y={rowY(i)} width="52" height="46" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x="186" y={rowY(i) + 30} text-anchor="middle" font-size="16" fill="var(--ink)">{b.size}</text>
        <line x1="240" y1={rowY(i) + 23} x2="330" y2={rowY(i) + 23} stroke="var(--accent)" stroke-width="2" />
        <polygon points={`330,${rowY(i) + 16} 330,${rowY(i) + 30} 342,${rowY(i) + 23}`} fill="var(--accent)" />
        <rect x="350" y={rowY(i)} width="140" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="420" y={rowY(i) + 30} text-anchor="middle" font-size="16" fill="var(--ink)">{b.level}</text>
      </g>
    ))}

    <text x="160" y="360" font-size="13" fill="var(--ink)">{t.resultLabel}</text>
    <rect x="280" y="330" width="240" height="48" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="360" text-anchor="middle" font-size="16" fill="var(--ink)">{t.result}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
