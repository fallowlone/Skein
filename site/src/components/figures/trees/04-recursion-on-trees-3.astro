---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The recurse-and-combine pattern: postorder steps, base cases, complexity",
    headline: "RECURSE ON SUBTREES AND COMBINE",
    sub: "postorder: left subtree, right subtree, then the node itself",
    steps: ["1 · solve the left subtree", "2 · solve the right subtree", "3 · combine with the current node", "4 · return the result up"],
    baseTitle: "base case: empty subtree (null)",
    heightBase: "height: null → -1",
    countBase: "count: null → 0",
    time: "time O(n) · visit each node once",
    space: "space O(h) · stack depth = tree height",
    caption:
      "The pattern: solve the left subtree, solve the right subtree, combine both answers with the current node, return the result up — that is postorder. The base case is the empty subtree: -1 for height, 0 for counts. Time O(n), space O(h).",
  },
  ru: {
    svgTitle: "Паттерн «рекурсия и свёртка»: шаги постпорядка, базы, сложность",
    headline: "РЕКУРСИРУЙ НА ПОДДЕРЕВЬЯХ И КОМБИНИРУЙ",
    sub: "постпорядок: левое поддерево, правое поддерево, потом сам узел",
    steps: ["1 · реши левое поддерево", "2 · реши правое поддерево", "3 · скомбинируй с текущим узлом", "4 · верни результат вверх"],
    baseTitle: "базовый случай: пустое поддерево (null)",
    heightBase: "высота: null → -1",
    countBase: "подсчёт: null → 0",
    time: "время O(n) · посети каждый узел один раз",
    space: "память O(h) · глубина стека = высота дерева",
    caption:
      "Паттерн: реши левое поддерево, реши правое поддерево, скомбинируй оба ответа с текущим узлом, верни результат вверх — это постпорядок. Базовый случай — пустое поддерево: -1 для высоты, 0 для подсчётов. Время O(n), память O(h).",
  },
};

const t = dict[lang];

const stepY = (i: number) => 130 + i * 34;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {t.steps.map((s, i) => (
      <g>
        <rect x="180" y={stepY(i) - 20} width="440" height="28" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="400" y={stepY(i)} text-anchor="middle" font-size="13" fill="var(--ink)">{s}</text>
      </g>
    ))}

    <text x="400" y="292" text-anchor="middle" font-size="13" fill="var(--muted)">{t.baseTitle}</text>
    <text x="280" y="318" text-anchor="middle" font-size="13" fill="var(--ink)">{t.heightBase}</text>
    <text x="520" y="318" text-anchor="middle" font-size="13" fill="var(--ink)">{t.countBase}</text>

    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--accent)">{t.time}</text>
    <text x="400" y="376" text-anchor="middle" font-size="13" fill="var(--accent)">{t.space}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
