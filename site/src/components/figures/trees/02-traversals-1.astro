---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Reference binary tree with pre-order, in-order, and post-order visit sequences",
    headline: "ONE TREE · THREE VISIT ORDERS",
    sub: "same four nodes — only the root moves: front, middle, back",
    treeLabel: "the reference tree",
    preLabel: "pre-order · node, left, right",
    inLabel: "in-order · left, node, right",
    postLabel: "post-order · left, right, node",
    rootFirst: "root 1st",
    rootMiddle: "root 3rd",
    rootLast: "root 4th",
    caption:
      "On root 1 with left child 2 (whose left child is 4) and right child 3: pre-order reads 1, 2, 4, 3 (root first); in-order reads 4, 2, 1, 3 (root in the middle); post-order reads 4, 2, 3, 1 (root last). The root cell is highlighted in each row.",
  },
  ru: {
    svgTitle: "Эталонное бинарное дерево с порядками обхода: прямой, симметричный, обратный",
    headline: "ОДНО ДЕРЕВО · ТРИ ПОРЯДКА ОБХОДА",
    sub: "те же четыре узла — движется только корень: начало, середина, конец",
    treeLabel: "эталонное дерево",
    preLabel: "прямой · узел, левое, правое",
    inLabel: "симметричный · левое, узел, правое",
    postLabel: "обратный · левое, правое, узел",
    rootFirst: "корень 1-й",
    rootMiddle: "корень 3-й",
    rootLast: "корень 4-й",
    caption:
      "На корне 1 с левым ребёнком 2 (чей левый ребёнок — 4) и правым ребёнком 3: прямой порядок читает 1, 2, 4, 3 (корень первым); симметричный читает 4, 2, 1, 3 (корень в середине); обратный читает 4, 2, 3, 1 (корень последним). Ячейка корня подсвечена в каждой строке.",
  },
};

const t = dict[lang];

const rows = [
  { label: t.preLabel, note: t.rootFirst, seq: ["1", "2", "4", "3"], root: 0 },
  { label: t.inLabel, note: t.rootMiddle, seq: ["4", "2", "1", "3"], root: 2 },
  { label: t.postLabel, note: t.rootLast, seq: ["4", "2", "3", "1"], root: 3 },
];

const nodes = [
  { v: "1", x: 150, y: 140 },
  { v: "2", x: 70, y: 245 },
  { v: "3", x: 230, y: 245 },
  { v: "4", x: 40, y: 345 },
];

const edges = [
  { x1: 150, y1: 140, x2: 70, y2: 245 },
  { x1: 150, y1: 140, x2: 230, y2: 245 },
  { x1: 70, y1: 245, x2: 40, y2: 345 },
];

const rowY = (r: number) => 122 + r * 100;
const cellX = (i: number) => 330 + i * 72;
const gapX = (i: number) => 330 + i * 72 + 64;
const cw = 56;
const ch = 40;
const gaps = [0, 1, 2];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="140" y="102" text-anchor="middle" font-size="13" fill="var(--muted)">{t.treeLabel}</text>
    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="24" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.v}</text>
      </g>
    ))}

    {rows.map((row, r) => (
      <g>
        <text x="320" y={rowY(r)} font-size="13" fill="var(--ink)">{row.label}</text>
        {row.seq.map((v, i) => (
          <g>
            <rect
              x={cellX(i)}
              y={rowY(r) + 14}
              width={cw}
              height={ch}
              fill="var(--card)"
              stroke={i === row.root ? "var(--accent)" : "var(--ink)"}
              stroke-width={i === row.root ? 3 : 2}
            />
            <text x={cellX(i) + cw / 2} y={rowY(r) + 40} text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
          </g>
        ))}
        {gaps.map((i) => (
          <text x={gapX(i)} y={rowY(r) + 40} text-anchor="middle" font-size="14" fill="var(--muted)">→</text>
        ))}
        <text x="616" y={rowY(r) + 40} font-size="12" fill="var(--accent)">{row.note}</text>
      </g>
    ))}
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
