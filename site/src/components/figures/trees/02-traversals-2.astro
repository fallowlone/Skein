---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Pre-order trace on the reference tree: visit 1, 2, 4, backtrack, visit 3",
    headline: "PRE-ORDER TRACE: VISIT FIRST, THEN DESCEND",
    sub: "preOrder(root) on 1 · 2 · 3 · 4 — node before children",
    step1a: "visit 1",
    step1b: "start at root",
    step2a: "visit 2",
    step2b: "go left",
    step3a: "visit 4",
    step3b: "go left",
    step4a: "backtrack",
    step4b: "4 → 2 → 1",
    step5a: "visit 3",
    step5b: "go right",
    orderLabel: "visiting order",
    note: "done: every node visited exactly once",
    caption:
      "Pre-order trace of preOrder(root): start at root 1 and visit it, go left to 2 and visit it, go left to 4 and visit it, find no further children and backtrack 4 → 2 → 1, then go right to 3 and visit it. Final visiting order: 1, 2, 4, 3. Every node is visited exactly once.",
  },
  ru: {
    svgTitle: "Трассировка прямого обхода эталонного дерева: посетить 1, 2, 4, вернуться, посетить 3",
    headline: "ТРАССИРОВКА ПРЯМОГО ОБХОДА: СНАЧАЛА УЗЕЛ",
    sub: "preOrder(root) на 1 · 2 · 3 · 4 — узел раньше детей",
    step1a: "посетить 1",
    step1b: "старт на корне",
    step2a: "посетить 2",
    step2b: "идти влево",
    step3a: "посетить 4",
    step3b: "идти влево",
    step4a: "возврат",
    step4b: "4 → 2 → 1",
    step5a: "посетить 3",
    step5b: "идти вправо",
    orderLabel: "порядок посещения",
    note: "готово: каждый узел посещён ровно раз",
    caption:
      "Трассировка прямого обхода preOrder(root): старт на корне 1 и посетить его, идти влево к 2 и посетить его, идти влево к 4 и посетить его, не найти дальше детей и вернуться 4 → 2 → 1, потом идти вправо к 3 и посетить его. Итоговый порядок посещения: 1, 2, 4, 3. Каждый узел посещён ровно один раз.",
  },
};

const t = dict[lang];

const steps = [
  { a: t.step1a, b: t.step1b, hot: true },
  { a: t.step2a, b: t.step2b, hot: true },
  { a: t.step3a, b: t.step3b, hot: true },
  { a: t.step4a, b: t.step4b, hot: false },
  { a: t.step5a, b: t.step5b, hot: true },
];

const order = ["1", "2", "4", "3"];
const gaps = [0, 1, 2];

const boxX = (i: number) => 40 + i * 145;
const boxW = 130;
const boxY = 104;
const boxH = 92;
const arrowX = (i: number) => 40 + i * 145 + boxW + 7;
const cellX = (i: number) => 264 + i * 72;
const cellGapX = (i: number) => 264 + i * 72 + 64;
const cw = 56;
const ch = 48;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {steps.map((s, i) => (
      <g>
        <rect x={boxX(i)} y={boxY} width={boxW} height={boxH} fill="var(--card)" stroke={s.hot ? "var(--accent)" : "var(--ink)"} stroke-width="2" />
        <text x={boxX(i) + boxW / 2} y={boxY + 34} text-anchor="middle" font-size="13" fill="var(--ink)">{s.a}</text>
        <text x={boxX(i) + boxW / 2} y={boxY + 60} text-anchor="middle" font-size="12" fill="var(--muted)">{s.b}</text>
      </g>
    ))}
    {steps.slice(0, 4).map((_, i) => (
      <text x={arrowX(i)} y={boxY + 52} text-anchor="middle" font-size="16" fill="var(--muted)">→</text>
    ))}


    <text x="400" y="252" text-anchor="middle" font-size="13" fill="var(--ink)">{t.orderLabel}</text>
    {order.map((v, i) => (
      <g>
        <rect x={cellX(i)} y="266" width={cw} height={ch} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cellX(i) + cw / 2} y="296" text-anchor="middle" font-size="15" fill="var(--ink)">{v}</text>
      </g>
    ))}
    {gaps.map((i) => (
      <text x={cellGapX(i)} y="296" text-anchor="middle" font-size="14" fill="var(--muted)">→</text>
    ))}

    <text x="400" y="360" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
