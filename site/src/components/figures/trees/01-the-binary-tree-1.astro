---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Five-node binary tree with labeled vocabulary",
    headline: "ONE ROOT, BRANCHES, LEAVES",
    sub: "1 is the root · 2 is the parent of 4 and 5 · 4 and 5 are siblings",
    root: "root",
    leaf: "leaf",
    internal: "internal",
    left: "left",
    right: "right",
    note: "2 is the parent of 4 and 5 · 4 is a child of 2 · 4 and 5 are siblings",
    caption:
      "Tree 1–5: node 1 is the root; 2 is the parent of 4 and 5; 4 is a child of 2; 4 and 5 are siblings; 3, 4 and 5 are leaves. Each node has at most two children: left and right.",
  },
  ru: {
    svgTitle: "Двоичное дерево из пяти узлов с подписанной терминологией",
    headline: "ОДИН КОРЕНЬ, ВЕТВИ, ЛИСТЬЯ",
    sub: "1 — корень · 2 — родитель 4 и 5 · 4 и 5 — братья",
    root: "корень",
    leaf: "лист",
    internal: "внутренний",
    left: "лево",
    right: "право",
    note: "2 — родитель 4 и 5 · 4 — дитя 2 · 4 и 5 — братья",
    caption:
      "Дерево 1–5: узел 1 — корень; 2 — родитель 4 и 5; 4 — дитя 2; 4 и 5 — братья; 3, 4 и 5 — листья. Каждый узел имеет максимум двух детей: левого и правого.",
  },
};

const t = dict[lang];

const nodes = [
  { v: "1", x: 400, y: 135 },
  { v: "2", x: 285, y: 235 },
  { v: "3", x: 515, y: 235 },
  { v: "4", x: 225, y: 330 },
  { v: "5", x: 345, y: 330 },
];

const edges = [
  { x1: 400, y1: 135, x2: 285, y2: 235 },
  { x1: 400, y1: 135, x2: 515, y2: 235 },
  { x1: 285, y1: 235, x2: 225, y2: 330 },
  { x1: 285, y1: 235, x2: 345, y2: 330 },
];

const leafTags = [
  { x: 515, y: 283 },
  { x: 225, y: 378 },
  { x: 345, y: 378 },
];

const edgeTags = [
  { x: 330, y: 178, key: "left" as const },
  { x: 470, y: 178, key: "right" as const },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="400" y="99" text-anchor="middle" font-size="13" fill="var(--accent)">{t.root}</text>

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="24" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.v}</text>
      </g>
    ))}
    {edgeTags.map((g) => (
      <text x={g.x} y={g.y} text-anchor="middle" font-size="11" fill="var(--muted)">{t[g.key]}</text>
    ))}
    {leafTags.map((p) => (
      <text x={p.x} y={p.y} text-anchor="middle" font-size="13" fill="var(--accent)">{t.leaf}</text>
    ))}

    <text x="255" y="239" text-anchor="end" font-size="13" fill="var(--muted)">{t.internal}</text>

    <text x="400" y="404" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
