---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Which traversal for which job, and the O(n) time, O(h) space cost",
    headline: "PICK THE ORDER BY THE JOB",
    sub: "parent context, sorted output, or child results — each order is a tool",
    preName: "pre-order",
    preUse: "copy a tree · ancestors before descendants",
    preEx: "process the node first, then recurse",
    inName: "in-order",
    inUse: "BST gives sorted output",
    inEx: "e.g. tree 2 · 1 · 3 reads 1, 2, 3",
    postName: "post-order",
    postUse: "delete a tree · subtree results bottom-up",
    postEx: "solve both children, then the node",
    cost: "time O(n) — each node once · space O(h): O(log n) balanced, O(n) chain",
    caption:
      "Pre-order processes parents before children (copy a tree, top-down); in-order on a binary search tree gives sorted output (tree 2 with children 1 and 3 reads 1, 2, 3); post-order processes parents after children (delete a tree, subtree results bottom-up). All three run in O(n) time and O(h) space — O(log n) on balanced trees, O(n) on chains.",
  },
  ru: {
    svgTitle: "Какой обход для какой задачи и цена: время O(n), память O(h)",
    headline: "ВЫБИРАЙ ПОРЯДОК ПО ЗАДАЧЕ",
    sub: "контекст предков, сортировка или результаты детей — каждый порядок инструмент",
    preName: "прямой",
    preUse: "скопировать дерево · предки раньше потомков",
    preEx: "сначала обработать узел, потом рекурсия",
    inName: "симметричный",
    inUse: "дерево поиска даёт сортировку",
    inEx: "напр. дерево 2 · 1 · 3 читается 1, 2, 3",
    postName: "обратный",
    postUse: "удалить дерево · результаты снизу вверх",
    postEx: "сначала решить обоих детей, потом узел",
    cost: "время O(n) — каждый узел раз · память O(h): O(log n) / O(n) цепочка",
    caption:
      "Прямой порядок обрабатывает родителей раньше детей (скопировать дерево, сверху вниз); симметричный порядок в двоичном дереве поиска даёт отсортированный вывод (дерево 2 с детьми 1 и 3 читается 1, 2, 3); обратный порядок обрабатывает родителей после детей (удалить дерево, результаты поддерева снизу вверх). Все три работают за O(n) времени и O(h) памяти — O(log n) на сбалансированных деревьях, O(n) на цепочках.",
  },
};

const t = dict[lang];

const rows = [
  { name: t.preName, use: t.preUse, ex: t.preEx },
  { name: t.inName, use: t.inUse, ex: t.inEx },
  { name: t.postName, use: t.postUse, ex: t.postEx },
];

const rowY = (r: number) => 96 + r * 80;
const badgeW = 170;
const badgeH = 58;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {rows.map((row, r) => (
      <g>
        <rect x="40" y={rowY(r)} width={badgeW} height={badgeH} fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
        <text x={40 + badgeW / 2} y={rowY(r) + 35} text-anchor="middle" font-size="14" fill="var(--ink)">{row.name}</text>
        <text x="234" y={rowY(r) + 25} font-size="13" fill="var(--ink)">{row.use}</text>
        <text x="234" y={rowY(r) + 47} font-size="12" fill="var(--muted)">{row.ex}</text>
      </g>
    ))}

    <rect x="40" y="344" width="720" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--ink)">{t.cost}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
