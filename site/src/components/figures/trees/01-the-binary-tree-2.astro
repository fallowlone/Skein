---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Depth and height labeled on the five-node tree",
    headline: "DEPTH ↓ FROM ROOT · HEIGHT ↓ TO FURTHEST LEAF",
    sub: "depth = edges down from the root · height = edges down to the furthest leaf",
    depth0: "depth 0 · level 0",
    depth1: "depth 1",
    depth2: "depth 2",
    height0: "1: height 2",
    height1: "2: height 1 · 3: height 0",
    height2: "4, 5: height 0",
    note1: "node 4: depth 2 via 1→2→4 · height 0",
    note2: "node 2: depth 1 · height 1",
    caption:
      "Root 1 has depth 0 and height 2, so the tree height is 2. Node 2 has depth 1 and height 1; node 3 has height 0; leaves 4 and 5 have depth 2 and height 0.",
  },
  ru: {
    svgTitle: "Глубина и высота, подписанные на дереве из пяти узлов",
    headline: "ГЛУБИНА ↓ ОТ КОРНЯ · ВЫСОТА ↓ ДО ДАЛЬНЕГО ЛИСТА",
    sub: "глубина = рёбра вниз от корня · высота = рёбра вниз до дальнего листа",
    depth0: "глубина 0 · уровень 0",
    depth1: "глубина 1",
    depth2: "глубина 2",
    height0: "1: высота 2",
    height1: "2: высота 1 · 3: высота 0",
    height2: "4, 5: высота 0",
    note1: "узел 4: глубина 2 через 1→2→4 · высота 0",
    note2: "узел 2: глубина 1 · высота 1",
    caption:
      "Корень 1 имеет глубину 0 и высоту 2, значит высота дерева — 2. Узел 2: глубина 1, высота 1; узел 3: высота 0; листья 4 и 5: глубина 2, высота 0.",
  },
};

const t = dict[lang];

const nodes = [
  { v: "1", x: 400, y: 120 },
  { v: "2", x: 315, y: 205 },
  { v: "3", x: 485, y: 205 },
  { v: "4", x: 265, y: 290 },
  { v: "5", x: 365, y: 290 },
];

const pathEdges = [
  { x1: 400, y1: 120, x2: 315, y2: 205 },
  { x1: 315, y1: 205, x2: 265, y2: 290 },
];

const plainEdges = [
  { x1: 400, y1: 120, x2: 485, y2: 205 },
  { x1: 315, y1: 205, x2: 365, y2: 290 },
];

const depthRows = [
  { y: 124, label: t.depth0 },
  { y: 209, label: t.depth1 },
  { y: 294, label: t.depth2 },
];

const heightRows = [
  { y: 124, label: t.height0 },
  { y: 209, label: t.height1 },
  { y: 294, label: t.height2 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {plainEdges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
    ))}
    {pathEdges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--accent)" stroke-width="3" />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="24" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="16" fill="var(--ink)">{n.v}</text>
      </g>
    ))}

    {depthRows.map((r) => (
      <text x="215" y={r.y} text-anchor="end" font-size="13" fill="var(--ink)">{r.label}</text>
    ))}
    {heightRows.map((r) => (
      <text x="540" y={r.y} text-anchor="start" font-size="13" fill="var(--ink)">{r.label}</text>
    ))}

    <text x="400" y="352" text-anchor="middle" font-size="13" fill="var(--accent)">{t.note1}</text>
    <text x="400" y="378" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
