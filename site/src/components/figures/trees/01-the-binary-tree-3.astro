---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Pointer-hop navigation root.left.right reaching node 5, and isLeaf results",
    headline: "FOLLOW POINTERS: root.left.right → 5",
    sub: "each link is one pointer hop · O(1) per hop",
    hopNote: "two hops: left, then right",
    leafTitle: "is it a leaf?",
    leafDef: "leaf: left === null && right === null",
    caption:
      "Navigating root.left.right hops left to 2, then right to 5, and reads value 5. isLeaf is true for node 4 and false for node 2 and the root; each hop costs O(1).",
  },
  ru: {
    svgTitle: "Навигация прыжками root.left.right к узлу 5 и результаты isLeaf",
    headline: "СЛЕДУЙ УКАЗАТЕЛЯМ: root.left.right → 5",
    sub: "каждая связь — один прыжок указателя · O(1) за прыжок",
    hopNote: "два прыжка: влево, затем вправо",
    leafTitle: "это лист?",
    leafDef: "лист: left === null && right === null",
    caption:
      "Навигация root.left.right прыгает влево к 2, затем вправо к 5, и читает значение 5. isLeaf даёт true для узла 4 и false для узла 2 и корня; каждый прыжок стоит O(1).",
  },
};

const t = dict[lang];

const hops = [
  { expr: "root", show: "= 1", x: 60, y: 110 },
  { expr: "root.left", show: "= 2", x: 300, y: 110 },
  { expr: "root.left.right", show: "= 5", x: 540, y: 110 },
];

const hopW = 200;
const hopH = 64;
const hopCy = 110 + hopH / 2;

const hopArrows = [
  { x1: 260, x2: 300, pts: "300,136 300,148 308,142" },
  { x1: 500, x2: 540, pts: "540,136 540,148 548,142" },
];

const leafRows = [
  { expr: "isLeaf(4)", out: "true", y: 244 },
  { expr: "isLeaf(2)", out: "false", y: 282 },
  { expr: "isLeaf(root)", out: "false", y: 320 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {hops.map((h) => (
      <g>
        <rect x={h.x} y={h.y} width={hopW} height={hopH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={h.x + hopW / 2} y={h.y + 26} text-anchor="middle" font-size="13" fill="var(--muted)">{h.expr}</text>
        <text x={h.x + hopW / 2} y={h.y + 50} text-anchor="middle" font-size="16" fill="var(--ink)">{h.show}</text>
      </g>
    ))}
    {hopArrows.map((a) => (
      <g>
        <line x1={a.x1} y1={hopCy} x2={a.x2} y2={hopCy} stroke="var(--accent)" stroke-width="2" />
        <polygon points={a.pts} fill="var(--accent)" />
      </g>
    ))}
    <text x="400" y="198" text-anchor="middle" font-size="12" fill="var(--muted)">{t.hopNote}</text>

    <text x="400" y="222" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leafTitle}</text>
    {leafRows.map((r) => (
      <g>
        <text x="370" y={r.y} text-anchor="end" font-size="14" fill="var(--ink)">{r.expr}</text>
        <rect x="390" y={r.y - 20} width="80" height="28" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="430" y={r.y} text-anchor="middle" font-size="14" fill="var(--accent)">{r.out}</text>
      </g>
    ))}

    <text x="400" y="366" text-anchor="middle" font-size="13" fill="var(--muted)">{t.leafDef}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
