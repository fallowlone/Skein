---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Height computed on tree 1-2-3-4: answers flow up from leaves to root",
    headline: "ANSWERS FLOW UP: LEAVES REPORT, PARENTS COMBINE",
    sub: "height(node) = 1 + max of children · null → -1",
    base: "null → -1",
    leaf: "leaf",
    root: "root",
    note: "leaf 4 → 0 · leaf 3 → 0 · node 2 → 1 · root 1 → 2",
    caption:
      "Computing height on root 1 with children 2, 3 and leaf 4 under 2: leaf 4 returns 1 + max(-1,-1) = 0, leaf 3 returns 0, node 2 returns 1 + max(0,-1) = 1, root 1 returns 1 + max(1,0) = 2.",
  },
  ru: {
    svgTitle: "Высота на дереве 1-2-3-4: ответы текут вверх от листьев к корню",
    headline: "ОТВЕТЫ ТЕКУТ ВВЕРХ: РОДИТЕЛИ СВОРАЧИВАЮТ",
    sub: "высота(узел) = 1 + max детей · null → -1",
    base: "null → -1",
    leaf: "лист",
    root: "корень",
    note: "лист 4 → 0 · лист 3 → 0 · узел 2 → 1 · корень 1 → 2",
    caption:
      "Считаем высоту на корне 1 с детьми 2, 3 и листом 4 под двойкой: лист 4 возвращает 1 + max(-1,-1) = 0, лист 3 возвращает 0, узел 2 возвращает 1 + max(0,-1) = 1, корень 1 возвращает 1 + max(1,0) = 2.",
  },
};

const t = dict[lang];

const nodes = [
  { id: "1", x: 400, y: 130, ret: "→ 2", tag: "root" },
  { id: "2", x: 270, y: 230, ret: "→ 1", tag: "" },
  { id: "3", x: 530, y: 230, ret: "→ 0", tag: "leaf" },
  { id: "4", x: 190, y: 330, ret: "→ 0", tag: "leaf" },
];

const edges = [
  { x1: 400, y1: 130, x2: 270, y2: 230 },
  { x1: 400, y1: 130, x2: 530, y2: 230 },
  { x1: 270, y1: 230, x2: 190, y2: 330 },
];

const tagOf = (tag: string) => (tag === "root" ? t.root : tag === "leaf" ? t.leaf : undefined);
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--muted)" stroke-width="2" />
    ))}

    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="26" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="15" fill="var(--ink)">{n.id}</text>
        <text x={n.x + 34} y={n.y + 5} font-size="13" fill="var(--accent)">{n.ret}</text>
        <text x={n.x} y={n.y + 44} text-anchor="middle" font-size="11" fill="var(--muted)">{tagOf(n.tag)}</text>
      </g>
    ))}

    <text x="620" y="330" font-size="12" fill="var(--muted)">{t.base}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
