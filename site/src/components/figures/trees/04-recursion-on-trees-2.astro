---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Node count on tree 1-2-3-4: each node returns 1 plus its subtrees",
    headline: "COUNT: 1 + LEFT + RIGHT",
    sub: "count(node) = 1 + left + right · null → 0",
    total: "total: 4 nodes",
    note: "node 4 → 1 · node 3 → 1 · node 2 → 2 · root 1 → 4",
    caption:
      "Counting nodes on the same tree: leaf 4 returns 1 + 0 + 0 = 1, node 3 returns 1, node 2 returns 1 + 1 + 0 = 2, root 1 returns 1 + 2 + 1 = 4. The entire tree has 4 nodes.",
  },
  ru: {
    svgTitle: "Подсчёт узлов на дереве 1-2-3-4: каждый узел возвращает 1 плюс поддеревья",
    headline: "ПОДСЧЁТ: 1 + ЛЕВОЕ + ПРАВОЕ",
    sub: "count(узел) = 1 + левое + правое · null → 0",
    total: "итого: 4 узла",
    note: "узел 4 → 1 · узел 3 → 1 · узел 2 → 2 · корень 1 → 4",
    caption:
      "Считаем узлы на том же дереве: лист 4 возвращает 1 + 0 + 0 = 1, узел 3 возвращает 1, узел 2 возвращает 1 + 1 + 0 = 2, корень 1 возвращает 1 + 2 + 1 = 4. Всё дерево имеет 4 узла.",
  },
};

const t = dict[lang];

const nodes = [
  { id: "1", x: 400, y: 130, ret: "→ 4" },
  { id: "2", x: 270, y: 230, ret: "→ 2" },
  { id: "3", x: 530, y: 230, ret: "→ 1" },
  { id: "4", x: 190, y: 330, ret: "→ 1" },
];

const edges = [
  { x1: 400, y1: 130, x2: 270, y2: 230 },
  { x1: 400, y1: 130, x2: 530, y2: 230 },
  { x1: 270, y1: 230, x2: 190, y2: 330 },
];

const rows = [
  { id: "4", math: "1 + 0 + 0 = 1" },
  { id: "3", math: "1 + 0 + 0 = 1" },
  { id: "2", math: "1 + 1 + 0 = 2" },
  { id: "1", math: "1 + 2 + 1 = 4" },
];

const rowY = (i: number) => 170 + i * 34;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--muted)" stroke-width="2" />
    ))}

    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r="26" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="15" fill="var(--ink)">{n.id}</text>
        <text x={n.x - 34} y={n.y + 5} text-anchor="end" font-size="13" fill="var(--accent)">{n.ret}</text>
      </g>
    ))}

    {rows.map((r, i) => (
      <text x="596" y={rowY(i)} font-size="13" fill="var(--ink)">{"count(" + r.id + ") = " + r.math}</text>
    ))}
    <text x="620" y={rowY(4)} font-size="13" fill="var(--accent)">{t.total}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
