---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Inserting 6 into a BST and the degenerate chain from sorted insertion",
    headline: "INSERT 6 · SORTED INPUT DEGENERATES",
    sub: "insert walks to a null and attaches a leaf · sorted input builds a chain",
    insertTitle: "insert 6: 6 > 5 → 6 < 8 → 6 < 7 → attach",
    chainTitle: "insert [1, 2, 3, 4, 5]: chain, height 4",
    newTag: "new",
    balancedTag: "balanced: O(log n)",
    degenerateTag: "degenerate: O(n)",
    note: "search and insert cost O(h) — balance decides the price",
    caption:
      "Inserting 6: 6 > 5 go right, 6 < 8 go left, 6 < 7 go left, then attach 6 as the left child of 7 (4 steps). But inserting sorted input [1, 2, 3, 4, 5] builds a chain of height 4, so operations degrade from O(log n) to O(n).",
  },
  ru: {
    svgTitle: "Вставка 6 в BST и вырожденная цепочка из отсортированной вставки",
    headline: "ВСТАВКА 6 · ОТСОРТИРОВАННЫЙ ВВОД ВЫРОЖДАЕТСЯ",
    sub: "вставка идёт до null и прикрепляет лист · отсортированный ввод строит цепочку",
    insertTitle: "вставка 6: 6 > 5 → 6 < 8 → 6 < 7 → прикрепить",
    chainTitle: "вставка [1, 2, 3, 4, 5]: цепочка, высота 4",
    newTag: "новый",
    balancedTag: "сбалансированное: O(log n)",
    degenerateTag: "вырожденное: O(n)",
    note: "поиск и вставка стоят O(h) — баланс решает цену",
    caption:
      "Вставка 6: 6 > 5 идём вправо, 6 < 8 идём влево, 6 < 7 идём влево, потом прикрепляем 6 как левого ребёнка 7 (4 шага). Но вставка отсортированного ввода [1, 2, 3, 4, 5] строит цепочку высоты 4, поэтому операции деградируют с O(log n) до O(n).",
  },
};

const t = dict[lang];

const tree = [
  { v: "5", x: 200, y: 130, onPath: true, isNew: false },
  { v: "3", x: 110, y: 195, onPath: false, isNew: false },
  { v: "8", x: 290, y: 195, onPath: true, isNew: false },
  { v: "1", x: 65, y: 260, onPath: false, isNew: false },
  { v: "4", x: 155, y: 260, onPath: false, isNew: false },
  { v: "7", x: 245, y: 260, onPath: true, isNew: false },
  { v: "9", x: 335, y: 260, onPath: false, isNew: false },
  { v: "6", x: 245, y: 325, onPath: true, isNew: true },
];

const treeEdges = [
  { x1: 200, y1: 130, x2: 110, y2: 195, onPath: false },
  { x1: 200, y1: 130, x2: 290, y2: 195, onPath: true },
  { x1: 110, y1: 195, x2: 65, y2: 260, onPath: false },
  { x1: 110, y1: 195, x2: 155, y2: 260, onPath: false },
  { x1: 290, y1: 195, x2: 245, y2: 260, onPath: true },
  { x1: 290, y1: 195, x2: 335, y2: 260, onPath: false },
  { x1: 245, y1: 260, x2: 245, y2: 325, onPath: true },
];

const chain = [
  { v: "1", y: 120 },
  { v: "2", y: 170 },
  { v: "3", y: 220 },
  { v: "4", y: 270 },
  { v: "5", y: 320 },
];

const chainEdges = [
  { y1: 120, y2: 170 },
  { y1: 170, y2: 220 },
  { y1: 220, y2: 270 },
  { y1: 270, y2: 320 },
];

const cx = 600;
const r = 19;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <line x1="400" y1="80" x2="400" y2="350" stroke="var(--muted)" stroke-width="1" stroke-dasharray="6 4" />

    <text x="200" y="100" text-anchor="middle" font-size="12" fill="var(--ink)">{t.insertTitle}</text>
    {treeEdges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke={e.onPath ? "var(--accent)" : "var(--muted)"} stroke-width={e.onPath ? 3 : 1.5} />
    ))}
    {tree.map((n) => (
      <g opacity={n.onPath || n.isNew ? 1 : 0.45}>
        <circle cx={n.x} cy={n.y} r={r} fill={n.isNew ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="13" fill={n.isNew ? "var(--card)" : "var(--ink)"}>{n.v}</text>
      </g>
    ))}
    <text x="272" y="330" font-size="12" fill="var(--accent)">{t.newTag}</text>
    <text x="200" y="368" text-anchor="middle" font-size="12" fill="var(--ink)">{t.balancedTag}</text>

    <text x="600" y="100" text-anchor="middle" font-size="12" fill="var(--ink)">{t.chainTitle}</text>
    {chainEdges.map((e) => (
      <line x1={cx} y1={e.y1} x2={cx} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
    ))}
    {chain.map((n) => (
      <g>
        <circle cx={cx} cy={n.y} r={r} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={cx} y={n.y + 5} text-anchor="middle" font-size="13" fill="var(--ink)">{n.v}</text>
      </g>
    ))}
    <text x="600" y="368" text-anchor="middle" font-size="12" fill="var(--ink)">{t.degenerateTag}</text>

    <text x="400" y="398" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
