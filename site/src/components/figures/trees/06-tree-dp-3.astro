---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Height-balanced check: every node differs by at most 1, result true",
    headline: "BALANCED IF |lh − rh| ≤ 1 AT EVERY NODE",
    sub: "return the height if balanced, −1 as the unbalanced sentinel",
    hLabel: "h",
    nullLabel: "null −1",
    check4: "node 4: leaf · h=0 ✓",
    check3: "node 3: leaf · h=0 ✓",
    check2: "node 2: |0 − (−1)| = 1 ≤ 1 ✓ → h=1",
    check1: "node 1: |1 − 0| = 1 ≤ 1 ✓ → h=2",
    result: "isBalanced(root) = true",
    note: "−1 encodes unbalanced; a non-negative return is the height",
    caption:
      "Balance check on root 1 with children 2, 3 and node 4 under 2: leaves 4 and 3 return h=0; node 2 has |0 − (−1)| = 1 ≤ 1 and returns h=1; root 1 has |1 − 0| = 1 ≤ 1 and returns h=2. isBalanced(root) = true.",
  },
  ru: {
    svgTitle: "Проверка сбалансированности: каждый узел отличается не более чем на 1, итог true",
    headline: "СБАЛАНСИРОВАНО, ЕСЛИ |lh − rh| ≤ 1 В КАЖДОМ УЗЛЕ",
    sub: "верни высоту если сбалансировано, −1 как сентинель",
    hLabel: "h",
    nullLabel: "null −1",
    check4: "узел 4: лист · h=0 ✓",
    check3: "узел 3: лист · h=0 ✓",
    check2: "узел 2: |0 − (−1)| = 1 ≤ 1 ✓ → h=1",
    check1: "узел 1: |1 − 0| = 1 ≤ 1 ✓ → h=2",
    result: "isBalanced(root) = true",
    note: "−1 кодирует несбалансированность; неотрицательный возврат — высота",
    caption:
      "Проверка баланса на корне 1 с детьми 2, 3 и узлом 4 под двойкой: листья 4 и 3 возвращают h=0; узел 2 имеет |0 − (−1)| = 1 ≤ 1 и возвращает h=1; корень 1 имеет |1 − 0| = 1 ≤ 1 и возвращает h=2. isBalanced(root) = true.",
  },
};

const t = dict[lang];

const checks = [dict[lang].check4, dict[lang].check3, dict[lang].check2, dict[lang].check1];

const nodes = [
  { id: "1", x: 150, y: 150, h: "2" },
  { id: "2", x: 75, y: 250, h: "1" },
  { id: "3", x: 225, y: 250, h: "0" },
  { id: "4", x: 38, y: 345, h: "0" },
];

const edges = [
  { x1: 150, y1: 150, x2: 75, y2: 250 },
  { x1: 150, y1: 150, x2: 225, y2: 250 },
  { x1: 75, y1: 250, x2: 38, y2: 345 },
];

const r = 21;
const shrink = (x1: number, y1: number, x2: number, y2: number) => {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const len = Math.sqrt(dx * dx + dy * dy);
  const ux = dx / len;
  const uy = dy / len;
  return { x1: x1 + ux * r, y1: y1 + uy * r, x2: x2 - ux * (r + 6), y2: y2 - uy * (r + 6) };
};
const segs = edges.map((e) => shrink(e.x1, e.y1, e.x2, e.y2));

const checkY = (i: number) => 140 + i * 44;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {segs.map((s) => (
      <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="var(--ink)" stroke-width="2" />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={n.x} cy={n.y} r={r} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="15" fill="var(--ink)">{n.id}</text>
        <text x={n.x} y={n.y + r + 16} text-anchor="middle" font-size="13" fill="var(--accent)">{t.hLabel}={n.h}</text>
      </g>
    ))}
    <rect x="92" y="329" width="70" height="32" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="127" y="350" text-anchor="middle" font-size="12" fill="var(--muted)">{t.nullLabel}</text>

    {checks.map((c, i) => (
      <text x="300" y={checkY(i)} font-size="14" fill="var(--ink)">{c}</text>
    ))}
    <rect x="300" y="300" width="330" height="40" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="465" y="326" text-anchor="middle" font-size="15" fill="var(--accent)">{t.result}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
