---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Binary tree with root 1, children 2 and 3, and node 4 under 2, grouped into levels",
    headline: "LEVEL BY LEVEL: 1 · 2, 3 · 4",
    sub: "top to bottom, left to right — FIFO queue",
    level0: "level 0",
    level1: "level 1",
    level2: "level 2",
    orderLabel: "visit order",
    order: "1 → 2 → 3 → 4",
    caption:
      "The lesson tree: root 1 on level 0, nodes 2 and 3 on level 1, node 4 on level 2. Level-order visits 1, then 2 and 3, then 4.",
  },
  ru: {
    svgTitle: "Бинарное дерево с корнем 1, детьми 2 и 3 и узлом 4 под двойкой, сгруппированное по уровням",
    headline: "УРОВЕНЬ ЗА УРОВНЕМ: 1 · 2, 3 · 4",
    sub: "сверху вниз, слева направо — FIFO-очередь",
    level0: "уровень 0",
    level1: "уровень 1",
    level2: "уровень 2",
    orderLabel: "порядок посещения",
    order: "1 → 2 → 3 → 4",
    caption:
      "Дерево из урока: корень 1 на уровне 0, узлы 2 и 3 на уровне 1, узел 4 на уровне 2. Поуровневый обход посещает 1, потом 2 и 3, потом 4.",
  },
};

const t = dict[lang];

const levels = [
  { label: t.level0, y: 70, nodes: [{ v: "1", x: 470 }] },
  { label: t.level1, y: 160, nodes: [{ v: "2", x: 370 }, { v: "3", x: 570 }] },
  { label: t.level2, y: 250, nodes: [{ v: "4", x: 370 }] },
];

const edges = [
  { x1: 470, y1: 90, x2: 370, y2: 140 },
  { x1: 470, y1: 90, x2: 570, y2: 140 },
  { x1: 370, y1: 180, x2: 370, y2: 230 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--ink)" stroke-width="2" />
    ))}

    {levels.map((lv) => (
      <g>
        <text x="130" y={lv.y + 27} font-size="13" fill="var(--muted)">{lv.label}</text>
        {lv.nodes.map((n) => (
          <g>
            <circle cx={n.x} cy={lv.y + 20} r="22" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
            <text x={n.x} y={lv.y + 26} text-anchor="middle" font-size="16" fill="var(--ink)">{n.v}</text>
          </g>
        ))}
      </g>
    ))}


    <text x="130" y="350" font-size="13" fill="var(--ink)">{t.orderLabel}</text>
    <rect x="270" y="322" width="220" height="48" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="380" y="352" text-anchor="middle" font-size="16" fill="var(--ink)">{t.order}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
