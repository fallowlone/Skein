---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Searching for 4 in a binary search tree: path 5 to 3 to 4",
    headline: "SEARCH FOR 4: COMPARE AND TURN",
    sub: "one comparison per level picks the only side that can hold the target",
    step1: "at 5: 4 < 5 — go left",
    step2: "at 3: 4 > 3 — go right",
    step3: "at 4: 4 = 4 — found",
    note: "3 comparisons for 7 nodes — the path costs O(height)",
    caption:
      "Searching for 4: start at 5 (4 < 5, go left), at 3 (4 > 3, go right), at 4 (4 = 4, found). Three comparisons visit only the root-to-target path; the wrong subtrees are never entered, so search costs O(h).",
  },
  ru: {
    svgTitle: "Поиск 4 в двоичном дереве поиска: путь 5 → 3 → 4",
    headline: "ПОИСК 4: СРАВНИ И ПОВЕРНИ",
    sub: "одно сравнение на уровень выбирает единственную сторону с целью",
    step1: "в 5: 4 < 5 — идём влево",
    step2: "в 3: 4 > 3 — идём вправо",
    step3: "в 4: 4 = 4 — найдено",
    note: "3 сравнения на 7 узлов — путь стоит O(высоты)",
    caption:
      "Поиск 4: начинаем с 5 (4 < 5, идём влево), в 3 (4 > 3, идём вправо), в 4 (4 = 4, найдено). Три сравнения посещают только путь от корня к цели; в неверные поддеревья не заходим, поэтому поиск стоит O(h).",
  },
};

const t = dict[lang];

const nodes = [
  { v: "5", x: 400, y: 104, onPath: true },
  { v: "3", x: 290, y: 176, onPath: true },
  { v: "8", x: 510, y: 176, onPath: false },
  { v: "1", x: 220, y: 248, onPath: false },
  { v: "4", x: 360, y: 248, onPath: true },
  { v: "7", x: 460, y: 248, onPath: false },
  { v: "9", x: 580, y: 248, onPath: false },
];

const edges = [
  { x1: 400, y1: 104, x2: 290, y2: 176, onPath: true },
  { x1: 400, y1: 104, x2: 510, y2: 176, onPath: false },
  { x1: 290, y1: 176, x2: 220, y2: 248, onPath: false },
  { x1: 290, y1: 176, x2: 360, y2: 248, onPath: true },
  { x1: 510, y1: 176, x2: 460, y2: 248, onPath: false },
  { x1: 510, y1: 176, x2: 580, y2: 248, onPath: false },
];

const steps = [
  { n: "1", y: 306, get label() { return t.step1; } },
  { n: "2", y: 334, get label() { return t.step2; } },
  { n: "3", y: 362, get label() { return t.step3; } },
];

const r = 23;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke={e.onPath ? "var(--accent)" : "var(--muted)"} stroke-width={e.onPath ? 3 : 1.5} />
    ))}
    {nodes.map((n) => (
      <g opacity={n.onPath ? 1 : 0.45}>
        <circle cx={n.x} cy={n.y} r={r} fill={n.onPath ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={n.x} y={n.y + 6} text-anchor="middle" font-size="15" fill={n.onPath ? "var(--card)" : "var(--ink)"}>{n.v}</text>
      </g>
    ))}

    {steps.map((s) => (
      <g>
        <circle cx="212" cy={s.y - 5} r="11" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="212" y={s.y} text-anchor="middle" font-size="12" fill="var(--ink)">{s.n}</text>
        <text x="234" y={s.y} font-size="14" fill="var(--ink)">{s.label}</text>
      </g>
    ))}

    <text x="400" y="398" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
