---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle:
      "keyof User gives the key union id, name, age; User indexed by name gives string — derived automatically, indexed by type and not by value",
    headline: "KEYOF LISTS KEYS, T[K] READS VALUES",
    sub: "User { id; name; age } becomes keys, then a value type",
    box1Title: "User",
    box1Line1: "id: string",
    box1Line2: "name: string",
    box1Line3: "age: number",
    box1Foot: "the data, written once",
    arrow1: "keyof",
    box2Title: "keyof User",
    box2Line1: '"id" | "name"',
    box2Line2: '| "age"',
    box2Verdict: "updates automatically",
    arrow2: "pick K",
    box3Title: 'User["name"]',
    box3Line1: "= string",
    box3Verdict: "by type, not by value",
    foot1: 'User["nope"] is an error: no such key',
    foot2: "change User once, every derived type follows",
    caption:
      'keyof User derives the key union from the User shape, and User["name"] reads the value type at that key; add a property and the derived types update with no hand-written duplicate.',
  },
  ru: {
    svgTitle:
      "keyof User даёт объединение ключей id, name, age; User по name даёт string — выводится автоматически, индексация по типу, а не по значению",
    headline: "KEYOF ДАЁТ КЛЮЧИ, T[K] ДАЁТ ЗНАЧЕНИЯ",
    sub: "User { id; name; age } превращается в ключи, затем в тип значения",
    box1Title: "User",
    box1Line1: "id: string",
    box1Line2: "name: string",
    box1Line3: "age: number",
    box1Foot: "данные — один раз",
    arrow1: "keyof",
    box2Title: "keyof User",
    box2Line1: '"id" | "name"',
    box2Line2: '| "age"',
    box2Verdict: "обновляется автоматически",
    arrow2: "выбрать K",
    box3Title: 'User["name"]',
    box3Line1: "= string",
    box3Verdict: "по типу, а не по значению",
    foot1: 'User["nope"] — ошибка: нет такого ключа',
    foot2: "измени User один раз — выведенные типы последуют",
    caption:
      'keyof User выводит объединение ключей из формы User, а User["name"] читает тип значения по этому ключу; добавь свойство — и выведенные типы обновятся без написанного вручную дубликата.',
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsEverydayIndexAccess-1" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="92" width="180" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="130" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box1Title}</text>
    <text x="130" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line1}</text>
    <text x="130" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line2}</text>
    <text x="130" y="208" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box1Line3}</text>
    <text x="130" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box1Foot}</text>

    <text x="265" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow1}</text>
    <line x1="240" y1="186" x2="284" y2="186" stroke="var(--accent)" stroke-width="2" />
    <polygon points="284,180 284,192 296,186" fill="var(--accent)" />

    <rect x="310" y="92" width="180" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box2Title}</text>
    <text x="400" y="156" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line1}</text>
    <text x="400" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box2Line2}</text>
    <text x="400" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box2Verdict}</text>

    <text x="535" y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{t.arrow2}</text>
    <line x1="510" y1="186" x2="554" y2="186" stroke="var(--accent)" stroke-width="2" />
    <polygon points="554,180 554,192 566,186" fill="var(--accent)" />

    <rect x="580" y="92" width="180" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="670" y="122" text-anchor="middle" font-size="13" fill="var(--ink)">{t.box3Title}</text>
    <text x="670" y="182" text-anchor="middle" font-size="12" fill="var(--muted)">{t.box3Line1}</text>
    <text x="670" y="250" text-anchor="middle" font-size="11" fill="var(--ink)">{t.box3Verdict}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
