---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Literal discriminant narrows, widened string does not: kind ok narrows to r.data, kind string leaves no narrowing and an error",
    headline: "LITERAL NARROWS, STRING DOES NOT",
    sub: "the discriminant must be a literal on every member",
    tagLeft: "literal discriminant",
    tagRight: "widened discriminant",
    leftLine1: 'kind: "ok"',
    leftLine2: 'if (r.kind === "ok")',
    leftLine3: "→ narrows to one variant",
    leftLine4: "r.data — reachable",
    rightLine1: "kind: string",
    rightLine2: 'if (b.kind === "data")',
    rightLine3: "→ so no narrowing happens",
    rightLine4: "Error: 'data' not on Bad",
    foot1: "copying the tag through let widens it and breaks narrowing",
    foot2: 'kind: "ok" works; kind: string does not',
    caption:
      "A literal discriminant narrows each branch to one variant; widen it to string and the checker can no longer tell members apart, so narrowing silently stops.",
  },
  ru: {
    svgTitle: "Литеральный дискриминант сужает, расширенный string — нет: kind ok сужает до r.data, kind string не даёт сужения и даёт ошибку",
    headline: "ЛИТЕРАЛ СУЖАЕТ, А STRING — НЕТ",
    sub: "дискриминант обязан быть литералом на каждом члене",
    tagLeft: "дискриминант — литерал",
    tagRight: "расширенный дискриминант",
    leftLine1: 'kind: "ok"',
    leftLine2: 'if (r.kind === "ok")',
    leftLine3: "→ сужает до одного варианта",
    leftLine4: "r.data — доступно",
    rightLine1: "kind: string",
    rightLine2: 'if (b.kind === "data")',
    rightLine3: "→ поэтому сужения не происходит",
    rightLine4: "Error: 'data' not on Bad",
    foot1: "копирование тега через let расширяет его и ломает сужение",
    foot2: 'kind: "ok" работает; kind: string — нет',
    caption:
      "Литеральный дискриминант сужает каждую ветку до одного варианта; расширь его до string — и проверяющий перестанет различать члены, сужение молча прекратится.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsEverydayDU-2">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <text x="210" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
      <rect x="40" y="116" width="340" height="180" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="210" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine1}</text>
      <text x="210" y="178" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine2}</text>
      <text x="210" y="206" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine3}</text>
      <text x="210" y="234" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine4}</text>

      <text x="590" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
      <rect x="420" y="116" width="340" height="180" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
      <text x="590" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine1}</text>
      <text x="590" y="178" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine2}</text>
      <text x="590" y="206" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine3}</text>
      <text x="590" y="234" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine4}</text>

      <text x="400" y="340" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
      <text x="400" y="366" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
