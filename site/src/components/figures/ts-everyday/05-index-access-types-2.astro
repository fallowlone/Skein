---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle:
      "Indexing User by the key union id or age gives string or number with duplicates collapsed; Action indexed by type reads the tag union add or clear from the variants",
    headline: "INDEX BY A KEY UNION, GET A VALUE UNION",
    sub: 'User["id" | "age"] plus Action["type"]',
    leftTitle: 'User["id" | "age"]',
    leftLine1: '"id" holds string',
    leftLine2: '"age" holds number',
    leftVerdict: "= string | number",
    rightTitle: 'Action["type"]',
    rightLine1: '"add" variant',
    rightLine2: '"clear" variant',
    rightVerdict: '= "add" | "clear"',
    foot1: "T[keyof T] means every value type at once",
    foot2: "duplicates collapse: string | string | number = string | number",
    caption:
      'Indexing by a union of keys unions the value types, so User["id" | "age"] is string | number and T[keyof T] is every value type; Action["type"] reads the discriminant tags straight from the variants, keeping one source of truth.',
  },
  ru: {
    svgTitle:
      "Индексация User объединением ключей id или age даёт string или number со схлопнутыми дубликатами; Action по type читает объединение тегов add или clear из вариантов",
    headline: "ИНДЕКС ПО ОБЪЕДИНЕНИЮ КЛЮЧЕЙ — ОБЪЕДИНЕНИЕ ЗНАЧЕНИЙ",
    sub: 'User["id" | "age"] плюс Action["type"]',
    leftTitle: 'User["id" | "age"]',
    leftLine1: 'в "id" лежит string',
    leftLine2: 'в "age" лежит number',
    leftVerdict: "= string | number",
    rightTitle: 'Action["type"]',
    rightLine1: 'вариант "add"',
    rightLine2: 'вариант "clear"',
    rightVerdict: '= "add" | "clear"',
    foot1: "T[keyof T] — это сразу все типы значений",
    foot2: "дубликаты схлопываются: string | string | number = string | number",
    caption:
      'Индексация объединением ключей объединяет типы значений: User["id" | "age"] — это string | number, а T[keyof T] — сразу все типы значений; Action["type"] читает теги дискриминанта прямо из вариантов, держа единый источник истины.',
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsEverydayIndexAccess-2" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="90" width="340" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="120" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftTitle}</text>
    <text x="210" y="158" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftLine1}</text>
    <text x="210" y="184" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftLine2}</text>
    <text x="210" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftVerdict}</text>

    <rect x="420" y="90" width="340" height="200" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="590" y="120" text-anchor="middle" font-size="13" fill="var(--ink)">{t.rightTitle}</text>
    <text x="590" y="158" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightLine1}</text>
    <text x="590" y="184" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightLine2}</text>
    <text x="590" y="248" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightVerdict}</text>

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
