---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A deferred closure re-widens id to string or number, while capturing const sid before the boundary keeps string",
    headline: "NARROWING IS LOST AT THE BOUNDARY",
    sub: "the checker assumes a call could reassign a captured variable",
    guardLine1: 'if (typeof id === "string")',
    guardLine2: "narrowed here: id is string",
    leftTag: "closure re-widens",
    leftLine1: "setTimeout(() => { ... })",
    leftLine2: "id: string | number",
    leftLine3: "id.toUpperCase() fails",
    rightTag: "const captures first",
    rightLine1: "const sid = id;",
    rightLine2: "sid: string",
    rightLine3: "sid.toUpperCase() — OK",
    foot1: "a call, closure, or await between guard and use restores the declared type",
    foot2: "copy the narrowed value into a const before the boundary",
    caption:
      "A deferred closure re-widens id to string or number, so the guarded call fails; capturing the narrowed value in a const before the boundary keeps string, and the call succeeds.",
  },
  ru: {
    svgTitle: "Отложенное замыкание расширяет id обратно до string или number, а захват const sid до границы сохраняет string",
    headline: "СУЖЕНИЕ ТЕРЯЕТСЯ НА ГРАНИЦЕ",
    sub: "проверяющий считает, что вызов мог изменить захваченную переменную",
    guardLine1: 'if (typeof id === "string")',
    guardLine2: "здесь сужено: id это string",
    leftTag: "замыкание расширяет обратно",
    leftLine1: "setTimeout(() => { ... })",
    leftLine2: "id: string | number",
    leftLine3: "id.toUpperCase() — ошибка",
    rightTag: "const захватывает первым",
    rightLine1: "const sid = id;",
    rightLine2: "sid: string",
    rightLine3: "sid.toUpperCase() — OK",
    foot1: "вызов, замыкание или await между проверкой и использованием возвращают объявленный тип",
    foot2: "скопируй суженное значение в const до границы",
    caption:
      "Отложенное замыкание расширяет id обратно до string или number, и защищённый вызов не проходит; захват суженного значения в const до границы сохраняет string, и вызов удаётся.",
  },
};

const t = dict[lang];

const splits = [
  { x1: 330, y1: 136, x2: 205, y2: 180 },
  { x1: 470, y1: 136, x2: 595, y2: 180 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsEverydayNarrowing-bound" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="250" y="84" width="300" height="52" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="106" text-anchor="middle" font-size="13" fill="var(--ink)">{t.guardLine1}</text>
    <text x="400" y="128" text-anchor="middle" font-size="11" fill="var(--accent)">{t.guardLine2}</text>

    {splits.map((s) => (
      <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsEverydayNarrowing-bound)" />
    ))}

    <rect x="40" y="180" width="330" height="150" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" stroke-dasharray="7 5" />
    <text x="205" y="212" text-anchor="middle" font-size="11" fill="var(--muted)">{t.leftTag}</text>
    <text x="205" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine1}</text>
    <text x="205" y="264" text-anchor="middle" font-size="13" fill="var(--ink)">{t.leftLine2}</text>
    <text x="205" y="290" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftLine3}</text>

    <rect x="430" y="180" width="330" height="150" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="212" text-anchor="middle" font-size="11" fill="var(--muted)">{t.rightTag}</text>
    <text x="595" y="238" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine1}</text>
    <text x="595" y="264" text-anchor="middle" font-size="13" fill="var(--accent)">{t.rightLine2}</text>
    <text x="595" y="290" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine3}</text>

    <text x="400" y="362" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="386" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
