---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One shared literal tag kind narrows a switch to one variant per branch: r.data is reachable only in ok, r.message only in error",
    headline: "ONE TAG, THREE NARROWED BRANCHES",
    sub: "branching on the discriminant narrows the whole object",
    unionLine1: "type Result =",
    unionLine2: '| { kind: "ok"; data: string }',
    unionLine3: '| { kind: "error"; message: string }',
    unionLine4: '| { kind: "loading" }',
    readTag: "read tag",
    switchLine: "switch (r.kind)",
    caseOk: 'case "ok":',
    caseError: 'case "error":',
    caseLoading: 'case "loading":',
    reachOk: "→ r.data",
    reachError: "→ r.message",
    reachLoading: '→ "…"',
    foot: "each branch sees exactly one variant — illegal states unrepresentable",
    caption:
      'One shared literal tag narrows the whole object per branch: r.data is reachable only in "ok" and r.message only in "error" — illegal states become unrepresentable.',
  },
  ru: {
    svgTitle: "Один общий литеральный тег kind сужает switch до одного варианта на ветку: r.data доступно лишь в ok, r.message — лишь в error",
    headline: "ОДИН ТЕГ — ТРИ СУЖЕННЫЕ ВЕТКИ",
    sub: "ветвление по дискриминанту сужает весь объект",
    unionLine1: "type Result =",
    unionLine2: '| { kind: "ok"; data: string }',
    unionLine3: '| { kind: "error"; message: string }',
    unionLine4: '| { kind: "loading" }',
    readTag: "читаем тег",
    switchLine: "switch (r.kind)",
    caseOk: 'case "ok":',
    caseError: 'case "error":',
    caseLoading: 'case "loading":',
    reachOk: "→ r.data",
    reachError: "→ r.message",
    reachLoading: '→ "…"',
    foot: "каждая ветка видит ровно один вариант — недопустимое непредставимо",
    caption:
      'Один общий литеральный тег сужает весь объект по веткам: r.data доступно лишь в "ok", а r.message — лишь в "error", и недопустимые состояния становятся непредставимыми.',
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsEverydayDU-1">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <rect x="170" y="76" width="460" height="124" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="400" y="104" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unionLine1}</text>
      <text x="400" y="128" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unionLine2}</text>
      <text x="400" y="152" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unionLine3}</text>
      <text x="400" y="176" text-anchor="middle" font-size="12" fill="var(--ink)">{t.unionLine4}</text>

      <line x1="400" y1="204" x2="400" y2="220" stroke="var(--muted)" stroke-width="2" />
      <polygon points="394,210 406,210 400,220" fill="var(--muted)" />
      <text x="424" y="216" font-size="11" fill="var(--muted)">{t.readTag}</text>

      <rect x="310" y="224" width="180" height="40" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="249" text-anchor="middle" font-size="12" fill="var(--ink)">{t.switchLine}</text>

      <line x1="340" y1="264" x2="150" y2="288" stroke="var(--muted)" stroke-width="2" />
      <polygon points="143,288 154,283 152,293" fill="var(--muted)" />
      <line x1="400" y1="264" x2="400" y2="288" stroke="var(--muted)" stroke-width="2" />
      <polygon points="394,278 406,278 400,288" fill="var(--muted)" />
      <line x1="460" y1="264" x2="650" y2="288" stroke="var(--muted)" stroke-width="2" />
      <polygon points="648,293 646,283 657,288" fill="var(--muted)" />

      <rect x="40" y="292" width="220" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="150" y="318" text-anchor="middle" font-size="12" fill="var(--ink)">{t.caseOk}</text>
      <text x="150" y="342" text-anchor="middle" font-size="12" fill="var(--ink)">{t.reachOk}</text>

      <rect x="290" y="292" width="220" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="400" y="318" text-anchor="middle" font-size="12" fill="var(--ink)">{t.caseError}</text>
      <text x="400" y="342" text-anchor="middle" font-size="12" fill="var(--ink)">{t.reachError}</text>

      <rect x="540" y="292" width="220" height="70" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
      <text x="650" y="318" text-anchor="middle" font-size="12" fill="var(--ink)">{t.caseLoading}</text>
      <text x="650" y="342" text-anchor="middle" font-size="12" fill="var(--ink)">{t.reachLoading}</text>

      <text x="400" y="394" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
