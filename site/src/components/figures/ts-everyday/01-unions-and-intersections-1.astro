---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Union Circle | Square: s.kind is reachable because it is common to both, while s.radius errors until narrowing",
    headline: "ONE-OF: ONLY WHAT BOTH HAVE",
    sub: "Shape = Circle | Square — which one is undecided",
    tagLeft: "reachable without narrowing",
    leftLine1: "s.kind",
    leftLine2: '"circle" | "square"',
    leftLine3: "common to both · OK",
    tagRight: "blocked until narrowing",
    rightLine1: "s.radius",
    rightLine2: "only on Circle",
    rightLine3: "Error — narrow first",
    foot1: "union = one-of: wider value set, fewer members",
    foot2: "s.radius needs narrowing — next lesson",
    caption:
      "A union value is either member, so the checker exposes only members common to every member: kind is reachable, radius waits for narrowing.",
  },
  ru: {
    svgTitle: "Объединение Circle | Square: s.kind доступно как общее для обоих, а s.radius даёт ошибку до сужения",
    headline: "ОДНО-ИЗ: ЛИШЬ ОБЩЕЕ ДЛЯ ОБОИХ",
    sub: "Shape = Circle | Square — что именно, неизвестно",
    tagLeft: "доступно без сужения",
    leftLine1: "s.kind",
    leftLine2: '"circle" | "square"',
    leftLine3: "общий для обоих · OK",
    tagRight: "недоступно до сужения",
    rightLine1: "s.radius",
    rightLine2: "только у Circle",
    rightLine3: "Error — сначала сузите",
    foot1: "объединение = одно-из: шире множество значений, уже набор членов",
    foot2: "для s.radius нужно сужение — следующий урок",
    caption:
      "Значение объединения — один из членов, поэтому проверяющий открывает лишь члены, общие для каждого члена объединения: kind доступен, radius ждёт сужения.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="60" y="120" width="300" height="130" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="210" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine1}</text>
    <text x="210" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine2}</text>
    <text x="210" y="218" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine3}</text>

    <text x="590" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="440" y="120" width="300" height="130" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="590" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine1}</text>
    <text x="590" y="190" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine2}</text>
    <text x="590" y="218" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine3}</text>

    <text x="400" y="308" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
