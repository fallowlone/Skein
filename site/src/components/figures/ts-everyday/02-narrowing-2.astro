---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Five everyday narrowing operators, each with its gotcha: typeof, truthiness, equality, in, instanceof",
    headline: "FIVE GUARDS, FIVE GOTCHAS",
    sub: "each operator narrows — each has a trap",
    rows: [
      { op: "typeof", effect: "splits on runtime tags", gotcha: 'typeof null === "object"' },
      { op: "truthiness if (v)", effect: "drops null, 0, '', false", gotcha: "also drops 0" },
      { op: "equality === / !==", effect: "narrows both branches", gotcha: "needs a literal" },
      { op: "in", effect: "keeps members with the key", gotcha: "structural, not nominal" },
      { op: "instanceof", effect: "narrows by prototype chain", gotcha: "fails across realms" },
    ],
    caption:
      "Five everyday narrowing operators, each with its gotcha: typeof confuses null with objects, truthiness drops 0, equality needs a literal, in is structural, instanceof follows the prototype chain.",
  },
  ru: {
    svgTitle: "Пять повседневных операторов сужения, у каждого своя подножка: typeof, истинность, равенство, in, instanceof",
    headline: "ПЯТЬ ПРОВЕРОК, ПЯТЬ ПОДНОЖЕК",
    sub: "каждый оператор сужает — у каждого есть ловушка",
    rows: [
      { op: "typeof", effect: "расщепляет по тегам рантайма", gotcha: 'typeof null === "object"' },
      { op: "истинность if (v)", effect: 'убирает null, 0, "", false', gotcha: "отбрасывает и 0" },
      { op: "равенство ===/!==", effect: "сужает обе ветки", gotcha: "нужен литерал" },
      { op: "in", effect: "оставляет члены с ключом", gotcha: "структурно, не номинально" },
      { op: "instanceof", effect: "сужает по цепочке прототипов", gotcha: "подводит между realm" },
    ],
    caption:
      "Пять повседневных операторов сужения, у каждого своя подножка: typeof путает null с объектами, истинность отбрасывает 0, равенству нужен литерал, in структурный, instanceof идёт по цепочке прототипов.",
  },
};

const t = dict[lang];

const rowY = [84, 142, 200, 258, 316];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsEverydayNarrowing-row" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {rowY.map((y) => (
      <rect x="30" y={y + 14} width="4" height="20" fill="var(--accent)" />
    ))}
    {rowY.map((y) => (
      <line x1="188" y1={y + 24} x2="208" y2={y + 24} stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsEverydayNarrowing-row)" />
    ))}
    {rowY.map((y, i) => (
      <text x="48" y={y + 30} font-size="12" fill="var(--ink)">{t.rows[i].op}</text>
    ))}
    {rowY.map((y, i) => (
      <text x="222" y={y + 30} font-size="12" fill="var(--accent)">{t.rows[i].effect}</text>
    ))}
    {rowY.map((y, i) => (
      <text x="500" y={y + 30} font-size="12" fill="var(--muted)">{t.rows[i].gotcha}</text>
    ))}
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
