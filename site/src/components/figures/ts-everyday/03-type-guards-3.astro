---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "an honest array guard checks every element with every at O(n) cost while sampling x[0] is an unsound lie the checker still believes",
    headline: "EVERY, NOT A SAMPLE",
    sub: "the honest guard checks container plus all elements",
    tagHonest: "honest array guard",
    tagSample: "sampled lie",
    honestCheck: "Array.isArray + every",
    honestScope: "all elements proven",
    honestCost: "cost: O(n)",
    honestVerdict: "verdict: HONEST",
    sampleCheck: "typeof x[0] only",
    sampleScope: "empty + tails slip through",
    sampleCost: "cost: O(1) — false safety",
    sampleVerdict: "verdict: LIE, still compiles",
    foot1: "in is fragile when members share a key — prefer a tag",
    foot2: "parse once at the boundary; asserts x is T is the throwing cousin",
    caption:
      "The honest array guard checks the container and every element at O(n) cost; sampling only x[0] is a lie the checker still believes — and the same lesson holds for in guards, where a shared key stops distinguishing members.",
  },
  ru: {
    svgTitle: "честный защитник массива проверяет каждый элемент через every ценой O(n), а выборка x[0] врёт, но проверяющий всё равно верит",
    headline: "EVERY, А НЕ ВЫБОРКА",
    sub: "честный защитник проверяет контейнер и все элементы",
    tagHonest: "честный защитник массива",
    tagSample: "выборка врёт",
    honestCheck: "Array.isArray + every",
    honestScope: "доказаны все элементы",
    honestCost: "цена: O(n)",
    honestVerdict: "вердикт: ЧЕСТНО",
    sampleCheck: "только typeof x[0]",
    sampleScope: "пустые + хвосты проскочат",
    sampleCost: "цена O(1) — мнимая защита",
    sampleVerdict: "вердикт: ВРЁТ, но компилируется",
    foot1: "in хрупок при общем ключе — предпочитайте тег-дискриминант",
    foot2: "разберите один раз на границе; asserts x is T — бросающий родственник",
    caption:
      "Честный защитник массива проверяет контейнер и каждый элемент ценой O(n); выборка лишь x[0] врёт, но проверяющий всё равно верит, — и то же верно для защитников на in, где общий ключ перестаёт различать членов.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsEverydayGuards-3" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagHonest}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.honestCheck}</text>
    <text x="205" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.honestScope}</text>
    <text x="205" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.honestCost}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.honestVerdict}</text>

    <text x="595" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagSample}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sampleCheck}</text>
    <text x="595" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sampleScope}</text>
    <text x="595" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.sampleCost}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.sampleVerdict}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
