---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Exhaustiveness with assertNever: fully handled union leaves never in default and compiles; a new retrying variant makes default a real type and a compile error",
    headline: "HANDLED → NEVER, NEW VARIANT → ERROR",
    sub: "assertNever turns a forgotten case into a compile error",
    tagLeft: "3 variants handled",
    tagRight: "add a 4th variant",
    leftLine1: "assertNever(x: never): never",
    leftLine2: "default: assertNever(r)",
    leftLine3: "r: never",
    leftLine4: "→ compiles clean",
    rightLine1: '{ kind: "retrying"; attempt: number }',
    rightLine2: "default: assertNever(r)",
    rightLine3: "r: { kind: retrying; … }",
    rightLine4: "Error: not assignable to never",
    foot1: "every switch that forgot the new case lights up",
    foot2: "find-all-places becomes a guaranteed compile error",
    caption:
      "While every variant is handled the default branch narrows to never and assertNever type-checks; add an unhandled variant and the leftover becomes a real type, failing the build at every unhandled switch.",
  },
  ru: {
    svgTitle: "Исчерпание через assertNever: полностью обработанное объединение оставляет never в default и компилируется; новый вариант retrying даёт реальный тип и ошибку компиляции",
    headline: "ОБРАБОТАНО → NEVER, НОВЫЙ ВАРИАНТ → ОШИБКА",
    sub: "assertNever превращает забытый case в ошибку компиляции",
    tagLeft: "3 варианта обработаны",
    tagRight: "добавляем 4-й вариант",
    leftLine1: "assertNever(x: never): never",
    leftLine2: "default: assertNever(r)",
    leftLine3: "r: never",
    leftLine4: "→ сборка чистая",
    rightLine1: '{ kind: "retrying"; attempt: number }',
    rightLine2: "default: assertNever(r)",
    rightLine3: "r: { kind: retrying; … }",
    rightLine4: "Ошибка: не присваиваемо к never",
    foot1: "каждый switch без нового case загорается",
    foot2: "поиск мест обновления — гарантированная ошибка компиляции",
    caption:
      "Пока обработан каждый вариант, ветка default сужается до never и assertNever проходит проверку; добавь необработанный вариант — и остаток станет реальным типом, ломая сборку в каждом необработанном switch.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <g id="TsEverydayDU-3">
      <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
      <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

      <text x="210" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
      <rect x="40" y="116" width="340" height="180" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="210" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine1}</text>
      <text x="210" y="178" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine2}</text>
      <text x="210" y="206" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine3}</text>
      <text x="210" y="234" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine4}</text>

      <text x="590" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
      <rect x="420" y="116" width="340" height="180" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
      <text x="590" y="150" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine1}</text>
      <text x="590" y="178" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine2}</text>
      <text x="590" y="206" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine3}</text>
      <text x="590" y="234" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine4}</text>

      <text x="400" y="340" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
      <text x="400" y="366" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
    </g>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
