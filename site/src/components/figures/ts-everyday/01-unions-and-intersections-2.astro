---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Intersection A & B merges every member: A carries id and name, B carries id and age, and A & B guarantees all three",
    headline: "ALL-OF: EVERY MEMBER MERGED",
    sub: "A & B demands everything at construction",
    tagLeft: "A = { id; name }",
    leftLine1: "id: number",
    leftLine2: "name: string",
    tagRight: "B = { id; age }",
    rightLine1: "id: number",
    rightLine2: "age: number",
    mergeTag: "A & B reachable: id, name, age",
    mergeLine1: "id · name · age — all members",
    mergeLine2: "drop one field — the checker complains",
    caption:
      "An intersection value is both at once, so it carries every member of both sides: id, name and age are all guaranteed — and all required when you build it.",
  },
  ru: {
    svgTitle: "Пересечение A & B сливает каждый член: A несёт id и name, B несёт id и age, а A & B гарантирует все три",
    headline: "ВСЁ-СРАЗУ: КАЖДЫЙ ЧЛЕН СЛИТ",
    sub: "A & B требует всё при конструировании",
    tagLeft: "A = { id; name }",
    leftLine1: "id: number",
    leftLine2: "name: string",
    tagRight: "B = { id; age }",
    rightLine1: "id: number",
    rightLine2: "age: number",
    mergeTag: "A & B доступно: id, name, age",
    mergeLine1: "id · name · age — все члены",
    mergeLine2: "убери поле — проверяющий ругается",
    caption:
      "Значение пересечения — и то, и другое сразу, поэтому оно несёт каждый член обеих сторон: id, name и age гарантированы все — и все требуются при конструировании.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="60" y="120" width="300" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="210" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine1}</text>
    <text x="210" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine2}</text>

    <text x="590" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="440" y="120" width="300" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="590" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine1}</text>
    <text x="590" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine2}</text>

    <text x="400" y="264" text-anchor="middle" font-size="11" fill="var(--muted)">{t.mergeTag}</text>
    <rect x="180" y="280" width="440" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="310" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mergeLine1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mergeLine2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
