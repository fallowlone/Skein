---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "A typeof guard splits the flow: the true branch holds string, the false branch holds the complement, number",
    headline: "A GUARD SPLITS THE FLOW",
    sub: "x: string | number, guarded by typeof",
    unionLine1: "x: string | number",
    unionLine2: "declared type at entry",
    guardA: "typeof x",
    guardB: '=== "string"?',
    edgeTrue: "true",
    edgeFalse: "false",
    branches: [
      { tag: "true branch", typeLine: "x: string", useLine: "x.toUpperCase() — OK" },
      { tag: "false branch", typeLine: "x: number", useLine: "x.toFixed(2) — OK" },
    ],
    caption:
      "A typeof guard splits the flow: the true branch holds string, so toUpperCase is safe; the false branch holds the complement, number, so toFixed is safe.",
  },
  ru: {
    svgTitle: "Проверка typeof расщепляет поток: ветка true держит string, ветка false — дополнение, number",
    headline: "ПРОВЕРКА РАСЩЕПЛЯЕТ ПОТОК",
    sub: "x: string | number под проверкой typeof",
    unionLine1: "x: string | number",
    unionLine2: "объявленный тип на входе",
    guardA: "typeof x",
    guardB: '=== "string"?',
    edgeTrue: "true",
    edgeFalse: "false",
    branches: [
      { tag: "ветка true", typeLine: "x: string", useLine: "x.toUpperCase() — OK" },
      { tag: "ветка false", typeLine: "x: number", useLine: "x.toFixed(2) — OK" },
    ],
    caption:
      "Проверка typeof расщепляет поток: ветка true держит string, и toUpperCase безопасен; ветка false держит дополнение, number, и безопасен toFixed.",
  },
};

const t = dict[lang];

const branches = [
  { x: 65, cx: 200 },
  { x: 465, cx: 600 },
];

const splits = [
  { x1: 292, y1: 222, x2: 200, y2: 316 },
  { x1: 508, y1: 222, x2: 600, y2: 316 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <defs>
      <marker id="TsEverydayNarrowing-split" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      </marker>
    </defs>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="290" y="96" width="220" height="52" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
    <text x="400" y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.unionLine1}</text>
    <text x="400" y="139" text-anchor="middle" font-size="11" fill="var(--muted)">{t.unionLine2}</text>

    <line x1="400" y1="148" x2="400" y2="162" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsEverydayNarrowing-split)" />

    <polygon points="400,166 508,222 400,278 292,222" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="216" text-anchor="middle" font-size="13" fill="var(--ink)">{t.guardA}</text>
    <text x="400" y="238" text-anchor="middle" font-size="13" fill="var(--ink)">{t.guardB}</text>

    {splits.map((s) => (
      <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="var(--accent)" stroke-width="1.6" marker-end="url(#TsEverydayNarrowing-split)" />
    ))}
    <text x="246" y="208" text-anchor="middle" font-size="12" fill="var(--accent)">{t.edgeTrue}</text>
    <text x="554" y="208" text-anchor="middle" font-size="12" fill="var(--accent)">{t.edgeFalse}</text>

    {branches.map((b) => (
      <g>
        <rect x={b.x} y="316" width="270" height="68" fill="var(--card)" stroke="var(--muted)" stroke-width="1.6" />
      </g>
    ))}
    {branches.map((b, i) => (
      <text x={b.cx} y="344" text-anchor="middle" font-size="13" fill="var(--accent)">{t.branches[i].typeLine}</text>
    ))}
    {branches.map((b, i) => (
      <text x={b.cx} y="364" text-anchor="middle" font-size="12" fill="var(--ink)">{t.branches[i].useLine}</text>
    ))}
    <text x="120" y="294" text-anchor="middle" font-size="11" fill="var(--muted)">{t.branches[0].tag}</text>
    <text x="680" y="294" text-anchor="middle" font-size="11" fill="var(--muted)">{t.branches[1].tag}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
