---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Disjoint primitives collapse to never: string & number is never, a & b is never, and a shared key with disjoint values hides the same trap",
    headline: "DISJOINT INTERSECTIONS BECOME NEVER",
    sub: "the alias compiles silently — the error waits",
    tagLeft: "string & number",
    leftLine1: "= never",
    leftLine2: "empty type · zero values",
    tagRight: '"a" & "b"',
    rightLine1: "= never",
    rightLine2: "no value is both",
    mergeTag: "hidden trap: shared key, disjoint values",
    mergeLine1: 'status: "active" & "archived" = never',
    mergeLine2: "uninhabitable — found at construction",
    caption:
      "No value is both a string and a number, so the checker reduces the intersection to never — silently at the alias, loudly at assignment; the same collapse hides per-property when objects share a key.",
  },
  ru: {
    svgTitle: "Непересекающиеся примитивы схлопываются в never: string & number — это never, a & b — never, а общий ключ с разными значениями прячет ту же ловушку",
    headline: "БЕЗ ОБЩЕГО — ЗНАЧИТ NEVER",
    sub: "алиас компилируется молча — ошибка ждёт",
    tagLeft: "string & number",
    leftLine1: "= never",
    leftLine2: "пустой тип · ноль значений",
    tagRight: '"a" & "b"',
    rightLine1: "= never",
    rightLine2: "ничто не является обоими",
    mergeTag: "скрытая ловушка: общий ключ, разные значения",
    mergeLine1: 'status: "active" & "archived" = never',
    mergeLine2: "необитаем — вскроется при конструировании",
    caption:
      "Никакое значение не является одновременно string и number, поэтому проверяющий сводит пересечение к never — молча на алиасе, громко при присваивании; то же схлопывание прячется посвойственно, когда объекты делят ключ.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="210" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLeft}</text>
    <rect x="60" y="120" width="300" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="210" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine1}</text>
    <text x="210" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.leftLine2}</text>

    <text x="590" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagRight}</text>
    <rect x="440" y="120" width="300" height="100" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="590" y="160" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine1}</text>
    <text x="590" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.rightLine2}</text>

    <text x="400" y="264" text-anchor="middle" font-size="11" fill="var(--muted)">{t.mergeTag}</text>
    <rect x="180" y="280" width="440" height="76" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="310" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mergeLine1}</text>
    <text x="400" y="336" text-anchor="middle" font-size="12" fill="var(--ink)">{t.mergeLine2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
