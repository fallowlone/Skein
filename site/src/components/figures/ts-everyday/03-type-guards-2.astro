---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "a lying isUser guard that checks only typeof compiles cleanly, narrows to User, and crashes at runtime on the missing email",
    headline: "LYING GUARD COMPILES",
    sub: "the checker trusts is T without proof — the body must earn it",
    tagLie: "lying body",
    tagHonest: "honest body",
    lieBody: "typeof x === object only",
    lieClaim: "claims: x is User",
    lieCompile: "compiles ✓ no error",
    lieRun: "email.toLowerCase() → TypeError ✗",
    honestBody: "checks id + email + roles",
    honestClaim: "every promised field",
    honestCompile: "compiles ✓ safe",
    honestRun: "email: string at runtime ✓",
    foot1: "the predicate is a contract only you can honor",
    foot2: "a broken promise stays invisible until runtime",
    caption:
      "A lying isUser body that checks only typeof compiles with no error, narrows the caller to User, and crashes at runtime on the missing email; the honest body checks every field the predicate promises.",
  },
  ru: {
    svgTitle: "тело isUser, которое лжёт и проверяет лишь typeof, компилируется чисто, сужает до User и падает в рантайме на отсутствующем email",
    headline: "ТЕЛО ЛЖЁТ — ОШИБОК НЕТ",
    sub: "проверяющий доверяет is T без доказательства — тело должно его заслужить",
    tagLie: "тело лжёт",
    tagHonest: "честное тело",
    lieBody: "только typeof x === object",
    lieClaim: "заявляет: x is User",
    lieCompile: "компилируется ✓ без ошибок",
    lieRun: "email.toLowerCase() → TypeError ✗",
    honestBody: "проверяет id + email + roles",
    honestClaim: "каждое обещанное поле",
    honestCompile: "компилируется ✓ безопасно",
    honestRun: "email: string в рантайме ✓",
    foot1: "предикат — контракт, соблюдать который только вам",
    foot2: "нарушенное обещание невидимо до рантайма",
    caption:
      "Тело isUser, которое лжёт и проверяет лишь typeof, компилируется без ошибок, сужает вызывающего до User и падает в рантайме на отсутствующем email; честное тело проверяет каждое поле, обещанное предикатом.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsEverydayGuards-2" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagLie}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lieBody}</text>
    <text x="205" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lieClaim}</text>
    <text x="205" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.lieCompile}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.lieRun}</text>

    <text x="595" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagHonest}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.honestBody}</text>
    <text x="595" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.honestClaim}</text>
    <text x="595" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.honestCompile}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.honestRun}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
