---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "a boolean return narrows nothing while an x is string predicate narrows the true branch to string and the false branch to number",
    headline: "BOOLEAN VS PREDICATE",
    sub: "boolean narrows nothing — x is T narrows both branches",
    tagBool: "boolean",
    tagPred: "x is string",
    boolSig: "isString(v): boolean",
    boolTrue: "true → string | number",
    boolFalse: "false → string | number",
    boolFoot: "narrowing: LOST",
    predSig: "isString(v): v is string",
    predTrue: "true → string ✓",
    predFalse: "false → number ✓",
    predFoot: "narrowing: KEPT",
    foot1: "plain boolean tells the caller nothing about what true means",
    foot2: "the predicate plugs into control-flow narrowing like typeof",
    caption:
      "A boolean return narrows nothing, so the caller keeps the full union on both branches; an x is string predicate narrows the true branch to string and subtracts it on the false branch.",
  },
  ru: {
    svgTitle: "возврат boolean ничего не сужает, а предикат x is string сужает ветку true до string, а ветку false — до number",
    headline: "BOOLEAN ПРОТИВ ПРЕДИКАТА",
    sub: "boolean ничего не сужает — x is T сужает обе ветки",
    tagBool: "boolean",
    tagPred: "x is string",
    boolSig: "isString(v): boolean",
    boolTrue: "true → string | number",
    boolFalse: "false → string | number",
    boolFoot: "сужение: ПОТЕРЯНО",
    predSig: "isString(v): v is string",
    predTrue: "true → string ✓",
    predFalse: "false → number ✓",
    predFoot: "сужение: СОХРАНЕНО",
    foot1: "обычный boolean ничего не говорит, что означает true",
    foot2: "предикат встраивается в сужение, как typeof",
    caption:
      "Возврат boolean ничего не сужает, и вызывающий оставляет полное объединение в обеих ветках; предикат x is string сужает ветку true до string и вычитает его в ветке false.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg id="TsEverydayGuards-1" viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="205" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagBool}</text>
    <rect x="40" y="126" width="330" height="190" fill="var(--card)" stroke="var(--muted)" stroke-width="2" stroke-dasharray="7 5" />
    <text x="205" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boolSig}</text>
    <text x="205" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boolTrue}</text>
    <text x="205" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.boolFalse}</text>
    <text x="205" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.boolFoot}</text>

    <text x="595" y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{t.tagPred}</text>
    <rect x="430" y="126" width="330" height="190" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="595" y="162" text-anchor="middle" font-size="12" fill="var(--ink)">{t.predSig}</text>
    <text x="595" y="188" text-anchor="middle" font-size="12" fill="var(--ink)">{t.predTrue}</text>
    <text x="595" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">{t.predFalse}</text>
    <text x="595" y="272" text-anchor="middle" font-size="11" fill="var(--muted)">{t.predFoot}</text>

    <text x="400" y="356" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot1}</text>
    <text x="400" y="381" text-anchor="middle" font-size="12" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
