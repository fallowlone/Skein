---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four single-bit mask idioms applied to x = 1010",
    headline: "FOUR IDIOMS, ONE MASK",
    maskWord: "one-hot mask",
    verbs: ["test", "set", "clear", "toggle"],
    bitWord: "bit",
    note: "test returns 0 or 1 · set forces 1 · clear forces 0 · toggle flips",
    caption:
      "On x = 1010: test bit 1 gives 1; set bit 0 gives 1011; clear bit 3 gives 10; toggle bit 2 gives 1110.",
  },
  ru: {
    svgTitle: "Четыре однобитные идиомы масок на x = 1010",
    headline: "ЧЕТЫРЕ ИДИОМЫ, ОДНА МАСКА",
    maskWord: "one-hot маска",
    verbs: ["проверить", "установить", "сбросить", "переключить"],
    bitWord: "бит",
    note: "проверить даёт 0 или 1 · установить даёт 1 · сбросить даёт 0 · переключить переворачивает",
    caption:
      "На x = 1010: проверить бит 1 даёт 1; установить бит 0 даёт 1011; сбросить бит 3 даёт 10; переключить бит 2 даёт 1110.",
  },
};

const t = dict[lang];

const xVal = "x = 1010";
const maskVal = "1 << i";
const bits = ["1", "0", "1", "0"];
const positions = ["3", "2", "1", "0"];
const rows = [
  { bit: 1, hi: 2, lhs: "(x >> 1) & 1 =", rhs: "1" },
  { bit: 0, hi: 3, lhs: "x | (1 << 0) =", rhs: "1011" },
  { bit: 3, hi: 0, lhs: "x & ~(1 << 3) =", rhs: "10" },
  { bit: 2, hi: 1, lhs: "x ^ (1 << 2) =", rhs: "1110" },
];

const rowTop = (i: number) => 108 + i * 62;
const cellX = (i: number) => 190 + i * 46;
const cw = 38;
const ch = 38;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{xVal} · {t.maskWord} {maskVal}</text>

    {positions.map((p, i) => (
      <text x={cellX(i) + cw / 2} y="100" text-anchor="middle" font-size="11" fill="var(--muted)">{p}</text>
    ))}

    {rows.map((r, ri) => (
      <g>
        <text x="36" y={rowTop(ri) + 25} font-size="14" fill="var(--ink)">{t.verbs[ri]}</text>
        {bits.map((b, bi) => (
          <g>
            <rect x={cellX(bi)} y={rowTop(ri)} width={cw} height={ch} fill={bi === r.hi ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
            <text x={cellX(bi) + cw / 2} y={rowTop(ri) + 26} text-anchor="middle" font-size="15" fill={bi === r.hi ? "var(--card)" : "var(--ink)"}>{b}</text>
          </g>
        ))}
        <text x="596" y={rowTop(ri) + 25} text-anchor="end" font-size="14" fill="var(--ink)">{r.lhs}</text>
        <text x="610" y={rowTop(ri) + 25} font-size="15" fill="var(--accent)">{r.rhs}</text>
        <text x="664" y={rowTop(ri) + 25} font-size="12" fill="var(--muted)">{t.bitWord} {r.bit}</text>
      </g>
    ))}

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
