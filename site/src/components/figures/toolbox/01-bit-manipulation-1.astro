---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Six bitwise operators with bit-level examples",
    headline: "SIX OPERATORS, BIT BY BIT",
    sub: "bit i of the result depends only on bit i of the inputs",
    names: ["AND (&)", "OR (|)", "XOR (^)", "NOT (~)", "Shift left (<<)", "Shift right (>>)"],
    notResult: "flips all bits",
    note: "AND reads / clears · OR sets · XOR toggles · << multiplies by two · >> divides by two",
    caption:
      "13 is 1101. AND, OR, XOR act bit by bit: 1100 & 1010 = 1000, 1100 | 1010 = 1110, 1100 ^ 1010 = 0110. NOT flips every bit. Shifts scale: 1 << 3 = 1000 (8), 1101 >> 1 = 110 (6).",
  },
  ru: {
    svgTitle: "Шесть побитовых операторов с побитовыми примерами",
    headline: "ШЕСТЬ ОПЕРАТОРОВ, БИТ ЗА БИТОМ",
    sub: "бит i результата зависит только от бита i входов",
    names: ["AND (&)", "OR (|)", "XOR (^)", "NOT (~)", "Сдвиг влево (<<)", "Сдвиг вправо (>>)"],
    notResult: "переворачивает все биты",
    note: "AND читает / сбрасывает · OR устанавливает · XOR переключает · << умножает на два · >> делит на два",
    caption:
      "13 это 1101. AND, OR, XOR действуют побитно: 1100 & 1010 = 1000, 1100 | 1010 = 1110, 1100 ^ 1010 = 0110. NOT переворачивает каждый бит. Сдвиги масштабируют: 1 << 3 = 1000 (8), 1101 >> 1 = 110 (6).",
  },
};

const t = dict[lang];

const rows = [
  { lhs: "1100 & 1010 =", rhs: "1000" },
  { lhs: "1100 | 1010 =", rhs: "1110" },
  { lhs: "1100 ^ 1010 =", rhs: "0110" },
  { lhs: "~1100 =", rhs: null },
  { lhs: "1 << 3 =", rhs: "1000 (8)" },
  { lhs: "1101 >> 1 =", rhs: "110 (6)" },
];

const dividers = [0, 1, 2, 3, 4];
const rowY = (i: number) => 104 + i * 44;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {rows.map((r, i) => (
      <g>
        <text x="40" y={rowY(i)} font-size="14" fill="var(--ink)">{t.names[i]}</text>
        <text x="455" y={rowY(i)} text-anchor="end" font-size="15" fill="var(--ink)">{r.lhs}</text>
        {r.rhs === null ? (
          <text x="472" y={rowY(i)} font-size="13" fill="var(--muted)">{t.notResult}</text>
        ) : (
          <text x="472" y={rowY(i)} font-size="15" fill="var(--accent)">{r.rhs}</text>
        )}
      </g>
    ))}
    {dividers.map((i) => (
      <line x1="40" y1={rowY(i) + 14} x2="760" y2={rowY(i) + 14} stroke="var(--muted)" stroke-width="1" opacity="0.4" />
    ))}

    <text x="400" y="372" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
