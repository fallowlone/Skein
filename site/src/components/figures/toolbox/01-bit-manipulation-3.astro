---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Power-of-two check and Kernighan popcount trace on 13",
    headline: "ONE TRICK, TWO CLASSICS",
    sub: "subtracting 1 erases the lowest set bit",
    aTitle: "CLASSIC 1: IS n A POWER OF TWO?",
    powTrue: "power of two",
    powFalse: "not a power of two",
    bTitle: "CLASSIC 2: POPCOUNT — THREE ROUNDS",
    note: "three ones, three rounds, stop",
    caption:
      "Power of two: n & (n - 1) === 0 for n > 0, since 1000 - 1 = 0111 and 1000 & 0111 = 0. 16 = 10000 is one; 24 = 11000 is not. Popcount(13): 1101 → 1100 → 1000 → 0000, count 0 → 3.",
  },
  ru: {
    svgTitle: "Проверка степени двойки и трассировка popcount Кернигана на 13",
    headline: "ОДИН ТРЮК, ДВЕ КЛАССИКИ",
    sub: "вычитание 1 стирает младший установленный бит",
    aTitle: "КЛАССИКА 1: n — СТЕПЕНЬ ДВОЙКИ?",
    powTrue: "степень двойки",
    powFalse: "не степень двойки",
    bTitle: "КЛАССИКА 2: POPCOUNT — ТРИ КРУГА",
    note: "три единицы — три круга, стоп",
    caption:
      "Степень двойки: n & (n - 1) === 0 при n > 0, ведь 1000 - 1 = 0111 и 1000 & 0111 = 0. 16 = 10000 — да; 24 = 11000 — нет. Popcount(13): 1101 → 1100 → 1000 → 0000, count 0 → 3.",
  },
};

const t = dict[lang];

const formula = "n & (n - 1) === 0, n > 0";
const borrow = "1000 - 1 = 0111";
const andZero = "1000 & 0111 = 0";
const ex16 = "16 = 10000";
const ex24 = "24 = 11000";
const nStart = "n = 13 = 1101";
const states = ["1101", "1100", "1000", "0000"];
const counts = ["count 0", "count 1", "count 2", "count 3"];
const stepOp = "n &= n - 1";

const boxW = 120;
const boxH = 70;
const boxY = 220;
const cy = boxY + boxH / 2;
const boxX = (i: number) => 40 + i * 200;
const arrows = [
  { x1: 160, tip: 240 },
  { x1: 360, tip: 440 },
  { x1: 560, tip: 640 },
].map((a) => ({ ...a, x2: a.tip - 8, pts: `${a.tip - 8},${cy - 5} ${a.tip - 8},${cy + 5} ${a.tip},${cy}` }));
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="58" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="40" y="88" font-size="13" fill="var(--accent)">{t.aTitle}</text>
    <text x="400" y="114" text-anchor="middle" font-size="17" fill="var(--ink)">{formula}</text>
    <text x="400" y="140" text-anchor="middle" font-size="14" fill="var(--ink)">{borrow} · {andZero}</text>
    <text x="210" y="164" text-anchor="middle" font-size="13" fill="var(--ink)">{ex16} → {t.powTrue}</text>
    <text x="590" y="164" text-anchor="middle" font-size="13" fill="var(--ink)">{ex24} → {t.powFalse}</text>

    <line x1="40" y1="184" x2="760" y2="184" stroke="var(--muted)" stroke-width="1" opacity="0.4" />

    <text x="40" y="206" font-size="13" fill="var(--accent)">{t.bTitle}</text>
    <text x="760" y="206" text-anchor="end" font-size="13" fill="var(--muted)">{nStart}</text>

    {states.map((s, i) => (
      <g>
        <rect x={boxX(i)} y={boxY} width={boxW} height={boxH} fill={i === 3 ? "var(--accent)" : "var(--card)"} stroke="var(--ink)" stroke-width="2" />
        <text x={boxX(i) + boxW / 2} y={boxY + 30} text-anchor="middle" font-size="17" fill={i === 3 ? "var(--card)" : "var(--ink)"}>{s}</text>
        <text x={boxX(i) + boxW / 2} y={boxY + 54} text-anchor="middle" font-size="12" fill={i === 3 ? "var(--card)" : "var(--muted)"}>{counts[i]}</text>
      </g>
    ))}
    {arrows.map((a) => (
      <g>
        <line x1={a.x1} y1={cy} x2={a.x2} y2={cy} stroke="var(--accent)" stroke-width="2" />
        <polygon points={a.pts} fill="var(--accent)" />
        <text x={(a.x1 + a.tip) / 2} y={cy - 12} text-anchor="middle" font-size="11" fill="var(--ink)">{stepOp}</text>
      </g>
    ))}

    <text x="400" y="330" text-anchor="middle" font-size="12" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
