---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props as Props;

const dict = {
  en: {
    svgTitle: "Time budget equation: 1 to 2 seconds at 100 million ops per second gives a budget of 10^8 to 2x10^8 operations",
    headline: "BUDGET: ~10⁸ OPS PER SECOND",
    sub: "1–2 seconds per test → about 10⁸–2×10⁸ operations",
    boxATitle: "time limit",
    boxAValue: "1–2 seconds",
    boxBTitle: "per second",
    boxBValue: "~10⁸ ops",
    boxBNote: "(100 million)",
    boxCTitle: "time budget",
    boxCValue: "~10⁸–2×10⁸",
    note1: "over budget → redesign, not optimize",
    note2: "no constant factor saves 100× over",
    caption:
      "Work backwards: compute your idea's cost first — over budget means redesign, not optimize. The budget is ~10⁸ simple operations per second over a 1–2 second limit.",
  },
  ru: {
    svgTitle: "Уравнение бюджета времени: 1–2 секунды при 100 миллионах операций в секунду дают бюджет 10⁸–2×10⁸ операций",
    headline: "БЮДЖЕТ: ~10⁸ ОПЕРАЦИЙ В СЕКУНДУ",
    sub: "1–2 секунды на тест → около 10⁸–2×10⁸ операций",
    boxATitle: "time limit",
    boxAValue: "1–2 секунды",
    boxBTitle: "в секунду",
    boxBValue: "~10⁸ операций",
    boxBNote: "(100 миллионов)",
    boxCTitle: "бюджет времени",
    boxCValue: "~10⁸–2×10⁸",
    note1: "сверх бюджета → перепроектируй, а не оптимизируй",
    note2: "никакой константный множитель не спасёт стократный перелёт",
    caption:
      "Работай с конца: сначала посчитай цену идеи — сверх бюджета значит перепроектируй, а не оптимизируй. Бюджет: ~10⁸ простых операций в секунду при лимите 1–2 секунды.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="40" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="68" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <g>
      <rect x="40" y="130" width="190" height="110" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="135" y="162" text-anchor="middle" font-size="13" fill="var(--muted)">{t.boxATitle}</text>
      <text x="135" y="196" text-anchor="middle" font-size="20" fill="var(--ink)">{t.boxAValue}</text>
    </g>

    <text x="255" y="196" text-anchor="middle" font-size="28" fill="var(--muted)">×</text>

    <g>
      <rect x="280" y="130" width="190" height="110" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="375" y="158" text-anchor="middle" font-size="13" fill="var(--muted)">{t.boxBTitle}</text>
      <text x="375" y="188" text-anchor="middle" font-size="20" fill="var(--ink)">{t.boxBValue}</text>
      <text x="375" y="212" text-anchor="middle" font-size="12" fill="var(--muted)">{t.boxBNote}</text>
    </g>

    <text x="495" y="196" text-anchor="middle" font-size="28" fill="var(--muted)">=</text>

    <g>
      <rect x="520" y="130" width="240" height="110" rx="10" fill="var(--card)" stroke="var(--accent)" stroke-width="3" />
      <text x="640" y="162" text-anchor="middle" font-size="13" fill="var(--muted)">{t.boxCTitle}</text>
      <text x="640" y="196" text-anchor="middle" font-size="20" fill="var(--ink)">{t.boxCValue}</text>
    </g>

    <text x="400" y="310" text-anchor="middle" font-size="15" fill="var(--ink)">{t.note1}</text>
    <text x="400" y="348" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
