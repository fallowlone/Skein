---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props as Props;

const dict = {
  en: {
    svgTitle: "Standard table mapping input size n to feasible complexity, from n up to 10-12 allowing O(n!) down to n above 10^7 requiring O(n) or O(log n)",
    headline: "THE BOUND NAMES THE COMPLEXITY",
    sub: "the standard table that competitive programmers use",
    colN: "input size n",
    colC: "feasible complexity",
    rows: [
      { n: "n ≤ 10–12", c: "O(n!) or O(2ⁿ)" },
      { n: "n ≤ 20–25", c: "O(2ⁿ)" },
      { n: "n ≤ 500", c: "O(n³)" },
      { n: "n ≤ 5,000", c: "O(n²)" },
      { n: "n ≤ 10⁶", c: "O(n log n) or O(n)" },
      { n: "n ≥ 10⁷", c: "O(n) or O(log n)" },
    ],
    caption:
      "The constraint names the complexity you must hit: read n first. Small n (≤ 10–12) even permits brute force — O(2ⁿ) over all subsets is instant.",
  },
  ru: {
    svgTitle: "Стандартная таблица соответствия размера входа n возможной сложности: от n до 10–12 с O(n!) до n свыше 10^7 с O(n) или O(log n)",
    headline: "ГРАНИЦА НАЗЫВАЕТ СЛОЖНОСТЬ",
    sub: "стандартная таблица, которую используют соревнующиеся программисты",
    colN: "размер входа n",
    colC: "возможная сложность",
    rows: [
      { n: "n ≤ 10–12", c: "O(n!) или O(2ⁿ)" },
      { n: "n ≤ 20–25", c: "O(2ⁿ)" },
      { n: "n ≤ 500", c: "O(n³)" },
      { n: "n ≤ 5 000", c: "O(n²)" },
      { n: "n ≤ 10⁶", c: "O(n log n) или O(n)" },
      { n: "n ≥ 10⁷", c: "O(n) или O(log n)" },
    ],
    caption:
      "Ограничение называет сложность, в которую обязан попасть, — прочти n первым. Мелкий n (≤ 10–12) даже разрешает перебор: O(2ⁿ) по всем подмножествам мгновенен.",
  },
};

const t = dict[lang];
const rowTop = (i: number) => 115 + i * 44;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="185" y="100" text-anchor="middle" font-size="13" fill="var(--muted)">{t.colN}</text>
    <text x="522" y="100" text-anchor="middle" font-size="13" fill="var(--muted)">{t.colC}</text>

    {t.rows.map((r, i) => (
      <g>
        <rect
          x="70"
          y={rowTop(i)}
          width="230"
          height="38"
          rx="8"
          fill="var(--card)"
          stroke={i === 4 ? "var(--accent)" : "var(--ink)"}
          stroke-width={i === 4 ? 3 : 1.5}
        />
        <text x="185" y={rowTop(i) + 25} text-anchor="middle" font-size="15" fill="var(--ink)">{r.n}</text>
        <rect
          x="315"
          y={rowTop(i)}
          width="415"
          height="38"
          rx="8"
          fill="var(--card)"
          stroke={i === 4 ? "var(--accent)" : "var(--ink)"}
          stroke-width={i === 4 ? 3 : 1.5}
        />
        <text x="522" y={rowTop(i) + 25} text-anchor="middle" font-size="15" fill="var(--ink)">{r.c}</text>
      </g>
    ))}
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
