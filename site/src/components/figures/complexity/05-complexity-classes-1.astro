---
interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Ladder of the seven complexity classes with operation counts for n = 1,000,000",
    headline: "SEVEN CLASSES, FASTEST TO SLOWEST",
    sub: "the full spectrum, ordered from least cost to most cost",
    classHeader: "Class",
    opsHeader: "ops · n = 1,000,000",
    fastest: "fastest",
    slowest: "slowest",
    ops: ["1", "20", "1,000,000", "20,000,000", "1 trillion", "2^1,000,000", "1,000,000!"],
    note: "each rung up is a new universe of cost",
    caption:
      "Seven classes form one ladder, from O(1) at 1 operation to O(n!) at 1,000,000! — pick the rung your input size can actually climb.",
  },
  ru: {
    svgTitle: "Лестница семи классов сложности с числом операций для n = 1 000 000",
    headline: "СЕМЬ КЛАССОВ: ОТ БЫСТРОГО К МЕДЛЕННОМУ",
    sub: "весь спектр, от наименьшей цены к наибольшей",
    classHeader: "Класс",
    opsHeader: "операций · n = 1 000 000",
    fastest: "самый быстрый",
    slowest: "самый медленный",
    ops: ["1", "20", "1 000 000", "20 000 000", "1 триллион", "2^1 000 000", "1 000 000!"],
    note: "каждая ступень вверх — новая вселенная цены",
    caption:
      "Семь классов — одна лестница, от O(1) с 1 операцией до O(n!) с 1 000 000! — сопоставь размер входа со ступенью, на которую реально взобраться.",
  },
};

const t = dict[lang];

const classes = ["O(1)", "O(log n)", "O(n)", "O(n log n)", "O(n²)", "O(2ⁿ)", "O(n!)"];
const rowY = [96, 133, 170, 207, 244, 281, 318];
const rowH = 30;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <text x="172" y="88" font-size="12" fill="var(--muted)">{t.classHeader}</text>
    <text x="628" y="88" text-anchor="end" font-size="12" fill="var(--muted)">{t.opsHeader}</text>

    <line x1="118" y1="122" x2="118" y2="318" stroke="var(--muted)" stroke-width="2" />
    <polygon points="118,330 111,317 125,317" fill="var(--muted)" />
    <text x="140" y="112" text-anchor="end" font-size="12" fill="var(--muted)">{t.fastest}</text>
    <text x="140" y="340" text-anchor="end" font-size="12" fill="var(--muted)">{t.slowest}</text>

    {rowY.map((y, i) => (
      <g>
        <rect x="150" y={y} width="500" height={rowH} rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="172" y={y + 21} font-size="15" fill="var(--ink)">{classes[i]}</text>
        <text x="628" y={y + 20} text-anchor="end" font-size="14" fill="var(--ink)">{t.ops[i]}</text>
      </g>
    ))}

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
