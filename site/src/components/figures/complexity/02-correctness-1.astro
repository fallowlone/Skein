---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Tested inputs versus untested edge cases where bugs hide",
    headline: "TESTED A FEW ≠ CORRECT FOR ALL",
    sub: "correctness means the right output for every valid input",
    leftTitle: "tested ✓",
    leftRows: [
      "[3, 9, 2, 7] → 9",
      "[1] → 1",
      "[-5, -1, -10] → -1",
      "[5, 5, 5, 5] → 5",
    ],
    leftNote: "all pass — but this is not proof",
    rightTitle: "where bugs hide ✗",
    rightRows: ["empty list → crashes", "single element", "all-equal values"],
    rightNote: "untested edge cases",
    note: "testing reveals bugs — it cannot prove correctness",
    caption:
      "Tests find bugs — proof gives certainty. A hundred passing tests still miss the input you never tried; one invariant covers every valid input at once.",
  },
  ru: {
    svgTitle: "Проверенные входы и непроверенные граничные случаи, где скрываются ошибки",
    headline: "ПРОВЕРИЛ НЕСКОЛЬКО ≠ ПРАВИЛЬНО ДЛЯ ВСЕХ",
    sub: "корректность — правильный результат для каждого действительного входа",
    leftTitle: "проверено ✓",
    leftRows: [
      "[3, 9, 2, 7] → 9",
      "[1] → 1",
      "[-5, -1, -10] → -1",
      "[5, 5, 5, 5] → 5",
    ],
    leftNote: "всё проходит — но это не доказательство",
    rightTitle: "где скрываются баги ✗",
    rightRows: ["пустой список → падает", "один элемент", "все равные значения"],
    rightNote: "непроверенные граничные случаи",
    note: "тестирование находит ошибки — но не доказывает корректность",
    caption:
      "Тесты находят баги — доказательство даёт уверенность. Сто зелёных тестов всё равно пропускают вход, который ты не пробовал; один инвариант покрывает сразу каждый допустимый вход.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="95" width="340" height="235" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="127" text-anchor="middle" font-size="15" fill="var(--ink)">{t.leftTitle}</text>
    {t.leftRows.map((row, i) => (
      <text x="210" y={160 + i * 30} text-anchor="middle" font-size="15" fill="var(--ink)">{row}</text>
    ))}
    <text x="210" y="308" text-anchor="middle" font-size="13" fill="var(--muted)">{t.leftNote}</text>

    <rect x="420" y="95" width="340" height="235" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="127" text-anchor="middle" font-size="15" fill="var(--ink)">{t.rightTitle}</text>
    {t.rightRows.map((row, i) => (
      <text x="590" y={175 + i * 34} text-anchor="middle" font-size="15" fill="var(--ink)">{row}</text>
    ))}
    <text x="590" y="308" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rightNote}</text>

    <text x="400" y="380" text-anchor="middle" font-size="13" fill="var(--accent)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
