---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" }: Props = Astro.props;

const dict = {
  en: {
    svgTitle: "Derive Big-O by counting loops: getFirst is O(1), sumAll is O(n), allPairs is O(n squared)",
    headline: "COUNT THE LOOPS",
    sub: "single loop → O(n) · nested loops → O(n²) · no loop → O(1)",
    b1Name: "getFirst",
    b1Shape: "no loop",
    b1Detail: "1 op · array access",
    b1Badge: "O(1)",
    b2Name: "sumAll",
    b2Shape: "single loop",
    b2Detail: "runs exactly n times",
    b2Badge: "O(n)",
    b3Name: "allPairs",
    b3Shape: "nested loops",
    b3Detail: "n × n = n² iterations",
    b3Badge: "O(n²)",
    foot1: "upper bound = worst case: findIndex with the target missing runs all n times → O(n)",
    foot2: "Big-O promises it never grows faster than this",
    caption:
      "To find the Big-O of code, count the loops: no loop is O(1), a single loop over n items is O(n), nested loops are O(n²). Big-O is an upper bound — best case may be kinder, but the bound plans for the worst.",
  },
  ru: {
    svgTitle: "Выведи Big-O, подсчитав циклы: getFirst это O(1), sumAll это O(n), allPairs это O(n в квадрате)",
    headline: "ПОДСЧИТАЙ ЦИКЛЫ",
    sub: "один цикл → O(n) · вложенные → O(n²) · без циклов → O(1)",
    b1Name: "getFirst",
    b1Shape: "без цикла",
    b1Detail: "1 op · доступ к массиву",
    b1Badge: "O(1)",
    b2Name: "sumAll",
    b2Shape: "один цикл",
    b2Detail: "выполняется ровно n раз",
    b2Badge: "O(n)",
    b3Name: "allPairs",
    b3Shape: "вложенные циклы",
    b3Detail: "n × n = n² итераций",
    b3Badge: "O(n²)",
    foot1: "верхняя граница = худший случай: цели нет — цикл идёт все n раз → O(n)",
    foot2: "Big-O обещает: быстрее этого не вырастет",
    caption:
      "Чтобы найти Big-O кода, подсчитай циклы: без циклов — O(1), один цикл над n элементами — O(n), вложенные циклы — O(n²). Big-O — верхняя граница: лучший случай может быть добрее, но граница готовится к худшему.",
  },
};

const t = dict[lang];

const boxes = [
  { x: 28, name: t.b1Name, shape: t.b1Shape, detail: t.b1Detail, badge: t.b1Badge },
  { x: 284, name: t.b2Name, shape: t.b2Shape, detail: t.b2Detail, badge: t.b2Badge },
  { x: 540, name: t.b3Name, shape: t.b3Shape, detail: t.b3Detail, badge: t.b3Badge },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {boxes.map((b) => (
      <g>
        <rect x={b.x} y="90" width="232" height="200" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={b.x + 116} y="124" text-anchor="middle" font-size="17" fill="var(--ink)">{b.name}</text>
        <text x={b.x + 116} y="150" text-anchor="middle" font-size="13" fill="var(--muted)">{b.shape}</text>
        <text x={b.x + 116} y="176" text-anchor="middle" font-size="13" fill="var(--muted)">{b.detail}</text>
        <text x={b.x + 116} y="248" text-anchor="middle" font-family="var(--font-display)" font-size="34" fill="var(--accent)">{b.badge}</text>
      </g>
    ))}

    <text x="400" y="335" text-anchor="middle" font-size="13" fill="var(--ink)">{t.foot1}</text>
    <text x="400" y="368" text-anchor="middle" font-size="13" fill="var(--muted)">{t.foot2}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
