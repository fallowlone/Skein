---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" }: Props = Astro.props;

const dict = {
  en: {
    svgTitle: "Growth shapes: O(1) flat, O(n) line, O(n squared) curve",
    headline: "O(1) FLAT · O(n) LINE · O(n²) CURVE",
    sub: "cost vs input size n",
    o1: "O(1)",
    o1Fact: "flat — never changes",
    o1Fn: "getFirst · 1 op · any n",
    on: "O(n)",
    onFact: "double n, double the cost",
    onFn: "sumAll · n ops",
    on2: "O(n²)",
    on2Fact: "double n, quadruple the cost",
    on2Fn: "allPairs · n² ops",
    note: "shape is the verdict — drop constants, keep the dominant term",
    caption:
      "Big-O names the shape of growth: O(1) stays flat no matter how big n is, O(n) climbs as a straight line, O(n²) shoots up as a curve. Constants fade; the dominant term rules.",
  },
  ru: {
    svgTitle: "Формы роста: O(1) плоско, O(n) линия, O(n в квадрате) кривая",
    headline: "O(1) ПЛОСКО · O(n) ЛИНИЯ · O(n²) КРИВАЯ",
    sub: "цена против размера входа n",
    o1: "O(1)",
    o1Fact: "плоская — никогда не меняется",
    o1Fn: "getFirst · 1 op · any n",
    on: "O(n)",
    onFact: "удвой n, удвой цену",
    onFn: "sumAll · n ops",
    on2: "O(n²)",
    on2Fact: "удвой n, учетвери цену",
    on2Fn: "allPairs · n² ops",
    note: "форма решает — отбрось остальное, оставь главный член",
    caption:
      "Big-O называет форму роста: O(1) остаётся плоской, как бы ни росло n, O(n) идёт прямой линией, O(n²) взлетает кривой. Константы тают; главный член правит.",
  },
};

const t = dict[lang];

const rows = [
  { o: t.o1, fact: t.o1Fact, fn: t.o1Fn, y: 135 },
  { o: t.on, fact: t.onFact, fn: t.onFn, y: 230 },
  { o: t.on2, fact: t.on2Fact, fn: t.on2Fn, y: 325 },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {rows.map((r) => (
      <g>
        <rect x="40" y={r.y - 32} width="120" height="64" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="100" y={r.y + 8} text-anchor="middle" font-family="var(--font-display)" font-size="20" fill="var(--ink)">{r.o}</text>
        <text x="420" y={r.y - 2} font-size="15" fill="var(--ink)">{r.fact}</text>
        <text x="420" y={r.y + 22} font-size="13" fill="var(--muted)">{r.fn}</text>
      </g>
    ))}

    {/* O(1): flat line */}
    <g>
      <line x1="190" y1="103" x2="190" y2="167" stroke="var(--muted)" stroke-width="1.5" />
      <line x1="190" y1="163" x2="390" y2="163" stroke="var(--muted)" stroke-width="1.5" />
      <line x1="196" y1="135" x2="384" y2="135" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" />
    </g>
    {/* O(n): straight diagonal */}
    <g>
      <line x1="190" y1="198" x2="190" y2="262" stroke="var(--muted)" stroke-width="1.5" />
      <line x1="190" y1="258" x2="390" y2="258" stroke="var(--muted)" stroke-width="1.5" />
      <line x1="196" y1="254" x2="384" y2="206" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" />
    </g>
    {/* O(n^2): curve that shoots up */}
    <g>
      <line x1="190" y1="293" x2="190" y2="357" stroke="var(--muted)" stroke-width="1.5" />
      <line x1="190" y1="353" x2="390" y2="353" stroke="var(--muted)" stroke-width="1.5" />
      <path d="M 196 349 Q 360 345 384 301" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" />
    </g>

    <text x="400" y="398" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
