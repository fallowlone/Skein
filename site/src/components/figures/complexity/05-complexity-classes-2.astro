---
interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The practical line: four classes fast at scale, three classes only for small n",
    headline: "THE PRACTICAL LINE",
    sub: "above the line: fast at scale · below: small n only",
    fastLabel: "fast at scale — use these",
    fast: ["O(1)", "O(log n)", "O(n)", "O(n log n)"],
    divider: "between O(n log n) and O(n²)",
    slow: [
      { cls: "O(n²)", who: "only for small inputs", limit: "n ≤ a few thousand" },
      { cls: "O(2ⁿ)", who: "only for tiny inputs", limit: "n ≤ ~30" },
      { cls: "O(n!)", who: "only for very tiny inputs", limit: "n ≤ ~10" },
    ],
    note: "a million items → O(1), O(log n), O(n), or O(n log n)",
    caption:
      "O(1), O(log n), O(n), O(n log n) stay fast at scale; everything above O(n log n) needs a small n to survive.",
  },
  ru: {
    svgTitle: "Граница практичного: четыре класса быстры на масштабе, три — только на мелком n",
    headline: "ГРАНИЦА ПРАКТИЧНОГО",
    sub: "выше линии: быстры на масштабе · ниже: только мелкий n",
    fastLabel: "быстры на масштабе — используй эти",
    fast: ["O(1)", "O(log n)", "O(n)", "O(n log n)"],
    divider: "между O(n log n) и O(n²)",
    slow: [
      { cls: "O(n²)", who: "только для малых входов", limit: "n ≤ несколько тысяч" },
      { cls: "O(2ⁿ)", who: "только для крошечных входов", limit: "n ≤ ~30" },
      { cls: "O(n!)", who: "только для очень крошечных входов", limit: "n ≤ ~10" },
    ],
    note: "миллион элементов → O(1), O(log n), O(n) или O(n log n)",
    caption:
      "O(1), O(log n), O(n), O(n log n) быстры на масштабе; всё выше O(n log n) выживает только на мелком n.",
  },
};

const t = dict[lang];

const pillX = [88, 248, 408, 568];
const slowY = [262, 296, 330];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="70" y="78" width="660" height="112" rx="8" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
    <text x="400" y="103" text-anchor="middle" font-size="13" fill="var(--ink)">{t.fastLabel}</text>
    {pillX.map((x, i) => (
      <g>
        <rect x={x} y="114" width="145" height="56" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={x + 72} y="148" text-anchor="middle" font-size="15" fill="var(--ink)">{t.fast[i]}</text>
      </g>
    ))}

    <line x1="70" y1="215" x2="288" y2="215" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 5" />
    <line x1="512" y1="215" x2="730" y2="215" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 5" />
    <rect x="288" y="203" width="224" height="24" rx="12" fill="var(--card)" stroke="var(--muted)" stroke-width="1.5" />
    <text x="400" y="220" text-anchor="middle" font-size="12" fill="var(--muted)">{t.divider}</text>

    <rect x="70" y="232" width="660" height="118" rx="8" fill="var(--card)" stroke="var(--muted)" stroke-width="2" />
    {slowY.map((y, i) => (
      <g>
        <text x="100" y={y} font-size="14" fill="var(--ink)">{t.slow[i].cls}</text>
        <text x="290" y={y} font-size="12" fill="var(--muted)">{t.slow[i].who}</text>
        <text x="700" y={y} text-anchor="end" font-size="13" fill="var(--ink)">{t.slow[i].limit}</text>
      </g>
    ))}

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
