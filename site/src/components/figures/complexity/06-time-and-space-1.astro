---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Bar comparison of duplicate finding: nested loops versus set",
    headline: "SAME ANSWER, DIFFERENT BILL",
    sub: "duplicate check, two ways",
    leftTitle: "nested loops",
    rightTitle: "set of seen values",
    time: "time",
    space: "space",
    loopTime: "O(n²)",
    loopSpace: "O(1)",
    setTime: "O(n)",
    setSpace: "O(n)",
    leftNote: "two variables: i and j",
    rightNote: "up to n stored values",
    leftVerdict: "slow + thrifty",
    rightVerdict: "fast + hungry",
    note: "spend O(n) memory to save O(n²) time",
    caption:
      "The tradeoff: nested loops cost O(n²) time but only O(1) space (two variables, i and j), while the set costs O(n) time and O(n) space (up to n stored values). Same answer, different bill — memory buys speed.",
  },
  ru: {
    svgTitle: "Сравнение поиска дубликата столбцами: вложенные циклы и множество",
    headline: "ОТВЕТ ОДИН, СЧЁТ РАЗНЫЙ",
    sub: "дубликат двумя путями",
    leftTitle: "вложенные циклы",
    rightTitle: "множество виденных",
    time: "время",
    space: "память",
    loopTime: "O(n²)",
    loopSpace: "O(1)",
    setTime: "O(n)",
    setSpace: "O(n)",
    leftNote: "две переменные: i и j",
    rightNote: "до n хранимых значений",
    leftVerdict: "медленно + бережливо",
    rightVerdict: "быстро + прожорливо",
    note: "потратить O(n) памяти, чтобы сэкономить O(n²) времени",
    caption:
      "Компромисс: вложенные циклы стоят O(n²) времени, но лишь O(1) памяти (две переменные, i и j), а множество стоит O(n) времени и O(n) памяти (до n хранимых значений). Ответ один, счёт разный — память покупает скорость.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="80" width="310" height="252" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x="430" y="80" width="310" height="252" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />

    <text x="215" y="106" text-anchor="middle" font-size="14" fill="var(--ink)">{t.leftTitle}</text>
    <text x="585" y="106" text-anchor="middle" font-size="14" fill="var(--ink)">{t.rightTitle}</text>

    <!-- Nested loops: towering time, stub space -->
    <rect x="128" y="132" width="64" height="156" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="160" y="124" text-anchor="middle" font-size="14" fill="var(--ink)">{t.loopTime}</text>
    <rect x="224" y="270" width="64" height="18" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="256" y="262" text-anchor="middle" font-size="14" fill="var(--ink)">{t.loopSpace}</text>
    <line x1="112" y1="288" x2="318" y2="288" stroke="var(--ink)" stroke-width="2" />
    <text x="160" y="306" text-anchor="middle" font-size="12" fill="var(--muted)">{t.time}</text>
    <text x="256" y="306" text-anchor="middle" font-size="12" fill="var(--muted)">{t.space}</text>
    <text x="215" y="324" text-anchor="middle" font-size="12" fill="var(--muted)">{t.leftNote}</text>

    <!-- Set: short time, tall space -->
    <rect x="498" y="228" width="64" height="60" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
    <text x="530" y="220" text-anchor="middle" font-size="14" fill="var(--ink)">{t.setTime}</text>
    <rect x="594" y="178" width="64" height="110" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="626" y="170" text-anchor="middle" font-size="14" fill="var(--ink)">{t.setSpace}</text>
    <line x1="482" y1="288" x2="688" y2="288" stroke="var(--ink)" stroke-width="2" />
    <text x="530" y="306" text-anchor="middle" font-size="12" fill="var(--muted)">{t.time}</text>
    <text x="626" y="306" text-anchor="middle" font-size="12" fill="var(--muted)">{t.space}</text>
    <text x="585" y="324" text-anchor="middle" font-size="12" fill="var(--muted)">{t.rightNote}</text>

    <text x="215" y="358" text-anchor="middle" font-size="14" fill="var(--ink)">{t.leftVerdict}</text>
    <text x="585" y="358" text-anchor="middle" font-size="14" fill="var(--ink)">{t.rightVerdict}</text>
    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
