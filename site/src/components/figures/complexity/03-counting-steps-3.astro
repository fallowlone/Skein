---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Growth table: largestOf steps 9, 19, 99, 199 versus pair steps 45, 190, 4950, 19900",
    headline: "DOUBLE n: DOUBLE OR QUADRUPLE THE COST",
    sub: "step count as a function of n",
    headN: "Input size n",
    headSingle: "largestOf steps",
    headNested: "countEqualPairs steps",
    rows: [
      ["10", "9", "45"],
      ["20", "19", "190"],
      ["100", "99", "4,950"],
      ["200", "199", "19,900"],
    ],
    linear: "n: 10 → 100 · largestOf: 9 → 99 (10×)",
    nested: "n: 10 → 100 · countEqualPairs: 45 → 4,950 (110×)",
    note: "quadratic pulls away: 10× vs 110×",
    caption:
      "Takeaway: count the basic ops as a function of n. A single loop grows with n (9 → 99, 10×); nested loops grow with n × n (45 → 4,950, 110×). Growth rate beats exact counts.",
  },
  ru: {
    svgTitle: "Таблица роста: шаги largestOf 9, 19, 99, 199 против шагов пар 45, 190, 4 950, 19 900",
    headline: "УДВОИЛ n: УДВОИЛ ИЛИ УЧЕТВЕРИЛ ЦЕНУ",
    sub: "число шагов как функция от n",
    headN: "Размер входа n",
    headSingle: "шаги largestOf",
    headNested: "шаги countEqualPairs",
    rows: [
      ["10", "9", "45"],
      ["20", "19", "190"],
      ["100", "99", "4 950"],
      ["200", "199", "19 900"],
    ],
    linear: "n: 10 → 100 · largestOf: 9 → 99 (10×)",
    nested: "n: 10 → 100 · countEqualPairs: 45 → 4 950 (110×)",
    note: "n*n уходит в отрыв: 10× против 110×",
    caption:
      "Вывод: считай базовые операции как функцию от n. Один цикл растёт с n (9 → 99, 10×); вложенные — с n на n (45 → 4 950, 110×). Скорость роста важнее точных чисел.",
  },
};

const t = dict[lang];

const colX = [200, 400, 600];
const rowY = [162, 202, 242, 282];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="110" y="222" width="580" height="34" fill="var(--card)" />

    <text x={colX[0]} y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.headN}</text>
    <text x={colX[1]} y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.headSingle}</text>
    <text x={colX[2]} y="118" text-anchor="middle" font-size="13" fill="var(--ink)">{t.headNested}</text>
    <line x1="110" y1="132" x2="690" y2="132" stroke="var(--muted)" stroke-width="1" />

    {rowY.map((y, r) => (
      <g>
        <text x={colX[0]} y={y} text-anchor="middle" font-size="15" fill="var(--ink)">{t.rows[r][0]}</text>
        <text x={colX[1]} y={y} text-anchor="middle" font-size="15" fill="var(--ink)">{t.rows[r][1]}</text>
        <text x={colX[2]} y={y} text-anchor="middle" font-size="15" fill="var(--accent)">{t.rows[r][2]}</text>
      </g>
    ))}
    <line x1="110" y1="300" x2="690" y2="300" stroke="var(--muted)" stroke-width="1" />

    <text x="400" y="332" text-anchor="middle" font-size="14" fill="var(--ink)">{t.linear}</text>
    <text x="400" y="360" text-anchor="middle" font-size="14" fill="var(--ink)">{t.nested}</text>
    <text x="400" y="394" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
