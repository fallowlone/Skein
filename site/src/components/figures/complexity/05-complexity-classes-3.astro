---
interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "At n = 100, O(n squared) is 10,000 but O(2 to the n) is 2^100, about 10^30",
    headline: "NEVER CONFUSE O(n²) WITH O(2ⁿ)",
    sub: "at n = 100: ten thousand vs a thirty-digit monster",
    leftCls: "O(n²)",
    leftKind: "quadratic time",
    leftValue: "10,000",
    leftWords: "ten thousand",
    rightCls: "O(2ⁿ)",
    rightKind: "exponential time",
    rightValue: "2^100 ≈ 10^30",
    rightWords: "thirty-digit monster",
    note: "quadratic hurts; exponential is a different planet",
    caption:
      "At n = 100, O(n²) is 10,000 but O(2ⁿ) is 2^100 ≈ 10^30 — quadratic hurts, exponential is a different planet.",
  },
  ru: {
    svgTitle: "При n = 100 O(n в квадрате) это 10 000, а O(2 в степени n) это 2^100, примерно 10^30",
    headline: "НЕ ПУТАЙ O(n²) С O(2ⁿ)",
    sub: "при n = 100: десять тысяч против тридцатизначного монстра",
    leftCls: "O(n²)",
    leftKind: "квадратичное время",
    leftValue: "10 000",
    leftWords: "десять тысяч",
    rightCls: "O(2ⁿ)",
    rightKind: "экспоненциальное время",
    rightValue: "2^100 ≈ 10^30",
    rightWords: "тридцатизначный монстр",
    note: "квадратичное болит; экспоненциальное — другая планета",
    caption:
      "При n = 100 O(n²) — это 10 000, а O(2ⁿ) — это 2^100 ≈ 10^30: квадратичное болит, экспоненциальное — другая планета.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <rect x="60" y="88" width="320" height="216" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="220" y="126" text-anchor="middle" font-size="22" fill="var(--ink)">{t.leftCls}</text>
    <text x="220" y="150" text-anchor="middle" font-size="13" fill="var(--muted)">{t.leftKind}</text>
    <text x="220" y="198" text-anchor="middle" font-family="var(--font-display)" font-size="30" fill="var(--ink)">{t.leftValue}</text>
    <text x="220" y="224" text-anchor="middle" font-size="13" fill="var(--muted)">{t.leftWords}</text>
    <line x1="90" y1="276" x2="350" y2="276" stroke="var(--muted)" stroke-width="1.5" />
    <rect x="90" y="248" width="60" height="26" fill="var(--accent)" />

    <rect x="420" y="88" width="320" height="216" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="580" y="126" text-anchor="middle" font-size="22" fill="var(--ink)">{t.rightCls}</text>
    <text x="580" y="150" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rightKind}</text>
    <text x="580" y="198" text-anchor="middle" font-family="var(--font-display)" font-size="30" fill="var(--ink)">{t.rightValue}</text>
    <text x="580" y="224" text-anchor="middle" font-size="13" fill="var(--muted)">{t.rightWords}</text>
    <line x1="450" y1="276" x2="710" y2="276" stroke="var(--muted)" stroke-width="1.5" />
    <rect x="450" y="248" width="260" height="26" fill="var(--accent)" />

    <text x="400" y="348" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
