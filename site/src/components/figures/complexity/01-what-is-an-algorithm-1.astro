---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Pipeline: input list 3, 9, 2, 7 through finite steps to output 9",
    headline: "INPUT IN, ANSWER OUT",
    sub: "a recipe the machine can follow",
    inTitle: "INPUT",
    inList: "[3, 9, 2, 7]",
    inNote: "list of numbers",
    stepsTitle: "STEPS",
    stepsLine1: "finite · no guessing",
    stepsLine2: "compare · keep bigger",
    outTitle: "OUTPUT",
    outVal: "9",
    outNote: "exact answer",
    badge1: "input defined",
    badge2: "steps finite",
    badge3: "output exact",
    src: "largestOf on [3, 9, 2, 7]",
    caption:
      "Takeaway: input plus finite unambiguous steps equals an algorithm — a defined list in, an exact answer out.",
  },
  ru: {
    svgTitle: "Конвейер: входной список 3, 9, 2, 7 через конечные шаги к выходу 9",
    headline: "ВХОД ВНУТРЬ, ОТВЕТ НАРУЖУ",
    sub: "рецепт, которому может следовать машина",
    inTitle: "ВХОД",
    inList: "[3, 9, 2, 7]",
    inNote: "список чисел",
    stepsTitle: "ШАГИ",
    stepsLine1: "конечные · без догадок",
    stepsLine2: "сравни · оставь большее",
    outTitle: "ВЫХОД",
    outVal: "9",
    outNote: "точный ответ",
    badge1: "вход задан",
    badge2: "шаги конечны",
    badge3: "выход точен",
    src: "largestOf на [3, 9, 2, 7]",
    caption:
      "Вывод: вход плюс конечные однозначные шаги равно алгоритм — заданный список внутрь, точный ответ наружу.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <g>
      <rect x="55" y="120" width="195" height="130" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="152" y="152" text-anchor="middle" font-family="var(--font-display)" font-size="15" fill="var(--ink)">{t.inTitle}</text>
      <text x="152" y="188" text-anchor="middle" font-size="18" fill="var(--ink)">{t.inList}</text>
      <text x="152" y="218" text-anchor="middle" font-size="13" fill="var(--muted)">{t.inNote}</text>
    </g>

    <g>
      <line x1="250" y1="185" x2="296" y2="185" stroke="var(--ink)" stroke-width="2" />
      <polygon points="296,177 310,185 296,193" fill="var(--ink)" />
    </g>

    <g>
      <rect x="310" y="120" width="180" height="130" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="400" y="152" text-anchor="middle" font-family="var(--font-display)" font-size="15" fill="var(--ink)">{t.stepsTitle}</text>
      <text x="400" y="186" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stepsLine1}</text>
      <text x="400" y="210" text-anchor="middle" font-size="12" fill="var(--ink)">{t.stepsLine2}</text>
    </g>

    <g>
      <line x1="490" y1="185" x2="536" y2="185" stroke="var(--ink)" stroke-width="2" />
      <polygon points="536,177 550,185 536,193" fill="var(--ink)" />
    </g>

    <g>
      <rect x="550" y="120" width="195" height="130" rx="10" fill="var(--card)" stroke="var(--accent)" stroke-width="2" />
      <text x="647" y="152" text-anchor="middle" font-family="var(--font-display)" font-size="15" fill="var(--ink)">{t.outTitle}</text>
      <text x="647" y="192" text-anchor="middle" font-size="26" fill="var(--ink)">{t.outVal}</text>
      <text x="647" y="218" text-anchor="middle" font-size="13" fill="var(--muted)">{t.outNote}</text>
    </g>

    <g font-size="13" fill="var(--ink)">
      <rect x="60" y="296" width="180" height="38" rx="19" fill="none" stroke="var(--ink)" stroke-width="2" />
      <text x="150" y="320" text-anchor="middle">{t.badge1}</text>
      <rect x="310" y="296" width="180" height="38" rx="19" fill="none" stroke="var(--ink)" stroke-width="2" />
      <text x="400" y="320" text-anchor="middle">{t.badge2}</text>
      <rect x="560" y="296" width="180" height="38" rx="19" fill="none" stroke="var(--ink)" stroke-width="2" />
      <text x="650" y="320" text-anchor="middle">{t.badge3}</text>
    </g>

    <text x="400" y="386" text-anchor="middle" font-size="13" fill="var(--muted)">{t.src}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
