---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Step cost: largestOf takes n minus 1 comparisons, O of n, versus n by n, O of n squared",
    headline: "COST = NUMBER OF STEPS",
    sub: "the algorithm visits each of the n numbers exactly once",
    leftTitle: "largestOf · O(n)",
    leftRows: ["n = 4 → 3 compares", "n = 100 → 99 compares", "n → n − 1 compares"],
    leftFoot: "O(n) time",
    rightTitle: "every number vs every other",
    rightRows: ["n × n comparisons", "O(n²) time", "much worse for large lists"],
    note: "if the list doubles, the steps roughly double",
    caption:
      "Finite — it always ends: the loop visits each item once, then stops. n items, n − 1 compares, halt.",
  },
  ru: {
    svgTitle: "Стоимость в шагах: largestOf делает n минус 1 сравнений, O от n, против n на n, O от n квадрат",
    headline: "СТОИМОСТЬ = ЧИСЛО ШАГОВ",
    sub: "алгоритм посещает каждое из n чисел ровно один раз",
    leftTitle: "largestOf · O(n)",
    leftRows: ["n = 4 → 3 сравнения", "n = 100 → 99 сравнений", "n → n − 1 сравнений"],
    leftFoot: "O(n) время",
    rightTitle: "каждое число со всеми остальными",
    rightRows: ["n × n сравнений", "O(n²) время", "намного хуже для больших списков"],
    note: "если список удвоится, число шагов примерно удвоится",
    caption:
      "Конечен — всегда завершается: цикл посещает каждый элемент один раз, затем останавливается. n элементов, n − 1 сравнений, стоп.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <g>
      <rect x="55" y="110" width="330" height="200" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="220" y="142" text-anchor="middle" font-family="var(--font-display)" font-size="15" fill="var(--ink)">{t.leftTitle}</text>
      {t.leftRows.map((row, i) => (
        <text x="220" y={176 + i * 34} text-anchor="middle" font-size="14" fill="var(--ink)">{row}</text>
      ))}
      <text x="220" y="288" text-anchor="middle" font-size="14" fill="var(--muted)">{t.leftFoot}</text>
    </g>

    <g>
      <rect x="415" y="110" width="330" height="200" rx="10" fill="none" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 5" />
      <text x="580" y="142" text-anchor="middle" font-family="var(--font-display)" font-size="15" fill="var(--muted)">{t.rightTitle}</text>
      {t.rightRows.map((row, i) => (
        <text x="580" y={184 + i * 38} text-anchor="middle" font-size="14" fill="var(--muted)">{row}</text>
      ))}
    </g>

    <text x="400" y="366" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
