---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "One scan of largestOf over 3, 9, 2, 7: start with 3, return 9",
    headline: "ONE SCAN: START WITH 3, RETURN 9",
    sub: "compare each · keep the bigger · move on",
    above: ["start: 3", "9 > 3 → 9", "2 < 9 · skip", "7 < 9 · skip"],
    largest: "largest = 3 → 9 → 9 → 9",
    ret: "return 9",
    note: "same input, same output, every time",
    caption:
      "Unambiguous — no judgment calls: compare, keep the bigger, move on. Every step is exact, so a human and a machine reach the same 9.",
  },
  ru: {
    svgTitle: "Один скан largestOf по 3, 9, 2, 7: начни с 3, верни 9",
    headline: "ОДИН СКАН: НАЧНИ С 3, ВЕРНИ 9",
    sub: "сравни каждое · оставь большее · иди дальше",
    above: ["начало: 3", "9 > 3 → 9", "2<9 · пропусти", "7<9 · пропусти"],
    largest: "largest = 3 → 9 → 9 → 9",
    ret: "верни 9",
    note: "тот же вход — тот же выход, всегда",
    caption:
      "Однозначен — без решений на глаз: сравни, оставь большее, иди дальше. Каждый шаг точен, поэтому человек и машина приходят к тем же 9.",
  },
};

const t = dict[lang];

const cells = [
  { v: "3", x: 164, hi: false },
  { v: "9", x: 288, hi: true },
  { v: "2", x: 412, hi: false },
  { v: "7", x: 536, hi: false },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {cells.map((c, i) => (
      <g>
        <text x={c.x + 50} y="122" text-anchor="middle" font-size="13" fill="var(--muted)">{t.above[i]}</text>
        <rect
          x={c.x}
          y="140"
          width="100"
          height="80"
          rx="10"
          fill="var(--card)"
          stroke={c.hi ? "var(--accent)" : "var(--ink)"}
          stroke-width={c.hi ? 3 : 2}
        />
        <text x={c.x + 50} y="190" text-anchor="middle" font-size="26" fill="var(--ink)">{c.v}</text>
      </g>
    ))}

    <text x="400" y="272" text-anchor="middle" font-size="16" fill="var(--ink)">{t.largest}</text>

    <g>
      <rect x="320" y="300" width="160" height="48" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="400" y="330" text-anchor="middle" font-size="16" fill="var(--ink)">{t.ret}</text>
    </g>

    <text x="400" y="390" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
