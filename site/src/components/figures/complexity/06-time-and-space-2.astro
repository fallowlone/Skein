---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Four rows mapping code patterns to space complexity",
    headline: "READ SPACE FROM CODE",
    sub: "count the new data you create",
    row1: "few variables (x, y, count)",
    row2: "new array, size n",
    row3: "new 2D array, n × n",
    row4: "recursion n deep (stack)",
    note: "a loop running n times with two variables is O(1)",
    caption:
      "Reading space from code: count the new data you create. A few variables are O(1), an array of size n is O(n), an n × n grid is O(n²), recursion n deep is O(n) stack space. A loop running n times with two variables is still O(1) — space counts memory, not loops.",
  },
  ru: {
    svgTitle: "Четыре строки от примеров кода к пространственной сложности",
    headline: "ЧТЕНИЕ ПАМЯТИ ИЗ КОДА",
    sub: "считай новые данные, которые ты создаёшь",
    row1: "несколько переменных (x, y, count)",
    row2: "новый массив, размер n",
    row3: "новый двумерный массив, n × n",
    row4: "рекурсия n в глубину (стек)",
    note: "цикл на n проходов с двумя переменными — O(1)",
    caption:
      "Чтение памяти из кода: считай новые данные, которые ты создаёшь. Несколько переменных — O(1), массив размером n — O(n), сетка n × n — O(n²), рекурсия n в глубину — O(n) памяти стека. Цикл на n проходов с двумя переменными — всё равно O(1): память считает память, а не циклы.",
  },
};

const t = dict[lang];

const rows = [
  { y: 84, label: t.row1, badge: "O(1)" },
  { y: 149, label: t.row2, badge: "O(n)" },
  { y: 214, label: t.row3, badge: "O(n²)" },
  { y: 279, label: t.row4, badge: "O(n)" },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {rows.map((r) => (
      <g>
        <rect x="60" y={r.y} width="680" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x="205" y={r.y + 34} font-size="15" fill="var(--ink)">{r.label}</text>
        <rect x="636" y={r.y + 12} width="88" height="32" fill="none" stroke="var(--ink)" stroke-width="2" />
        <text x="680" y={r.y + 34} text-anchor="middle" font-size="16" fill="var(--ink)">{r.badge}</text>
      </g>
    ))}

    <!-- Row 1: two variable boxes, x and y -->
    <rect x="92" y="98" width="28" height="28" fill="none" stroke="var(--ink)" stroke-width="2" />
    <text x="106" y="118" text-anchor="middle" font-size="14" fill="var(--ink)">x</text>
    <rect x="128" y="98" width="28" height="28" fill="none" stroke="var(--ink)" stroke-width="2" />
    <text x="142" y="118" text-anchor="middle" font-size="14" fill="var(--ink)">y</text>

    <!-- Row 2: array of four cells -->
    <rect x="92" y="165" width="24" height="24" fill="none" stroke="var(--ink)" stroke-width="2" />
    <rect x="120" y="165" width="24" height="24" fill="none" stroke="var(--ink)" stroke-width="2" />
    <rect x="148" y="165" width="24" height="24" fill="none" stroke="var(--ink)" stroke-width="2" />
    <rect x="176" y="165" width="24" height="24" fill="none" stroke="var(--accent)" stroke-width="2" />

    <!-- Row 3: 3x3 grid -->
    <g fill="none" stroke="var(--ink)" stroke-width="2">
      <rect x="100" y="220" width="13" height="13" />
      <rect x="117" y="220" width="13" height="13" />
      <rect x="134" y="220" width="13" height="13" />
      <rect x="100" y="237" width="13" height="13" />
      <rect x="117" y="237" width="13" height="13" stroke="var(--accent)" />
      <rect x="134" y="237" width="13" height="13" />
      <rect x="100" y="254" width="13" height="13" />
      <rect x="117" y="254" width="13" height="13" />
      <rect x="134" y="254" width="13" height="13" />
    </g>

    <!-- Row 4: three stacked frames -->
    <rect x="96" y="289" width="100" height="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x="96" y="303" width="100" height="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <rect x="96" y="317" width="100" height="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />

    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
