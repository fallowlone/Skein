---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "countEqualPairs on 3, 9, 3 checks three pairs: 3 compares total, 1 plus 2",
    headline: "EVERY PAIR GETS CHECKED",
    sub: "countEqualPairs on [3, 9, 3] — nested loops",
    verdicts: ["No", "Yes · count = 1", "No"],
    compares: ["compare 1", "compare 2", "compare 3"],
    formula: "n = 3 → 3 compares = 1 + 2",
    note: "pattern: n × (n − 1) / 2 ≈ n² · n = 4 → 6 · n = 5 → 10",
    caption:
      "Nested loops check every pair: on [3, 9, 3] three compares total, 3 = 1 + 2. The pattern n × (n − 1) / 2 is roughly n² — double n, quadruple the cost.",
  },
  ru: {
    svgTitle: "countEqualPairs на 3, 9, 3 проверяет три пары: всего 3 сравнения, 1 плюс 2",
    headline: "ПРОВЕРЯЕТСЯ КАЖДАЯ ПАРА",
    sub: "countEqualPairs на [3, 9, 3] — вложенные циклы",
    verdicts: ["Нет", "Да · count = 1", "Нет"],
    compares: ["сравнение 1", "сравнение 2", "сравнение 3"],
    formula: "n = 3 → 3 сравнения = 1 + 2",
    note: "паттерн: n × (n − 1) / 2 ≈ n² · n = 4 → 6 · n = 5 → 10",
    caption:
      "Вложенные циклы проверяют каждую пару: на [3, 9, 3] всего три сравнения, 3 = 1 + 2. Формула n × (n − 1) / 2 — это примерно n²: удвоил n — учетверил цену.",
  },
};

const t = dict[lang];

const cells = [
  { v: "3", x: 250, idx: "i = 0" },
  { v: "9", x: 400, idx: "i = 1" },
  { v: "3", x: 550, idx: "i = 2" },
];

const pairs = [
  { x: 100, tag: "i = 0, j = 1", q: "3 === 9?" },
  { x: 310, tag: "i = 0, j = 2", q: "3 === 3?" },
  { x: 520, tag: "i = 1, j = 2", q: "9 === 3?" },
];
const cardY = 200;
const cardW = 180;
const cardH = 112;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {cells.map((c) => (
      <g>
        <text x={c.x} y="84" text-anchor="middle" font-size="12" fill="var(--muted)">{c.idx}</text>
        <rect x={c.x - 50} y="92" width="100" height="60" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={c.x} y="133" text-anchor="middle" font-size="28" fill="var(--ink)">{c.v}</text>
      </g>
    ))}

    {pairs.map((p, i) => (
      <g>
        <rect x={p.x} y={cardY} width={cardW} height={cardH} fill="transparent" stroke="var(--ink)" stroke-width="2" />
        <text x={p.x + cardW / 2} y={cardY + 24} text-anchor="middle" font-size="12" fill="var(--ink)">{p.tag}</text>
        <text x={p.x + cardW / 2} y={cardY + 54} text-anchor="middle" font-size="20" fill="var(--ink)">{p.q}</text>
        <text x={p.x + cardW / 2} y={cardY + 80} text-anchor="middle" font-size="13" fill="var(--accent)">{t.verdicts[i]}</text>
        <text x={p.x + cardW / 2} y={cardY + 100} text-anchor="middle" font-size="12" fill="var(--muted)">{t.compares[i]}</text>
      </g>
    ))}

    <text x="400" y="350" text-anchor="middle" font-size="19" fill="var(--ink)">{t.formula}</text>
    <text x="400" y="386" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
