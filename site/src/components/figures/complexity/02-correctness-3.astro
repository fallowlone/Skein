---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Correct versus buggy initialization on an all-negative list",
    headline: "WRONG INIT — BROKEN BEFORE IT STARTS",
    sub: "largestOf_WRONG([-5, -3, -1]) returns 0, not -1",
    leftTitle: "correct init ✓",
    leftLines: ["largest = numbers[0] = -5", "max of [-5] is -5", "INV true → returns -1 ✓"],
    rightTitle: "buggy init ✗",
    rightLines: ["largest = 0", "max of [-5] is -5, not 0", "INV false → returns 0 ✗"],
    note: "a faulty invariant means a faulty algorithm",
    caption:
      "Start largest at 0 and INV is already false on all-negative lists. The invariant catches the bug tests missed.",
  },
  ru: {
    svgTitle: "Верная и ошибочная инициализация на всех отрицательных числах",
    headline: "НЕВЕРНЫЙ ИНИТ — СЛОМАН ДО СТАРТА",
    sub: "largestOf_WRONG([-5, -3, -1]) возвращает 0, а не -1",
    leftTitle: "верный инит ✓",
    leftLines: ["largest = numbers[0] = -5", "максимум [-5] — это -5", "INV верен → возвращает -1 ✓"],
    rightTitle: "багги инит ✗",
    rightLines: ["largest = 0", "максимум [-5] — это -5, не 0", "INV ложен → возвращает 0 ✗"],
    note: "ложный инвариант означает ложный алгоритм",
    caption:
      "Начни largest с 0, и INV уже ложен на всех отрицательных списках. Инвариант ловит баг, пропущенный тестами.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="23" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="62" text-anchor="middle" font-size="14" fill="var(--muted)">{t.sub}</text>

    <rect x="40" y="100" width="340" height="205" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="210" y="134" text-anchor="middle" font-size="15" fill="var(--ink)">{t.leftTitle}</text>
    {t.leftLines.map((line, i) => (
      <text x="210" y={174 + i * 36} text-anchor="middle" font-size="14" fill="var(--ink)">{line}</text>
    ))}

    <rect x="420" y="100" width="340" height="205" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="590" y="134" text-anchor="middle" font-size="15" fill="var(--ink)">{t.rightTitle}</text>
    {t.rightLines.map((line, i) => (
      <text x="590" y={174 + i * 36} text-anchor="middle" font-size="14" fill="var(--ink)">{line}</text>
    ))}

    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--accent)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
