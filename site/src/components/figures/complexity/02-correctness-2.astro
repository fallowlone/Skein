---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "The invariant proof as three checkpoints: init, maintain, exit",
    headline: "ONE PROPERTY · THREE CHECKPOINTS",
    sub: "INV: largest = max of numbers[0..i]",
    boxes: [
      { title: "① INIT", lines: ["largest = numbers[0]", "INV true at i = 0"] },
      { title: "② MAINTAIN", lines: ["compare numbers[i]", "keep the max", "INV survives"] },
      { title: "③ EXIT", lines: ["i = n", "whole list seen", "INV IS the answer"] },
    ],
    note: "true at every step implies correct output",
    caption:
      "True before the loop, true after every pass, decisive at exit — one property proved thrice means correct.",
  },
  ru: {
    svgTitle: "Доказательство инвариантом как три точки: инит, поддержание, выход",
    headline: "ОДНО СВОЙСТВО · ТРИ ТОЧКИ",
    sub: "INV: largest = максимум numbers[0..i]",
    boxes: [
      { title: "① ИНИТ", lines: ["largest = numbers[0]", "INV верен при i = 0"] },
      { title: "② ДЕРЖИМ", lines: ["сравни numbers[i]", "оставь максимум", "INV жив"] },
      { title: "③ ВЫХОД", lines: ["i = n", "весь список просмотрен", "INV И ЕСТЬ ответ"] },
    ],
    note: "верен на каждом шаге — значит выход правильный",
    caption:
      "Верен до цикла, верен после каждого прохода, решающий на выходе — одно свойство, доказанное трижды, значит правильно.",
  },
};

const t = dict[lang];

const boxX = [20, 285, 550];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="62" text-anchor="middle" font-size="14" fill="var(--accent)">{t.sub}</text>

    {t.boxes.map((box, i) => (
      <g>
        <rect x={boxX[i]} y="105" width="230" height="200" rx="8" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={boxX[i] + 115} y="140" text-anchor="middle" font-size="15" fill="var(--ink)">{box.title}</text>
        {box.lines.map((line, j) => (
          <text x={boxX[i] + 115} y={178 + j * 32} text-anchor="middle" font-size="13" fill="var(--ink)">{line}</text>
        ))}
      </g>
    ))}
    <text x="266" y="218" text-anchor="middle" font-size="26" fill="var(--muted)">→</text>
    <text x="531" y="218" text-anchor="middle" font-size="26" fill="var(--muted)">→</text>

    <text x="400" y="372" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
