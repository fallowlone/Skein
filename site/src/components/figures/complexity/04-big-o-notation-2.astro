---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" }: Props = Astro.props;

const dict = {
  en: {
    svgTitle: "At n equals 10000, 3n plus 100 is still linear and n squared over 2 is still quadratic",
    headline: "AT n = 10,000, +100 IS NOISE",
    sub: "the dominant term overwhelms everything else",
    aTitle: "n  vs  3n + 100",
    aVal1: "10,000",
    aVal2: "30,100",
    aVerdict: "→ O(n)",
    aNote: "both roughly “linear”",
    aBottom: "the +100 is noise",
    bTitle: "n² / 2  vs  n²",
    bVal1: "50,000,000",
    bVal2: "100,000,000",
    bVerdict: "→ O(n²)",
    bNote: "×2 apart, both roughly “quadratic”",
    bBottom: "half of a mountain is still a mountain",
    note: "shape of growth, not the constant",
    caption:
      "Drop the small stuff: 3n+100 is O(n) — at n=10,000 the +100 is noise next to 10,000 vs 30,100. n²/2 is O(n²) — 50,000,000 vs 100,000,000 is a factor of 2, but half of a mountain is still a mountain.",
  },
  ru: {
    svgTitle: "При n равном 10 000, 3n плюс 100 всё ещё линейно, а n в квадрате пополам всё ещё квадратично",
    headline: "ПРИ n = 10 000 ДОБАВКА +100 — ШУМ",
    sub: "доминирующий член доминирует над всем остальным",
    aTitle: "n  против  3n + 100",
    aVal1: "10 000",
    aVal2: "30 100",
    aVerdict: "→ O(n)",
    aNote: "оба примерно «линейны»",
    aBottom: "добавка +100 — шум",
    bTitle: "n² / 2  против  n²",
    bVal1: "50 000 000",
    bVal2: "100 000 000",
    bVerdict: "→ O(n²)",
    bNote: "множитель 2, оба примерно «квадратичны»",
    bBottom: "половина горы всё равно гора",
    note: "важна форма роста, не константа",
    caption:
      "Отбрось мелочь: 3n+100 это O(n) — при n=10 000 добавка +100 лишь шум рядом с 10 000 против 30 100. n²/2 это O(n²) — 50 000 000 против 100 000 000 отличаются в 2 раза, но половина горы всё равно гора.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {/* Group A: linear pair */}
    <g>
      <rect x="30" y="85" width="360" height="250" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="210" y="118" text-anchor="middle" font-size="16" fill="var(--ink)">{t.aTitle}</text>
      <rect x="50" y="138" width="150" height="46" rx="6" fill="transparent" stroke="var(--ink)" stroke-width="1.5" />
      <text x="125" y="167" text-anchor="middle" font-size="16" fill="var(--ink)">{t.aVal1}</text>
      <rect x="220" y="138" width="150" height="46" rx="6" fill="transparent" stroke="var(--ink)" stroke-width="1.5" />
      <text x="295" y="167" text-anchor="middle" font-size="16" fill="var(--ink)">{t.aVal2}</text>
      <text x="210" y="230" text-anchor="middle" font-family="var(--font-display)" font-size="26" fill="var(--accent)">{t.aVerdict}</text>
      <text x="210" y="260" text-anchor="middle" font-size="13" fill="var(--muted)">{t.aNote}</text>
      <text x="210" y="300" text-anchor="middle" font-size="13" fill="var(--muted)">{t.aBottom}</text>
    </g>

    {/* Group B: quadratic pair */}
    <g>
      <rect x="410" y="85" width="360" height="250" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
      <text x="590" y="118" text-anchor="middle" font-size="16" fill="var(--ink)">{t.bTitle}</text>
      <rect x="430" y="138" width="150" height="46" rx="6" fill="transparent" stroke="var(--ink)" stroke-width="1.5" />
      <text x="505" y="167" text-anchor="middle" font-size="15" fill="var(--ink)">{t.bVal1}</text>
      <rect x="600" y="138" width="150" height="46" rx="6" fill="transparent" stroke="var(--ink)" stroke-width="1.5" />
      <text x="675" y="167" text-anchor="middle" font-size="15" fill="var(--ink)">{t.bVal2}</text>
      <text x="590" y="230" text-anchor="middle" font-family="var(--font-display)" font-size="26" fill="var(--accent)">{t.bVerdict}</text>
      <text x="590" y="260" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bNote}</text>
      <text x="590" y="300" text-anchor="middle" font-size="13" fill="var(--muted)">{t.bBottom}</text>
    </g>

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
