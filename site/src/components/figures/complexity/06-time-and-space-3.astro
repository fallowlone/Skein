---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "Call stack of countdown with three frames plus the base case",
    headline: "RECURSION HIDES ITS BILL",
    sub: "countdown(1000) holds 1000 stack frames — O(n) you never declared",
    frame1: "countdown(3)",
    frame2: "countdown(2)",
    frame3: "countdown(1)",
    base: "countdown(0): base case",
    depth: "stack 3 deep",
    holds: "each frame holds n + return address",
    bill: "the bill",
    maxDepth: "max depth n",
    stackCost: "→ O(n) space",
    loopVersion: "rewritten as a loop",
    loopCost: "→ O(1) space",
    note: "time and space: one budget, two pockets",
    caption:
      "Recursion hides its bill: countdown(3) stacks 3 frames, and countdown(1000) holds 1000 — O(n) space you never declared. Each frame holds n and the return address. Rewritten as a loop, the stack stays shallow at O(1). Time and space are one budget with two pockets.",
  },
  ru: {
    svgTitle: "Стек вызовов countdown с тремя кадрами и базовым случаем",
    headline: "РЕКУРСИЯ ПРЯЧЕТ СВОЙ СЧЁТ",
    sub: "countdown(1000) держит 1000 кадров стека — O(n), которую ты не объявлял",
    frame1: "countdown(3)",
    frame2: "countdown(2)",
    frame3: "countdown(1)",
    base: "countdown(0): базовый случай",
    depth: "стек глубины 3",
    holds: "каждый кадр хранит n + адрес возврата",
    bill: "счёт",
    maxDepth: "максимальная глубина n",
    stackCost: "→ O(n) памяти",
    loopVersion: "переписать как цикл",
    loopCost: "→ O(1) памяти",
    note: "время и память — один бюджет с двумя карманами",
    caption:
      "Рекурсия прячет свой счёт: countdown(3) складывает 3 кадра, а countdown(1000) держит 1000 — O(n) памяти, которую ты не объявлял. Каждый кадр хранит n и адрес возврата. Переписанный как цикл, стек остаётся мелким: O(1). Время и память — один бюджет с двумя карманами.",
  },
};

const t = dict[lang];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    <!-- Stack frames -->
    <rect x="120" y="96" width="260" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="250" y="124" text-anchor="middle" font-size="14" fill="var(--ink)">{t.frame1}</text>
    <rect x="120" y="150" width="260" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="250" y="178" text-anchor="middle" font-size="14" fill="var(--ink)">{t.frame2}</text>
    <rect x="120" y="204" width="260" height="46" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="250" y="232" text-anchor="middle" font-size="14" fill="var(--ink)">{t.frame3}</text>
    <rect x="120" y="258" width="260" height="46" fill="none" stroke="var(--muted)" stroke-width="2" stroke-dasharray="6 4" />
    <text x="250" y="286" text-anchor="middle" font-size="14" fill="var(--muted)">{t.base}</text>

    <text x="250" y="330" text-anchor="middle" font-size="13" fill="var(--ink)">{t.depth}</text>
    <text x="250" y="352" text-anchor="middle" font-size="12" fill="var(--muted)">{t.holds}</text>

    <!-- The bill -->
    <rect x="470" y="96" width="250" height="208" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="595" y="124" text-anchor="middle" font-size="14" fill="var(--ink)">{t.bill}</text>
    <text x="595" y="160" text-anchor="middle" font-size="14" fill="var(--ink)">{t.maxDepth}</text>
    <text x="595" y="186" text-anchor="middle" font-size="16" fill="var(--accent)">{t.stackCost}</text>
    <line x1="500" y1="210" x2="690" y2="210" stroke="var(--muted)" stroke-width="1" />
    <text x="595" y="240" text-anchor="middle" font-size="14" fill="var(--ink)">{t.loopVersion}</text>
    <text x="595" y="266" text-anchor="middle" font-size="16" fill="var(--accent)">{t.loopCost}</text>

    <text x="400" y="388" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
