---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props;

const dict = {
  en: {
    svgTitle: "largestOf on 3, 9, 2, 7 pays one compare per new cell: 3 compares for 4 items",
    headline: "EVERY ELEMENT PAYS ONE COMPARE",
    sub: "largestOf on [3, 9, 2, 7] — one new cell, one new compare",
    start: "start · largest = 3",
    step2: "9 > 3 · largest = 9",
    step3: "2 < 9 · skip",
    step4: "7 < 9 · skip",
    counts: ["compares = 0", "compares = 1", "compares = 2", "compares = 3"],
    boxNote: "one new cell, one new compare — cost grows with n",
    boxFormula: "n = 4 → 3 compares = n − 1",
    note: "single loop → step count ≈ n",
    caption:
      "Step count is a function of n: largestOf on [3, 9, 2, 7] pays one compare per new cell — 3 compares for 4 items, n − 1. Every element pays one compare.",
  },
  ru: {
    svgTitle: "largestOf на 3, 9, 2, 7 платит одно сравнение за новую клетку: 3 сравнения на 4 элемента",
    headline: "КАЖДЫЙ ЭЛЕМЕНТ ПЛАТИТ ОДНО СРАВНЕНИЕ",
    sub: "largestOf на [3, 9, 2, 7] — одна новая клетка, одно новое сравнение",
    start: "старт · largest = 3",
    step2: "9 > 3 · largest = 9",
    step3: "2 < 9 · пропущено",
    step4: "7 < 9 · пропущено",
    counts: ["сравнений = 0", "сравнений = 1", "сравнений = 2", "сравнений = 3"],
    boxNote: "одна новая клетка — одно новое сравнение: цена растёт с n",
    boxFormula: "n = 4 → 3 сравнения = n − 1",
    note: "один цикл → число шагов ≈ n",
    caption:
      "Число шагов — функция от n: largestOf на [3, 9, 2, 7] платит одно сравнение за новую клетку — 3 сравнения на 4 элемента, n − 1. Каждый элемент платит одно сравнение.",
  },
};

const t = dict[lang];

const cells = [
  { v: "3", x: 150, label: t.start },
  { v: "9", x: 300, label: t.step2 },
  { v: "2", x: 450, label: t.step3 },
  { v: "7", x: 600, label: t.step4 },
];
const cellY = 110;
const cellW = 104;
const cellH = 64;
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="22" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {cells.map((c, i) => (
      <g>
        <text x={c.x} y={cellY - 10} text-anchor="middle" font-size="12" fill="var(--muted)">[{i}]</text>
        <rect x={c.x - cellW / 2} y={cellY} width={cellW} height={cellH} fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
        <text x={c.x} y={cellY + 43} text-anchor="middle" font-size="30" fill="var(--ink)">{c.v}</text>
        <text x={c.x} y={cellY + cellH + 26} text-anchor="middle" font-size="12" fill="var(--ink)">{c.label}</text>
        <text x={c.x} y={cellY + cellH + 54} text-anchor="middle" font-size="13" fill="var(--accent)">{t.counts[i]}</text>
      </g>
    ))}

    <rect x="130" y="270" width="540" height="80" fill="var(--card)" stroke="var(--ink)" stroke-width="2" />
    <text x="400" y="296" text-anchor="middle" font-size="13" fill="var(--muted)">{t.boxNote}</text>
    <text x="400" y="328" text-anchor="middle" font-size="20" fill="var(--ink)">{t.boxFormula}</text>

    <text x="400" y="392" text-anchor="middle" font-size="13" fill="var(--muted)">{t.note}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
