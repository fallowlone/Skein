---
interface Props {
  lang: "en" | "ru";
}

const { lang = "en" } = Astro.props as Props;

const dict = {
  en: {
    svgTitle: "Verdict for pair-sum with n up to 100,000: O(n squared) needs 10^10 operations and is ruled out, O(n log n) and O(n) fit the budget",
    headline: "n ≤ 100,000 RULES OUT O(n²)",
    sub: "pair-sum: arr[i] + arr[j] = target",
    row1a: "O(n²)",
    row1cost: "= 10¹⁰ operations",
    row1v: "✗ ruled out",
    row1v2: "100× over budget",
    row2a: "O(n log n)",
    row2cost: "≈ 1.7×10⁶ operations",
    row2v: "✓ within budget",
    row3a: "O(n)",
    row3cost: "= 100,000 operations",
    row3v: "✓ trivially fast",
    design: "design: hash set (O(n)) or sort + two pointers (O(n log n))",
    caption:
      "Dead ends die before they cost you: at n ≤ 100,000, O(n²) needs 10¹⁰ operations — 100× over budget — so design a hash set O(n) or sort + two pointers O(n log n) instead.",
  },
  ru: {
    svgTitle: "Вердикт для суммы пары при n до 100 000: O(n в квадрате) требует 10^10 операций и исключён, O(n log n) и O(n) влезают в бюджет",
    headline: "n ≤ 100 000 ИСКЛЮЧАЕТ O(n²)",
    sub: "сумма пары: arr[i] + arr[j] = target",
    row1a: "O(n²)",
    row1cost: "= 10¹⁰ операций",
    row1v: "✗ исключено",
    row1v2: "превышен в 100 раз",
    row2a: "O(n log n)",
    row2cost: "≈ 1.7×10⁶ операций",
    row2v: "✓ в пределах бюджета",
    row3a: "O(n)",
    row3cost: "= 100 000 операций",
    row3v: "✓ тривиально быстро",
    design: "дизайн: хеш-множество (O(n)) или сортировка + два указателя (O(n log n))",
    caption:
      "Тупики умирают до того, как станут стоить времени: при n ≤ 100 000 O(n²) просит 10¹⁰ операций — в 100 раз сверх бюджета — поэтому проектируй хеш-множество O(n) или сортировку + два указателя O(n log n).",
  },
};

const t = dict[lang];
const rows = [
  { top: 122, a: t.row1a, cost: t.row1cost },
  { top: 197, a: t.row2a, cost: t.row2cost },
  { top: 272, a: t.row3a, cost: t.row3cost },
];
---

<figure data-lesson-visual class="my-6">
  <svg viewBox="0 0 800 420" role="img" font-family="var(--font-mono)">
    <title lang="en">{dict.en.svgTitle}</title>
    <title lang="ru">{dict.ru.svgTitle}</title>
    <text x="400" y="34" text-anchor="middle" font-family="var(--font-display)" font-size="24" fill="var(--ink)">{t.headline}</text>
    <text x="400" y="60" text-anchor="middle" font-size="13" fill="var(--muted)">{t.sub}</text>

    {rows.map((r, i) => (
      <g>
        <rect
          x="60"
          y={r.top}
          width="175"
          height="56"
          rx="8"
          fill="var(--card)"
          stroke={i === 0 ? "var(--muted)" : "var(--ink)"}
          stroke-width="2"
          stroke-dasharray={i === 0 ? "6 4" : "none"}
        />
        <text x="147" y={r.top + 35} text-anchor="middle" font-size="16" fill={i === 0 ? "var(--muted)" : "var(--ink)"}>{r.a}</text>
        <rect
          x="255"
          y={r.top}
          width="245"
          height="56"
          rx="8"
          fill="var(--card)"
          stroke={i === 0 ? "var(--muted)" : "var(--ink)"}
          stroke-width="2"
          stroke-dasharray={i === 0 ? "6 4" : "none"}
        />
        <text x="377" y={r.top + 35} text-anchor="middle" font-size="14" fill={i === 0 ? "var(--muted)" : "var(--ink)"}>{r.cost}</text>
        <rect
          x="520"
          y={r.top}
          width="220"
          height="56"
          rx="8"
          fill={i === 0 ? "transparent" : "var(--card)"}
          stroke={i === 0 ? "var(--muted)" : "var(--ink)"}
          stroke-width="2"
          stroke-dasharray={i === 0 ? "6 4" : "none"}
        />
      </g>
    ))}

    <text x="630" y="149" text-anchor="middle" font-size="14" fill="var(--muted)">{t.row1v}</text>
    <text x="630" y="169" text-anchor="middle" font-size="12" fill="var(--muted)">{t.row1v2}</text>
    <text x="630" y="232" text-anchor="middle" font-size="14" fill="var(--ink)">{t.row2v}</text>
    <text x="630" y="307" text-anchor="middle" font-size="14" fill="var(--ink)">{t.row3v}</text>

    <text x="400" y="375" text-anchor="middle" font-size="12.5" fill="var(--muted)">{t.design}</text>
  </svg>
  <figcaption style="text-align: center;">{t.caption}</figcaption>
</figure>
