---
/**
 * PosterFill — GSAP letter-sweep for the giant outline line (e.g. ATLAS).
 * Splits text into per-letter spans; on hover each letter fills accent
 * left-to-right with a stagger, lifts in a wave, lands elastic.
 * No-JS / reduced-motion falls back to the plain CSS hover fill.
 */
type Props = { text: string; drift?: boolean; shift?: boolean; cls?: string; decorative?: boolean };
const { text, drift = false, shift = false, cls = "", decorative = false } = Astro.props;
---
<span
  class:list={["pg-outline", shift && "pg-shift", cls || undefined]}
  data-fill-sweep
  data-drift={drift ? "" : undefined}
  aria-hidden={decorative ? "true" : undefined}
>{text}</span>

<script>
  import { setupGsap } from "../../scripts/gsap-setup";
  import { gsap } from "gsap";

  document.querySelectorAll<HTMLElement>("[data-fill-sweep]").forEach((el) => {
    if (el.classList.contains("is-js")) return;
    if (!setupGsap()) return;
    el.classList.add("is-js");
    const raw = el.textContent ?? "";
    if (!el.hasAttribute("aria-hidden")) el.setAttribute("aria-label", raw);
    el.textContent = "";
    const chars = [...raw].map((c) => {
      const s = document.createElement("span");
      s.className = "pf-ch";
      s.setAttribute("aria-hidden", "true");
      s.textContent = c === " " ? " " : c;
      el.appendChild(s);
      return s;
    });
    const tl = gsap
      .timeline({ paused: true })
      .to(chars, { backgroundSize: "100% 100%", duration: 0.45, ease: "power2.inOut", stagger: 0.055 }, 0)
      .to(chars, { y: -14, duration: 0.22, ease: "power2.out", stagger: 0.055 }, 0)
      .to(chars, { y: 0, duration: 0.5, ease: "elastic.out(1, 0.45)", stagger: 0.055 }, 0.22);
    el.addEventListener("mouseenter", () => tl.timeScale(1).play());
    el.addEventListener("mouseleave", () => tl.timeScale(1.6).reverse());
    el.addEventListener("click", () => (tl.progress() > 0.5 ? tl.reverse() : tl.play()));
  });
</script>
