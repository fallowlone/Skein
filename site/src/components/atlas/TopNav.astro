---
import ThemeToggle from "~/components/brand/ThemeToggle.astro";
import GlobalSearch from "~/components/nav/GlobalSearch.astro";
import StreakBadge from "~/components/brand/StreakBadge.tsx";
import AccountMenu from "~/components/account/AccountMenu.tsx";
import { t, type Locale, swapLocale } from "~/i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

const path = Astro.url.pathname;
// active section for aria-current
const seg = path.replace(/^\/(en|ru)/, "").replace(/^\//, "").split("/")[0] || "";
const isAtlas = seg === "" || seg === "learn";
const isPlan = seg === "roadmap";
const isReview = seg === "review";
const isProjects = seg === "projects";
const isEnglish = seg === "english";
const isGlossary = seg === "glossary";

const tag = lang === "en" ? "a map of the craft" : "карта ремесла";
const ruHref = swapLocale(path, "ru");
const enHref = swapLocale(path, "en");
---
<header class="topnav">
  <div class="topnav-inner">
    <a class="wordmark" href={`/${lang}/`} aria-label="Open Atlas home">
      <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
        <path d="M12 4.2 a7.8 7.8 0 0 1 7.4 5.4" stroke-opacity="0.45" />
        <path d="M4.6 9.6 a7.8 7.8 0 0 0 1.2 8.4" stroke-opacity="0.45" />
        <circle cx="12" cy="12" r="4.4" stroke-opacity="0.8" />
        <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
        <path d="M12 12 L18.2 6.4" stroke-width="1" />
        <circle cx="18.2" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
      </svg>
      <span class="wm-text">
        <span class="wm-name">open atlas</span>
        <span class="wm-tag">{tag}</span>
      </span>
    </a>
    <nav>
      <a href={`/${lang}/`} aria-current={isAtlas ? "page" : undefined}>{t("nav.atlas.atlas", lang)}</a>
      <a href={`/${lang}/roadmap/`} aria-current={isPlan ? "page" : undefined}>{t("nav.plan", lang)}</a>
      <a href={`/${lang}/review/`} aria-current={isReview ? "page" : undefined}>{t("nav.review", lang)}</a>
      <a href={`/${lang}/projects/`} aria-current={isProjects ? "page" : undefined}>{t("nav.projects", lang)}</a>
      <span class="nav-sep" aria-hidden="true"></span>
      <a class="nav-sec" href={`/${lang}/english/`} aria-current={isEnglish ? "page" : undefined}>{t("nav.english", lang)}</a>
      <a class="nav-sec" href={`/${lang}/glossary/`} aria-current={isGlossary ? "page" : undefined}>{t("nav.glossary", lang)}</a>
    </nav>
    <div class="spacer"></div>
    <div class="topnav-tools">
      <StreakBadge client:idle />
      <GlobalSearch lang={lang} />
      <div class="seg" role="group" aria-label="Language">
        <a href={enHref} aria-current={lang === "en" ? "true" : undefined}>EN</a>
        <a href={ruHref} aria-current={lang === "ru" ? "true" : undefined}>RU</a>
      </div>
      <ThemeToggle lang={lang} />
      <a class="icon-btn" href={`/${lang}/settings/`} aria-label={t("settings.title", lang)} title={t("settings.title", lang)}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
      </a>
      <AccountMenu client:idle lang={lang} />
    </div>
  </div>
</header>
