---
import ThemeToggle from "~/components/brand/ThemeToggle.astro";
import { t, type Locale, swapLocale } from "~/i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

const path = Astro.url.pathname;
// active section for aria-current
const seg = path.replace(/^\/(en|ru)/, "").replace(/^\//, "").split("/")[0] || "";
const isAtlas = seg === "" || seg === "learn" || seg === "projects";
const isEnglish = seg === "english";
const isGlossary = seg === "glossary";
const isAccount = seg === "account" || seg === "profile";

const tag = lang === "en" ? "a map of the craft" : "карта ремесла";
const ruHref = swapLocale(path, "ru");
const enHref = swapLocale(path, "en");
---
<header class="topnav">
  <div class="topnav-inner">
    <a class="wordmark" href={`/${lang}/`} aria-label="Open Atlas home">
      <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
        <path d="M12 4.2 a7.8 7.8 0 0 1 7.4 5.4" stroke-opacity="0.45" />
        <path d="M4.6 9.6 a7.8 7.8 0 0 0 1.2 8.4" stroke-opacity="0.45" />
        <circle cx="12" cy="12" r="4.4" stroke-opacity="0.8" />
        <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
        <path d="M12 12 L18.2 6.4" stroke-width="1" />
        <circle cx="18.2" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
      </svg>
      <span class="wm-text">
        <span class="wm-name">open atlas</span>
        <span class="wm-tag">{tag}</span>
      </span>
    </a>
    <nav>
      <a href={`/${lang}/`} aria-current={isAtlas ? "page" : undefined}>{t("nav.atlas.atlas", lang)}</a>
      <a href={`/${lang}/english/`} aria-current={isEnglish ? "page" : undefined}>{t("nav.english", lang)}</a>
      <a href={`/${lang}/glossary/`} aria-current={isGlossary ? "page" : undefined}>{t("nav.glossary", lang)}</a>
      <a href={`/${lang}/account`} aria-current={isAccount ? "page" : undefined}>{t("account.menu", lang)}</a>
    </nav>
    <div class="spacer"></div>
    <div class="topnav-tools">
      <div class="seg" role="group" aria-label="Language">
        <a href={enHref} aria-current={lang === "en" ? "true" : undefined}>EN</a>
        <a href={ruHref} aria-current={lang === "ru" ? "true" : undefined}>RU</a>
      </div>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>
