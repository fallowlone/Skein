---
import ThemeToggle from "~/components/brand/ThemeToggle.astro";
import GlobalSearch from "~/components/nav/GlobalSearch.astro";
import StreakBadge from "~/components/brand/StreakBadge.tsx";
import AccountMenu from "~/components/account/AccountMenu.tsx";
import { t, type Locale, swapLocale } from "~/i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

const path = Astro.url.pathname;
// active section for aria-current
const seg = path.replace(/^\/(en|ru)/, "").replace(/^\//, "").split("/")[0] || "";
const isAtlas = seg === "" || seg === "learn";
const isPlan = seg === "roadmap";
const isReview = seg === "review";
const isInterview = seg === "interview";
const isInterviewQA = seg === "interview-qa";
const isAssess = seg === "assess";
const isReadiness = seg === "readiness";
const isProjects = seg === "projects";
const isEnglish = seg === "english";
const isGlossary = seg === "glossary";

const tag = lang === "en" ? "a map of the craft" : "карта ремесла";
const ruHref = swapLocale(path, "ru");
const enHref = swapLocale(path, "en");
const menuLabel = lang === "ru" ? "Открыть меню" : "Open navigation menu";
const homeLabel = `Learnvane — ${t("a11y.home", lang)}`;
const searchLabel = lang === "ru" ? "Поиск" : "Search";
const langLabel = lang === "ru" ? "Язык" : "Language";
const settingsLabel = lang === "ru" ? "Настройки" : "Settings";
---
{/* Compact top bar — drawer mode (<720px) only; hamburger opens the rail overlay. */}
<header class="rail-topbar">
  <button class="tb-btn" data-rail-open aria-label={menuLabel} aria-expanded="false" aria-controls="primary-rail">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>
  <a class="rail-wordmark" href={`/${lang}/`} aria-label={homeLabel}>
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
      <path d="M12 4.2 a7.8 7.8 0 0 1 7.4 5.4" stroke-opacity="0.45" />
      <path d="M4.6 9.6 a7.8 7.8 0 0 0 1.2 8.4" stroke-opacity="0.45" />
      <circle cx="12" cy="12" r="4.4" stroke-opacity="0.8" />
      <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
      <path d="M12 12 L18.2 6.4" stroke-width="1" />
      <circle cx="18.2" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
    </svg>
    <span class="wm-text"><span class="wm-name">Learnvane</span></span>
  </a>
  <span class="tb-spacer"></span>
  <button class="tb-btn" data-search-open aria-label={searchLabel}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
  </button>
</header>

<div class="rail-scrim" data-rail-close aria-hidden="true"></div>

{/* The rail. In drawer mode it becomes a focus-trapped role=dialog (set by JS). */}
<nav id="primary-rail" class="rail" aria-label={t("a11y.nav.primary", lang)}>
  <a class="rail-wordmark" href={`/${lang}/`} aria-label={homeLabel}>
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
      <path d="M12 4.2 a7.8 7.8 0 0 1 7.4 5.4" stroke-opacity="0.45" />
      <path d="M4.6 9.6 a7.8 7.8 0 0 0 1.2 8.4" stroke-opacity="0.45" />
      <circle cx="12" cy="12" r="4.4" stroke-opacity="0.8" />
      <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
      <path d="M12 12 L18.2 6.4" stroke-width="1" />
      <circle cx="18.2" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
    </svg>
    <span class="wm-text">
      <span class="wm-name">Learnvane</span>
      <span class="wm-tag">{tag}</span>
    </span>
  </a>

  <div class="rail-nav">
    <a class="rail-item" href={`/${lang}/`} aria-current={isAtlas ? "page" : undefined}>
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M9 4 3 6.2v13.6L9 17.6l6 2.2 6-2.2V4.2l-6 2.2L9 4Z"/><path d="M9 4v13.6M15 6.4V20"/></svg>
      <span class="lbl">{t("nav.atlas.atlas", lang)}</span>
    </a>
    <a class="rail-item" href={`/${lang}/roadmap/`} aria-current={isPlan ? "page" : undefined}>
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="6.5" cy="6" r="2.2"/><circle cx="17.5" cy="18" r="2.2"/><path d="M8.7 6h6.3a3 3 0 0 1 0 6H9a3 3 0 0 0 0 6h6.3"/></svg>
      <span class="lbl">{t("nav.plan", lang)}</span>
    </a>
    <a class="rail-item" href={`/${lang}/review/`} aria-current={isReview ? "page" : undefined}>
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3.5 12a8.5 8.5 0 0 1 14.4-6.1L21 8.5"/><path d="M21 3.5v5h-5"/><path d="M20.5 12a8.5 8.5 0 0 1-14.4 6.1L3 15.5"/><path d="M3 20.5v-5h5"/></svg>
      <span class="lbl">{t("nav.review", lang)}</span>
      <span class="rail-due" data-due-badge data-due-label={t("review.dueCount", lang)} hidden></span>
    </a>
    <a class="rail-item" href={`/${lang}/interview/`} aria-current={isInterview ? "page" : undefined}>
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/><path d="M17 11l3 3-3 3"/></svg>
      <span class="lbl">{t("nav.interview", lang)}</span>
    </a>
    {/* [assess-engine-replan] /assess rail disabled: evidence model design defect (C1-C4) */}
    {/* <a class="rail-item" href={`/${lang}/assess/`} aria-current={isAssess ? "page" : undefined}>
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M9 11.5 11 13.5 15.5 9"/><circle cx="12" cy="12" r="8.5"/></svg>
      <span class="lbl">{t("nav.assess", lang)}</span>
    </a> */}
    <a class="rail-item" href={`/${lang}/readiness/`} aria-current={isReadiness ? "page" : undefined}>
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M12 21a9 9 0 1 1 9-9"/><path d="M12 12l4-2.5"/><circle cx="12" cy="12" r="1.6"/></svg>
      <span class="lbl">{t("nav.readiness", lang)}</span>
    </a>
    <a class="rail-item" href={`/${lang}/projects/`} aria-current={isProjects ? "page" : undefined}>
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m12 3 8.5 4.7L12 12.4 3.5 7.7 12 3Z"/><path d="m3.5 12 8.5 4.7 8.5-4.7"/></svg>
      <span class="lbl">{t("nav.projects", lang)}</span>
    </a>

    <hr class="rail-sep" />

    <a class="rail-item secondary" href={`/${lang}/english/`} aria-current={isEnglish ? "page" : undefined}>
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 5.5h8M8 5.5V8c0 4-2 6.6-4.5 7.6M6 9.5c0 2.6 2.2 4.6 5.5 5.4"/><path d="M13.5 19.5 17.5 10l4 9.5M15 16.4h5"/></svg>
      <span class="lbl">{t("nav.english", lang)}</span>
    </a>
    <a class="rail-item secondary" href={`/${lang}/glossary/`} aria-current={isGlossary ? "page" : undefined}>
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M6 4h9a2 2 0 0 1 2 2v14H8a2 2 0 0 0-2 2z"/><path d="M6 4v16"/><path d="M9.5 8.5h5M9.5 11.5h5"/></svg>
      <span class="lbl">{t("nav.glossary", lang)}</span>
    </a>
  </div>

  <div class="rail-tools">
    <div class="rail-streak"><StreakBadge client:idle /></div>
    <GlobalSearch lang={lang} />
    <div class="rail-lang">
      <span class="lbl">{langLabel}</span>
      <div class="seg" role="group" aria-label={t("a11y.lang.group", lang)}>
        <a href={enHref} aria-current={lang === "en" ? "true" : undefined}>EN</a>
        <a href={ruHref} aria-current={lang === "ru" ? "true" : undefined}>RU</a>
      </div>
    </div>
    <ThemeToggle lang={lang} />
    <a class="icon-btn" href={`/${lang}/settings/`} aria-label={settingsLabel} title={settingsLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
      <span class="font-mono text-[11px] uppercase tracking-wider">{settingsLabel}</span>
    </a>
    <div class="rail-account"><AccountMenu client:idle lang={lang} /></div>
  </div>
</nav>

<style is:global>
  /* Account island sits in the vertical rail: stretch its trigger to a full row. */
  .rail-account > div { width: 100%; }
  .rail-account .icon-btn,
  .rail-account .oa-btn { width: 100%; justify-content: flex-start; }
  /* AccountMenu's dropdown is absolutely positioned; let it escape the narrow rail. */
  .rail-account [role="menu"] { right: auto; left: 0; }
  @media (min-width: 720px) and (max-width: 1099.98px) {
    .rail-account > div { width: 40px; margin-inline: auto; }
    .rail-account .icon-btn { width: 40px; justify-content: center; }
    .rail-account .icon-btn > span:not([class*="avatar"]) { display: none; }
  }
</style>

<script>
  // Drawer behaviour for the <720px rail: open/close, scrim + Esc + nav-select
  // close, focus trap, focus restore. Mode (wide/icon/drawer) itself is pure CSS.
  (function () {
    const shell = document.querySelector(".oa-shell");
    const rail = document.getElementById("primary-rail");
    if (!shell || !rail) return;
    const openBtn = document.querySelector<HTMLElement>("[data-rail-open]");
    const mq = window.matchMedia("(max-width: 719.98px)");
    let lastFocus: HTMLElement | null = null;

    function focusables(): HTMLElement[] {
      return Array.from(
        rail!.querySelectorAll<HTMLElement>(
          'a[href],button:not([disabled]),input,[tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => el.offsetParent !== null);
    }

    function openDrawer() {
      if (!mq.matches) return;
      lastFocus = document.activeElement as HTMLElement;
      shell!.setAttribute("data-rail", "open");
      rail!.setAttribute("role", "dialog");
      rail!.setAttribute("aria-modal", "true");
      openBtn?.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      const f = focusables();
      f[0]?.focus();
    }
    function closeDrawer() {
      shell!.removeAttribute("data-rail");
      rail!.setAttribute("role", "navigation");
      rail!.removeAttribute("aria-modal");
      openBtn?.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      if (lastFocus && lastFocus.isConnected) lastFocus.focus();
      lastFocus = null;
    }

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("[data-rail-open]")) { openDrawer(); return; }
      if (target.closest("[data-rail-close]")) { closeDrawer(); return; }
      // selecting a nav item closes the drawer
      if (target.closest(".rail-item") && shell!.getAttribute("data-rail") === "open") closeDrawer();
    });

    document.addEventListener("keydown", (e) => {
      if (shell!.getAttribute("data-rail") !== "open") return;
      if (e.key === "Escape") { e.preventDefault(); closeDrawer(); return; }
      if (e.key !== "Tab") return;
      const f = focusables();
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    // leaving drawer width while open → reset to docked rail
    mq.addEventListener("change", () => { if (!mq.matches) closeDrawer(); });
  })();
</script>

<script>
  // Fill the spaced-repetition "N due" badge on the Review nav item from the local SRS store, so the
  // queue is visible while browsing — the biggest lever on whether reviews actually happen. Bundled
  // module script (NOT a hydration island), so it adds zero per-page island-cap cost on the global nav.
  import { dueCount } from "../../scripts/review-state";
  const badge = document.querySelector<HTMLElement>("[data-due-badge]");
  if (badge) {
    const n = dueCount(Date.now());
    if (n > 0) {
      const label = `${n} ${badge.dataset.dueLabel ?? ""}`.trim();
      badge.textContent = String(n);
      badge.title = label;            // sighted hover context (the visible pill is just the number)
      badge.hidden = false;
      const link = badge.closest("a");
      const lbl = link?.querySelector(".lbl")?.textContent?.trim() ?? "";
      link?.setAttribute("aria-label", `${lbl} — ${label}`.trim());
    }
  }
</script>

<style>
  .rail-due {
    margin-left: auto;
    font: 600 10px/1 var(--font-mono);
    background: var(--accent);
    color: var(--paper);
    padding: 2px 6px;
    border-radius: 999px;
    min-width: 1.1em;
    text-align: center;
  }
  /* Icon mode centers each rail-item, which neutralises margin-left:auto — anchor the badge to the
     icon's top-right corner instead (.rail-item is position:relative) so it never overlaps the glyph. */
  @media (min-width: 720px) and (max-width: 1099.98px) {
    .rail-due {
      position: absolute;
      top: 3px;
      right: 3px;
      margin-left: 0;
      padding: 1px 5px;
    }
  }
</style>
