---
import { t, type Locale } from "~/i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;
---

{/* "Continue learning" strip for the home page. Hidden until inline JS finds the
    most recent last-visited lesson across every track. A brand-new visitor with
    no stored progress sees nothing (the element stays display:none). Mirrors the
    storage contract written by the lesson layout: atlas.last.<lang>.<track> →
    { slug, title, href, at }. */}
<a class="home-resume" id="homeResume" href="#" hidden>
  <span class="hr-k">{t("home.resume.kicker", lang)}</span>
  <span class="hr-t" id="homeResumeTitle"></span>
  <span class="hr-track" id="homeResumeTrack"></span>
</a>

<script is:inline define:vars={{ lang }}>
  (function () {
    const el = document.getElementById("homeResume");
    if (!el) return;
    const prefix = "atlas.last." + lang + ".";
    let best = null;
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (!key || key.indexOf(prefix) !== 0) continue;
        const track = key.slice(prefix.length);
        let entry;
        try { entry = JSON.parse(localStorage.getItem(key) || ""); } catch (_) { continue; }
        if (!entry || typeof entry.href !== "string" || !entry.title) continue;
        // Valid lesson href is unit-scoped: /<lang>/learn/<track>/<unit>/<lesson>/ → 5 segments.
        // Pre-migration 2-segment entries now 404 — skip them.
        const segs = entry.href.split(/[?#]/)[0].split("/").filter(Boolean);
        const valid = entry.href.startsWith("/") && segs.length === 5 && segs[1] === "learn";
        if (!valid) continue;
        const at = typeof entry.at === "number" ? entry.at : 0;
        if (!best || at > best.at) best = { at, href: entry.href, title: entry.title, track };
      }
    } catch (_) { return; }
    if (!best) return;
    el.setAttribute("href", best.href);
    const titleEl = document.getElementById("homeResumeTitle");
    const trackEl = document.getElementById("homeResumeTrack");
    if (titleEl) titleEl.textContent = best.title;
    if (trackEl) trackEl.textContent = best.track;
    el.hidden = false;
  })();
</script>

<style>
  .home-resume {
    display: flex; flex-direction: column; gap: 4px;
    margin: 0 0 var(--s-6);
    padding: 16px 20px; border-radius: 6px;
    border: 1px solid rgba(47, 214, 189, 0.4);
    background: rgba(47, 214, 189, 0.05);
    text-decoration: none;
    transition: border-color .16s, background .16s, transform .16s;
  }
  .home-resume:hover {
    border-color: #2fd6bd; background: rgba(47, 214, 189, 0.09);
    transform: translateY(-2px);
  }
  .hr-k {
    font-family: var(--font-mono); font-size: 10.5px;
    letter-spacing: 0.12em; text-transform: uppercase; color: #2fd6bd;
  }
  .hr-t {
    font-family: var(--font-display); font-size: 20px; color: var(--ink);
    margin-top: 2px;
  }
  .hr-track {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.04em; color: var(--muted);
  }
</style>
