---
type Props = {
  /** When true, couple layer transforms to scrollY (topic ascent), with
   *  per-layer speed factors for depth + rAF lerp for weighted glide.
   *  When false, layers rest at translateY(0) — orbit visible (home backdrop). */
  parallax?: boolean;
};
const { parallax = false } = Astro.props;

function mulberry32(seed: number) {
  return function () {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rng = mulberry32(20260521);
// top values are % of the 400vh strip. Space zone = 0-25%.
const starsFar = Array.from({ length: 55 }, () => ({
  x: +(rng() * 100).toFixed(2),
  y: +(rng() * 24).toFixed(2),
  s: +(0.5 + rng() * 0.8).toFixed(2),
  o: +(0.55 + rng() * 0.4).toFixed(2),
}));
const starsNear = Array.from({ length: 35 }, () => ({
  x: +(rng() * 100).toFixed(2),
  y: +(rng() * 24).toFixed(2),
  s: +(1.2 + rng() * 1.4).toFixed(2),
  o: +(0.4 + rng() * 0.55).toFixed(2),
}));
const clouds = Array.from({ length: 5 }, () => ({
  x: +(rng() * 90).toFixed(1),
  y: +(27 + rng() * 16).toFixed(1),
  w: Math.round(170 + rng() * 200),
  o: +(0.05 + rng() * 0.07).toFixed(3),
}));
const particles = Array.from({ length: 18 }, () => ({
  x: +(rng() * 100).toFixed(2),
  y: +(28 + rng() * 60).toFixed(2),
  s: +(1 + rng() * 1.8).toFixed(2),
  o: +(0.3 + rng() * 0.5).toFixed(2),
  d: +(16 + rng() * 12).toFixed(1),
  delay: +(rng() * -20).toFixed(1),
}));
---

<div class="atlas-world" aria-hidden="true" data-parallax={parallax ? "true" : "false"}>
  <div class="atlas-world-strip layer" id="awBase">
    <div class="zone z-space"><span class="zone-edge">Orbit</span></div>
    <div class="zone z-sky"><span class="zone-edge">Sky</span></div>
    <div class="zone z-grass">
      <div class="horizon"></div>
      <span class="zone-edge">Surface</span>
    </div>
    <div class="zone z-under"><span class="zone-edge">Underground</span></div>

    <svg class="scene-rays" viewBox="0 0 240 240" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="awRay" x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#ffe6bf" stop-opacity=".22"/>
          <stop offset="1" stop-color="#ffe6bf" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <g class="rays">
        <path d="M120 240 L60 0 L84 0 Z" fill="url(#awRay)"/>
        <path d="M120 240 L98 0 L114 0 Z" fill="url(#awRay)"/>
        <path d="M120 240 L138 0 L156 0 Z" fill="url(#awRay)"/>
        <path d="M120 240 L176 0 L198 0 Z" fill="url(#awRay)"/>
      </g>
    </svg>
    <div class="sun-glow"></div>
    <div class="sun-core"></div>

    <svg class="scene-hills" viewBox="0 0 240 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 64 Q60 50 120 60 T240 56 V120 H0 Z" fill="#43406e"/>
      <path d="M0 64 Q60 50 120 60 T240 56" fill="none" stroke="#f6c98a" stroke-width="0.8" opacity=".5"/>
      <path d="M0 74 Q70 60 140 70 T240 66 V120 H0 Z" fill="#2f5a52"/>
      <path d="M0 74 Q70 60 140 70 T240 66" fill="none" stroke="#ffd9a0" stroke-width="0.8" opacity=".35"/>
      <path d="M0 82 Q50 75 130 82 T240 79 V120 H0 Z" fill="#2c6b3f"/>
      <path d="M0 90 Q60 85 150 90 T240 88 V120 H0 Z" fill="#236233"/>
      <path d="M0 96 q10 -3 18 0 q8 4 16 0 q9 -4 18 1 q8 3 15 -1 q10 -3 19 1 q8 3 16 -1 q9 -4 18 1 q8 3 15 -1 q10 -3 19 1 q8 3 16 -1 q9 -3 17 1 q9 -3 18 0 q8 4 17 -1 q9 -3 18 1 V120 H0 Z" fill="#3a2410"/>
    </svg>

    <svg class="scene-earth" viewBox="0 0 240 460" preserveAspectRatio="none" aria-hidden="true">
      <g stroke="#4a3018" stroke-width="1" fill="none">
        <path d="M0 80 q60 5 120 0 t120 -1" opacity=".5"/>
        <path d="M0 200 q70 -5 140 1 t100 0" opacity=".35" stroke-dasharray="7 9"/>
        <path d="M0 330 q60 5 130 -1 t110 1" opacity=".28"/>
      </g>
      <g fill="#3a2a1a" opacity=".5">
        <circle cx="30" cy="120" r="1.6"/><circle cx="90" cy="150" r="1.2"/>
        <circle cx="200" cy="110" r="1.7"/><circle cx="60" cy="250" r="1.3"/>
        <circle cx="150" cy="270" r="1.4"/><circle cx="210" cy="320" r="1.2"/>
        <circle cx="40" cy="370" r="1.4"/><circle cx="120" cy="400" r="1.2"/>
      </g>
    </svg>

    <svg class="scene-rock" style="left:9%;top:58%;width:132px;height:107px" viewBox="0 0 64 52" aria-hidden="true">
      <path d="M8 34 L22 12 L44 18 L58 38 L34 52 L10 46 Z" fill="#2a1c0e"/>
      <path d="M22 12 L44 18 L34 28 L16 26 Z" fill="#4a3520"/>
      <path d="M44 18 L58 38 L34 52 L34 28 Z" fill="#1c1208"/>
    </svg>
    <svg class="scene-rock" style="left:68%;top:60%;width:96px;height:78px;transform:scaleX(-1)" viewBox="0 0 64 52" aria-hidden="true">
      <path d="M8 34 L22 12 L44 18 L58 38 L34 52 L10 46 Z" fill="#2a1c0e"/>
      <path d="M22 12 L44 18 L34 28 L16 26 Z" fill="#4a3520"/>
      <path d="M44 18 L58 38 L34 52 L34 28 Z" fill="#1c1208"/>
    </svg>
    <svg class="scene-rock" style="left:40%;top:66%;width:80px;height:65px" viewBox="0 0 64 52" aria-hidden="true">
      <path d="M8 34 L22 12 L44 18 L58 38 L34 52 L10 46 Z" fill="#2a1c0e"/>
      <path d="M22 12 L44 18 L34 28 L16 26 Z" fill="#4a3520"/>
      <path d="M44 18 L58 38 L34 52 L34 28 Z" fill="#1c1208"/>
    </svg>
    <svg class="scene-rock" style="left:80%;top:74%;width:114px;height:93px" viewBox="0 0 64 52" aria-hidden="true">
      <path d="M8 34 L22 12 L44 18 L58 38 L34 52 L10 46 Z" fill="#2a1c0e"/>
      <path d="M22 12 L44 18 L34 28 L16 26 Z" fill="#4a3520"/>
      <path d="M44 18 L58 38 L34 52 L34 28 Z" fill="#1c1208"/>
    </svg>
    <svg class="scene-rock" style="left:6%;top:81%;width:104px;height:85px;transform:scaleX(-1)" viewBox="0 0 64 52" aria-hidden="true">
      <path d="M8 34 L22 12 L44 18 L58 38 L34 52 L10 46 Z" fill="#2a1c0e"/>
      <path d="M22 12 L44 18 L34 28 L16 26 Z" fill="#4a3520"/>
      <path d="M44 18 L58 38 L34 52 L34 28 Z" fill="#1c1208"/>
    </svg>
    <svg class="scene-rock" style="left:48%;top:87%;width:124px;height:101px" viewBox="0 0 64 52" aria-hidden="true">
      <path d="M8 34 L22 12 L44 18 L58 38 L34 52 L10 46 Z" fill="#2a1c0e"/>
      <path d="M22 12 L44 18 L34 28 L16 26 Z" fill="#4a3520"/>
      <path d="M44 18 L58 38 L34 52 L34 28 Z" fill="#1c1208"/>
    </svg>

    <svg class="scene-crystal" viewBox="0 0 240 160" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <radialGradient id="awGem" cx="50%" cy="55%" r="80%">
          <stop offset="0" stop-color="#ffd98f" stop-opacity=".34"/>
          <stop offset=".4" stop-color="#ffd98f" stop-opacity=".15"/>
          <stop offset=".7" stop-color="#ffd98f" stop-opacity=".05"/>
          <stop offset="1" stop-color="#ffd98f" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <ellipse class="gem-glow" cx="120" cy="86" rx="70" ry="52" fill="url(#awGem)"/>
      <g>
        <path d="M110 72 L120 52 L130 72 L120 110 Z" fill="#ffd98f"/>
        <path d="M110 72 L120 52 L120 110 Z" fill="#d8a85a"/>
        <path d="M130 72 L120 52 L120 110 Z" fill="#fff0c8"/>
        <path d="M94 82 L101 66 L108 82 L101 104 Z" fill="#e8be72"/>
        <path d="M101 66 L108 82 L101 104 Z" fill="#c79a4e"/>
        <path d="M132 78 L139 64 L146 78 L139 100 Z" fill="#f0c878"/>
        <path d="M139 64 L146 78 L139 100 Z" fill="#caa45a"/>
      </g>
    </svg>
  </div>

  <div class="layer" id="awStarFar">
    {starsFar.map((st) => (
      <i class="star" style={`left:${st.x}%;top:${st.y}%;width:${Math.max(1, Math.round(st.s) + 1)}px;height:${Math.max(1, Math.round(st.s) + 1)}px;opacity:${st.o};--o:${st.o};--tw:${(2.5 + (st.x % 45) / 10).toFixed(1)}s;--td:${(-(st.y % 7)).toFixed(1)}s`}></i>
    ))}
  </div>

  <div class="layer" id="awClouds">
    {clouds.map((c) => (
      <i class="cloud" style={`left:${c.x}%;top:${c.y}%;width:${c.w}px;height:${Math.round(c.w * 0.4)}px;opacity:${c.o}`}></i>
    ))}
    {particles.slice(0, 9).map((p) => (
      <i class="mote" style={`left:${p.x}%;top:${p.y}%;width:${p.s}px;height:${p.s}px;opacity:${p.o};--d:${p.d}s;--delay:${p.delay}s`}></i>
    ))}
  </div>

  <div class="layer" id="awStarNear">
    {starsNear.map((st) => (
      <i class="star" style={`left:${st.x}%;top:${st.y}%;width:${Math.max(1, Math.round(st.s) + 1)}px;height:${Math.max(1, Math.round(st.s) + 1)}px;opacity:${st.o};--o:${st.o};--tw:${(2.5 + (st.x % 45) / 10).toFixed(1)}s;--td:${(-(st.y % 7)).toFixed(1)}s`}></i>
    ))}
    {particles.slice(9).map((p) => (
      <i class="mote" style={`left:${p.x}%;top:${p.y}%;width:${p.s}px;height:${p.s}px;opacity:${p.o};--d:${p.d}s;--delay:${p.delay}s`}></i>
    ))}
  </div>

</div>

<script is:inline>
  (function () {
    const world = document.querySelector(".atlas-world");
    if (!world) return;

    // Respect prefers-reduced-motion + the site's motion override key
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const override = localStorage.getItem("skein.motion");
    const enabled = override === "on" ? true : override === "off" ? false : !reduce;
    if (enabled) world.classList.add("motion-on");

    // Parallax coupling only runs in parallax mode with motion enabled
    if (world.getAttribute("data-parallax") !== "true") return;
    if (!enabled) return;

    // [layer element, speed factor] — <1 lags (far), >1 leads (near)
    const layers = [
      [document.getElementById("awStarFar"), 0.80],
      [document.getElementById("awClouds"), 0.90],
      [document.getElementById("awBase"), 1.00],
      [document.getElementById("awStarNear"), 1.12],
    ].filter((l) => l[0]);
    if (!layers.length) return;

    let target = 0, cur = 0, raf = 0;

    function measure() {
      const max = document.body.scrollHeight - innerHeight;
      target = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    }
    function apply(p) {
      const base = -(1 - p) * 300; // vh
      for (let i = 0; i < layers.length; i++) {
        layers[i][0].style.transform = "translateY(" + base * layers[i][1] + "vh)";
      }
    }
    function tick() {
      cur += (target - cur) * 0.08;
      if (Math.abs(target - cur) < 0.0004) cur = target;
      apply(cur);
      raf = cur !== target ? requestAnimationFrame(tick) : 0;
    }
    function onScroll() {
      measure();
      if (!raf) raf = requestAnimationFrame(tick);
    }

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll, { passive: true });
    measure();
    cur = target;
    apply(cur);
  })();
</script>

<style>
  .atlas-world {
    position: fixed; inset: 0; z-index: 0;
    overflow: hidden; pointer-events: none;
  }
  .layer {
    position: absolute; left: 0; right: 0; top: 0;
    height: 400vh; will-change: transform;
  }
  .atlas-world-strip {
    background: linear-gradient(to bottom,
      #06060f 0%,
      #0a0e26 12%,
      #161a40 28%,
      #3b2f63 40%,
      #8a4f6a 47%,
      #d98a5e 50%,
      #f6b07a 51%,
      #3a2410 54%,
      #1c130a 75%,
      #0b0805 100%);
  }
  .zone { position: absolute; left: 0; right: 0; height: 25%; }
  .z-space  { top: 0; }
  .z-sky    { top: 25%; }
  .z-grass  { top: 50%; }
  .z-under  { top: 75%; }

  .star { position: absolute; background: #fff; border-radius: 50%; }
  .cloud {
    position: absolute; border-radius: 50%; background: #e0b29a;
    filter: blur(34px);
  }
  .mote { position: absolute; border-radius: 50%; background: #fff; }

  .horizon {
    position: absolute; left: 0; right: 0; top: 0; height: 1px;
    background: linear-gradient(to right, transparent,
      rgba(246, 201, 138, 0.55) 50%, transparent);
  }

  .scene-rays {
    position: absolute; left: 0; right: 0;
    top: 26%; height: 24%; width: 100%;
    filter: blur(2px);
  }
  .rays { transform-origin: 50% 100%; }
  .sun-glow {
    position: absolute; left: 50%; top: 47%;
    width: 150%; height: 16%;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side,
      rgba(255,230,191,0.40) 0%, rgba(255,199,133,0.18) 45%, transparent 78%);
  }
  .sun-core {
    position: absolute; left: 50%; top: 48%;
    width: 130px; height: 40px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff1d8;
    opacity: .5;
    filter: blur(30px);
  }
  .scene-hills {
    position: absolute; left: 0; right: 0;
    top: 43%; height: 12%; width: 100%;
  }
  .scene-earth {
    position: absolute; left: 0; right: 0;
    top: 54%; height: 46%; width: 100%;
  }
  .scene-crystal {
    position: absolute; left: 0; right: 0;
    top: 78%; height: 16%; width: 100%;
  }
  .scene-rock { position: absolute; }
  .gem-glow { filter: blur(28px); }

  @keyframes aw-ray-sway {
    0%, 100% { transform: skewX(0deg) scaleY(1); }
    50%      { transform: skewX(3deg) scaleY(1.04); }
  }
  @keyframes aw-mote-drift {
    0%   { transform: translate(0, 0); }
    50%  { transform: translate(8px, -14px); }
    100% { transform: translate(0, 0); }
  }
  @keyframes aw-gem-pulse {
    0%, 100% { opacity: .65; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.06); }
  }
  @keyframes aw-twinkle {
    0%, 100% { opacity: var(--o); }
    50%      { opacity: calc(var(--o) * 0.4); }
  }
  .atlas-world.motion-on .star {
    animation: aw-twinkle var(--tw, 4s) ease-in-out infinite;
    animation-delay: var(--td, 0s);
  }
  .atlas-world.motion-on .rays {
    animation: aw-ray-sway 14s ease-in-out infinite;
  }
  .atlas-world.motion-on .mote {
    animation: aw-mote-drift var(--d, 20s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  .atlas-world.motion-on .gem-glow {
    transform-box: fill-box; transform-origin: center;
    animation: aw-gem-pulse 6s ease-in-out infinite;
  }
  .zone-edge {
    position: absolute; left: 14px; top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    font-size: 10px; letter-spacing: 0.3em; color: #62667f;
    opacity: 0.5;
  }
</style>
