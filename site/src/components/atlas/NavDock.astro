---
/* Primary nav for the Atlas layout (poster pilot): fixed bottom dock.
   TopNav stays mounted but collapsed (its search overlay + scripts keep
   working); Topic/Lesson chrome is untouched. No Preact islands here —
   AccountMenu/ThemeToggle are the only client pieces, same as the rail. */
import ThemeToggle from "~/components/brand/ThemeToggle.astro";
import AccountMenu from "~/components/account/AccountMenu.tsx";
import { t, type Locale, swapLocale } from "~/i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;

const path = Astro.url.pathname;
const seg = path.replace(/^\/(en|ru)/, "").replace(/^\//, "").split("/")[0] || "";
const cur = (s: string) => (seg === s ? "page" : undefined);
const ruHref = swapLocale(path, "ru");
const enHref = swapLocale(path, "en");
const searchLabel = lang === "ru" ? "Поиск" : "Search";
const settingsLabel = lang === "ru" ? "Настройки" : "Settings";

const sections = [
  { slug: "", label: "Atlas" },
  { slug: "roadmap", label: t("nav.plan", lang) },
  { slug: "review", label: t("nav.review", lang), due: true },
  { slug: "interview", label: t("nav.interview", lang) },
  { slug: "readiness", label: t("nav.readiness", lang) },
  { slug: "projects", label: t("nav.projects", lang) },
  { slug: "english", label: t("nav.english", lang) },
  { slug: "glossary", label: t("nav.glossary", lang) },
];
---

<nav class="navdock" aria-label={t("a11y.nav.primary", lang)}>
  {sections.map((s) => (
    <a class="nd-sec" href={s.slug === "" ? `/${lang}/` : `/${lang}/${s.slug}/`} aria-current={s.slug === "" ? (seg === "" || seg === "learn" ? "page" : undefined) : cur(s.slug)}>
      {s.label}{s.due ? <span class="nd-due" data-due-mirror hidden></span> : null}
    </a>
  ))}
</nav>

<div class="navtools">
  <button type="button" class="icon-btn" data-search-open aria-label={searchLabel} title={searchLabel}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
  </button>
  <ThemeToggle lang={lang} />
  <span class="nd-lang" role="group" aria-label={t("a11y.lang.group", lang)}>
    <a href={enHref} aria-current={lang === "en" ? "true" : undefined}>EN</a>
    <a href={ruHref} aria-current={lang === "ru" ? "true" : undefined}>RU</a>
  </span>
  <a class="icon-btn" href={`/${lang}/settings/`} aria-label={settingsLabel} title={settingsLabel}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3"/>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
    </svg>
  </a>
  <AccountMenu client:idle lang={lang} />
</div>

<script is:inline>
  // Mirror the rail's review due-badge into the dock copy (the rail script
  // fills only the first [data-due-badge] in the document).
  (function () {
    var src = document.querySelector("[data-due-badge]");
    var dst = document.querySelector("[data-due-mirror]");
    if (!src || !dst) return;
    var sync = function () {
      dst.textContent = src.textContent;
      dst.hidden = src.hidden;
      dst.title = src.title;
    };
    new MutationObserver(sync).observe(src, { childList: true, attributes: true });
    sync();
  })();
</script>
