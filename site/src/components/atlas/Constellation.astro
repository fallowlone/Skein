---
type Props = {
  seed: number;
  count?: number;
  inset?: number;
  /** Container size in px; controls the SVG width/height. */
  size?: number;
  /** Tailwind/absolute positioning classes for the wrapping span. */
  class?: string;
  style?: string;
};

const { seed, count = 11, inset = 14, size = 230, class: className = "", style = "" } = Astro.props;

function mulberry32(s: number) {
  return function () {
    s |= 0; s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rng = mulberry32(seed >>> 0);
const span = 100 - inset * 2;

// Orderly left-to-right chain: x advances monotonically, y wanders gently
// around the midline. Reads as a single row, not a scattered cloud.
const pts = Array.from({ length: count }, (_, i) => {
  const t = count > 1 ? i / (count - 1) : 0.5;
  const jitterX = (rng() - 0.5) * (span / Math.max(count, 1)) * 0.9;
  return {
    x: +(inset + t * span + jitterX).toFixed(1),
    y: +(inset + span * 0.5 + (rng() - 0.5) * span * 0.4).toFixed(1),
    // Star-like variance: small radius + per-dot opacity, mirroring the
    // background starfield. First dot is the brighter teal anchor.
    r: i === 0 ? 1.8 : +(0.6 + rng() * 0.9).toFixed(2),
    o: i === 0 ? 0.9 : +(0.4 + rng() * 0.4).toFixed(2),
  };
});

// Only the sequential path — no random crossing lines (was visual clutter).
const lines: [number, number][] = [];
for (let i = 0; i < count - 1; i++) lines.push([i, i + 1]);
---

<svg
  class={`atlas-constellation ${className}`}
  style={`width:${size}px;height:${size}px;${style}`}
  viewBox="0 0 100 100"
  aria-hidden="true"
>
  {lines.map(([a, b]) => (
    <line
      x1={pts[a].x} y1={pts[a].y}
      x2={pts[b].x} y2={pts[b].y}
      class="cn-line"
    />
  ))}
  {pts.map((p, i) => (
    <circle
      cx={p.x} cy={p.y} r={p.r}
      class={i === 0 ? "cn-dot cn-anchor" : "cn-dot"}
      style={`opacity:${p.o}`}
    />
  ))}
</svg>

<style>
  .atlas-constellation { overflow: visible; opacity: 0.6; }
  .cn-line { stroke: rgba(47, 214, 189, 0.16); stroke-width: 0.35; fill: none; }
  .cn-dot  { fill: #fff; }
  .cn-anchor {
    fill: #2fd6bd;
    filter: drop-shadow(0 0 1.4px rgba(47, 214, 189, 0.7));
  }
</style>
