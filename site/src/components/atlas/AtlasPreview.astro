---
// Static "atlas preview" mini-map for the homepage hero — the report variant
// "Atlas Preview". Pure inline SVG (no hydration): ten track-domain chips on a
// decorative cartographic background, with the blue route a learner's start
// generates. Copy comes from i18n; node labels are illustrative domain tags.
import { t, type Locale } from "~/i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;
const routeLabel = t("home.map.route", lang);
---

<svg viewBox="0 0 760 470" preserveAspectRatio="xMinYMin meet" aria-hidden="true" class="atlas-preview">
  <defs>
    <filter id="ap-chip-shadow" x="-20%" y="-40%" width="140%" height="200%">
      <feDropShadow dx="0" dy="1.5" stdDeviation="1.5" flood-color="rgba(26,25,22,0.10)" />
    </filter>
  </defs>

  {/* terrain blobs — quiet landmasses behind the graph */}
  <g fill="var(--paper-2)" opacity="0.55">
    <path d="M60 200 C60 140 130 108 200 116 C270 124 312 160 302 215 C292 268 212 292 142 282 C86 274 60 240 60 200 Z" />
    <path d="M480 190 C480 140 560 128 640 148 C720 168 742 230 702 280 C662 330 542 332 502 292 C472 262 480 220 480 190 Z" />
    <path d="M300 400 C300 370 360 358 410 370 C460 382 472 420 432 442 C392 460 310 450 300 400 Z" />
    <path d="M120 380 C120 356 160 348 200 356 C240 364 246 396 216 412 C186 426 128 416 120 380 Z" />
  </g>

  {/* dashed trails */}
  <g fill="none" stroke="var(--rule)" stroke-width="1.1" stroke-dasharray="3 6" opacity="0.8">
    <path d="M640 70 C660 140 690 200 706 260 C712 290 702 320 690 348" />
    <path d="M60 120 C110 140 150 130 200 96" />
    <path d="M240 440 C300 448 360 444 430 420" />
  </g>

  {/* line-art decorations: mountains, pines, water */}
  <g fill="none" stroke="var(--rule-strong)" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round" opacity="0.75">
    {/* mountains */}
    <g transform="translate(96,150)">
      <path d="M0 26 L18 0 L30 16 M22 26 L40 4 L58 26" />
      <path d="M10 26 h44" stroke-opacity="0.5" />
    </g>
    <g transform="translate(540,26)">
      <path d="M0 22 L14 0 L26 14 M18 22 L34 4 L48 22" />
    </g>
    <g transform="translate(372,382)">
      <path d="M0 20 L14 0 L26 14 M18 20 L32 4 L46 20" />
    </g>
    {/* pines */}
    <g transform="translate(626,84)">
      <path d="M8 0 L15 13 H1 Z M8 13 V19" />
      <path d="M24 6 L30 17 H18 Z M24 17 V22" />
    </g>
    <g transform="translate(672,106)">
      <path d="M7 0 L13 11 H1 Z M7 11 V16" />
    </g>
    <g transform="translate(674,296)">
      <path d="M8 0 L15 13 H1 Z M8 13 V19" />
      <path d="M26 8 L32 18 H20 Z M26 18 V23" />
    </g>
    <g transform="translate(632,320)">
      <path d="M7 0 L13 11 H1 Z M7 11 V16" />
    </g>
    {/* water */}
    <g transform="translate(30,348)">
      <path d="M0 8 Q5 2 10 8 T20 8 M26 14 Q31 8 36 14 T46 14" />
    </g>
    <g transform="translate(668,128)">
      <path d="M0 8 Q5 2 10 8 T20 8 M26 14 Q31 8 36 14 T46 14" />
    </g>
    <g transform="translate(344,356)">
      <path d="M0 8 Q5 2 10 8 T20 8" />
    </g>
  </g>

  {/* compass rose */}
  <g transform="translate(700,42)" stroke="var(--ink)" fill="none" stroke-width="1.1">
    <circle r="13" />
    <path d="M0 -19 V-13 M0 13 V19 M-19 0 H-13 M13 0 H19" />
    <path d="M0 -9 L3.2 0 L0 9 L-3.2 0 Z" transform="rotate(45)" />
    <path d="M0 -9 L3.2 0 L0 0 Z" fill="var(--ink)" stroke="none" transform="rotate(45)" />
    <text y="-25" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--ink)" stroke="none">N</text>
  </g>

  {/* gray prerequisite edges */}
  <g stroke="var(--rule-strong)" stroke-width="1.2">
    <path d="M380 91 L478 124" />
    <path d="M537 150 L616 228" />
    <path d="M422 205 L568 245" />
    <path d="M136 189 L302 205" />
    <path d="M84 206 L84 298" />
    <path d="M154 315 L256 323" />
    <path d="M616 262 L652 362" />
  </g>

  {/* chips */}
  <g font-family="var(--font-mono)" font-size="13" fill="var(--ink)">
    <g filter="url(#ap-chip-shadow)">
      <rect x="36" y="64" width="118" height="34" rx="7" fill="var(--card)" stroke="var(--hairline-2)" />
      <rect x="258" y="74" width="122" height="34" rx="7" fill="var(--card)" stroke="var(--hairline-2)" />
      <rect x="478" y="98" width="118" height="52" rx="7" fill="var(--card)" stroke="var(--hairline-2)" />
      <rect x="32" y="172" width="104" height="34" rx="7" fill="var(--card)" stroke="var(--hairline-2)" />
      <rect x="302" y="188" width="120" height="34" rx="7" fill="var(--card)" stroke="var(--hairline-2)" />
      <rect x="568" y="228" width="96" height="34" rx="7" fill="var(--card)" stroke="var(--hairline-2)" />
      <rect x="32" y="298" width="122" height="34" rx="7" fill="var(--card)" stroke="var(--hairline-2)" />
      <rect x="256" y="306" width="132" height="34" rx="7" fill="var(--card)" stroke="var(--hairline-2)" />
      <rect x="472" y="302" width="62" height="34" rx="7" fill="var(--card)" stroke="var(--hairline-2)" />
      <rect x="608" y="362" width="88" height="34" rx="7" fill="var(--card)" stroke="var(--hairline-2)" />
    </g>
    <text x="46" y="86">1 foundations</text>
    <text x="268" y="96">2 algorithms</text>
    <text x="488" y="118">3 data-</text>
    <text x="488" y="134">structures</text>
    <text x="42" y="194">4 systems</text>
    <text x="312" y="210">5 databases</text>
    <text x="578" y="250">6 testing</text>
    <text x="42" y="320">7 deployment</text>
    <text x="266" y="328">8 performance</text>
    <text x="482" y="324">9 ml</text>
    <text x="618" y="384">10 ci-cd</text>
  </g>

  {/* gray ports on non-route connections */}
  <g fill="var(--card)" stroke="var(--hairline-strong)" stroke-width="1.2">
    <circle cx="380" cy="91" r="4.5" />
    <circle cx="478" cy="124" r="4.5" />
    <circle cx="537" cy="150" r="4.5" />
    <circle cx="616" cy="228" r="4.5" />
    <circle cx="568" cy="245" r="4.5" />
    <circle cx="616" cy="262" r="4.5" />
    <circle cx="422" cy="205" r="4.5" />
    <circle cx="136" cy="189" r="4.5" />
    <circle cx="302" cy="205" r="4.5" />
    <circle cx="84" cy="206" r="4.5" />
    <circle cx="84" cy="298" r="4.5" />
    <circle cx="154" cy="315" r="4.5" />
    <circle cx="256" cy="323" r="4.5" />
    <circle cx="652" cy="362" r="4.5" />
  </g>

  {/* the blue route starting generates */}
  <path
    d="M154 81 L258 91 L302 108 L318 188 L350 222 L330 306 L388 323 L472 319 L522 336 L608 379"
    fill="none" stroke="var(--accent-bright)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"
  />
  <g fill="var(--accent-bright)">
    <circle cx="154" cy="81" r="4.5" />
    <circle cx="258" cy="91" r="4.5" />
    <circle cx="302" cy="108" r="4" />
    <circle cx="318" cy="188" r="4.5" />
    <circle cx="350" cy="222" r="4" />
    <circle cx="330" cy="306" r="4.5" />
    <circle cx="388" cy="323" r="4.5" />
    <circle cx="472" cy="319" r="4.5" />
    <circle cx="522" cy="336" r="4" />
    <circle cx="608" cy="379" r="4.5" />
  </g>

  {/* your-route annotation */}
  <text x="420" y="260" font-family="var(--font-mono)" font-size="13" fill="var(--accent-bright)">{routeLabel}</text>
  <g stroke="var(--accent-bright)" fill="none" stroke-width="1.4">
    <path d="M448 270 C462 284 476 292 494 298" stroke-dasharray="4 4" />
    <path d="M498 300 L488 296 L493 290 Z" fill="var(--accent-bright)" stroke="none" />
  </g>
</svg>
<p class="map-caption">{t("home.map.caption", lang)}</p>
