---
import { t, type Locale } from "~/i18n";

type Props = { lang: Locale };
const { lang } = Astro.props;
const routeLabel = t("home.map.route", lang);
---

<svg viewBox="0 0 760 470" preserveAspectRatio="xMinYMin meet" aria-hidden="true" class="atlas-preview">
  <defs>
    <pattern id="atlas-grid" width="28" height="28" patternUnits="userSpaceOnUse">
      <path d="M28 0H0V28" fill="none" stroke="var(--rule)" stroke-width="0.7" opacity="0.46" />
    </pattern>
    <filter id="atlas-card-shadow" x="-30%" y="-60%" width="160%" height="220%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="rgba(20,24,32,0.12)" />
    </filter>
    <filter id="atlas-route-glow" x="-20%" y="-50%" width="140%" height="200%">
      <feGaussianBlur stdDeviation="5" />
    </filter>
  </defs>

  <g>
    <rect width="760" height="440" fill="url(#atlas-grid)" opacity="0.72" />

    {/* quiet cartographic contours give the panel depth without competing with the route */}
    <g fill="none" stroke="var(--rule-strong)" opacity="0.34">
      <path d="M-48 344 C56 268 142 276 222 319 C300 360 390 360 470 312 C553 262 627 256 810 301" />
      <path d="M-61 372 C45 294 139 301 222 345 C304 389 397 388 482 337 C569 285 646 281 824 329" />
      <path d="M-77 399 C37 323 137 327 224 372 C312 417 410 418 497 366 C585 313 663 310 844 359" />
      <path d="M316 -24 C384 34 391 93 360 145 C328 199 331 247 379 286 C430 326 498 321 545 275 C591 231 596 170 565 118 C533 65 536 24 594 -32" />
      <path d="M347 -29 C408 26 414 82 386 132 C356 185 360 228 401 261 C445 296 501 292 541 253 C580 214 584 163 557 117 C527 67 532 27 582 -27" />
    </g>

    {/* region washes make the route feel like a map rather than a flowchart */}
    <path d="M-18 284 C80 224 168 228 242 276 C294 311 316 354 304 445 H-18 Z" fill="var(--paper-2)" opacity="0.54" />
    <path d="M259 40 C356 -4 456 0 523 64 C583 121 590 201 546 253 C494 314 386 303 327 244 C274 191 235 103 259 40 Z" fill="var(--paper-2)" opacity="0.37" />
    <path d="M551 -22 H792 V278 C728 308 659 292 618 242 C573 188 566 91 551 -22 Z" fill="var(--paper-2)" opacity="0.45" />

    {/* section labels */}
    <g font-family="var(--font-mono)" font-size="9.5" letter-spacing="1.5" fill="var(--faint)">
      <text x="30" y="414">FOUNDATIONS</text>
      <text x="329" y="414">ENGINEERING</text>
      <text x="610" y="414">DELIVERY</text>
    </g>
    <g stroke="var(--hairline-2)" stroke-width="1">
      <path d="M30 396 H285" />
      <path d="M329 396 H566" />
      <path d="M610 396 H728" />
    </g>

    {/* route underglow */}
    <path
      d="M78 346 C126 330 151 291 194 282 C245 271 258 319 311 309 C361 299 358 241 407 228 C457 215 475 256 517 236 C559 216 546 167 587 146 C625 127 649 102 686 70"
      fill="none"
      stroke="var(--accent-bright)"
      stroke-width="12"
      opacity="0.11"
      filter="url(#atlas-route-glow)"
      stroke-linecap="round"
    />
    <path
      d="M78 346 C126 330 151 291 194 282 C245 271 258 319 311 309 C361 299 358 241 407 228 C457 215 475 256 517 236 C559 216 546 167 587 146 C625 127 649 102 686 70"
      fill="none"
      stroke="var(--accent-bright)"
      stroke-width="2.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    {/* secondary branches: visible enough to imply breadth, quiet enough to keep one primary path */}
    <g fill="none" stroke="var(--rule-strong)" stroke-width="1.1" stroke-dasharray="3 6" opacity="0.58">
      <path d="M194 282 C197 221 162 184 117 157" />
      <path d="M311 309 C335 356 396 367 448 348" />
      <path d="M407 228 C382 176 397 127 437 101" />
      <path d="M517 236 C591 270 648 259 704 222" />
    </g>

    {/* route nodes */}
    <g>
      <g transform="translate(78 346)">
        <circle r="9" fill="var(--card)" stroke="var(--accent-bright)" stroke-width="2" />
        <circle r="3.5" fill="var(--accent-bright)" />
      </g>
      <g transform="translate(194 282)"><circle r="7" fill="var(--card)" stroke="var(--accent-bright)" stroke-width="2" /><circle r="3" fill="var(--accent-bright)" /></g>
      <g transform="translate(311 309)"><circle r="7" fill="var(--card)" stroke="var(--accent-bright)" stroke-width="2" /><circle r="3" fill="var(--accent-bright)" /></g>
      <g transform="translate(407 228)"><circle r="7" fill="var(--card)" stroke="var(--accent-bright)" stroke-width="2" /><circle r="3" fill="var(--accent-bright)" /></g>
      <g transform="translate(517 236)"><circle r="7" fill="var(--card)" stroke="var(--accent-bright)" stroke-width="2" /><circle r="3" fill="var(--accent-bright)" /></g>
      <g transform="translate(587 146)"><circle r="7" fill="var(--card)" stroke="var(--accent-bright)" stroke-width="2" /><circle r="3" fill="var(--accent-bright)" /></g>
      <g transform="translate(686 70)"><circle r="10" fill="var(--accent-bright)" /><circle r="3.3" fill="var(--card)" /></g>
    </g>

    {/* domain cards */}
    <g font-family="var(--font-mono)" fill="var(--ink)" filter="url(#atlas-card-shadow)">
      <g transform="translate(34 301)">
        <rect width="133" height="34" rx="8" fill="var(--card)" stroke="var(--hairline-2)" />
        <text x="12" y="21" font-size="11.5"><tspan fill="var(--faint)">01</tspan><tspan dx="8">foundations</tspan></text>
      </g>
      <g transform="translate(133 235)">
        <rect width="129" height="34" rx="8" fill="var(--card)" stroke="var(--hairline-2)" />
        <text x="12" y="21" font-size="11.5"><tspan fill="var(--faint)">02</tspan><tspan dx="8">algorithms</tspan></text>
      </g>
      <g transform="translate(253 322)">
        <rect width="145" height="48" rx="8" fill="var(--card)" stroke="var(--hairline-2)" />
        <text x="12" y="19" font-size="11.5"><tspan fill="var(--faint)">03</tspan><tspan dx="8">data</tspan></text>
        <text x="44" y="34" font-size="11.5">structures</text>
      </g>
      <g transform="translate(350 178)">
        <rect width="116" height="34" rx="8" fill="var(--card)" stroke="var(--hairline-2)" />
        <text x="12" y="21" font-size="11.5"><tspan fill="var(--faint)">04</tspan><tspan dx="8">systems</tspan></text>
      </g>
      <g transform="translate(460 249)">
        <rect width="127" height="34" rx="8" fill="var(--card)" stroke="var(--hairline-2)" />
        <text x="12" y="21" font-size="11.5"><tspan fill="var(--faint)">05</tspan><tspan dx="8">databases</tspan></text>
      </g>
      <g transform="translate(531 98)">
        <rect width="111" height="34" rx="8" fill="var(--card)" stroke="var(--hairline-2)" />
        <text x="12" y="21" font-size="11.5"><tspan fill="var(--faint)">06</tspan><tspan dx="8">testing</tspan></text>
      </g>
      <g transform="translate(621 81)">
        <rect width="107" height="34" rx="8" fill="var(--card)" stroke="var(--hairline-2)" />
        <text x="12" y="21" font-size="11.5"><tspan fill="var(--faint)">10</tspan><tspan dx="8">ci-cd</tspan></text>
      </g>
    </g>

    {/* off-route breadth markers */}
    <g font-family="var(--font-mono)" font-size="10.5" fill="var(--muted)">
      <g transform="translate(73 132)">
        <circle cx="7" cy="7" r="4" fill="var(--card)" stroke="var(--hairline-strong)" />
        <text x="20" y="11">performance</text>
      </g>
      <g transform="translate(414 76)">
        <circle cx="7" cy="7" r="4" fill="var(--card)" stroke="var(--hairline-strong)" />
        <text x="20" y="11">ml</text>
      </g>
      <g transform="translate(657 198)">
        <circle cx="7" cy="7" r="4" fill="var(--card)" stroke="var(--hairline-strong)" />
        <text x="20" y="11">deployment</text>
      </g>
      <g transform="translate(402 340)">
        <circle cx="7" cy="7" r="4" fill="var(--card)" stroke="var(--hairline-strong)" />
        <text x="20" y="11">security</text>
      </g>
    </g>

    {/* route annotation */}
    <g transform="translate(484 183)">
      <rect x="0" y="0" width="92" height="26" rx="13" fill="var(--card)" stroke="var(--accent-bright)" stroke-width="1" />
      <circle cx="14" cy="13" r="3.5" fill="var(--accent-bright)" />
      <text x="25" y="16.5" font-family="var(--font-mono)" font-size="10.5" fill="var(--accent-bright)">{routeLabel}</text>
    </g>

    {/* compass */}
    <g transform="translate(704 37)" stroke="var(--ink-2)" fill="none" stroke-width="1">
      <circle r="14" opacity="0.72" />
      <path d="M0 -20 V-14 M0 14 V20 M-20 0 H-14 M14 0 H20" opacity="0.64" />
      <path d="M0 -9 L3 0 L0 9 L-3 0 Z" transform="rotate(35)" />
      <path d="M0 -9 L3 0 L0 0 Z" fill="var(--ink-2)" stroke="none" transform="rotate(35)" />
      <text y="-24" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--muted)" stroke="none">N</text>
    </g>

    {/* start / finish micro-markers */}
    <g font-family="var(--font-mono)" font-size="9" letter-spacing="1.1" fill="var(--faint)">
      <text x="46" y="370">START</text>
      <text x="652" y="52">SHIP</text>
    </g>
  </g>
</svg>
<p class="map-caption">{t("home.map.caption", lang)}</p>
