---
import concepts from "~/content/path/concepts.json";
import type { Locale } from "~/i18n";

const { lang, ids } = Astro.props as { lang: Locale; ids: string[] };
const known = new Map((concepts as Array<{ id: string; label: { en: string; ru: string } }>).map((c) => [c.id, c.label]));
const labels = ids.map((id) => known.get(id)?.[lang] ?? id);
const unknownLabel = lang === "ru" ? "Не измерено" : "Not measured";
---

{labels.length > 0 && (
  <aside class="concept-mastery" aria-label={lang === "ru" ? "Концепты урока" : "Lesson concepts"}>
    <span>{lang === "ru" ? "Концепты урока" : "Lesson concepts"}</span>
    <ul>
      {labels.map((label, index) => (
        <li data-concept-id={ids[index]} data-lang={lang}>
          <span>{label}</span>
          <output data-concept-status>{unknownLabel}</output>
        </li>
      ))}
    </ul>
  </aside>
)}

<script>
  import { currentConceptMasteryLevel } from "~/scripts/path/path-io";

  document.querySelectorAll("[data-concept-id]").forEach((row) => {
    const id = row.getAttribute("data-concept-id");
    const status = row.querySelector("[data-concept-status]");
    if (!id || !status) return;
    const ru = row.getAttribute("data-lang") === "ru";
    status.textContent = currentConceptMasteryLevel(id) === "measured"
      ? (ru ? "Измерено проверкой" : "Measured by a check")
      : (ru ? "Не измерено" : "Not measured");
  });
</script>

<style>
  .concept-mastery {
    margin: 18px 0;
    padding: 14px 16px;
    border-left: 2px solid var(--accent);
    background: var(--card);
  }
  span {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul {
    margin: 8px 0 0;
    padding-left: 18px;
    color: var(--ink-2);
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  output {
    color: var(--muted);
    font-size: 12px;
  }
</style>
