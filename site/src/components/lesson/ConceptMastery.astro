---
import concepts from "~/content/path/concepts.json";
import type { Locale } from "~/i18n";

const { lang, ids } = Astro.props as { lang: Locale; ids: string[] };
const known = new Map((concepts as Array<{ id: string; label: { en: string; ru: string } }>).map((c) => [c.id, c.label]));
const labels = ids.map((id) => known.get(id)?.[lang] ?? id);
---

{labels.length > 0 && (
  <aside class="concept-mastery" aria-label={lang === "ru" ? "Концепты урока" : "Lesson concepts"}>
    <span>{lang === "ru" ? "Концепты урока" : "Lesson concepts"}</span>
    <ul>
      {labels.map((label, index) => (
        <li data-concept-id={ids[index]}>
          <span>{label}</span>
          <button type="button" data-level="understood">
            {lang === "ru" ? "Понял" : "Understood"}
          </button>
        </li>
      ))}
    </ul>
  </aside>
)}

<script>
  import { advanceConceptMastery, currentConceptMasteryLevel } from "~/scripts/path/path-io";

  document.querySelectorAll("[data-concept-id]").forEach((row) => {
    const id = row.getAttribute("data-concept-id");
    const button = row.querySelector("button");
    if (!id || !button) return;
    button.textContent = currentConceptMasteryLevel(id);
    button.addEventListener("click", () => {
      const next = advanceConceptMastery(id);
      if (next) button.textContent = next;
    });
  });
</script>

<style>
  .concept-mastery {
    margin: 18px 0;
    padding: 14px 16px;
    border-left: 2px solid var(--accent);
    background: var(--card);
  }
  span {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul {
    margin: 8px 0 0;
    padding-left: 18px;
    color: var(--ink-2);
  }
</style>
