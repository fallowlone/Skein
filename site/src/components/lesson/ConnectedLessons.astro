---
import { t, type Locale } from "../../i18n";

export type ConnectionMeta = {
  title: string;
  level?: string;
  track: string;
  unit: string;
  href: string;
};

type Props = {
  lang: Locale;
  buildsOn: string[];
  unlocks: string[];
  deepensInto: string[];
  appearsAgainIn: string[];
  meta: Record<string, ConnectionMeta>;
};

const { lang, buildsOn, unlocks, deepensInto, appearsAgainIn, meta } = Astro.props;

type Group = {
  ids: string[];
  relKey: string;
  variant: "cn-in" | "cn-out" | "cn-deep" | "cn-spiral";
  cardClass: "" | "deep" | "spiral";
};

const groups: Group[] = [
  { ids: buildsOn,      relKey: "lesson.cn.buildsOn",      variant: "cn-in",     cardClass: "" },
  { ids: unlocks,       relKey: "lesson.cn.unlocks",        variant: "cn-out",    cardClass: "" },
  { ids: deepensInto,   relKey: "lesson.cn.deepensInto",    variant: "cn-deep",   cardClass: "deep" },
  { ids: appearsAgainIn, relKey: "lesson.cn.appearsAgainIn", variant: "cn-spiral", cardClass: "spiral" },
];

const visible = groups.filter((g) => g.ids.length > 0);
---

{visible.length > 0 && (
  <section class="cn-block" aria-label={t("lesson.cn.heading", lang)}>
    <div class="cn-heading">{t("lesson.cn.heading", lang)}</div>
    {visible.map((group) => (
      <div class="cn-group">
        <div class={`cn-rel ${group.variant}`}>{t(group.relKey, lang)}</div>
        <ul class="cn-list" role="list">
          {group.ids.map((id) => {
            const m = meta[id];
            if (!m) return null;
            return (
              <li>
                <a href={m.href} class={`cn-card${group.cardClass ? ` ${group.cardClass}` : ""}`}>
                  <span class="cn-t">{m.title}</span>
                  {m.level && <span class="cn-d">{m.level}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </section>
)}

<style>
  .cn-block {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .cn-heading {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .cn-group {
    margin-bottom: 1rem;
  }

  .cn-rel {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.375rem;
    padding-left: 2px;
  }

  .cn-in     { color: var(--ok); }
  .cn-out    { color: var(--accent); }
  .cn-deep   { color: var(--warn); }
  .cn-spiral { color: var(--muted); }

  .cn-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .cn-card {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule-strong);
    background: var(--card);
    text-decoration: none;
    transition: border-color 0.12s, background 0.12s;
  }

  .cn-card:hover {
    border-color: var(--accent);
    background: var(--card-2);
  }

  .cn-card.deep {
    border-color: oklch(70% 0.13 75 / 0.4);
    background: oklch(70% 0.13 75 / 0.06);
  }

  .cn-card.spiral {
    border-style: dashed;
  }

  .cn-t {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }

  .cn-d {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
