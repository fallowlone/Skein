---
import { t, type Locale } from "../../i18n";

export type ConnectionMeta = {
  title: string;
  level?: string;
  track: string;
  unit: string;
  href: string;
};

type Props = {
  lang: Locale;
  buildsOn: string[];
  unlocks: string[];
  deepensInto: string[];
  appearsAgainIn: string[];
  meta: Record<string, ConnectionMeta>;
};

const { lang, buildsOn, unlocks, deepensInto, appearsAgainIn, meta } = Astro.props;

type Group = {
  ids: string[];
  relKey: string;
  variant: "cn-in" | "cn-out" | "cn-deep" | "cn-spiral";
  cardClass: "" | "deep" | "spiral";
};

const groups: Group[] = [
  { ids: buildsOn,      relKey: "lesson.cn.buildsOn",      variant: "cn-in",     cardClass: "" },
  { ids: unlocks,       relKey: "lesson.cn.unlocks",        variant: "cn-out",    cardClass: "" },
  { ids: deepensInto,   relKey: "lesson.cn.deepensInto",    variant: "cn-deep",   cardClass: "deep" },
  { ids: appearsAgainIn, relKey: "lesson.cn.appearsAgainIn", variant: "cn-spiral", cardClass: "spiral" },
];

const visible = groups.filter((g) => g.ids.length > 0);
---

{visible.length > 0 && (
  <section class="cn-block" aria-label={t("lesson.cn.heading", lang)}>
    <div class="cn-heading">{t("lesson.cn.heading", lang)}</div>
    {visible.map((group) => {
      const cards = group.ids.map((id) => {
        const m = meta[id];
        if (!m) return null;
        return (
          <li>
            <a href={m.href} class={`cn-card${group.cardClass ? ` ${group.cardClass}` : ""}`}>
              <span class="cn-t">{m.title}</span>
              {m.level && <span class="cn-d">{m.level}</span>}
            </a>
          </li>
        );
      });
      // The spiral group ("appears again in") can be long — collapse it.
      if (group.variant === "cn-spiral") {
        const n = group.ids.filter((id) => meta[id]).length;
        return (
          <details class="cn-group cn-collapsible">
            <summary class={`cn-rel ${group.variant}`}>
              {t(group.relKey, lang)}<span class="cn-count">{n}</span>
            </summary>
            <ul class="cn-list" role="list">{cards}</ul>
          </details>
        );
      }
      return (
        <div class="cn-group">
          <div class={`cn-rel ${group.variant}`}>{t(group.relKey, lang)}</div>
          <ul class="cn-list" role="list">{cards}</ul>
        </div>
      );
    })}
  </section>
)}

<style>
  .cn-block {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 0.5px solid var(--hairline);
  }

  .cn-heading {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .cn-group {
    margin-bottom: 1rem;
  }

  .cn-rel {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.375rem;
    padding-left: 2px;
  }

  .cn-in     { color: var(--ok); }
  .cn-out    { color: var(--accent); }
  .cn-deep   { color: var(--warn); }
  .cn-spiral { color: var(--muted); }

  .cn-collapsible > summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    user-select: none;
  }
  .cn-collapsible > summary::-webkit-details-marker { display: none; }
  .cn-collapsible > summary::before {
    content: "\25B8";
    font-size: 9px;
    color: var(--muted);
    transition: transform 0.12s ease;
  }
  .cn-collapsible[open] > summary::before { transform: rotate(90deg); }
  .cn-collapsible[open] > summary { margin-bottom: 0.375rem; }
  .cn-count {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    color: var(--muted);
    opacity: 0.75;
  }
  @media (prefers-reduced-motion: reduce) {
    .cn-collapsible > summary::before { transition: none; }
  }

  .cn-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .cn-card {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--r-sm);
    border: 0.5px solid var(--hairline-2);
    background: var(--card);
    text-decoration: none;
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .cn-card:hover {
    border-color: var(--accent);
    background: var(--card-2);
  }

  .cn-card.deep {
    border-color: color-mix(in srgb, var(--warn) 40%, transparent);
    background: color-mix(in srgb, var(--warn) 7%, var(--card));
  }

  .cn-card.spiral {
    border-style: dashed;
  }

  .cn-t {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }

  .cn-d {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
