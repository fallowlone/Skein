---
// Static "Before this lesson" block: links to a lesson's prerequisite lessons.
// Pure presentational — refs are resolved upstream in Lesson.astro and passed in
// as { title, href } pairs (dangling refs are dropped there). Renders nothing
// when there are no resolved links, so it never adds an empty section.
import { t, type Locale } from "~/i18n";

export type PrereqLink = { title: string; href: string };

type Props = {
  lang: Locale;
  links: PrereqLink[];
};

const { lang, links } = Astro.props;
---

{links.length > 0 && (
  <nav class="pq-block" aria-label={t("lesson.prereq.heading", lang)}>
    <div class="pq-heading">{t("lesson.prereq.heading", lang)}</div>
    <ul class="pq-list" role="list">
      {links.map((l) => (
        <li>
          <a href={l.href} class="pq-card">
            <span class="pq-arrow" aria-hidden="true">↑</span>
            <span class="pq-t">{l.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .pq-block {
    margin: 0 0 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 0.5px solid var(--hairline);
  }
  .pq-heading {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.625rem;
  }
  .pq-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .pq-card {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--r-sm);
    border: 0.5px solid var(--hairline-2);
    background: var(--card);
    text-decoration: none;
    transition: border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .pq-card:hover {
    border-color: var(--accent);
    background: var(--card-2);
  }
  .pq-arrow {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ok);
    line-height: 1;
  }
  .pq-t {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }
</style>
