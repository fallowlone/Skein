---
/**
 * VisualCanvas — the wide "visual canvas" tier of the Skein editorial lesson
 * system (reading 680 / learning ~800 / canvas ~1000).
 *
 * A dedicated figure surface for technical diagrams: faint cartographic grid
 * (the Skein signature), a mono kicker, the drawing, and a centered caption.
 * No card chrome — whitespace, grid and typography do the separating.
 *
 * Server-rendered, zero hydration islands. The breakout widths live in
 * Lesson.astro (`[data-span="canvas"]`).
 *
 * Author usage in a lesson MDX:
 *   import VisualCanvas from "~/components/lesson/VisualCanvas.astro";
 *   <VisualCanvas
 *     label="What each side knows after every handshake step."
 *     caption="State is created in three steps — one round-trip, then ESTABLISHED."
 *     hue="var(--d-network)"
 *   >
 *     ...svg or diagram markup...
 *   </VisualCanvas>
 */
interface Props {
  /** aria label for the figure (what the diagram shows — a real explanation, not a title) */
  label: string;
  /** figure caption rendered below the diagram */
  caption?: string;
  /** accent hue token, e.g. var(--d-network) */
  hue?: string;
}

const { label, caption, hue } = Astro.props;
---

<figure data-lesson-visual data-span="canvas" class="vcanvas" style={hue ? `--d: ${hue};` : undefined}>
  <div class="vcanvas-kicker" aria-hidden="true">
    <span class="vcanvas-tag">Visual</span>
    <span class="vcanvas-rule"></span>
  </div>
  <div class="vcanvas-body" role="img" aria-label={label}><slot /></div>
  {caption && <figcaption class="vcanvas-cap">{caption}</figcaption>}
</figure>

<style>
  .vcanvas {
    margin: 40px 0; padding: 28px clamp(16px, 4vw, 44px) 20px;
    background:
      linear-gradient(var(--hairline) 0.5px, transparent 0.5px),
      linear-gradient(90deg, var(--hairline) 0.5px, transparent 0.5px),
      var(--paper);
    background-size: 28px 28px;
    border-top: 0.5px solid var(--hairline-2);
    border-bottom: 0.5px solid var(--hairline-2);
  }
  .vcanvas-kicker { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .vcanvas-tag {
    font-family: var(--font-mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--d, var(--accent));
    border: 0.5px solid color-mix(in srgb, var(--d, var(--accent)) 38%, transparent);
    border-radius: var(--r-sm); padding: 3px 8px; white-space: nowrap;
    background: var(--paper);
  }
  .vcanvas-rule { flex: 1; height: 0.5px; background: var(--hairline-2); }
  .vcanvas-body { overflow-x: auto; }
  .vcanvas-cap {
    margin: 16px auto 0; max-width: 62ch; text-align: center;
    font-family: var(--font-mono); font-size: 12px; line-height: 1.65; color: var(--muted);
  }
</style>
