---
import { t, type Locale } from "~/i18n";
import StreakBadge from "~/components/brand/StreakBadge.tsx";

type Props = {
  lang: Locale;
  trackSlug: string;
  trackTitle: string;
  unitOrder?: number;
  unitTitle?: string;
  lessonTitle: string;
  lessonOrder?: number;
  editorial?: boolean;
};
const { lang, trackSlug, trackTitle, unitOrder, unitTitle, lessonTitle, lessonOrder, editorial = false } = Astro.props;
// Middle crumb: "Unit 3 · Scope". Rendered only when we have a unit title.
const unitLabel = unitTitle
  ? unitOrder
    ? `${t("lesson.unit", lang)} ${unitOrder} · ${unitTitle}`
    : unitTitle
  : null;
---

<header class:list={["lesson-topbar", { "is-editorial": editorial }]}>
  {/* WAI-ARIA breadcrumb pattern: ordered list, separators drawn by CSS ::after
      (decorative, never announced), current page marked with aria-current. */}
  <nav aria-label={t("a11y.nav.breadcrumb", lang)}>
    <ol class="crumb">
      {editorial ? (
        <>
          <li><a href={`/${lang}/learn/${trackSlug}/`} class="crumb-link">{trackTitle}</a></li>
          {unitOrder && <li><span>{lang === "ru" ? `Юнит ${String(unitOrder).padStart(2, "0")}` : `Unit ${String(unitOrder).padStart(2, "0")}`}</span></li>}
          {lessonOrder && <li class="crumb-current" aria-current="page"><span>{lang === "ru" ? `Урок ${String(lessonOrder).padStart(2, "0")}` : `Lesson ${String(lessonOrder).padStart(2, "0")}`}</span></li>}
        </>
      ) : (
        <>
          <li><a href={`/${lang}/`}>{t("nav.atlas.atlas", lang)}</a></li>
          <li><a href={`/${lang}/learn/${trackSlug}/`} class="crumb-link">{trackTitle}</a></li>
          {unitLabel && <li class="crumb-unit"><span>{unitLabel}</span></li>}
          <li class="crumb-current" aria-current="page"><span>{lessonTitle}</span></li>
        </>
      )}
    </ol>
  </nav>
  {!editorial && <StreakBadge client:idle />}
  {!editorial && (
    <a class="back" href={`/${lang}/learn/${trackSlug}/`}>
      ↑ {t("lesson.backToClimb", lang)}
    </a>
  )}
</header>

<style>
  .lesson-topbar {
    display: flex; justify-content: space-between; align-items: center;
    gap: 16px; padding: 14px 0;
    border-bottom: var(--rule-w) solid var(--rule);
    flex-wrap: nowrap;
  }
  .lesson-topbar.is-editorial {
    border-bottom: 0;
    padding: 18px 0 8px;
  }
  .lesson-topbar.is-editorial .crumb {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  .lesson-topbar.is-editorial .crumb li:not(:last-child)::after {
    content: "·";
    color: var(--faint);
  }
  .lesson-topbar.is-editorial .crumb-current > span {
    color: var(--muted);
    font-weight: 500;
  }
  .lesson-topbar > nav { min-width: 0; flex: 1; }
  .crumb {
    font-family: var(--font-mono); font-size: 11.5px; color: var(--muted);
    display: flex; align-items: center; gap: 7px;
    letter-spacing: 0.02em; min-width: 0;
    margin: 0; padding: 0; list-style: none;
    overflow: hidden; white-space: nowrap;
  }
  .crumb li { display: flex; align-items: center; gap: 7px; min-width: 0; }
  /* Decorative separator — not a text node, so it is never announced. */
  .crumb li:not(:last-child)::after { content: "/"; color: var(--muted); flex: none; }
  /* Ellipsis needs a block-ish box: the flex item, not the flex li itself. */
  .crumb a,
  .crumb li > span {
    min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--ink); }
  .crumb-current > span { color: var(--ink); font-weight: 600; }
  .crumb-link {
    color: var(--muted); text-decoration: none;
  }
  .crumb-link:hover { color: var(--ink); }
  .crumb-unit { color: var(--muted); }
  /* Keep the unit segment from crowding out the lesson title on narrow widths. */
  @media (max-width: 720px) {
    .crumb-unit { display: none; }
  }
  .back {
    font-family: var(--font-mono); font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.04em; text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .lesson-topbar { flex-direction: column; align-items: flex-start; gap: 8px; padding: 12px 0; }
    .crumb, .back { font-size: 11px; }
  }
</style>
