---
import AlgoPractice from "~/components/algo/AlgoPractice.astro";
import AlgoTrace from "~/components/algo/AlgoTrace.astro";
import AnnotatedCode from "~/components/algo/AnnotatedCode.astro";
import CodeRunner from "~/components/algo/CodeRunner.astro";
import ComplexityChart from "~/components/algo/ComplexityChart.astro";
import PreparedDrillSet from "~/components/algo/PreparedDrillSet.astro";
import MachineFigure from "~/components/algo/MachineFigure.astro";
import MathRecall from "~/components/algo/MathRecall.astro";
import StructureFigure from "~/components/algo/StructureFigure.astro";
import DiagramFrame from "~/components/diagram/DiagramFrame.astro";
import EditorialDiagram from "~/components/diagram/EditorialDiagram.astro";
import FlowDiagram from "~/components/diagram/FlowDiagram.astro";
import Infographic from "~/components/diagram/Infographic.astro";
import PacketDot from "~/components/diagram/PacketDot.astro";
import Pulse from "~/components/diagram/Pulse.astro";
import SequenceDiagram from "~/components/diagram/SequenceDiagram.astro";
import StackDiagram from "~/components/diagram/StackDiagram.astro";
import Misconception from "~/components/layout/Misconception.astro";
import NumbersCard from "~/components/layout/NumbersCard.astro";
import Check from "~/components/lesson/Check.astro";
import Code from "~/components/lesson/Code.astro";
import Complexity from "~/components/lesson/Complexity.astro";
import Explanation from "~/components/lesson/Explanation.astro";
import Goal from "~/components/lesson/Goal.astro";
import Hook from "~/components/lesson/Hook.astro";
import Idea from "~/components/lesson/Idea.astro";
import Inset from "~/components/lesson/Inset.astro";
import Recap from "~/components/lesson/Recap.astro";
import Step from "~/components/lesson/Step.astro";
import Trace from "~/components/lesson/Trace.astro";
import WorkedExample from "~/components/lesson/WorkedExample.astro";
import BarModel from "~/components/math/BarModel.astro";
import FunctionPlot from "~/components/math/FunctionPlot.astro";
import NumberLine from "~/components/math/NumberLine.astro";
import PlaceValueGrid from "~/components/math/PlaceValueGrid.astro";
import PracticeSet from "~/components/math/PracticeSet.astro";
import DebugLog from "~/components/pedagogy/DebugLog.astro";
import DesignPrompt from "~/components/pedagogy/DesignPrompt.astro";
import DragOrder from "~/components/pedagogy/DragOrder.astro";
import FadedExample from "~/components/pedagogy/FadedExample.tsx";
import MetaphorComplete from "~/components/pedagogy/MetaphorComplete.astro";
import NumberDrill from "~/components/pedagogy/NumberDrill.astro";
import PersonaTag from "~/components/pedagogy/PersonaTag.astro";
import ProjectBrief from "~/components/pedagogy/ProjectBrief.astro";
import Quiz from "~/components/pedagogy/Quiz.astro";
import RFCQuiz from "~/components/pedagogy/RFCQuiz.astro";
import RetrievalDrawer from "~/components/pedagogy/RetrievalDrawer.tsx";
import TraceScenario from "~/components/pedagogy/TraceScenario.astro";
import TradeoffMatrix from "~/components/pedagogy/TradeoffMatrix.astro";
import Crux from "~/components/prose/Crux.astro";
import KeyTakeaway from "~/components/prose/KeyTakeaway.astro";
import SpiralCue from "~/components/prose/SpiralCue.astro";
import Term from "~/components/prose/Term.astro";

type JsonValue = string | number | boolean | null | JsonValue[] | { [key: string]: JsonValue };
type RenderNode =
  | { type: "text"; value: string }
  | { type: "raw"; value: string }
  | { type: "element"; name: string; props?: Record<string, JsonValue>; children?: RenderNode[] };

type DrillData = {
  track: string;
  unit: string;
  intro: Record<"en" | "ru", string>;
  problems: JsonValue[];
};

type Props = { node?: RenderNode; nodes?: RenderNode[]; drill?: DrillData | null };

const REGISTRY: Record<string, any> = {
  AlgoPractice, AlgoTrace, AnnotatedCode, BarModel, Check, Code, CodeRunner,
  Complexity, ComplexityChart, Crux, DebugLog, DesignPrompt, DiagramFrame,
  DragOrder, EditorialDiagram, Explanation, FlowDiagram, FunctionPlot,
  Goal, Hook, Idea, Infographic, Inset, KeyTakeaway, MachineFigure, MathRecall,
  MetaphorComplete, Misconception, NumberDrill, NumberLine, NumbersCard,
  PacketDot, PersonaTag, PlaceValueGrid, PracticeSet, ProjectBrief, Pulse, Quiz,
  Recap, RFCQuiz, SequenceDiagram, SpiralCue, StackDiagram, Step, StructureFigure,
  Term, Trace, TraceScenario, TradeoffMatrix, WorkedExample,
};

const NATIVE_TAGS = new Set([
  "a", "b", "blockquote", "br", "caption", "circle", "code", "defs", "del",
  "div", "em", "g", "h2", "h3", "hr", "li", "line", "marker", "ol", "p",
  "path", "polygon", "pre", "rect", "span", "strong", "sup", "svg", "table",
  "tbody", "td", "text", "th", "thead", "tr", "tspan", "ul",
]);

function propsWithoutDirectives(props: Record<string, JsonValue> | undefined): Record<string, JsonValue> {
  return Object.fromEntries(Object.entries(props ?? {}).filter(([key]) => !key.startsWith("client:")));
}

const renderNodes = Astro.props.nodes ?? (Astro.props.node ? [Astro.props.node] : []);
const drill = Astro.props.drill ?? null;
---

{renderNodes.map((node) => {
  if (node.type === "text") return node.value;
  if (node.type === "raw") return <Fragment set:html={node.value} />;

  const props = propsWithoutDirectives(node.props);
  if (node.name === "RetrievalDrawer") {
    return <RetrievalDrawer client:visible {...props as any} />;
  }
  if (node.name === "FadedExample") {
    return <FadedExample client:visible {...props as any} />;
  }
  if (node.name === "DrillSet") {
    if (!drill) throw new Error("lesson payload is missing DrillSet data");
    return <PreparedDrillSet {...props as any} data={drill as any} />;
  }

  const Component = REGISTRY[node.name];
  if (Component) {
    return (
      <Component {...props as any}>
        <Astro.self nodes={node.children ?? []} drill={drill} />
      </Component>
    );
  }

  if (!NATIVE_TAGS.has(node.name)) throw new Error(`unsupported lesson render-tree element: ${node.name}`);
  const Tag = node.name as any;
  return (
    <Tag {...props as any}>
      <Astro.self nodes={node.children ?? []} drill={drill} />
    </Tag>
  );
})}
