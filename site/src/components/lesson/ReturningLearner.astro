---
import type { Locale } from "~/i18n";
const { lang, lessonKey } = Astro.props as { lang: Locale; lessonKey: string };
const [track, unit] = lessonKey.split("/");
const recoveryHref = `/${lang}/calibrate?unit=${track}/${unit}`;
const reviewHref = `/${lang}/review/`;
const roadmapHref = `/${lang}/roadmap/`;
---

<aside class="returning" data-returning={lessonKey} hidden>
  <p>{lang === "ru"
    ? "Ты давно не возвращался к этой теме. Сначала попробуй вспомнить главную идею без подсказок."
    : "You have been away from this topic. First recall the core idea without hints."}</p>
  <nav aria-label={lang === "ru" ? "Восстановление обучения" : "Learning recovery"}>
    <a href={recoveryHref} class="recovery-link">{lang === "ru" ? "Быстрая проверка и диагностика →" : "Run a quick check and diagnostic →"}</a>
    <a href={reviewHref} class="recovery-link">{lang === "ru" ? "Повторить изученное →" : "Review what you have learned →"}</a>
    <a href={roadmapHref} class="recovery-link">{lang === "ru" ? "Открыть маршрут →" : "Open your roadmap →"}</a>
  </nav>
</aside>

<script>
  import { isReturningLearner } from "~/scripts/returning-learner";
  const key = "skein.user-state.v1";
  try {
    const state = JSON.parse(localStorage.getItem(key) || "{}");
    const el = document.querySelector<HTMLElement>("[data-returning]");
    const lessonKey = el?.dataset.returning;
    if (el && lessonKey && isReturningLearner(state.history, lessonKey)) el.removeAttribute("hidden");
  } catch (_) {}
</script>

<style>
  .returning {
    margin: 18px 0;
    padding: 12px 16px;
    border-left: 2px solid var(--accent);
    background: var(--card);
    color: var(--ink-2);
  }
  .returning p { margin: 0 0 10px; }
  .returning nav { display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .recovery-link { color: var(--accent); }
</style>
