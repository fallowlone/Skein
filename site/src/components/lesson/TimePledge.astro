---
// Time-Saved Pledge — mid-lesson supporter card (Lazyweb variant, bold_swing).
// Injected before the Crux panel of topic lessons: a personal "time saved"
// metric, a local-only pledge slider ($2–$25) and the free-continue escape.
// Rendered as an inert <template> and moved into place by a tiny script —
// the lesson body is MDX, so the layout cannot inject between paragraphs;
// no hydration island needed (lesson pages have a hydration cap).
import { t, type Locale } from "~/i18n";

type Props = { lang: Locale; estMin: number };
const { lang, estMin } = Astro.props;

const amounts = ["$2", "$5", "$10", "$25"];
const ctaTemplate = t("lesson.pledge.cta", lang); // "{n}" placeholder
---
<template id="time-pledge">
  <aside class="time-pledge" data-pledge>
    <h3 class="tp-head">{t("lesson.pledge.head", lang)}</h3>
    <p class="tp-est">{t("lesson.pledge.estimate", lang).replace("{n}", String(estMin))}</p>
    <div class="tp-scale" aria-hidden="true">
      {amounts.map((a) => <span>{a}</span>)}
    </div>
    <input
      type="range"
      class="tp-slider"
      min="0"
      max="3"
      step="1"
      value="1"
      aria-label={t("lesson.pledge.aria", lang)}
    />
    <div class="tp-actions">
      <a class="tp-cta" href={`/${lang}/account`} data-cta-template={ctaTemplate} data-amount="1">
        {ctaTemplate.replace("{n}", amounts[1])}
      </a>
      <button type="button" class="tp-free">{t("lesson.pledge.free", lang)}</button>
    </div>
    <p class="tp-note">{t("lesson.pledge.note", lang)}</p>
  </aside>
</template>

<script>
  // Move the pledge card in front of the first Crux panel of the lesson body.
  // Topic lessons only: lessons without a Crux stay pledge-free.
  (function mountPledge() {
    const tpl = document.getElementById("time-pledge");
    const content = document.querySelector(".lesson-content");
    if (!(tpl instanceof HTMLTemplateElement) || !content) return;
    const crux = content.querySelector(".crux-panel");
    if (!crux || !crux.parentNode) return;
    if (content.querySelector(".time-pledge")) return; // already mounted (HMR)

    const card = tpl.content.firstElementChild;
    if (!(card instanceof HTMLElement)) return;
    crux.parentNode.insertBefore(card, crux);

    const slider = card.querySelector<HTMLInputElement>(".tp-slider");
    const cta = card.querySelector<HTMLAnchorElement>(".tp-cta");
    const template = cta?.dataset.ctaTemplate ?? "{n}";
    const amounts = ["$2", "$5", "$10", "$25"];
    const paint = () => {
      if (!slider || !cta) return;
      const i = Number(slider.value);
      slider.style.setProperty("--fill", `${(i / 3) * 100}%`);
      cta.textContent = template.replace("{n}", amounts[i] ?? "$5");
      cta.dataset.amount = String(i);
    };
    slider?.addEventListener("input", paint);
    card.querySelector(".tp-free")?.addEventListener("click", () => card.remove());
    paint();
  })();
</script>

<style>
  .time-pledge {
    position: relative; overflow: hidden;
    margin: var(--s-6) 0; padding: var(--s-5) var(--s-5);
    background: color-mix(in srgb, var(--ok) 5%, var(--card));
    border: 0.5px solid color-mix(in srgb, var(--ok) 26%, var(--hairline-2));
    border-radius: var(--r-md);
  }
  /* decorative concentric rings, echoing the lesson plate */
  .time-pledge::before, .time-pledge::after {
    content: ""; position: absolute; border-radius: 50%;
    border: 0.5px solid color-mix(in srgb, var(--ok) 22%, transparent);
    pointer-events: none;
  }
  .time-pledge::before { width: 220px; height: 220px; right: -60px; top: -60px; }
  .time-pledge::after { width: 340px; height: 340px; right: -120px; top: -120px; }

  .time-pledge .tp-head {
    margin: 0; font-family: var(--font-display); font-size: var(--fs-h4);
    font-weight: 500; letter-spacing: -0.01em; color: var(--ink);
  }
  .time-pledge .tp-est {
    margin: var(--s-2) 0 0; font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.04em; color: var(--muted);
  }
  .time-pledge .tp-scale {
    display: flex; justify-content: space-between; margin: var(--s-5) 0 6px;
    font-family: var(--font-mono); font-size: 11px; color: var(--muted);
  }
  .time-pledge .tp-slider {
    width: 100%; height: 18px; appearance: none; -webkit-appearance: none;
    background: transparent; cursor: pointer; margin: 0;
    --fill: 33%;
  }
  .time-pledge .tp-slider::-webkit-slider-runnable-track {
    height: 4px; border-radius: var(--r-pill);
    background: linear-gradient(
      to right,
      var(--ok) var(--fill),
      color-mix(in srgb, var(--ink) 14%, transparent) var(--fill)
    );
  }
  .time-pledge .tp-slider::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 15px; height: 15px; border-radius: 50%; margin-top: -5.5px;
    background: var(--ok); border: 2px solid var(--card);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .time-pledge .tp-slider::-moz-range-track {
    height: 4px; border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .time-pledge .tp-slider::-moz-range-progress {
    height: 4px; border-radius: var(--r-pill); background: var(--ok);
  }
  .time-pledge .tp-slider::-moz-range-thumb {
    width: 13px; height: 13px; border-radius: 50%;
    background: var(--ok); border: 2px solid var(--card);
  }
  .time-pledge .tp-slider:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .time-pledge .tp-actions { display: flex; align-items: center; gap: var(--s-5); margin-top: var(--s-4); }
  .time-pledge a.tp-cta, .time-pledge button.tp-free {
    font-family: inherit; font-size: 13.5px; line-height: 1.3;
  }
  .time-pledge a.tp-cta {
    display: inline-flex; align-items: center;
    background: var(--ok); color: var(--on-accent, #fff);
    border: 0.5px solid var(--ok); border-radius: var(--r-sm);
    padding: 9px 20px; font-weight: 550; text-decoration: none;
    transition: background var(--dur-1) var(--ease);
  }
  .time-pledge a.tp-cta:hover { background: color-mix(in srgb, var(--ok) 85%, var(--ink)); text-decoration: none; }
  .time-pledge button.tp-free {
    background: none; border: 0; padding: 0; cursor: pointer;
    color: color-mix(in srgb, var(--ok) 70%, var(--ink));
    text-decoration: underline; text-underline-offset: 3px;
  }
  .time-pledge button.tp-free:hover { color: var(--ok); }
  .time-pledge .tp-note {
    margin: var(--s-3) 0 0; font-family: var(--font-mono); font-size: 10.5px;
    letter-spacing: 0.03em; color: var(--faint);
  }
</style>
