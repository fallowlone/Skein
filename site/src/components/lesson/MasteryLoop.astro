---
import type { Locale } from "~/i18n";
const { lang } = Astro.props as { lang: Locale };
const items = lang === "ru"
  ? ["Вспомни без подсказки", "Проверь модель мышления", "Примени в задаче", "Повтори позже"]
  : ["Recall without hints", "Check the mental model", "Apply to a task", "Review later"];
---

<aside class="mastery-loop" aria-label={lang === "ru" ? "Цикл освоения" : "Mastery loop"}>
  <span class="label">{lang === "ru" ? "Цикл освоения" : "Mastery loop"}</span>
  <ol>
    {items.map((item) => <li>{item}</li>)}
  </ol>
</aside>

<style>
  .mastery-loop {
    margin: 18px 0;
    padding: 14px 16px;
    border: 0.5px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--card);
  }
  .label {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--muted);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding-left: 18px;
    color: var(--ink-2);
    font-size: 14px;
  }
</style>
