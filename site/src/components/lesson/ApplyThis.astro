---
import { t, type Locale } from "~/i18n";

export type ApplyProject = {
  slug: string;
  title: string;
  pitch: string;
};

type Props = {
  lang: Locale;
  projects: ApplyProject[];
};
const { lang, projects } = Astro.props;
---

{projects.length > 0 && (
  <section class="apply-this" aria-label={t("lesson.apply.heading", lang)}>
    <p class="ap-k">{t("lesson.apply.heading", lang)}</p>
    <p class="ap-sub">{t("lesson.apply.sub", lang)}</p>
    <div class="ap-list">
      {projects.map((p) => (
        <a class="ap-card" href={`/${lang}/projects/${p.slug}`}>
          <span class="ap-title">{p.title}</span>
          <span class="ap-pitch">{p.pitch}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .apply-this {
    margin-top: 36px; padding-top: 22px;
    border-top: 0.5px solid var(--hairline);
  }
  .ap-k {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
    margin: 0 0 4px;
  }
  .ap-sub {
    font-family: var(--font-body); font-size: 13px; color: var(--muted);
    margin: 0 0 14px;
  }
  .ap-list { display: grid; gap: 10px; }
  .ap-card {
    display: flex; flex-direction: column; gap: 4px;
    border: 0.5px solid var(--hairline-2); border-radius: var(--r-md);
    padding: 14px 16px; text-decoration: none;
    transition: background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .ap-card:hover { background: var(--card-2); border-color: var(--accent); }
  .ap-title {
    font-family: var(--font-display); font-size: 16px; font-weight: 520;
    color: var(--ink);
  }
  .ap-pitch {
    font-family: var(--font-body); font-size: 13.5px; line-height: 1.5;
    color: var(--ink-2);
  }
</style>
