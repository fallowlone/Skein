---
import { t, type Locale } from "../../i18n";
type Props = { kind: "why" | "practice" | "mistake" | "edgecase"; lang: Locale };
const { kind, lang } = Astro.props;
const label = t(`lesson.inset.${kind}`, lang);
---
<details data-lesson-section="inset" class={`lk-inset ${kind}`}>
  <summary>
    <span class="lk-chev">▸</span>{label}
  </summary>
  <div class="lk-inset-body"><slot /></div>
</details>
