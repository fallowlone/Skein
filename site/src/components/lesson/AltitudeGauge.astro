---
import { t, type Locale } from "~/i18n";

type Level = "zero" | "junior" | "middle" | "senior";
type Props = { lang: Locale; level?: Level };
const { lang, level } = Astro.props;

const ORDER: Level[] = ["zero", "junior", "middle", "senior"];
const currentIdx = level ? ORDER.indexOf(level) : -1;
---

{level && (
  <div class="level-gauge" data-level={level}>
    <span class="lg-cap">{t("lesson.altitude.cap", lang)}</span>
    <div class="lg-track">
      {ORDER.map((seg, i) => {
        const state = i < currentIdx ? "done" : i === currentIdx ? "is-here" : "";
        return <span class={`lg-seg ${state}`}>{t(`lesson.altitude.${seg}`, lang)}</span>;
      })}
    </div>
  </div>
)}

<style>
  .level-gauge { margin-top: 24px; }
  .lg-cap {
    display: block; font-family: var(--font-mono); font-size: var(--fs-mono-label);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
    margin-bottom: 9px;
  }
  .lg-track { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3px; }
  .lg-seg {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em;
    text-align: center; padding: 8px 4px 0; color: var(--faint);
    border-top: 1.5px solid var(--hairline-2);
    transition: color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .lg-seg.done {
    color: var(--muted);
    border-top-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .lg-seg.is-here {
    color: var(--accent); font-weight: 500;
    border-top-color: var(--accent);
  }
</style>
