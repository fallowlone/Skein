---
import { t, type Locale } from "../../i18n";
type Props = { lang: Locale };
const { lang } = Astro.props;
---
<div data-lesson-section="check">
  <div class="font-mono text-[10px] uppercase tracking-wider text-bbg-muted font-semibold mb-2">
    {t("lesson.check", lang)}
  </div>
  <slot />
</div>
