---
import { t, type Locale } from "~/i18n";

type Props = {
  lang: Locale;
  nextHref: string | null;
  nextTitle: string | null;
  /** Link back to the personalised path/plan. */
  planHref: string;
  /** True when the *next* lesson starts a new unit (i.e. this is the last lesson of its unit). */
  unitComplete?: boolean;
  /** Href of the next unit's first lesson, when crossing a unit boundary. */
  nextUnitHref?: string | null;
};
const { lang, nextHref, nextTitle, planHref, unitComplete, nextUnitHref } = Astro.props;
---

<nav class="lesson-postnav" aria-label="lesson navigation">
  {unitComplete && (
    <p class="unit-done">
      <span class="ud-flag">{t("lesson.unitComplete", lang)}</span>
      {nextUnitHref && (
        <a class="ud-link" href={nextUnitHref}>{t("lesson.nextUnit", lang)}</a>
      )}
    </p>
  )}

  {nextHref && nextTitle && (
    <a class="next-lesson" href={nextHref}>
      <span class="np-k">{t("lesson.continue", lang)}</span>
      <span class="np-t">{nextTitle}</span>
    </a>
  )}

  <a class="back-to-plan" href={planHref}>{t("lesson.backToPlan", lang)}</a>
</nav>

<style>
  .lesson-postnav { margin-top: 22px; }
  .unit-done {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px;
    margin: 0 0 14px;
  }
  .ud-flag {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ok, var(--accent)); font-weight: 600;
  }
  .ud-link {
    font-family: var(--font-display); font-size: 14px; color: var(--ink-2);
    text-decoration: none; border-bottom: 0.5px solid var(--hairline-strong);
  }
  .ud-link:hover { color: var(--accent); border-color: var(--accent); }

  .next-lesson {
    display: flex; flex-direction: column; gap: 4px;
    border: 0.5px solid var(--hairline-2); border-radius: var(--r-md);
    padding: 14px 16px; text-align: right;
    transition: background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
    text-decoration: none;
  }
  .next-lesson:hover {
    background: var(--card-2); border-color: var(--accent);
  }
  .np-k {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);
  }
  .np-t {
    font-family: var(--font-display); font-size: 17px; font-weight: 520;
    color: var(--ink);
  }
  .back-to-plan {
    display: inline-block; margin-top: 14px;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em;
    color: var(--muted); text-decoration: none;
    border-bottom: 0.5px solid var(--hairline);
  }
  .back-to-plan:hover { color: var(--accent); border-color: var(--accent); }
</style>
