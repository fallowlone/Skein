---
/**
 * WhyThree — the "why not two messages?" question, shown as a Skein editorial
 * section with two side-by-side panels and a concise prose narrative between them.
 *
 * Two panels: TWO-MESSAGE (inactive) and THREE-MESSAGE (correct/active).
 * The "missing acknowledgement" gap is visually explicit: after two messages one
 * side holds state without confirmation, the other has sent without reply.
 *
 * Server-rendered, zero islands. The two-panel grid lives in the editorial column;
 * on narrow screens the panels stack.
 */
import VisualCanvas from "~/components/lesson/VisualCanvas.astro";

interface Props {
  label: string;
  caption?: string;
  hue?: string;
  question: string;
  two: string;       // prose describing the two-message handshake
  three: string;     // prose describing the three-message handshake
  win: string;       // what the third ACK proves
}

const { label, caption, hue, question, two, three, win } = Astro.props;

---

<VisualCanvas label={label} caption={caption} hue={hue}>
  <h2 data-lesson-section="why-three" class="why-three-h2" style={hue ? `--d: ${hue};` : undefined}>{question}</h2>
  <div class="why-three-grid" data-three-grid hidden aria-label="Two-vs-three message handshake comparison">
    <section class="why-panel why-panel--two">
      <h3>Two-message handshake</h3>
      <p class="why-panel-text">{two}</p>
    </section>
    <section class="why-panel why-panel--three">
      <h3>Three-message handshake</h3>
      <p class="why-panel-text">{three}</p>
    </section>
  </div>
  <div class="why-three-result" aria-label="What the third ACK proves">
    <p class="why-three-win">{win}</p>
  </div>
</VisualCanvas>

<script>
  function initWhyThree(root: HTMLElement) {
    const grid = root.querySelector<HTMLElement>("[data-three-grid]");
    const panels = Array.from(grid?.querySelectorAll<HTMLElement>(".why-panel") ?? []);
    const result = root.querySelector<HTMLElement>("[data-three-result]");
    if (!grid || panels.length < 2 || !result) return;
    let active = 0; // start with "two"
    function set(n: number) {
      active = n;
      panels.forEach((p, i) => { p.hidden = i !== active; });
    }
    set(0);
    // Click each panel to toggle
    panels.forEach((p, i) => {
      p.addEventListener("click", () => set(i));
    });
  }
  function init() {
    document.querySelectorAll<HTMLElement>("[data-three-grid]").forEach(initWhyThree);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>

<style>
  .why-three-h2 {
    font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 500;
    line-height: 1.25; letter-spacing: -.01em; color: var(--ink); margin: 0 0 22px;
  }
  .why-three-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; margin: 0 0 20px; }
  .why-panel { background: var(--paper); border: 0.5px solid var(--hairline-2); border-radius: var(--r-md); padding: var(--s-5); }
  .why-panel--two[data-hidden="true"] { display: none; }
  .why-panel h3 { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .why-panel-text { font-family: var(--serif); font-size: 16.5px; line-height: 1.65; color: var(--ink-2); }
  .why-three-result { background: color-mix(in srgb, var(--ok) 7%, var(--card)); border: 0.5px solid var(--ok); border-radius: var(--r-md); padding: var(--s-5); margin-top: 20px; }
  .why-three-result .why-three-win {
    font-family: var(--font-display); font-size: var(--fs-h4); font-weight: 400;
    line-height: 1.2; color: var(--ok);
  }
  @media (max-width: 560px) { .why-three-grid { grid-template-columns: 1fr; gap: 0 16px; } }
  @media (prefers-reduced-motion: no-preference) {
    .why-panel { animation: panel-in var(--dur-2) var(--ease); }
    @keyframes panel-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  }
</style>