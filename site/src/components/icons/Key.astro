---
type Props = { size?: number; class?: string };
const { size = 64, class: cls = "" } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 32" width={size} height={size / 2} class={cls} aria-hidden="true">
  <circle cx="12" cy="16" r="10" fill="#FCA5A5" stroke="#991B1B" stroke-width="1.5"/>
  <circle cx="12" cy="16" r="3" fill="#FFFFFF"/>
  <rect x="20" y="13" width="36" height="6" fill="#FCA5A5" stroke="#991B1B" stroke-width="1.5"/>
  <rect x="42" y="19" width="4" height="6" fill="#FCA5A5" stroke="#991B1B" stroke-width="1.5"/>
  <rect x="50" y="19" width="4" height="6" fill="#FCA5A5" stroke="#991B1B" stroke-width="1.5"/>
</svg>
