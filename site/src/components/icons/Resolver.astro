---
type Props = { size?: number; class?: string };
const { size = 96, class: cls = "" } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 64" width={size} height={size * 64 / 96} class={cls} aria-hidden="true">
  <rect x="2" y="6" width="60" height="52" rx="10" fill="#BBF7D0" stroke="#047857" stroke-width="1.5"/>
  <text x="32" y="38" font-family="Inter, sans-serif" font-weight="800" font-size="14" fill="#065F46" text-anchor="middle">DNS</text>
  <line x1="62" y1="20" x2="80" y2="14" stroke="#374151" stroke-width="1" stroke-dasharray="2 3"/>
  <line x1="62" y1="32" x2="80" y2="32" stroke="#374151" stroke-width="1" stroke-dasharray="2 3"/>
  <line x1="62" y1="44" x2="80" y2="50" stroke="#374151" stroke-width="1" stroke-dasharray="2 3"/>
  <circle cx="86" cy="14" r="6" fill="#BFDBFE" stroke="#1D4ED8" stroke-width="1"/>
  <circle cx="86" cy="32" r="6" fill="#BFDBFE" stroke="#1D4ED8" stroke-width="1"/>
  <circle cx="86" cy="50" r="6" fill="#BFDBFE" stroke="#1D4ED8" stroke-width="1"/>
</svg>
