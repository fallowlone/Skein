---
// src/components/diagram/FlowDiagram.astro
import DiagramFrame from "./DiagramFrame.astro";
import { placeNodes, fitColumnWidth, subBudget, wrapSub, type RawNode } from "./flow-layout";

interface Edge { from: string; to: string; label?: string }
interface Props { nodes: RawNode[]; edges: Edge[]; caption?: string; label: string; perRow?: number; hue?: string }
const { nodes, edges, caption, label, perRow = 4, hue } = Astro.props;

const placed = placeNodes(nodes, perRow);
const cols = Math.max(...placed.map((n) => n.col)) + 1;
const rows = Math.max(...placed.map((n) => n.row)) + 1;
// Box width grows with the longest label/sub (capped — the svg scales to fit),
// and the box gains a second sub line when a sub still can't fit on one.
const CW = fitColumnWidth(placed);
const budget = subBudget(CW);
const subLines = new Map(placed.map((n) => [n.id, n.sub ? wrapSub(n.sub, budget) : []]));
const anyTwoLine = [...subLines.values()].some((l) => l.length === 2);
const CH = anyTwoLine ? 64 : 52, GX = 46, GY = 40;
// Top band so a top-row edge label can sit ABOVE the boxes instead of over their text.
const PADTOP = 18;
const W = cols * CW + (cols - 1) * GX;
const H = rows * CH + (rows - 1) * GY;
const cx = (c: number) => c * (CW + GX) + CW / 2;
const cy = (r: number) => r * (CH + GY) + CH / 2;
const byId = new Map(placed.map((n) => [n.id, n]));
// Scope the arrowhead marker per instance so two diagrams on one page don't collide.
const uid = label.replace(/[^a-z0-9]/gi, "").toLowerCase().slice(0, 24) || "flow";
const arrowId = `flow-arrow-${uid}`;
// Clip an endpoint from a node centre out to its rectangle border, plus a gap,
// so the line (and its arrowhead) sit in the inter-box gap instead of under a box.
const GAP = 4;
const clip = (px: number, py: number, dx: number, dy: number): [number, number] => {
  const adx = Math.abs(dx), ady = Math.abs(dy);
  const s = Math.min(adx ? (CW / 2) / adx : Infinity, ady ? (CH / 2) / ady : Infinity);
  const len = Math.hypot(dx, dy) || 1;
  return [px + dx * s + (dx / len) * GAP, py + dy * s + (dy / len) * GAP];
};
// Lines render under the boxes; labels are kept OFF the node text entirely:
//  - horizontal-ish edge → lift the label into the gap ABOVE the higher box (a
//    label is wider than the GX gap, so at box-centre height it would overlap the
//    adjacent boxes — the original bug). The PADTOP band gives the top row room.
//  - vertical/diagonal edge → offset it to the side of the connector.
// Labels sit over the frame's --card background, so the --card halo matches.
const drawn = edges
  .map((e) => {
    const a = byId.get(e.from), b = byId.get(e.to);
    if (!a || !b) return null;
    const ax = cx(a.col), ay = cy(a.row), bx = cx(b.col), by = cy(b.row);
    const [x1, y1] = clip(ax, ay, bx - ax, by - ay);
    const [x2, y2] = clip(bx, by, ax - bx, ay - by);
    const mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
    const horizontal = Math.abs(by - ay) < CH / 2;
    let lx = mx, ly: number;
    if (horizontal) {
      const topRow = Math.min(a.row, b.row);
      ly = topRow * (CH + GY) - 6; // just above the box top edge
    } else {
      ly = my + 3;
      lx = mx + 16; // beside the vertical connector
    }
    return { x1, y1, x2, y2, lx, ly, label: e.label };
  })
  .filter((d): d is NonNullable<typeof d> => d !== null);
---
<DiagramFrame caption={caption} label={label} hue={hue}>
  <svg viewBox={`0 ${-PADTOP} ${W} ${H + PADTOP}`} class="flow" width={W} height={H + PADTOP}>
    <defs>
      <marker id={arrowId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
      </marker>
    </defs>
    {drawn.map((d) => (
      <line x1={d.x1} y1={d.y1} x2={d.x2} y2={d.y2} stroke="var(--muted)" stroke-width="1.4" marker-end={`url(#${arrowId})`} opacity="0.8" />
    ))}
    {placed.map((n) => {
      const lines = subLines.get(n.id) ?? [];
      const labelY = lines.length === 2 ? 22 : lines.length === 1 ? CH / 2 - 4 : CH / 2 + 4;
      return (
        <g transform={`translate(${n.col * (CW + GX)} ${n.row * (CH + GY)})`}>
          <rect width={CW} height={CH} rx="7" fill="var(--card-2)" stroke="var(--hairline-strong)" stroke-width="0.8" />
          <text x={CW / 2} y={labelY} text-anchor="middle" font-size="12.5" font-family="var(--font-body)" fill="var(--ink)">{n.label}</text>
          {lines.map((line, i) => (
            <text x={CW / 2} y={lines.length === 2 ? 38 + i * 12 : CH / 2 + 12} text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--muted)">{line}</text>
          ))}
        </g>
      );
    })}
    {/* Edge labels last — lifted into the gap above/beside the connector (never over
        node text), with a --card halo matching the frame background. */}
    {drawn.map((d) => d.label && (
      <text
        x={d.lx} y={d.ly} text-anchor="middle"
        font-size="10.5" font-family="var(--font-mono)" fill="var(--muted)"
        stroke="var(--card)" stroke-width="3.5" stroke-linejoin="round"
        style="paint-order: stroke;"
      >{d.label}</text>
    ))}
  </svg>
</DiagramFrame>
<style>.flow { display: block; margin: 0 auto; max-width: 100%; height: auto; }</style>
