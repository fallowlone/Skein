---
/**
 * HandshakeStepper — the handshake as a first-class Skein visual.
 *
 * Answers "what exactly does each side know after each step?" State snapshots
 * are shown explicitly per step (state / seq / peer-seq) with the Skein
 * semantic colors: gray = inactive, amber = transitional, green = established.
 * Arrows: solid ink = the current message, gray dashed = not yet sent.
 *
 * Interaction is progressive enhancement via an inline <script> (the Quiz
 * pattern): with JS the learner steps through Prev/Next; without JS all three
 * steps render stacked and fully readable. Zero hydration islands.
 *
 * Protocol facts are language-neutral and hardcoded; only UI chrome strings
 * and the per-step notes travel as props so EN/RU lessons pass their own copy.
 */
import VisualCanvas from "~/components/lesson/VisualCanvas.astro";

interface SideState { state: string; seq: string; peer: string }
interface StepMsg { from: string; to: string; text: string }

interface Props {
  label: string;
  caption?: string;
  hue?: string;
  clientLabel?: string;
  serverLabel?: string;
  unknownLabel: string;
  prevLabel: string;
  nextLabel: string;
  stepLabel: string;
  ofLabel: string;
  stateLabel: string;
  seqLabel: string;
  peerLabel: string;
  /** per-step serif annotation, one per step */
  notes: [string, string, string];
}

const {
  label, caption, hue,
  clientLabel = "Client", serverLabel = "Server",
  unknownLabel, prevLabel, nextLabel, stepLabel, ofLabel,
  stateLabel, seqLabel, peerLabel, notes,
} = Astro.props;

const U = unknownLabel;
const steps: { msg: StepMsg; client: SideState; server: SideState }[] = [
  {
    msg: { from: "Client", to: "Server", text: "SYN · seq=x" },
    client: { state: "SYN-SENT", seq: "x", peer: U },
    server: { state: "SYN-RECEIVED", seq: "—", peer: "x" },
  },
  {
    msg: { from: "Server", to: "Client", text: "SYN-ACK · seq=y ack=x+1" },
    client: { state: "ESTABLISHED", seq: "x", peer: "y" },
    server: { state: "SYN-RECEIVED", seq: "y", peer: "x" },
  },
  {
    msg: { from: "Client", to: "Server", text: "ACK · ack=y+1" },
    client: { state: "ESTABLISHED", seq: "x+1", peer: "y" },
    server: { state: "ESTABLISHED", seq: "y", peer: "x+1" },
  },
];

function stateTone(state: string): "idle" | "transit" | "done" {
  if (state === "ESTABLISHED") return "done";
  if (state === "CLOSED" || state === "LISTEN") return "idle";
  return "transit";
}

const LANE_L = 110, LANE_R = 450;
const ARROW_Y = [64, 112, 160];
const uid = `hs${Math.abs([...label].reduce((a, c) => (a * 33 + c.charCodeAt(0)) | 0, 7)) % 10000}`;
---

<VisualCanvas label={label} caption={caption} hue={hue}>
  <div class="stepper" data-stepper>
    <div class="stepper-panels" aria-live="polite">
      {steps.map((s, i) => (
        <section class="step-panel" data-step-panel={i} aria-label={`${stepLabel} ${i + 1} ${ofLabel} 3`}>
          <p class="step-head">
            <span class="step-k">{stepLabel} {i + 1} {ofLabel} 3</span>
            <code class="step-msg">{s.msg.from} → {s.msg.to} · {s.msg.text}</code>
          </p>
          <svg viewBox="0 0 560 196" class="step-svg" aria-hidden="true">
            <defs>
              <marker id={`${uid}-a${i}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
              </marker>
            </defs>
            {[clientLabel, serverLabel].map((name, k) => (
              <g>
                <circle cx={k === 0 ? LANE_L : LANE_R} cy="26" r="9" class="node" />
                <text x={k === 0 ? LANE_L : LANE_R} y="30" text-anchor="middle" font-size="9" font-family="var(--font-mono)" class="node-t">{(k === 0 ? "C" : "S")}</text>
                <text x={k === 0 ? LANE_L : LANE_R} y="52" text-anchor="middle" font-size="11" font-family="var(--font-mono)" class="actor">{name}</text>
                <line x1={k === 0 ? LANE_L : LANE_R} y1="60" x2={k === 0 ? LANE_L : LANE_R} y2="190" class="lane" stroke-dasharray="3 4" />
              </g>
            ))}
            {steps.map((m, k) => {
              const fwd = m.msg.from === "Client";
              const x1 = fwd ? LANE_L : LANE_R, x2 = fwd ? LANE_R : LANE_L;
              const cls = k === i ? "wire now" : k < i ? "wire past" : "wire future";
              const dashCls = k > i ? "wire-future" : undefined;
              return (
                <g class={cls}>
                  <line x1={x1} y1={ARROW_Y[k]} x2={x2} y2={ARROW_Y[k]} marker-end={`url(#${uid}-a${i})`}
                    class={dashCls} style={dashCls ? "stroke-dasharray: 5 5;" : undefined} />
                  <text x={(x1 + x2) / 2} y={ARROW_Y[k] - 7} text-anchor="middle" font-size="11" font-family="var(--font-mono)">{m.msg.text}</text>
                </g>
              );
            })}
          </svg>
          <div class="state-grid">
            {[{ name: clientLabel, side: s.client }, { name: serverLabel, side: s.server }].map(({ name, side }) => (
              <div class="side" data-tone={stateTone(side.state)}>
                <p class="side-name">{name}</p>
                <dl class="kv">
                  <div><dt>{stateLabel}</dt><dd><span class="pill">{side.state}</span></dd></div>
                  <div><dt>{seqLabel}</dt><dd><code>{side.seq}</code></dd></div>
                  <div><dt>{peerLabel}</dt><dd><code>{side.peer}</code></dd></div>
                </dl>
              </div>
            ))}
          </div>
          <p class="step-note">{notes[i]}</p>
        </section>
      ))}
    </div>
    <div class="stepper-bar" data-stepper-bar hidden>
      <button type="button" class="stp-btn" data-step-prev>← {prevLabel}</button>
      <div class="stp-dots" role="group" aria-label={`${stepLabel} · 1–3`}>
        {steps.map((s, i) => (
          <button type="button" class="stp-dot" data-step-dot={i} aria-label={`${stepLabel} ${i + 1}: ${s.msg.text}`}></button>
        ))}
      </div>
      <button type="button" class="stp-btn" data-step-next>{nextLabel} →</button>
    </div>
  </div>
</VisualCanvas>

<script>
  function initStepper(root: HTMLElement) {
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-step-panel]"));
    const bar = root.querySelector<HTMLElement>("[data-stepper-bar]");
    const prev = root.querySelector<HTMLButtonElement>("[data-step-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-step-next]");
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-step-dot]"));
    if (panels.length === 0 || !bar || !prev || !next) return;
    const prevButton = prev;
    const nextButton = next;
    let current = 0;
    function show(n: number) {
      current = Math.max(0, Math.min(panels.length - 1, n));
      panels.forEach((p, i) => { p.hidden = i !== current; });
      dots.forEach((d, i) => {
        const on = i === current;
        d.classList.toggle("on", on);
        d.setAttribute("aria-current", on ? "true" : "false");
      });
      prevButton.disabled = current === 0;
      nextButton.disabled = current === panels.length - 1;
    }
    root.setAttribute("data-stepper-active", "true");
    bar.hidden = false;
    prevButton.addEventListener("click", () => show(current - 1));
    nextButton.addEventListener("click", () => show(current + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => show(i)));
    show(0);
  }
  function init() {
    document.querySelectorAll<HTMLElement>("[data-stepper]").forEach(initStepper);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>

<style>
  .stepper { max-width: 720px; margin: 0 auto; }
  .step-panel { background: var(--paper); }
  .step-panel + .step-panel { margin-top: 40px; }
  .stepper[data-stepper-active] .step-panel + .step-panel { margin-top: 0; }
  .step-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin: 0 0 12px; }
  .step-k {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
  .step-msg {
    font-family: var(--font-mono); font-size: 13px; color: var(--ink);
    background: var(--card); border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm); padding: 3px 10px;
  }
  .step-svg { display: block; width: 100%; height: auto; }
  .step-svg .node { fill: var(--ink); }
  .step-svg .node-t { fill: var(--paper); font-weight: 700; }
  .step-svg .actor { fill: var(--ink); font-weight: 600; }
  .step-svg .lane { stroke: var(--hairline-strong); stroke-width: 1; }
  .step-svg .wire { stroke-width: 1.6; }
  .step-svg .wire text { fill: var(--ink-2); }
  .step-svg .wire.now { color: var(--ink); stroke: var(--ink); }
  .step-svg .wire.now text { fill: var(--ink); font-weight: 700; }
  .step-svg .wire.past { color: var(--muted); stroke: var(--muted); }
  .step-svg .wire.past text { fill: var(--muted); }
  .step-svg .wire.future { color: var(--muted); stroke: var(--muted); opacity: 0.55; }
  .step-svg .wire.future text { fill: var(--muted); }
  .state-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
  .side { border-top: 2px solid var(--hairline-strong); padding-top: 10px; }
  .side[data-tone="transit"] { border-top-color: var(--warn); }
  .side[data-tone="done"] { border-top-color: var(--ok); }
  .side-name {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px;
  }
  .kv { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .kv > div { display: flex; align-items: baseline; gap: 10px; }
  .kv dt { font-family: var(--font-mono); font-size: 11px; color: var(--muted); min-width: 74px; }
  .kv dd { margin: 0; }
  .kv code { font-family: var(--font-mono); font-size: 12.5px; color: var(--ink); }
  .pill {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.04em;
    border-radius: var(--r-pill); padding: 2px 10px; white-space: nowrap;
    background: color-mix(in srgb, var(--ink) 8%, transparent); color: var(--ink-2);
  }
  .side[data-tone="transit"] .pill { background: color-mix(in srgb, var(--warn) 22%, transparent); color: var(--ink); }
  .side[data-tone="done"] .pill { background: color-mix(in srgb, var(--ok) 20%, transparent); color: var(--ok); }
  .step-note {
    font-family: var(--font-display); font-style: italic; font-size: 16.5px;
    line-height: 1.6; color: var(--ink-2); margin: 14px 0 0; max-width: 58ch;
  }
  .stepper-bar {
    display: flex; align-items: center; gap: 16px; margin-top: 22px;
    border-top: 0.5px solid var(--hairline-2); padding-top: 16px;
  }
  .stepper-bar[hidden] { display: none; }
  .stp-btn {
    min-height: 40px; min-width: 96px; padding: 0 18px; cursor: pointer;
    font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--ink);
    background: var(--card); border: 0.5px solid var(--hairline-strong); border-radius: var(--r-pill);
  }
  .stp-btn:hover:not(:disabled) { border-color: var(--ink); }
  .stp-btn:disabled { opacity: 0.4; cursor: default; }
  .stp-btn:focus-visible, .stp-dot:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .stp-dots { display: flex; gap: 10px; margin: 0 auto; }
  .stp-dot {
    width: 32px; height: 32px; border-radius: 50%; cursor: pointer;
    background: transparent; border: 1.5px solid var(--hairline-strong); padding: 0;
  }
  .stp-dot.on { background: var(--ink); border-color: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    .step-panel { animation: step-in var(--dur-2) var(--ease); }
    @keyframes step-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  }
  @media (max-width: 560px) {
    .state-grid { grid-template-columns: 1fr; }
    .stp-btn { min-width: 0; }
  }
</style>
