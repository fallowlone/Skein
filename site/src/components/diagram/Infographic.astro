---
// src/components/diagram/Infographic.astro
// Inlines a pre-generated AntV Infographic SVG (see scripts/gen-infographics.mjs).
// Zero client JS, zero hydration island. Reuses DiagramFrame so it satisfies the
// lesson linter's `data-lesson-visual` requirement and matches the diagram kit's
// frame/caption/hue styling. Author DSL in a sibling `infographics/<name>.infographic`,
// run `bun run gen:infographics`, then:
//   import Infographic from "~/components/diagram/Infographic.astro";
//   import overhead from "./infographics/storage-overhead.svg?raw";
//   <Infographic svg={overhead} label="…" caption="…" />
import DiagramFrame from "./DiagramFrame.astro";
interface Props {
  /** Raw SVG string, imported with Vite's `?raw` from a generated sibling .svg. */
  svg: string;
  /** Screen-reader label — required (the SVG content is not semantic). */
  label: string;
  caption?: string;
  hue?: string;
}
const { svg, label, caption, hue } = Astro.props;

// AntV lays a template out at whatever size it needs and ignores a `width`
// passed to renderToString — trees in particular come out 1000–4300px wide.
// A blanket `max-width:100%` then scaled them down into the 680px article
// column, shrinking 14px labels to ~2.5px: present, but unreadable.
//
// So measure the generated canvas here (build time, no JS) and pick a mode:
//  - fits the column → scale down as before;
//  - wider → render 1:1 and let the frame scroll horizontally, so labels keep
//    their authored size and the reader pans instead of squinting.
// Below the threshold the downscale is still ≥ ~0.85, which stays legible.
const SCROLL_ABOVE = 800;
const width = Number(svg.match(/<svg[^>]*\bwidth="(\d+(?:\.\d+)?)"/)?.[1] ?? 0);
const scroll = width > SCROLL_ABOVE;

// The drawing is one labelled image (DiagramFrame carries role="img" + label),
// so its internals must not be walked by assistive tech. Marked here rather than
// in the generator so no committed SVG needs regenerating.
const svgHtml = svg.replace(/<svg\b(?![^>]*\baria-hidden=)/, '<svg aria-hidden="true"');
---
<DiagramFrame label={label} caption={caption} hue={hue}>
  <div
    class:list={["ig", { "ig-scroll": scroll }]}
    style={scroll ? `--ig-w: ${width}px;` : undefined}
    set:html={svgHtml}
  />
</DiagramFrame>
<style>
  /* color drives currentColor for the neutral text remapped at generation time,
     so titles/labels follow the active light/dark theme. */
  .ig { color: var(--ink); }
  .ig :global(svg) { display: block; margin: 0 auto; max-width: 100%; height: auto; }
  /* Oversized canvas: hold natural size; .dframe-body is the scroll container. */
  .ig-scroll { width: var(--ig-w); }
  .ig-scroll :global(svg) { width: var(--ig-w); max-width: none; margin: 0; }
  .ig :global(text),
  .ig :global(tspan),
  .ig :global(foreignObject span) { font-family: var(--font-body); }
</style>
