---
import Pulse from "./Pulse.astro";
import Server from "../icons/Server.astro";
import Database from "../icons/Database.astro";
import Monitor from "../icons/Monitor.astro";
import Globe from "../icons/Globe.astro";
import Cloud from "../icons/Cloud.astro";
import Resolver from "../icons/Resolver.astro";
import Lock from "../icons/Lock.astro";
import Key from "../icons/Key.astro";
import Doc from "../icons/Doc.astro";

type IconName = "server" | "database" | "monitor" | "globe" | "cloud" | "resolver" | "lock" | "key" | "doc";
type Props = { id: string; icon: IconName; label: string; pulse?: boolean; size?: number };
const { id, icon, label, pulse = true, size = 80 } = Astro.props;

const ICONS = {
  server: Server,
  database: Database,
  monitor: Monitor,
  globe: Globe,
  cloud: Cloud,
  resolver: Resolver,
  lock: Lock,
  key: Key,
  doc: Doc,
};
const Icon = ICONS[icon];
if (!Icon) throw new Error(`Unknown icon: ${icon}`);
---
<div id={id} class="inline-flex flex-col items-center gap-2 group transition hover:-translate-y-0.5">
  {pulse ? <Pulse><Icon size={size} /></Pulse> : <Icon size={size} />}
  <span class="text-sm font-semibold text-ink">{label}</span>
</div>
