---
/**
 * EditorialDiagram — lesson-facing wrapper around the editorial scene engine.
 *
 * Renders one of the editorial scene archetypes (paper + grid + dashed arc +
 * serif hero + mono labels) as a STATIC SVG: `<GrammarDiagram>` is a Preact
 * component used with NO client directive, so Astro renders it to plain HTML at
 * build time — zero hydration islands. CSS draw-animations are skipped via
 * `reducedMotion` (final-frame appearance), matching no-JS readers.
 *
 * Wrapped in `DiagramFrame`, so it carries `data-lesson-visual` (satisfies the
 * lesson visual lint rule), a figure caption, an aria label, and a hue accent.
 *
 * Author usage in a lesson MDX (between </Explanation> and <KeyTakeaway>):
 *   import EditorialDiagram from "~/components/diagram/EditorialDiagram.astro";
 *   <EditorialDiagram
 *     kind="arc"
 *     genre="present perfect"
 *     hero="shipped"
 *     labels={["past", "now", "future"]}
 *     note="it's live now"
 *     label="A finished action whose result is live in the present."
 *     caption="The arc lands on NOW: the past act, the present result."
 *     hue="var(--d-systems, var(--accent))"
 *   />
 */
import GrammarDiagram from "~/components/english/GrammarDiagram";
import DiagramFrame from "~/components/diagram/DiagramFrame.astro";
import { ARCHETYPE_BUILDERS, ALIASES } from "~/english/animations/archetype-map";
import type { DiagramInput } from "~/english/animations/editorial/diagram-input";

interface Props {
  /** archetype key: arc | timeline | contrast-pair | transformation | map | branch | scale | swap | highlight | slot-fill */
  kind: string;
  /** aria label for the figure + the SVG (what the diagram shows) */
  label: string;
  /** figure caption rendered below the diagram */
  caption?: string;
  /** accent hue token, e.g. var(--d-systems, var(--accent)) */
  hue?: string;
  /** mono caps tag, top-left (usually the lesson's topic) */
  genre?: string;
  /** mono formula strip under the header */
  formula?: string;
  /** serif emphasis word inside the diagram */
  hero?: string;
  /** small italic note rendered INSIDE the svg (distinct from the figure caption) */
  note?: string;
  /** archetype labels (ticks, chips, tokens — meaning depends on kind) */
  labels?: string[];
  /** archetype items (e.g. "a→b" pairs for map) */
  items?: string[];
  /** focus token index for the highlight archetype */
  focus?: number;
}

const { kind, label, caption, hue, genre, formula, hero, note, labels, items, focus } = Astro.props;

const canonical = ALIASES[kind] ?? kind;
const builder = ARCHETYPE_BUILDERS[canonical];
if (!builder) {
  throw new Error(
    `EditorialDiagram: unknown kind "${kind}". Valid: ${Object.keys(ARCHETYPE_BUILDERS).join(", ")} (aliases: ${Object.keys(ALIASES).join(", ")}).`,
  );
}

// `family` is only read by the grammar-coupled timeline builder; general
// archetypes ignore it. The cast keeps grammar types out of lesson authoring.
const input = {
  archetype: canonical,
  family: "general",
  genre: genre ?? "",
  formula,
  hero,
  caption: note,
  labels: labels ?? [],
  items: items ?? [],
  focus,
} as unknown as DiagramInput;

const scene = builder(input);
---

<DiagramFrame label={label} caption={caption} hue={hue}>
  <GrammarDiagram scene={scene} label={label} reducedMotion={true} />
</DiagramFrame>
