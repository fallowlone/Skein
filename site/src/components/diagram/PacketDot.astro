---
// NOTE: no <script> here on purpose. This component renders inside an inline
// <svg>, so a script emitted at the component's position becomes an
// SVGScriptElement — which never executes `type="module"`. The animation is
// booted from src/layouts/Lesson.astro (page-level HTML context) instead.
type Props = { color?: string; durationMs?: number; delayMs?: number; size?: number };
const { color = "var(--d-network)", durationMs = 1800, delayMs = 0, size = 8 } = Astro.props;
---
<circle
  data-packet
  data-duration={String(durationMs)}
  data-delay={String(delayMs)}
  cx="0"
  cy="0"
  r={size / 2}
  fill={color}
  opacity="0"
/>
