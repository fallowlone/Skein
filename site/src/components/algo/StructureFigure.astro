---
type Cell = { value: string; mark?: "active" | "done" | "target" };
type Props = { cells: (Cell | string)[]; indices?: boolean; caption?: string };
const { cells, indices = true, caption } = Astro.props;
const norm = cells.map((c) => (typeof c === "string" ? { value: c } : c));
const fill = (m?: string) =>
  m === "active" ? "bg-accent-ghost border-accent"
  : m === "done" ? "bg-card-2 border-ok"
  : m === "target" ? "bg-card-2 border-warn"
  : "bg-card border-hairline-2";
---
<figure data-lesson-visual class="my-6">
  <div class="flex gap-1.5 justify-center flex-wrap">
    {norm.map((c, i) => (
      <div class="flex flex-col items-center gap-1">
        <div class={`w-12 h-12 grid place-items-center rounded-[var(--r-sm)] border-[0.5px] font-mono text-[14px] text-ink ${fill(c.mark)}`}>
          {c.value}
        </div>
        {indices && <span class="font-mono text-[10px] text-faint">{i}</span>}
      </div>
    ))}
  </div>
  {caption && <figcaption class="mt-2 text-center text-[12px] text-muted">{caption}</figcaption>}
</figure>
