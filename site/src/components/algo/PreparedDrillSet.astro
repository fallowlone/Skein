---
import DrillBoard from "./DrillBoard.tsx";
import type { Locale } from "~/i18n";

type DrillData = {
  track: string;
  unit: string;
  intro: Record<Locale, string>;
  problems: unknown[];
};

type Props = { unitKey: string; lang: Locale; data: DrillData };
const { unitKey, lang, data } = Astro.props;

if (`${data.track}/${data.unit}` !== unitKey) {
  throw new Error(`PreparedDrillSet: payload does not match "${unitKey}"`);
}
---

<p class="text-[14px] text-ink-2 mb-4">{data.intro[lang]}</p>
<DrillBoard client:visible lang={lang} problems={data.problems as any} unit={data.unit} />
