---
import { t, type Locale } from "../../i18n";

type Cell = { value: string; mark?: "active" | "done" | "target" };
type Frame = { caption: string; line?: number; cells: (Cell | string)[] };
type Props = { id: string; lang: Locale; code: string[]; frames: Frame[] };

const { id, lang, code, frames } = Astro.props;
const norm = frames.map((f) => ({
  ...f,
  cells: f.cells.map((c) => (typeof c === "string" ? { value: c } : c)),
}));
---
<figure id={id} data-lesson-visual data-algo-trace class="algo-trace">
  <div class="at-code">
    {code.map((ln, i) => (
      <div data-code-line={i + 1} class="at-row">
        <span class="at-ln">{i + 1}</span>
        <code class="at-src">{ln === "" ? " " : ln}</code>
      </div>
    ))}
  </div>

  <div data-trace-cells class="at-cells"></div>
  <p data-trace-caption class="at-caption"></p>

  <div class="at-nav">
    <button type="button" data-trace-prev aria-label={t("trace.prev", lang)} class="at-btn">&lsaquo;</button>
    <span data-trace-status class="at-status"></span>
    <button type="button" data-trace-next aria-label={t("trace.next", lang)} class="at-btn">&rsaquo;</button>
  </div>

  <script type="application/json" data-trace-frames set:html={JSON.stringify(norm)} />
  <script type="application/json" data-trace-label set:html={JSON.stringify(t("trace.step", lang))} />
</figure>

<style>
  .algo-trace {
    --at-radius: 12px;
    margin: 32px 0;
    padding: 16px;
    background: var(--card);
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--at-radius);
  }
  .at-code {
    overflow-x: auto;
    padding: 12px 0;
    background: var(--card-2);
    border: 0.5px solid var(--hairline);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
  }
  .at-row {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 4px;
    align-items: baseline;
    border-left: 2px solid transparent;
    transition: background 0.18s ease, border-color 0.18s ease;
  }
  .at-ln {
    text-align: right;
    padding-right: 14px;
    color: var(--faint);
    user-select: none;
    font-size: 11.5px;
  }
  .at-src {
    white-space: pre;
    color: var(--ink-2);
    padding-right: 18px;
  }
  /* highlighted (active) line — toggled by the stepper */
  .at-row.is-active {
    background: color-mix(in srgb, var(--accent) 10%, var(--card-2));
    border-left-color: var(--accent);
  }
  .at-row.is-active .at-ln { color: var(--accent); }
  .at-row.is-active .at-src { color: var(--ink); }

  .at-cells {
    display: flex;
    gap: 6px;
    justify-content: center;
    flex-wrap: wrap;
    min-height: 3.25rem;
    margin-top: 18px;
  }
  .at-caption {
    margin: 12px auto 0;
    max-width: 46ch;
    text-align: center;
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--muted);
    min-height: 1.4rem;
  }
  .at-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 14px;
  }
  .at-btn {
    width: 34px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-sm, 6px);
    background: var(--card);
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }
  .at-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-ghost);
  }
  .at-btn:disabled { opacity: 0.35; cursor: default; }
  .at-status {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    min-width: 8ch;
    text-align: center;
  }
</style>

<script>
  type Cell = { value: string; mark?: "active" | "done" | "target" };
  type Frame = { caption: string; line?: number; cells: Cell[] };

  function markClass(m?: string): string {
    if (m === "active") return "bg-[color:var(--accent-ghost)] border-[color:var(--accent)] text-[color:var(--ink)]";
    if (m === "done") return "bg-[color:color-mix(in_srgb,var(--ok)_14%,var(--card))] border-[color:var(--ok)] text-[color:var(--ink)]";
    if (m === "target") return "bg-[color:color-mix(in_srgb,var(--warn)_14%,var(--card))] border-[color:var(--warn)] text-[color:var(--ink)]";
    return "bg-card border-[color:var(--hairline-strong)] text-[color:var(--ink-2)]";
  }

  function initTrace(root: HTMLElement) {
    const framesEl = root.querySelector<HTMLElement>("[data-trace-frames]");
    const labelEl = root.querySelector<HTMLElement>("[data-trace-label]");
    if (!framesEl || !labelEl) return;
    const frames: Frame[] = JSON.parse(framesEl.textContent || "[]");
    const stepLabel: string = JSON.parse(labelEl.textContent || '"Step"');
    if (frames.length === 0) return;

    const cellsBox = root.querySelector<HTMLElement>("[data-trace-cells]")!;
    const caption = root.querySelector<HTMLElement>("[data-trace-caption]")!;
    const status = root.querySelector<HTMLElement>("[data-trace-status]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-trace-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-trace-next]")!;
    const codeRows = Array.from(root.querySelectorAll<HTMLElement>("[data-code-line]"));
    let i = 0;

    function render() {
      const f = frames[i];
      cellsBox.innerHTML = "";
      for (const c of f.cells) {
        const cell = document.createElement("div");
        cell.className =
          "w-12 h-12 grid place-items-center rounded-[7px] border-2 font-mono text-[14px] " +
          markClass(c.mark);
        cell.textContent = c.value;
        cellsBox.appendChild(cell);
      }
      caption.textContent = f.caption;
      status.textContent = `${stepLabel} ${i + 1} / ${frames.length}`;
      codeRows.forEach((el) => {
        const on = f.line !== undefined && Number(el.dataset.codeLine) === f.line;
        el.classList.toggle("is-active", on);
      });
      prev.disabled = i === 0;
      next.disabled = i === frames.length - 1;
    }

    prev.addEventListener("click", () => { if (i > 0) { i -= 1; render(); } });
    next.addEventListener("click", () => { if (i < frames.length - 1) { i += 1; render(); } });
    render();
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-algo-trace]").forEach(initTrace);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
