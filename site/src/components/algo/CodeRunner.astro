---
import { t, type Locale } from "../../i18n";
type Props = { id: string; lang: Locale; code: string };
const { id, lang, code } = Astro.props;
const starter = code.replace(/\n$/, "");
const rows = Math.min(Math.max(starter.split("\n").length + 1, 4), 22);
---
<section id={id} data-code-runner class="coderunner">
  <textarea data-code-input rows={rows} spellcheck="false" class="cr-input">{starter}</textarea>
  <div class="cr-actions">
    <button type="button" data-code-run class="btn">{t("coderunner.run", lang)}</button>
    <button type="button" data-code-reset class="btn ghost">{t("coderunner.reset", lang)}</button>
  </div>
  <div class="cr-out-wrap">
    <div class="cr-out-label">{t("coderunner.output", lang)}</div>
    <pre data-code-output class="cr-output"></pre>
  </div>
  <script type="application/json" data-code-starter set:html={JSON.stringify(starter)} />
</section>

<style>
  .coderunner {
    margin: 32px 0;
    padding: 16px;
    background: var(--card);
    border: 0.5px solid var(--hairline-2);
    border-radius: 12px;
  }
  .cr-input {
    width: 100%;
    resize: vertical;
    padding: 12px 14px;
    background: var(--card-2);
    border: 0.5px solid var(--hairline);
    border-radius: 8px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    tab-size: 2;
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .cr-input:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .cr-actions { display: flex; gap: 10px; margin-top: 12px; }
  .cr-out-wrap { margin-top: 16px; }
  .cr-out-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 6px;
  }
  .cr-output {
    overflow-x: auto;
    min-height: 2.75rem;
    padding: 12px 14px;
    background: var(--card-2);
    border: 0.5px solid var(--hairline);
    border-left: 2px solid var(--accent);
    border-radius: 8px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.65;
    white-space: pre-wrap;
  }
</style>

<script>
  // User code runs inside a QuickJS WASM sandbox (no native eval), so the page
  // CSP needs only 'wasm-unsafe-eval' — never 'unsafe-eval'. The sandbox has no
  // DOM / network / cookie access; the only host binding is console.*.
  function fmt(a: unknown): string {
    if (typeof a === "string") return a;
    try { return JSON.stringify(a); } catch { return String(a); }
  }

  async function runUserCode(source: string): Promise<string> {
    const lines: string[] = [];
    try {
      const { getQuickJS } = await import("quickjs-emscripten"); // code-split WASM
      const QuickJS = await getQuickJS();
      const vm = QuickJS.newContext();
      const logFn = vm.newFunction("log", (...args) => {
        lines.push(args.map((a) => fmt(vm.dump(a))).join(" "));
      });
      const consoleObj = vm.newObject();
      for (const m of ["log", "error", "warn", "info"]) vm.setProp(consoleObj, m, logFn);
      vm.setProp(vm.global, "console", consoleObj);
      consoleObj.dispose(); logFn.dispose();

      const result = vm.evalCode(source);
      if (result.error) {
        const msg = vm.dump(result.error);
        result.error.dispose();
        lines.push(`⚠ ${typeof msg === "string" ? msg : (msg && (msg as any).message) || JSON.stringify(msg)}`);
      } else {
        result.value.dispose();
      }
      vm.dispose();
    } catch (err) {
      lines.push(`⚠ ${err instanceof Error ? err.message : String(err)}`);
    }
    return lines.length ? lines.join("\n") : "—";
  }

  function initRunner(root: HTMLElement) {
    const input = root.querySelector<HTMLTextAreaElement>("[data-code-input]")!;
    const output = root.querySelector<HTMLElement>("[data-code-output]")!;
    const runBtn = root.querySelector<HTMLButtonElement>("[data-code-run]")!;
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-code-reset]")!;
    const starterEl = root.querySelector<HTMLElement>("[data-code-starter");
    const starter: string = starterEl ? JSON.parse(starterEl.textContent || '""') : "";

    runBtn.addEventListener("click", async () => {
      if (runBtn.disabled) return;
      runBtn.disabled = true;
      const prev = output.textContent;
      output.textContent = "…";
      try {
        output.textContent = await runUserCode(input.value);
      } catch {
        output.textContent = prev;
      } finally {
        runBtn.disabled = false;
      }
    });
    resetBtn.addEventListener("click", () => {
      input.value = starter;
      output.textContent = "";
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "Tab") {
        e.preventDefault();
        const s = input.selectionStart, end = input.selectionEnd;
        input.value = input.value.slice(0, s) + "  " + input.value.slice(end);
        input.selectionStart = input.selectionEnd = s + 2;
      }
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-code-runner]").forEach(initRunner);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
