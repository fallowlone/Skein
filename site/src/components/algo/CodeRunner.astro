---
import { t, type Locale } from "../../i18n";
type Props = { id: string; lang: Locale; code: string };
const { id, lang, code } = Astro.props;
const starter = code.replace(/\n$/, "");
const rows = Math.min(Math.max(starter.split("\n").length + 1, 4), 22);
---
<section id={id} data-code-runner class="coderunner">
  <textarea data-code-input rows={rows} spellcheck="false" class="cr-input">{starter}</textarea>
  <div class="cr-actions">
    <button type="button" data-code-run class="btn">{t("coderunner.run", lang)}</button>
    <button type="button" data-code-reset class="btn ghost">{t("coderunner.reset", lang)}</button>
  </div>
  <div class="cr-out-wrap">
    <div class="cr-out-label">{t("coderunner.output", lang)}</div>
    <pre data-code-output class="cr-output"></pre>
  </div>
  <script type="application/json" data-code-starter set:html={JSON.stringify(starter)} />
</section>

<style>
  .coderunner {
    margin: 32px 0;
    padding: 16px;
    background: var(--card);
    border: 0.5px solid var(--hairline-2);
    border-radius: 12px;
  }
  .cr-input {
    width: 100%;
    resize: vertical;
    padding: 12px 14px;
    background: var(--card-2);
    border: 0.5px solid var(--hairline);
    border-radius: 8px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    tab-size: 2;
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .cr-input:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .cr-actions { display: flex; gap: 10px; margin-top: 12px; }
  .cr-out-wrap { margin-top: 16px; }
  .cr-out-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 6px;
  }
  .cr-output {
    overflow-x: auto;
    min-height: 2.75rem;
    padding: 12px 14px;
    background: var(--card-2);
    border: 0.5px solid var(--hairline);
    border-left: 2px solid var(--accent);
    border-radius: 8px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.65;
    white-space: pre-wrap;
  }
</style>

<script>
  function runUserCode(source: string): string {
    const lines: string[] = [];
    const log = (...args: unknown[]) =>
      lines.push(
        args
          .map((a) => {
            if (typeof a === "string") return a;
            try { return JSON.stringify(a); } catch { return String(a); }
          })
          .join(" ")
      );
    try {
      // eslint-disable-next-line no-new-func
      const fn = new Function("console", `"use strict";\n${source}`);
      fn({ log, error: log, warn: log, info: log });
    } catch (err) {
      lines.push(`⚠ ${err instanceof Error ? err.message : String(err)}`);
    }
    return lines.length ? lines.join("\n") : "—";
  }

  function initRunner(root: HTMLElement) {
    const input = root.querySelector<HTMLTextAreaElement>("[data-code-input]")!;
    const output = root.querySelector<HTMLElement>("[data-code-output]")!;
    const runBtn = root.querySelector<HTMLButtonElement>("[data-code-run]")!;
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-code-reset]")!;
    const starterEl = root.querySelector<HTMLElement>("[data-code-starter");
    const starter: string = starterEl ? JSON.parse(starterEl.textContent || '""') : "";

    runBtn.addEventListener("click", () => {
      output.textContent = runUserCode(input.value);
    });
    resetBtn.addEventListener("click", () => {
      input.value = starter;
      output.textContent = "";
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "Tab") {
        e.preventDefault();
        const s = input.selectionStart, end = input.selectionEnd;
        input.value = input.value.slice(0, s) + "  " + input.value.slice(end);
        input.selectionStart = input.selectionEnd = s + 2;
      }
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-code-runner]").forEach(initRunner);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
