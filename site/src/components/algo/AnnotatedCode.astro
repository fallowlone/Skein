---
type Annotation = { line: number; text: string };
type Props = { code: string; annotations?: Annotation[]; caption?: string };
const { code, annotations = [], caption } = Astro.props;
const lines = code.replace(/\n$/, "").split("\n");
const noted = new Set(annotations.map((a) => a.line));
---
<figure class="annotated">
  <div class="ac-code">
    {lines.map((ln, i) => (
      <div class:list={["ac-row", { "is-noted": noted.has(i + 1) }]}>
        <span class="ac-ln">{i + 1}</span>
        <code class="ac-src">{ln === "" ? " " : ln}</code>
      </div>
    ))}
  </div>
  {annotations.length > 0 && (
    <ul class="ac-notes">
      {annotations.map((a) => (
        <li>
          <span class="ac-tag">L{a.line}</span>
          <span>{a.text}</span>
        </li>
      ))}
    </ul>
  )}
  {caption && <figcaption class="ac-caption">{caption}</figcaption>}
</figure>

<style>
  .annotated {
    margin: 24px 0;
    overflow: hidden;
    background: var(--card);
    border: 0.5px solid var(--hairline-2);
    border-radius: 12px;
  }
  .ac-code {
    overflow-x: auto;
    padding: 12px 0;
    background: var(--card-2);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
  }
  .ac-row {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 4px;
    align-items: baseline;
    border-left: 2px solid transparent;
  }
  .ac-row.is-noted {
    background: color-mix(in srgb, var(--accent) 10%, var(--card-2));
    border-left-color: var(--accent);
  }
  .ac-ln {
    text-align: right;
    padding-right: 14px;
    color: var(--faint);
    user-select: none;
    font-size: 11.5px;
  }
  .ac-row.is-noted .ac-ln { color: var(--accent); }
  .ac-src { white-space: pre; color: var(--ink-2); padding-right: 18px; }

  .ac-notes {
    border-top: 0.5px solid var(--hairline);
    padding: 12px 16px;
    margin: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .ac-notes li { display: flex; gap: 8px; }
  .ac-tag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }
  .ac-caption {
    border-top: 0.5px solid var(--hairline);
    padding: 8px 16px;
    font-size: 12px;
    color: var(--muted);
  }
</style>
