---
type Annotation = { line: number; text: string };
type Props = { code: string; annotations?: Annotation[]; caption?: string };
const { code, annotations = [], caption } = Astro.props;
const lines = code.replace(/\n$/, "").split("\n");
const noted = new Set(annotations.map((a) => a.line));
---
<figure class="my-6 rounded-[var(--r-md)] border-[0.5px] border-hairline-2 bg-card overflow-hidden">
  <pre class="overflow-x-auto px-0 py-3 text-[13px] leading-relaxed font-mono bg-[var(--code-bg)] text-[var(--code-ink)]"><code>{lines.map((ln, i) => (
    <div class={`px-4 ${noted.has(i + 1) ? "bg-accent-ghost" : ""}`}>
      <span class="inline-block w-7 select-none text-right pr-3 text-faint">{i + 1}</span>
      <span>{ln === "" ? " " : ln}</span>
    </div>
  ))}</code></pre>
  {annotations.length > 0 && (
    <ul class="border-t-[0.5px] border-hairline-2 px-4 py-3 space-y-1.5 text-[12.5px] text-muted">
      {annotations.map((a) => (
        <li class="flex gap-2">
          <span class="font-mono shrink-0 text-accent font-semibold">L{a.line}</span>
          <span>{a.text}</span>
        </li>
      ))}
    </ul>
  )}
  {caption && <figcaption class="border-t-[0.5px] border-hairline-2 px-4 py-2 text-[12px] text-muted">{caption}</figcaption>}
</figure>
