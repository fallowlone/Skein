---
type Cell = { value: string; addr?: string; mark?: "active" | "done" | "target" };
type Gate = { name: string; inputs?: string[]; out?: string };
type Props = {
  kind: "cells" | "cpu" | "gate";
  cells?: (Cell | string)[];
  gate?: Gate;
  caption?: string;
  lang?: "en" | "ru";
};

const { kind, cells = [], gate, caption, lang = "en" } = Astro.props;
const norm: Cell[] = cells.map((c) => (typeof c === "string" ? { value: c } : c));
// An 8-bit byte must render as two 4-bit lines so it fits the fixed-size cell box.
// Normalize regardless of how the value was spaced ("0001 0000" or "00011010").
const asByte = (v: string): [string, string] | null => {
  const b = v.replace(/\s+/g, "");
  return /^[01]{8}$/.test(b) ? [b.slice(0, 4), b.slice(4, 8)] : null;
};
const fill = (m?: string) =>
  m === "active" ? "bg-[color:var(--accent-ghost)] border-[color:var(--accent)]"
  : m === "done" ? "bg-[color:color-mix(in_srgb,var(--ok)_12%,var(--card))] border-[color:var(--ok)]"
  : m === "target" ? "bg-[color:color-mix(in_srgb,var(--warn)_12%,var(--card))] border-[color:var(--warn)]"
  : "bg-card border-[color:var(--hairline-strong)]";
const stages = lang === "ru"
  ? ["Выборка", "Декодирование", "Исполнение"]
  : ["Fetch", "Decode", "Execute"];
---

<figure data-lesson-visual class="my-6">
  {kind === "cells" && (
    <div class="flex gap-1.5 justify-center flex-wrap">
      {norm.map((c) => (
        <div class="flex flex-col items-center gap-1">
          <div class={`w-12 h-12 grid place-items-center overflow-hidden rounded-lg border-2 font-mono text-[14px] leading-[1.05] text-ink ${fill(c.mark)}`}>
            {asByte(c.value)
              ? <span class="text-center">{asByte(c.value)![0]}<br />{asByte(c.value)![1]}</span>
              : c.value}
          </div>
          {c.addr && <span class="font-mono text-[10px] text-muted">{c.addr}</span>}
        </div>
      ))}
    </div>
  )}

  {kind === "cpu" && (
    <div class="flex items-center justify-center gap-2 flex-wrap">
      {stages.map((s, i) => (
        <>
          <div class="px-4 py-3 rounded-lg border-2 border-[color:var(--accent)] bg-[color:var(--accent-ghost)] font-mono text-[13px] text-ink">
            {s}
          </div>
          {i < stages.length - 1 && <span class="text-muted">&rarr;</span>}
        </>
      ))}
      <span class="text-muted">&#x21BA;</span>
    </div>
  )}

  {kind === "gate" && gate && (
    <div class="flex items-center justify-center gap-3">
      <div class="flex flex-col gap-1 font-mono text-[12px] text-muted">
        {(gate.inputs ?? []).map((x) => <span>{x}</span>)}
      </div>
      <span class="text-muted">&rarr;</span>
      <div class="px-5 py-4 rounded-lg border-2 border-[color:var(--accent)] bg-[color:var(--accent-ghost)] font-mono text-[14px] font-semibold text-ink">
        {gate.name}
      </div>
      <span class="text-muted">&rarr;</span>
      <span class="font-mono text-[12px] text-muted">{gate.out ?? "out"}</span>
    </div>
  )}

  {caption && <figcaption class="mt-2 text-center text-[12px] text-muted">{caption}</figcaption>}
</figure>
