---
type Cell = { value: string; addr?: string; mark?: "active" | "done" | "target" };
type Gate = { name: string; inputs?: string[]; out?: string };
type Props = {
  kind: "cells" | "cpu" | "gate";
  cells?: (Cell | string)[];
  gate?: Gate;
  caption?: string;
  lang?: "en" | "ru";
};

const { kind, cells = [], gate, caption, lang = "en" } = Astro.props;
const norm: Cell[] = cells.map((c) => (typeof c === "string" ? { value: c } : c));
const fill = (m?: string) =>
  m === "active" ? "bg-accent-ghost border-[0.5px] border-accent"
  : m === "done" ? "bg-card-2 border-[0.5px] border-ok"
  : m === "target" ? "bg-card-2 border-[0.5px] border-warn"
  : "bg-card border-[0.5px] border-hairline-2";
const stages = lang === "ru"
  ? ["Выборка", "Декодирование", "Исполнение"]
  : ["Fetch", "Decode", "Execute"];
---

<figure data-lesson-visual class="my-6">
  {kind === "cells" && (
    <div class="flex gap-1.5 justify-center flex-wrap">
      {norm.map((c) => (
        <div class="flex flex-col items-center gap-1">
          <div class={`w-12 h-12 grid place-items-center rounded-[var(--r-sm)] font-mono text-[14px] text-ink ${fill(c.mark)}`}>
            {c.value}
          </div>
          {c.addr && <span class="font-mono text-[10px] text-muted">{c.addr}</span>}
        </div>
      ))}
    </div>
  )}

  {kind === "cpu" && (
    <div class="flex items-center justify-center gap-2 flex-wrap">
      {stages.map((s, i) => (
        <>
          <div class="px-4 py-3 rounded-[var(--r-sm)] border-[0.5px] border-accent bg-accent-ghost font-mono text-[13px] text-ink">
            {s}
          </div>
          {i < stages.length - 1 && <span class="text-muted">&rarr;</span>}
        </>
      ))}
      <span class="text-muted">&#x21BA;</span>
    </div>
  )}

  {kind === "gate" && gate && (
    <div class="flex items-center justify-center gap-3">
      <div class="flex flex-col gap-1 font-mono text-[12px] text-faint">
        {(gate.inputs ?? []).map((x) => <span>{x}</span>)}
      </div>
      <span class="text-muted">&rarr;</span>
      <div class="px-5 py-4 rounded-[var(--r-sm)] border-[0.5px] border-accent bg-accent-ghost font-mono text-[14px] font-semibold text-ink">
        {gate.name}
      </div>
      <span class="text-muted">&rarr;</span>
      <span class="font-mono text-[12px] text-muted">{gate.out ?? "out"}</span>
    </div>
  )}

  {caption && <figcaption class="mt-2 text-center text-[12px] text-faint">{caption}</figcaption>}
</figure>
