---
type Theme = "lilac" | "mint" | "peach" | "sky" | "rose";
type Props = { theme: Theme };
const { theme } = Astro.props;
const fg: Record<Theme, string> = {
  lilac: "var(--p-lilac)",
  mint:  "var(--p-mint)",
  peach: "var(--p-peach)",
  sky:   "var(--p-sky)",
  rose:  "var(--p-rose)",
};
const bg: Record<Theme, string> = {
  lilac: "var(--p-lilac-bg)",
  mint:  "var(--p-mint-bg)",
  peach: "var(--p-peach-bg)",
  sky:   "var(--p-sky-bg)",
  rose:  "var(--p-rose-bg)",
};
---
<span
  class="inline-flex items-center justify-center px-4 h-7 rounded-[1px] font-mono text-[11px] uppercase tracking-[0.08em] border"
  style={`background:${bg[theme]}; border-color:${fg[theme]}; color:var(--ink);`}
>
  <slot />
</span>
