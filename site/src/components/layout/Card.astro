---
type Props = { id?: string; variant?: "default" | "yellow" | "highlight" };
const { id, variant = "default" } = Astro.props;
const cls = {
  default:   "bg-card border-rule",
  yellow:    "bg-card border-rule-strong",
  highlight: "bg-card border-l-2",
}[variant];
const style = variant === "highlight" ? "border-color: var(--accent); padding-left: 1.25rem;" : "";
---
<div id={id} class={`layout-card my-8 border ${cls} p-5 w-full rounded-[2px]`} style={style} data-text-class="body">
  <slot />
</div>

<style>
  /* Quiet depth on hover — shadow elevation + border firming. Content card, not
     a tap target, so no transform/press. Compositor-only. */
  .layout-card {
    transition: box-shadow var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease);
  }
  .layout-card:hover { box-shadow: var(--shadow-1); border-color: var(--rule-strong); }
</style>
