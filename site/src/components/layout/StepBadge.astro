---
type Props = { n: number; label?: string };
const { n, label } = Astro.props;
---
<div class="inline-flex items-baseline gap-3">
  <span class="font-mono text-[20px] font-medium text-muted leading-none tabular-nums">{String(n).padStart(2, "0")}</span>
  {label && (
    <span class="font-display text-[17px] font-medium text-ink leading-snug" data-text-class="step-label">
      {label}
    </span>
  )}
</div>
