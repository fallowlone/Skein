---
type Stat = { label: string; value: string };
type Props = { id?: string; stats: Stat[]; title?: string };
const { id, stats, title = "Typical timings" } = Astro.props;
---
<figure id={id} class="my-10 hr-top hr-bot py-5">
  <figcaption class="meta mb-4" data-text-class="annot">{title}</figcaption>
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-10">
    {stats.map((s, i) => (
      <div class={`flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2 ${i > 0 ? "hl" : ""}`}>
        <dt class="text-[14px] text-ink-2 leading-snug">{s.label}</dt>
        <dd class="font-mono text-[13px] text-ink tabular-nums overflow-wrap:anywhere text-right">{s.value}</dd>
      </div>
    ))}
  </dl>
</figure>
