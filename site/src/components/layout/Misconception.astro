---
type Props = { id: string; title?: string };
const { id, title = "heads-up" } = Astro.props;
---
<aside id={id} data-text-class="misconception" class="my-8 pl-5 border-l-2" style="border-color: var(--danger);">
  <div class="meta mb-2" style="color: var(--danger);">{title}</div>
  <div class="leading-relaxed text-ink">
    <slot />
  </div>
</aside>
