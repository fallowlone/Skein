---
import Pill from "./Pill.astro";
import StepBadge from "./StepBadge.astro";

type Theme = "lilac" | "mint" | "peach" | "sky" | "rose";
type Props = {
  id: string;
  theme: Theme;
  title: string;
  step?: number;
  stepLabel?: string;
};
const { id, theme, title, step, stepLabel } = Astro.props;
// Each theme maps to its real pillar pair (bg tint + matching border), so the
// five stages read as distinct surfaces instead of collapsing to one pale tint.
const fg: Record<Theme, string> = {
  lilac: "var(--p-lilac)",
  mint:  "var(--p-mint)",
  peach: "var(--p-peach)",
  sky:   "var(--p-sky)",
  rose:  "var(--p-rose)",
};
const bgVar: Record<Theme, string> = {
  lilac: "var(--p-lilac-bg)",
  mint:  "var(--p-mint-bg)",
  peach: "var(--p-peach-bg)",
  sky:   "var(--p-sky-bg)",
  rose:  "var(--p-rose-bg)",
};
const stageStyle = `--stage-bg:${bgVar[theme]}; --stage-fg:${fg[theme]};`;
---
<section
  id={id}
  data-stage
  data-stage-theme={theme}
  data-animated
  style={stageStyle}
  class="stage-panel relative my-16 rounded-3xl border-[0.5px] border-dashed px-6 md:px-12 py-12"
>
  <div class="absolute -top-5 left-1/2 -translate-x-1/2">
    <Pill theme={theme}>{title}</Pill>
  </div>
  {step !== undefined && (
    <div class="mb-8">
      <StepBadge n={step} label={stepLabel} />
    </div>
  )}
  <div data-stage-content class="space-y-8 relative">
    <slot />
  </div>
</section>

<style>
  /* Per-theme pillar surface: tint background + matching dashed border. The
     title Pill (top-center) already maps per-theme. Tokens resolve in both
     themes. */
  .stage-panel {
    background: var(--stage-bg);
    border-color: color-mix(in srgb, var(--stage-fg) 50%, transparent);
  }
</style>

<script>
  import { setupGsap } from "../../scripts/gsap-setup";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const motion = setupGsap();
  if (motion) {
    document.querySelectorAll<HTMLElement>("[data-stage-content]").forEach((root) => {
      const children = Array.from(root.children) as HTMLElement[];
      gsap.set(children, { opacity: 0, y: 24 });
      gsap.to(children, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power2.out",
        stagger: 0.12,
        scrollTrigger: { trigger: root.parentElement, start: "top 70%", once: true },
      });
    });
  } else {
    document.querySelectorAll<HTMLElement>("[data-stage-content]").forEach((root) => {
      Array.from(root.children).forEach((c) => ((c as HTMLElement).style.opacity = "1"));
    });
  }
</script>
