---
import { t, type Locale } from "../../i18n";
import {
  algoLinksIndex,
  linksForLesson,
  linksForUnit,
  type LessonLink,
} from "./algo-links";

type Props = {
  lang: Locale;
  kind: "lesson" | "algoUnit";
  lessonKey?: string;
  unitId?: string;
};

const { lang, kind, lessonKey = "", unitId = "" } = Astro.props;

const rows =
  kind === "lesson"
    ? linksForLesson(algoLinksIndex, lessonKey, lang)
    : linksForUnit(algoLinksIndex, unitId, lang);
const heading = t(kind === "lesson" ? "algoLinks.lessonHead" : "algoLinks.unitHead", lang);
const canonicalLabel = t("algoLinks.canonical", lang);

function metaFor(row: (typeof rows)[number]): string {
  const canon = row.canonical ? `◆ ${canonicalLabel}` : "";
  if (kind === "algoUnit") {
    const track = (row as LessonLink).trackLabel;
    return [track, canon].filter(Boolean).join(" · ");
  }
  return [`${row.shared}∩`, canon].filter(Boolean).join(" · ");
}
---

{rows.length > 0 && (
  <section class="al-block" aria-label={heading}>
    <div class="poster-sec-head"><span>{heading}</span><span>{rows.length}</span></div>
    <div class="poster-rows">
      {rows.map((row, i) => (
        <a class="poster-row" href={row.href}>
          <span class="pr-num">{String(i + 1).padStart(2, "0")}</span>
          <span class="pr-name al-name">{row.title}</span>
          <span class="pr-meta">{metaFor(row)}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .al-block {
    margin-top: 2.5rem;
  }
  .al-block .poster-row {
    grid-template-columns: 44px 1fr auto;
  }
  .al-block .pr-name {
    font-size: clamp(19px, 2.4vw, 30px);
  }
  .al-name {
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
