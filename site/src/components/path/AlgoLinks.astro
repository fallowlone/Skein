---
import { t, type Locale } from "../../i18n";
import {
  algoLinksIndex,
  linksForLesson,
  linksForUnit,
  rowMeta,
} from "./algo-links";

type Props = {
  lang: Locale;
  kind: "lesson" | "algoUnit";
  lessonKey?: string;
  unitId?: string;
};

const { lang, kind, lessonKey = "", unitId = "" } = Astro.props;

const rows =
  kind === "lesson"
    ? linksForLesson(algoLinksIndex, lessonKey, lang)
    : linksForUnit(algoLinksIndex, unitId, lang);
const heading = t(kind === "lesson" ? "algoLinks.lessonHead" : "algoLinks.unitHead", lang);
const canonicalLabel = t("algoLinks.canonical", lang);

const metaFor = (row: (typeof rows)[number]): string => rowMeta(row, kind, canonicalLabel);
---

{rows.length > 0 && (
  <section data-algo-links={kind} aria-label={heading} style="margin-top:2.5rem">
    <div class="poster-sec-head"><span>{heading}</span><span>{rows.length}</span></div>
    <div class="al-rows">
      {rows.map((row, i) => (
        <a class="al-row" href={row.href}>
          <span class="al-num">{String(i + 1).padStart(2, "0")}</span>
          <span class="al-name" style="overflow-wrap:break-word;min-width:0">{row.title}</span>
          <span class="al-meta">{metaFor(row)}</span>
          <span class="al-arr" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  /* Compact rows inside unit/lesson flow: same grid rhythm as .oa-lesson,
     not the giant poster type (poster-kit .poster-row is reserved for
     home/learn index hero lists). Scoped to [data-algo-links]. */
  [data-algo-links] .al-rows { border-top: 0.5px solid var(--hairline); }
  [data-algo-links] .al-row {
    display: grid; grid-template-columns: 24px 1fr auto auto;
    gap: var(--s-3); align-items: baseline;
    padding: 8px 10px; color: var(--ink-2); text-decoration: none;
    border-bottom: 0.5px solid var(--hairline);
  }
  [data-algo-links] .al-row:hover { background: var(--card-2); color: var(--ink); }
  [data-algo-links] .al-num {
    font-family: var(--font-mono); font-size: 11px; color: var(--faint); min-width: 2ch;
  }
  [data-algo-links] .al-name { font-size: var(--fs-meta); line-height: 1.4; }
  [data-algo-links] .al-meta {
    font-family: var(--font-mono); font-size: 11px; color: var(--faint);
    letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap;
  }
  [data-algo-links] .al-arr { font-family: var(--font-mono); color: var(--faint); }
</style>
