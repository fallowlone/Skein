---
import { t, type Locale } from "../../i18n";

type Props = { id: string; lang: Locale };
const { id, lang } = Astro.props;

const TIERS = ["junior", "middle", "senior"] as const;
---
<section id={id} class="my-10 w-full" data-tier-accordion>
  <header class="flex gap-6 border-b border-rule mb-5" role="tablist">
    {TIERS.map((tier) => (
      <button
        type="button"
        role="tab"
        data-tier={tier}
        class="relative -mb-px px-0.5 pb-2.5 text-[13px] tracking-wide lowercase font-semibold border-b-2 border-transparent transition text-bbg-muted hover:text-bbg-ink"
      >{t(`tier.${tier}`, lang)}</button>
    ))}
  </header>
  <div>
    <div data-tier-panel="junior" hidden><slot name="junior" /></div><!--/tier-panel-->
    <div data-tier-panel="middle"><slot name="middle" /></div><!--/tier-panel-->
    <div data-tier-panel="senior" hidden><slot name="senior" /></div><!--/tier-panel-->
  </div>
</section>

<script>
  type Tier = "junior" | "middle" | "senior";
  const KEY = "awesome.user-state.v1";

  function readTier(): Tier {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return "middle";
      const parsed = JSON.parse(raw);
      const t = parsed?.tier;
      return t === "junior" || t === "senior" ? t : "middle";
    } catch { return "middle"; }
  }

  function writeTier(tier: Tier) {
    try {
      const raw = localStorage.getItem(KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      parsed.tier = tier;
      parsed.manualTierFlips = (parsed.manualTierFlips ?? 0) + 1;
      localStorage.setItem(KEY, JSON.stringify(parsed));
    } catch {}
  }

  function activate(acc: HTMLElement, tier: Tier) {
    acc.querySelectorAll<HTMLElement>("[data-tier-panel]").forEach((p) => {
      p.hidden = p.dataset.tierPanel !== tier;
    });
    acc.querySelectorAll<HTMLButtonElement>("[data-tier]").forEach((b) => {
      const active = b.dataset.tier === tier;
      b.classList.toggle("text-ink", active);
      b.classList.toggle("border-ink", active);
      b.classList.toggle("border-transparent", !active);
      b.classList.toggle("text-bbg-muted", !active);
      b.setAttribute("aria-selected", active ? "true" : "false");
    });
  }

  function syncAll(tier: Tier) {
    document.querySelectorAll<HTMLElement>("[data-tier-accordion]").forEach((acc) => {
      activate(acc, tier);
    });
  }

  function init() {
    const initial = readTier();
    syncAll(initial);
    document.querySelectorAll<HTMLElement>("[data-tier-accordion]").forEach((acc) => {
      acc.querySelectorAll<HTMLButtonElement>("[data-tier]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const tier = btn.dataset.tier as Tier;
          writeTier(tier);
          syncAll(tier);
        });
      });
    });
    document.addEventListener("tier-change", ((e: CustomEvent) => {
      const tier = e.detail?.tier;
      if (tier === "junior" || tier === "middle" || tier === "senior") syncAll(tier);
    }) as EventListener);
  }

  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
