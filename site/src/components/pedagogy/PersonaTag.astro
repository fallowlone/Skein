---
import personas from "../../content/personas.json";
import { type Locale } from "../../i18n";

type Persona = { name: Record<Locale, string>; role: Record<Locale, string>; color: string };
type Props = { id: keyof typeof personas; lang: Locale; size?: number };
const { id, lang } = Astro.props;
const map = personas as Record<string, Persona>;
const p = map[id as string];
if (!p) throw new Error(`Unknown persona id: ${id}`);
const displayName = p.name[lang];
---
<span class="inline-flex items-baseline gap-1.5 align-baseline" data-persona={id}>
  <span class="pill-dot self-center" style={`background:${p.color};`}></span>
  <span class="font-semibold text-ink">{displayName}</span>
  <span class="meta-lc text-muted">· {p.role[lang]}</span>
</span>
