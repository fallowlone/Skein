---
import { t, type Locale } from "../../i18n";

type Option = {
  name: string;
  summary: string;
  correct?: boolean;
  justification: string;
};

type Props = {
  id: string;
  /** Progress key. Most lessons pass `lessonSlug`; older pieces pass `pieceSlug`. */
  lessonSlug?: string;
  pieceSlug?: string;
  lang: Locale;
  prompt: string;
  options: Option[];
};

const { id, lessonSlug, pieceSlug, lang, prompt, options } = Astro.props;
const slug = lessonSlug ?? pieceSlug ?? "";
---
<section
  id={id}
  data-tradeoff
  data-piece-slug={slug}
  class="relative my-10 hr-top hr-bot py-6 transition-opacity duration-200"
>
  <header class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2.5">
      <span class="pill-dot" style="background: var(--accent);"></span>
      <span class="meta">{t("tradeoff.title", lang)}</span>
    </div>
    <span data-completed-badge class="badge ok" hidden>
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      completed
    </span>
  </header>
  <h3 class="font-display text-[20px] font-semibold text-ink leading-snug mb-5 tracking-tight">{prompt}</h3>

  <div class="space-y-2">
    {options.map((o, i) => (
      <div>
        <button
          type="button"
          data-option-index={i}
          data-correct={o.correct ? "true" : "false"}
          data-state="idle"
          class="group w-full text-left rounded-[2px] border border-rule-strong bg-card hover:border-ink hover:bg-card-2 px-4 py-3 transition-all duration-150 focus-visible:ring-2 focus-visible:ring-offset-2 outline-none"
        >
          <div class="flex items-start gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[13px] font-semibold text-ink tracking-tight">{o.name}</span>
                {o.correct && (
                  <span data-best-pill class="badge ok" hidden>
                    best fit
                  </span>
                )}
              </div>
              <div class="text-[12.5px] text-muted leading-relaxed">{o.summary}</div>
            </div>
            <span data-chevron class="shrink-0 mt-0.5 transition-transform duration-200 rotate-0 text-muted group-hover:text-ink">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </span>
          </div>
        </button>
        <div data-justify-for={i} class="mt-2 mb-1 ml-3 mr-1 rounded-[var(--r-md)] px-4 py-3 border-l-[3px] animate-reveal-up" hidden>
          <div class="flex items-start gap-2">
            <span data-just-icon class="mt-0.5 shrink-0"></span>
            <div>
              <div data-just-label class="font-mono text-[10px] uppercase tracking-wider font-semibold mb-1"></div>
              <div data-just-text class="text-[12.5px] leading-relaxed">{o.justification}</div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  type State = { completed: boolean; lastAt: number };
  const KEY = "awesome.user-state.v1";

  function persist(pieceSlug: string, id: string, state: State) {
    try {
      const raw = localStorage.getItem(KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      parsed.exercises ??= {};
      parsed.exercises[pieceSlug] ??= {};
      parsed.exercises[pieceSlug][id] = state;
      localStorage.setItem(KEY, JSON.stringify(parsed));
    } catch {}
  }

  const ICON_CHECK = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>`;
  const ICON_INFO = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>`;

  function setOptionSelected(btn: HTMLButtonElement, correct: boolean) {
    btn.dataset.state = "selected";
    btn.classList.remove("border-hairline-2", "bg-card", "hover:border-hairline-strong", "hover:bg-card-2", "hover:shadow-soft-sm");
    if (correct) {
      btn.classList.add("ex-correct", "shadow-soft-sm");
    } else {
      btn.classList.add("ex-wrong", "shadow-soft-sm");
    }
    const chevron = btn.querySelector<HTMLElement>("[data-chevron]")!;
    chevron.classList.remove("rotate-0");
    chevron.classList.add("rotate-90");
  }

  function setOptionIdle(btn: HTMLButtonElement) {
    btn.dataset.state = "idle";
    btn.classList.remove(
      "ex-correct", "ex-wrong", "shadow-soft-sm"
    );
    btn.classList.add("border-hairline-2", "bg-card", "hover:border-hairline-strong", "hover:bg-card-2", "hover:shadow-soft-sm");
    const chevron = btn.querySelector<HTMLElement>("[data-chevron]")!;
    chevron.classList.remove("rotate-90");
    chevron.classList.add("rotate-0");
  }

  function applyJustification(panel: HTMLElement, correct: boolean) {
    panel.classList.remove("border-ok", "bg-card-2", "border-danger");
    if (correct) {
      panel.classList.add("border-ok", "bg-card-2");
    } else {
      panel.classList.add("border-danger", "bg-card-2");
    }
    const icon = panel.querySelector<HTMLElement>("[data-just-icon]")!;
    const label = panel.querySelector<HTMLElement>("[data-just-label]")!;
    const text = panel.querySelector<HTMLElement>("[data-just-text]")!;
    icon.innerHTML = correct ? ICON_CHECK : ICON_INFO;
    icon.className = `mt-0.5 shrink-0 ${correct ? "text-ok" : "text-danger"}`;
    label.className = `font-mono text-[10px] uppercase tracking-wider font-semibold mb-1 ${correct ? "text-ok" : "text-danger"}`;
    label.textContent = correct ? "Why it fits" : "Where it falls short";
    text.className = `text-[12.5px] leading-relaxed ${correct ? "text-ink" : "text-ink"}`;
  }

  function initTradeoff(root: HTMLElement) {
    const pieceSlug = root.dataset.pieceSlug ?? "";
    const id = root.id;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-option-index]"));
    const completedBadge = root.querySelector<HTMLElement>("[data-completed-badge]")!;
    let firedComplete = false;

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = btn.dataset.optionIndex;
        const correct = btn.dataset.correct === "true";
        const panel = root.querySelector<HTMLElement>(`[data-justify-for="${idx}"]`);
        const open = btn.dataset.state === "selected";

        if (open) {
          // toggle close
          setOptionIdle(btn);
          if (panel) panel.hidden = true;
          const bestPill = btn.querySelector<HTMLElement>("[data-best-pill]");
          if (bestPill) bestPill.hidden = true;
          return;
        }

        setOptionSelected(btn, correct);
        if (panel) {
          applyJustification(panel, correct);
          panel.hidden = false;
        }
        if (correct) {
          const bestPill = btn.querySelector<HTMLElement>("[data-best-pill]");
          if (bestPill) bestPill.hidden = false;
          if (!firedComplete) {
            firedComplete = true;
            completedBadge.hidden = false;
            root.classList.add("opacity-60");
            persist(pieceSlug, id, { completed: true, lastAt: Date.now() });
          }
        }
      });
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-tradeoff]").forEach(initTradeoff);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
