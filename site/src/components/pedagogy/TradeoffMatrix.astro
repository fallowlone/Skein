---
import { t, type Locale } from "../../i18n";

type Option = {
  name: string;
  summary: string;
  correct?: boolean;
  justification: string;
};

type Props = {
  id: string;
  pieceSlug: string;
  lang: Locale;
  prompt: string;
  options: Option[];
};

const { id, pieceSlug, lang, prompt, options } = Astro.props;
---
<section
  id={id}
  data-tradeoff
  data-piece-slug={pieceSlug}
  class="relative rounded-2xl border-2 border-gray-200 bg-white p-6 transition-opacity duration-200 my-8"
>
  <header class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2.5">
      <span class="w-1.5 h-1.5 rounded-full bg-bbg-teal"></span>
      <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-bbg-muted font-medium">{t("tradeoff.title", lang)}</span>
    </div>
    <span data-completed-badge class="inline-flex items-center gap-1 text-[11px] font-medium text-bbg-success" hidden>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      Completed
    </span>
  </header>
  <h3 class="text-[17px] font-semibold text-bbg-ink leading-snug mb-4 tracking-tight">{prompt}</h3>

  <div class="space-y-2">
    {options.map((o, i) => (
      <div>
        <button
          type="button"
          data-option-index={i}
          data-correct={o.correct ? "true" : "false"}
          data-state="idle"
          class="group w-full text-left rounded-xl border-2 border-gray-200 bg-white hover:border-gray-300 hover:bg-bbg-paper hover:shadow-soft-sm px-4 py-3 transition-all duration-150 focus-visible:ring-2 focus-visible:ring-bbg-purple focus-visible:ring-offset-2 outline-none"
        >
          <div class="flex items-start gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[13px] font-semibold text-bbg-ink tracking-tight">{o.name}</span>
                {o.correct && (
                  <span data-best-pill class="font-mono text-[9.5px] uppercase tracking-wider px-1.5 py-[2px] rounded bg-bbg-success/15 text-bbg-success font-semibold" hidden>
                    best fit
                  </span>
                )}
              </div>
              <div class="text-[12.5px] text-bbg-muted leading-relaxed">{o.summary}</div>
            </div>
            <span data-chevron class="shrink-0 mt-0.5 transition-transform duration-200 rotate-0 text-bbg-muted group-hover:text-bbg-ink">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </span>
          </div>
        </button>
        <div data-justify-for={i} class="mt-2 mb-1 ml-3 mr-1 rounded-lg px-4 py-3 border-l-[3px] animate-reveal-up" hidden>
          <div class="flex items-start gap-2">
            <span data-just-icon class="mt-0.5 shrink-0"></span>
            <div>
              <div data-just-label class="font-mono text-[10px] uppercase tracking-wider font-semibold mb-1"></div>
              <div data-just-text class="text-[12.5px] leading-relaxed">{o.justification}</div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  type State = { completed: boolean; lastAt: number };
  const KEY = "awesome.user-state.v1";

  function persist(pieceSlug: string, id: string, state: State) {
    try {
      const raw = localStorage.getItem(KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      parsed.exercises ??= {};
      parsed.exercises[pieceSlug] ??= {};
      parsed.exercises[pieceSlug][id] = state;
      localStorage.setItem(KEY, JSON.stringify(parsed));
    } catch {}
  }

  const ICON_CHECK = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>`;
  const ICON_INFO = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>`;

  function setOptionSelected(btn: HTMLButtonElement, correct: boolean) {
    btn.dataset.state = "selected";
    btn.classList.remove("border-gray-200", "bg-white", "hover:border-gray-300", "hover:bg-bbg-paper", "hover:shadow-soft-sm");
    if (correct) {
      btn.classList.add("border-bbg-success", "bg-panel-mint/50", "shadow-soft-sm");
    } else {
      btn.classList.add("border-panel-peach-ink/40", "bg-panel-peach/50", "shadow-soft-sm");
    }
    const chevron = btn.querySelector<HTMLElement>("[data-chevron]")!;
    chevron.classList.remove("rotate-0");
    chevron.classList.add("rotate-90");
  }

  function setOptionIdle(btn: HTMLButtonElement) {
    btn.dataset.state = "idle";
    btn.classList.remove(
      "border-bbg-success", "bg-panel-mint/50", "shadow-soft-sm",
      "border-panel-peach-ink/40", "bg-panel-peach/50"
    );
    btn.classList.add("border-gray-200", "bg-white", "hover:border-gray-300", "hover:bg-bbg-paper", "hover:shadow-soft-sm");
    const chevron = btn.querySelector<HTMLElement>("[data-chevron]")!;
    chevron.classList.remove("rotate-90");
    chevron.classList.add("rotate-0");
  }

  function applyJustification(panel: HTMLElement, correct: boolean) {
    panel.classList.remove("bg-panel-mint", "border-bbg-success", "bg-panel-peach", "border-panel-peach-ink");
    if (correct) {
      panel.classList.add("bg-panel-mint", "border-bbg-success");
    } else {
      panel.classList.add("bg-panel-peach", "border-panel-peach-ink");
    }
    const icon = panel.querySelector<HTMLElement>("[data-just-icon]")!;
    const label = panel.querySelector<HTMLElement>("[data-just-label]")!;
    const text = panel.querySelector<HTMLElement>("[data-just-text]")!;
    icon.innerHTML = correct ? ICON_CHECK : ICON_INFO;
    icon.className = `mt-0.5 shrink-0 ${correct ? "text-bbg-success" : "text-panel-peach-ink"}`;
    label.className = `font-mono text-[10px] uppercase tracking-wider font-semibold mb-1 ${correct ? "text-bbg-success" : "text-panel-peach-ink"}`;
    label.textContent = correct ? "Why it fits" : "Where it falls short";
    text.className = `text-[12.5px] leading-relaxed ${correct ? "text-green-900" : "text-amber-900"}`;
  }

  function initTradeoff(root: HTMLElement) {
    const pieceSlug = root.dataset.pieceSlug ?? "";
    const id = root.id;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-option-index]"));
    const completedBadge = root.querySelector<HTMLElement>("[data-completed-badge]")!;
    let firedComplete = false;

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = btn.dataset.optionIndex;
        const correct = btn.dataset.correct === "true";
        const panel = root.querySelector<HTMLElement>(`[data-justify-for="${idx}"]`);
        const open = btn.dataset.state === "selected";

        if (open) {
          // toggle close
          setOptionIdle(btn);
          if (panel) panel.hidden = true;
          const bestPill = btn.querySelector<HTMLElement>("[data-best-pill]");
          if (bestPill) bestPill.hidden = true;
          return;
        }

        setOptionSelected(btn, correct);
        if (panel) {
          applyJustification(panel, correct);
          panel.hidden = false;
        }
        if (correct) {
          const bestPill = btn.querySelector<HTMLElement>("[data-best-pill]");
          if (bestPill) bestPill.hidden = false;
          if (!firedComplete) {
            firedComplete = true;
            completedBadge.hidden = false;
            root.classList.add("opacity-60");
            persist(pieceSlug, id, { completed: true, lastAt: Date.now() });
          }
        }
      });
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-tradeoff]").forEach(initTradeoff);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
