---
import { Button as ShadcnButton } from "~/components/ui/button";
import { t, type Locale } from "../../i18n";

type Item = string | { id?: string; label: string };
type Props = {
  id: string;
  /** Progress key. Most lessons pass `lessonSlug`; older pieces pass `pieceSlug`. */
  lessonSlug?: string;
  pieceSlug?: string;
  lang: Locale;
  prompt: string;
  items: Item[];
};

const { id, lessonSlug, pieceSlug, lang, prompt, items } = Astro.props;
const slug = lessonSlug ?? pieceSlug ?? "";
const indexed = items.map((it, i) => ({
  correctIndex: i,
  label: typeof it === "string" ? it : it.label,
}));
---
<section
  id={id}
  data-drag-order
  data-piece-slug={slug}
  data-correct-order={JSON.stringify(indexed.map((x) => x.correctIndex))}
  data-all-correct={t("dragOrder.allCorrect", lang)}
  data-incorrect={t("dragOrder.incorrect", lang)}
  data-check-failed={lang === "ru" ? "Не удалось проверить ответ. Попробуйте ещё раз." : "Could not check your answer. Try again."}
  class="relative rounded-[var(--r-lg)] border-[0.5px] border-hairline-2 bg-card p-6 transition-opacity duration-200 my-8"
>
  <header class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2.5">
      <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
      <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-muted font-medium">{t("dragOrder.title", lang)}</span>
    </div>
    <span data-completed-badge class="quiz-done" hidden>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      {t("quiz.completed", lang)}
    </span>
  </header>
  <h3 class="font-display text-[18px] font-[460] text-ink leading-snug mb-4">{prompt}</h3>
  <p id={`${id}-move-hint`} class="text-[11.5px] text-muted mb-4">{t("dragOrder.moveHint", lang)}</p>
  <ol data-items class="space-y-2">
    {indexed.map((item, i) => (
      <li
        draggable="true"
        data-correct-index={item.correctIndex}
        data-state="idle"
        class="drag-item group relative flex items-center gap-3 rounded-[var(--r-md)] border-[0.5px] border-hairline-2 hover:border-hairline-strong px-3 py-3 bg-card transition-all duration-150 select-none"
      >
        <ShadcnButton
          type="button"
          aria-describedby={`${id}-move-hint`}
          aria-label={`${t("a11y.dragHandle", lang)}: ${item.label}`}
          data-grip
          class={`shrink-0 p-1.5 rounded-md cursor-grab active:cursor-grabbing text-muted hover:text-accent transition-colors ${i === 0 ? "animate-wiggle-hint" : ""}`}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="6" r="1.2" fill="currentColor"/>
            <circle cx="15" cy="6" r="1.2" fill="currentColor"/>
            <circle cx="9" cy="12" r="1.2" fill="currentColor"/>
            <circle cx="15" cy="12" r="1.2" fill="currentColor"/>
            <circle cx="9" cy="18" r="1.2" fill="currentColor"/>
            <circle cx="15" cy="18" r="1.2" fill="currentColor"/>
          </svg>
        </ShadcnButton>
        <span class="move-controls">
          <ShadcnButton type="button" data-move="-1" aria-label={`${t("dragOrder.moveUp", lang)}: ${item.label}`} class="move-btn">↑</ShadcnButton>
          <ShadcnButton type="button" data-move="1" aria-label={`${t("dragOrder.moveDown", lang)}: ${item.label}`} class="move-btn">↓</ShadcnButton>
        </span>
        <span data-position class="font-mono shrink-0 w-7 h-7 rounded-[var(--r-sm)] grid place-items-center text-[12px] font-semibold bg-card-2 border-[0.5px] border-hairline text-muted tabular-nums">{i + 1}</span>
        <span class="flex-1 text-[14px] leading-relaxed text-ink-2">{item.label}</span>
        <span data-icon-correct class="text-ok shrink-0" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
        </span>
        <span data-icon-wrong class="text-danger shrink-0" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </span>
      </li>
    ))}
  </ol>
  <div class="flex items-center gap-2 mt-4 pt-4 border-t border-dashed border-hairline-2">
    <ShadcnButton
      type="button"
      data-action="check"
      class="oa-btn oa-btn-primary oa-btn-sm disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      {t("exercise.check", lang)}
    </ShadcnButton>
    <ShadcnButton
      type="button"
      data-action="reset"
      class="oa-btn oa-btn-ghost oa-btn-sm"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 019-9 9 9 0 016.7 3M21 3v6h-6M21 12a9 9 0 01-9 9 9 9 0 01-6.7-3M3 21v-6h6"/></svg>
      {t("exercise.reset", lang)}
    </ShadcnButton>
    <span data-status class="ml-auto text-[11.5px] font-mono uppercase tracking-wider" hidden></span>
  </div>
</section>

<script>
  import { submitLessonAttempt } from "~/lib/lesson-attempt";
  type State = { completed: boolean; lastAt: number };
  const KEY = "skein.user-state.v1";

  function persist(pieceSlug: string, id: string, state: State) {
    try {
      const raw = localStorage.getItem(KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      parsed.exercises ??= {};
      parsed.exercises[pieceSlug] ??= {};
      parsed.exercises[pieceSlug][id] = state;
      localStorage.setItem(KEY, JSON.stringify(parsed));
    } catch {}
  }

  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function renumber(list: HTMLOListElement) {
    Array.from(list.children).forEach((li, i) => {
      const pos = (li as HTMLElement).querySelector<HTMLElement>("[data-position]");
      if (pos) pos.textContent = String(i + 1);
    });
  }

  function resetItemStyle(li: HTMLElement) {
    li.dataset.state = "idle";
    li.classList.remove("correct", "wrong", "dragging");
    const iconC = li.querySelector<HTMLElement>("[data-icon-correct]")!;
    const iconW = li.querySelector<HTMLElement>("[data-icon-wrong]")!;
    iconC.hidden = true;
    iconW.hidden = true;
  }

  function markCorrect(li: HTMLElement) {
    resetItemStyle(li);
    li.dataset.state = "correct";
    li.classList.add("correct");
    (li.querySelector<HTMLElement>("[data-icon-correct]")!).hidden = false;
  }

  function markWrong(li: HTMLElement) {
    resetItemStyle(li);
    li.dataset.state = "wrong";
    li.classList.add("wrong");
    (li.querySelector<HTMLElement>("[data-icon-wrong]")!).hidden = false;
  }

  function initDragOrder(root: HTMLElement) {
    const list = root.querySelector<HTMLOListElement>("[data-items]");
    if (!list) return;
    const original = Array.from(list.children) as HTMLElement[];
    const pieceSlug = root.dataset.pieceSlug ?? "";
    const id = root.id;
    const completedBadge = root.querySelector<HTMLElement>("[data-completed-badge]")!;
    const statusEl = root.querySelector<HTMLElement>("[data-status]")!;
    const checkBtn = root.querySelector<HTMLButtonElement>('[data-action="check"]')!;

    function applyShuffle() {
      const shuffled = shuffle(original);
      if (shuffled.length > 1 && shuffled.every((el, i) => Number(el.dataset.correctIndex) === i)) {
        [shuffled[0], shuffled[1]] = [shuffled[1], shuffled[0]];
      }
      list!.innerHTML = "";
      shuffled.forEach((el) => list!.appendChild(el));
      renumber(list!);
    }
    applyShuffle();

    let dragged: HTMLElement | null = null;

    function moveItem(li: HTMLElement, direction: number) {
      if (checkBtn.disabled) return;
      const sibling = direction < 0 ? li.previousElementSibling : li.nextElementSibling;
      if (!sibling) return;
      if (direction < 0) list!.insertBefore(li, sibling);
      else list!.insertBefore(sibling, li);
      renumber(list!);
      list!.querySelectorAll<HTMLElement>("li").forEach(resetItemStyle);
      statusEl.hidden = true;
    }

    list.addEventListener("click", (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-move]");
      const li = button?.closest<HTMLElement>("li");
      if (button && li) moveItem(li, Number(button.dataset.move));
    });

    list.addEventListener("keydown", (e) => {
      if (!(e.target instanceof HTMLElement) || !e.target.matches("[data-grip]")) return;
      if (e.key !== "ArrowUp" && e.key !== "ArrowDown") return;
      e.preventDefault();
      const li = e.target.closest<HTMLElement>("li");
      if (li) moveItem(li, e.key === "ArrowUp" ? -1 : 1);
    });

    list.addEventListener("dragstart", (e) => {
      if (checkBtn.disabled) { e.preventDefault(); return; }
      const t = (e.target as HTMLElement).closest("li") as HTMLElement | null;
      if (!t) return;
      dragged = t;
      t.classList.add("dragging");
      // remove wiggle hint once user starts dragging
      list!.querySelectorAll("[data-grip]").forEach((g) => g.classList.remove("animate-wiggle-hint"));
      if (e.dataTransfer) {
        e.dataTransfer.effectAllowed = "move";
        try { e.dataTransfer.setData("text/plain", ""); } catch {}
      }
    });

    list.addEventListener("dragover", (e) => {
      e.preventDefault();
      const t = (e.target as HTMLElement).closest("li") as HTMLElement | null;
      if (!t || !dragged || t === dragged) return;
      const rect = t.getBoundingClientRect();
      const before = (e.clientY - rect.top) < rect.height / 2;
      list!.insertBefore(dragged, before ? t : t.nextSibling);
    });

    list.addEventListener("dragend", () => {
      if (dragged) {
        dragged.classList.remove("dragging");
      }
      dragged = null;
      renumber(list!);
    });

    checkBtn.addEventListener("click", async () => {
      checkBtn.disabled = true;
      const current = Array.from(list!.children) as HTMLElement[];
      let passed: boolean;
      try { passed = await submitLessonAttempt(id, current.map((li) => Number(li.dataset.correctIndex))); }
      catch {
        statusEl.hidden = false;
        statusEl.textContent = root.dataset.checkFailed ?? "Could not check your answer. Try again.";
        statusEl.className = "ml-auto text-[11.5px] font-mono text-danger";
        checkBtn.disabled = false;
        return;
      }
      let allCorrect = true;
      let wrongCount = 0;
      current.forEach((li, pos) => {
        const correctIdx = Number(li.dataset.correctIndex);
        if (correctIdx === pos) {
          markCorrect(li);
        } else {
          markWrong(li);
          allCorrect = false;
          wrongCount += 1;
        }
      });
      statusEl.hidden = false;
      if (allCorrect && passed) {
        statusEl.textContent = `✓ ${root.dataset.allCorrect}`;
        statusEl.className = "ml-auto text-[11.5px] font-mono uppercase tracking-wider text-ok";
        completedBadge.hidden = false;
        root.classList.add("opacity-60");
        checkBtn.disabled = true;
        root.querySelectorAll<HTMLButtonElement>("[data-move], [data-grip]").forEach((button) => { button.disabled = true; });
        persist(pieceSlug, id, { completed: true, lastAt: Date.now() });
      } else {
        statusEl.textContent = `${root.dataset.incorrect}: ${wrongCount}`;
        statusEl.className = "ml-auto text-[11.5px] font-mono uppercase tracking-wider text-danger";
        checkBtn.disabled = false;
      }
    });

    root.querySelector<HTMLButtonElement>('[data-action="reset"]')!.addEventListener("click", () => {
      applyShuffle();
      list!.querySelectorAll<HTMLElement>("li").forEach(resetItemStyle);
      statusEl.hidden = true;
      completedBadge.hidden = true;
      root.classList.remove("opacity-60");
      checkBtn.disabled = false;
      root.querySelectorAll<HTMLButtonElement>("[data-move], [data-grip]").forEach((button) => { button.disabled = false; });
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-drag-order]").forEach(initDragOrder);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>

<style>
  .move-controls { display: none; }
  @media (max-width: 640px) {
    .drag-item [data-grip] { display: none; }
    .move-controls { display: grid; flex: none; }
    .move-btn { min-width: 44px; min-height: 44px; color: var(--muted); }
    .move-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  }
</style>
