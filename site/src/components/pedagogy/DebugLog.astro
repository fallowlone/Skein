---
import { t, type Locale } from "../../i18n";

type Props = {
  id: string;
  pieceSlug: string;
  lang: Locale;
  title?: string;
  output: string;
  outputLang?: string;
  question: string;
  hint: string;
  answer: string;
};

const { id, pieceSlug, lang, title, output, outputLang = "log", question, hint, answer } = Astro.props;
---
<section
  id={id}
  data-debug-log
  data-piece-slug={pieceSlug}
  class="relative rounded-[var(--r-lg)] border-[0.5px] border-hairline-2 bg-card p-6 transition-opacity duration-200 my-8"
>
  <header class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2.5">
      <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
      <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-muted font-medium">{t("debugLog.title", lang)}</span>
    </div>
    <span data-completed-badge class="ex-done-badge" hidden>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      Completed
    </span>
  </header>
  {title && <h3 class="font-display text-[18px] font-[460] text-ink leading-snug mb-4 tracking-tight">{title}</h3>}

  <div class="rounded-[var(--r-sm)] overflow-hidden bg-[var(--code-bg)] border-[0.5px] border-hairline-2">
    <div class="flex items-center justify-between px-3 py-2 border-b border-hairline">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]/70"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#FEBC2E]/70"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#28C840]/70"></span>
      </div>
      <span class="font-mono text-[10px] uppercase tracking-wider text-faint">{outputLang}</span>
    </div>
    <pre class="font-mono text-[12.5px] leading-relaxed px-4 py-3.5 text-[var(--code-ink)] overflow-x-auto whitespace-pre"><code>{output}</code></pre>
  </div>

  <p class="text-ink mt-4 mb-3 text-[14px] leading-relaxed">{question}</p>

  <div class="flex items-center gap-2 mt-4">
    <button
      type="button"
      data-action="hint"
      data-active="false"
      class="inline-flex items-center gap-1.5 rounded-[var(--r-sm)] border-[0.5px] border-hairline-2 bg-card text-muted text-[12.5px] font-medium px-3 py-1.5 hover:border-warn hover:bg-card-2 hover:text-warn transition focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 outline-none"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 22h4M12 2a7 7 0 00-4 12.7c.7.7 1 1.5 1 2.3v1h6v-1c0-.8.3-1.6 1-2.3A7 7 0 0012 2z"/></svg>
      <span data-hint-label>{t("debugLog.hint", lang)}</span>
    </button>
    <button
      type="button"
      data-action="answer"
      data-active="false"
      class="inline-flex items-center gap-1.5 rounded-[var(--r-sm)] border-[0.5px] border-hairline-2 bg-card text-muted text-[12.5px] font-medium px-3 py-1.5 hover:border-ok hover:bg-card-2 hover:text-ok transition focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 outline-none"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
      <span data-answer-label>{t("debugLog.answer", lang)}</span>
    </button>
    <button
      type="button"
      data-action="reset"
      class="ml-auto inline-flex items-center gap-1 rounded-[var(--r-sm)] text-muted text-[12px] font-medium px-2 py-1 hover:bg-card-2 hover:text-ink transition outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
      hidden
      data-reset-btn
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 019-9 9 9 0 016.7 3M21 3v6h-6M21 12a9 9 0 01-9 9 9 9 0 01-6.7-3M3 21v-6h6"/></svg>
      Reset
    </button>
  </div>

  <div data-hint hidden class="mt-3 rounded-[var(--r-sm)] border-l-2 border-warn bg-card-2 px-4 py-3 animate-reveal-up">
    <div class="flex items-start gap-2">
      <span class="text-warn mt-0.5 shrink-0">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 22h4M12 2a7 7 0 00-4 12.7c.7.7 1 1.5 1 2.3v1h6v-1c0-.8.3-1.6 1-2.3A7 7 0 0012 2z"/></svg>
      </span>
      <div>
        <div class="font-mono text-[10px] uppercase tracking-wider text-warn font-semibold mb-1">Hint</div>
        <div class="text-[13px] leading-relaxed text-muted">{hint}</div>
      </div>
    </div>
  </div>

  <div data-answer hidden class="mt-3 rounded-[var(--r-sm)] border-l-2 border-ok bg-card-2 px-4 py-3 animate-reveal-up">
    <div class="flex items-start gap-2">
      <span class="text-ok mt-0.5 shrink-0">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      </span>
      <div>
        <div class="font-mono text-[10px] uppercase tracking-wider text-ok font-semibold mb-1">Answer</div>
        <div class="text-[13px] leading-relaxed text-muted">{answer}</div>
      </div>
    </div>
  </div>
</section>

<script>
  type State = { completed: boolean; lastAt: number };
  const KEY = "awesome.user-state.v1";

  function persist(pieceSlug: string, id: string, state: State) {
    try {
      const raw = localStorage.getItem(KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      parsed.exercises ??= {};
      parsed.exercises[pieceSlug] ??= {};
      parsed.exercises[pieceSlug][id] = state;
      localStorage.setItem(KEY, JSON.stringify(parsed));
    } catch {}
  }

  function setHintActive(btn: HTMLButtonElement, active: boolean) {
    btn.dataset.active = active ? "true" : "false";
    const label = btn.querySelector<HTMLElement>("[data-hint-label]");
    if (active) {
      btn.classList.remove("border-hairline-2", "bg-card", "text-muted", "hover:border-warn", "hover:bg-card-2", "hover:text-warn");
      btn.classList.add("border-warn", "bg-card-2", "text-warn");
      if (label) label.textContent = "Hint shown";
    } else {
      btn.classList.remove("border-warn", "bg-card-2", "text-warn");
      btn.classList.add("border-hairline-2", "bg-card", "text-muted", "hover:border-warn", "hover:bg-card-2", "hover:text-warn");
    }
  }

  function setAnswerActive(btn: HTMLButtonElement, active: boolean) {
    btn.dataset.active = active ? "true" : "false";
    const label = btn.querySelector<HTMLElement>("[data-answer-label]");
    if (active) {
      btn.classList.remove("border-hairline-2", "bg-card", "text-muted", "hover:border-ok", "hover:bg-card-2", "hover:text-ok");
      btn.classList.add("border-ok", "bg-card-2", "text-ok");
      if (label) label.textContent = "Answer shown";
    } else {
      btn.classList.remove("border-ok", "bg-card-2", "text-ok");
      btn.classList.add("border-hairline-2", "bg-card", "text-muted", "hover:border-ok", "hover:bg-card-2", "hover:text-ok");
    }
  }

  function initDebug(root: HTMLElement) {
    const pieceSlug = root.dataset.pieceSlug ?? "";
    const id = root.id;
    const hint = root.querySelector<HTMLElement>("[data-hint]")!;
    const answer = root.querySelector<HTMLElement>("[data-answer]")!;
    const hintBtn = root.querySelector<HTMLButtonElement>('[data-action="hint"]')!;
    const answerBtn = root.querySelector<HTMLButtonElement>('[data-action="answer"]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-reset-btn]")!;
    const completedBadge = root.querySelector<HTMLElement>("[data-completed-badge]")!;

    function updateResetVisibility() {
      const show = !hint.hidden || !answer.hidden;
      resetBtn.hidden = !show;
    }

    hintBtn.addEventListener("click", () => {
      hint.hidden = false;
      setHintActive(hintBtn, true);
      updateResetVisibility();
    });

    answerBtn.addEventListener("click", () => {
      answer.hidden = false;
      setAnswerActive(answerBtn, true);
      completedBadge.hidden = false;
      root.classList.add("opacity-60");
      updateResetVisibility();
      persist(pieceSlug, id, { completed: true, lastAt: Date.now() });
    });

    resetBtn.addEventListener("click", () => {
      hint.hidden = true;
      answer.hidden = true;
      setHintActive(hintBtn, false);
      setAnswerActive(answerBtn, false);
      const label = hintBtn.querySelector<HTMLElement>("[data-hint-label]");
      if (label) label.textContent = "Hint";
      completedBadge.hidden = true;
      root.classList.remove("opacity-60");
      updateResetVisibility();
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-debug-log]").forEach(initDebug);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
