---
import { t, type Locale } from "../../i18n";

type Choice = { label: string; correct?: boolean; misconception?: string };

type Props = {
  id: string;
  /** Progress key. Most lessons pass `lessonSlug`; older pieces pass `pieceSlug`. */
  lessonSlug?: string;
  pieceSlug?: string;
  lang: Locale;
  question: string;
  choices: Choice[];
};

const { id, lessonSlug, pieceSlug, lang, question, choices } = Astro.props;
const slug = lessonSlug ?? pieceSlug ?? "";
const letters = ["A", "B", "C", "D", "E", "F"];
---
<section
  id={id}
  data-quiz
  data-piece-slug={slug}
  class="relative rounded-2xl border-2 border-gray-200 bg-card p-6 transition-opacity duration-200 my-8"
>
  <header class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2.5">
      <span class="w-1.5 h-1.5 rounded-full bg-bbg-teal"></span>
      <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-bbg-muted font-medium">{t("quiz.title", lang)}</span>
    </div>
    <span data-completed-badge class="inline-flex items-center gap-1 text-[11px] font-medium text-bbg-success" hidden>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      Completed
    </span>
  </header>
  <h3 class="text-[17px] font-semibold text-bbg-ink leading-snug mb-4 tracking-tight">{question}</h3>
  <div class="space-y-2.5">
    {choices.map((c, i) => (
      <div>
        <button
          type="button"
          data-choice-index={i}
          data-correct={c.correct ? "true" : "false"}
          class="group w-full text-left rounded-xl border-2 border-gray-200 bg-white hover:border-gray-300 hover:bg-bbg-paper hover:shadow-soft-sm px-4 py-3 flex items-start gap-3 transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-bbg-purple focus-visible:ring-offset-2 outline-none"
        >
          <span data-badge class="font-mono shrink-0 w-7 h-7 rounded-md grid place-items-center text-[12px] font-semibold mt-[1px] transition-colors bg-gray-100 text-bbg-muted group-hover:bg-gray-200">
            {letters[i] ?? String(i + 1)}
          </span>
          <span class="flex-1 text-[14px] leading-relaxed text-bbg-ink pt-1">{c.label}</span>
          <span data-icon-correct class="text-bbg-success shrink-0 pt-1" hidden>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          </span>
          <span data-icon-wrong class="text-bbg-warn shrink-0 pt-1" hidden>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </span>
        </button>
        {c.misconception && (
          <div data-misconception-for={i} class="mt-2 ml-10 rounded-md px-3 py-2 text-[12.5px] leading-relaxed animate-reveal-up bg-panel-rose border-l-[3px] border-bbg-warn text-rose-900" hidden>
            <span class="font-mono uppercase tracking-wider text-[10px] text-bbg-warn font-semibold block mb-0.5">Heads-up</span>
            {c.misconception}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<script>
  type State = { completed: boolean; lastAt: number };
  const KEY = "awesome.user-state.v1";

  function readExerciseState(pieceSlug: string, exerciseId: string): State | null {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      return parsed?.exercises?.[pieceSlug]?.[exerciseId] ?? null;
    } catch { return null; }
  }

  function writeExerciseState(pieceSlug: string, exerciseId: string, state: State) {
    try {
      const raw = localStorage.getItem(KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      parsed.exercises ??= {};
      parsed.exercises[pieceSlug] ??= {};
      parsed.exercises[pieceSlug][exerciseId] = state;
      localStorage.setItem(KEY, JSON.stringify(parsed));
    } catch {}
  }

  function setChoiceState(btn: HTMLButtonElement, state: "idle" | "correct" | "wrong" | "dim") {
    const badge = btn.querySelector<HTMLElement>("[data-badge]")!;
    const iconCorrect = btn.querySelector<HTMLElement>("[data-icon-correct]")!;
    const iconWrong = btn.querySelector<HTMLElement>("[data-icon-wrong]")!;
    btn.classList.remove(
      "border-gray-200", "border-bbg-success", "border-bbg-warn",
      "bg-white", "bg-panel-mint", "bg-panel-rose",
      "hover:border-gray-300", "hover:bg-bbg-paper", "hover:shadow-soft-sm",
      "opacity-50"
    );
    badge.classList.remove("bg-gray-100", "text-bbg-muted", "group-hover:bg-gray-200", "bg-bbg-success", "bg-bbg-warn", "text-white");
    iconCorrect.hidden = state !== "correct";
    iconWrong.hidden = state !== "wrong";
    if (state === "correct") {
      btn.classList.add("border-bbg-success", "bg-panel-mint");
      badge.classList.add("bg-bbg-success", "text-white");
      iconCorrect.classList.add("animate-check-pop");
    } else if (state === "wrong") {
      btn.classList.add("border-bbg-warn", "bg-panel-rose");
      badge.classList.add("bg-bbg-warn", "text-white");
    } else if (state === "dim") {
      btn.classList.add("border-gray-200", "bg-white", "opacity-50");
      badge.classList.add("bg-gray-100", "text-bbg-muted");
    } else {
      btn.classList.add("border-gray-200", "bg-white", "hover:border-gray-300", "hover:bg-bbg-paper", "hover:shadow-soft-sm");
      badge.classList.add("bg-gray-100", "text-bbg-muted", "group-hover:bg-gray-200");
    }
  }

  function initQuiz(root: HTMLElement) {
    const id = root.id;
    const pieceSlug = root.dataset.pieceSlug ?? "";
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-choice-index]"));
    const completedBadge = root.querySelector<HTMLElement>("[data-completed-badge]")!;
    let answered = false;

    function markCompleted() {
      answered = true;
      root.classList.add("opacity-60");
      completedBadge.hidden = false;
      writeExerciseState(pieceSlug, id, { completed: true, lastAt: Date.now() });
    }

    function hideAllMisconceptions() {
      root.querySelectorAll<HTMLElement>("[data-misconception-for]").forEach((m) => { m.hidden = true; });
    }

    const stored = readExerciseState(pieceSlug, id);
    if (stored?.completed) {
      buttons.forEach((b) => {
        const correct = b.dataset.correct === "true";
        setChoiceState(b, correct ? "correct" : "dim");
      });
      root.classList.add("opacity-60");
      completedBadge.hidden = false;
      answered = true;
    }

    buttons.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        if (answered) return;
        const correct = btn.dataset.correct === "true";
        hideAllMisconceptions();
        if (correct) {
          buttons.forEach((b) => {
            const isThis = b === btn;
            setChoiceState(b, isThis ? "correct" : "dim");
          });
          markCompleted();
        } else {
          setChoiceState(btn, "wrong");
          const m = root.querySelector<HTMLElement>(`[data-misconception-for="${idx}"]`);
          if (m) m.hidden = false;
        }
      });
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-quiz]").forEach(initQuiz);
  }

  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
