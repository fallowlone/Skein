---
import { t, type Locale } from "../../i18n";

type Step = { prompt: string; reveal: string };

type Props = {
  id: string;
  pieceSlug: string;
  lang: Locale;
  scenario: string;
  steps: Step[];
};

const { id, pieceSlug, lang, scenario, steps } = Astro.props;
const total = steps.length;
---
<section
  id={id}
  data-trace-scenario
  data-piece-slug={pieceSlug}
  data-current="0"
  class="relative rounded-2xl border-2 border-gray-200 bg-white p-6 transition-opacity duration-200 my-8"
>
  <header class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2.5">
      <span class="w-1.5 h-1.5 rounded-full bg-bbg-success"></span>
      <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-bbg-muted font-medium">{t("trace.title", lang)}</span>
    </div>
    <span data-step-counter class="font-mono text-[11px] text-bbg-muted tabular-nums">1/{total}</span>
  </header>
  <h3 class="text-[17px] font-semibold text-bbg-ink leading-snug mb-5 tracking-tight">{scenario}</h3>

  <div data-steps>
    {steps.map((s, i) => (
      <div data-step={i} data-step-state={i === 0 ? "current-collapsed" : "future"} class="relative flex gap-4">
        <div class="relative shrink-0 w-7 flex flex-col items-center">
          <div data-node class={`relative z-10 w-7 h-7 rounded-full border-2 grid place-items-center font-mono text-[12px] font-semibold ${i === 0 ? "bg-white text-bbg-purple border-bbg-purple" : "bg-white text-bbg-muted border-gray-200"}`}>
            <span data-node-num>{i + 1}</span>
            <span data-node-check hidden>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
          </div>
          {i < total - 1 && (
            <div data-spine class="flex-1 w-[2px] mt-1 bg-gray-200"></div>
          )}
        </div>

        <div data-card class={`flex-1 rounded-xl border px-4 py-3 mb-3 transition-colors ${i === 0 ? "border-bbg-purple/30 bg-bbg-paper" : "border-gray-200 bg-bbg-paper/60 opacity-60"}`}>
          <div class="flex items-start gap-3">
            <div class="flex-1 min-w-0">
              <div data-card-label class={`text-[10.5px] font-mono uppercase tracking-wider mb-1 ${i === 0 ? "text-bbg-purple" : "text-bbg-muted"}`}>
                {i === 0 ? `Step 1 of ${total}` : "Locked"}
              </div>
              <div class="text-[14px] text-bbg-ink leading-relaxed font-medium">{s.prompt}</div>
              <div data-reveal hidden class="mt-3 pt-3 border-t border-dashed border-bbg-purple/20 animate-reveal-up">
                <div class="text-[13.5px] leading-relaxed text-bbg-annot">{s.reveal}</div>
              </div>
            </div>
            {i > 0 && (
              <span data-lock class="text-bbg-muted shrink-0 mt-0.5">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>
              </span>
            )}
          </div>

          <button
            type="button"
            data-action="reveal"
            class={`mt-3 inline-flex items-center gap-1.5 rounded-lg bg-bbg-purple text-white text-[12.5px] font-medium px-3 py-1.5 hover:bg-bbg-purple/90 transition focus-visible:ring-2 focus-visible:ring-bbg-purple focus-visible:ring-offset-2 outline-none ${i === 0 ? "" : "hidden"}`}
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            {t("trace.reveal", lang)}
          </button>
          <button
            type="button"
            data-action="next"
            class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-bbg-purple text-white text-[12.5px] font-medium px-3 py-1.5 hover:bg-bbg-purple/90 transition focus-visible:ring-2 focus-visible:ring-bbg-purple focus-visible:ring-offset-2 outline-none hidden"
          >
            <span data-next-label>{i === total - 1 ? "Finish" : t("trace.next", lang)}</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    ))}
  </div>

  <div data-done class="mt-2 flex items-center gap-3 rounded-xl border-2 border-bbg-success bg-panel-mint px-4 py-3 animate-reveal-up" hidden>
    <span class="w-8 h-8 rounded-full bg-bbg-success text-white grid place-items-center shrink-0 animate-check-pop">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
    </span>
    <div>
      <div class="text-[13px] font-semibold text-bbg-success">{t("trace.done", lang)}</div>
    </div>
  </div>
</section>

<script>
  type State = { completed: boolean; lastAt: number };
  const KEY = "awesome.user-state.v1";

  function persist(pieceSlug: string, id: string, state: State) {
    try {
      const raw = localStorage.getItem(KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      parsed.exercises ??= {};
      parsed.exercises[pieceSlug] ??= {};
      parsed.exercises[pieceSlug][id] = state;
      localStorage.setItem(KEY, JSON.stringify(parsed));
    } catch {}
  }

  function applyState(stepEl: HTMLElement, state: "past" | "current-collapsed" | "current-revealed" | "future", n: number, total: number) {
    stepEl.dataset.stepState = state;
    const node = stepEl.querySelector<HTMLElement>("[data-node]")!;
    const nodeNum = stepEl.querySelector<HTMLElement>("[data-node-num]")!;
    const nodeCheck = stepEl.querySelector<HTMLElement>("[data-node-check]")!;
    const card = stepEl.querySelector<HTMLElement>("[data-card]")!;
    const label = stepEl.querySelector<HTMLElement>("[data-card-label]")!;
    const reveal = stepEl.querySelector<HTMLElement>("[data-reveal]")!;
    const lock = stepEl.querySelector<HTMLElement>("[data-lock]");
    const revealBtn = stepEl.querySelector<HTMLButtonElement>('[data-action="reveal"]')!;
    const nextBtn = stepEl.querySelector<HTMLButtonElement>('[data-action="next"]')!;
    const spine = stepEl.querySelector<HTMLElement>("[data-spine]");

    node.className = "relative z-10 w-7 h-7 rounded-full border-2 grid place-items-center font-mono text-[12px] font-semibold";
    card.className = "flex-1 rounded-xl border px-4 py-3 mb-3 transition-colors";
    label.className = "text-[10.5px] font-mono uppercase tracking-wider mb-1";
    if (lock) lock.hidden = state !== "future";
    revealBtn.classList.add("hidden");
    nextBtn.classList.add("hidden");
    nodeNum.hidden = false;
    nodeCheck.hidden = true;
    reveal.hidden = state !== "current-revealed" && state !== "past";

    if (state === "past") {
      node.classList.add("bg-bbg-success", "text-white", "border-bbg-success");
      nodeNum.hidden = true;
      nodeCheck.hidden = false;
      card.classList.add("border-bbg-success/30", "bg-panel-mint/40");
      label.classList.add("text-bbg-success");
      label.textContent = "Step done";
      if (spine) {
        spine.className = "flex-1 w-[2px] mt-1 bg-bbg-success/40";
      }
    } else if (state === "current-collapsed") {
      node.classList.add("bg-white", "text-bbg-purple", "border-bbg-purple");
      card.classList.add("border-bbg-purple/30", "bg-bbg-paper");
      label.classList.add("text-bbg-purple");
      label.textContent = `Step ${n} of ${total}`;
      revealBtn.classList.remove("hidden");
    } else if (state === "current-revealed") {
      node.classList.add("bg-white", "text-bbg-purple", "border-bbg-purple");
      card.classList.add("border-bbg-purple/40", "bg-white", "shadow-soft-sm");
      label.classList.add("text-bbg-purple");
      label.textContent = `Step ${n} of ${total}`;
      nextBtn.classList.remove("hidden");
    } else {
      node.classList.add("bg-white", "text-bbg-muted", "border-gray-200");
      card.classList.add("border-gray-200", "bg-bbg-paper/60", "opacity-60");
      label.classList.add("text-bbg-muted");
      label.textContent = "Locked";
      if (spine) {
        spine.className = "flex-1 w-[2px] mt-1 bg-gray-200";
      }
    }
  }

  function initTrace(root: HTMLElement) {
    const pieceSlug = root.dataset.pieceSlug ?? "";
    const id = root.id;
    const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-step]"));
    const total = steps.length;
    const counter = root.querySelector<HTMLElement>("[data-step-counter]")!;
    const done = root.querySelector<HTMLElement>("[data-done]")!;
    let current = 0;
    let revealed = false;

    function render() {
      steps.forEach((step, i) => {
        let state: "past" | "current-collapsed" | "current-revealed" | "future";
        if (i < current) state = "past";
        else if (i === current) state = revealed ? "current-revealed" : "current-collapsed";
        else state = "future";
        applyState(step, state, i + 1, total);
      });
      counter.textContent = current >= total ? `${total}/${total}` : `${current + 1}/${total}`;
    }

    render();

    steps.forEach((step) => {
      step.querySelector<HTMLButtonElement>('[data-action="reveal"]')!.addEventListener("click", () => {
        revealed = true;
        render();
      });
      step.querySelector<HTMLButtonElement>('[data-action="next"]')!.addEventListener("click", () => {
        if (current + 1 >= total) {
          // finish
          steps.forEach((s, i) => applyState(s, "past", i + 1, total));
          counter.textContent = `${total}/${total}`;
          done.hidden = false;
          persist(pieceSlug, id, { completed: true, lastAt: Date.now() });
          return;
        }
        current += 1;
        revealed = false;
        render();
      });
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-trace-scenario]").forEach(initTrace);
  }
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
