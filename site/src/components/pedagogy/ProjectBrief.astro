---
import { type Locale } from "../../i18n";

type Props = {
  id: string;
  /** Progress key — the unit/lesson slug this brief belongs to. */
  lessonSlug?: string;
  pieceSlug?: string;
  lang: Locale;
  /** One-line objective: what the learner builds and why. */
  objective: string;
  /** Hard requirements — the checklist that defines "done". */
  requirements: string[];
  /** How to know each requirement actually works (observable, testable). */
  acceptance: string[];
  /** Optional senior-level extensions beyond the baseline. */
  stretch?: string[];
};

const { id, lessonSlug, pieceSlug, lang, objective, requirements, acceptance, stretch = [] } =
  Astro.props;
const slug = lessonSlug ?? pieceSlug ?? "";

const L = {
  kicker: lang === "ru" ? "Проект" : "Project",
  objective: lang === "ru" ? "Цель" : "Objective",
  requirements: lang === "ru" ? "Требования" : "Requirements",
  acceptance: lang === "ru" ? "Критерии приёмки" : "Acceptance criteria",
  stretch: lang === "ru" ? "Senior-стретч" : "Senior stretch",
  done: lang === "ru" ? "Сделано" : "Done",
  progress: lang === "ru" ? "из" : "of",
};
---
<section
  id={id}
  data-project-brief
  data-piece-slug={slug}
  class="relative rounded-2xl border-2 border-gray-200 bg-card p-6 transition-opacity duration-200 my-8"
>
  <header class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2.5">
      <span class="w-1.5 h-1.5 rounded-full bg-bbg-purple"></span>
      <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-bbg-muted font-medium">{L.kicker}</span>
    </div>
    <span data-progress class="font-mono text-[11px] text-bbg-muted tabular-nums">0 {L.progress} {requirements.length}</span>
  </header>

  <div class="mb-5">
    <span class="font-mono uppercase tracking-wider text-[10px] text-bbg-purple font-semibold block mb-1">{L.objective}</span>
    <p class="text-[15px] leading-relaxed text-bbg-ink">{objective}</p>
  </div>

  <div class="mb-5">
    <span class="font-mono uppercase tracking-wider text-[10px] text-bbg-muted font-semibold block mb-2">{L.requirements}</span>
    <ul class="space-y-2">
      {requirements.map((r, i) => (
        <li>
          <button
            type="button"
            data-req-index={i}
            class="group w-full text-left rounded-xl border-2 border-gray-200 bg-white hover:border-gray-300 hover:bg-bbg-paper px-4 py-2.5 flex items-start gap-3 transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-bbg-purple focus-visible:ring-offset-2 outline-none"
          >
            <span data-box class="shrink-0 w-5 h-5 mt-[1px] rounded-md border-2 border-gray-300 grid place-items-center transition-colors">
              <svg data-check class="text-white" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="flex-1 text-[14px] leading-relaxed text-bbg-ink">{r}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div class={stretch.length ? "mb-5" : ""}>
    <span class="font-mono uppercase tracking-wider text-[10px] text-bbg-muted font-semibold block mb-2">{L.acceptance}</span>
    <ul class="space-y-1.5 pl-1">
      {acceptance.map((a) => (
        <li class="flex items-start gap-2.5 text-[13.5px] leading-relaxed text-bbg-ink">
          <span class="mt-[7px] w-1.5 h-1.5 rounded-full bg-bbg-teal shrink-0"></span>
          <span>{a}</span>
        </li>
      ))}
    </ul>
  </div>

  {stretch.length > 0 && (
    <div class="rounded-xl bg-panel-lilac border-l-[3px] border-bbg-purple px-4 py-3">
      <span class="font-mono uppercase tracking-wider text-[10px] text-bbg-purple font-semibold block mb-1.5">{L.stretch}</span>
      <ul class="space-y-1.5">
        {stretch.map((s) => (
          <li class="flex items-start gap-2.5 text-[13px] leading-relaxed text-bbg-ink">
            <span class="mt-[7px] w-1.5 h-1.5 rounded-full bg-bbg-purple shrink-0"></span>
            <span>{s}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<script>
  const KEY = "awesome.user-state.v1";

  function readReqs(slug: string, id: string): number[] {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      return parsed?.projects?.[slug]?.[id]?.checked ?? [];
    } catch { return []; }
  }

  function writeReqs(slug: string, id: string, checked: number[]) {
    try {
      const raw = localStorage.getItem(KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      parsed.projects ??= {};
      parsed.projects[slug] ??= {};
      parsed.projects[slug][id] = { checked, lastAt: Date.now() };
      localStorage.setItem(KEY, JSON.stringify(parsed));
    } catch {}
  }

  function setBox(btn: HTMLButtonElement, on: boolean) {
    const box = btn.querySelector<HTMLElement>("[data-box]")!;
    const check = btn.querySelector<HTMLElement>("[data-check]")!;
    box.classList.toggle("border-gray-300", !on);
    box.classList.toggle("border-bbg-success", on);
    box.classList.toggle("bg-bbg-success", on);
    check.hidden = !on;
  }

  function initBrief(root: HTMLElement) {
    const id = root.id;
    const slug = root.dataset.pieceSlug ?? "";
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-req-index]"));
    const progress = root.querySelector<HTMLElement>("[data-progress]")!;
    const total = buttons.length;
    const checked = new Set<number>(readReqs(slug, id));

    function render() {
      buttons.forEach((b, i) => setBox(b, checked.has(i)));
      const n = checked.size;
      progress.textContent = progress.textContent!.replace(/^\d+/, String(n));
      root.classList.toggle("opacity-60", n === total && total > 0);
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener("click", () => {
        if (checked.has(i)) checked.delete(i);
        else checked.add(i);
        writeReqs(slug, id, Array.from(checked).sort((a, b) => a - b));
        render();
      });
    });
    render();
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-project-brief]").forEach(initBrief);
  }

  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);
</script>
