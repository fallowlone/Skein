---
import Topic from "./Topic.astro";
import ChapterSidebar from "../components/nav/ChapterSidebar.astro";
import { type Locale } from "../i18n";

type Depth = { mechanism: string; tradeoff: string; failure_mode: string; numbers: string };
type Props = {
  title: string;
  lang: Locale;
  pillarSlug: string;
  chapterSlug: string;
  currentPiece?: string;
  sources?: string[];
  depth?: Depth;
};
const { title, lang, pillarSlug, chapterSlug, currentPiece, sources, depth } = Astro.props;
---
<Topic title={title} lang={lang} sources={sources} depth={depth}>
  <div class="grid grid-cols-1 md:grid-cols-[280px_minmax(0,1fr)] gap-10">
    <aside class="md:sticky md:top-24 self-start">
      <ChapterSidebar
        lang={lang}
        pillarSlug={pillarSlug}
        chapterSlug={chapterSlug}
        currentPiece={currentPiece}
      />
    </aside>
    <article class="max-w-[840px]">
      <slot />
    </article>
  </div>
</Topic>
