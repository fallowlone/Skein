---
import { getCollection, getEntry } from "astro:content";
import Topic from "./Topic.astro";
import ChapterSidebar from "../components/nav/ChapterSidebar.astro";
import PieceHeader from "../components/nav/PieceHeader.astro";
import ReadingProgress from "../components/nav/ReadingProgress.astro";
import PrereqStrip from "../components/nav/PrereqStrip.astro";
import DepthBadges from "../components/nav/DepthBadges.astro";
import PieceTOC from "../components/nav/PieceTOC.astro";
import NextPieceCard from "../components/nav/NextPieceCard.astro";
import RelatedPieces from "../components/nav/RelatedPieces.astro";
import PersonaLegend from "../components/nav/PersonaLegend.astro";
import { type Locale } from "../i18n";

type Depth = { mechanism: string; tradeoff: string; failure_mode: string; numbers: string };
type Props = {
  title: string;
  lang: Locale;
  pillarSlug: string;
  chapterSlug: string;
  currentPiece?: string;
  sources?: string[];
  depth?: Depth;
  prereqs?: string[];
  readingMin?: number;
  spiral?: string[];
};

const {
  title,
  lang,
  pillarSlug,
  chapterSlug,
  currentPiece,
  sources,
  depth,
  prereqs = [],
  readingMin = 12,
  spiral = [],
} = Astro.props;

const pillar = await getEntry("pillars", pillarSlug);
const chapter = await getEntry("chapters", chapterSlug);
const allPieces = await getCollection("book", (e) => e.data.lang === lang && e.data.chapter === chapterSlug);

const pillarTitle = pillar?.data.title[lang] ?? pillarSlug;
const pillarColor = (pillar?.data.color ?? "lilac") as "lilac" | "mint" | "peach" | "sky" | "rose";
const chapterTitle = chapter?.data.title[lang] ?? chapterSlug;

const orderedSlugs = chapter?.data.pieces ?? [];
const idx = currentPiece ? orderedSlugs.indexOf(currentPiece) : -1;

function adjacent(targetIdx: number) {
  if (targetIdx < 0 || targetIdx >= orderedSlugs.length) return null;
  const slug = orderedSlugs[targetIdx];
  const p = allPieces.find((e) => e.data.slug === slug);
  if (!p) return null;
  return { slug, title: p.data.title };
}

const prev = idx > 0 ? adjacent(idx - 1) : null;
const next = idx >= 0 && idx < orderedSlugs.length - 1 ? adjacent(idx + 1) : null;
const pieceOrder = idx >= 0 ? idx + 1 : 1;
---
<Topic title={title} lang={lang} sources={sources} depth={depth}>
  <PieceHeader
    lang={lang}
    pillarSlug={pillarSlug}
    pillarTitle={pillarTitle}
    pillarColor={pillarColor}
    chapterTitle={chapterTitle}
    pieceOrder={pieceOrder}
    pieceTitle={title}
    prev={prev}
    next={next}
  />
  <ReadingProgress readingMin={readingMin} />

  <div class="grid grid-cols-1 lg:grid-cols-[260px_minmax(0,1fr)_260px] gap-x-10 gap-y-6 max-w-[1600px] mx-auto px-4 lg:px-8 mt-6">
    <aside class="hidden lg:block lg:sticky lg:top-[60px] self-start max-h-[calc(100vh-80px)] overflow-y-auto py-2 pr-2">
      <ChapterSidebar
        lang={lang}
        pillarSlug={pillarSlug}
        chapterSlug={chapterSlug}
        currentPiece={currentPiece}
      />
    </aside>

    <article class="min-w-0 max-w-[880px] mx-auto w-full pb-12">
      <header class="mb-6">
        <div class="meta mb-2">
          <span>{String(pieceOrder).padStart(2, "0")}</span>
          <span class="opacity-50 px-1">·</span>
          <span>{chapterTitle}</span>
        </div>
        <h1 class="font-display text-[clamp(28px,4vw,40px)] font-bold leading-[1.1] tracking-[-0.02em] m-0 text-ink" style="text-wrap: pretty;">
          {title}
        </h1>
      </header>
      {prereqs.length > 0 && (
        <PrereqStrip lang={lang} pillarSlug={pillarSlug} prereqs={prereqs} />
      )}
      {depth && <DepthBadges lang={lang} depth={depth} />}

      <slot />

      {currentPiece && (
        <NextPieceCard
          lang={lang}
          pillarSlug={pillarSlug}
          chapterSlug={chapterSlug}
          currentPiece={currentPiece}
        />
      )}
      {currentPiece && spiral.length > 0 && (
        <RelatedPieces
          lang={lang}
          pillarSlug={pillarSlug}
          currentPiece={currentPiece}
          spiral={spiral}
        />
      )}
    </article>

    <aside class="hidden lg:block lg:sticky lg:top-[60px] self-start max-h-[calc(100vh-80px)] overflow-y-auto py-2 pl-2 border-l border-rule">
      <PieceTOC lang={lang} depth={depth} />
    </aside>
  </div>

  <PersonaLegend lang={lang} />
</Topic>
