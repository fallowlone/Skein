---
import "~/styles/lesson-kit.css";
import Topic from "~/layouts/Topic.astro";
import { getCollection } from "astro:content";
import { t, type Locale } from "~/i18n";
import ConnectedLessons, { type ConnectionMeta } from "~/components/lesson/ConnectedLessons.astro";
import { getConnectionMap, getLocaleIndex } from "~/scripts/connections-cache";
import { resolveNextLesson } from "~/scripts/next-lesson";
import Topbar from "~/components/lesson/Topbar.astro";
import AltitudeGauge from "~/components/lesson/AltitudeGauge.astro";
import LessonPlate from "~/components/lesson/LessonPlate.astro";
import { TRACK_ABBR, DOMAIN_HUE, type TrackColor } from "~/scripts/track-meta";
import type { Track } from "~/types";
import RightRail from "~/components/lesson/RightRail.astro";
import NextLessonCard from "~/components/lesson/NextLessonCard.astro";
import PracticeSection from "~/components/pedagogy/PracticeSection.tsx";
import LessonQuestion from "~/components/lesson/LessonQuestion.tsx";
import PrereqLinks, { type PrereqLink } from "~/components/lesson/PrereqLinks.astro";
import type { PracticeTaskData } from "~/content.config";

type Level = "zero" | "junior" | "middle" | "senior";
type Props = {
  title: string;
  lang: Locale;
  trackSlug: string;
  unitSlug: string;
  summary: string;
  estMin: number;
  order: number;
  sources: string[];
  lessonType?: "concept" | "coding" | "topic";
  level?: Level;
  /** Required for topic lessons: "<track>/<unit>/<slug>" */
  lessonKey?: string;
  /** Lesson slug — used for the last-visited write */
  slug: string;
  /** Prerequisite lesson refs (bare slug or "<track>/<unit>/<slug>") */
  prereqs?: string[];
  /** Cross-track math prerequisite refs (always "math/<unit>/<slug>") */
  mathPrereqs?: string[];
  /** Practice tasks for this lesson, or null when none authored */
  practice?: PracticeTaskData[] | null;
};

const {
  title, lang, trackSlug, unitSlug, summary, estMin, order, sources,
  lessonType, level, lessonKey, slug, prereqs, mathPrereqs, practice,
} = Astro.props;

// Resolve track title for the breadcrumb
const allTracks = await getCollection("tracks");
const trackEntry = allTracks.find((t) => t.data.slug === trackSlug);
const trackTitle = trackEntry?.data.title[lang] ?? trackSlug;
const trackColor = (trackEntry?.data.color ?? "sky") as TrackColor;
const allUnits = await getCollection("units");
const unitOrder = allUnits.find(
  (u) => u.data.track === trackSlug && u.data.slug === unitSlug,
)?.data.order;

// Resolve connections graph (existing behaviour)
let connections: {
  buildsOn: string[]; unlocks: string[];
  deepensInto: string[]; appearsAgainIn: string[];
} | null = null;
let metaLookup: Record<string, ConnectionMeta> = {};

const allLessons = await getCollection("lessons");

if (lessonType === "topic" && lessonKey) {
  const connMap = getConnectionMap(allLessons);
  connections = connMap[lessonKey] ?? null;

  if (connections) {
    const byKey = getLocaleIndex(allLessons, lang);
    const allIds = [
      ...connections.buildsOn,
      ...connections.unlocks,
      ...connections.deepensInto,
      ...connections.appearsAgainIn,
    ];
    for (const id of allIds) {
      const entry = byKey.get(id);
      if (!entry) continue;
      metaLookup[id] = {
        title: entry.data.title,
        level: entry.data.level,
        track: entry.data.track,
        unit: entry.data.unit,
        href: `/${lang}/learn/${entry.data.track}/${entry.data.unit}/${entry.data.slug}`,
      };
    }
  }
}

// Resolve next-lesson card (within unit, fallback to next unit's first lesson)
const trackUnits = (await getCollection("units"))
  .filter((u) => u.data.track === trackSlug)
  .sort((a, b) => a.data.order - b.data.order)
  .map((u) => ({ slug: u.data.slug, order: u.data.order, lessons: u.data.lessons }));

const next = resolveNextLesson(trackUnits, unitSlug, slug);
const nextLessonEntry = next
  ? allLessons.find((l) => l.data.lang === lang && l.data.track === trackSlug && l.data.unit === next.unit && l.data.slug === next.slug)
  : null;
const nextHref = next ? `/${lang}/learn/${trackSlug}/${next.unit}/${next.slug}/` : null;
const nextTitle = nextLessonEntry?.data.title ?? null;

// For the last-visited write
const lessonHref = `/${lang}/learn/${trackSlug}/${unitSlug}/${slug}/`;
// Canonical lesson id for metrics + reader questions
const metricsKey = `${trackSlug}/${unitSlug}/${slug}`;

// Resolve the visible "Before this lesson" links from prereqs + mathPrereqs.
// Ref forms: bare slug → same track+unit; "<track>/<unit>/<slug>" → as-is.
// Dangling refs (no matching lesson in this locale) are dropped silently.
const prereqIndex = getLocaleIndex(allLessons, lang);
const prereqRefs = [...(prereqs ?? []), ...(mathPrereqs ?? [])];
const seenPrereq = new Set<string>();
const prereqLinks: PrereqLink[] = [];
for (const ref of prereqRefs) {
  const id = ref.includes("/") ? ref : `${trackSlug}/${unitSlug}/${ref}`;
  if (seenPrereq.has(id)) continue;
  seenPrereq.add(id);
  const entry = prereqIndex.get(id);
  const prereqTitle = entry?.data.title;
  if (!prereqTitle) continue;
  prereqLinks.push({
    title: prereqTitle,
    href: `/${lang}/learn/${entry.data.track}/${entry.data.unit}/${entry.data.slug}/`,
  });
}

import diagnosticsIndex from "~/content/path/diagnostics-index.json";
import unitConcepts from "~/content/path/unit-concepts.json";
const _diagSet = new Set(diagnosticsIndex as string[]);
const _unitTeaches = ((unitConcepts as Record<string, { teaches: string[] }>)[`${trackSlug}/${unitSlug}`]?.teaches) ?? [];
const showPreUnitCheck = order === 1 && _unitTeaches.some((c) => _diagSet.has(c));
const calibrateHref = `/${lang}/calibrate?unit=${trackSlug}/${unitSlug}`;
---

<Topic title={title} lang={lang} description={summary} sources={sources} cspExtra="wasm">
  <Topbar lang={lang} trackSlug={trackSlug} trackTitle={trackTitle} lessonTitle={title} />

  <div class="lesson-shell">
    <article class="lesson-body" data-lesson-type={lessonType}
      data-metrics-lesson={metricsKey} data-metrics-track={trackSlug} data-metrics-lang={lang}>
      <LessonPlate
        title={title}
        summary={summary}
        trackTitle={trackTitle}
        abbr={TRACK_ABBR[trackSlug as Track]}
        hue={DOMAIN_HUE[trackColor]}
        unitOrder={unitOrder}
        order={order}
        level={level}
        estMin={estMin}
        lang={lang}
      />
      <AltitudeGauge lang={lang} level={level} />

      <div class="lesson-content">
        <PrereqLinks lang={lang} links={prereqLinks} />
        {showPreUnitCheck && (
          <a href={calibrateHref} class="mb-4 block rounded border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm text-emerald-800 no-underline">
            {lang === "en" ? "Already know this unit? Take a 1-minute quick check →" : "Уже знаешь этот юнит? Пройди быструю проверку за минуту →"}
          </a>
        )}
        <slot />
      </div>

      {practice && practice.length > 0 && lessonKey && (
        <PracticeSection client:visible lang={lang} lessonKey={lessonKey} tasks={practice} />
      )}

      {lessonType === "topic" && connections && (
        <ConnectedLessons
          lang={lang}
          buildsOn={connections.buildsOn}
          unlocks={connections.unlocks}
          deepensInto={connections.deepensInto}
          appearsAgainIn={connections.appearsAgainIn}
          meta={metaLookup}
        />
      )}

      <LessonQuestion client:visible lang={lang} lessonKey={metricsKey} />

      <NextLessonCard lang={lang} nextHref={nextHref} nextTitle={nextTitle} />
    </article>

    <RightRail lang={lang} />
  </div>
</Topic>

<script>
  import { initLessonMetrics } from "~/scripts/metrics";
  const el = document.querySelector<HTMLElement>("[data-metrics-lesson]");
  if (el?.dataset.metricsLesson) {
    initLessonMetrics(el.dataset.metricsLesson, el.dataset.metricsTrack ?? "", el.dataset.metricsLang ?? "");
  }

  // PacketDot animation boots here, not in PacketDot.astro: the dots render
  // inside inline <svg>, where an emitted <script> becomes an SVGScriptElement
  // and a module script never executes. gsap loads only when a dot is present.
  const bootPackets = () => {
    const dots = document.querySelectorAll<SVGCircleElement>("[data-packet]");
    if (dots.length === 0) return;
    Promise.all([import("~/scripts/gsap-setup"), import("gsap")]).then(([{ setupGsap }, { gsap }]) => {
      if (!setupGsap()) return;
      dots.forEach((dot) => {
        const path = dot.ownerSVGElement?.querySelector<SVGPathElement>("[data-path]");
        if (!path || !path.getAttribute("d")) return;
        const duration = Number(dot.dataset.duration ?? "1800") / 1000;
        const delay = Number(dot.dataset.delay ?? "0") / 1000;
        gsap.set(dot, { opacity: 1 });
        gsap.to(dot, {
          duration,
          ease: "none",
          repeat: -1,
          repeatDelay: 0.4,
          delay,
          motionPath: { path, align: path, alignOrigin: [0.5, 0.5], autoRotate: false },
        });
      });
    });
  };
  if (document.readyState === "complete") bootPackets();
  else window.addEventListener("load", bootPackets, { once: true });
</script>

<script is:inline define:vars={{ lang, trackSlug, slug, title, lessonHref }}>
  try {
    localStorage.setItem(
      "atlas.last." + lang + "." + trackSlug,
      JSON.stringify({ slug, title, href: lessonHref, at: Date.now() })
    );
  } catch (_) { /* private browsing, storage full, etc. — non-fatal */ }
</script>

<style>
  .lesson-shell {
    max-width: 1080px; margin: 0 auto; padding: 0 32px;
    display: grid; grid-template-columns: minmax(0, 1fr) 232px; gap: 56px;
    align-items: start;
  }
  .lesson-body { padding: 40px 0 64px; min-width: 0; max-width: 680px; }
  .lesson-kicker {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--muted); margin: 0 0 14px;
  }
  .lesson-title {
    font-family: var(--font-display); font-size: clamp(34px, 5vw, 46px);
    font-weight: 520; line-height: 1.08; letter-spacing: -0.02em; margin: 0;
  }
  .lesson-crux {
    margin: 22px 0 0; padding: 16px 0 16px 20px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display); font-size: 19px; line-height: 1.55;
    font-weight: 400; color: var(--ink-2);
  }
  .crux-tag {
    display: block; font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
    margin-bottom: 7px;
  }
  .hdr-meta {
    display: flex; flex-wrap: wrap; gap: 18px; margin-top: 22px;
    padding-top: 18px; border-top: 0.5px solid var(--hairline);
  }
  .hm {
    font-family: var(--font-mono); font-size: 11px; color: var(--muted);
    letter-spacing: 0.03em;
  }

  /* ── editorial prose, scoped to MDX content body ── */
  .lesson-content { margin-top: 30px; }
  .lesson-content :global(h2) {
    font-family: var(--font-display); font-size: 25px; font-weight: 520;
    letter-spacing: -0.01em; margin: 38px 0 14px;
  }
  .lesson-content :global(h3) {
    font-family: var(--font-display); font-size: 19px; font-weight: 560;
    margin: 28px 0 10px;
  }
  .lesson-content :global(p) {
    font-size: 16.5px; line-height: 1.72; color: var(--ink-2); margin: 0 0 16px;
  }
  .lesson-content :global(code) {
    font-family: var(--font-mono); font-size: 0.85em;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    border: 0.5px solid var(--hairline);
    padding: 1px 5px; border-radius: var(--r-sm);
  }
  .lesson-content :global(pre:not(.astro-code)) {
    background: var(--code-bg, var(--card)); border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-md); padding: 14px 16px; overflow-x: auto;
    font-size: 13px; line-height: 1.65;
  }
  .lesson-content :global(pre code) {
    background: transparent; padding: 0; border-radius: 0; border: 0;
  }
  .lesson-content :global(ul),
  .lesson-content :global(ol) {
    font-size: 16.5px; line-height: 1.72; color: var(--ink-2);
    margin: 0 0 16px; padding-left: 24px;
  }
  .lesson-content :global(li) { margin-bottom: 6px; }
  .lesson-content :global(blockquote) {
    border-left: 2px solid var(--hairline-strong); padding-left: 16px;
    color: var(--muted); font-style: italic; margin: 16px 0;
  }
  .lesson-content :global(figure) { margin: 24px 0; }
  .lesson-content :global(figcaption) {
    font-family: var(--font-mono); font-size: 11px; color: var(--muted);
    margin-top: 9px; letter-spacing: 0.02em;
  }

  /* block-level lesson sections need breathing room */
  .lesson-content :global([data-lesson-section]) {
    margin-top: 32px;
    margin-bottom: 32px;
  }
  .lesson-content :global(details) {
    margin-top: 24px;
    margin-bottom: 24px;
  }
  .lesson-content :global([data-lesson-step]) {
    margin-top: 16px;
  }

  @media (max-width: 880px) {
    .lesson-shell { grid-template-columns: 1fr; gap: 0; padding-left: 20px; padding-right: 20px; }
    .lesson-body { max-width: 100%; }
  }
</style>
