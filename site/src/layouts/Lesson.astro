---
import "~/styles/lesson-kit.css";
import Topic from "~/layouts/Topic.astro";
import { t, type Locale } from "~/i18n";
import ConnectedLessons, { type ConnectionMeta } from "~/components/lesson/ConnectedLessons.astro";
import Topbar from "~/components/lesson/Topbar.astro";
import AltitudeGauge from "~/components/lesson/AltitudeGauge.astro";
import LessonPlate from "~/components/lesson/LessonPlate.astro";
import { TRACK_ABBR, DOMAIN_HUE, type TrackColor } from "~/scripts/track-meta";
import type { Track } from "~/types";
import RightRail from "~/components/lesson/RightRail.astro";
import NextLessonCard from "~/components/lesson/NextLessonCard.astro";
import ApplyThis from "~/components/lesson/ApplyThis.astro";
import PracticeSection from "~/components/pedagogy/PracticeSection.tsx";
import LessonSupport from "~/components/lesson/LessonSupport.tsx";
import MasteryLoop from "~/components/lesson/MasteryLoop.astro";
import ConceptMastery from "~/components/lesson/ConceptMastery.astro";
import ReturningLearner from "~/components/lesson/ReturningLearner.astro";
import PrereqLinks, { type PrereqLink } from "~/components/lesson/PrereqLinks.astro";
import type { PracticeTaskData } from "~/content.config";

type Level = "zero" | "junior" | "middle" | "senior";
type RuntimeLessonMeta = {
  title: string;
  level?: string;
  track: string;
  unit: string;
  slug: string;
};
type RuntimeLessonContext = {
  track?: { title?: Partial<Record<Locale, string>>; color?: string };
  unit?: { title?: Partial<Record<Locale, string>>; order?: number };
  graph?: {
    prereqLessons?: string[];
    buildsOn?: string[];
    unlocks?: string[];
    deepensInto?: string[];
    appearsAgainIn?: string[];
    navPrev?: string | null;
    navNext?: string | null;
  };
  lessonMeta?: Record<string, RuntimeLessonMeta>;
  projects?: Array<{ slug: string; title: string; pitch: string }>;
};
type Props = {
  title: string;
  lang: Locale;
  trackSlug: string;
  unitSlug: string;
  summary: string;
  estMin: number;
  order: number;
  sources: string[];
  lessonType?: "concept" | "coding" | "topic";
  level?: Level;
  /** Required for topic lessons: "<track>/<unit>/<slug>" */
  lessonKey?: string;
  /** Lesson slug — used for the last-visited write */
  slug: string;
  /** Prerequisite lesson refs (bare slug or "<track>/<unit>/<slug>") */
  prereqs?: string[];
  /** Cross-track math prerequisite refs (always "math/<unit>/<slug>") */
  mathPrereqs?: string[];
  /** Practice tasks for this lesson, or null when none authored */
  practice?: PracticeTaskData[] | null;
  /** Concept ids covered by this lesson */
  concepts?: string[];
  /** Prepared backend read-model. */
  runtime: RuntimeLessonContext;
  interactiveAllowed?: boolean;
};

const {
  title, lang, trackSlug, unitSlug, summary, estMin, order, sources,
  lessonType, level, lessonKey, slug, prereqs, mathPrereqs, practice, concepts, runtime,
  interactiveAllowed = true,
} = Astro.props;

// Resolve track title for the breadcrumb
const trackTitle = runtime.track?.title?.[lang] ?? trackSlug;
const trackColor = (runtime.track?.color ?? "sky") as TrackColor;
const unitOrder = runtime.unit?.order;
// Breadcrumb middle segment: "Unit N · <unit title>" (falls back to the slug).
const unitTitle = runtime.unit?.title?.[lang] ?? unitSlug;

// Resolve connections graph (existing behaviour)
let connections: {
  buildsOn: string[]; unlocks: string[];
  deepensInto: string[]; appearsAgainIn: string[];
} | null = null;
let metaLookup: Record<string, ConnectionMeta> = {};

if (lessonType === "topic" && lessonKey) {
  const graph = runtime.graph ?? {};
  connections = {
    buildsOn: graph.buildsOn ?? [],
    unlocks: graph.unlocks ?? [],
    deepensInto: graph.deepensInto ?? [],
    appearsAgainIn: graph.appearsAgainIn ?? [],
  };

  if (connections) {
    const allIds = [
      ...connections.buildsOn,
      ...connections.unlocks,
      ...connections.deepensInto,
      ...connections.appearsAgainIn,
    ];
    for (const id of allIds) {
      const prepared = runtime.lessonMeta?.[id];
      if (!prepared) continue;
      metaLookup[id] = {
        title: prepared.title,
        level: prepared.level,
        track: prepared.track,
        unit: prepared.unit,
        href: `/${lang}/learn/${prepared.track}/${prepared.unit}/${prepared.slug}`,
      };
    }
  }
}

const nextPreparedId = runtime.graph?.navNext ?? null;
const nextPrepared = nextPreparedId ? runtime.lessonMeta?.[nextPreparedId] : null;
const nextHref = nextPrepared
  ? `/${lang}/learn/${nextPrepared.track}/${nextPrepared.unit}/${nextPrepared.slug}/`
  : null;
const nextTitle = nextPrepared?.title ?? null;

// Prior lesson — symmetric "← Previous" affordance. Null at the start of the track.
const priorPreparedId = runtime.graph?.navPrev ?? null;
const priorPrepared = priorPreparedId ? runtime.lessonMeta?.[priorPreparedId] : null;
const prevHref = priorPrepared
  ? `/${lang}/learn/${priorPrepared.track}/${priorPrepared.unit}/${priorPrepared.slug}/`
  : null;
const prevTitle = priorPrepared?.title ?? null;

// W2.6 — post-lesson cycle close. Plan link + unit-complete signal.
const planHref = `/${lang}/roadmap/`;
// This is the last lesson of its unit when the next lesson crosses into a new unit.
const unitComplete = nextPrepared
  ? nextPrepared.unit !== unitSlug
  : false;
const nextUnitHref = unitComplete ? nextHref : null;

// W2.4a — "Apply this": projects whose feedsFrom covers this lesson key. Build the
// reverse index once over all projects, look up this lesson, cap at 2, localise.
const lessonKeyForProjects = `${trackSlug}/${unitSlug}/${slug}`;
const applyProjects = runtime.projects ?? [];

// For the last-visited write
const lessonHref = `/${lang}/learn/${trackSlug}/${unitSlug}/${slug}/`;
// Canonical lesson id for metrics + reader questions
const metricsKey = `${trackSlug}/${unitSlug}/${slug}`;
// Every lesson page is editorial: article-first shell, LMS chrome moved to the
// end-of-lesson "Lesson context" disclosure. The flag stays as a hook for
// components that want to style differently (Topbar, RightRail).
const isEditorialLesson = true;
const editorialTrackLabel = trackTitle.toUpperCase();

// Resolve the visible "Before this lesson" links from prereqs + mathPrereqs.
// Ref forms: bare slug → same track+unit; "<track>/<unit>/<slug>" → as-is.
// Dangling refs (no matching lesson in this locale) are dropped silently.
const prereqRefs = runtime.graph?.prereqLessons ?? [...(prereqs ?? []), ...(mathPrereqs ?? [])];
const seenPrereq = new Set<string>();
const prereqLinks: PrereqLink[] = [];
for (const ref of prereqRefs) {
  const id = ref;
  if (seenPrereq.has(id)) continue;
  seenPrereq.add(id);
  const prepared = runtime.lessonMeta?.[id];
  const prereqTitle = prepared?.title;
  if (!prereqTitle) continue;
  prereqLinks.push({
    title: prereqTitle,
    href: `/${lang}/learn/${prepared.track}/${prepared.unit}/${prepared.slug}/`,
  });
}

import diagnosticsIndex from "~/content/path/diagnostics-index.json";
import unitConcepts from "~/content/path/unit-concepts.json";
// Structured data: the site had none, so search engines had to infer that these
// pages are course material. A LearningResource plus the reader's actual
// breadcrumb trail states it outright. Absolute URLs — crawlers require them.
const SITE_ORIGIN = "https://fallowlone.com";
const abs = (path: string) => new URL(path, SITE_ORIGIN).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: title,
    description: summary,
    inLanguage: lang,
    url: abs(`/${lang}/learn/${trackSlug}/${unitSlug}/${slug}/`),
    learningResourceType: lessonType === "coding" ? "exercise" : "lesson",
    educationalLevel: level ?? "intermediate",
    timeRequired: `PT${estMin}M`,
    isPartOf: { "@type": "Course", name: trackTitle, url: abs(`/${lang}/learn/${trackSlug}/`) },
    ...(sources.length ? { citation: sources } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t("nav.atlas.atlas", lang), item: abs(`/${lang}/`) },
      { "@type": "ListItem", position: 2, name: trackTitle, item: abs(`/${lang}/learn/${trackSlug}/`) },
      { "@type": "ListItem", position: 3, name: title },
    ],
  },
];

const _diagSet = new Set(diagnosticsIndex as string[]);
const _unitTeaches = ((unitConcepts as Record<string, { teaches: string[] }>)[`${trackSlug}/${unitSlug}`]?.teaches) ?? [];
const showPreUnitCheck = order === 1 && _unitTeaches.some((c) => _diagSet.has(c));
const calibrateHref = `/${lang}/calibrate?unit=${trackSlug}/${unitSlug}`;
const canonicalLessonKey = lessonKey ?? `${trackSlug}/${unitSlug}/${slug}`;
---

<Topic title={title} lang={lang} description={summary} sources={sources} cspExtra="wasm" jsonLd={jsonLd}>
  <Topbar
    lang={lang}
    trackSlug={trackSlug}
    trackTitle={trackTitle}
    unitOrder={unitOrder}
    unitTitle={unitTitle}
    lessonTitle={title}
    lessonOrder={order}
    editorial={isEditorialLesson}
  />

  <div class:list={["lesson-shell", { "lesson-shell--editorial": isEditorialLesson }]}>
    <article class:list={["lesson-body", { "is-editorial": isEditorialLesson }]} data-lesson-type={lessonType}
      data-metrics-lesson={metricsKey} data-metrics-track={trackSlug} data-metrics-lang={lang}>
      {isEditorialLesson ? (
        <header class="editorial-header">
          <p class="editorial-kicker">
            <span>{editorialTrackLabel}</span>
            {unitOrder && <><span aria-hidden="true">·</span><span>{lang === "ru" ? "ЮНИТ" : "UNIT"} {String(unitOrder).padStart(2, "0")}</span></>}
            <span aria-hidden="true">·</span><span>{lang === "ru" ? "УРОК" : "LESSON"} {String(order).padStart(2, "0")}</span>
            <span aria-hidden="true">·</span><span>{estMin} {lang === "ru" ? "МИН" : "MIN"}</span>
          </p>
          <h1 class="editorial-title">{title}</h1>
          <p class="editorial-deck">{summary}</p>
          <div class="editorial-meta" aria-label={lang === "ru" ? "Метаданные урока" : "Lesson metadata"}>
            <span>Skein Curriculum</span>
            {level && <><span aria-hidden="true">·</span><span>{t(`lesson.altitude.${level}`, lang)}</span></>}
            <span aria-hidden="true">·</span><span>{estMin} {lang === "ru" ? "мин чтения" : "min read"}</span>
            {prereqLinks[0] && (
              <><span aria-hidden="true">·</span><a href={prereqLinks[0].href}>{lang === "ru" ? "Пререквизит" : "Prerequisite"} ✓ {prereqLinks[0].title}</a></>
            )}
          </div>
        </header>
      ) : (
        <>
          <LessonPlate
            title={title}
            summary={summary}
            trackTitle={trackTitle}
            abbr={TRACK_ABBR[trackSlug as Track]}
            hue={DOMAIN_HUE[trackColor]}
            unitOrder={unitOrder}
            order={order}
            level={level}
            estMin={estMin}
            lang={lang}
          />
          <AltitudeGauge lang={lang} level={level} />
        </>
      )}

      <div class="lesson-content">
        <slot />

        {(concepts?.length || prereqLinks.length || level) && (
          <details class="lesson-context">
            <summary>
              <span class="lk-label">{t("lesson.context.heading", lang)}</span>
              <span aria-hidden="true" class="lesson-context-chev">▸</span>
            </summary>
            <div class="lesson-context-body">
              {prereqLinks.length > 0 && <PrereqLinks lang={lang} links={prereqLinks} />}
              {concepts?.length ? <ConceptMastery lang={lang} ids={concepts} /> : null}
              <MasteryLoop lang={lang} />
              <ReturningLearner lang={lang} lessonKey={canonicalLessonKey} />
              {showPreUnitCheck && (
                <a href={calibrateHref} class="pre-unit-check">
                  {lang === "en" ? "Already know this unit? Take a 1-minute quick check →" : "Уже знаешь этот юнит? Пройди быструю проверку за минуту →"}
                </a>
              )}
            </div>
          </details>
        )}
      </div>

      {interactiveAllowed && (
        <div class="lesson-after-content">
          {practice && practice.length > 0 && lessonKey && (
            <PracticeSection client:visible lang={lang} lessonKey={lessonKey} tasks={practice} />
          )}
          <LessonSupport client:visible lang={lang} lessonKey={canonicalLessonKey} concepts={concepts ?? []} />
        </div>
      )}

      {lessonType === "topic" && connections && (
        <ConnectedLessons
          lang={lang}
          buildsOn={connections.buildsOn}
          unlocks={connections.unlocks}
          deepensInto={connections.deepensInto}
          appearsAgainIn={connections.appearsAgainIn}
          meta={metaLookup}
        />
      )}

      <ApplyThis lang={lang} projects={applyProjects} />

      <NextLessonCard
        lang={lang}
        prevHref={prevHref}
        prevTitle={prevTitle}
        nextHref={nextHref}
        nextTitle={nextTitle}
        planHref={planHref}
        unitComplete={unitComplete}
        nextUnitHref={nextUnitHref}
      />
    </article>

    <RightRail lang={lang} editorial={isEditorialLesson} />
  </div>
</Topic>

<script>
  import { initLessonMetrics } from "~/scripts/metrics";
  const el = document.querySelector<HTMLElement>("[data-metrics-lesson]");
  if (el?.dataset.metricsLesson) {
    initLessonMetrics(el.dataset.metricsLesson, el.dataset.metricsTrack ?? "", el.dataset.metricsLang ?? "");
  }

  // PacketDot animation boots here, not in PacketDot.astro: the dots render
  // inside inline <svg>, where an emitted <script> becomes an SVGScriptElement
  // and a module script never executes. gsap loads only when a dot is present.
  const bootPackets = () => {
    const dots = document.querySelectorAll<SVGCircleElement>("[data-packet]");
    if (dots.length === 0) return;
    Promise.all([import("~/scripts/gsap-setup"), import("gsap")]).then(([{ setupGsap }, { gsap }]) => {
      if (!setupGsap()) return;
      dots.forEach((dot) => {
        const path = dot.ownerSVGElement?.querySelector<SVGPathElement>("[data-path]");
        if (!path || !path.getAttribute("d")) return;
        const duration = Number(dot.dataset.duration ?? "1800") / 1000;
        const delay = Number(dot.dataset.delay ?? "0") / 1000;
        gsap.set(dot, { opacity: 1 });
        gsap.to(dot, {
          duration,
          ease: "none",
          repeat: -1,
          repeatDelay: 0.4,
          delay,
          motionPath: { path, align: path, alignOrigin: [0.5, 0.5], autoRotate: false },
        });
      });
    });
  };
  if (document.readyState === "complete") bootPackets();
  else window.addEventListener("load", bootPackets, { once: true });
</script>

<script is:inline define:vars={{ lang, trackSlug, slug, title, lessonHref }}>
  try {
    localStorage.setItem(
      "atlas.last." + lang + "." + trackSlug,
      JSON.stringify({ slug, title, href: lessonHref, at: Date.now() })
    );
  } catch (_) { /* private browsing, storage full, etc. — non-fatal */ }
</script>

<style>
  .lesson-shell {
    max-width: 1080px; margin: 0 auto; padding: 0 32px;
    display: grid; grid-template-columns: minmax(0, 1fr) 232px; gap: 56px;
    align-items: start;
  }
  .lesson-body { padding: 40px 0 64px; min-width: 0; max-width: 680px; }
  .lesson-kicker {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--muted); margin: 0 0 14px;
  }
  .lesson-title {
    font-family: var(--font-display); font-size: clamp(34px, 5vw, 46px);
    font-weight: 520; line-height: 1.08; letter-spacing: -0.02em; margin: 0;
  }
  .lesson-crux {
    margin: 22px 0 0; padding: 16px 0 16px 20px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display); font-size: 19px; line-height: 1.55;
    font-weight: 400; color: var(--ink-2);
  }
  .crux-tag {
    display: block; font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
    margin-bottom: 7px;
  }
  .hdr-meta {
    display: flex; flex-wrap: wrap; gap: 18px; margin-top: 22px;
    padding-top: 18px; border-top: 0.5px solid var(--hairline);
  }
  .hm {
    font-family: var(--font-mono); font-size: 11px; color: var(--muted);
    letter-spacing: 0.03em;
  }

  /* Pre-unit quick-check nudge. Token-driven, so it follows the active theme —
     the previous tailwind literals (bg-emerald-50) stayed light in dark mode. */
  .pre-unit-check {
    display: block;
    margin-bottom: 16px;
    padding: 9px 16px;
    border: 0.5px solid color-mix(in srgb, var(--ok) 45%, transparent);
    border-left: 2px solid var(--ok);
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--ok) 10%, var(--card));
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: none;
    transition: background var(--dur-1) var(--ease);
  }
  .pre-unit-check:hover { background: color-mix(in srgb, var(--ok) 18%, var(--card)); }

  /* ── editorial prose, scoped to MDX content body ── */
  .lesson-content { margin-top: 30px; }
  .lesson-content :global(h2) {
    font-family: var(--font-display); font-size: 25px; font-weight: 520;
    letter-spacing: -0.01em; margin: 38px 0 14px;
  }
  .lesson-content :global(h3) {
    font-family: var(--font-display); font-size: 19px; font-weight: 560;
    margin: 28px 0 10px;
  }
  .lesson-content :global(p) {
    font-size: 16.5px; line-height: 1.72; color: var(--ink-2); margin: 0 0 16px;
  }
  .lesson-content :global(code) {
    font-family: var(--font-mono); font-size: 0.85em;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    border: 0.5px solid var(--hairline);
    padding: 1px 5px; border-radius: var(--r-sm);
  }
  .lesson-content :global(pre:not(.astro-code)) {
    background: var(--code-bg, var(--card)); border: 0.5px solid var(--hairline-2);
    border-radius: var(--r-md); padding: 14px 16px; overflow-x: auto;
    font-size: 13px; line-height: 1.65;
  }
  .lesson-content :global(pre code) {
    background: transparent; padding: 0; border-radius: 0; border: 0;
  }
  .lesson-content :global(ul),
  .lesson-content :global(ol) {
    font-size: 16.5px; line-height: 1.72; color: var(--ink-2);
    margin: 0 0 16px; padding-left: 24px;
  }
  .lesson-content :global(li) { margin-bottom: 6px; }
  .lesson-content :global(blockquote) {
    border-left: 2px solid var(--hairline-strong); padding-left: 16px;
    color: var(--muted); font-style: italic; margin: 16px 0;
  }
  .lesson-content :global(figure) { margin: 24px 0; }
  .lesson-content :global(figcaption) {
    font-family: var(--font-mono); font-size: 11px; color: var(--muted);
    margin-top: 9px; letter-spacing: 0.02em;
  }

  /* Editorial reader: validated by the TCP pilot, now used by js-engine. */
  .lesson-shell--editorial {
    max-width: 1400px;
    padding-inline: 32px;
    grid-template-columns: minmax(0, 1140px) 160px;
    gap: 36px;
    justify-content: center;
  }
  .lesson-body.is-editorial {
    width: 100%;
    max-width: 1140px;
    padding: 28px 0 76px;
  }
  .editorial-header {
    width: 100%;
    max-width: 720px;
    margin: 0 0 34px;
  }
  .editorial-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin: 0 0 18px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .editorial-kicker > span[aria-hidden="true"] { color: var(--faint); }
  .editorial-title {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(42px, 5.2vw, 64px);
    font-weight: 470;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--ink);
    text-wrap: balance;
  }
  .editorial-deck {
    max-width: 660px;
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 380;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }
  .editorial-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    align-items: center;
    margin-top: 22px;
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--muted);
  }
  .editorial-meta > span[aria-hidden="true"] { color: var(--faint); }
  .editorial-meta a {
    color: var(--muted);
    text-decoration: none;
    text-underline-offset: 3px;
  }
  .editorial-meta a:hover,
  .editorial-meta a:focus-visible { color: var(--ink); text-decoration: underline; }
  .lesson-context {
    margin-top: 48px;
    border-top: 0.5px solid var(--hairline-2);
    padding-top: 16px;
  }
  .lesson-context summary {
    cursor: pointer; list-style: none;
    display: flex; align-items: center; gap: var(--s-2);
    font-family: var(--font-mono); font-size: var(--fs-mono-label);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
  }
  .lesson-context summary::-webkit-details-marker { display: none; }
  .lesson-context-chev { transition: transform var(--dur-1) var(--ease); }
  .lesson-context[open] .lesson-context-chev { transform: rotate(90deg); }
  .lesson-context-body {
    margin-top: var(--s-4); display: grid; gap: var(--s-4);
    font-size: var(--fs-small); color: var(--ink-2);
  }

  .lesson-body.is-editorial .lesson-content {
    margin-top: 0;
  }
  .lesson-body.is-editorial .lesson-content :global([data-lesson-section="hook"]),
  .lesson-body.is-editorial .lesson-content :global([data-lesson-section="crux"]),
  .lesson-body.is-editorial .lesson-content :global([data-lesson-section="key-takeaway"]),
  .lesson-body.is-editorial .lesson-content :global([data-retrieval]),
  .lesson-body.is-editorial .lesson-content :global(.lk-recap),
  .lesson-body.is-editorial .lesson-content :global([data-quiz]),
  .lesson-body.is-editorial .lesson-content :global([data-drag-order]),
  .lesson-body.is-editorial .lesson-content :global([data-metaphor-complete]),
  .lesson-body.is-editorial .lesson-content :global(.lk-inset) {
    width: 100%;
    max-width: 700px;
  }
  .lesson-body.is-editorial .lesson-content :global([data-lesson-section="explanation"] > p),
  .lesson-body.is-editorial .lesson-content :global([data-lesson-section="explanation"] > h2),
  .lesson-body.is-editorial .lesson-content :global([data-lesson-section="explanation"] > h3),
