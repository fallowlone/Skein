---
import "../styles/global.css";
import TitleBar from "../components/brand/TitleBar.astro";
import SourcesFooter from "../components/brand/SourcesFooter.astro";

type Depth = { mechanism: string; tradeoff: string; failure_mode: string; numbers: string };
type Heading = { depth: number; slug: string; text: string };
type NavItem = { title: string; slug: string } | null;

type Props = {
  title: string;
  pillar: string;
  depth: Depth;
  sources: string[];
  summary: string;
  headings: Heading[];
  prev?: NavItem;
  next?: NavItem;
};
const { title, pillar, depth, sources, summary, headings, prev = null, next = null } = Astro.props;
---
<html lang="en" data-depth={JSON.stringify(depth)} data-pillar={pillar}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-bbg-ink">
    <div class="fixed top-0 left-0 right-0 h-1 z-50 bg-transparent pointer-events-none">
      <div data-progress-bar class="h-full bg-bbg-teal" style="width: 0%"></div>
    </div>
    <TitleBar headline={title} />

    <div class="max-w-[1400px] mx-auto px-4 md:px-12 pt-8 pb-24 grid grid-cols-1 lg:grid-cols-[260px_minmax(0,1fr)] gap-12 overflow-x-clip">
      <aside class="hidden lg:block sticky top-[112px] self-start max-h-[calc(100vh-128px)] overflow-y-auto pr-2 text-sm">
        <p class="uppercase tracking-wider text-xs text-bbg-muted font-bold mb-3">{pillar}</p>
        <p class="font-bold text-bbg-ink mb-4 text-base leading-snug">{title}</p>
        <nav class="border-l border-gray-200 pl-3 space-y-1.5">
          {headings.map((h) => (
            <a
              data-toc-link
              href={`#${h.slug}`}
              class={`block leading-snug text-bbg-muted hover:text-bbg-ink transition ${h.depth >= 3 ? "pl-3 text-xs" : "text-sm"}`}
            >
              {h.text}
            </a>
          ))}
        </nav>
      </aside>

      <article class="max-w-[820px]">
        <p class="uppercase tracking-wider text-xs text-bbg-muted font-bold mb-3">{pillar}</p>
        <p class="text-lg text-bbg-muted leading-relaxed mb-12">{summary}</p>
        <div class="prose-body">
          <slot />
        </div>

        <nav class="mt-24 pt-8 border-t border-gray-200 flex items-center justify-between gap-4 text-sm">
          <div>
            {prev && (
              <a href={`/book/${prev.slug}/`} class="block group">
                <span class="block text-xs text-bbg-muted uppercase tracking-wider">Previous</span>
                <span class="block font-bold text-bbg-ink group-hover:text-bbg-purple transition">← {prev.title}</span>
              </a>
            )}
          </div>
          <div class="text-right">
            {next && (
              <a href={`/book/${next.slug}/`} class="block group">
                <span class="block text-xs text-bbg-muted uppercase tracking-wider">Next</span>
                <span class="block font-bold text-bbg-ink group-hover:text-bbg-purple transition">{next.title} →</span>
              </a>
            )}
          </div>
        </nav>
      </article>
    </div>

    <SourcesFooter sources={sources} />

    <script>
      import { initProgressBar, activateTocOnScroll } from "../scripts/book-progress";
      initProgressBar();
      activateTocOnScroll();
    </script>

    <style is:global>
      .toc-active { color: theme(colors.bbg.purple); font-weight: 600; }
      .prose-body h2 { font-size: 1.875rem; font-weight: 800; margin: 3rem 0 1rem; color: theme(colors.bbg.ink); scroll-margin-top: 120px; }
      .prose-body h3 { font-size: 1.375rem; font-weight: 700; margin: 2rem 0 0.75rem; color: theme(colors.bbg.ink); scroll-margin-top: 120px; }
      .prose-body p { font-size: 1.0625rem; line-height: 1.75; color: theme(colors.bbg.ink); margin: 1rem 0; }
      .prose-body p code, .prose-body li code { font-family: theme(fontFamily.mono); font-size: 0.95em; background: #F3F4F6; padding: 0.1em 0.35em; border-radius: 4px; color: theme(colors.bbg.annot); }
      .prose-body ul { list-style: disc; padding-left: 1.5rem; margin: 1rem 0; }
      .prose-body ol { list-style: decimal; padding-left: 1.5rem; margin: 1rem 0; }
      .prose-body li { margin: 0.25rem 0; line-height: 1.75; }
      .prose-body pre { margin: 1.25rem 0; padding: 1rem 1.25rem; border-radius: 0.75rem; background: #F9FAFB; border: 1px solid #E5E7EB; overflow-x: auto; font-size: 0.875rem; }
      .prose-body pre code { font-family: theme(fontFamily.mono); }
      .prose-body blockquote { border-left: 3px solid theme(colors.bbg.teal); padding: 0.25rem 1rem; margin: 1rem 0; color: theme(colors.bbg.muted); font-style: italic; }
      .prose-body strong { color: theme(colors.bbg.ink); font-weight: 700; }
      .prose-body a { color: theme(colors.bbg.purple); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 2px; }
    </style>
  </body>
</html>
