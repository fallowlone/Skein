---
// Critical CSS is inlined (design tokens + chrome) so the first paint needs no
// stylesheet round-trip; the full sheet then loads async (print-swap, below).
// This removes the render-blocking CSS request PageSpeed flagged on the home
// page. tokens.css + atlas-kit.css are also @imported by global.css, so the
// async sheet stays self-sufficient — the inline copy is just an early subset.
import tokensCss from "~/styles/tokens.css?inline";
import atlasKitCss from "~/styles/atlas-kit.css?inline";
import globalCssHref from "~/styles/global.css?url";
import TopNav from "~/components/atlas/TopNav.astro";
import ThemeBoot from "~/components/brand/ThemeBoot.astro";
import { t, type Locale } from "~/i18n";
import { buildCsp } from "~/lib/csp";
import SeoHead from "~/components/brand/SeoHead.astro";

type Props = {
  title: string;
  lang: Locale;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};
const { title, lang, description, jsonLd } = Astro.props;

// Minimal preflight subset — mirrors global.css @layer base + Tailwind reset for
// the above-the-fold elements, so nothing flashes unstyled before the async
// sheet arrives. Followed by the full token set and chrome kit.
const criticalReset = `
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;line-height:1.5;font-family:var(--font-body);color:var(--ink);overflow-x:clip;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;font-feature-settings:'ss01','cv11','tnum'}
body{margin:0;background:var(--paper);overflow-x:clip}
h1,h2,h3,h4{margin:0;font-family:var(--font-display);font-weight:700;color:var(--ink);letter-spacing:-0.018em;font-feature-settings:'ss01'}
p{margin:0}
a{color:inherit;text-decoration:none}
button{font-family:inherit;font-size:100%;margin:0}
img,svg{display:block;vertical-align:middle}
`;
const criticalCss = criticalReset + tokensCss + atlasKitCss;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Same page CSP as Topic.astro — Atlas-layout pages (home, pillar grid)
        previously shipped no CSP at all. script-src keeps 'unsafe-inline' for
        Astro island + ThemeBoot bootstrap (hashes change every build). */}
    <meta http-equiv="Content-Security-Policy" content={buildCsp()} />
    {/* Critical CSS inline → first paint needs no stylesheet round-trip. */}
    <style is:inline set:html={criticalCss}></style>
    {/* Full sheet loads off the critical path (print-swap), like the fonts.
        `rel` must be stylesheet, not preload: a preload whose `media` does not match
        is skipped, so onload never fired and the sheet — which carries @tailwind
        utilities — never applied on any Atlas page. A non-matching media on a real
        stylesheet still fetches, just without blocking render, then onload adopts it. */}
    <link rel="stylesheet" href={globalCssHref} onload="this.media='all'" media="print" />
    <noscript><link rel="stylesheet" href={globalCssHref} /></noscript>
    <SeoHead title={title} lang={lang} description={description} jsonLd={jsonLd} />
    <ThemeBoot />
  </head>
  <body class="atlas-body oa-shell">
    <a href="#main" class="oa-skip">{t("a11y.skipToContent", lang)}</a>
    <TopNav lang={lang} />
    <div class="oa-main">
    <main id="main">
      <slot />
    </main>
    <footer class="atlas-foot">
      <p class="foot-logo">open atlas <em>· {t("home.tagline", lang)}</em></p>
      <p class="foot-links">
        <a href={`/${lang}/terms`}>{t("terms.footer", lang)}</a>
        <a href={`/${lang}/glossary/`}>{t("nav.glossary", lang)}</a>
      </p>
      <p class="foot-fine">© 2026 open atlas · CC BY-SA 4.0 · MMXXVI</p>
    </footer>
    </div>

    <style is:global>
      /* Atlas shell — unified paper/ink (cosmic palette removed, redesign 1b) */
      .atlas-body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        /* `clip` not `hidden`: hidden promotes overflow-y to auto and breaks
           position:sticky for descendants (see global.css). */
        overflow-x: clip;
        min-height: 100vh;
        transition: background var(--dur-2) var(--ease), color var(--dur-2) var(--ease);
      }
      .atlas-body a { color: inherit; text-decoration: none; }
      .atlas-body h1,
      .atlas-body h2,
      .atlas-body h3 {
        font-family: var(--font-display); margin: 0;
      }
      .atlas-foot {
        position: relative; z-index: 2;
        margin-top: 10px; padding: 30px 0 60px;
        border-top: 0.5px solid var(--hairline); text-align: center;
      }
      .atlas-foot .foot-logo { font-family: var(--font-display); font-size: 15px; margin: 0; color: var(--ink); }
      .atlas-foot .foot-logo em { color: var(--faint); font-size: 12px; }
      .atlas-foot .foot-links {
        display: flex; gap: 20px; justify-content: center;
        font-family: var(--font-mono); font-size: 10px;
        letter-spacing: 0.12em; text-transform: uppercase;
        margin: 14px 0 0;
      }
      .atlas-foot .foot-links a { color: var(--muted); transition: color .15s; }
      .atlas-foot .foot-links a:hover { color: var(--ink); }
      .atlas-foot .foot-fine {
        font-family: var(--font-mono); font-size: 10px;
        letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--faint); margin: 12px 0 0;
      }
    </style>
  </body>
</html>
