---
import "~/styles/global.css";
import TopNav from "~/components/atlas/TopNav.astro";
import ThemeBoot from "~/components/brand/ThemeBoot.astro";
import { t, type Locale } from "~/i18n";
import SeoHead from "~/components/brand/SeoHead.astro";

type Props = { title: string; lang: Locale; description?: string };
const { title, lang, description } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <SeoHead title={title} lang={lang} description={description} />
    <ThemeBoot />
  </head>
  <body class="atlas-body">
    <TopNav lang={lang} />
    <slot />
    <footer class="atlas-foot">
      <p class="foot-logo">open atlas <em>· {t("home.tagline", lang)}</em></p>
      <p class="foot-links">
        <a href={`/${lang}/terms`}>{t("terms.footer", lang)}</a>
        <a href={`/${lang}/glossary/`}>{t("nav.glossary", lang)}</a>
      </p>
      <p class="foot-fine">© 2026 open atlas · CC BY-SA 4.0 · MMXXVI</p>
    </footer>

    <style is:global>
      /* Atlas shell — unified paper/ink (cosmic palette removed, redesign 1b) */
      .atlas-body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        min-height: 100vh;
        transition: background var(--dur-2) var(--ease), color var(--dur-2) var(--ease);
      }
      .atlas-body a { color: inherit; text-decoration: none; }
      .atlas-body h1,
      .atlas-body h2,
      .atlas-body h3 {
        font-family: var(--font-display); margin: 0;
      }
      .atlas-foot {
        position: relative; z-index: 2;
        margin-top: 10px; padding: 30px 0 60px;
        border-top: 0.5px solid var(--hairline); text-align: center;
      }
      .atlas-foot .foot-logo { font-family: var(--font-display); font-size: 15px; margin: 0; color: var(--ink); }
      .atlas-foot .foot-logo em { color: var(--faint); font-size: 12px; }
      .atlas-foot .foot-links {
        display: flex; gap: 20px; justify-content: center;
        font-family: var(--font-mono); font-size: 10px;
        letter-spacing: 0.12em; text-transform: uppercase;
        margin: 14px 0 0;
      }
      .atlas-foot .foot-links a { color: var(--muted); transition: color .15s; }
      .atlas-foot .foot-links a:hover { color: var(--ink); }
      .atlas-foot .foot-fine {
        font-family: var(--font-mono); font-size: 10px;
        letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--faint); margin: 12px 0 0;
      }
    </style>
  </body>
</html>
