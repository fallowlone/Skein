---
import "../styles/global.css";
import TopNav from "../components/atlas/TopNav.astro";
import SourcesFooter from "../components/brand/SourcesFooter.astro";
import ThemeBoot from "../components/brand/ThemeBoot.astro";
import Toast from "../components/brand/Toast.astro";
import KeyboardShortcuts from "../components/nav/KeyboardShortcuts.astro";
import SpacedRevisitBanner from "../components/pedagogy/SpacedRevisitBanner.tsx";
import SiteFooter from "~/components/brand/SiteFooter.astro";
import { t, type Locale } from "../i18n";
import { buildCsp, type CspExtra } from "~/lib/csp";
import SeoHead from "~/components/brand/SeoHead.astro";

type Depth = { mechanism: string; tradeoff: string; failure_mode: string; numbers: string };
type Props = {
  title: string;
  lang: Locale;
  description?: string;
  pillars?: string[];
  sources?: string[];
  depth?: Depth;
  cspExtra?: CspExtra;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};
const { title, lang, description, sources = [], depth, cspExtra, noindex, jsonLd } = Astro.props;
const depthAttr = depth ? JSON.stringify(depth) : undefined;
---
<html lang={lang} data-depth={depthAttr}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Content-Security-Policy. The BYOK-relevant control is `connect-src`: a
      decrypted Anthropic key can only ever be sent to 'self' or api.anthropic.com,
      so even an injected script cannot exfiltrate it to a third-party origin
      (img-src + form-action close the other common channels). `script-src` keeps
      'unsafe-inline' because Astro inlines island-hydration bootstrap scripts (and
      ThemeBoot) inline; hashing them is infeasible since the hashes change every
      build. Tightening script-src is tracked as a follow-up (Astro experimental CSP).
    */}
    <meta
      http-equiv="Content-Security-Policy"
      content={buildCsp(cspExtra)}
    />
    <ThemeBoot />
    <SeoHead title={title} lang={lang} description={description} noindex={noindex} jsonLd={jsonLd} />
  </head>
  <body class="oa-shell min-h-screen bg-paper text-ink">
    <a href="#main" class="oa-skip">{t("a11y.skipToContent", lang)}</a>
    <TopNav lang={lang} />
    <div class="oa-main">
    <SpacedRevisitBanner client:idle lang={lang} />
    <main id="main" class="max-w-[1600px] mx-auto px-6 md:px-12 pt-8 pb-24">
      <slot />
    </main>
    <KeyboardShortcuts lang={lang} />
    <SourcesFooter sources={sources} lang={lang} />
    <Toast />

    <div
      id="glossary-tooltip"
      role="tooltip"
      class="fixed z-50 pointer-events-none bg-card border border-rule-strong rounded-[2px] px-3 py-2 max-w-[280px] text-[12.5px] leading-snug text-ink shadow-soft"
      style="opacity: 0; transform: translateY(4px); transition: opacity .14s, transform .14s;"
      hidden
    ></div>

    <script>
      function initGlossary() {
        const tip = document.getElementById("glossary-tooltip");
        if (!tip) return;
        // Terms carry the definition in data-definition and point at a hidden
        // sibling via aria-describedby (see prose/Term.astro) — this tooltip is
        // the visual layer only, and must not remove either of them.
        const terms = Array.from(
          document.querySelectorAll<HTMLElement>(".gloss[data-definition]")
        );
        if (terms.length === 0) return;

        function place(target: HTMLElement) {
          const r = target.getBoundingClientRect();
          const tw = tip!.offsetWidth || 200;
          const th = tip!.offsetHeight || 40;
          let x = r.left + r.width / 2 - tw / 2;
          let y = r.bottom + 8;
          if (x < 8) x = 8;
          if (x + tw > window.innerWidth - 8) x = window.innerWidth - tw - 8;
          if (y + th > window.innerHeight - 8) y = r.top - th - 8;
          tip!.style.left = `${Math.round(x)}px`;
          tip!.style.top = `${Math.round(y)}px`;
        }

        function show(el: HTMLElement) {
          const text = el.dataset.definition || "";
          if (!text) return;
          tip!.textContent = text;
          tip!.hidden = false;
          requestAnimationFrame(() => {
            place(el);
            tip!.style.opacity = "1";
            tip!.style.transform = "translateY(0)";
          });
        }

        function hide() {
          tip!.style.opacity = "0";
          tip!.style.transform = "translateY(4px)";
          setTimeout(() => { tip!.hidden = true; }, 160);
        }

        for (const el of terms) {
          el.addEventListener("mouseenter", () => show(el));
          el.addEventListener("focus", () => show(el));
          el.addEventListener("mouseleave", hide);
          el.addEventListener("blur", hide);
        }
      }

      if (document.readyState !== "loading") initGlossary();
      else document.addEventListener("DOMContentLoaded", initGlossary);
    </script>
    <SiteFooter lang={lang} />
    </div>
  </body>
</html>
