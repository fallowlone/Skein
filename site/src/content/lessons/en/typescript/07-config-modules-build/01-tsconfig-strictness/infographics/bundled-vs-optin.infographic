data
  title tsconfig strictness flags
  compares
    - label Inside strict: true (8 flags)
      children
        - label strictNullChecks — load-bearing
        - label noImplicitAny
        - label strictFunctionTypes
        - label strictBindCallApply
        - label strictPropertyInitialization
        - label useUnknownInCatchVariables
        - label noImplicitThis
        - label alwaysStrict (emit only)
    - label Opt in — NOT in strict (highest value)
      children
        - label noUncheckedIndexedAccess → T | undefined
        - label exactOptionalPropertyTypes → a? = absent
