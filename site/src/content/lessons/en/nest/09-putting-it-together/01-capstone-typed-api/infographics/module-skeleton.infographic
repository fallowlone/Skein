data
  title One service: feature modules over a typed core
  compares
    - label Feature module (per domain slice)
      children
        - label Controller — thin HTTP edge, no logic
        - label Service — business rules + one transaction
        - label Repository — typed Repository<T>
    - label Core module — one slot per cross-cutting concern
      children
        - label ConfigModule — typed, validate at boot
        - label APP_GUARD — JwtAuthGuard, authn then authz
        - label APP_PIPE — ValidationPipe, whitelist + transform
        - label APP_INTERCEPTOR — response envelope + timing
        - label APP_FILTER — one error shape
        - label Health controller — liveness vs readiness
