data
  title Three incidents, three signatures
  compares
    - label The leak — OOMKilled every ~30h
      children
        - label Signal: RSS climbs 40 MB/h, linear with traffic
        - label Tool: tracemalloc snapshot diff names the line
        - label Fix: bounded cache + RSS trend alert
    - label The hang — async workers frozen
      children
        - label Signal: p99 vertical, CPU near zero
        - label Tool: py-spy dump on the live pid
        - label Fix: ban sync HTTP in async (CI lint)
    - label The restart — CrashLoopBackOff
      children
        - label Signal: restart loop, clean logs
        - label Tool: kubectl describe — probe events
        - label Fix: startup probe suspends liveness
