infographic compare-binary-horizontal-underline-text-vs
data
  title Два механизма фокуса на один Tab-стоп
  desc Оба делают композит одним Tab-стопом со стрелками внутри — расходятся в том, где живёт фокус
  compares
    - label Roving tabindex
      children
        - label Roving tabindex
          desc Настоящий DOM-фокус едет на обмене 0/-1
        - label Стилизация фокуса бесплатна
          desc :focus-visible работает, activeElement честен
        - label Прокрутка от платформы
          desc Браузер сам прокручивает к фокусу
        - label Цена — focus() на каждую стрелку
          desc Ре-рендер плюс по ref на каждый элемент
        - label По умолчанию для вкладок и меню
          desc Тулбары и радиогруппы тоже
    - label aria-activedescendant
      children
        - label aria-activedescendant
          desc DOM-фокус стоит на месте, в поле ввода
        - label Виртуальный фокус по id
          desc Атрибут указывает на подсвеченную опцию
        - label Дешевле на нажатие
          desc Меняется один атрибут, без focus()
        - label Цена — всё руками
          desc Подсветка, прокрутка, дисциплина id
        - label Обязателен при вводе
          desc Combobox, поиск-селект, палитра
theme
  palette #6366f1 #14b8a6
