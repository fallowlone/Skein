infographic compare-hierarchy-row-letter-card-rounded-rect-node
data
  title Флаги строгости tsconfig
  compares
    - label Внутри strict: true (8 флагов)
      children
        - label strictNullChecks — несущий
        - label noImplicitAny
        - label strictFunctionTypes
        - label strictBindCallApply
        - label strictPropertyInitialization
        - label useUnknownInCatchVariables
        - label noImplicitThis
        - label alwaysStrict (только emit)
    - label Подключить вручную — НЕ в strict (самые ценные)
      children
        - label noUncheckedIndexedAccess → T | undefined
        - label exactOptionalPropertyTypes → a? = отсутствует
theme
  palette #6366f1 #f59e0b #14b8a6
