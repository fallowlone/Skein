infographic hierarchy-tree-curved-line-rounded-rect-node
data
  root
    label Три формы дедлока, три исправления
    children
      - label A: инверсия порядка локов
        children
          - label Причина: два пути берут ту же пару в обратном порядке
          - label Фикс: один глобальный порядок локов; по ключу для динамических пар
      - label B: блокирующая операция под мьютексом
        children
          - label Причина: отправка в канал, I/O, RPC или Wait под локом
          - label Фикс: копия под локом, освобождение, затем отправка
      - label C: WaitGroup.Add гонится с Wait
        children
          - label Причина: Add внутри ребёнка; Wait видит 0 и выходит рано
          - label Фикс: Add до go; только по указателю; -race метит
theme
  palette #6366f1 #14b8a6 #f59e0b
