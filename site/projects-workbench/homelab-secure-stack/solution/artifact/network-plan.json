{
  "segments": [
    {
      "id": "mgmt",
      "name": "Management",
      "vlan": 10,
      "purpose": "management",
      "internetAccess": false
    },
    {
      "id": "lan",
      "name": "Trusted LAN",
      "vlan": 20,
      "purpose": "trusted",
      "internetAccess": true
    },
    {
      "id": "iot",
      "name": "IoT",
      "vlan": 30,
      "purpose": "iot",
      "internetAccess": true
    },
    {
      "id": "guest",
      "name": "Guest",
      "vlan": 40,
      "purpose": "guest",
      "internetAccess": true
    },
    {
      "id": "dmz",
      "name": "DMZ",
      "vlan": 50,
      "purpose": "dmz",
      "internetAccess": true
    },
    {
      "id": "storage",
      "name": "Storage",
      "vlan": 60,
      "purpose": "storage",
      "internetAccess": false
    }
  ],
  "rules": [
    {
      "from": "lan",
      "to": "mgmt",
      "ports": [
        22,
        443
      ],
      "action": "allow",
      "reason": "admin access from trusted workstations only; nothing else may reach management"
    },
    {
      "from": "lan",
      "to": "iot",
      "ports": [
        1883,
        8123
      ],
      "action": "allow",
      "reason": "automation hub speaks MQTT and HTTP to devices; the reverse direction stays closed"
    },
    {
      "from": "lan",
      "to": "storage",
      "ports": [
        445,
        2049
      ],
      "action": "allow",
      "reason": "file shares for trusted machines"
    },
    {
      "from": "dmz",
      "to": "storage",
      "ports": [
        2049
      ],
      "action": "allow",
      "reason": "media server reads the library read-only; write access stays on the LAN"
    },
    {
      "from": "iot",
      "to": "internet",
      "ports": [
        443
      ],
      "action": "allow",
      "reason": "vendor firmware and time sync; everything else from IoT is denied"
    },
    {
      "from": "guest",
      "to": "internet",
      "ports": [
        80,
        443,
        53
      ],
      "action": "allow",
      "reason": "guests get the internet and nothing local"
    },
    {
      "from": "internet",
      "to": "dmz",
      "ports": [
        443
      ],
      "action": "allow",
      "reason": "single ingress: the reverse proxy, behind SSO"
    }
  ],
  "services": [
    {
      "name": "reverse-proxy",
      "segment": "dmz",
      "exposed": true,
      "auth": "sso",
      "tls": true
    },
    {
      "name": "media-server",
      "segment": "dmz",
      "exposed": false,
      "auth": "sso",
      "tls": true
    },
    {
      "name": "nas",
      "segment": "storage",
      "exposed": false
    },
    {
      "name": "router-ui",
      "segment": "mgmt",
      "exposed": false,
      "auth": "mtls",
      "tls": true
    },
    {
      "name": "home-assistant",
      "segment": "lan",
      "exposed": false,
      "auth": "sso",
      "tls": true
    }
  ],
  "backups": {
    "target": "NAS snapshots (hourly, 7d) replicated to Backblaze B2 with client-side encryption",
    "frequency": "hourly local, nightly offsite",
    "offsite": true,
    "restoreTestedAt": "2026-07-12 — restored the Home Assistant config and one photo album to a scratch VM"
  },
  "updates": {
    "automatic": true,
    "cadence": "unattended-upgrades nightly for OS packages; container images pinned by digest and bumped weekly after the staging pull"
  }
}
