{
  "format_version": "1.2",
  "planned_values": {
    "root_module": {
      "resources": [
        {
          "address": "aws_vpc.main",
          "type": "aws_vpc",
          "name": "main",
          "values": {
            "cidr_block": "10.0.0.0/16",
            "enable_dns_hostnames": true
          }
        },
        {
          "address": "aws_subnet.public_a",
          "type": "aws_subnet",
          "name": "public_a",
          "values": {
            "availability_zone": "eu-central-1a",
            "map_public_ip_on_launch": true,
            "cidr_block": "10.0.0.0/24"
          }
        },
        {
          "address": "aws_subnet.public_b",
          "type": "aws_subnet",
          "name": "public_b",
          "values": {
            "availability_zone": "eu-central-1b",
            "map_public_ip_on_launch": true,
            "cidr_block": "10.0.1.0/24"
          }
        },
        {
          "address": "aws_subnet.private_a",
          "type": "aws_subnet",
          "name": "private_a",
          "values": {
            "availability_zone": "eu-central-1a",
            "map_public_ip_on_launch": false,
            "cidr_block": "10.0.10.0/24"
          }
        },
        {
          "address": "aws_subnet.private_b",
          "type": "aws_subnet",
          "name": "private_b",
          "values": {
            "availability_zone": "eu-central-1b",
            "map_public_ip_on_launch": false,
            "cidr_block": "10.0.11.0/24"
          }
        },
        {
          "address": "aws_lb.front",
          "type": "aws_lb",
          "name": "front",
          "values": {
            "internal": false,
            "load_balancer_type": "application"
          }
        },
        {
          "address": "aws_lb_listener.https",
          "type": "aws_lb_listener",
          "name": "https",
          "values": {
            "port": 443,
            "protocol": "HTTPS",
            "ssl_policy": "ELBSecurityPolicy-TLS13-1-2-2021-06"
          }
        },
        {
          "address": "aws_security_group_rule.app_from_lb",
          "type": "aws_security_group_rule",
          "name": "app_from_lb",
          "values": {
            "type": "ingress",
            "from_port": 8080,
            "to_port": 8080,
            "cidr_blocks": [
              "10.0.0.0/16"
            ]
          }
        },
        {
          "address": "aws_vpc_security_group_ingress_rule.db_from_app",
          "type": "aws_vpc_security_group_ingress_rule",
          "name": "db_from_app",
          "values": {
            "from_port": 5432,
            "to_port": 5432,
            "cidr_ipv4": "10.0.10.0/23"
          }
        },
        {
          "address": "aws_db_instance.pg",
          "type": "aws_db_instance",
          "name": "pg",
          "values": {
            "publicly_accessible": false,
            "storage_encrypted": true,
            "backup_retention_period": 7,
            "skip_final_snapshot": false,
            "multi_az": true,
            "password": "${data.aws_secretsmanager_secret_version.db.secret_string}"
          }
        },
        {
          "address": "aws_s3_bucket.assets",
          "type": "aws_s3_bucket",
          "name": "assets",
          "values": {
            "bucket": "app-assets-prod"
          }
        },
        {
          "address": "aws_s3_bucket_public_access_block.assets",
          "type": "aws_s3_bucket_public_access_block",
          "name": "assets",
          "values": {
            "block_public_acls": true,
            "block_public_policy": true,
            "ignore_public_acls": true,
            "restrict_public_buckets": true
          }
        },
        {
          "address": "aws_s3_bucket_server_side_encryption_configuration.assets",
          "type": "aws_s3_bucket_server_side_encryption_configuration",
          "name": "assets",
          "values": {}
        },
        {
          "address": "aws_iam_policy.app",
          "type": "aws_iam_policy",
          "name": "app",
          "values": {
            "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\",\"s3:PutObject\"],\"Resource\":\"arn:aws:s3:::app-assets-prod/*\"},{\"Effect\":\"Allow\",\"Action\":[\"secretsmanager:GetSecretValue\"],\"Resource\":\"arn:aws:secretsmanager:eu-central-1:111122223333:secret:db-*\"}]}"
          }
        }
      ],
      "child_modules": [
        {
          "address": "module.compute",
          "resources": [
            {
              "address": "module.compute.aws_ecs_service.app",
              "type": "aws_ecs_service",
              "name": "app",
              "values": {
                "desired_count": 2
              }
            }
          ]
        }
      ]
    }
