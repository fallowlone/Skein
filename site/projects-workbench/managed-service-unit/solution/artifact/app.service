[Unit]
Description=Example supervised daemon
Documentation=https://example.internal/runbooks/app
After=network-online.target
Wants=network-online.target
# Give the crash loop room to breathe before systemd gives up on the unit entirely.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
ExecStart=/usr/local/bin/app --serve
ExecReload=/bin/kill -HUP $MAINPID
# Restart on failure with a pause, so a crash loop does not spin the CPU.
Restart=on-failure
RestartSec=2s
# Give the daemon time to finish in-flight work on SIGTERM before SIGKILL.
TimeoutStopSec=20s

# Identity: a dedicated unprivileged user, never root.
User=app
Group=app

# Budget: a leak or a runaway loop gets throttled instead of taking the host.
MemoryMax=256M
CPUQuota=50%
TasksMax=64

# Hardening — systemd's deny-by-default toolkit, switched on.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallFilter=@system-service
# ProtectSystem=strict makes everything read-only; name the one path that is not.
ReadWritePaths=/var/lib/app

# stdout/stderr go to journald: rotation, rate limiting and structured fields for free.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=app

[Install]
WantedBy=multi-user.target
