---
import { env } from "cloudflare:workers";
import Lesson from "~/layouts/Lesson.astro";
import LessonRenderTree from "~/components/lesson/LessonRenderTree.astro";
import { fetchLessonPayload, validLessonParams } from "../../../../../lib/lesson-payload";

const { lang, track, unit, lesson } = Astro.params;

let result = null;
if (validLessonParams(lang, track, unit, lesson)) {
  const apiOrigin = (env as { LESSON_API_ORIGIN?: string }).LESSON_API_ORIGIN
    ?? import.meta.env.LESSON_API_ORIGIN
    ?? Astro.url.origin;
  result = await fetchLessonPayload(apiOrigin, { lang, track: track!, unit: unit!, lesson: lesson! }, fetch, Astro.request.headers.get("cookie"));
}

if (!result?.ok) {
  Astro.response.status = result?.status ?? 404;
  Astro.response.headers.set("cache-control", "no-store");
} else {
  Astro.response.headers.set("cache-control", "private, no-store");
}

const payload = result?.ok ? result.payload : null;
const failureStatus = result && !result.ok ? result.status : 404;
// Gate-page copy (variant D): one table drives kicker/title/deck/CTA per
// failure kind, RU/EN. Donate checkout + "how to unlock" render on 403 only.
const errLang = lang === "ru" ? "ru" : "en";
const errKind = failureStatus === 401 ? "signin" : failureStatus === 403 ? "locked" : "missing";
const errCopy = {
  signin: {
    code: "401",
    label: errLang === "ru" ? "НУЖЕН ВХОД" : "SIGN IN REQUIRED",
    title: errLang === "ru" ? "Войдите, чтобы продолжить курс" : "Sign in to continue the course",
    deck: errLang === "ru" ? "Уроки и прогресс привязаны к аккаунту." : "Lessons and progress live on your account.",
    cta: errLang === "ru" ? "Войти" : "Sign in",
    href: `/api/auth/login?lang=${errLang}`,
  },
  locked: {
    code: "403",
    label: errLang === "ru" ? "УРОК ЗАКРЫТ" : "LESSON LOCKED",
    title: errLang === "ru" ? "Сначала пройдите предыдущий урок" : "Complete the previous lesson first",
    deck: errLang === "ru"
      ? "Уроки открываются по порядку. Завершите предыдущий урок — этот откроется автоматически."
      : "Lessons unlock in order. Finish the previous one — this opens automatically.",
    cta: errLang === "ru" ? "К списку уроков" : "Back to lessons",
    href: `/${errLang}/learn/${track}/`,
    stepsHead: errLang === "ru" ? "КАК ОТКРЫТЬ" : "HOW TO UNLOCK",
    steps: errLang === "ru"
      ? ["Откройте предыдущий урок из списка и решите его задания.", "Вернитесь сюда — доступ откроется сам, без ожидания."]
      : ["Open the previous lesson from the list and solve its tasks.", "Come back — access opens instantly, no waiting."],
    donateHead: errLang === "ru" ? "Или откройте весь курс сразу" : "Or unlock the whole track at once",
    donateSub: errLang === "ru"
      ? "Разовый платёж — все уроки курса навсегда: 300 Stars или $9.99."
      : "One payment — every lesson, forever: 300 Stars or $9.99.",
    donateError: errLang === "ru" ? "Не удалось открыть оплату. Попробуйте позже." : "Could not open checkout. Try again later.",
  },
  missing: {
    code: String(failureStatus),
    label: errLang === "ru" ? "УРОК НЕ НАЙДЕН" : "LESSON NOT FOUND",
    title: errLang === "ru" ? "Урок не найден" : "Lesson not found",
    deck: errLang === "ru" ? "Проверьте ссылку или вернитесь к списку уроков." : "Check the link or go back to the lesson list.",
    cta: errLang === "ru" ? "К списку уроков" : "Back to lessons",
    href: `/${errLang}/learn/${track}/`,
  },
}[errKind] as { code: string; label: string; title: string; deck: string; cta: string; href: string; stepsHead?: string; steps?: string[]; donateHead?: string; donateSub?: string; donateError?: string };
const row = payload?.lesson;
const practice = payload?.practice?.tasks ?? null;
---

{row && payload ? (
  <Lesson
    title={row.title}
    lang={row.lang}
    trackSlug={row.track}
    unitSlug={row.unit}
    slug={row.slug}
    summary={row.summary}
    estMin={row.estMin}
    order={row.order}
    sources={row.sources}
    lessonType={row.lessonType}
    level={row.level}
    lessonKey={row.key}
    prereqs={row.prereqs}
    mathPrereqs={row.mathPrereqs}
    practice={practice as any}
    concepts={row.concepts}
    interactiveAllowed={result?.ok && result.authenticated}
    runtime={{
      track: payload.track as any,
      unit: payload.unit as any,
      graph: payload.graph as any,
      lessonMeta: payload.lessonMeta as any,
      projects: payload.projects,
    }}
  >
    <LessonRenderTree nodes={row.body.root as any} drill={payload.drill as any} interactiveAllowed={result?.ok && result.authenticated} lang={row.lang} />
  </Lesson>
) : (
  <html lang={errLang}>
    <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>{errCopy.title}</title>
    <style is:inline>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:flex;align-items:center;background:#fafafa;color:#171717;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}@media(prefers-color-scheme:dark){body{background:#0a0a0a;color:#ededed}}.wrap{max-width:960px;width:100%;margin:0 auto;padding:64px 24px;display:grid;grid-template-columns:1.2fr .8fr;gap:56px;align-items:start}@media(max-width:720px){.wrap{grid-template-columns:1fr;gap:36px}}.kicker{font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:.14em;color:#737373;margin:0 0 16px}h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(32px,4vw,44px);line-height:1.1;letter-spacing:-.02em;margin:0 0 16px;text-wrap:balance}.deck{font-size:16px;line-height:1.65;color:#525252;margin:0 0 28px}@media(prefers-color-scheme:dark){.deck{color:#a3a3a3}}.btn{display:inline-block;background:#171717;color:#fafafa;font-size:15px;font-weight:600;padding:13px 28px;border-radius:10px;text-decoration:none}@media(prefers-color-scheme:dark){.btn{background:#ededed;color:#0a0a0a}}.btn:hover{opacity:.85}.how{border-left:1px solid #e5e5e5;padding-left:28px}@media(prefers-color-scheme:dark){.how{border-color:#262626}}.how h2{font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:.14em;font-weight:400;color:#737373;margin:4px 0 20px}ol{list-style:none;margin:0;padding:0;display:grid;gap:18px}li{display:grid;grid-template-columns:32px 1fr;gap:12px;align-items:start;font-size:14px;line-height:1.55;color:#525252}@media(prefers-color-scheme:dark){li{color:#a3a3a3}}.n{width:32px;height:32px;border:1px solid #d4d4d4;border-radius:50%;display:grid;place-items:center;font-family:ui-monospace,Menlo,monospace;font-size:13px;color:#171717}@media(prefers-color-scheme:dark){.n{border-color:#404040;color:#ededed}}.donate-box{margin-top:30px;border-top:1px solid #e5e5e5;padding-top:24px}@media(prefers-color-scheme:dark){.donate-box{border-color:#262626}}.donate-head{font-size:15px;font-weight:650;margin:0 0 6px}.donate-sub{font-size:14px;color:#737373;margin:0 0 16px;line-height:1.55}.pay-row{display:flex;flex-wrap:wrap;gap:10px}.pay{font:inherit;font-size:14px;font-weight:600;padding:12px 20px;border-radius:10px;cursor:pointer}.pay:disabled{opacity:.5;cursor:wait}.pay-tg{background:#171717;color:#fafafa;border:1px solid #171717}@media(prefers-color-scheme:dark){.pay-tg{background:#ededed;border-color:#ededed;color:#0a0a0a}}.pay-gh{background:transparent;color:inherit;border:1px solid #a3a3a3}.pay:hover:not(:disabled){opacity:.85}.pay-status{font-size:13.5px;color:#737373;margin:12px 0 0}</style></head>
    <body><div class="wrap">
      <div>
        <p class="kicker">{errCopy.code} · {errCopy.label}</p>
        <h1>{errCopy.title}</h1>
        <p class="deck">{errCopy.deck}</p>
        <a class="btn" href={errCopy.href}>{errCopy.cta}</a>
        {errKind === "locked" && (
          <div class="donate-box" data-gate-checkout data-track={track} data-lang={errLang} data-donate-error={errCopy.donateError}>
            <p class="donate-head">{errCopy.donateHead}</p>
            <p class="donate-sub">{errCopy.donateSub}</p>
            <div class="pay-row">
              <button type="button" class="pay pay-tg" data-provider="telegram">300 Telegram Stars</button>
              <button type="button" class="pay pay-gh" data-provider="github">GitHub Sponsors · $9.99</button>
            </div>
            <p class="pay-status" data-checkout-status hidden></p>
          </div>
        )}
      </div>
      {errKind === "locked" && (
        <aside class="how">
          <h2>{errCopy.stepsHead}</h2>
          <ol>
            {(errCopy.steps ?? []).map((step, i) => (
              <li><span class="n">{i + 1}</span><span>{step}</span></li>
            ))}
          </ol>
        </aside>
      )}
    </div>
    <script>
      (function () {
        var box = document.querySelector("[data-gate-checkout]");
        if (!box) return;
        var track = box.getAttribute("data-track"), lang = box.getAttribute("data-lang") || "ru";
        var donateError = box.getAttribute("data-donate-error") || "Checkout unavailable. Try again later.";
        var status = box.querySelector("[data-checkout-status]");
        box.addEventListener("click", function (e) {
          var btn = e.target.closest("[data-provider]");
          if (!btn || btn.disabled) return;
          var tg = btn.getAttribute("data-provider") === "telegram";
          btn.disabled = true;
          status.hidden = true;
          fetch(tg ? "/api/telegram/invoice" : "/api/courses/github-intent", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(tg ? { product: "course:" + track } : { track: track }),
          }).then(function (r) {
            if (r.status === 401) { location.href = "/api/auth/login?lang=" + lang; return null; }
            if (!r.ok) throw 0;
            return r.json();
          }).then(function (res) {
            if (!res) return;
            var url = tg ? res.invoiceUrl : res.sponsorUrl;
            if (!url) throw 0;
            location.href = url;
          }).catch(function () {
            status.textContent = donateError;
            status.hidden = false;
            btn.disabled = false;
          });
        });
      })();
    </script>
    </body>
  </html>
)}
