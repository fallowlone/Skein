---
import { env } from "cloudflare:workers";
import Lesson from "~/layouts/Lesson.astro";
import LessonRenderTree from "~/components/lesson/LessonRenderTree.astro";
import { fetchLessonPayload, validLessonParams } from "../../../../../lib/lesson-payload";

const { lang, track, unit, lesson } = Astro.params;

let result = null;
if (validLessonParams(lang, track, unit, lesson)) {
  const apiOrigin = (env as { LESSON_API_ORIGIN?: string }).LESSON_API_ORIGIN
    ?? import.meta.env.LESSON_API_ORIGIN
    ?? Astro.url.origin;
  result = await fetchLessonPayload(apiOrigin, { lang, track: track!, unit: unit!, lesson: lesson! });
}

if (!result?.ok) {
  Astro.response.status = result?.status ?? 404;
  Astro.response.headers.set("cache-control", "no-store");
} else {
  Astro.response.headers.set(
    "cache-control",
    "public, max-age=0, s-maxage=300, stale-while-revalidate=86400",
  );
}

const payload = result?.ok ? result.payload : null;
const row = payload?.lesson;
const practice = payload?.practice?.tasks ?? null;
---

{row && payload ? (
  <Lesson
    title={row.title}
    lang={row.lang}
    trackSlug={row.track}
    unitSlug={row.unit}
    slug={row.slug}
    summary={row.summary}
    estMin={row.estMin}
    order={row.order}
    sources={row.sources}
    lessonType={row.lessonType}
    level={row.level}
    lessonKey={row.key}
    prereqs={row.prereqs}
    mathPrereqs={row.mathPrereqs}
    practice={practice as any}
    concepts={row.concepts}
    runtime={{
      track: payload.track as any,
      unit: payload.unit as any,
      graph: payload.graph as any,
      lessonMeta: payload.lessonMeta as any,
      projects: payload.projects,
    }}
  >
    <LessonRenderTree nodes={row.body.root as any} drill={payload.drill as any} />
  </Lesson>
) : (
  <html lang={lang === "ru" ? "ru" : "en"}>
    <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>Lesson not found</title></head>
    <body><main><h1>{lang === "ru" ? "Урок не найден" : "Lesson not found"}</h1></main></body>
  </html>
)}
