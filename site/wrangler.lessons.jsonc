{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skein-lessons",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "fallowlone.com/en/learn/*",
      "zone_name": "fallowlone.com"
    },
    {
      "pattern": "fallowlone.com/ru/learn/*",
      "zone_name": "fallowlone.com"
    }
  ]
}
