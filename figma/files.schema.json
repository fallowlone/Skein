{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figma file registry",
  "type": "object",
  "required": ["files"],
  "properties": {
    "description": { "type": "string" },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["fileKey", "url"],
        "properties": {
          "fileKey": {
            "type": "string",
            "description": "Figma fileKey extracted from URL (figma.com/design/<fileKey>/...)"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": ["design", "figjam", "slides", "make"]
          },
          "nodes": {
            "type": "object",
            "description": "Named node IDs inside the file (use ':' form, not '-' form)",
            "additionalProperties": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": ["draft", "review", "published"]
          },
          "exports": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Relative paths to exported assets under assets/exports/"
          }
        }
      }
    }
  }
}
