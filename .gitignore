# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Node (only if a script grows into a project)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local

# Python (ad-hoc scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# Local data caches — keep schemas and raw JSON, ignore intermediate dumps
scripts/.cache/
*.tmp
*.log

# Large binary exports — keep tracked unless they get huge; review case by case
# assets/exports/**/*.mp4
# assets/exports/**/*.mov

# Astro site (build tool)
site/node_modules/
site/dist/
site/.astro/
site/bun.lockb

# Archived SVG MVP (reference only)
scripts/_archive/build/node_modules/
scripts/_archive/build/bun.lockb

.superpowers/
